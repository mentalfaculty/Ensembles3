:" ","type":"text"},{"text":"standard S3 convention. For example, the Ensembles path","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"ensembleId\/events\/data.json"},{"text":" maps to the S3 key","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"<keyPrefix>ensembleId\/events\/data.json"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Directory creation writes a zero-byte marker object with a trailing ","type":"text"},{"type":"codeVoice","code":"\/"},{"text":" key.","type":"text"},{"text":" ","type":"text"},{"text":"Directory listing uses ","type":"text"},{"type":"codeVoice","code":"ListObjectsV2"},{"text":" with a delimiter to discover","type":"text"},{"text":" ","type":"text"},{"text":"“subdirectories” via common prefixes. This approach is compatible with S3","type":"text"},{"text":" ","type":"text"},{"text":"console browsing and third-party tools.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The app configures an ","type":"text"},{"type":"codeVoice","code":"S3Client"},{"text":" with its own credentials and injects it","type":"text"},{"text":" ","type":"text"},{"text":"at init time:","type":"text"}]},{"code":["let s3Client = try await S3Client()","let cloudFS = S3CloudFileSystem(","    client: s3Client,","    bucketName: \"my-bucket\",","    keyPrefix: \"ensembles\/\"",")"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"Authentication","level":2,"anchor":"Authentication"},{"type":"paragraph","inlineContent":[{"text":"The AWS SDK for Swift resolves credentials automatically from the standard","type":"text"},{"text":" ","type":"text"},{"text":"credential provider chain. Configure credentials using any of:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Environment variables"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"AWS_ACCESS_KEY_ID"},{"type":"text","text":", "},{"type":"codeVoice","code":"AWS_SECRET_ACCESS_KEY"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and optionally "},{"type":"codeVoice","code":"AWS_SESSION_TOKEN"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Shared credentials file"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"~\/.aws\/credentials"},{"type":"text","text":" (set via "},{"type":"codeVoice","code":"aws configure"},{"type":"text","text":")"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"IAM role"}]},{"type":"text","text":": Automatic on EC2, ECS, and Lambda"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"SSO"}]},{"type":"text","text":": Run "},{"type":"codeVoice","code":"aws sso login"},{"type":"text","text":", then configure "},{"type":"codeVoice","code":"~\/.aws\/config"}],"type":"paragraph"}]}]},{"code":["\/\/ Default credentials (auto-resolved from environment\/config)","let s3Client = try await S3Client()","","\/\/ Explicit region","let config = try await S3Client.S3ClientConfiguration(region: \"us-west-2\")","let s3Client = S3Client(config: config)"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"Compatible Services","level":2,"anchor":"Compatible-Services"},{"type":"paragraph","inlineContent":[{"text":"This backend works with any S3-compatible service by configuring a custom","type":"text"},{"text":" ","type":"text"},{"text":"endpoint on the ","type":"text"},{"type":"codeVoice","code":"S3Client"},{"text":":","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"MinIO"}]},{"type":"text","text":" — self-hosted object storage"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Cloudflare R2"}]},{"typ