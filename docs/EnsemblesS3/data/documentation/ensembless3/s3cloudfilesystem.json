ype":"text","text":" "},{"type":"text","text":"simulates directory semantics using key prefixes and "},{"type":"codeVoice","code":"\/"},{"type":"text","text":" delimiters — the"},{"type":"text","text":" "},{"type":"text","text":"standard S3 convention. For example, the Ensembles path"},{"type":"text","text":" "},{"type":"codeVoice","code":"ensembleId\/events\/data.json"},{"type":"text","text":" maps to the S3 key"},{"type":"text","text":" "},{"type":"codeVoice","code":"<keyPrefix>ensembleId\/events\/data.json"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Directory creation writes a zero-byte marker object with a trailing "},{"type":"codeVoice","code":"\/"},{"type":"text","text":" key."},{"type":"text","text":" "},{"type":"text","text":"Directory listing uses "},{"type":"codeVoice","code":"ListObjectsV2"},{"type":"text","text":" with a delimiter to discover"},{"type":"text","text":" "},{"type":"text","text":"“subdirectories” via common prefixes. This approach is compatible with S3"},{"type":"text","text":" "},{"type":"text","text":"console browsing and third-party tools."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The app configures an "},{"type":"codeVoice","code":"S3Client"},{"type":"text","text":" with its own credentials and injects it"},{"type":"text","text":" "},{"type":"text","text":"at init time:"}]},{"syntax":"swift","type":"codeListing","code":["let s3Client = try await S3Client()","let cloudFS = S3CloudFileSystem(","    client: s3Client,","    bucketName: \"my-bucket\",","    keyPrefix: \"ensembles\/\"",")"]},{"level":2,"type":"heading","anchor":"Authentication","text":"Authentication"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The AWS SDK for Swift resolves credentials automatically from the standard"},{"type":"text","text":" "},{"type":"text","text":"credential provider chain. Configure credentials using any of:"}]},{"type":"unorderedList","items":[{"content":[{"type":"par