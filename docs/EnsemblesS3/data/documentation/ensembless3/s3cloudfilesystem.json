{"hierarchy":{"paths":[["doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3"]]},"abstract":[{"type":"text","text":"A cloud file system backed by Amazon S3, using the AWS SDK for Swift."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"externalID":"s:11EnsemblesS30B15CloudFileSystemC","modules":[{"name":"EnsemblesS3"}],"role":"symbol","symbolKind":"class","roleHeading":"Class","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"S3CloudFileSystem"}],"navigatorTitle":[{"kind":"identifier","text":"S3CloudFileSystem"}],"title":"S3CloudFileSystem"},"relationshipsSections":[{"type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/CloudFileSystem","doc:\/\/EnsemblesS3\/s8SendableP","doc:\/\/EnsemblesS3\/s16SendableMetatypeP"],"title":"Conforms To"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"S3CloudFileSystem"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"aside","style":"important","content":[{"inlineContent":[{"type":"text","text":"This backend requires the "},{"type":"codeVoice","code":"AWSS3"},{"type":"text","text":" product from"},{"type":"text","text":" "},{"identifier":"https:\/\/github.com\/awslabs\/aws-sdk-swift","type":"reference","isActive":true},{"type":"text","text":". With the source distribution,"},{"type":"text","text":" "},{"type":"text","text":"enable the "},{"type":"codeVoice","code":"S3"},{"type":"text","text":" package trait and SPM resolves it automatically. With the binary distribution"},{"type":"text","text":" "},{"type":"text","text":"(XCFrameworks), add aws-sdk-swift as a separate package dependency in your project."}],"type":"paragraph"}],"name":"Important"},{"type":"paragraph","inlineContent":[{"text":"S3 is a flat key-value store, not a hierarchical file system. This backend","type":"text"},{"text":" ","type":"text"},{"text":"simulates directory semantics using key prefixes and ","type":"text"},{"code":"\/","type":"codeVoice"},{"text":" delimiters — the","type":"text"},{"text":" ","type":"text"},{"text":"standard S3 convention. For example, the Ensembles path","type":"text"},{"text":" ","type":"text"},{"code":"ensembleId\/events\/data.json","type":"codeVoice"},{"text":" maps to the S3 key","type":"text"},{"text":" ","type":"text"},{"code":"<keyPrefix>ensembleId\/events\/data.json","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Directory creation writes a zero-byte marker object with a trailing ","type":"text"},{"code":"\/","type":"codeVoice"},{"text":" key.","type":"text"},{"text":" ","type":"text"},{"text":"Directory listing uses ","type":"text"},{"code":"ListObjectsV2","type":"codeVoice"},{"text":" with a delimiter to discover","type":"text"},{"text":" ","type":"text"},{"text":"“subdirectories” via common prefixes. This approach is compatible with S3","type":"text"},{"text":" ","type":"text"},{"text":"console browsing and third-party tools.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The app configures an ","type":"text"},{"code":"S3Client","type":"codeVoice"},{"text":" with its own credentials and injects it","type":"text"},{"text":" ","type":"text"},{"text":"at init time:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let s3Client = try await S3Client()","let cloudFS = S3CloudFileSystem(","    client: s3Client,","    bucketName: \"my-bucket\",","    keyPrefix: \"ensembles\/\"",")"]},{"type":"heading","level":2,"anchor":"Authentication","text":"Authentication"},{"type":"paragraph","inlineContent":[{"text":"The AWS SDK for Swift resolves credentials automatically from the standard","type":"text"},{"text":" ","type":"text"},{"text":"credential provider chain. Configure credentials using any of:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Environment variables"}],"type":"strong"},{"text":": ","type":"text"},{"code":"AWS_ACCESS_KEY_ID","type":"codeVoice"},{"text":", ","type":"text"},{"code":"AWS_SECRET_ACCESS_KEY","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"and optionally ","type":"text"},{"code":"AWS_SESSION_TOKEN","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Shared credentials file"}],"type":"strong"},{"text":": ","type":"text"},{"code":"~\/.aws\/credentials","type":"codeVoice"},{"text":" (set via ","type":"text"},{"code":"aws configure","type":"codeVoice"},{"text":")","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"IAM role"}],"type":"strong"},{"type":"text","text":": Automatic on EC2, ECS, and Lambda"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"SSO"}]},{"type":"text","text":": Run "},{"code":"aws sso login","type":"codeVoice"},{"type":"text","text":", then configure "},{"code":"~\/.aws\/config","type":"codeVoice"}],"type":"paragraph"}]}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Default credentials (auto-resolved from environment\/config)","let s3Client = try await S3Client()","","\/\/ Explicit region","let config = try await S3Client.S3ClientConfiguration(region: \"us-west-2\")","let s3Client = S3Client(config: config)"]},{"type":"heading","level":2,"anchor":"Compatible-Services","text":"Compatible Services"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This backend works with any S3-compatible service by configuring a custom"},{"type":"text","text":" "},{"type":"text","text":"endpoint on the "},{"type":"codeVoice","code":"S3Client"},{"type":"tex