"type":"codeVoice","code":"<keyPrefix>ensembleId\/events\/data.json"},{"text":".","type":"text"}]},{"inlineContent":[{"type":"text","text":"Directory creation writes a zero-byte marker object with a trailing "},{"type":"codeVoice","code":"\/"},{"text":" key.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Directory listing uses "},{"type":"codeVoice","code":"ListObjectsV2"},{"type":"text","text":" with a delimiter to discover"},{"text":" ","type":"text"},{"text":"“subdirectories” via common prefixes. This approach is compatible with S3","type":"text"},{"text":" ","type":"text"},{"text":"console browsing and third-party tools.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The app configures an "},{"code":"S3Client","type":"codeVoice"},{"text":" with its own credentials and injects it","type":"text"},{"text":" ","type":"text"},{"text":"at init time:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let s3Client = try await S3Client()","let cloudFS = S3CloudFileSystem(","    client: s3Client,","    bucketName: \"my-bucket\",","    keyPrefix: \"ensembles\/\"",")"]},{"level":2,"type":"heading","anchor":"Authentication","text":"Authentication"},{"inlineContent":[{"text":"The AWS SDK for Swift resolves credentials automatically from the standard","type":"text"},{"text":" ","type":"text"},{"text":"credential provider chain. Configure credentials using any of:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Environment variables"}],"type":"strong"},{"type":"text","text":": "},{"type":"codeVoice","code":"AWS_ACCESS_KEY_ID"},{"type":"text","text":", "},{"type":"codeVoice","code":"AWS_SECRET_ACCESS_KEY"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and optionally "},{"type":"codeVoice","code":"AWS_SESSION_TOKEN"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineCo