ctory semantics using key prefixes and ","type":"text"},{"code":"\/","type":"codeVoice"},{"text":" delimiters — the","type":"text"},{"text":" ","type":"text"},{"text":"standard S3 convention. For example, the Ensembles path","type":"text"},{"text":" ","type":"text"},{"code":"ensembleId\/events\/data.json","type":"codeVoice"},{"text":" maps to the S3 key","type":"text"},{"text":" ","type":"text"},{"code":"<keyPrefix>ensembleId\/events\/data.json","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Directory creation writes a zero-byte marker object with a trailing ","type":"text"},{"code":"\/","type":"codeVoice"},{"text":" key.","type":"text"},{"text":" ","type":"text"},{"text":"Directory listing uses ","type":"text"},{"code":"ListObjectsV2","type":"codeVoice"},{"text":" with a delimiter to discover","type":"text"},{"text":" ","type":"text"},{"text":"“subdirectories” via common prefixes. This approach is compatible with S3","type":"text"},{"text":" ","type":"text"},{"text":"console browsing and third-party tools.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The app configures an ","type":"text"},{"code":"S3Client","type":"codeVoice"},{"text":" with its own credentials and injects it","type":"text"},{"text":" ","type":"text"},{"text":"at init time:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["let s3Client = try await S3Client()","let cloudFS = S3CloudFileSystem(","    client: s3Client,","    bucketName: \"my-bucket\",","    keyPrefix: \"ensembles\/\"",")"],"syntax":"swift"},{"level":2,"text":"Authentication","type":"heading","anchor":"Authentication"},{"inlineContent":[{"text":"The AWS SDK for Swift resolves credentials automatically from the standard","type":"text"},{"text":" ","type":"text"},{"text":"credential provider chain. Configure credentials using any of:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Environment variables","type":"text"}],"type":"strong"},{"text":": ","type":"text"},{"code":"AWS_ACCESS_KEY_ID","type":"codeVoice"},{"text":", ","type":"text"},{"code":"AWS_SECRET_ACCESS_KEY","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"and optionally ","type":"text"},{"code":"AWS_SESSION_TOKEN","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Shared credentials file","type":"text"}],"type":"strong"},{"text":": ","type":"text"},{"code":"~\/.aws\/credentials","type":"codeVoice"},{"text":" (set via ","type":"text"},{"code":"aws configure","type":"codeVoice"},{"text":")","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"IAM role","type":"text"}],"type":"strong"},{"text":": Automatic on EC2, ECS, and Lambda","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"SSO","type":"text"}],"type":"strong"},{"text":": Run ","type":"text"},{"code":"aws sso login","type":"codeVoice"},{"text":", then configure ","type":"text"},{"code":"~\/.aws\/config","type":"codeVoice"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"codeListing","code":["\/\/ Default credentials (auto-resolved from environment\/config)","let s3Client = try await S3Client()","","\/\/ Explicit region","let config = try await S3Client.S3ClientConfiguration(region: \"us-west-2\")","let s3Client = S3Client(config: config)"],"syntax":"swift"},{"level":2,"text":"Compatible Services","type":"heading","anchor":"Compatible-Services"},{"inlineContent":[{"text":"This backend works with any S3-compatible service by configuring a custom","type":"text"},{"text":" ","type":"text"},{"text":"endpoint on the ","type":"text"},{"code":"S3Client","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"MinIO","type":"text"}],"type":"strong"},{"text":" — self-hosted object storage","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Cloudflare R2","type":"text"}],"type":"strong"},{"text":" — zero egress fees","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Backblaze B2","type":"text"}],"type":"strong"},{"text":" — low-cost cloud storage","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"DigitalOcean Spaces","type":"text"}],"type":"strong"},{"text":" — simple object storage","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"codeListing","code":["let config = try await S3Client.S3ClientConfiguration(","    region: \"auto\",","    endpoint: \"https:\/\/your-minio-host:9000\"",")","let s3Client = S3Client(config: config)","let cloudFS = S3CloudFileSystem(","    client: s3Client,","    bucketName: \"my-bucket\",","    keyPrefix: \"ensembles\/\"",")"],"syntax":"swift"},{"level":2,"text":"Threading","type":"heading","anchor":"Threading"},{"inlineContent":[{"text":"This class is ","type":"text"},{"code":"@unchecked Sendable","type":"codeVoice"},{"text":". The ","type":"text"},{"code":"S3Client","type":"codeVoice"},{"text":" handles its own thread","type":"text"},{"text":" ","type":"text"},{"text":"safety internally. Mutable state (","type":"text"},{"code":"loggedIn","type":"codeVoice"},{"text":") is only written during","type":"text"},{"text":" ","type":"text"},{"code":"connect()","type":"codeVoice"},{"text":" and error handling.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3"]]},"references":{"doc://EnsemblesS3/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","identifier":"doc:\/\/EnsemblesS3\/s16SendableMetatypeP","type":"unresolvable"},"doc://EnsemblesS3/documentation/EnsemblesS3/S3CloudFileSystem/client":{"kind":"symbol","type":"topic","title":"client","identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3Cl