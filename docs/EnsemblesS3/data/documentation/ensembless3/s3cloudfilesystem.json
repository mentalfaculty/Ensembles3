\/data.json"},{"type":"text","text":" maps to the S3 key"},{"type":"text","text":" "},{"type":"codeVoice","code":"<keyPrefix>ensembleId\/events\/data.json"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Directory creation writes a zero-byte marker object with a trailing "},{"type":"codeVoice","code":"\/"},{"type":"text","text":" key."},{"type":"text","text":" "},{"type":"text","text":"Directory listing uses "},{"type":"codeVoice","code":"ListObjectsV2"},{"text":" with a delimiter to discover","type":"text"},{"type":"text","text":" "},{"type":"text","text":"“subdirectories” via common prefixes. This approach is compatible with S3"},{"type":"text","text":" "},{"type":"text","text":"console browsing and third-party tools."}]},{"inlineContent":[{"type":"text","text":"The app configures an "},{"type":"codeVoice","code":"S3Client"},{"type":"text","text":" with its own credentials and injects it"},{"type":"text","text":" "},{"type":"text","text":"at init time:"}],"type":"paragraph"},{"syntax":"swift","code":["let s3Client = try await S3Client()","let cloudFS = S3CloudFileSystem(","    client: s3Client,","    bucketName: \"my-bucket\",","    keyPrefix: \"ensembles\/\"",")"],"type":"codeListing"},{"type":"heading","text":"Authentication","level":2,"anchor":"Authentication"},{"inlineContent":[{"type":"text","text":"The AWS SDK for Swift resolves credentials automatically from the standard"},{"type":"text","text":" "},{"type":"text","text":"credential provider chain. Configure credentials using any of:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Environment variables","type":"text"}],"type":"strong"},{"text":": ","type":"text"},{"code":"AWS_ACCESS_KEY_ID","type":"codeVoice"},{"text":", ","type":"text"},{"code":"AWS_SECRET_ACCESS_KEY","type":"codeVoice"},{"type":"text","text":","},{"text":" ","type":"text"},{"text":"and optionally ","type":"text"},{"code":"AWS_SESSION_TOKEN","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Shared credentials file"}]},{"text":": ","type":"text"},{"type":"codeVoice","code":"~\/.aws\/credentials"},{"text":" (set via ","type":"text"},{"code":"aws configure","type":"codeVoice"},{"text":")","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"IAM role"}],"type":"strong"},{"text":": Automatic on EC2, ECS, and Lambda","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"SSO","type":"text"}],"type":"strong"},{"text":": Run ","type":"text"},{"type":"codeVoice","code":"aws sso login"},{"type":"text","text":", then configure "},{"type":"codeVoice","code":"~\/.aws\/config"}]}]}]},{"type":"codeListing","code":["\/\/ Default credentials (auto-resolved from environment\/config)","let s3Client = try await S3Client()","","\/\/ Explicit region","let config = try await S3Client.S3ClientConfiguration(region: \"us-west-2\")","let s3Client = S3Client(config: config)"],"syntax":"swift"},{"type":"heading","anchor":"Compatible-Services","level":2,"text":"Compatible Services"},{"type":"paragraph","inlineContent":[{"text":"This backend works with any S3-compatible service by configuring a custom","type":"text"},{"text":" ","type":"text"},{"text":"endpoint on the ","type":"text"},{"code":"S3Client","type":"codeVoice"},{"text":":","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"MinIO","type":"text"}]},{"type":"text","text":" — self-hosted object storage"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Cloudflare R2"}],"type":"strong"},{"text":" — zero egress fees","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Backblaze B2"}]},{"type":"text","text":" — low-cost cloud storage"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"DigitalOcean Spaces"}],"type":"strong"},{"text":" — simple object storage","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"codeListing","code":["let config = try await S3Client.S3ClientConfiguration(","    region: \"auto\",","    endpoint: \"https:\/\/your-minio-host:9000\"",")","let s3Client = S3Client(config: config)","let cloudFS = S3CloudFileSystem(","    client: s3Client,","    bucketName: \"my-bucket\",","    keyPrefix: \"ensembles\/\"",")"],"syntax":"swift"},{"level":2,"type":"heading","anchor":"Threading","text":"Threading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This class is "},{"type":"codeVoice","code":"@unchecked Sendable"},{"text":". The ","type":"text"},{"type":"codeVoice","code":"S3Client"},{"type":"text","text":" handles its own thread"},{"type":"text","text":" "},{"type":"text","text":"safety internally. Mutable state ("},{"code":"loggedIn","type":"codeVoice"},{"type":"text","text":") is only written during"},{"type":"text","text":" "},{"code":"connect()","type":"codeVoice"},{"type":"text","text":" and error handling."}]}]}],"kind":"symbol","topicSections":[{"anchor":"Initializers","identifiers":["doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem\/init(client:bucketName:keyPrefix:)"],"generated":true,"title":"Initializers"},{"anchor":"Instance-Properties","identifiers":["doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem\/bucketName","doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem\/client","doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem\/isConnected","doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem\/keyPrefix"],"generated":true,"title":"Instance Properties"},{"anchor":"Instance-Methods","identifiers":["doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem\/connect()","doc:\/\/EnsemblesS3\