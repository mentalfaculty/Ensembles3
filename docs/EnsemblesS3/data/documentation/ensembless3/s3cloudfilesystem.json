xt","text":" with a delimiter to discover"},{"type":"text","text":" "},{"type":"text","text":"“subdirectories” via common prefixes. This approach is compatible with S3"},{"type":"text","text":" "},{"type":"text","text":"console browsing and third-party tools."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The app configures an "},{"code":"S3Client","type":"codeVoice"},{"type":"text","text":" with its own credentials and injects it"},{"type":"text","text":" "},{"type":"text","text":"at init time:"}],"type":"paragraph"},{"code":["let s3Client = try await S3Client()","let cloudFS = S3CloudFileSystem(","    client: s3Client,","    bucketName: \"my-bucket\",","    keyPrefix: \"ensembles\/\"",")"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":2,"text":"Authentication","anchor":"Authentication"},{"inlineContent":[{"type":"text","text":"The AWS SDK for Swift resolves credentials automatically from the standard"},{"type":"text","text":" "},{"type":"text","text":"credential provider chain. Configure credentials using any of:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Environment variables"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"AWS_ACCESS_KEY_ID"},{"type":"text","text":", "},{"type":"codeVoice","code":"AWS_SECRET_ACCESS_KEY"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and optionally "},{"type":"codeVoice","code":"AWS_SESSION_TOKEN"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Shared credentials file"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"~\/.aws\/credentials"},{"type":"text","text":" (set via "},{"type":"codeVoice","code":"aws configure"},{"type":"text","text":")"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"IAM role"}]},{"type":"text","text":