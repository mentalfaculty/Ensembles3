{"kind":"symbol","abstract":[{"type":"text","text":"An Amazon S3-based cloud backend for Ensembles."}],"sections":[],"metadata":{"role":"collection","modules":[{"name":"EnsemblesS3"}],"title":"EnsemblesS3","symbolKind":"module","roleHeading":"Framework","externalID":"EnsemblesS3"},"topicSections":[{"identifiers":["doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem"],"anchor":"Cloud-File-System","title":"Cloud File System"}],"primaryContentSections":[{"content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"EnsemblesS3 provides ","type":"text"},{"identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem","isActive":true,"type":"reference"},{"text":", an implementation of the Ensembles ","type":"text"},{"code":"CloudFileSystem","type":"codeVoice"},{"text":" protocol that stores sync data in an Amazon S3 bucket. It uses the official ","type":"text"},{"identifier":"https:\/\/github.com\/awslabs\/aws-sdk-swift","isActive":true,"type":"reference"},{"text":" for all API operations.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"S3 is a natural fit for Ensembles — it’s highly durable, globally available, and cost-effective for the small files that Ensembles exchanges. S3-compatible services (MinIO, DigitalOcean Spaces, Backblaze B2, Cloudflare R2) can also be used by configuring the ","type":"text"},{"code":"S3Client","type":"codeVoice"},{"text":" with a custom endpoint.","type":"text"}],"type":"paragraph"},{"text":"S3 as a File System","level":3,"anchor":"S3-as-a-File-System","type":"heading"},{"inlineContent":[{"text":"S3 is a flat key-value store, not a hierarchical file system. ","type":"text"},{"identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem","isActive":true,"type":"reference"},{"text":" simulates directory semantics using key prefixes and ","type":"text"},{"code":"\/","type":"codeVoice"},{"text":" delimiters — the standard S3 convention. For example, the Ensembles path ","type":"text"},{"code":"ensembleId\/events\/data.json","type":"codeVoice"},{"text":" maps to the S3 key ","type":"text"},{"code":"prefix\/ensembleId\/events\/data.json","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Directory creation writes a zero-byte marker object with a trailing ","type":"text"},{"code":"\/","type":"codeVoice"},{"text":" in the key. Directory listing uses ","type":"text"},{"code":"ListObjectsV2","type":"codeVoice"},{"text":" with a delimiter to discover “subdirectories” via common prefixes.","type":"text"}],"type":"paragraph"},{"text":"Authentication","level":3,"anchor":"Authentication","type":"heading"},{"inlineContent":[{"text":"The AWS SDK for Swift supports multiple credential sources (environment variables, IAM roles, SSO, credential files). Your app creates and configures an ","type":"text"},{"code":"S3Client","type":"codeVoice"},{"text":", then injects it:","type":"text"}],"type":"paragraph"},{"code":["import EnsemblesS3","import AWSS3","","let s3Client = try await S3Client()  \/\/ Uses default credential chain","let cloudFileSystem = S3CloudFileSystem(","    client: s3Client,","    bucketName: \"my-ensembles-bucket\",","    keyPrefix: \"sync\/\"  \/\/ Optional: isolate Ensembles data under a prefix",")"],"type":"codeListing","syntax":"swift"},{"text":"Setup","level":3,"anchor":"Setup","type":"heading"},{"code":["let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MainStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: S3CloudFileSystem(","        client: s3Client,","        bucketName: \"my-bucket\",","        keyPrefix: \"ensembles\/\"","    )",")","try await ensemble?.attachPersistentStore()"],"type":"codeListing","syntax":"swift"},{"text":"Key Prefix","level":3,"anchor":"Key-Prefix","type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem\/keyPrefix"},{"type":"text","text":" parameter isolates Ensembles data within a shared bucket. For example, with "},{"type":"codeVoice","code":"keyPrefix: \"ensembles\/\""},{"type":"text","text":", the path "},{"type":"codeVoice","code":"\/MyStore\/events\/abc.json"},{"type":"text","text":" maps to the S3 key "},{"type":"codeVoice","code":"ensembles\/MyStore\/events\/abc.json"},{"type":"text","text":". A trailing "},{"type":"codeVoice","code":"\/"},{"type":"text","text":" is added automatically if omitted."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If "},{"type":"codeVoice","code":"keyPrefix"},{"type":"text","text":" is empty (the default), Ensembles data is stored at the bucket root."}],"type":"paragraph"},{"text":"S3-Compatible Services","level":3,"anchor":"S3-Compatible-Services","type":"heading"},{"inlineContent":[{"type":"text","text":"To use an S3-compatible service, configure the "},{"type":"codeVoice","code":"S3Client"},{"type":"text","text":" with a custom endpoint:"}],"type":"paragraph"},{"code":["let config = try await S3Client.S3ClientConfiguration()","config.endpoint = \"https:\/\/s3.us-east-1.amazonaws.com\"  \/\/ or MinIO, R2, etc.","let s3Client = S3Client(config: config)"],"type":"codeListing","syntax":"swift"},{"text":"Error Handling","level":3,"anchor":"Error-Handling","type":"heading"},{"inlineContent":[{"type":"text","text":"AWS SDK errors are mapped to "},{"type":"codeVoice","code":"EnsembleError"},{"type":"text","text":" cases:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AccessDenied"},{"text":", ","type":"text"},{"type":"codeVoice","code":"InvalidAccessKeyId"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"SignatureDoesNotMatch"},{"text":" map to ","type":"text"},{"type":"codeVoice","code":"EnsembleError\/authenticationFailure"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NoSuchKey"},{"text":", ","type":"text"},{"type":"codeVoice","code":"NoSuchBucket"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"NotFound"},{"text":" map to ","type":"text"},{"type":"codeVoice","code":"EnsembleError\/fileAccessFailed"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"All other errors map to ","type":"text"},{"type":"codeVoice","code":"EnsembleError\/serverError"},{"text":".","type":"text"}]}]}],"type":"unorderedList"},{"text":"Dependencies","level":3,"anchor":"Dependencies","type":"heading"},{"inlineContent":[{"type":"text","text":"This module depends on the "},{"type":"reference","isActive":true,"overridingTitle":"AWS SDK for Swift","overridingTitleInlineContent":[{"type":"text","text":"AWS SDK for Swift"}],"identifier":"https:\/\/github.com\/awslabs\/aws-sdk-swift"},{"type":"text","text":" ("},{"type":"codeVoice","code":"AWSS3"},{"type":"text","text":" module)."}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ensembless3"]}],"hierarchy":{"paths":[[]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3"},"references":{"doc://EnsemblesS3/documentation/EnsemblesS3/S3CloudFileSystem":{"kind":"symbol","abstract":[{"text":"A cloud file system backed by Amazon S3, using the AWS SDK for Swift.","type":"text"}],"navigatorTitle":[{"text":"S3CloudFileSystem","kind":"identifier"}],"type":"topic","url":"\/documentation\/ensembless3\/s3cloudfilesystem","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"S3CloudFileSystem","kind":"identifier"}],"title":"S3CloudFileSystem","role":"symbol","identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem"},"https://github.com/awslabs/aws-sdk-swift":{"title":"AWS SDK for Swift","identifier":"https:\/\/github.com\/awslabs\/aws-sdk-swift","url":"https:\/\/github.com\/awslabs\/aws-sdk-swift","titleInlineContent":[{"type":"text","text":"AWS SDK for Swift"}],"type":"link"},"doc://EnsemblesS3/documentation/EnsemblesS3":{"kind":"symbol","abstract":[{"type":"text","text":"An Amazon S3-based cloud backend for Ensembles."}],"type":"topic","url":"\/documentation\/ensembless3","title":"EnsemblesS3","role":"collection","identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3"},"doc://EnsemblesS3/documentation/EnsemblesS3/S3CloudFileSystem/keyPrefix":{"kind":"symbol","fragments":[{"kind":"keyword","text":"let"},{"text":" ","kind":"text"},{"text":"keyPrefix","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"}],"type":"topic","abstract":[{"type":"text","text":"Optional key prefix within the bucket (e.g. “ensembles\/”)."},{"type":"text","text":" "},{"text":"If set, all keys are prefixed with this value.","type":"text"}],"role":"symbol","title":"keyPrefix","url":"\/documentation\/ensembless3\/s3cloudfilesystem\/keyprefix","identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem\/keyPrefix"}}}