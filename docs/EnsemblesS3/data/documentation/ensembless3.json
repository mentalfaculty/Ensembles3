3\/CloudDirectory","doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/CloudFile","doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/DataFile","doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/EnsembleContainerConfiguration","doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/EventRevision","doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/FileExistence","doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/GlobalIdentifier","doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/ObjectChange","doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/Revision","doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/RevisionSet","doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/StoreModificationEvent","doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/StoredPropertyChange","doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/SyncOptions"],"title":"Structures","generated":true,"anchor":"Structures"},{"identifiers":["doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/currentLoggingLevel()","doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/log(_:level:)","doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/setLoggingLevel(_:)"],"title":"Functions","generated":true,"anchor":"Functions"},{"identifiers":["doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/EventIntegratorDidSaveBlock","doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/EventIntegratorFailedSaveBlock","doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/EventIntegratorMergingEntityBlock","doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/EventIntegratorShouldSaveBlock","doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/GlobalCount","doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/RevisionNumber"],"title":"Type Aliases","generated":true,"anchor":"Type-Aliases"},{"identifiers":["doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/AttachingPhase","doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/CompatibilityMode","doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/EnsembleActivity","doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/EnsembleError","doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/EnsembleNotificationKey","doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/EnsemblesLicense","doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/LoggingLevel","doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/ModelUserInfoKeys","doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/ObjectChangeType","doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/PropertyChangeType","doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/SQLiteError","doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/SQLiteValue","doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/SeedPolicy","doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/StoreModificationEventType","doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/StoredValue","doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/SyncingPhase"],"title":"Enumerations","generated":true,"anchor":"Enumerations"},{"identifiers":["doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/CoreData","doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/Foundation","doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/Swift"],"title":"Extended Modules","generated":true,"anchor":"Extended-Modules"}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"EnsemblesS3 provides "},{"type":"reference","identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem","isActive":true},{"type":"text","text":", an implementation of the Ensembles "},{"type":"codeVoice","code":"CloudFileSystem"},{"type":"text","text":" protocol that stores sync data in an Amazon S3 bucket. It uses the official "},{"type":"reference","identifier":"https:\/\/github.com\/awslabs\/aws-sdk-swift","isActive":true},{"type":"text","text":" for all API operations."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"S3 is a natural fit for Ensembles — it’s highly durable, globally available, and cost-effective for the small files that Ensembles exchanges. S3-compatible services (MinIO, DigitalOcean Spaces, Backblaze B2, Cloudflare R2) can also be used by configuring the "},{"type":"codeVoice","code":"S3Client"},{"type":"text","text":" with a custom endpoint."}]},{"text":"S3 as a File System","anchor":"S3-as-a-File-System","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"S3 is a flat key-value store, not a hierarchical file system. "},{"type":"reference","identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem","isActive":true},{"type":"text","text":" simulates directory semantics using key prefixes and "},{"type":"codeVoice","code":"\/"},{"type":"text","text":" delimiters — the standard S3 convention. For example, the Ensembles path "},{"type":"codeVoice","code":"ensembleId\/events\/data.json"},{"type":"text","text":" maps to the S3 key "},{"type":"codeVoice","code":"prefix\/ensembleId\/events\/data.json"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Directory creation writes a zero-byte marker object with a trailing "},{"type":"codeVoice","code":"\/"},{"type":"text","text":" in the key. Directory listing uses "},{"type":"codeVoice","code":"ListObjectsV2"},{"type":"text","text":" with a delimiter to discover “subdirectories” via common prefixes."}]},{"text":"Authentication","anchor":"Authentication","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"The AWS SDK for Swift supports multiple credential sources (environment variables, IAM roles, SSO, credential files). Your app creates and configures an "},{"type":"codeVoice","code":"S3Client"},{"type":"text","text":", then injects it:"}]},{"syntax":"swift","code":["import EnsemblesS3","import AWSS3","","let s3Client = try await S3Client()  \/\/ Uses default credential chain","let cloudFileSystem = S3CloudFileSystem(","    client: s3Client,","    bucketName: \"my-ensembles-bucket\",","    keyPrefix: \"sync\/\"  \/\/ Optional: isolate Ensembles data under a prefix",")"],"type":"codeListing"},{"anchor":"Setup","level":3,"type":"heading","text":"Setup"},{"type":"codeListing","syntax":"swift","code":["let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MainStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: S3CloudFileSystem(","        client: s3Client,","        bucketName: \"my-bucket\",","        keyPrefix: \"ensembles\/\"","    )",")","try await ensemble?.attachPersistentStore()"]},{"anchor":"Key-Prefix","level":3,"type":"heading","text":"Key Prefix"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem\/keyPrefix","isActive":true,"type":"reference"},{"text":" parameter isolates Ensembles data within a shared bucket. For example, with ","type":"text"},{"code":"keyPrefix: \"ensembles\/\"","type":"codeVoice"},{"text":", the path ","type":"text"},{"code":"\/MyStore\/events\/abc.json","type":"codeVoice"},{"text":" maps to the S3 key ","type":"text"},{"code":"ensembles\/MyStore\/events\/abc.json","type":"codeVoice"},{"text":". A trailing ","type":"text"},{"code":"\/","type":"codeVoice"},{"text":" is added automatically if omitted.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If ","type":"text"},{"code":"keyPrefix","type":"codeVoice"},{"text":" is empty (the default), Ensembles data is stored at the bucket root.","type":"text"}]},{"anchor":"S3-Compatible-Services","level":3,"type":"heading","text":"S3-Compatible Services"},{"type":"paragraph","inlineContent":[{"text":"To use an S3-compatible service, configure the ","type":"text"},{"code":"S3Client","type":"codeVoice"},{"text":" with a custom endpoint:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let config = try await S3Client.S3ClientConfiguration()","config.endpoint = \"https:\/\/s3.us-east-1.amazonaws.com\"  \/\/ or MinIO, R2, etc.","let s3Client = S3Client(config: config)"]},{"anchor":"Error-Handling","level":3,"type":"heading","text":"Error Handling"},{"type":"paragraph","inlineContent":[{"text":"AWS SDK errors are mapped to ","type":"text"},{"identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/EnsembleError","isActive":true,"type":"reference"},{"text":" cases:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AccessDenied"},{"type":"text","text":", "},{"type":"codeVoice","code":"InvalidAccessKeyId"},{"type":"text","text":", and "},{"type":"codeVoice","code":"SignatureDoesNotMatch"},{"type":"text","text":" map to "},{"type":"reference","identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/EnsembleError\/authenticationFailure","isActive":true},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NoSuchKey"},{"type":"text","text":", "},{"type":"codeVoice","code":"NoSuchBucket"},{"type":"text","text":", and "},{"type":"codeVoice","code":"NotFound"},{"type":"text","text":" map to "},{"type":"reference","identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/EnsembleError\/fileAccessFailed","isActive":true},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"All other errors map to "},{"type":"reference","identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/EnsembleError\/serverError","isActive":true},{"type":"text","text":"."}]}]}]},{"anchor":"Dependencies","level":3,"type":"heading","text":"Dependencies"},{"type":"paragraph","inlineContent":[{"text":"This module depends on the ","type":"text"},{"identifier":"https:\/\/github.com\/awslabs\/aws-sdk-swift","isActive":true,"overridingTitleInlineContent":[{"type":"text","text":"AWS SDK for Swift"}],"type":"reference","overridingTitle":"AWS SDK for Swift"},{"text":" (","type":"text"},{"code":"AWSS3","type":"codeVoice"},{"text":" mod