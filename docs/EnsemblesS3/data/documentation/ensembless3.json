{"topicSections":[{"title":"Cloud File System","anchor":"Cloud-File-System","identifiers":["doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem"]}],"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"url":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3","interfaceLanguage":"swift"},"hierarchy":{"paths":[[]]},"abstract":[{"text":"An Amazon S3-based cloud backend for Ensembles.","type":"text"}],"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"EnsemblesS3 provides "},{"type":"reference","isActive":true,"identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem"},{"type":"text","text":", an implementation of the Ensembles "},{"type":"codeVoice","code":"CloudFileSystem"},{"type":"text","text":" protocol that stores sync data in an Amazon S3 bucket. It uses the official "},{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/awslabs\/aws-sdk-swift"},{"type":"text","text":" for all API operations."}]},{"inlineContent":[{"type":"text","text":"S3 is a natural fit for Ensembles — it’s highly durable, globally available, and cost-effective for the small files that Ensembles exchanges. S3-compatible services (MinIO, DigitalOcean Spaces, Backblaze B2, Cloudflare R2) can also be used by configuring the "},{"type":"codeVoice","code":"S3Client"},{"type":"text","text":" with a custom endpoint."}],"type":"paragraph"},{"anchor":"S3-as-a-File-System","level":3,"type":"heading","text":"S3 as a File System"},{"inlineContent":[{"type":"text","text":"S3 is a flat key-value store, not a hierarchical file system. "},{"type":"reference","identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem","isActive":true},{"type":"text","text":" simulates directory semantics using key prefixes and "},{"type":"codeVoice","code":"\/"},{"type":"text","text":" delimiters — the standard S3 convention. For example, the Ensembles path "},{"type":"codeVoice","code":"ensembleId\/events\/data.json"},{"type":"text","text":" maps to the S3 key "},{"type":"codeVoice","code":"prefix\/ensembleId\/events\/data.json"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Directory creation writes a zero-byte marker object with a trailing "},{"type":"codeVoice","code":"\/"},{"type":"text","text":" in the key. Directory listing uses "},{"code":"ListObjectsV2","type":"codeVoice"},{"text":" with a delimiter to discover “subdirectories” via common prefixes.","type":"text"}]},{"type":"heading","anchor":"Authentication","level":3,"text":"Authentication"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The AWS SDK for Swift supports multiple credential sources (environment variables, IAM roles, SSO, credential files). Your app creates and configures an "},{"code":"S3Client","type":"codeVoice"},{"type":"text","text":", then injects it:"}]},{"type":"codeListing","code":["import EnsemblesS3","import AWSS3","","let s3Client = try await S3Client()  \/\/ Uses default credential chain","let cloudFileSystem = S3CloudFileSystem(","    client: s3Client,","    bucketName: \"my-ensembles-bucket\",","    keyPrefix: \"sync\/\"  \/\/ Optional: isolate Ensembles data under a prefix",")"],"syntax":"swift"},{"type":"heading","text":"Setup","level":3,"anchor":"Setup"},{"type":"codeListing","syntax":"swift","code":["let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MainStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: S3CloudFileSystem(","        client: s3Client,","        bucketName: \"my-bucket\",","        keyPrefix: \"ensembles\/\"","    )",")","try await ensemble?.attachPersistentStore()"]},{"level":3,"type":"heading","text":"Key Prefix","anchor":"Key-Prefix"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem\/keyPrefix"},{"type":"text","text":" parameter isolates Ensembles data within a shared bucket. For example, with "},{"type":"codeVoice","code":"keyPrefix: \"ensembles\/\""},{"type":"text","text":", the path "},{"type":"codeVoice","code":"\/MyStore\/events\/abc.json"},{"type":"text","text":" maps to the S3 key "},{"type":"codeVoice","code":"ensembles\/MyStore\/events\/abc.json"},{"type":"text","text":". A trailing "},{"type":"codeVoice","code":"\/"},{"type":"text","text":" is added automatically if omitted."}]},{"inlineContent":[{"type":"text","text":"If "},{"type":"codeVoice","code":"keyPrefix"},{"text":" is empty (the default), Ensembles data is stored at the bucket root.","type":"text"}],"type":"paragraph"},{"text":"S3-Compatible Services","anchor":"S3-Compatible-Services","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"To use an S3-compatible service, configure the "},{"type":"codeVoice","code":"S3Client"},{"type":"text","text":" with a custom endpoint:"}],"type":"paragraph"},{"code":["let config = try await S3Client.S3ClientConfiguration()","config.endpoint = \"https:\/\/s3.us-east-1.amazonaws.com\"  \/\/ or MinIO, R2, etc.","let s3Client = S3Client(config: config)"],"type":"codeListing","syntax":"swift"},{"text":"Error Handling","anchor":"Error-Handling","type":"heading","level":3},{"inlineContent":[{"text":"AWS SDK errors are mapped to ","type":"text"},{"code":"EnsembleError","type":"codeVoice"},{"text":" cases:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"AccessDenied","type":"codeVoice"},{"text":", ","type":"text"},{"code":"InvalidAccessKeyId","type":"codeVoice"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"SignatureDoesNotMatch"},{"type":"text","text":" map to "},{"type":"codeVoice","code":"EnsembleError\/authenticationFailure"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"NoSuchKey"},{"type":"text","text":", "},{"type":"codeVoice","code":"NoSuchBucket"},{"type":"text","text":", and "},{"type":"codeVoice","code":"NotFound"},{"type":"text","text":" map to "},{"type":"codeVoice","code":"EnsembleError\/fileAccessFailed"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"All other errors map to ","type":"text"},{"code":"EnsembleError\/serverError","type":"codeVoice"},{"text":".","type":"text"}]}]}],"type":"unorderedList"},{"type":"heading","text":"Dependencies","level":3,"anchor":"Dependencies"},{"type":"paragraph","inlineContent":[{"text":"This module depends on the ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/awslabs\/aws-sdk-swift","overridingTitleInlineContent":[{"type":"text","text":"AWS SDK for Swift"}],"overridingTitle":"AWS SDK for Swift"},{"text":" (","type":"text"},{"type":"codeVoice","code":"AWSS3"},{"text":" module).","type":"text"}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ensembless3"]}],"metadata":{"title":"EnsemblesS3","roleHeading":"Framework","symbolKind":"module","role":"collection","modules":[{"name":"EnsemblesS3"}],"externalID":"EnsemblesS3"},"kind":"symbol","references":{"doc://EnsemblesS3/documentation/EnsemblesS3/S3CloudFileSystem":{"identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem","kind":"symbol","type":"topic","url":"\/documentation\/ensembless3\/s3cloudfilesystem","role":"symbol","title":"S3CloudFileSystem","fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"text":"S3CloudFileSystem","kind":"identifier"}],"abstract":[{"text":"A cloud file system backed by Amazon S3, using the AWS SDK for Swift.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"S3CloudFileSystem"}]},"doc://EnsemblesS3/documentation/EnsemblesS3":{"identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3","kind":"symbol","type":"topic","url":"\/documentation\/ensembless3","role":"collection","title":"EnsemblesS3","abstract":[{"text":"An Amazon S3-based cloud backend for Ensembles.","type":"text"}]},"doc://EnsemblesS3/documentation/EnsemblesS3/S3CloudFileSystem/keyPrefix":{"kind":"symbol","title":"keyPrefix","abstract":[{"type":"text","text":"Optional key prefix within the bucket (e.g. “ensembles\/”)."},{"type":"text","text":" "},{"type":"text","text":"If set, all keys are prefixed with this value."}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"keyPrefix","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"}],"role":"symbol","identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem\/keyPrefix","type":"topic","url":"\/documentation\/ensembless3\/s3cloudfilesystem\/keyprefix"},"https://github.com/awslabs/aws-sdk-swift":{"identifier":"https:\/\/github.com\/awslabs\/aws-sdk-swift","title":"AWS SDK for Swift","titleInlineContent":[{"type":"text","text":"AWS SDK for Swift"}],"url":"https:\/\/github.com\/awslabs\/aws-sdk-swift","type":"link"}}}