{"hierarchy":{"paths":[[]]},"abstract":[{"text":"An Amazon S3-based cloud backend for Ensembles.","type":"text"}],"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"EnsemblesS3 provides "},{"isActive":true,"type":"reference","identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem"},{"type":"text","text":", an implementation of the Ensembles "},{"type":"codeVoice","code":"CloudFileSystem"},{"type":"text","text":" protocol that stores sync data in an Amazon S3 bucket. It uses the official "},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/awslabs\/aws-sdk-swift"},{"type":"text","text":" for all API operations."}]},{"type":"paragraph","inlineContent":[{"text":"S3 is a natural fit for Ensembles — it’s highly durable, globally available, and cost-effective for the small files that Ensembles exchanges. S3-compatible services (MinIO, DigitalOcean Spaces, Backblaze B2, Cloudflare R2) can also be used by configuring the ","type":"text"},{"code":"S3Client","type":"codeVoice"},{"text":" with a custom endpoint.","type":"text"}]},{"type":"heading","text":"S3 as a File System","anchor":"S3-as-a-File-System","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"S3 is a flat key-value store, not a hierarchical file system. "},{"type":"reference","isActive":true,"identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem"},{"type":"text","text":" simulates directory semantics using key prefixes and "},{"type":"codeVoice","code":"\/"},{"type":"text","text":" delimiters — the standard S3 convention. For example, the Ensembles path "},{"type":"codeVoice","code":"ensembleId\/events\/data.json"},{"type":"text","text":" maps to the S3 key "},{"type":"codeVoice","code":"prefix\/ensembleId\/events\/data.json"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Directory creation writes a zero-byte marker object with a trailing "},{"code":"\/","type":"codeVoice"},{"type":"text","text":" in the key. Directory listing uses "},{"code":"ListObjectsV2","type":"codeVoice"},{"text":" with a delimiter to discover “subdirectories” via common prefixes.","type":"text"}]},{"level":3,"type":"heading","text":"Authentication","anchor":"Authentication"},{"inlineContent":[{"type":"text","text":"The AWS SDK for Swift supports multiple credential sources (environment variables, IAM roles, SSO, credential files). Your app creates and configures an "},{"type":"codeVoice","code":"S3Client"},{"type":"text","text":", then injects it:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import EnsemblesS3","import AWSS3","","let s3Client = try await S3Client()  \/\/ Uses default credential chain","let cloudFileSystem = S3CloudFileSystem(","    client: s3Client,","    bucketName: \"my-ensembles-bucket\",","    keyPrefix: \"sync\/\"  \/\/ Optional: isolate Ensembles data under a prefix",")"]},{"level":3,"type":"heading","text":"Setup","anchor":"Setup"},{"syntax":"swift","type":"codeListing","code":["let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MainStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: S3CloudFileSystem(","        client: s3Client,","        bucketName: \"my-bucket\",","        keyPrefix: \"ensembles\/\"","    )",")","try await ensemble?.attachPersistentStore()"]},{"level":3,"type":"heading","text":"Key Prefix","anchor":"Key-Prefix"},{"inlineContent":[{"text":"The ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem\/keyPrefix"},{"text":" parameter isolates Ensembles data within a shared bucket. For example, with ","type":"text"},{"type":"codeVoice","code":"keyPrefix: \"ensembles\/\""},{"text":", the path ","type":"text"},{"type":"codeVoice","code":"\/MyStore\/events\/abc.json"},{"text":" maps to the S3 key ","type":"text"},{"type":"codeVoice","code":"ensembles\/MyStore\/events\/abc.json"},{"text":". A trailing ","type":"text"},{"type":"codeVoice","code":"\/"},{"text":" is added automatically if omitted.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If ","type":"text"},{"code":"keyPrefix","type":"codeVoice"},{"text":" is empty (the default), Ensembles data is stored at the bucket root.","type":"text"}],"type":"paragraph"},{"level":3,"type":"heading","text":"S3-Compatible Services","anchor":"S3-Compatible-Services"},{"inlineContent":[{"text":"To use an S3-compatible service, configure the ","type":"text"},{"type":"codeVoice","code":"S3Client"},{"text":" with a custom endpoint:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let config = try await S3Client.S3ClientConfiguration()","config.endpoint = \"https:\/\/s3.us-east-1.amazonaws.com\"  \/\/ or MinIO, R2, etc.","let s3Client = S3Client(config: config)"]},{"level":3,"type":"heading","text":"Error Handling","anchor":"Error-Handling"},{"inlineContent":[{"type":"text","text":"AWS SDK errors are mapped to "},{"type":"codeVoice","code":"EnsembleError"},{"type":"text","text":" cases:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"AccessDenied"},{"type":"text","text":", "},{"type":"codeVoice","code":"InvalidAccessKeyId"},{"type":"text","text":", and "},{"type":"codeVoice","code":"SignatureDoesNotMatch"},{"type":"text","text":" map to "},{"type":"codeVoice","code":"EnsembleError\/authenticationFailure"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"NoSuchKey"},{"text":", ","type":"text"},{"type":"codeVoice","code":"NoSuchBucket"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"NotFound"},{"text":" map to ","type":"text"},{"type":"codeVoice","code":"EnsembleError\/fileAccessFailed"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"All other errors map to "},{"code":"EnsembleError\/serverError","type":"codeVoice"},{"type":"text","text":"."}]}]}],"type":"unorderedList"},{"anchor":"Dependencies","level":3,"text":"Dependencies","type":"heading"},{"inlineContent":[{"text":"This module depends on the ","type":"text"},{"overridingTitleInlineContent":[{"text":"AWS SDK for Swift","type":"text"}],"isActive":true,"identifier":"https:\/\/github.com\/awslabs\/aws-sdk-swift","type":"reference","overridingTitle":"AWS SDK for Swift"},{"text":" (","type":"text"},{"code":"AWSS3","type":"codeVoice"},{"text":" module).","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/ensembless3"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"topicSections":[{"title":"Cloud File System","anchor":"Cloud-File-System","identifiers":["doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem"]}],"metadata":{"roleHeading":"Framework","externalID":"EnsemblesS3","role":"collection","modules":[{"name":"EnsemblesS3"}],"title":"EnsemblesS3","symbolKind":"module"},"kind":"symbol","references":{"doc://EnsemblesS3/documentation/EnsemblesS3":{"url":"\/documentation\/ensembless3","title":"EnsemblesS3","role":"collection","kind":"symbol","type":"topic","identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3","abstract":[{"text":"An Amazon S3-based cloud backend for Ensembles.","type":"text"}]},"doc://EnsemblesS3/documentation/EnsemblesS3/S3CloudFileSystem":{"kind":"symbol","type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"S3CloudFileSystem"}],"abstract":[{"type":"text","text":"A cloud file system backed by Amazon S3, using the AWS SDK for Swift."}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"text":"S3CloudFileSystem","kind":"identifier"}],"url":"\/documentation\/ensembless3\/s3cloudfilesystem","identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem","title":"S3CloudFileSystem"},"https://github.com/awslabs/aws-sdk-swift":{"title":"AWS SDK for Swift","titleInlineContent":[{"text":"AWS SDK for Swift","type":"text"}],"url":"https:\/\/github.com\/awslabs\/aws-sdk-swift","identifier":"https:\/\/github.com\/awslabs\/aws-sdk-swift","type":"link"},"doc://EnsemblesS3/documentation/EnsemblesS3/S3CloudFileSystem/keyPrefix":{"role":"symbol","type":"topic","abstract":[{"type":"text","text":"Optional key prefix within the bucket (e.g. “ensembles\/”)."},{"text":" ","type":"text"},{"text":"If set, all keys are prefixed with this value.","type":"text"}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"keyPrefix"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"}],"url":"\/documentation\/ensembless3\/s3cloudfilesystem\/keyprefix","title":"keyPrefix","identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem\/keyPrefix","kind":"symbol"}}}