{"metadata":{"roleHeading":"Framework","modules":[{"name":"EnsemblesS3"}],"role":"collection","title":"EnsemblesS3","symbolKind":"module","externalID":"EnsemblesS3"},"topicSections":[{"identifiers":["doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem"],"anchor":"Cloud-File-System","title":"Cloud File System"}],"hierarchy":{"paths":[[]]},"abstract":[{"text":"An Amazon S3-based cloud backend for Ensembles.","type":"text"}],"sections":[],"identifier":{"url":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3","interfaceLanguage":"swift"},"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"EnsemblesS3 provides "},{"identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem","isActive":true,"type":"reference"},{"type":"text","text":", an implementation of the Ensembles "},{"type":"codeVoice","code":"CloudFileSystem"},{"type":"text","text":" protocol that stores sync data in an Amazon S3 bucket. It uses the official "},{"identifier":"https:\/\/github.com\/awslabs\/aws-sdk-swift","isActive":true,"type":"reference"},{"type":"text","text":" for all API operations."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"S3 is a natural fit for Ensembles — it’s highly durable, globally available, and cost-effective for the small files that Ensembles exchanges. S3-compatible services (MinIO, DigitalOcean Spaces, Backblaze B2, Cloudflare R2) can also be used by configuring the "},{"type":"codeVoice","code":"S3Client"},{"type":"text","text":" with a custom endpoint."}],"type":"paragraph"},{"text":"S3 as a File System","level":3,"anchor":"S3-as-a-File-System","type":"heading"},{"inlineContent":[{"type":"text","text":"S3 is a flat key-value store, not a hierarchical file system. "},{"identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem","isActive":true,"type":"reference"},{"type":"text","text":" simulates directory semantics using key prefixes and "},{"type":"codeVoice","code":"\/"},{"type":"text","text":" delimiters — the standard S3 convention. For example, the Ensembles path "},{"type":"codeVoice","code":"ensembleId\/events\/data.json"},{"type":"text","text":" maps to the S3 key "},{"type":"codeVoice","code":"prefix\/ensembleId\/events\/data.json"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Directory creation writes a zero-byte marker object with a trailing "},{"type":"codeVoice","code":"\/"},{"type":"text","text":" in the key. Directory listing uses "},{"type":"codeVoice","code":"ListObjectsV2"},{"type":"text","text":" with a delimiter to discover “subdirectories” via common prefixes."}],"type":"paragraph"},{"text":"Authentication","level":3,"anchor":"Authentication","type":"heading"},{"inlineContent":[{"type":"text","text":"The AWS SDK for Swift supports multiple credential sources (environment variables, IAM roles, SSO, credential files). Your app creates and configures an "},{"type":"codeVoice","code":"S3Client"},{"type":"text","text":", then injects it:"}],"type":"paragraph"},{"code":["import EnsemblesS3","import AWSS3","","let s3Client = try await S3Client()  \/\/ Uses default credential chain","let cloudFileSystem = S3CloudFileSystem(","    client: s3Client,","    bucketName: \"my-ensembles-bucket\",","    keyPrefix: \"sync\/\"  \/\/ Optional: isolate Ensembles data under a prefix",")"],"type":"codeListing","syntax":"swift"},{"text":"Setup","level":3,"anchor":"Setup","type":"heading"},{"code":["let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MainStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: S3CloudFileSystem(","        client: s3Client,","        bucketName: \"my-bucket\",","        keyPrefix: \"ensembles\/\"","    )",")","try await ensemble?.attachPersistentStore()"],"type":"codeListing","syntax":"swift"},{"text":"Key Prefix","level":3,"anchor":"Key-Prefix","type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem\/keyPrefix","isActive":true,"type":"reference"},{"type":"text","text":" parameter isolates Ensembles data within a shared bucket. For example, with "},{"type":"codeVoice","code":"keyPrefix: \"ensembles\/\""},{"type":"text","text":", the path "},{"type":"codeVoice","code":"\/MyStore\/events\/abc.json"},{"type":"text","text":" maps to the S3 key "},{"type":"codeVoice","code":"ensembles\/MyStore\/events\/abc.json"},{"type":"text","text":". A trailing "},{"type":"codeVoice","code":"\/"},{"type":"text","text":" is added automatically if omitted."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If "},{"type":"codeVoice","code":"keyPrefix"},{"type":"text","text":" is empty (the default), Ensembles data is stored at the bucket root."}],"type":"paragraph"},{"text":"S3-Compatible Services","level":3,"anchor":"S3-Compatible-Services","type":"heading"},{"inlineContent":[{"type":"text","text":"To use an S3-compatible service, configure the "},{"type":"codeVoice","code":"S3Client"},{"type":"text","text":" with a custom endpoint:"}],"type":"paragraph"},{"code":["let config = try await S3Client.S3ClientConfiguration()","config.endpoint = \"https:\/\/s3.us-east-1.amazonaws.com\"  \/\/ or MinIO, R2, etc.","let s3Client = S3Client(config: config)"],"type":"codeListing","syntax":"swift"},{"text":"Error Handling","level":3,"anchor":"Error-Handling","type":"heading"},{"inlineContent":[{"type":"text","text":"AWS SDK errors are mapped to "},{"type":"codeVoice","code":"EnsembleError"},{"type":"text","text":" cases:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"AccessDenied"},{"type":"text","text":", "},{"type":"codeVoice","code":"InvalidAccessKeyId"},{"type":"text","text":", and "},{"type":"codeVoice","code":"SignatureDoesNotMatch"},{"type":"text","text":" map to "},{"type":"codeVoice","code":"EnsembleError\/authenticationFailure"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"NoSuchKey"},{"type":"text","text":", "},{"type":"codeVoice","code":"NoSuchBucket"},{"type":"text","text":", and "},{"type":"codeVoice","code":"NotFound"},{"type":"text","text":" map to "},{"type":"codeVoice","code":"EnsembleError\/fileAccessFailed"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"All other errors map to "},{"type":"codeVoice","code":"EnsembleError\/serverError"},{"type":"text","text":"."}],"type":"paragraph"}]}]},{"text":"Dependencies","level":3,"anchor":"Dependencies","type":"heading"},{"inlineContent":[{"type":"text","text":"This module depends on the "},{"identifier":"https:\/\/github.com\/awslabs\/aws-sdk-swift","isActive":true,"type":"reference","overridingTitleInlineContent":[{"type":"text","text":"AWS SDK for Swift"}],"overridingTitle":"AWS SDK for Swift"},{"type":"text","text":" ("},{"type":"codeVoice","code":"AWSS3"},{"type":"text","text":" module)."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/ensembless3"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"https://github.com/awslabs/aws-sdk-swift":{"titleInlineContent":[{"text":"AWS SDK for Swift","type":"text"}],"identifier":"https:\/\/github.com\/awslabs\/aws-sdk-swift","url":"https:\/\/github.com\/awslabs\/aws-sdk-swift","title":"AWS SDK for Swift","type":"link"},"doc://EnsemblesS3/documentation/EnsemblesS3":{"abstract":[{"type":"text","text":"An Amazon S3-based cloud backend for Ensembles."}],"role":"collection","type":"topic","identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3","title":"EnsemblesS3","kind":"symbol","url":"\/documentation\/ensembless3"},"doc://EnsemblesS3/documentation/EnsemblesS3/S3CloudFileSystem/keyPrefix":{"url":"\/documentation\/ensembless3\/s3cloudfilesystem\/keyprefix","abstract":[{"text":"Optional key prefix within the bucket (e.g. “ensembles\/”).","type":"text"},{"text":" ","type":"text"},{"text":"If set, all keys are prefixed with this value.","type":"text"}],"title":"keyPrefix","identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem\/keyPrefix","role":"symbol","kind":"symbol","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"keyPrefix","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"}]},"doc://EnsemblesS3/documentation/EnsemblesS3/S3CloudFileSystem":{"abstract":[{"type":"text","text":"A cloud file system backed by Amazon S3, using the AWS SDK for Swift."}],"role":"symbol","navigatorTitle":[{"text":"S3CloudFileSystem","kind":"identifier"}],"type":"topic","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"S3CloudFileSystem","kind":"identifier"}],"title":"S3CloudFileSystem","identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem","kind":"symbol","url":"\/documentation\/ensembless3\/s3cloudfilesystem"}}}