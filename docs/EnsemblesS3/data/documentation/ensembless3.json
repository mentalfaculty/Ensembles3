{"topicSections":[{"identifiers":["doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem"],"anchor":"Cloud-File-System","title":"Cloud File System"}],"kind":"symbol","primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"EnsemblesS3 provides "},{"isActive":true,"identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem","type":"reference"},{"type":"text","text":", an implementation of the Ensembles "},{"type":"codeVoice","code":"CloudFileSystem"},{"type":"text","text":" protocol that stores sync data in an Amazon S3 bucket. It uses the official "},{"isActive":true,"identifier":"https:\/\/github.com\/awslabs\/aws-sdk-swift","type":"reference"},{"type":"text","text":" for all API operations."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"S3 is a natural fit for Ensembles — it’s highly durable, globally available, and cost-effective for the small files that Ensembles exchanges. S3-compatible services (MinIO, DigitalOcean Spaces, Backblaze B2, Cloudflare R2) can also be used by configuring the "},{"type":"codeVoice","code":"S3Client"},{"type":"text","text":" with a custom endpoint."}],"type":"paragraph"},{"level":3,"anchor":"S3-as-a-File-System","text":"S3 as a File System","type":"heading"},{"inlineContent":[{"type":"text","text":"S3 is a flat key-value store, not a hierarchical file system. "},{"isActive":true,"identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem","type":"reference"},{"type":"text","text":" simulates directory semantics using key prefixes and "},{"type":"codeVoice","code":"\/"},{"type":"text","text":" delimiters — the standard S3 convention. For example, the Ensembles path "},{"type":"codeVoice","code":"ensembleId\/events\/data.json"},{"type":"text","text":" maps to the S3 key "},{"type":"codeVoice","code":"prefix\/ensembleId\/events\/data.json"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Directory creation writes a zero-byte marker object with a trailing "},{"type":"codeVoice","code":"\/"},{"type":"text","text":" in the key. Directory listing uses "},{"type":"codeVoice","code":"ListObjectsV2"},{"type":"text","text":" with a delimiter to discover “subdirectories” via common prefixes."}],"type":"paragraph"},{"level":3,"anchor":"Authentication","text":"Authentication","type":"heading"},{"inlineContent":[{"type":"text","text":"The AWS SDK for Swift supports multiple credential sources (environment variables, IAM roles, SSO, credential files). Your app creates and configures an "},{"type":"codeVoice","code":"S3Client"},{"type":"text","text":", then injects it:"}],"type":"paragraph"},{"syntax":"swift","code":["import EnsemblesS3","import AWSS3","","let s3Client = try await S3Client()  \/\/ Uses default credential chain","let cloudFileSystem = S3CloudFileSystem(","    client: s3Client,","    bucketName: \"my-ensembles-bucket\",","    keyPrefix: \"sync\/\"  \/\/ Optional: isolate Ensembles data under a prefix",")"],"type":"codeListing"},{"level":3,"anchor":"Setup","text":"Setup","type":"heading"},{"syntax":"swift","code":["let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MainStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: S3CloudFileSystem(","        client: s3Client,","        bucketName: \"my-bucket\",","        keyPrefix: \"ensembles\/\"","    )",")","try await ensemble?.attachPersistentStore()"],"type":"codeListing"},{"level":3,"anchor":"Key-Prefix","text":"Key Prefix","type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"isActive":true,"identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem\/keyPrefix","type":"reference"},{"type":"text","text":" parameter isolates Ensembles data within a shared bucket. For example, with "},{"type":"codeVoice","code":"keyPrefix: \"ensembles\/\""},{"type":"text","text":", the path "},{"type":"codeVoice","code":"\/MyStore\/events\/abc.json"},{"type":"text","text":" maps to the S3 key "},{"type":"codeVoice","code":"ensembles\/MyStore\/events\/abc.json"},{"type":"text","text":". A trailing "},{"type":"codeVoice","code":"\/"},{"type":"text","text":" is added automatically if omitted."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If "},{"type":"codeVoice","code":"keyPrefix"},{"type":"text","text":" is empty (the default), Ensembles data is stored at the bucket root."}],"type":"paragraph"},{"level":3,"anchor":"S3-Compatible-Services","text":"S3-Compatible Services","type":"heading"},{"inlineContent":[{"type":"text","text":"To use an S3-compatible service, configure the "},{"type":"codeVoice","code":"S3Client"},{"type":"text","text":" with a custom endpoint:"}],"type":"paragraph"},{"syntax":"swift","code":["let config = try await S3Client.S3ClientConfiguration()","config.endpoint = \"https:\/\/s3.us-east-1.amazonaws.com\"  \/\/ or MinIO, R2, etc.","let s3Client = S3Client(config: config)"],"type":"codeListing"},{"level":3,"anchor":"Error-Handling","text":"Error Handling","type":"heading"},{"inlineContent":[{"type":"text","text":"AWS SDK errors are mapped to "},{"type":"codeVoice","code":"EnsembleError"},{"type":"text","text":" cases:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"AccessDenied","type":"codeVoice"},{"type":"text","text":", "},{"code":"InvalidAccessKeyId","type":"codeVoice"},{"type":"text","text":", and "},{"code":"SignatureDoesNotMatch","type":"codeVoice"},{"type":"text","text":" map to "},{"code":"EnsembleError\/authenticationFailure","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"NoSuchKey","type":"codeVoice"},{"type":"text","text":", "},{"code":"NoSuchBucket","type":"codeVoice"},{"type":"text","text":", and "},{"code":"NotFound","type":"codeVoice"},{"type":"text","text":" map to "},{"code":"EnsembleError\/fileAccessFailed","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"All other errors map to "},{"code":"EnsembleError\/serverError","type":"codeVoice"},{"type":"text","text":"."}]}]}],"type":"unorderedList"},{"level":3,"anchor":"Dependencies","text":"Dependencies","type":"heading"},{"inlineContent":[{"type":"text","text":"This module depends on the "},{"overridingTitleInlineContent":[{"text":"AWS SDK for Swift","type":"text"}],"isActive":true,"identifier":"https:\/\/github.com\/awslabs\/aws-sdk-swift","type":"reference","overridingTitle":"AWS SDK for Swift"},{"type":"text","text":" ("},{"type":"codeVoice","code":"AWSS3"},{"type":"text","text":" module)."}],"type":"paragraph"}]}],"sections":[],"variants":[{"paths":["\/documentation\/ensembless3"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[[]]},"metadata":{"modules":[{"name":"EnsemblesS3"}],"title":"EnsemblesS3","externalID":"EnsemblesS3","role":"collection","roleHeading":"Framework","symbolKind":"module"},"identifier":{"url":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"text":"An Amazon S3-based cloud backend for Ensembles.","type":"text"}],"references":{"doc://EnsemblesS3/documentation/EnsemblesS3/S3CloudFileSystem":{"role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"S3CloudFileSystem"}],"url":"\/documentation\/ensembless3\/s3cloudfilesystem","type":"topic","abstract":[{"type":"text","text":"A cloud file system backed by Amazon S3, using the AWS SDK for Swift."}],"identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem","title":"S3CloudFileSystem","navigatorTitle":[{"kind":"identifier","text":"S3CloudFileSystem"}]},"doc://EnsemblesS3/documentation/EnsemblesS3":{"role":"collection","kind":"symbol","url":"\/documentation\/ensembless3","type":"topic","abstract":[{"type":"text","text":"An Amazon S3-based cloud backend for Ensembles."}],"identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3","title":"EnsemblesS3"},"https://github.com/awslabs/aws-sdk-swift":{"url":"https:\/\/github.com\/awslabs\/aws-sdk-swift","titleInlineContent":[{"text":"AWS SDK for Swift","type":"text"}],"type":"link","identifier":"https:\/\/github.com\/awslabs\/aws-sdk-swift","title":"AWS SDK for Swift"},"doc://EnsemblesS3/documentation/EnsemblesS3/S3CloudFileSystem/keyPrefix":{"title":"keyPrefix","abstract":[{"type":"text","text":"Optional key prefix within the bucket (e.g. “ensembles\/”)."},{"text":" ","type":"text"},{"text":"If set, all keys are prefixed with this value.","type":"text"}],"fragments":[{"text":"let","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"keyPrefix"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"}],"kind":"symbol","type":"topic","url":"\/documentation\/ensembless3\/s3cloudfilesystem\/keyprefix","role":"symbol","identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem\/keyPrefix"}}}