{"metadata":{"role":"collection","externalID":"EnsemblesS3","title":"EnsemblesS3","symbolKind":"module","modules":[{"name":"EnsemblesS3"}],"roleHeading":"Framework"},"abstract":[{"text":"An Amazon S3-based cloud backend for Ensembles.","type":"text"}],"topicSections":[{"identifiers":["doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem"],"title":"Cloud File System","anchor":"Cloud-File-System"}],"hierarchy":{"paths":[[]]},"variants":[{"paths":["\/documentation\/ensembless3"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","identifier":{"url":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3","interfaceLanguage":"swift"},"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"EnsemblesS3 provides "},{"type":"reference","identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem","isActive":true},{"type":"text","text":", an implementation of the Ensembles "},{"code":"CloudFileSystem","type":"codeVoice"},{"type":"text","text":" protocol that stores sync data in an Amazon S3 bucket. It uses the official "},{"type":"reference","identifier":"https:\/\/github.com\/awslabs\/aws-sdk-swift","isActive":true},{"type":"text","text":" for all API operations."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"S3 is a natural fit for Ensembles — it’s highly durable, globally available, and cost-effective for the small files that Ensembles exchanges. S3-compatible services (MinIO, DigitalOcean Spaces, Backblaze B2, Cloudflare R2) can also be used by configuring the "},{"code":"S3Client","type":"codeVoice"},{"type":"text","text":" with a custom endpoint."}],"type":"paragraph"},{"level":3,"anchor":"S3-as-a-File-System","type":"heading","text":"S3 as a File System"},{"inlineContent":[{"type":"text","text":"S3 is a flat key-value store, not a hierarchical file system. "},{"type":"reference","identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem","isActive":true},{"type":"text","text":" simulates directory semantics using key prefixes and "},{"code":"\/","type":"codeVoice"},{"type":"text","text":" delimiters — the standard S3 convention. For example, the Ensembles path "},{"code":"ensembleId\/events\/data.json","type":"codeVoice"},{"type":"text","text":" maps to the S3 key "},{"code":"prefix\/ensembleId\/events\/data.json","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Directory creation writes a zero-byte marker object with a trailing "},{"code":"\/","type":"codeVoice"},{"type":"text","text":" in the key. Directory listing uses "},{"code":"ListObjectsV2","type":"codeVoice"},{"type":"text","text":" with a delimiter to discover “subdirectories” via common prefixes."}],"type":"paragraph"},{"level":3,"anchor":"Authentication","type":"heading","text":"Authentication"},{"inlineContent":[{"type":"text","text":"The AWS SDK for Swift supports multiple credential sources (environment variables, IAM roles, SSO, credential files). Your app creates and configures an "},{"code":"S3Client","type":"codeVoice"},{"type":"text","text":", then injects it:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import EnsemblesS3","import AWSS3","","let s3Client = try await S3Client()  \/\/ Uses default credential chain","let cloudFileSystem = S3CloudFileSystem(","    client: s3Client,","    bucketName: \"my-ensembles-bucket\",","    keyPrefix: \"sync\/\"  \/\/ Optional: isolate Ensembles data under a prefix",")"]},{"level":3,"anchor":"Setup","type":"heading","text":"Setup"},{"syntax":"swift","type":"codeListing","code":["let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MainStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: S3CloudFileSystem(","        client: s3Client,","        bucketName: \"my-bucket\",","        keyPrefix: \"ensembles\/\"","    )",")","try await ensemble?.attachPersistentStore()"]},{"level":3,"anchor":"Key-Prefix","type":"heading","text":"Key Prefix"},{"inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem\/keyPrefix","isActive":true},{"type":"text","text":" parameter isolates Ensembles data within a shared bucket. For example, with "},{"code":"keyPrefix: \"ensembles\/\"","type":"codeVoice"},{"type":"text","text":", the path "},{"code":"\/MyStore\/events\/abc.json","type":"codeVoice"},{"type":"text","text":" maps to the S3 key "},{"code":"ensembles\/MyStore\/events\/abc.json","type":"codeVoice"},{"type":"text","text":". A trailing "},{"code":"\/","type":"codeVoice"},{"type":"text","text":" is added automatically if omitted."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If "},{"code":"keyPrefix","type":"codeVoice"},{"type":"text","text":" is empty (the default), Ensembles data is stored at the bucket root."}],"type":"paragraph"},{"level":3,"anchor":"S3-Compatible-Services","type":"heading","text":"S3-Compatible Services"},{"inlineContent":[{"type":"text","text":"To use an S3-compatible service, configure the "},{"code":"S3Client","type":"codeVoice"},{"type":"text","text":" with a custom endpoint:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let config = try await S3Client.S3ClientConfiguration()","config.endpoint = \"https:\/\/s3.us-east-1.amazonaws.com\"  \/\/ or MinIO, R2, etc.","let s3Client = S3Client(config: config)"]},{"level":3,"anchor":"Error-Handling","type":"heading","text":"Error Handling"},{"inlineContent":[{"type":"text","text":"AWS SDK errors are mapped to "},{"code":"EnsembleError","type":"codeVoice"},{"type":"text","text":" cases:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"AccessDenied","type":"codeVoice"},{"type":"text","text":", "},{"code":"InvalidAccessKeyId","type":"codeVoice"},{"type":"text","text":", and "},{"code":"SignatureDoesNotMatch","type":"codeVoice"},{"type":"text","text":" map to "},{"code":"EnsembleError\/authenticationFailure","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"NoSuchKey","type":"codeVoice"},{"type":"text","text":", "},{"code":"NoSuchBucket","type":"codeVoice"},{"type":"text","text":", and "},{"code":"NotFound","type":"codeVoice"},{"type":"text","text":" map to "},{"code":"EnsembleError\/fileAccessFailed","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"All other errors map to "},{"code":"EnsembleError\/serverError","type":"codeVoice"},{"type":"text","text":"."}]}]}],"type":"unorderedList"},{"level":3,"anchor":"Dependencies","type":"heading","text":"Dependencies"},{"inlineContent":[{"type":"text","text":"This module depends on the "},{"type":"reference","identifier":"https:\/\/github.com\/awslabs\/aws-sdk-swift","isActive":true,"overridingTitleInlineContent":[{"type":"text","text":"AWS SDK for Swift"}],"overridingTitle":"AWS SDK for Swift"},{"type":"text","text":" ("},{"code":"AWSS3","type":"codeVoice"},{"type":"text","text":" module)."}],"type":"paragraph"}]}],"references":{"doc://EnsemblesS3/documentation/EnsemblesS3":{"type":"topic","identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3","abstract":[{"type":"text","text":"An Amazon S3-based cloud backend for Ensembles."}],"role":"collection","title":"EnsemblesS3","url":"\/documentation\/ensembless3","kind":"symbol"},"https://github.com/awslabs/aws-sdk-swift":{"url":"https:\/\/github.com\/awslabs\/aws-sdk-swift","identifier":"https:\/\/github.com\/awslabs\/aws-sdk-swift","title":"AWS SDK for Swift","type":"link","titleInlineContent":[{"type":"text","text":"AWS SDK for Swift"}]},"doc://EnsemblesS3/documentation/EnsemblesS3/S3CloudFileSystem/keyPrefix":{"type":"topic","abstract":[{"text":"Optional key prefix within the bucket (e.g. “ensembles\/”).","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"If set, all keys are prefixed with this value."}],"identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem\/keyPrefix","title":"keyPrefix","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"keyPrefix"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"}],"kind":"symbol","role":"symbol","url":"\/documentation\/ensembless3\/s3cloudfilesystem\/keyprefix"},"doc://EnsemblesS3/documentation/EnsemblesS3/S3CloudFileSystem":{"title":"S3CloudFileSystem","role":"symbol","identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem","navigatorTitle":[{"kind":"identifier","text":"S3CloudFileSystem"}],"url":"\/documentation\/ensembless3\/s3cloudfilesystem","abstract":[{"type":"text","text":"A cloud file system backed by Amazon S3, using the AWS SDK for Swift."}],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"S3CloudFileSystem"}]}}}