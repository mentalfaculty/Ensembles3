{"abstract":[{"text":"An Amazon S3-based cloud backend for Ensembles.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3"},"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"EnsemblesS3 provides "},{"type":"reference","identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem","isActive":true},{"type":"text","text":", an implementation of the Ensembles "},{"type":"codeVoice","code":"CloudFileSystem"},{"type":"text","text":" protocol that stores sync data in an Amazon S3 bucket. It uses the official "},{"type":"reference","identifier":"https:\/\/github.com\/awslabs\/aws-sdk-swift","isActive":true},{"type":"text","text":" for all API operations."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"S3 is a natural fit for Ensembles — it’s highly durable, globally available, and cost-effective for the small files that Ensembles exchanges. S3-compatible services (MinIO, DigitalOcean Spaces, Backblaze B2, Cloudflare R2) can also be used by configuring the "},{"type":"codeVoice","code":"S3Client"},{"type":"text","text":" with a custom endpoint."}]},{"text":"S3 as a File System","type":"heading","anchor":"S3-as-a-File-System","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"S3 is a flat key-value store, not a hierarchical file system. "},{"type":"reference","identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem","isActive":true},{"type":"text","text":" simulates directory semantics using key prefixes and "},{"type":"codeVoice","code":"\/"},{"type":"text","text":" delimiters — the standard S3 convention. For example, the Ensembles path "},{"type":"codeVoice","code":"ensembleId\/events\/data.json"},{"type":"text","text":" maps to the S3 key "},{"type":"codeVoice","code":"prefix\/ensembleId\/events\/data.json"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Directory creation writes a zero-byte marker object with a trailing "},{"type":"codeVoice","code":"\/"},{"type":"text","text":" in the key. Directory listing uses "},{"type":"codeVoice","code":"ListObjectsV2"},{"type":"text","text":" with a delimiter to discover “subdirectories” via common prefixes."}]},{"text":"Authentication","type":"heading","anchor":"Authentication","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"The AWS SDK for Swift supports multiple credential sources (environment variables, IAM roles, SSO, credential files). Your app creates and configures an "},{"type":"codeVoice","code":"S3Client"},{"type":"text","text":", then injects it:"}]},{"syntax":"swift","type":"codeListing","code":["import EnsemblesS3","import AWSS3","","let s3Client = try await S3Client()  \/\/ Uses default credential chain","let cloudFileSystem = S3CloudFileSystem(","    client: s3Client,","    bucketName: \"my-ensembles-bucket\",","    keyPrefix: \"sync\/\"  \/\/ Optional: isolate Ensembles data under a prefix",")"]},{"text":"Setup","type":"heading","anchor":"Setup","level":3},{"syntax":"swift","type":"codeListing","code":["let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MainStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: S3CloudFileSystem(","        client: s3Client,","        bucketName: \"my-bucket\",","        keyPrefix: \"ensembles\/\"","    )",")","try await ensemble?.attachPersistentStore()"]},{"text":"Key Prefix","type":"heading","anchor":"Key-Prefix","level":3},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem\/keyPrefix"},{"text":" parameter isolates Ensembles data within a shared bucket. For example, with ","type":"text"},{"code":"keyPrefix: \"ensembles\/\"","type":"codeVoice"},{"text":", the path ","type":"text"},{"code":"\/MyStore\/events\/abc.json","type":"codeVoice"},{"text":" maps to the S3 key ","type":"text"},{"code":"ensembles\/MyStore\/events\/abc.json","type":"codeVoice"},{"text":". A trailing ","type":"text"},{"code":"\/","type":"codeVoice"},{"text":" is added automatically if omitted.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If ","type":"text"},{"code":"keyPrefix","type":"codeVoice"},{"text":" is empty (the default), Ensembles data is stored at the bucket root.","type":"text"}]},{"text":"S3-Compatible Services","type":"heading","anchor":"S3-Compatible-Services","level":3},{"type":"paragraph","inlineContent":[{"text":"To use an S3-compatible service, configure the ","type":"text"},{"code":"S3Client","type":"codeVoice"},{"text":" with a custom endpoint:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let config = try await S3Client.S3ClientConfiguration()","config.endpoint = \"https:\/\/s3.us-east-1.amazonaws.com\"  \/\/ or MinIO, R2, etc.","let s3Client = S3Client(config: config)"]},{"text":"Error Handling","type":"heading","anchor":"Error-Handling","level":3},{"type":"paragraph","inlineContent":[{"text":"AWS SDK errors are mapped to ","type":"text"},{"code":"EnsembleError","type":"codeVoice"},{"text":" cases:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AccessDenied"},{"text":", ","type":"text"},{"type":"codeVoice","code":"InvalidAccessKeyId"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"SignatureDoesNotMatch"},{"text":" map to ","type":"text"},{"type":"codeVoice","code":"EnsembleError\/authenticationFailure"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NoSuchKey"},{"text":", ","type":"text"},{"code":"NoSuchBucket","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"NotFound","type":"codeVoice"},{"text":" map to ","type":"text"},{"code":"EnsembleError\/fileAccessFailed","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"All other errors map to "},{"type":"codeVoice","code":"EnsembleError\/serverError"},{"type":"text","text":"."}]}]}],"type":"unorderedList"},{"text":"Dependencies","type":"heading","anchor":"Dependencies","level":3},{"type":"paragraph","inlineContent":[{"text":"This module depends on the ","type":"text"},{"overridingTitleInlineContent":[{"type":"text","text":"AWS SDK for Swift"}],"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/awslabs\/aws-sdk-swift","overridingTitle":"AWS SDK for Swift"},{"text":" (","type":"text"},{"code":"AWSS3","type":"codeVoice"},{"text":" module).","type":"text"}]}],"kind":"content"}],"metadata":{"modules":[{"name":"EnsemblesS3"}],"role":"collection","externalID":"EnsemblesS3","symbolKind":"module","title":"EnsemblesS3","roleHeading":"Framework"},"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","sections":[],"topicSections":[{"anchor":"Cloud-File-System","identifiers":["doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem"],"title":"Cloud File System"}],"hierarchy":{"paths":[[]]},"variants":[{"paths":["\/documentation\/ensembless3"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://EnsemblesS3/documentation/EnsemblesS3/S3CloudFileSystem/keyPrefix":{"url":"\/documentation\/ensembless3\/s3cloudfilesystem\/keyprefix","role":"symbol","title":"keyPrefix","kind":"symbol","identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem\/keyPrefix","fragments":[{"text":"let","kind":"keyword"},{"kind":"text","text":" "},{"text":"keyPrefix","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"}],"type":"topic","abstract":[{"type":"text","text":"Optional key prefix within the bucket (e.g. “ensembles\/”)."},{"type":"text","text":" "},{"text":"If set, all keys are prefixed with this value.","type":"text"}]},"doc://EnsemblesS3/documentation/EnsemblesS3":{"role":"collection","abstract":[{"type":"text","text":"An Amazon S3-based cloud backend for Ensembles."}],"type":"topic","kind":"symbol","identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3","url":"\/documentation\/ensembless3","title":"EnsemblesS3"},"doc://EnsemblesS3/documentation/EnsemblesS3/S3CloudFileSystem":{"title":"S3CloudFileSystem","url":"\/documentation\/ensembless3\/s3cloudfilesystem","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"S3CloudFileSystem"}],"identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem","type":"topic","navigatorTitle":[{"kind":"identifier","text":"S3CloudFileSystem"}],"role":"symbol","abstract":[{"text":"A cloud file system backed by Amazon S3, using the AWS SDK for Swift.","type":"text"}],"kind":"symbol"},"https://github.com/awslabs/aws-sdk-swift":{"titleInlineContent":[{"type":"text","text":"AWS SDK for Swift"}],"type":"link","title":"AWS SDK for Swift","url":"https:\/\/github.com\/awslabs\/aws-sdk-swift","identifier":"https:\/\/github.com\/awslabs\/aws-sdk-swift"}}}