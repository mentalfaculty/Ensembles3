{"abstract":[{"type":"text","text":"An Amazon S3-based cloud backend for Ensembles."}],"metadata":{"role":"collection","symbolKind":"module","title":"EnsemblesS3","roleHeading":"Framework","externalID":"EnsemblesS3","modules":[{"name":"EnsemblesS3"}]},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ensembless3"]}],"kind":"symbol","hierarchy":{"paths":[[]]},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"EnsemblesS3 provides ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem"},{"text":", an implementation of the Ensembles ","type":"text"},{"type":"codeVoice","code":"CloudFileSystem"},{"text":" protocol that stores sync data in an Amazon S3 bucket. It uses the official ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/awslabs\/aws-sdk-swift"},{"text":" for all API operations.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"S3 is a natural fit for Ensembles — it’s highly durable, globally available, and cost-effective for the small files that Ensembles exchanges. S3-compatible services (MinIO, DigitalOcean Spaces, Backblaze B2, Cloudflare R2) can also be used by configuring the ","type":"text"},{"type":"codeVoice","code":"S3Client"},{"text":" with a custom endpoint.","type":"text"}]},{"anchor":"S3-as-a-File-System","level":3,"type":"heading","text":"S3 as a File System"},{"type":"paragraph","inlineContent":[{"text":"S3 is a flat key-value store, not a hierarchical file system. ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem"},{"text":" simulates directory semantics using key prefixes and ","type":"text"},{"type":"codeVoice","code":"\/"},{"text":" delimiters — the standard S3 convention. For example, the Ensembles path ","type":"text"},{"type":"codeVoice","code":"ensembleId\/events\/data.json"},{"text":" maps to the S3 key ","type":"text"},{"type":"codeVoice","code":"prefix\/ensembleId\/events\/data.json"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Directory creation writes a zero-byte marker object with a trailing ","type":"text"},{"type":"codeVoice","code":"\/"},{"text":" in the key. Directory listing uses ","type":"text"},{"type":"codeVoice","code":"ListObjectsV2"},{"text":" with a delimiter to discover “subdirectories” via common prefixes.","type":"text"}]},{"anchor":"Authentication","level":3,"type":"heading","text":"Authentication"},{"type":"paragraph","inlineContent":[{"text":"The AWS SDK for Swift supports multiple credential sources (environment variables, IAM roles, SSO, credential files). Your app creates and configures an ","type":"text"},{"type":"codeVoice","code":"S3Client"},{"text":", then injects it:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import EnsemblesS3","import AWSS3","","let s3Client = try await S3Client()  \/\/ Uses default credential chain","let cloudFileSystem = S3CloudFileSystem(","    client: s3Client,","    bucketName: \"my-ensembles-bucket\",","    keyPrefix: \"sync\/\"  \/\/ Optional: isolate Ensembles data under a prefix",")"]},{"anchor":"Setup","level":3,"type":"heading","text":"Setup"},{"syntax":"swift","type":"codeListing","code":["let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MainStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: S3CloudFileSystem(","        client: s3Client,","        bucketName: \"my-bucket\",","        keyPrefix: \"ensembles\/\"","    )",")","try await ensemble?.attachPersistentStore()"]},{"anchor":"Key-Prefix","level":3,"type":"heading","text":"Key Prefix"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"isActive":true,"identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem\/keyPrefix","type":"reference"},{"text":" parameter isolates Ensembles data within a shared bucket. For example, with ","type":"text"},{"code":"keyPrefix: \"ensembles\/\"","type":"codeVoice"},{"text":", the path ","type":"text"},{"code":"\/MyStore\/events\/abc.json","type":"codeVoice"},{"text":" maps to the S3 key ","type":"text"},{"code":"ensembles\/MyStore\/events\/abc.json","type":"codeVoice"},{"text":". A trailing ","type":"text"},{"code":"\/","type":"codeVoice"},{"text":" is added automatically if omitted.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If ","type":"text"},{"code":"keyPrefix","type":"codeVoice"},{"text":" is empty (the default), Ensembles data is stored at the bucket root.","type":"text"}]},{"anchor":"S3-Compatible-Services","level":3,"type":"heading","text":"S3-Compatible Services"},{"type":"paragraph","inlineContent":[{"text":"To use an S3-compatible service, configure the ","type":"text"},{"code":"S3Client","type":"codeVoice"},{"text":" with a custom endpoint:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let config = try await S3Client.S3ClientConfiguration()","config.endpoint = \"https:\/\/s3.us-east-1.amazonaws.com\"  \/\/ or MinIO, R2, etc.","let s3Client = S3Client(config: config)"]},{"anchor":"Error-Handling","level":3,"type":"heading","text":"Error Handling"},{"type":"paragraph","inlineContent":[{"text":"AWS SDK errors are mapped to ","type":"text"},{"code":"EnsembleError","type":"codeVoice"},{"text":" cases:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"AccessDenied","type":"codeVoice"},{"text":", ","type":"text"},{"code":"InvalidAccessKeyId","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"SignatureDoesNotMatch","type":"codeVoice"},{"text":" map to ","type":"text"},{"code":"EnsembleError\/authenticationFailure","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"NoSuchKey","type":"codeVoice"},{"text":", ","type":"text"},{"code":"NoSuchBucket","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"NotFound","type":"codeVoice"},{"text":" map to ","type":"text"},{"code":"EnsembleError\/fileAccessFailed","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"All other errors map to ","type":"text"},{"code":"EnsembleError\/serverError","type":"codeVoice"},{"text":".","type":"text"}]}]}],"type":"unorderedList"},{"anchor":"Dependencies","level":3,"type":"heading","text":"Dependencies"},{"type":"paragraph","inlineContent":[{"text":"This module depends on the ","type":"text"},{"isActive":true,"overridingTitle":"AWS SDK for Swift","identifier":"https:\/\/github.com\/awslabs\/aws-sdk-swift","overridingTitleInlineContent":[{"text":"AWS SDK for Swift","type":"text"}],"type":"reference"},{"text":" (","type":"text"},{"code":"AWSS3","type":"codeVoice"},{"text":" module).","type":"text"}]}]}],"identifier":{"url":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3","interfaceLanguage":"swift"},"topicSections":[{"title":"Cloud File System","anchor":"Cloud-File-System","identifiers":["doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem"]}],"references":{"doc://EnsemblesS3/documentation/EnsemblesS3/S3CloudFileSystem":{"role":"symbol","navigatorTitle":[{"text":"S3CloudFileSystem","kind":"identifier"}],"abstract":[{"text":"A cloud file system backed by Amazon S3, using the AWS SDK for Swift.","type":"text"}],"title":"S3CloudFileSystem","type":"topic","kind":"symbol","identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem","url":"\/documentation\/ensembless3\/s3cloudfilesystem","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"S3CloudFileSystem"}]},"doc://EnsemblesS3/documentation/EnsemblesS3/S3CloudFileSystem/keyPrefix":{"title":"keyPrefix","fragments":[{"kind":"keyword","text":"let"},{"text":" ","kind":"text"},{"text":"keyPrefix","kind":"identifier"},{"kind":"text","text":": "},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem\/keyPrefix","abstract":[{"type":"text","text":"Optional key prefix within the bucket (e.g. “ensembles\/”)."},{"type":"text","text":" "},{"type":"text","text":"If set, all keys are prefixed with this value."}],"type":"topic","url":"\/documentation\/ensembless3\/s3cloudfilesystem\/keyprefix"},"doc://EnsemblesS3/documentation/EnsemblesS3":{"role":"collection","kind":"symbol","title":"EnsemblesS3","type":"topic","url":"\/documentation\/ensembless3","identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3","abstract":[{"type":"text","text":"An Amazon S3-based cloud backend for Ensembles."}]},"https://github.com/awslabs/aws-sdk-swift":{"title":"AWS SDK for Swift","type":"link","identifier":"https:\/\/github.com\/awslabs\/aws-sdk-swift","titleInlineContent":[{"type":"text","text":"AWS SDK for Swift"}],"url":"https:\/\/github.com\/awslabs\/aws-sdk-swift"}}}