{"hierarchy":{"paths":[[]]},"sections":[],"primaryContentSections":[{"content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"EnsemblesS3 provides "},{"type":"reference","isActive":true,"identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem"},{"type":"text","text":", an implementation of the Ensembles "},{"type":"codeVoice","code":"CloudFileSystem"},{"type":"text","text":" protocol that stores sync data in an Amazon S3 bucket. It uses the official "},{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/awslabs\/aws-sdk-swift"},{"type":"text","text":" for all API operations."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"S3 is a natural fit for Ensembles — it’s highly durable, globally available, and cost-effective for the small files that Ensembles exchanges. S3-compatible services (MinIO, DigitalOcean Spaces, Backblaze B2, Cloudflare R2) can also be used by configuring the "},{"type":"codeVoice","code":"S3Client"},{"type":"text","text":" with a custom endpoint."}],"type":"paragraph"},{"text":"S3 as a File System","level":3,"anchor":"S3-as-a-File-System","type":"heading"},{"inlineContent":[{"type":"text","text":"S3 is a flat key-value store, not a hierarchical file system. "},{"type":"reference","isActive":true,"identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem"},{"type":"text","text":" simulates directory semantics using key prefixes and "},{"type":"codeVoice","code":"\/"},{"type":"text","text":" delimiters — the standard S3 convention. For example, the Ensembles path "},{"type":"codeVoice","code":"ensembleId\/events\/data.json"},{"type":"text","text":" maps to the S3 key "},{"type":"codeVoice","code":"prefix\/ensembleId\/events\/data.json"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Directory creation writes a zero-byte marker object with a trailing "},{"type":"codeVoice","code":"\/"},{"type":"text","text":" in the key. Directory listing uses "},{"type":"codeVoice","code":"ListObjectsV2"},{"type":"text","text":" with a delimiter to discover “subdirectories” via common prefixes."}],"type":"paragraph"},{"text":"Authentication","level":3,"anchor":"Authentication","type":"heading"},{"inlineContent":[{"type":"text","text":"The AWS SDK for Swift supports multiple credential sources (environment variables, IAM roles, SSO, credential files). Your app creates and configures an "},{"type":"codeVoice","code":"S3Client"},{"type":"text","text":", then injects it:"}],"type":"paragraph"},{"code":["import EnsemblesS3","import AWSS3","","let s3Client = try await S3Client()  \/\/ Uses default credential chain","let cloudFileSystem = S3CloudFileSystem(","    client: s3Client,","    bucketName: \"my-ensembles-bucket\",","    keyPrefix: \"sync\/\"  \/\/ Optional: isolate Ensembles data under a prefix",")"],"syntax":"swift","type":"codeListing"},{"text":"Setup","level":3,"anchor":"Setup","type":"heading"},{"code":["let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MainStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: S3CloudFileSystem(","        client: s3Client,","        bucketName: \"my-bucket\",","        keyPrefix: \"ensembles\/\"","    )",")","try await ensemble?.attachPersistentStore()"],"syntax":"swift","type":"codeListing"},{"text":"Key Prefix","level":3,"anchor":"Key-Prefix","type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem\/keyPrefix"},{"type":"text","text":" parameter isolates Ensembles data within a shared bucket. For example, with "},{"type":"codeVoice","code":"keyPrefix: \"ensembles\/\""},{"type":"text","text":", the path "},{"type":"codeVoice","code":"\/MyStore\/events\/abc.json"},{"type":"text","text":" maps to the S3 key "},{"type":"codeVoice","code":"ensembles\/MyStore\/events\/abc.json"},{"type":"text","text":". A trailing "},{"type":"codeVoice","code":"\/"},{"type":"text","text":" is added automatically if omitted."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If "},{"type":"codeVoice","code":"keyPrefix"},{"type":"text","text":" is empty (the default), Ensembles data is stored at the bucket root."}],"type":"paragraph"},{"text":"S3-Compatible Services","level":3,"anchor":"S3-Compatible-Services","type":"heading"},{"inlineContent":[{"type":"text","text":"To use an S3-compatible service, configure the "},{"type":"codeVoice","code":"S3Client"},{"type":"text","text":" with a custom endpoint:"}],"type":"paragraph"},{"code":["let config = try await S3Client.S3ClientConfiguration()","config.endpoint = \"https:\/\/s3.us-east-1.amazonaws.com\"  \/\/ or MinIO, R2, etc.","let s3Client = S3Client(config: config)"],"syntax":"swift","type":"codeListing"},{"text":"Error Handling","level":3,"anchor":"Error-Handling","type":"heading"},{"inlineContent":[{"type":"text","text":"AWS SDK errors are mapped to "},{"type":"codeVoice","code":"EnsembleError"},{"type":"text","text":" cases:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"AccessDenied","type":"codeVoice"},{"type":"text","text":", "},{"code":"InvalidAccessKeyId","type":"codeVoice"},{"type":"text","text":", and "},{"code":"SignatureDoesNotMatch","type":"codeVoice"},{"type":"text","text":" map to "},{"code":"EnsembleError\/authenticationFailure","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"NoSuchKey","type":"codeVoice"},{"type":"text","text":", "},{"code":"NoSuchBucket","type":"codeVoice"},{"type":"text","text":", and "},{"code":"NotFound","type":"codeVoice"},{"type":"text","text":" map to "},{"code":"EnsembleError\/fileAccessFailed","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"All other errors map to "},{"code":"EnsembleError\/serverError","type":"codeVoice"},{"type":"text","text":"."}]}]}],"type":"unorderedList"},{"text":"Dependencies","level":3,"anchor":"Dependencies","type":"heading"},{"inlineContent":[{"type":"text","text":"This module depends on the "},{"overridingTitleInlineContent":[{"type":"text","text":"AWS SDK for Swift"}],"type":"reference","overridingTitle":"AWS SDK for Swift","isActive":true,"identifier":"https:\/\/github.com\/awslabs\/aws-sdk-swift"},{"type":"text","text":" ("},{"type":"codeVoice","code":"AWSS3"},{"type":"text","text":" module)."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/ensembless3"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","topicSections":[{"title":"Cloud File System","identifiers":["doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem"],"anchor":"Cloud-File-System"}],"identifier":{"url":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3","interfaceLanguage":"swift"},"abstract":[{"text":"An Amazon S3-based cloud backend for Ensembles.","type":"text"}],"metadata":{"role":"collection","modules":[{"name":"EnsemblesS3"}],"roleHeading":"Framework","title":"EnsemblesS3","externalID":"EnsemblesS3","symbolKind":"module"},"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"https://github.com/awslabs/aws-sdk-swift":{"title":"AWS SDK for Swift","identifier":"https:\/\/github.com\/awslabs\/aws-sdk-swift","titleInlineContent":[{"text":"AWS SDK for Swift","type":"text"}],"type":"link","url":"https:\/\/github.com\/awslabs\/aws-sdk-swift"},"doc://EnsemblesS3/documentation/EnsemblesS3":{"type":"topic","abstract":[{"text":"An Amazon S3-based cloud backend for Ensembles.","type":"text"}],"role":"collection","identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3","kind":"symbol","title":"EnsemblesS3","url":"\/documentation\/ensembless3"},"doc://EnsemblesS3/documentation/EnsemblesS3/S3CloudFileSystem/keyPrefix":{"url":"\/documentation\/ensembless3\/s3cloudfilesystem\/keyprefix","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"keyPrefix"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"}],"kind":"symbol","identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem\/keyPrefix","abstract":[{"text":"Optional key prefix within the bucket (e.g. “ensembles\/”).","type":"text"},{"text":" ","type":"text"},{"text":"If set, all keys are prefixed with this value.","type":"text"}],"title":"keyPrefix"},"doc://EnsemblesS3/documentation/EnsemblesS3/S3CloudFileSystem":{"type":"topic","abstract":[{"type":"text","text":"A cloud file system backed by Amazon S3, using the AWS SDK for Swift."}],"role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"S3CloudFileSystem"}],"identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem","kind":"symbol","title":"S3CloudFileSystem","navigatorTitle":[{"kind":"identifier","text":"S3CloudFileSystem"}],"url":"\/documentation\/ensembless3\/s3cloudfilesystem"}}}