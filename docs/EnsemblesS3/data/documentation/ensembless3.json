{"identifier":{"url":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"EnsemblesS3 provides ","type":"text"},{"identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem","isActive":true,"type":"reference"},{"text":", an implementation of the Ensembles ","type":"text"},{"code":"CloudFileSystem","type":"codeVoice"},{"text":" protocol that stores sync data in an Amazon S3 bucket. It uses the official ","type":"text"},{"identifier":"https:\/\/github.com\/awslabs\/aws-sdk-swift","isActive":true,"type":"reference"},{"text":" for all API operations.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"S3 is a natural fit for Ensembles — it’s highly durable, globally available, and cost-effective for the small files that Ensembles exchanges. S3-compatible services (MinIO, DigitalOcean Spaces, Backblaze B2, Cloudflare R2) can also be used by configuring the ","type":"text"},{"code":"S3Client","type":"codeVoice"},{"text":" with a custom endpoint.","type":"text"}],"type":"paragraph"},{"level":3,"text":"S3 as a File System","anchor":"S3-as-a-File-System","type":"heading"},{"inlineContent":[{"text":"S3 is a flat key-value store, not a hierarchical file system. ","type":"text"},{"identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem","isActive":true,"type":"reference"},{"text":" simulates directory semantics using key prefixes and ","type":"text"},{"code":"\/","type":"codeVoice"},{"text":" delimiters — the standard S3 convention. For example, the Ensembles path ","type":"text"},{"code":"ensembleId\/events\/data.json","type":"codeVoice"},{"text":" maps to the S3 key ","type":"text"},{"code":"prefix\/ensembleId\/events\/data.json","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Directory creation writes a zero-byte marker object with a trailing ","type":"text"},{"code":"\/","type":"codeVoice"},{"text":" in the key. Directory listing uses ","type":"text"},{"code":"ListObjectsV2","type":"codeVoice"},{"text":" with a delimiter to discover “subdirectories” via common prefixes.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Authentication","anchor":"Authentication","type":"heading"},{"inlineContent":[{"text":"The AWS SDK for Swift supports multiple credential sources (environment variables, IAM roles, SSO, credential files). Your app creates and configures an ","type":"text"},{"code":"S3Client","type":"codeVoice"},{"text":", then injects it:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import EnsemblesS3","import AWSS3","","let s3Client = try await S3Client()  \/\/ Uses default credential chain","let cloudFileSystem = S3CloudFileSystem(","    client: s3Client,","    bucketName: \"my-ensembles-bucket\",","    keyPrefix: \"sync\/\"  \/\/ Optional: isolate Ensembles data under a prefix",")"],"type":"codeListing"},{"level":3,"text":"Setup","anchor":"Setup","type":"heading"},{"syntax":"swift","code":["let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MainStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: S3CloudFileSystem(","        client: s3Client,","        bucketName: \"my-bucket\",","        keyPrefix: \"ensembles\/\"","    )",")","try await ensemble?.attachPersistentStore()"],"type":"codeListing"},{"level":3,"text":"Key Prefix","anchor":"Key-Prefix","type":"heading"},{"inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem\/keyPrefix","isActive":true,"type":"reference"},{"text":" parameter isolates Ensembles data within a shared bucket. For example, with ","type":"text"},{"code":"keyPrefix: \"ensembles\/\"","type":"codeVoice"},{"text":", the path ","type":"text"},{"code":"\/MyStore\/events\/abc.json","type":"codeVoice"},{"text":" maps to the S3 key ","type":"text"},{"code":"ensembles\/MyStore\/events\/abc.json","type":"codeVoice"},{"text":". A trailing ","type":"text"},{"code":"\/","type":"codeVoice"},{"text":" is added automatically if omitted.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If ","type":"text"},{"code":"keyPrefix","type":"codeVoice"},{"text":" is empty (the default), Ensembles data is stored at the bucket root.","type":"text"}],"type":"paragraph"},{"level":3,"text":"S3-Compatible Services","anchor":"S3-Compatible-Services","type":"heading"},{"inlineContent":[{"text":"To use an S3-compatible service, configure the ","type":"text"},{"code":"S3Client","type":"codeVoice"},{"text":" with a custom endpoint:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let config = try await S3Client.S3ClientConfiguration()","config.endpoint = \"https:\/\/s3.us-east-1.amazonaws.com\"  \/\/ or MinIO, R2, etc.","let s3Client = S3Client(config: config)"],"type":"codeListing"},{"level":3,"text":"Error Handling","anchor":"Error-Handling","type":"heading"},{"inlineContent":[{"text":"AWS SDK errors are mapped to ","type":"text"},{"code":"EnsembleError","type":"codeVoice"},{"text":" cases:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"AccessDenied"},{"text":", ","type":"text"},{"type":"codeVoice","code":"InvalidAccessKeyId"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"SignatureDoesNotMatch"},{"text":" map to ","type":"text"},{"type":"codeVoice","code":"EnsembleError\/authenticationFailure"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"NoSuchKey"},{"text":", ","type":"text"},{"type":"codeVoice","code":"NoSuchBucket"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"NotFound"},{"text":" map to ","type":"text"},{"type":"codeVoice","code":"EnsembleError\/fileAccessFailed"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"All other errors map to ","type":"text"},{"type":"codeVoice","code":"EnsembleError\/serverError"},{"text":".","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":3,"text":"Dependencies","anchor":"Dependencies","type":"heading"},{"inlineContent":[{"text":"This module depends on the ","type":"text"},{"identifier":"https:\/\/github.com\/awslabs\/aws-sdk-swift","isActive":true,"overridingTitleInlineContent":[{"text":"AWS SDK for Swift","type":"text"}],"overridingTitle":"AWS SDK for Swift","type":"reference"},{"text":" (","type":"text"},{"code":"AWSS3","type":"codeVoice"},{"text":" module).","type":"text"}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ensembless3"]}],"kind":"symbol","hierarchy":{"paths":[[]]},"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"title":"EnsemblesS3","externalID":"EnsemblesS3","modules":[{"name":"EnsemblesS3"}],"roleHeading":"Framework","role":"collection","symbolKind":"module"},"abstract":[{"text":"An Amazon S3-based cloud backend for Ensembles.","type":"text"}],"topicSections":[{"title":"Cloud File System","anchor":"Cloud-File-System","identifiers":["doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem"]}],"references":{"doc://EnsemblesS3/documentation/EnsemblesS3/S3CloudFileSystem/keyPrefix":{"role":"symbol","type":"topic","url":"\/documentation\/ensembless3\/s3cloudfilesystem\/keyprefix","title":"keyPrefix","abstract":[{"text":"Optional key prefix within the bucket (e.g. “ensembles\/”).","type":"text"},{"type":"text","text":" "},{"type":"text","text":"If set, all keys are prefixed with this value."}],"identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem\/keyPrefix","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"keyPrefix"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"}],"kind":"symbol"},"doc://EnsemblesS3/documentation/EnsemblesS3":{"url":"\/documentation\/ensembless3","identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3","kind":"symbol","role":"collection","type":"topic","abstract":[{"text":"An Amazon S3-based cloud backend for Ensembles.","type":"text"}],"title":"EnsemblesS3"},"doc://EnsemblesS3/documentation/EnsemblesS3/S3CloudFileSystem":{"abstract":[{"type":"text","text":"A cloud file system backed by Amazon S3, using the AWS SDK for Swift."}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"S3CloudFileSystem","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem","title":"S3CloudFileSystem","navigatorTitle":[{"text":"S3CloudFileSystem","kind":"identifier"}],"role":"symbol","kind":"symbol","url":"\/documentation\/ensembless3\/s3cloudfilesystem"},"https://github.com/awslabs/aws-sdk-swift":{"title":"AWS SDK for Swift","titleInlineContent":[{"text":"AWS SDK for Swift","type":"text"}],"identifier":"https:\/\/github.com\/awslabs\/aws-sdk-swift","url":"https:\/\/github.com\/awslabs\/aws-sdk-swift","type":"link"}}}