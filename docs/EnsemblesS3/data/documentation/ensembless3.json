{"kind":"symbol","abstract":[{"text":"An Amazon S3-based cloud backend for Ensembles.","type":"text"}],"topicSections":[{"title":"Cloud File System","anchor":"Cloud-File-System","identifiers":["doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem"]}],"metadata":{"roleHeading":"Framework","role":"collection","modules":[{"name":"EnsemblesS3"}],"title":"EnsemblesS3","externalID":"EnsemblesS3","symbolKind":"module"},"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3"},"hierarchy":{"paths":[[]]},"primaryContentSections":[{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"EnsemblesS3 provides ","type":"text"},{"identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem","type":"reference","isActive":true},{"text":", an implementation of the Ensembles ","type":"text"},{"code":"CloudFileSystem","type":"codeVoice"},{"text":" protocol that stores sync data in an Amazon S3 bucket. It uses the official ","type":"text"},{"identifier":"https:\/\/github.com\/awslabs\/aws-sdk-swift","type":"reference","isActive":true},{"text":" for all API operations.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"S3 is a natural fit for Ensembles — it’s highly durable, globally available, and cost-effective for the small files that Ensembles exchanges. S3-compatible services (MinIO, DigitalOcean Spaces, Backblaze B2, Cloudflare R2) can also be used by configuring the ","type":"text"},{"code":"S3Client","type":"codeVoice"},{"text":" with a custom endpoint.","type":"text"}]},{"text":"S3 as a File System","level":3,"type":"heading","anchor":"S3-as-a-File-System"},{"type":"paragraph","inlineContent":[{"text":"S3 is a flat key-value store, not a hierarchical file system. ","type":"text"},{"identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem","type":"reference","isActive":true},{"text":" simulates directory semantics using key prefixes and ","type":"text"},{"code":"\/","type":"codeVoice"},{"text":" delimiters — the standard S3 convention. For example, the Ensembles path ","type":"text"},{"code":"ensembleId\/events\/data.json","type":"codeVoice"},{"text":" maps to the S3 key ","type":"text"},{"code":"prefix\/ensembleId\/events\/data.json","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Directory creation writes a zero-byte marker object with a trailing ","type":"text"},{"code":"\/","type":"codeVoice"},{"text":" in the key. Directory listing uses ","type":"text"},{"code":"ListObjectsV2","type":"codeVoice"},{"text":" with a delimiter to discover “subdirectories” via common prefixes.","type":"text"}]},{"text":"Authentication","level":3,"type":"heading","anchor":"Authentication"},{"type":"paragraph","inlineContent":[{"text":"The AWS SDK for Swift supports multiple credential sources (environment variables, IAM roles, SSO, credential files). Your app creates and configures an ","type":"text"},{"code":"S3Client","type":"codeVoice"},{"text":", then injects it:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import EnsemblesS3","import AWSS3","","let s3Client = try await S3Client()  \/\/ Uses default credential chain","let cloudFileSystem = S3CloudFileSystem(","    client: s3Client,","    bucketName: \"my-ensembles-bucket\",","    keyPrefix: \"sync\/\"  \/\/ Optional: isolate Ensembles data under a prefix",")"]},{"type":"heading","level":3,"text":"Setup","anchor":"Setup"},{"syntax":"swift","code":["let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MainStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: S3CloudFileSystem(","        client: s3Client,","        bucketName: \"my-bucket\",","        keyPrefix: \"ensembles\/\"","    )",")","try await ensemble?.attachPersistentStore()"],"type":"codeListing"},{"type":"heading","level":3,"text":"Key Prefix","anchor":"Key-Prefix"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem\/keyPrefix","isActive":true},{"type":"text","text":" parameter isolates Ensembles data within a shared bucket. For example, with "},{"type":"codeVoice","code":"keyPrefix: \"ensembles\/\""},{"type":"text","text":", the path "},{"type":"codeVoice","code":"\/MyStore\/events\/abc.json"},{"type":"text","text":" maps to the S3 key "},{"type":"codeVoice","code":"ensembles\/MyStore\/events\/abc.json"},{"text":". A trailing ","type":"text"},{"type":"codeVoice","code":"\/"},{"text":" is added automatically if omitted.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If ","type":"text"},{"code":"keyPrefix","type":"codeVoice"},{"text":" is empty (the default), Ensembles data is stored at the bucket root.","type":"text"}]},{"text":"S3-Compatible Services","level":3,"type":"heading","anchor":"S3-Compatible-Services"},{"type":"paragraph","inlineContent":[{"text":"To use an S3-compatible service, configure the ","type":"text"},{"code":"S3Client","type":"codeVoice"},{"text":" with a custom endpoint:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let config = try await S3Client.S3ClientConfiguration()","config.endpoint = \"https:\/\/s3.us-east-1.amazonaws.com\"  \/\/ or MinIO, R2, etc.","let s3Client = S3Client(config: config)"]},{"text":"Error Handling","level":3,"type":"heading","anchor":"Error-Handling"},{"type":"paragraph","inlineContent":[{"text":"AWS SDK errors are mapped to ","type":"text"},{"code":"EnsembleError","type":"codeVoice"},{"text":" cases:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"AccessDenied"},{"text":", ","type":"text"},{"type":"codeVoice","code":"InvalidAccessKeyId"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"SignatureDoesNotMatch"},{"text":" map to ","type":"text"},{"type":"codeVoice","code":"EnsembleError\/authenticationFailure"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"NoSuchKey"},{"text":", ","type":"text"},{"type":"codeVoice","code":"NoSuchBucket"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"NotFound"},{"text":" map to ","type":"text"},{"type":"codeVoice","code":"EnsembleError\/fileAccessFailed"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"All other errors map to ","type":"text"},{"type":"codeVoice","code":"EnsembleError\/serverError"},{"text":".","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Dependencies","level":3,"type":"heading","anchor":"Dependencies"},{"type":"paragraph","inlineContent":[{"text":"This module depends on the ","type":"text"},{"overridingTitle":"AWS SDK for Swift","identifier":"https:\/\/github.com\/awslabs\/aws-sdk-swift","type":"reference","isActive":true,"overridingTitleInlineContent":[{"type":"text","text":"AWS SDK for Swift"}]},{"text":" (","type":"text"},{"code":"AWSS3","type":"codeVoice"},{"text":" module).","type":"text"}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ensembless3"]}],"sections":[],"references":{"doc://EnsemblesS3/documentation/EnsemblesS3":{"kind":"symbol","abstract":[{"type":"text","text":"An Amazon S3-based cloud backend for Ensembles."}],"url":"\/documentation\/ensembless3","type":"topic","identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3","title":"EnsemblesS3","role":"collection"},"https://github.com/awslabs/aws-sdk-swift":{"title":"AWS SDK for Swift","identifier":"https:\/\/github.com\/awslabs\/aws-sdk-swift","titleInlineContent":[{"text":"AWS SDK for Swift","type":"text"}],"url":"https:\/\/github.com\/awslabs\/aws-sdk-swift","type":"link"},"doc://EnsemblesS3/documentation/EnsemblesS3/S3CloudFileSystem":{"navigatorTitle":[{"text":"S3CloudFileSystem","kind":"identifier"}],"identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem","url":"\/documentation\/ensembless3\/s3cloudfilesystem","kind":"symbol","role":"symbol","title":"S3CloudFileSystem","type":"topic","abstract":[{"type":"text","text":"A cloud file system backed by Amazon S3, using the AWS SDK for Swift."}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"S3CloudFileSystem"}]},"doc://EnsemblesS3/documentation/EnsemblesS3/S3CloudFileSystem/keyPrefix":{"kind":"symbol","abstract":[{"text":"Optional key prefix within the bucket (e.g. “ensembles\/”).","type":"text"},{"text":" ","type":"text"},{"text":"If set, all keys are prefixed with this value.","type":"text"}],"url":"\/documentation\/ensembless3\/s3cloudfilesystem\/keyprefix","type":"topic","title":"keyPrefix","identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem\/keyPrefix","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"keyPrefix"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"}]}}}