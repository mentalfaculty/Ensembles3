{"identifier":{"url":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3","interfaceLanguage":"swift"},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"EnsemblesS3 provides "},{"identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem","type":"reference","isActive":true},{"type":"text","text":", an implementation of the Ensembles "},{"type":"codeVoice","code":"CloudFileSystem"},{"type":"text","text":" protocol that stores sync data in an Amazon S3 bucket. It uses the official "},{"identifier":"https:\/\/github.com\/awslabs\/aws-sdk-swift","type":"reference","isActive":true},{"type":"text","text":" for all API operations."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"S3 is a natural fit for Ensembles — it’s highly durable, globally available, and cost-effective for the small files that Ensembles exchanges. S3-compatible services (MinIO, DigitalOcean Spaces, Backblaze B2, Cloudflare R2) can also be used by configuring the "},{"type":"codeVoice","code":"S3Client"},{"type":"text","text":" with a custom endpoint."}]},{"text":"S3 as a File System","type":"heading","level":3,"anchor":"S3-as-a-File-System"},{"type":"paragraph","inlineContent":[{"type":"text","text":"S3 is a flat key-value store, not a hierarchical file system. "},{"identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem","type":"reference","isActive":true},{"type":"text","text":" simulates directory semantics using key prefixes and "},{"type":"codeVoice","code":"\/"},{"type":"text","text":" delimiters — the standard S3 convention. For example, the Ensembles path "},{"type":"codeVoice","code":"ensembleId\/events\/data.json"},{"type":"text","text":" maps to the S3 key "},{"type":"codeVoice","code":"prefix\/ensembleId\/events\/data.json"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Directory creation writes a zero-byte marker object with a trailing "},{"type":"codeVoice","code":"\/"},{"type":"text","text":" in the key. Directory listing uses "},{"type":"codeVoice","code":"ListObjectsV2"},{"type":"text","text":" with a delimiter to discover “subdirectories” via common prefixes."}]},{"text":"Authentication","type":"heading","level":3,"anchor":"Authentication"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The AWS SDK for Swift supports multiple credential sources (environment variables, IAM roles, SSO, credential files). Your app creates and configures an "},{"type":"codeVoice","code":"S3Client"},{"type":"text","text":", then injects it:"}]},{"code":["import EnsemblesS3","import AWSS3","","let s3Client = try await S3Client()  \/\/ Uses default credential chain","let cloudFileSystem = S3CloudFileSystem(","    client: s3Client,","    bucketName: \"my-ensembles-bucket\",","    keyPrefix: \"sync\/\"  \/\/ Optional: isolate Ensembles data under a prefix",")"],"type":"codeListing","syntax":"swift"},{"text":"Setup","type":"heading","level":3,"anchor":"Setup"},{"code":["let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MainStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: S3CloudFileSystem(","        client: s3Client,","        bucketName: \"my-bucket\",","        keyPrefix: \"ensembles\/\"","    )",")","try await ensemble?.attachPersistentStore()"],"type":"codeListing","syntax":"swift"},{"text":"Key Prefix","type":"heading","level":3,"anchor":"Key-Prefix"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem\/keyPrefix","type":"reference","isActive":true},{"type":"text","text":" parameter isolates Ensembles data within a shared bucket. For example, with "},{"type":"codeVoice","code":"keyPrefix: \"ensembles\/\""},{"type":"text","text":", the path "},{"type":"codeVoice","code":"\/MyStore\/events\/abc.json"},{"type":"text","text":" maps to the S3 key "},{"type":"codeVoice","code":"ensembles\/MyStore\/events\/abc.json"},{"type":"text","text":". A trailing "},{"type":"codeVoice","code":"\/"},{"type":"text","text":" is added automatically if omitted."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If "},{"type":"codeVoice","code":"keyPrefix"},{"type":"text","text":" is empty (the default), Ensembles data is stored at the bucket root."}]},{"text":"S3-Compatible Services","type":"heading","level":3,"anchor":"S3-Compatible-Services"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To use an S3-compatible service, configure the "},{"type":"codeVoice","code":"S3Client"},{"type":"text","text":" with a custom endpoint:"}]},{"code":["let config = try await S3Client.S3ClientConfiguration()","config.endpoint = \"https:\/\/s3.us-east-1.amazonaws.com\"  \/\/ or MinIO, R2, etc.","let s3Client = S3Client(config: config)"],"type":"codeListing","syntax":"swift"},{"text":"Error Handling","type":"heading","level":3,"anchor":"Error-Handling"},{"type":"paragraph","inlineContent":[{"type":"text","text":"AWS SDK errors are mapped to "},{"type":"codeVoice","code":"EnsembleError"},{"type":"text","text":" cases:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"AccessDenied","type":"codeVoice"},{"text":", ","type":"text"},{"code":"InvalidAccessKeyId","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"SignatureDoesNotMatch","type":"codeVoice"},{"text":" map to ","type":"text"},{"code":"EnsembleError\/authenticationFailure","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"NoSuchKey","type":"codeVoice"},{"text":", ","type":"text"},{"code":"NoSuchBucket","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"NotFound","type":"codeVoice"},{"text":" map to ","type":"text"},{"code":"EnsembleError\/fileAccessFailed","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"All other errors map to ","type":"text"},{"code":"EnsembleError\/serverError","type":"codeVoice"},{"text":".","type":"text"}]}]}],"type":"unorderedList"},{"text":"Dependencies","type":"heading","level":3,"anchor":"Dependencies"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This module depends on the "},{"overridingTitle":"AWS SDK for Swift","identifier":"https:\/\/github.com\/awslabs\/aws-sdk-swift","type":"reference","isActive":true,"overridingTitleInlineContent":[{"type":"text","text":"AWS SDK for Swift"}]},{"type":"text","text":" ("},{"type":"codeVoice","code":"AWSS3"},{"type":"text","text":" module)."}]}]}],"hierarchy":{"paths":[[]]},"kind":"symbol","schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"An Amazon S3-based cloud backend for Ensembles.","type":"text"}],"topicSections":[{"identifiers":["doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem"],"anchor":"Cloud-File-System","title":"Cloud File System"}],"metadata":{"externalID":"EnsemblesS3","symbolKind":"module","modules":[{"name":"EnsemblesS3"}],"roleHeading":"Framework","role":"collection","title":"EnsemblesS3"},"variants":[{"paths":["\/documentation\/ensembless3"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://EnsemblesS3/documentation/EnsemblesS3":{"title":"EnsemblesS3","identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3","role":"collection","abstract":[{"type":"text","text":"An Amazon S3-based cloud backend for Ensembles."}],"kind":"symbol","url":"\/documentation\/ensembless3","type":"topic"},"doc://EnsemblesS3/documentation/EnsemblesS3/S3CloudFileSystem/keyPrefix":{"abstract":[{"type":"text","text":"Optional key prefix within the bucket (e.g. “ensembles\/”)."},{"type":"text","text":" "},{"type":"text","text":"If set, all keys are prefixed with this value."}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem\/keyPrefix","url":"\/documentation\/ensembless3\/s3cloudfilesystem\/keyprefix","type":"topic","title":"keyPrefix","fragments":[{"text":"let","kind":"keyword"},{"kind":"text","text":" "},{"text":"keyPrefix","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"}]},"doc://EnsemblesS3/documentation/EnsemblesS3/S3CloudFileSystem":{"title":"S3CloudFileSystem","identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem","role":"symbol","abstract":[{"type":"text","text":"A cloud file system backed by Amazon S3, using the AWS SDK for Swift."}],"kind":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"S3CloudFileSystem","kind":"identifier"}],"url":"\/documentation\/ensembless3\/s3cloudfilesystem","type":"topic","navigatorTitle":[{"text":"S3CloudFileSystem","kind":"identifier"}]},"https://github.com/awslabs/aws-sdk-swift":{"url":"https:\/\/github.com\/awslabs\/aws-sdk-swift","identifier":"https:\/\/github.com\/awslabs\/aws-sdk-swift","titleInlineContent":[{"text":"AWS SDK for Swift","type":"text"}],"title":"AWS SDK for Swift","type":"link"}}}