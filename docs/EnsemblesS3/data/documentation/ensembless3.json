{"topicSections":[{"anchor":"Cloud-File-System","title":"Cloud File System","identifiers":["doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem"]}],"hierarchy":{"paths":[[]]},"kind":"symbol","sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"role":"collection","title":"EnsemblesS3","externalID":"EnsemblesS3","symbolKind":"module","roleHeading":"Framework","modules":[{"name":"EnsemblesS3"}]},"identifier":{"url":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3","interfaceLanguage":"swift"},"abstract":[{"text":"An Amazon S3-based cloud backend for Ensembles.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"EnsemblesS3 provides "},{"identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem","type":"reference","isActive":true},{"type":"text","text":", an implementation of the Ensembles "},{"type":"codeVoice","code":"CloudFileSystem"},{"type":"text","text":" protocol that stores sync data in an Amazon S3 bucket. It uses the official "},{"identifier":"https:\/\/github.com\/awslabs\/aws-sdk-swift","type":"reference","isActive":true},{"type":"text","text":" for all API operations."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"S3 is a natural fit for Ensembles — it’s highly durable, globally available, and cost-effective for the small files that Ensembles exchanges. S3-compatible services (MinIO, DigitalOcean Spaces, Backblaze B2, Cloudflare R2) can also be used by configuring the "},{"type":"codeVoice","code":"S3Client"},{"type":"text","text":" with a custom endpoint."}]},{"text":"S3 as a File System","type":"heading","level":3,"anchor":"S3-as-a-File-System"},{"type":"paragraph","inlineContent":[{"type":"text","text":"S3 is a flat key-value store, not a hierarchical file system. "},{"identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem","type":"reference","isActive":true},{"type":"text","text":" simulates directory semantics using key prefixes and "},{"type":"codeVoice","code":"\/"},{"type":"text","text":" delimiters — the standard S3 convention. For example, the Ensembles path "},{"type":"codeVoice","code":"ensembleId\/events\/data.json"},{"type":"text","text":" maps to the S3 key "},{"type":"codeVoice","code":"prefix\/ensembleId\/events\/data.json"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Directory creation writes a zero-byte marker object with a trailing "},{"type":"codeVoice","code":"\/"},{"type":"text","text":" in the key. Directory listing uses "},{"type":"codeVoice","code":"ListObjectsV2"},{"type":"text","text":" with a delimiter to discover “subdirectories” via common prefixes."}]},{"text":"Authentication","type":"heading","level":3,"anchor":"Authentication"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The AWS SDK for Swift supports multiple credential sources (environment variables, IAM roles, SSO, credential files). Your app creates and configures an "},{"type":"codeVoice","code":"S3Client"},{"type":"text","text":", then injects it:"}]},{"syntax":"swift","type":"codeListing","code":["import EnsemblesS3","import AWSS3","","let s3Client = try await S3Client()  \/\/ Uses default credential chain","let cloudFileSystem = S3CloudFileSystem(","    client: s3Client,","    bucketName: \"my-ensembles-bucket\",","    keyPrefix: \"sync\/\"  \/\/ Optional: isolate Ensembles data under a prefix",")"]},{"text":"Setup","type":"heading","level":3,"anchor":"Setup"},{"syntax":"swift","type":"codeListing","code":["let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MainStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: S3CloudFileSystem(","        client: s3Client,","        bucketName: \"my-bucket\",","        keyPrefix: \"ensembles\/\"","    )",")","try await ensemble?.attachPersistentStore()"]},{"text":"Key Prefix","type":"heading","level":3,"anchor":"Key-Prefix"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem\/keyPrefix","type":"reference","isActive":true},{"type":"text","text":" parameter isolates Ensembles data within a shared bucket. For example, with "},{"type":"codeVoice","code":"keyPrefix: \"ensembles\/\""},{"type":"text","text":", the path "},{"type":"codeVoice","code":"\/MyStore\/events\/abc.json"},{"type":"text","text":" maps to the S3 key "},{"type":"codeVoice","code":"ensembles\/MyStore\/events\/abc.json"},{"type":"text","text":". A trailing "},{"type":"codeVoice","code":"\/"},{"type":"text","text":" is added automatically if omitted."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If "},{"type":"codeVoice","code":"keyPrefix"},{"type":"text","text":" is empty (the default), Ensembles data is stored at the bucket root."}]},{"text":"S3-Compatible Services","type":"heading","level":3,"anchor":"S3-Compatible-Services"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To use an S3-compatible service, configure the "},{"type":"codeVoice","code":"S3Client"},{"type":"text","text":" with a custom endpoint:"}]},{"syntax":"swift","type":"codeListing","code":["let config = try await S3Client.S3ClientConfiguration()","config.endpoint = \"https:\/\/s3.us-east-1.amazonaws.com\"  \/\/ or MinIO, R2, etc.","let s3Client = S3Client(config: config)"]},{"text":"Error Handling","type":"heading","level":3,"anchor":"Error-Handling"},{"type":"paragraph","inlineContent":[{"text":"AWS SDK errors are mapped to ","type":"text"},{"code":"EnsembleError","type":"codeVoice"},{"text":" cases:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AccessDenied"},{"type":"text","text":", "},{"type":"codeVoice","code":"InvalidAccessKeyId"},{"type":"text","text":", and "},{"type":"codeVoice","code":"SignatureDoesNotMatch"},{"type":"text","text":" map to "},{"type":"codeVoice","code":"EnsembleError\/authenticationFailure"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"NoSuchKey","type":"codeVoice"},{"text":", ","type":"text"},{"code":"NoSuchBucket","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"NotFound","type":"codeVoice"},{"text":" map to ","type":"text"},{"type":"codeVoice","code":"EnsembleError\/fileAccessFailed"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"text":"All other errors map to ","type":"text"},{"type":"codeVoice","code":"EnsembleError\/serverError"},{"type":"text","text":"."}],"type":"paragraph"}]}]},{"type":"heading","text":"Dependencies","level":3,"anchor":"Dependencies"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This module depends on the "},{"type":"reference","identifier":"https:\/\/github.com\/awslabs\/aws-sdk-swift","overridingTitleInlineContent":[{"type":"text","text":"AWS SDK for Swift"}],"isActive":true,"overridingTitle":"AWS SDK for Swift"},{"type":"text","text":" ("},{"type":"codeVoice","code":"AWSS3"},{"type":"text","text":" module)."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ensembless3"]}],"references":{"doc://EnsemblesS3/documentation/EnsemblesS3/S3CloudFileSystem/keyPrefix":{"title":"keyPrefix","url":"\/documentation\/ensembless3\/s3cloudfilesystem\/keyprefix","type":"topic","abstract":[{"text":"Optional key prefix within the bucket (e.g. “ensembles\/”).","type":"text"},{"text":" ","type":"text"},{"text":"If set, all keys are prefixed with this value.","type":"text"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"keyPrefix"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"}],"identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem\/keyPrefix","role":"symbol"},"https://github.com/awslabs/aws-sdk-swift":{"title":"AWS SDK for Swift","identifier":"https:\/\/github.com\/awslabs\/aws-sdk-swift","type":"link","url":"https:\/\/github.com\/awslabs\/aws-sdk-swift","titleInlineContent":[{"type":"text","text":"AWS SDK for Swift"}]},"doc://EnsemblesS3/documentation/EnsemblesS3/S3CloudFileSystem":{"title":"S3CloudFileSystem","role":"symbol","abstract":[{"type":"text","text":"A cloud file system backed by Amazon S3, using the AWS SDK for Swift."}],"kind":"symbol","identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3\/S3CloudFileSystem","url":"\/documentation\/ensembless3\/s3cloudfilesystem","navigatorTitle":[{"text":"S3CloudFileSystem","kind":"identifier"}],"type":"topic","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"S3CloudFileSystem"}]},"doc://EnsemblesS3/documentation/EnsemblesS3":{"abstract":[{"type":"text","text":"An Amazon S3-based cloud backend for Ensembles."}],"identifier":"doc:\/\/EnsemblesS3\/documentation\/EnsemblesS3","kind":"symbol","type":"topic","title":"EnsemblesS3","url":"\/documentation\/ensembless3","role":"collection"}}}