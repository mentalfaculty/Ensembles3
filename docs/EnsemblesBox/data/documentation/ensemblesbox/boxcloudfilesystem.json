larations":[{"languages":["swift"],"tokens":[{"text":"final","kind":"keyword"},{"text":" ","kind":"text"},{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BoxCloudFileSystem","kind":"identifier"}],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"name":"Important","type":"aside","style":"important","content":[{"inlineContent":[{"type":"text","text":"This backend requires the "},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/box\/box-ios-sdk.git"},{"text":" ","type":"text"},{"type":"text","text":"package. With the source distribution, enable the "},{"type":"codeVoice","code":"Box"},{"type":"text","text":" package trait and SPM resolves it"},{"type":"text","text":" "},{"type":"text","text":"automatically. With the binary distribution (XCFrameworks), add BoxSDK as a separate"},{"type":"text","text":" "},{"type":"text","text":"package dependency in your project."}],"type":"paragraph"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Box uses numeric IDs rather than paths to identify files and folders. This backend"},{"type":"text","text":" "},{"type":"text","text":"bridges the path-based "},{"type":"codeVoice","code":"CloudFileSystem"},{"type":"text","text":" protocol onto Box’s ID-based API by"},{"type":"text","text":" "},{"type":"text","text":"walking the folder hierarchy to resolve Ensembles paths"},{"type":"text","text":" "},{"type":"text","text":"(e.g. "},{"type":"codeVoice","code":"ensembleId\/events\/file.json"},{"type":"text","text":") to Box folder and file IDs."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Resolved IDs are cached in internal dictionaries to minimize API calls. The cache"},{"type":"text","text":" "},{"type":"text","text":"is invalidated when items are deleted or when not-found errors indicate stale entries."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The app creates and configures a "},{"type":"codeVoice","code":"BoxClient"},{"type":"text","text":" with its own authentication"},{"type":"text","text":" "},{"type":"text","text":"and injects it at init time:"}]},{"type":"codeListing","code":["let auth = BoxDeveloperTokenAuth(token: \"your-token\")","let client = BoxClient(auth: auth)","let cloudFS = BoxCloudFileSystem(client: client)"],"syntax":"swift"},{"type":"heading","anchor":"Authentication","text":"Authentication","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Box Swift SDK supports multiple authentication methods. Create a"},{"type":"text","text":" "},{"type":"codeVoice","code":"BoxClient"},{"type":"text","text":" with the appropriate auth for your use case:"}]},{"type":"heading","anchor":"Developer-Token-testing-only","text":"Developer Token (testing only)","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Get a short-lived token from "},{"type":"reference","isActive":true,"identifier":"https:\/\/developer.box.com\/"},{"type":"text","text":" "},{"type":"text","text":"under your app’s configuration page. These tokens expire after 60 minutes."}]},{"type":"codeListing","code":["let auth = BoxDeveloperTokenAuth(token: \"your-developer-token\")","let client = BoxClient(auth: auth)","let cloudFS = BoxCloudFileSystem(client: client)"],"syntax":"swift"},{"type":"heading","anchor":"OAuth-20-production-apps","text":"OAuth 2.0 (production apps)","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Register your app at "},{"type":"reference","isActive":true,"overridingTitleInlineContent":[{"type":"text","text":"developer.box.com"}],"overridingTitle":"developer.box.com","identifier":"https:\/\/developer.box.com\/"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"text","text":"configure an OAuth 2.0 redirect URI:"}]},{"type":"codeListing","code":["let config = OAuthConfig(clientId: \"your-client-id\", clientSecret: \"your-secret\")","let auth = BoxOAuth(config: config)","\/\/ Call auth.authorize(url:) with your redirect URL after the OAuth flow","let client = BoxClient(auth: auth)","let cloudFS = BoxCloudFileSystem(client: client)"],"syntax":"swift"},{"type":"heading","anchor":"Client-Credentials-Grant-server-side","text":"Client Credentials Grant (server-side)","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"For server-to-server integration without user interaction:"}]},{"type":"codeListing","code":["let config = CCGConfig(","    clientId: \"your-client-id\",","    clientSecret: \"your-secret\",","    userId: \"user-id\"",")","let auth = BoxCCGAuth(config: config)","let client = BoxClient(auth: auth)","let cloudFS = BoxCloudFileSystem(client: client)"],"syntax":"swift"},{"type":"heading","anchor":"Threading","text":"Threading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"This class is "},{"type":"codeVoice","code":"@unchecked Sendable"},{"type":"text","text":". The "},{"type":"codeVoice","code":"BoxClient"},{"type":"text","text":" handles its own thread"},{"type":"text","text":" "},{"type":"text","text":"safety internally. Mutable state (caches, "},{"type":"codeVoice","code":"loggedIn"},{"type":"text","text":" flag) is accessed only"},{"type":"text","text":" "},{"type":"text","text":"from async methods that are serialized by the ensemble’s operation queue."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ensemblesbox\/boxcloudfilesystem"]}],"abstract":[{"text":"A cloud file system backed by Box, using the Box Swift SDK (","type":"text"},{"type":"codeVoice","code":"BoxSdkGen"},{"text":").","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem"},"relationshipsSections":[{"title":"Conforms To","kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/EnsemblesBox\/9Ensembles15CloudFileSystemP","doc:\/\/EnsemblesBox\/s8SendableP","