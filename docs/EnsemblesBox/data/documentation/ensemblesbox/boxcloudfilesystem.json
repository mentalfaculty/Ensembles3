{"abstract":[{"text":"A cloud file system backed by Box, using the Box Swift SDK (","type":"text"},{"code":"BoxSdkGen","type":"codeVoice"},{"text":").","type":"text"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"BoxCloudFileSystem"}]}],"kind":"declarations"},{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"style":"important","content":[{"inlineContent":[{"type":"text","text":"This backend requires the "},{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/box\/box-ios-sdk.git"},{"type":"text","text":" "},{"type":"text","text":"package. With the source distribution, enable the "},{"type":"codeVoice","code":"Box"},{"type":"text","text":" package trait and SPM resolves it"},{"type":"text","text":" "},{"type":"text","text":"automatically. With the binary distribution (XCFrameworks), add BoxSDK as a separate"},{"type":"text","text":" "},{"type":"text","text":"package dependency in your project."}],"type":"paragraph"}],"name":"Important","type":"aside"},{"inlineContent":[{"text":"Box uses numeric IDs rather than paths to identify files and folders. This backend","type":"text"},{"text":" ","type":"text"},{"text":"bridges the path-based ","type":"text"},{"type":"codeVoice","code":"CloudFileSystem"},{"text":" protocol onto Box’s ID-based API by","type":"text"},{"text":" ","type":"text"},{"text":"walking the folder hierarchy to resolve Ensembles paths","type":"text"},{"text":" ","type":"text"},{"text":"(e.g. ","type":"text"},{"type":"codeVoice","code":"ensembleId\/events\/file.json"},{"text":") to Box folder and file IDs.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Resolved IDs are cached in internal dictionaries to minimize API calls. The cache","type":"text"},{"text":" ","type":"text"},{"text":"is invalidated when items are deleted or when not-found errors indicate stale entries.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The app creates and configures a ","type":"text"},{"type":"codeVoice","code":"BoxClient"},{"text":" with its own authentication","type":"text"},{"text":" ","type":"text"},{"text":"and injects it at init time:","type":"text"}],"type":"paragraph"},{"code":["let auth = BoxDeveloperTokenAuth(token: \"your-token\")","let client = BoxClient(auth: auth)","let cloudFS = BoxCloudFileSystem(client: client)"],"syntax":"swift","type":"codeListing"},{"level":2,"text":"Authentication","type":"heading","anchor":"Authentication"},{"inlineContent":[{"text":"The Box Swift SDK supports multiple authentication methods. Create a","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"BoxClient"},{"text":" with the appropriate auth for your use case:","type":"text"}],"type":"paragraph"},{"level":3,"text":"Developer Token (testing only)","type":"heading","anchor":"Developer-Token-testing-only"},{"inlineContent":[{"text":"Get a short-lived token from ","type":"text"},{"type":"reference","identifier":"https:\/\/developer.box.com\/","isActive":true},{"text":" ","type":"text"},{"text":"under your app’s configuration page. These tokens expire after 60 minutes.","type":"text"}],"type":"paragraph"},{"code":["let auth = BoxDeveloperTokenAuth(token: \"your-developer-token\")","let client = BoxClient(auth: auth)","let cloudFS = BoxCloudFileSystem(client: client)"],"syntax":"swift","type":"codeListing"},{"level":3,"text":"OAuth 2.0 (production apps)","type":"heading","anchor":"OAuth-20-production-apps"},{"inlineContent":[{"text":"Register your app at ","type":"text"},{"overridingTitle":"developer.box.com","overridingTitleInlineContent":[{"type":"text","text":"developer.box.com"}],"type":"reference","identifier":"https:\/\/developer.box.com\/","isActive":true},{"text":" and","type":"text"},{"text":" ","type":"text"},{"text":"configure an OAuth 2.0 redirect URI:","type":"text"}],"type":"paragraph"},{"code":["let config = OAuthConfig(clientId: \"your-client-id\", clientSecret: \"your-secret\")","let auth = BoxOAuth(config: config)","\/\/ Call auth.authorize(url:) with your redirect URL after the OAuth flow","let client = BoxClient(auth: auth)","let cloudFS = BoxCloudFileSystem(client: client)"],"syntax":"swift","type":"codeListing"},{"level":3,"text":"Client Credentials Grant (server-side)","type":"heading","anchor":"Client-Credentials-Grant-server-side"},{"inlineContent":[{"text":"For server-to-server integration without user interaction:","type":"text"}],"type":"paragraph"},{"code":["let config = CCGConfig(","    clientId: \"your-client-id\",","    clientSecret: \"your-secret\",","    userId: \"user-id\"",")","let auth = BoxCCGAuth(config: config)","let client = BoxClient(auth: auth)","let cloudFS = BoxCloudFileSystem(client: client)"],"syntax":"swift","type":"codeListing"},{"level":2,"text":"Threading","type":"heading","anchor":"Threading"},{"inlineContent":[{"text":"This class is ","type":"text"},{"type":"codeVoice","code":"@unchecked Sendable"},{"text":". The ","type":"text"},{"type":"codeVoice","code":"BoxClient"},{"text":" handles its own thread","type":"text"},{"text":" ","type":"text"},{"text":"safety internally. Mutable state (caches, ","type":"text"},{"type":"codeVoice","code":"loggedIn"},{"text":" flag) is accessed only","type":"text"},{"text":" ","type":"text"},{"text":"from async methods that are serialized by the ensemble’s operation queue.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"relationshipsSections":[{"title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/EnsemblesBox\/9Ensembles15CloudFileSystemP","doc:\/\/EnsemblesBox\/s8SendableP","doc:\/\/EnsemblesBox\/s16SendableMetatypeP"],"type":"conformsTo"}],"topicSections":[{"generated":true,"title":"Initializers","anchor":"Initializers","identifiers":["doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFil