ype":"text"},{"text":" ","type":"text"},{"text":"walking the folder hierarchy to resolve Ensembles paths","type":"text"},{"text":" ","type":"text"},{"text":"(e.g. ","type":"text"},{"code":"ensembleId\/events\/file.json","type":"codeVoice"},{"text":") to Box folder and file IDs.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Resolved IDs are cached in internal dictionaries to minimize API calls. The cache","type":"text"},{"text":" ","type":"text"},{"text":"is invalidated when items are deleted or when not-found errors indicate stale entries.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The app creates and configures a ","type":"text"},{"code":"BoxClient","type":"codeVoice"},{"text":" with its own authentication","type":"text"},{"text":" ","type":"text"},{"text":"and injects it at init time:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let auth = BoxDeveloperTokenAuth(token: \"your-token\")","let client = BoxClient(auth: auth)","let cloudFS = BoxCloudFileSystem(client: client)"]},{"level":2,"type":"heading","text":"Authentication","anchor":"Authentication"},{"type":"paragraph","inlineContent":[{"text":"The Box Swift SDK supports multiple authentication methods. Create a","type":"text"},{"text":" ","type":"text"},{"code":"BoxClient","type":"codeVoice"},{"text":" with the appropriate auth for your use case:","type":"text"}]},{"level":3,"type":"heading","text":"Developer Token (testing only)","anchor":"Developer-Token-testing-only"},{"type":"paragraph","inlineContent":[{"text":"Get a short-lived token from ","type":"text"},{"identifier":"https:\/\/developer.box.com\/","type":"reference","isActive":true},{"text":" ","type":"text"},{"text":"under your app’s configuration page. These tokens expire after 60 minutes.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let auth = BoxDeveloperTokenAuth(token: \"your-developer-token\")","let client = BoxClient(auth: auth)","let cloudFS = BoxCloudFileSystem(cl