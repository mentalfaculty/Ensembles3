{"topicSections":[{"identifiers":["doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem\/init(client:)"],"title":"Initializers","generated":true,"anchor":"Initializers"},{"identifiers":["doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem\/client","doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem\/isConnected"],"title":"Instance Properties","generated":true,"anchor":"Instance-Properties"},{"identifiers":["doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem\/connect()","doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem\/contentsOfDirectory(atPath:)","doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem\/createDirectory(atPath:)","doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem\/downloadFile(atPath:toLocalFile:)","doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem\/fetchUserIdentity()","doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem\/fileExists(atPath:)","doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem\/removeItem(atPath:)","doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem\/uploadLocalFile(atPath:toPath:)"],"title":"Instance Methods","generated":true,"anchor":"Instance-Methods"},{"identifiers":["doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem\/CloudFileSystem-Implementations"],"title":"Default Implementations","generated":true,"anchor":"Default-Implementations"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ensemblesbox\/boxcloudfilesystem"]}],"identifier":{"url":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem","interfaceLanguage":"swift"},"kind":"symbol","relationshipsSections":[{"identifiers":["doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/CloudFileSystem","doc:\/\/EnsemblesBox\/s8SendableP","doc:\/\/EnsemblesBox\/s16SendableMetatypeP"],"kind":"relationships","title":"Conforms To","type":"conformsTo"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"BoxCloudFileSystem"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"content":[{"inlineContent":[{"type":"text","text":"This backend requires the "},{"type":"reference","identifier":"https:\/\/github.com\/box\/box-ios-sdk.git","isActive":true},{"type":"text","text":" "},{"type":"text","text":"package. With the source distribution, enable the "},{"type":"codeVoice","code":"Box"},{"type":"text","text":" package trait and SPM resolves it"},{"type":"text","text":" "},{"type":"text","text":"automatically. With the binary distribution (XCFrameworks), add BoxSDK as a separate"},{"text":" ","type":"text"},{"text":"package dependency in your project.","type":"text"}],"type":"paragraph"}],"name":"Important","style":"important","type":"aside"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Box uses numeric IDs rather than paths to identify files and folders. This backend"},{"type":"text","text":" "},{"type":"text","text":"bridges the path-based "},{"type":"reference","isActive":true,"identifier":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/CloudFileSystem"},{"type":"text","text":" protocol onto Box’s ID-based API by"},{"type":"text","text":" "},{"type":"text","text":"walking the folder hierarchy to resolve Ensembles paths"},{"type":"text","text":" "},{"type":"text","text":"(e.g. "},{"type":"codeVoice","code":"ensembleId\/events\/file.json"},{"type":"text","text":") to Box folder and file IDs."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Resolved IDs are cached in internal dictionaries to minimize API calls. The cache"},{"type":"text","text":" "},{"type":"text","text":"is invalidated when items are deleted or when not-found errors indicate stale entries."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The app creates and configures a "},{"type":"codeVoice","code":"BoxClient"},{"type":"text","text":" with its own authentication"},{"type":"text","text":" "},{"type":"text","text":"and injects it at init time:"}]},{"type":"codeListing","syntax":"swift","code":["let auth = BoxDeveloperTokenAuth(token: \"your-token\")","let client = BoxClient(auth: auth)","let cloudFS = BoxCloudFileSystem(client: client)"]},{"anchor":"Authentication","type":"heading","text":"Authentication","level":2},{"type":"paragraph","inlineContent":[{"text":"The Box Swift SDK supports multiple authentication methods. Create a","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"BoxClient"},{"text":" with the appropriate auth for your use case:","type":"text"}]},{"type":"heading","level":3,"anchor":"Developer-Token-testing-only","text":"Developer Token (testing only)"},{"inlineContent":[{"type":"text","text":"Get a short-lived token from "},{"type":"reference","isActive":true,"identifier":"https:\/\/developer.box.com\/"},{"type":"text","text":" "},{"type":"text","text":"under your app’s configuration page. These tokens expire after 60 minutes."}],"type":"paragraph"},{"syntax":"swift","code":["let auth = BoxDeveloperTokenAuth(token: \"your-developer-token\")","let client = BoxClient(auth: auth)","let cloudFS = BoxCloudFileSystem(client: client)"],"type":"codeListing"},{"anchor":"OAuth-20-production-apps","text":"OAuth 2.0 (production apps)","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Register your app at "},{"type":"reference","overridingTitleInlineContent":[{"type":"text","text":"developer.box.com"}],"identifier":"https:\/\/developer.box.com\/","isActive":true,"overridingTitle":"developer.box.com"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"text","text":"configure an OAuth 2.0 redirect URI:"}],"type":"paragraph"},{"syntax":"swift","code":["let config = OAuthConfig(clientId: \"your-client-id\", clientSecret: \"your-secret\")","let auth = BoxOAuth(config: config)","\/\/ Call auth.authorize(url:) with your redirect URL after the OAuth flow","let client = BoxClient(auth: auth)","let cloudFS = BoxCloudFileSystem(client: client)"],"type":"codeListing"},{"anchor":"Client-Credentials-Grant-server-side","text":"Client Credentials Grant (server-side)","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"For server-to-server integration without user interaction:"}],"type":"paragraph"},{"syntax":"swift","code":["let config = CCGConfig(","    clientId: \"your-client-id\",","    clientSecret: \"your-secret\",","    userId: \"user-id\"",")","let auth = BoxCCGAuth(config: config)","let client = BoxClient(auth: auth)","let cloudFS = BoxCloudFileSystem(client: client)"],"type":"codeListing"},{"anchor":"Threading","text":"Threading","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"This class is "},{"type":"codeVoice","code":"@unchecked Sendable"},{"type":"text","text":". The "},{"type":"codeVoice","code":"BoxClient"},{"type":"text","text":" handles its own thread"},{"type":"text","text":" "},{"type":"text","text":"safety internally. Mutable state (caches, "},{"type":"codeVoice","code":"loggedIn"},{"type":"text","text":" flag) is accessed only"},{"type":"text","text":" "},{"type":"text","text":"from async methods that are serialized by the ensemble’s operation queue."}],"type":"paragraph"}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox"]]},"metadata":{"title":"BoxCloudFileSystem","role":"symbol","roleHeading":"Class","modules":[{"name":"EnsemblesBox"}],"navigatorTitle":[{"kind":"identifier","text":"BoxCloudFileSystem"}],"symbolKind":"class","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BoxCloudFileSystem","kind":"identifier"}],"externalID":"s:12EnsemblesBox0B15CloudF