{"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem"},"metadata":{"navigatorTitle":[{"kind":"identifier","text":"BoxCloudFileSystem"}],"modules":[{"name":"EnsemblesBox"}],"role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"BoxCloudFileSystem"}],"symbolKind":"class","title":"BoxCloudFileSystem","roleHeading":"Class","externalID":"s:12EnsemblesBox0B15CloudFileSystemC"},"relationshipsSections":[{"type":"conformsTo","kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/EnsemblesBox\/9Ensembles15CloudFileSystemP","doc:\/\/EnsemblesBox\/s8SendableP","doc:\/\/EnsemblesBox\/s16SendableMetatypeP"]}],"hierarchy":{"paths":[["doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"BoxCloudFileSystem"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"type":"aside","name":"Important","style":"important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"This backend requires the "},{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/box\/box-ios-sdk.git"},{"type":"text","text":" "},{"type":"text","text":"package. With the source distribution, enable the "},{"type":"codeVoice","code":"Box"},{"type":"text","text":" package trait and SPM resolves it"},{"type":"text","text":" "},{"type":"text","text":"automatically. With the binary distribution (XCFrameworks), add BoxSDK as a separate"},{"type":"text","text":" "},{"type":"text","text":"package dependency in your project."}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Box uses numeric IDs rather than paths to identify files and folders. This backend"},{"type":"text","text":" "},{"type":"text","text":"bridges the path-based "},{"type":"codeVoice","code":"CloudFileSystem"},{"type":"text","text":" protocol onto Box’s ID-based API by"},{"type":"text","text":" "},{"type":"text","text":"walking the folder hierarchy to resolve Ensembles paths"},{"type":"text","text":" "},{"type":"text","text":"(e.g. "},{"type":"codeVoice","code":"ensembleId\/events\/file.json"},{"type":"text","text":") to Box folder and file IDs."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Resolved IDs are cached in internal dictionaries to minimize API calls. The cache"},{"type":"text","text":" "},{"type":"text","text":"is invalidated when items are deleted or when not-found errors indicate stale entries."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The app creates and configures a "},{"type":"codeVoice","code":"BoxClient"},{"type":"text","text":" with its own authentication"},{"type":"text","text":" "},{"type":"text","text":"and injects it at init time:"}]},{"syntax":"swift","type":"codeListing","code":["let auth = BoxDeveloperTokenAuth(token: \"your-token\")","let client = BoxClient(auth: auth)","let cloudFS = BoxCloudFileSystem(client: client)"]},{"type":"heading","anchor":"Authentication","level":2,"text":"Authentication"},{"type":"paragraph","inlineContent":[{"text":"The Box Swift SDK supports multiple authentication methods. Create a","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"BoxClient"},{"text":" with the appropriate auth for your use case:","type":"text"}]},{"type":"heading","anchor":"Developer-Token-testing-only","level":3,"text":"Developer Token (testing only)"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Get a short-lived token from "},{"type":"reference","identifier":"https:\/\/developer.box.com\/","isActive":true},{"type":"text","text":" "},{"type":"text","text":"under your app’s configuration page. These tokens expire after 60 minutes."}]},{"type":"codeListing","syntax":"swift","code":["let auth = BoxDeveloperTokenAuth(token: \"your-developer-token\")","let client = BoxClient(auth: auth)","let cloudFS = BoxCloudFileSystem(client: client)"]},{"type":"heading","anchor":"OAuth-20-production-apps","level":3,"text":"OAuth 2.0 (production apps)"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Register your app at "},{"overridingTitle":"developer.box.com","type":"reference","identifier":"https:\/\/developer.box.com\/","isActive":true,"overridingTitleInlineContent":[{"text":"developer.box.com","type":"text"}]},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"text","text":"configure an OAuth 2.0 redirect URI:"}]},{"type":"codeListing","syntax":"swift","code":["let config = OAuthConfig(clientId: \"your-client-id\", clientSecret: \"your-secret\")","let auth = BoxOAuth(config: config)","\/\/ Call auth.authorize(url:) with your redirect URL after the OAuth flow","let client = BoxClient(auth: auth)","let cloudFS = BoxCloudFileSystem(client: client)"]},{"type":"heading","anchor":"Client-Credentials-Grant-server-side","level":3,"text":"Client Credentials Grant (server-side)"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For server-to-server integration without user interaction:"}]},{"type":"codeListing","syntax":"swift","code":["let config = CCGConfig(","    clientId: \"your-client-id\",","    clientSecret: \"your-secret\",","    userId: \"user-id\"",")","let auth = BoxCCGAuth(config: config)","let client = BoxClient(auth: auth)","let cloudFS = BoxCloudFileSystem(client: client)"]},{"type":"heading","anchor":"Threading","level":2,"text":"Threading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This class is "},{"type":"codeVoice","code":"@unchecked Sendable"},{"type":"text","text":". The "},{"type":"codeVoice","code":"BoxClient"},{"type":"text","text":" handles its own thread"},{"type":"text","text":" "},{"type":"text","text":"safety internally. Mutable state (caches, "},{"type":"codeVoice","code":"loggedIn"},{"type":"text","text":" flag) is accessed only"},{"type":"text","text":" "},{"type":"text","text":"from async methods that are serialized by the ensemble’s operation queue."}]}]}],"abstract":[{"type":"text","text":"A cloud file system backed by Box, using the Box Swift SDK ("},{"type":"codeVoice","code":"BoxSdkGen"},{"type":"text","text":")."}],"schemaVersion":{"patch":0,"major":0,"minor":3},"topicSections":[{"title":"Initializers","identifiers":["doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem\/init(client:)"],"generated":true,"anchor":"Initializers"},{"title":"Instance Properties","identifiers":["doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem\/client","doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem\/isConnected"],"generated":true,"anchor":"Instance-Properties"},{"title":"Instance Methods","identifiers":["doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem\/connect()","doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem\/contentsOfDirectory(atPath:)","doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem\/createDirectory(atPath:)","doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem\/downloadFile(atPath:toLocalFile:)","doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem\/fetchUserIdentity()","doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem\/fileExists(atPath:)","doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem\/removeItem(atPath:)","doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem\/uploadLocalFile(atPath:toPath:)"],"generated":true,"anchor":"Instance-Methods"},{"generated":true,"title":"Default Implementations","anchor":"Default-Implementations","identifiers":["doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem\/CloudFileSystem-Implementatio