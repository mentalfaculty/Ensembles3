{"kind":"symbol","hierarchy":{"paths":[["doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"final","kind":"keyword"},{"text":" ","kind":"text"},{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BoxCloudFileSystem","kind":"identifier"}],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"content":[{"type":"paragraph","inlineContent":[{"text":"This backend requires the ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/box\/box-ios-sdk.git"},{"text":" ","type":"text"},{"text":"package. With the source distribution, enable the ","type":"text"},{"code":"Box","type":"codeVoice"},{"text":" package trait and SPM resolves it","type":"text"},{"text":" ","type":"text"},{"text":"automatically. With the binary distribution (XCFrameworks), add BoxSDK as a separate","type":"text"},{"text":" ","type":"text"},{"text":"package dependency in your project.","type":"text"}]}],"name":"Important","type":"aside","style":"important"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Box uses numeric IDs rather than paths to identify files and folders. This backend"},{"type":"text","text":" "},{"type":"text","text":"bridges the path-based "},{"code":"CloudFileSystem","type":"codeVoice"},{"type":"text","text":" protocol onto Box’s ID-based API by"},{"type":"text","text":" "},{"type":"text","text":"walking the folder hierarchy to resolve Ensembles paths"},{"type":"text","text":" "},{"type":"text","text":"(e.g. "},{"code":"ensembleId\/events\/file.json","type":"codeVoice"},{"type":"text","text":") to Box folder and file IDs."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Resolved IDs are cached in internal dictionaries to minimize API calls. The cache"},{"type":"text","text":" "},{"type":"text","text":"is invalidated when items are deleted or when not-found errors indicate stale entries."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The app creates and configures a "},{"code":"BoxClient","type":"codeVoice"},{"type":"text","text":" with its own authentication"},{"type":"text","text":" "},{"type":"text","text":"and injects it at init time:"}]},{"syntax":"swift","code":["let auth = BoxDeveloperTokenAuth(token: \"your-token\")","let client = BoxClient(auth: auth)","let cloudFS = BoxCloudFileSystem(client: client)"],"type":"codeListing"},{"level":2,"text":"Authentication","anchor":"Authentication","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Box Swift SDK supports multiple authentication methods. Create a"},{"type":"text","text":" "},{"code":"BoxClient","type":"codeVoice"},{"type":"text","text":" with the appropriate auth for your use case:"}]},{"level":3,"text":"Developer Token (testing only)","anchor":"Developer-Token-testing-only","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Get a short-lived token from "},{"identifier":"https:\/\/developer.box.com\/","isActive":true,"type":"reference"},{"type":"text","text":" "},{"type":"text","text":"under your app’s configuration page. These tokens expire after 60 minutes."}]},{"syntax":"swift","code":["let auth = BoxDeveloperTokenAuth(token: \"your-developer-token\")","let client = BoxClient(auth: auth)","let cloudFS = BoxCloudFileSystem(client: client)"],"type":"codeListing"},{"level":3,"text":"OAuth 2.0 (production apps)","anchor":"OAuth-20-production-apps","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Register your app at "},{"identifier":"https:\/\/developer.box.com\/","overridingTitle":"developer.box.com","isActive":true,"type":"reference","overridingTitleInlineContent":[{"text":"developer.box.com","type":"text"}]},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"text","text":"configure an OAuth 2.0 redirect URI:"}]},{"syntax":"swift","code":["let config = OAuthConfig(clientId: \"your-client-id\", clientSecret: \"your-secret\")","let auth = BoxOAuth(config: config)","\/\/ Call auth.authorize(url:) with your redirect URL after the OAuth flow","let client = BoxClient(auth: auth)","let cloudFS = BoxCloudFileSystem(client: client)"],"type":"codeListing"},{"level":3,"text":"Client Credentials Grant (server-side)","anchor":"Client-Credentials-Grant-server-side","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For server-to-server integration without user interaction:"}]},{"syntax":"swift","code":["let config = CCGConfig(","    clientId: \"your-client-id\",","    clientSecret: \"your-secret\",","    userId: \"user-id\"",")","let auth = BoxCCGAuth(config: config)","let client = BoxClient(auth: auth)","let cloudFS = BoxCloudFileSystem(client: client)"],"type":"codeListing"},{"level":2,"text":"Threading","anchor":"Threading","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This class is "},{"code":"@unchecked Sendable","type":"codeVoice"},{"type":"text","text":". The "},{"code":"BoxClient","type":"codeVoice"},{"type":"text","text":" handles its own thread"},{"type":"text","text":" "},{"type":"text","text":"safety internally. Mutable state (caches, "},{"code":"loggedIn","type":"codeVoice"},{"type":"text","text":" flag) is accessed only"},{"type":"text","text":" "},{"type":"text","text":"from async methods that are serialized by the ensemble’s operation queue."}]}]}],"abstract":[{"text":"A cloud file system backed by Box, using the Box Swift SDK (","type":"text"},{"code":"BoxSdkGen","type":"codeVoice"},{"text":").","type":"text"}],"topicSections":[{"generated":true,"identifiers":["doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem\/init(client:)"],"anchor":"Initializers","title":"Initializers"},{"generated":true,"identifiers":["doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem\/client","doc:\/\/E