neContent":[{"type":"text","text":"Resolved IDs are cached in internal dictionaries to minimize API calls. The cache"},{"type":"text","text":" "},{"type":"text","text":"is invalidated when items are deleted or when not-found errors indicate stale entries."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The app creates and configures a "},{"type":"codeVoice","code":"BoxClient"},{"type":"text","text":" with its own authentication"},{"type":"text","text":" "},{"type":"text","text":"and injects it at init time:"}]},{"syntax":"swift","type":"codeListing","code":["let auth = BoxDeveloperTokenAuth(token: \"your-token\")","let client = BoxClient(auth: auth)","let cloudFS = BoxCloudFileSystem(client: client)"]},{"type":"heading","level":2,"text":"Authentication","anchor":"Authentication"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Box Swift SDK supports multiple authentication methods. Create a"},{"type":"text","text":" "},{"type":"codeVoice","code":"BoxClient"},{"type":"text","text":" with the appropriate auth for your use case:"}]},{"type":"heading","level":3,"text":"Developer Token (testing only)","anchor":"Developer-Token-testing-only"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Get a short-lived token from "},{"isActive":true,"type":"reference","identifier":"https:\/\/developer.box.com\/"},{"type":"text","text":" "},{"type":"text","text":"under your app’s configuration page. These tokens expire after 60 minutes."}]},{"syntax":"swift","type":"codeListing","code":["let auth = BoxDeveloperTokenAuth(token: \"your-developer-token\")","let client = BoxClient(auth: auth)","let cloudFS = BoxCloudFileSystem(client: client)"]},{"type":"heading","level":3,"text":"OAuth 2.0 (production apps)","anchor":"OAuth-20-production-apps"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Register your app at "},{"isActive":true,"overridingTitle":"developer.box.com","type":"reference","identifier":"https:\/\/developer.box.com\/","overridingTitleInlineContent":[{"text":"developer.box.com","type":"text"}]},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"text","text":"configure an OAuth 2.0 redirect URI:"}]},{"syntax":"swift","type":"codeListing","code":["let config = OAuthConfig(clientId: \"your-client-id\", clientSecret: \"your-secret\")","let auth = BoxOAuth(config: config)","\/\/ Call auth.authorize(url:) with your redirect URL after the OAuth flow","let client = BoxClient(auth: auth)","let cloudFS = BoxCloudFileSystem(client: client)"]},{"type":"heading","level":3,"text":"Client Credentials Grant (server-side)","anchor":"Client-Credentials-Grant-server-side"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For server-to-server integration without user interaction:"}]},{"syntax":"swift","type":"codeListing","code":["let config = CCGConfig(","    clientId: \"your-client-id\",","    clientSecret: \"your-secret\",","    userId: \"user-id\"",")","let auth = BoxCCGAuth(config: config)","let client = BoxClient(auth: auth)","let cloudFS = BoxCloudFileSystem(client: client)"]},{"type":"heading","level":2,"text":"Threading","anchor":"Threading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This class is "},{"type":"codeVoice","code":"@unchecked Sendable"},{"type":"text","text":". The "},{"type":"codeVoice","code":"BoxClient"},{"type":"text","text":" handles its own thread"},{"type":"text","text":" "},{"type":"text","text":"safety internally. Mutable state (caches, "},{"type":"codeVoice","code":"loggedIn"},{"type":"text","text":" flag) is accessed only"},{"type":"text","text":" "},{"type":"text","text":"from async methods that are serialized by the ensemble’s operation queue."}]}],"kind":"content"}],"kind":"symbol","metadata":{"externalID":"s:12EnsemblesBox0B15CloudFileSystemC","title":"BoxCloudFileSystem","roleHeading":"Class","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BoxCloudFileSystem","kind":"identifier"}],"sym