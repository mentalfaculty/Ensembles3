,"type":"text"},{"text":"(e.g. ","type":"text"},{"code":"ensembleId\/events\/file.json","type":"codeVoice"},{"text":") to Box folder and file IDs.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Resolved IDs are cached in internal dictionaries to minimize API calls. The cache","type":"text"},{"text":" ","type":"text"},{"text":"is invalidated when items are deleted or when not-found errors indicate stale entries.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The app creates and configures a ","type":"text"},{"code":"BoxClient","type":"codeVoice"},{"text":" with its own authentication","type":"text"},{"text":" ","type":"text"},{"text":"and injects it at init time:","type":"text"}]},{"code":["let auth = BoxDeveloperTokenAuth(token: \"your-token\")","let client = BoxClient(auth: auth)","let cloudFS = BoxCloudFileSystem(client: client)"],"type":"codeListing","syntax":"swift"},{"type":"heading","anchor":"Authentication","level":2,"text":"Authentication"},{"type":"paragraph","inlineContent":[{"text":"The Box Swift SDK supports multiple authentication methods. Create a","type":"text"},{"text":" ","type":"text"},{"code":"BoxClient","type":"codeVoice"},{"text":" with the appropriate auth for your use case:","type":"text"}]},{"type":"heading","anchor":"Developer-Token-testing-only","level":3,"text":"Developer Token (testing only)"},{"type":"paragraph","inlineContent":[{"text":"Get a short-lived token from ","type":"text"},{"isActive":true,"identifier":"https:\/\/developer.box.com\/","type":"reference"},{"text":" ","type":"text"},{"text":"under your app’s configuration page. These tokens expire after 60 minutes.","type":"text"}]},{"code":["let auth = BoxDeveloperTokenAuth(token: \"your-developer-token\")","let client = BoxClient(auth: auth)","let cloudFS = BoxCloudFileSystem(client: client)"],"type":"codeListing","syntax":"swift"},{"type":"heading","anchor":"OAuth-20-production-apps","level":3,"text":"OAuth 2.0 (production apps)"},{"type":"paragraph","inlineContent":[{"text":"Register your app at ","type":"text"},{"isActive":true,"overridingTitle":"developer.box.com","identifier":"https:\/\/developer.box.com\/","overridingTitleInlineContent":[{"type":"text","text":"developer.box.com"}],"type":"reference"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"text":"configure an OAuth 2.0 redirect URI:","type":"text"}]},{"code":["let config = OAuthConfig(clientId: \"your-client-id\", clientSecret: \"your-secret\")","let auth = BoxOAuth(config: config)","\/\/ Call auth.authorize(url:) with your redirect URL after the OAuth flow","let client = BoxClient(auth: auth)","let cloudFS = BoxCloudFileSystem(client: client)"],"type":"codeListing","syntax":"swift"},{"type":"heading","anchor":"Client-Credentials-Grant-server-side","level":3,"text":"Client Credentials Grant (server-side)"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For server-to-server integration without user interaction:"}]},{"code":["let config = CCGConfig(","    clientId: \"your-client-id\",","    clientSecret: \"your-secret\",","    userId: \"user-id\"",")","let auth = BoxCCGAuth(config: config)","let client = BoxClient(auth: auth)","let cloudFS = BoxCloudFileSystem(client: client)"],"type":"codeListing","syntax":"swift"},{"type":"heading","anchor":"Threading","level":2,"text":"Threading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This class is "},{"type":"codeVoice","code":"@unchecked Sendable"},{"type":"text","text":". The "},{"type":"codeVoice","code":"BoxClient"},{"type":"text","text":" handles its own thread"},{"type":"text","text":" "},{"type":"text","text":"safety internally. Mutable state (caches, "},{"type":"codeVoice","code":"loggedIn"},{"type":"text","text":" flag) is accessed only"},{"type":"text","text":" "},{"type":"text","text":"from async methods that are serialized by the ensemble’s operation queue."}]}],"kind":"content"}],"references":{"doc://EnsemblesBox/documentation/EnsemblesBox":{"url":"