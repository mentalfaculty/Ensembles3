(e.g. ","type":"text"},{"type":"codeVoice","code":"ensembleId\/events\/file.json"},{"text":") to Box folder and file IDs.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Resolved IDs are cached in internal dictionaries to minimize API calls. The cache","type":"text"},{"text":" ","type":"text"},{"text":"is invalidated when items are deleted or when not-found errors indicate stale entries.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The app creates and configures a ","type":"text"},{"type":"codeVoice","code":"BoxClient"},{"text":" with its own authentication","type":"text"},{"text":" ","type":"text"},{"text":"and injects it at init time:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let auth = BoxDeveloperTokenAuth(token: \"your-token\")","let client = BoxClient(auth: auth)","let cloudFS = BoxCloudFileSystem(client: client)"],"type":"codeListing"},{"anchor":"Authentication","text":"Authentication","level":2,"type":"heading"},{"inlineContent":[{"text":"The Box Swift SDK supports multiple authentication methods. Create a","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"BoxClient"},{"text":" with the appropriate auth for your use case:","type":"text"}],"type":"paragraph"},{"anchor":"Developer-Token-testing-only","text":"Developer Token (testing only)","level":3,"type":"heading"},{"inlineContent":[{"text":"Get a short-lived token from ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/developer.box.com\/"},{"text":" ","type":"text"},{"text":"under your app’s configuration page. These tokens expire after 60 minutes.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let auth = BoxDeveloperTokenAuth(token: \"your-developer-token\")","let client = BoxClient(auth: auth)","let cloudFS = BoxCloudFileSystem(client: client)"],"type":"codeListing"},{"anchor":"OAuth-20-production-apps","text":"OAuth 2.0 (production apps)","level":3,"type":"heading"},{"inlineContent":[{"text":"Register your app at ","type":"text"},{"overridingTitleInlineContent":[{"text":"developer.box.com","type":"text"}],"isActive":true,"type":"reference","identifier":"https:\/\/developer.box.com\/","overridingTitle":"developer.box.com"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"text":"configure an OAuth 2.0 redirect URI:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let config = OAuthConfig(clientId: \"your-client-id\", clientSecret: \"your-secret\")","let auth = BoxOAuth(config: config)","\/\/ Call auth.authorize(url:) with your redirect URL after the OAuth flow","let client = BoxClient(auth: auth)","let cloudFS = BoxCloudFileSystem(client: client)"],"type":"codeListing"},{"anchor":"Client-Credentials-Grant-server-side","text":"Client Credentials Grant (server-side)","level":3,"type":"heading"},{"inlineContent":[{"text":"For server-to-server integration without user interaction:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let config = CCGConfig(","    clientId: \"your-client-id\",","    clientSecret: \"your-secret\",","    userId: \"user-id\"",")","let auth = BoxCCGAuth(config: config)","let client = BoxClient(auth: auth)","let cloudFS = BoxCloudFileSystem(client: client)"],"type":"codeListing"},{"anchor":"Threading","text":"Threading","level":2,"type":"heading"},{"inlineContent":[{"text":"This class is ","type":"text"},{"type":"codeVoice","code":"@unchecked Sendable"},{"text":". The ","type":"text"},{"type":"codeVoice","code":"BoxClient"},{"text":" handles its own thread","type":"text"},{"text":" ","type":"text"},{"text":"safety internally. Mutable state (caches, ","type":"text"},{"type":"codeVoice","code":"loggedIn"},{"text":" flag) is accessed only","type":"text"},{"text":" ","type":"text"},{"text":"from async methods that are serialized by the ensemble’s operation queue.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"text":"A cloud