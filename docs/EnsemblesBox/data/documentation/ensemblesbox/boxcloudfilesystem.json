{"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"BoxCloudFileSystem"}],"languages":["swift"]}]},{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"style":"important","content":[{"inlineContent":[{"type":"text","text":"This backend requires the "},{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/box\/box-ios-sdk.git"},{"type":"text","text":" "},{"type":"text","text":"package. With the source distribution, enable the "},{"type":"codeVoice","code":"Box"},{"type":"text","text":" package trait and SPM resolves it"},{"type":"text","text":" "},{"type":"text","text":"automatically. With the binary distribution (XCFrameworks), add BoxSDK as a separate"},{"type":"text","text":" "},{"type":"text","text":"package dependency in your project."}],"type":"paragraph"}],"type":"aside","name":"Important"},{"inlineContent":[{"type":"text","text":"Box uses numeric IDs rather than paths to identify files and folders. This backend"},{"type":"text","text":" "},{"type":"text","text":"bridges the path-based "},{"type":"codeVoice","code":"CloudFileSystem"},{"type":"text","text":" protocol onto Box’s ID-based API by"},{"type":"text","text":" "},{"type":"text","text":"walking the folder hierarchy to resolve Ensembles paths"},{"type":"text","text":" "},{"type":"text","text":"(e.g. "},{"type":"codeVoice","code":"ensembleId\/events\/file.json"},{"type":"text","text":") to Box folder and file IDs."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Resolved IDs are cached in internal dictionaries to minimize API calls. The cache"},{"type":"text","text":" "},{"type":"text","text":"is invalidated when items are deleted or when not-found errors indicate stale entries."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The app creates and configures a "},{"type":"codeVoice","code":"BoxClient"},{"type":"text","text":" with its own authentication"},{"type":"text","text":" "},{"type":"text","text":"and injects it at init time:"}],"type":"paragraph"},{"code":["let auth = BoxDeveloperTokenAuth(token: \"your-token\")","let client = BoxClient(auth: auth)","let cloudFS = BoxCloudFileSystem(client: client)"],"type":"codeListing","syntax":"swift"},{"anchor":"Authentication","level":2,"type":"heading","text":"Authentication"},{"inlineContent":[{"type":"text","text":"The Box Swift SDK supports multiple authentication methods. Create a"},{"type":"text","text":" "},{"code":"BoxClient","type":"codeVoice"},{"type":"text","text":" with the appropriate auth for your use case:"}],"type":"paragraph"},{"anchor":"Developer-Token-testing-only","level":3,"type":"heading","text":"Developer Token (testing only)"},{"inlineContent":[{"type":"text","text":"Get a short-lived token from "},{"isActive":true,"type":"reference","identifier":"https:\/\/developer.box.com\/"},{"type":"text","text":" "},{"type":"text","text":"under your app’s configuration page. These tokens expire after 60 minutes."}],"type":"paragraph"},{"type":"codeListing","code":["let auth = BoxDeveloperTokenAuth(token: \"your-developer-token\")","let client = BoxClient(auth: auth)","let cloudFS = BoxCloudFileSystem(client: client)"],"syntax":"swift"},{"text":"OAuth 2.0 (production apps)","anchor":"OAuth-20-production-apps","type":"heading","level":3},{"inlineContent":[{"text":"Register your app at ","type":"text"},{"overridingTitleInlineContent":[{"text":"developer.box.com","type":"text"}],"isActive":true,"identifier":"https:\/\/developer.box.com\/","overridingTitle":"developer.box.com","type":"reference"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"text":"configure an OAuth 2.0 redirect URI:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["let config = OAuthConfig(clientId: \"your-client-id\", clientSecret: \"your-secret\")","let auth = BoxOAuth(config: config)","\/\/ Call auth.authorize(url:) with your redirect URL after the OAuth flow","let client = BoxClient(auth: auth)","let cloudFS = BoxCloudFileSystem(client: client)"],"syntax":"swift"},{"text":"Client Credentials Grant (server-side)","anchor":"Client-Credentials-Grant-server-side","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"For server-to-server integration without user interaction:"}],"type":"paragraph"},{"type":"codeListing","code":["let config = CCGConfig(","    clientId: \"your-client-id\",","    clientSecret: \"your-secret\",","    userId: \"user-id\"",")","let auth = BoxCCGAuth(config: config)","let client = BoxClient(auth: auth)","let cloudFS = BoxCloudFileSystem(client: client)"],"syntax":"swift"},{"text":"Threading","anchor":"Threading","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"This class is "},{"code":"@unchecked Sendable","type":"codeVoice"},{"type":"text","text":". The "},{"code":"BoxClient","type":"codeVoice"},{"type":"text","text":" handles its own thread"},{"type":"text","text":" "},{"type":"text","text":"safety internally. Mutable state (caches, "},{"code":"loggedIn","type":"codeVoice"},{"type":"text","text":" flag) is accessed only"},{"type":"text","text":" "},{"type":"text","text":"from async methods that are serialized by the ensemble’s operation queue."}],"type":"paragraph"}],"kind":"content"}],"identifier":{"url":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem","interfaceLanguage":"swift"},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ensemblesbox\/boxcloudfilesystem"]}],"metadata":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BoxCloudFileSystem","kind":"identifier"}],"roleHeading":"Class","role":"symbol","title":"BoxCloudFileSystem","navigatorTitle":[{"kind":"identifier","text":"BoxCloudFileSyst