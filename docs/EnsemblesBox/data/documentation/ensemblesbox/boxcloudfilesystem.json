{"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"identifier":{"url":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox"]]},"abstract":[{"type":"text","text":"A cloud file system backed by Box, using the Box Swift SDK ("},{"type":"codeVoice","code":"BoxSdkGen"},{"type":"text","text":")."}],"topicSections":[{"anchor":"Initializers","identifiers":["doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem\/init(client:)"],"title":"Initializers","generated":true},{"anchor":"Instance-Properties","identifiers":["doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem\/client","doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem\/isConnected"],"title":"Instance Properties","generated":true},{"anchor":"Instance-Methods","identifiers":["doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem\/connect()","doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem\/contentsOfDirectory(atPath:)","doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem\/createDirectory(atPath:)","doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem\/downloadFile(atPath:toLocalFile:)","doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem\/fetchUserIdentity()","doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem\/fileExists(atPath:)","doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem\/removeItem(atPath:)","doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem\/uploadLocalFile(atPath:toPath:)"],"title":"Instance Methods","generated":true},{"anchor":"Default-Implementations","identifiers":["doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem\/CloudFileSystem-Implementations"],"title":"Default Implementations","generated":true}],"variants":[{"paths":["\/documentation\/ensemblesb