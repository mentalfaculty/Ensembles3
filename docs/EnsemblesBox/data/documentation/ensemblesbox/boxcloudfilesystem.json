{"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","sections":[],"hierarchy":{"paths":[["doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox"]]},"metadata":{"externalID":"s:12EnsemblesBox0B15CloudFileSystemC","title":"BoxCloudFileSystem","roleHeading":"Class","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"BoxCloudFileSystem"}],"symbolKind":"class","modules":[{"name":"EnsemblesBox"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BoxCloudFileSystem","kind":"identifier"}]},"abstract":[{"type":"text","text":"A cloud file system backed by Box, using the Box Swift SDK ("},{"type":"codeVoice","code":"BoxSdkGen"},{"type":"text","text":")."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"final","kind":"keyword"},{"text":" ","kind":"text"},{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BoxCloudFileSystem","kind":"identifier"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"style":"important","name":"Important","type":"aside","content":[{"inlineContent":[{"text":"This backend requires the ","type":"text"},{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/box\/box-ios-sdk.git"},{"text":" ","type":"text"},{"text":"package. With the source distribution, enable the ","type":"text"},{"type":"codeVoice","code":"Box"},{"text":" package trait and SPM resolves it","type":"text"},{"text":" ","type":"text"},{"text":"automatically. With the binary distribution (XCFrameworks), add BoxSDK as a separate","type":"text"},{"text":" ","type":"text"},{"text":"package dependency in your project.","type":"text"}],"type":"paragraph"}]},{"type":"paragraph","inlineContent":[{"text":"Box uses numeric IDs rather than paths to identify files and folders. This backend","type":"text"},{"text":" ","type":"text"},{"text":"bridges the path-based ","type":"text"},{"co