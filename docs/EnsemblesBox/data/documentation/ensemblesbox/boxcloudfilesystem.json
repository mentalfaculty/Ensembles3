d":"identifier","text":"BoxCloudFileSystem"}],"roleHeading":"Class","modules":[{"name":"EnsemblesBox"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BoxCloudFileSystem","kind":"identifier"}],"role":"symbol","externalID":"s:12EnsemblesBox0B15CloudFileSystemC"},"schemaVersion":{"minor":3,"major":0,"patch":0},"relationshipsSections":[{"type":"conformsTo","title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/EnsemblesBox\/9Ensembles15CloudFileSystemP","doc:\/\/EnsemblesBox\/s8SendableP","doc:\/\/EnsemblesBox\/s16SendableMetatypeP"]}],"identifier":{"url":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"final","kind":"keyword"},{"text":" ","kind":"text"},{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BoxCloudFileSystem","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"content":[{"inlineContent":[{"text":"This backend requires the ","type":"text"},{"isActive":true,"identifier":"https:\/\/github.com\/box\/box-ios-sdk.git","type":"reference"},{"text":" ","type":"text"},{"text":"package. With the source distribution, enable the ","type":"text"},{"type":"codeVoice","code":"Box"},{"text":" package trait and SPM resolves it","type":"text"},{"text":" ","type":"text"},{"text":"automatically. With the binary distribution (XCFrameworks), add BoxSDK as a separate","type":"text"},{"text":" ","type":"text"},{"text":"package dependency in your project.","type":"text"}],"type":"paragraph"}],"name":"Important","type":"aside","style":"important"},{"inlineContent":[{"text":"Box uses numeric IDs rather than paths to identify files and folders. This backend","type":"text"},{"text":" ","type":"text"},{"text":"bridges the path-based ","type":"text"},{"code":"CloudFileSystem","type":"codeVoice"},{"text":" protocol onto Box’s ID-based API by","type":"text"},{"text":" ","type":"text"},{"text":"walking the folder hierarchy to resolve Ensembles paths","type":"text"},{"text":" ","type":"text"},{"text":"(e.g. ","type":"text"},{"code":"ensembleId\/events\/file.json","type":"codeVoice"},{"text":") to Box folder and file IDs.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Resolved IDs are cached in internal dictionaries to minimize API calls. The cache","type":"text"},{"text":" ","type":"text"},{"text":"is invalidated when items are deleted or when not-found errors indicate stale entries.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The app creates and configures a ","type":"text"},{"code":"BoxClient","type":"codeVoice"},{"text":" with its own authentication","type":"text"},{"text":" ","type":"text"},{"text":"and injects it at init time:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let auth = BoxDeveloperTokenAuth(token: \"your-token\")","let client = BoxClient(auth: auth)","let cloudFS = BoxCloudFileSystem(client: client)"],"type":"codeListing"},{"level":2,"text":"Authentication","anchor":"Authentication","type":"heading"},{"inlineContent":[{"text":"The Box Swift SDK supports multiple authentication methods. Create a","type":"text"},{"text":" ","type":"text"},{"code":"BoxClient","type":"codeVoice"},{"text":" with the appropriate auth for your use case:","type":"text"}],"type":"paragraph"},{"level":3,"text":"Developer Token (testing only)","anchor":"Developer-Token-testing-only","type":"heading"},{"inlineContent":[{"text":"Get a short-lived token from ","type":"text"},{"identifier":"https:\/\/developer.box.com\/","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"under your app’s configuration page. These tokens expire after 60 minutes.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let auth = BoxDeveloperTokenAuth(token: \"your-developer-token\")","let client = BoxClient(auth: auth)","let cloudFS = BoxCloudFileSystem(client: client)"],"type":"codeListing"},{"level":3,"text":"OAuth 2.0 (production apps)","anchor":"OAuth-20-production-apps","type":"heading"},{"inlineContent":[{"text":"Register your app at ","type":"text"},{"identifier":"https:\/\/developer.box.com\/","overridingTitle":"developer.box.com","overridingTitleInlineContent":[{"text":"developer.box.com","type":"text"}],"isActive":true,"type":"reference"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"text":"configure an OAuth 2.0 redirect URI:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let config = OAuthConfig(clientId: \"your-client-id\", clientSecret: \"your-secret\")","let auth = BoxOAuth(config: config)","\/\/ Call auth.authorize(url:) with your redirect URL after the OAuth flow","let client = BoxClient(auth: auth)","let cloudFS = BoxCloudFileSystem(client: client)"],"type":"codeListing"},{"level":3,"text":"Client Credentials Grant (server-side)","anchor":"Client-Credentials-Grant-server-side","type":"heading"},{"inlineContent":[{"text":"For server-to-server integration without user interaction:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let config = CCGConfig(","    clientId: \"your-client-id\",","    clientSecret: \"your-secret\",","    userId: \"user-id\"",")","let auth = BoxCCGAuth(config: config)","let client = BoxClient(auth: auth)","let cloudFS = BoxCloudFileSystem(client: client)"],"type":"codeListing"},{"level":2,"text":"Threading","anchor":"Threading","type":"heading"},{"inlineContent":[{"text":"This class is ","type":"text"},{"code":"@unchecked Sendable","type":"codeVoice"},{"text":". The ","type":"text"},{"code":"BoxClient","type":"codeVoice"},{"text":" handles its own thread","type":"text"},{"text":" ","type":"text"},{"text":"safety internally. Mutable state (caches, ","type":"text"},{"code":"loggedIn","type":"codeVoice"},{"text":" flag) is accessed only","type":"text"},{"text":" ","type":"text"},{