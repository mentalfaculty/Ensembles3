{"hierarchy":{"paths":[[]]},"topicSections":[{"identifiers":["doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem"],"title":"Cloud File System","anchor":"Cloud-File-System"}],"metadata":{"role":"collection","modules":[{"name":"EnsemblesBox"}],"title":"EnsemblesBox","externalID":"EnsemblesBox","roleHeading":"Framework","symbolKind":"module"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ensemblesbox"]}],"abstract":[{"text":"A Box-based cloud backend for Ensembles.","type":"text"}],"kind":"symbol","identifier":{"url":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"EnsemblesBox provides "},{"type":"reference","identifier":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem","isActive":true},{"type":"text","text":", an implementation of the Ensembles "},{"type":"codeVoice","code":"CloudFileSystem"},{"type":"text","text":" protocol that stores sync data on "},{"type":"reference","identifier":"https:\/\/www.box.com","isActive":true},{"type":"text","text":". It uses the official Box Swift SDK ("},{"type":"codeVoice","code":"BoxSdkGen"},{"type":"text","text":") for all API operations."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Box is widely used in enterprise environments and offers strong administrative controls, compliance features, and large storage quotas."}]},{"text":"The ID Problem","type":"heading","level":3,"anchor":"The-ID-Problem"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Unlike path-based services (pCloud, WebDAV, S3), Box identifies every file and folder by a numeric ID. The Ensembles "},{"type":"codeVoice","code":"CloudFileSystem"},{"type":"text","text":" protocol uses string paths like "},{"type":"codeVoice","code":"ensembleId\/events\/file.json"},{"type":"text","text":". "},{"type":"reference","identifier":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem","isActive":true},{"type":"text","text":" bridges this gap by walking the folder hierarchy to resolve paths to Box IDs, caching the mappings to minimize API calls."}]},{"text":"Authentication","type":"heading","level":3,"anchor":"Authentication"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Box supports multiple authentication methods (OAuth 2.0, Developer Token, Client Credentials Grant, JWT). Your app creates and configures a "},{"type":"codeVoice","code":"BoxClient"},{"type":"text","text":" with the appropriate auth, then injects it:"}]},{"code":["import EnsemblesBox","import BoxSdkGen","","\/\/ Developer token (for testing)","let auth = BoxDeveloperTokenAuth(token: \"your-dev-token\")","let boxClient = BoxClient(auth: auth)","let cloudFileSystem = BoxCloudFileSystem(client: boxClient)"],"syntax":"swift","type":"codeListing"},{"text":"Setup","type":"heading","level":3,"anchor":"Setup"},{"code":["let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MainStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: BoxCloudFileSystem(client: boxClient)",")","try await ensemble?.attachPersistentStore()"],"syntax":"swift","type":"codeListing"},{"text":"Path Resolution and Caching","type":"heading","level":3,"anchor":"Path-Resolution-and-Caching"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When Ensembles requests an operation on path "},{"type":"codeVoice","code":"\/ensembleId\/events\/file.json"},{"type":"text","text":", the backend:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Starts at the Box root folder (ID "},{"type":"codeVoice","code":"\"0\""},{"type":"text","text":")."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Lists the root folder to find "},{"type":"codeVoice","code":"ensembleId"},{"type":"text","text":" and gets its folder ID."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Lists that folder to find "},{"type":"codeVoice","code":"events"},{"type":"text","text":" and gets its folder ID."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Lists that folder to find "},{"type":"codeVoice","code":"file.json"},{"type":"text","text":" and gets its file ID."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each resolved ID is cached in an internal dictionary. Subsequent operations on the same path skip the API calls. The cache is invalidated when items are deleted or when not-found errors suggest staleness."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Folder listings are paginated automatically (up to 1000 items per page) to handle large directories."}]},{"text":"Error Handling","type":"heading","level":3,"anchor":"Error-Handling"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Box SDK errors are mapped to "},{"type":"codeVoice","code":"EnsembleError"},{"type":"text","text":" cases:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Authentication failures (401, unauthorized) map to "},{"type":"codeVoice","code":"EnsembleError\/authenticationFailure"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Not-found errors (404) map to "},{"type":"codeVoice","code":"EnsembleError\/fileAccessFailed"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Conflict errors (409, item already exists) are handled internally with retry logic."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"All other errors map to "},{"type":"codeVoice","code":"EnsembleError\/serverError"},{"type":"text","text":"."}]}]}]},{"text":"Dependencies","type":"heading","level":3,"anchor":"Dependencies"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This module depends on the "},{"type":"reference","identifier":"https:\/\/github.com\/box\/box-ios-sdk","isActive":true},{"type":"text","text":" v10+ ("},{"type":"codeVoice","code":"BoxSdkGen"},{"type":"text","text":" module). The SDK has zero external dependencies of its own."}]}]}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"https://github.com/box/box-ios-sdk":{"url":"https:\/\/github.com\/box\/box-ios-sdk","title":"Box iOS SDK","identifier":"https:\/\/github.com\/box\/box-ios-sdk","type":"link","titleInlineContent":[{"text":"Box iOS SDK","type":"text"}]},"https://www.box.com":{"url":"https:\/\/www.box.com","title":"Box","identifier":"https:\/\/www.box.com","type":"link","titleInlineContent":[{"text":"Box","type":"text"}]},"doc://EnsemblesBox/documentation/EnsemblesBox/BoxCloudFileSystem":{"type":"topic","identifier":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem","fragments":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"text":"BoxCloudFileSystem","kind":"identifier"}],"url":"\/documentation\/ensemblesbox\/boxcloudfilesystem","title":"BoxCloudFileSystem","abstract":[{"type":"text","text":"A cloud file system backed by Box, using the Box Swift SDK ("},{"code":"BoxSdkGen","type":"codeVoice"},{"type":"text","text":")."}],"navigatorTitle":[{"text":"BoxCloudFileSystem","kind":"identifier"}],"kind":"symbol","role":"symbol"},"doc://EnsemblesBox/documentation/EnsemblesBox":{"identifier":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox","abstract":[{"text":"A Box-based cloud backend for Ensembles.","type":"text"}],"role":"collection","title":"EnsemblesBox","kind":"symbol","url":"\/documentation\/ensemblesbox","type":"topic"}}}