{"kind":"symbol","metadata":{"role":"collection","externalID":"EnsemblesBox","symbolKind":"module","roleHeading":"Framework","modules":[{"name":"EnsemblesBox"}],"title":"EnsemblesBox"},"topicSections":[{"anchor":"Cloud-File-System","title":"Cloud File System","identifiers":["doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"EnsemblesBox provides ","type":"text"},{"identifier":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem","type":"reference","isActive":true},{"text":", an implementation of the Ensembles ","type":"text"},{"code":"CloudFileSystem","type":"codeVoice"},{"text":" protocol that stores sync data on ","type":"text"},{"identifier":"https:\/\/www.box.com","type":"reference","isActive":true},{"text":". It uses the official Box Swift SDK (","type":"text"},{"code":"BoxSdkGen","type":"codeVoice"},{"text":") for all API operations.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Box is widely used in enterprise environments and offers strong administrative controls, compliance features, and large storage quotas.","type":"text"}]},{"anchor":"The-ID-Problem","type":"heading","level":3,"text":"The ID Problem"},{"type":"paragraph","inlineContent":[{"text":"Unlike path-based services (pCloud, WebDAV, S3), Box identifies every file and folder by a numeric ID. The Ensembles ","type":"text"},{"code":"CloudFileSystem","type":"codeVoice"},{"text":" protocol uses string paths like ","type":"text"},{"code":"ensembleId\/events\/file.json","type":"codeVoice"},{"text":". ","type":"text"},{"identifier":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem","type":"reference","isActive":true},{"text":" bridges this gap by walking the folder hierarchy to resolve paths to Box IDs, caching the mappings to minimize API calls.","type":"text"}]},{"anchor":"Authentication","type":"heading","level":3,"text":"Authentication"},{"type":"paragraph","inlineContent":[{"text":"Box supports multiple authentication methods (OAuth 2.0, Developer Token, Client Credentials Grant, JWT). Your app creates and configures a ","type":"text"},{"code":"BoxClient","type":"codeVoice"},{"text":" with the appropriate auth, then injects it:","type":"text"}]},{"code":["import EnsemblesBox","import BoxSdkGen","","\/\/ Developer token (for testing)","let auth = BoxDeveloperTokenAuth(token: \"your-dev-token\")","let boxClient = BoxClient(auth: auth)","let cloudFileSystem = BoxCloudFileSystem(client: boxClient)"],"type":"codeListing","syntax":"swift"},{"anchor":"Setup","type":"heading","level":3,"text":"Setup"},{"code":["let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MainStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: BoxCloudFileSystem(client: boxClient)",")","try await ensemble?.attachPersistentStore()"],"type":"codeListing","syntax":"swift"},{"anchor":"Path-Resolution-and-Caching","type":"heading","level":3,"text":"Path Resolution and Caching"},{"type":"paragraph","inlineContent":[{"text":"When Ensembles requests an operation on path ","type":"text"},{"code":"\/ensembleId\/events\/file.json","type":"codeVoice"},{"text":", the backend:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Starts at the Box root folder (ID "},{"type":"codeVoice","code":"\"0\""},{"type":"text","text":")."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Lists the root folder to find "},{"type":"codeVoice","code":"ensembleId"},{"type":"text","text":" and gets its folder ID."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Lists that folder to find "},{"type":"codeVoice","code":"events"},{"type":"text","text":" and gets its folder ID."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Lists that folder to find "},{"type":"codeVoice","code":"file.json"},{"type":"text","text":" and gets its file ID."}],"type":"paragraph"}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"text":"Each resolved ID is cached in an internal dictionary. Subsequent operations on the same path skip the API calls. The cache is invalidated when items are deleted or when not-found errors suggest staleness.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Folder listings are paginated automatically (up to 1000 items per page) to handle large directories.","type":"text"}]},{"anchor":"Error-Handling","type":"heading","level":3,"text":"Error Handling"},{"type":"paragraph","inlineContent":[{"text":"Box SDK errors are mapped to ","type":"text"},{"code":"EnsembleError","type":"codeVoice"},{"text":" cases:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Authentication failures (401, unauthorized) map to "},{"type":"codeVoice","code":"EnsembleError\/authenticationFailure"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Not-found errors (404) map to "},{"type":"codeVoice","code":"EnsembleError\/fileAccessFailed"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Conflict errors (409, item already exists) are handled internally with retry logic."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"All other errors map to "},{"type":"codeVoice","code":"EnsembleError\/serverError"},{"type":"text","text":"."}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Dependencies","type":"heading","level":3,"text":"Dependencies"},{"type":"paragraph","inlineContent":[{"text":"This module depends on the ","type":"text"},{"identifier":"https:\/\/github.com\/box\/box-ios-sdk","type":"reference","isActive":true},{"text":" v10+ (","type":"text"},{"code":"BoxSdkGen","type":"codeVoice"},{"text":" module). The SDK has zero external dependencies of its own.","type":"text"}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ensemblesbox"]}],"abstract":[{"type":"text","text":"A Box-based cloud backend for Ensembles."}],"identifier":{"url":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox","interfaceLanguage":"swift"},"sections":[],"hierarchy":{"paths":[[]]},"references":{"https://github.com/box/box-ios-sdk":{"title":"Box iOS SDK","titleInlineContent":[{"type":"text","text":"Box iOS SDK"}],"url":"https:\/\/github.com\/box\/box-ios-sdk","identifier":"https:\/\/github.com\/box\/box-ios-sdk","type":"link"},"doc://EnsemblesBox/documentation/EnsemblesBox":{"title":"EnsemblesBox","url":"\/documentation\/ensemblesbox","abstract":[{"text":"A Box-based cloud backend for Ensembles.","type":"text"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox","role":"collection"},"https://www.box.com":{"title":"Box","titleInlineContent":[{"type":"text","text":"Box"}],"url":"https:\/\/www.box.com","identifier":"https:\/\/www.box.com","type":"link"},"doc://EnsemblesBox/documentation/EnsemblesBox/BoxCloudFileSystem":{"identifier":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BoxCloudFileSystem","kind":"identifier"}],"abstract":[{"text":"A cloud file system backed by Box, using the Box Swift SDK (","type":"text"},{"code":"BoxSdkGen","type":"codeVoice"},{"text":").","type":"text"}],"role":"symbol","url":"\/documentation\/ensemblesbox\/boxcloudfilesystem","type":"topic","kind":"symbol","title":"BoxCloudFileSystem","navigatorTitle":[{"text":"BoxCloudFileSystem","kind":"identifier"}]}}}