{"abstract":[{"type":"text","text":"A Box-based cloud backend for Ensembles."}],"topicSections":[{"identifiers":["doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem"],"title":"Cloud File System","anchor":"Cloud-File-System"}],"sections":[],"metadata":{"modules":[{"name":"EnsemblesBox"}],"symbolKind":"module","externalID":"EnsemblesBox","roleHeading":"Framework","role":"collection","title":"EnsemblesBox"},"variants":[{"paths":["\/documentation\/ensemblesbox"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","hierarchy":{"paths":[[]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"url":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"EnsemblesBox provides "},{"identifier":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem","type":"reference","isActive":true},{"type":"text","text":", an implementation of the Ensembles "},{"type":"codeVoice","code":"CloudFileSystem"},{"type":"text","text":" protocol that stores sync data on "},{"identifier":"https:\/\/www.box.com","type":"reference","isActive":true},{"type":"text","text":". It uses the official Box Swift SDK ("},{"type":"codeVoice","code":"BoxSdkGen"},{"type":"text","text":") for all API operations."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Box is widely used in enterprise environments and offers strong administrative controls, compliance features, and large storage quotas."}]},{"type":"heading","text":"The ID Problem","level":3,"anchor":"The-ID-Problem"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Unlike path-based services (pCloud, WebDAV, S3), Box identifies every file and folder by a numeric ID. The Ensembles "},{"type":"codeVoice","code":"CloudFileSystem"},{"type":"text","text":" protocol uses string paths like "},{"type":"codeVoice","code":"ensembleId\/events\/file.json"},{"type":"text","text":". "},{"identifier":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem","type":"reference","isActive":true},{"type":"text","text":" bridges this gap by walking the folder hierarchy to resolve paths to Box IDs, caching the mappings to minimize API calls."}]},{"type":"heading","text":"Authentication","level":3,"anchor":"Authentication"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Box supports multiple authentication methods (OAuth 2.0, Developer Token, Client Credentials Grant, JWT). Your app creates and configures a "},{"type":"codeVoice","code":"BoxClient"},{"type":"text","text":" with the appropriate auth, then injects it:"}]},{"syntax":"swift","type":"codeListing","code":["import EnsemblesBox","import BoxSdkGen","","\/\/ Developer token (for testing)","let auth = BoxDeveloperTokenAuth(token: \"your-dev-token\")","let boxClient = BoxClient(auth: auth)","let cloudFileSystem = BoxCloudFileSystem(client: boxClient)"]},{"type":"heading","text":"Setup","level":3,"anchor":"Setup"},{"syntax":"swift","type":"codeListing","code":["let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MainStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: BoxCloudFileSystem(client: boxClient)",")","try await ensemble?.attachPersistentStore()"]},{"type":"heading","text":"Path Resolution and Caching","level":3,"anchor":"Path-Resolution-and-Caching"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When Ensembles requests an operation on path "},{"type":"codeVoice","code":"\/ensembleId\/events\/file.json"},{"type":"text","text":", the backend:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Starts at the Box root folder (ID "},{"code":"\"0\"","type":"codeVoice"},{"type":"text","text":")."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Lists the root folder to find "},{"code":"ensembleId","type":"codeVoice"},{"type":"text","text":" and gets its folder ID."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Lists that folder to find "},{"code":"events","type":"codeVoice"},{"type":"text","text":" and gets its folder ID."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Lists that folder to find "},{"code":"file.json","type":"codeVoice"},{"type":"text","text":" and gets its file ID."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each resolved ID is cached in an internal dictionary. Subsequent operations on the same path skip the API calls. The cache is invalidated when items are deleted or when not-found errors suggest staleness."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Folder listings are paginated automatically (up to 1000 items per page) to handle large directories."}]},{"type":"heading","text":"Error Handling","level":3,"anchor":"Error-Handling"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Box SDK errors are mapped to "},{"type":"codeVoice","code":"EnsembleError"},{"type":"text","text":" cases:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Authentication failures (401, unauthorized) map to "},{"code":"EnsembleError\/authenticationFailure","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Not-found errors (404) map to "},{"code":"EnsembleError\/fileAccessFailed","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Conflict errors (409, item already exists) are handled internally with retry logic."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"All other errors map to "},{"code":"EnsembleError\/serverError","type":"codeVoice"},{"type":"text","text":"."}]}]}]},{"type":"heading","text":"Dependencies","level":3,"anchor":"Dependencies"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This module depends on the "},{"identifier":"https:\/\/github.com\/box\/box-ios-sdk","type":"reference","isActive":true},{"type":"text","text":" v10+ ("},{"type":"codeVoice","code":"BoxSdkGen"},{"type":"text","text":" module). The SDK has zero external dependencies of its own."}]}]}],"references":{"https://www.box.com":{"identifier":"https:\/\/www.box.com","titleInlineContent":[{"type":"text","text":"Box"}],"url":"https:\/\/www.box.com","title":"Box","type":"link"},"doc://EnsemblesBox/documentation/EnsemblesBox/BoxCloudFileSystem":{"url":"\/documentation\/ensemblesbox\/boxcloudfilesystem","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BoxCloudFileSystem","kind":"identifier"}],"title":"BoxCloudFileSystem","abstract":[{"text":"A cloud file system backed by Box, using the Box Swift SDK (","type":"text"},{"type":"codeVoice","code":"BoxSdkGen"},{"text":").","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"BoxCloudFileSystem"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem","role":"symbol"},"https://github.com/box/box-ios-sdk":{"identifier":"https:\/\/github.com\/box\/box-ios-sdk","titleInlineContent":[{"type":"text","text":"Box iOS SDK"}],"url":"https:\/\/github.com\/box\/box-ios-sdk","title":"Box iOS SDK","type":"link"},"doc://EnsemblesBox/documentation/EnsemblesBox":{"identifier":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox","url":"\/documentation\/ensemblesbox","type":"topic","abstract":[{"type":"text","text":"A Box-based cloud backend for Ensembles."}],"role":"collection","kind":"symbol","title":"EnsemblesBox"}}}