{"hierarchy":{"paths":[[]]},"topicSections":[{"title":"Cloud File System","identifiers":["doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem"],"anchor":"Cloud-File-System"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ensemblesbox"]}],"kind":"symbol","abstract":[{"text":"A Box-based cloud backend for Ensembles.","type":"text"}],"sections":[],"metadata":{"symbolKind":"module","role":"collection","title":"EnsemblesBox","externalID":"EnsemblesBox","modules":[{"name":"EnsemblesBox"}],"roleHeading":"Framework"},"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"EnsemblesBox provides ","type":"text"},{"isActive":true,"identifier":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem","type":"reference"},{"text":", an implementation of the Ensembles ","type":"text"},{"type":"codeVoice","code":"CloudFileSystem"},{"text":" protocol that stores sync data on ","type":"text"},{"isActive":true,"identifier":"https:\/\/www.box.com","type":"reference"},{"text":". It uses the official Box Swift SDK (","type":"text"},{"type":"codeVoice","code":"BoxSdkGen"},{"text":") for all API operations.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Box is widely used in enterprise environments and offers strong administrative controls, compliance features, and large storage quotas.","type":"text"}],"type":"paragraph"},{"level":3,"text":"The ID Problem","anchor":"The-ID-Problem","type":"heading"},{"inlineContent":[{"text":"Unlike path-based services (pCloud, WebDAV, S3), Box identifies every file and folder by a numeric ID. The Ensembles ","type":"text"},{"type":"codeVoice","code":"CloudFileSystem"},{"text":" protocol uses string paths like ","type":"text"},{"type":"codeVoice","code":"ensembleId\/events\/file.json"},{"text":". ","type":"text"},{"isActive":true,"identifier":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem","type":"reference"},{"text":" bridges this gap by walking the folder hierarchy to resolve paths to Box IDs, caching the mappings to minimize API calls.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Authentication","anchor":"Authentication","type":"heading"},{"inlineContent":[{"text":"Box supports multiple authentication methods (OAuth 2.0, Developer Token, Client Credentials Grant, JWT). Your app creates and configures a ","type":"text"},{"type":"codeVoice","code":"BoxClient"},{"text":" with the appropriate auth, then injects it:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import EnsemblesBox","import BoxSdkGen","","\/\/ Developer token (for testing)","let auth = BoxDeveloperTokenAuth(token: \"your-dev-token\")","let boxClient = BoxClient(auth: auth)","let cloudFileSystem = BoxCloudFileSystem(client: boxClient)"],"type":"codeListing"},{"level":3,"text":"Setup","anchor":"Setup","type":"heading"},{"syntax":"swift","code":["let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MainStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: BoxCloudFileSystem(client: boxClient)",")","try await ensemble?.attachPersistentStore()"],"type":"codeListing"},{"level":3,"text":"Path Resolution and Caching","anchor":"Path-Resolution-and-Caching","type":"heading"},{"inlineContent":[{"text":"When Ensembles requests an operation on path ","type":"text"},{"type":"codeVoice","code":"\/ensembleId\/events\/file.json"},{"text":", the backend:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Starts at the Box root folder (ID "},{"type":"codeVoice","code":"\"0\""},{"type":"text","text":")."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Lists the root folder to find "},{"type":"codeVoice","code":"ensembleId"},{"type":"text","text":" and gets its folder ID."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Lists that folder to find "},{"type":"codeVoice","code":"events"},{"type":"text","text":" and gets its folder ID."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Lists that folder to find "},{"type":"codeVoice","code":"file.json"},{"type":"text","text":" and gets its file ID."}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"text":"Each resolved ID is cached in an internal dictionary. Subsequent operations on the same path skip the API calls. The cache is invalidated when items are deleted or when not-found errors suggest staleness.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Folder listings are paginated automatically (up to 1000 items per page) to handle large directories.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Error Handling","anchor":"Error-Handling","type":"heading"},{"inlineContent":[{"text":"Box SDK errors are mapped to ","type":"text"},{"type":"codeVoice","code":"EnsembleError"},{"text":" cases:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Authentication failures (401, unauthorized) map to "},{"type":"codeVoice","code":"EnsembleError\/authenticationFailure"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Not-found errors (404) map to "},{"type":"codeVoice","code":"EnsembleError\/fileAccessFailed"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Conflict errors (409, item already exists) are handled internally with retry logic."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"All other errors map to "},{"type":"codeVoice","code":"EnsembleError\/serverError"},{"type":"text","text":"."}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":3,"text":"Dependencies","anchor":"Dependencies","type":"heading"},{"inlineContent":[{"text":"This module depends on the ","type":"text"},{"isActive":true,"identifier":"https:\/\/github.com\/box\/box-ios-sdk","type":"reference"},{"text":" v10+ (","type":"text"},{"type":"codeVoice","code":"BoxSdkGen"},{"text":" module). The SDK has zero external dependencies of its own.","type":"text"}],"type":"paragraph"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox"},"references":{"https://www.box.com":{"identifier":"https:\/\/www.box.com","title":"Box","titleInlineContent":[{"text":"Box","type":"text"}],"url":"https:\/\/www.box.com","type":"link"},"doc://EnsemblesBox/documentation/EnsemblesBox":{"url":"\/documentation\/ensemblesbox","abstract":[{"type":"text","text":"A Box-based cloud backend for Ensembles."}],"identifier":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox","role":"collection","type":"topic","title":"EnsemblesBox","kind":"symbol"},"https://github.com/box/box-ios-sdk":{"identifier":"https:\/\/github.com\/box\/box-ios-sdk","title":"Box iOS SDK","titleInlineContent":[{"text":"Box iOS SDK","type":"text"}],"url":"https:\/\/github.com\/box\/box-ios-sdk","type":"link"},"doc://EnsemblesBox/documentation/EnsemblesBox/BoxCloudFileSystem":{"title":"BoxCloudFileSystem","type":"topic","navigatorTitle":[{"kind":"identifier","text":"BoxCloudFileSystem"}],"abstract":[{"text":"A cloud file system backed by Box, using the Box Swift SDK (","type":"text"},{"code":"BoxSdkGen","type":"codeVoice"},{"type":"text","text":")."}],"kind":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"BoxCloudFileSystem"}],"url":"\/documentation\/ensemblesbox\/boxcloudfilesystem","role":"symbol","identifier":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem"}}}