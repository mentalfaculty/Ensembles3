{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"EnsemblesBox provides "},{"identifier":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem","type":"reference","isActive":true},{"type":"text","text":", an implementation of the Ensembles "},{"code":"CloudFileSystem","type":"codeVoice"},{"type":"text","text":" protocol that stores sync data on "},{"identifier":"https:\/\/www.box.com","type":"reference","isActive":true},{"type":"text","text":". It uses the official Box Swift SDK ("},{"code":"BoxSdkGen","type":"codeVoice"},{"type":"text","text":") for all API operations."}]},{"type":"paragraph","inlineContent":[{"text":"Box is widely used in enterprise environments and offers strong administrative controls, compliance features, and large storage quotas.","type":"text"}]},{"anchor":"The-ID-Problem","type":"heading","level":3,"text":"The ID Problem"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Unlike path-based services (pCloud, WebDAV, S3), Box identifies every file and folder by a numeric ID. The Ensembles "},{"type":"codeVoice","code":"CloudFileSystem"},{"type":"text","text":" protocol uses string paths like "},{"type":"codeVoice","code":"ensembleId\/events\/file.json"},{"type":"text","text":". "},{"type":"reference","isActive":true,"identifier":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem"},{"type":"text","text":" bridges this gap by walking the folder hierarchy to resolve paths to Box IDs, caching the mappings to minimize API calls."}]},{"anchor":"Authentication","type":"heading","level":3,"text":"Authentication"},{"type":"paragraph","inlineContent":[{"text":"Box supports multiple authentication methods (OAuth 2.0, Developer Token, Client Credentials Grant, JWT). Your app creates and configures a ","type":"text"},{"code":"BoxClient","type":"codeVoice"},{"text":" with the appropriate auth, then injects it:","type":"text"}]},{"type":"codeListing","code":["import EnsemblesBox","import BoxSdkGen","","\/\/ Developer token (for testing)","let auth = BoxDeveloperTokenAuth(token: \"your-dev-token\")","let boxClient = BoxClient(auth: auth)","let cloudFileSystem = BoxCloudFileSystem(client: boxClient)"],"syntax":"swift"},{"text":"Setup","type":"heading","anchor":"Setup","level":3},{"type":"codeListing","code":["let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MainStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: BoxCloudFileSystem(client: boxClient)",")","try await ensemble?.attachPersistentStore()"],"syntax":"swift"},{"text":"Path Resolution and Caching","type":"heading","anchor":"Path-Resolution-and-Caching","level":3},{"type":"paragraph","inlineContent":[{"text":"When Ensembles requests an operation on path ","type":"text"},{"code":"\/ensembleId\/events\/file.json","type":"codeVoice"},{"text":", the backend:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Starts at the Box root folder (ID "},{"code":"\"0\"","type":"codeVoice"},{"type":"text","text":")."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Lists the root folder to find ","type":"text"},{"type":"codeVoice","code":"ensembleId"},{"text":" and gets its folder ID.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Lists that folder to find "},{"type":"codeVoice","code":"events"},{"type":"text","text":" and gets its folder ID."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Lists that folder to find "},{"code":"file.json","type":"codeVoice"},{"type":"text","text":" and gets its file ID."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each resolved ID is cached in an internal dictionary. Subsequent operations on the same path skip the API calls. The cache is invalidated when items are deleted or when not-found errors suggest staleness."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Folder listings are paginated automatically (up to 1000 items per page) to handle large directories."}]},{"text":"Error Handling","type":"heading","anchor":"Error-Handling","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Box SDK errors are mapped to "},{"code":"EnsembleError","type":"codeVoice"},{"type":"text","text":" cases:"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Authentication failures (401, unauthorized) map to "},{"code":"EnsembleError\/authenticationFailure","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Not-found errors (404) map to "},{"type":"codeVoice","code":"EnsembleError\/fileAccessFailed"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Conflict errors (409, item already exists) are handled internally with retry logic."}]}]},{"content":[{"inlineContent":[{"text":"All other errors map to ","type":"text"},{"code":"EnsembleError\/serverError","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":3,"anchor":"Dependencies","text":"Dependencies","type":"heading"},{"inlineContent":[{"text":"This module depends on the ","type":"text"},{"isActive":true,"identifier":"https:\/\/github.com\/box\/box-ios-sdk","type":"reference"},{"text":" v10+ (","type":"text"},{"code":"BoxSdkGen","type":"codeVoice"},{"text":" module). The SDK has zero external dependencies of its own.","type":"text"}],"type":"paragraph"}]}],"topicSections":[{"identifiers":["doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem"],"title":"Cloud File System","anchor":"Cloud-File-System"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[[]]},"metadata":{"roleHeading":"Framework","externalID":"EnsemblesBox","symbolKind":"module","modules":[{"name":"EnsemblesBox"}],"role":"collection","title":"EnsemblesBox"},"variants":[{"paths":["\/documentation\/ensemblesbox"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"A Box-based cloud backend for Ensembles."}],"sections":[],"kind":"symbol","references":{"doc://EnsemblesBox/documentation/EnsemblesBox":{"identifier":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox","url":"\/documentation\/ensemblesbox","abstract":[{"type":"text","text":"A Box-based cloud backend for Ensembles."}],"kind":"symbol","type":"topic","role":"collection","title":"EnsemblesBox"},"https://github.com/box/box-ios-sdk":{"title":"Box iOS SDK","titleInlineContent":[{"text":"Box iOS SDK","type":"text"}],"url":"https:\/\/github.com\/box\/box-ios-sdk","identifier":"https:\/\/github.com\/box\/box-ios-sdk","type":"link"},"doc://EnsemblesBox/documentation/EnsemblesBox/BoxCloudFileSystem":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"BoxCloudFileSystem"}],"type":"topic","abstract":[{"type":"text","text":"A cloud file system backed by Box, using the Box Swift SDK ("},{"type":"codeVoice","code":"BoxSdkGen"},{"text":").","type":"text"}],"role":"symbol","kind":"symbol","navigatorTitle":[{"text":"BoxCloudFileSystem","kind":"identifier"}],"identifier":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem","title":"BoxCloudFileSystem","url":"\/documentation\/ensemblesbox\/boxcloudfilesystem"},"https://www.box.com":{"title":"Box","type":"link","identifier":"https:\/\/www.box.com","url":"https:\/\/www.box.com","titleInlineContent":[{"text":"Box","type":"text"}]}}}