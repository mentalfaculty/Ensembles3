{"kind":"symbol","hierarchy":{"paths":[[]]},"identifier":{"url":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"topicSections":[{"identifiers":["doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem"],"anchor":"Cloud-File-System","title":"Cloud File System"}],"sections":[],"metadata":{"modules":[{"name":"EnsemblesBox"}],"role":"collection","roleHeading":"Framework","title":"EnsemblesBox","externalID":"EnsemblesBox","symbolKind":"module"},"abstract":[{"type":"text","text":"A Box-based cloud backend for Ensembles."}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"EnsemblesBox provides "},{"isActive":true,"type":"reference","identifier":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem"},{"type":"text","text":", an implementation of the Ensembles "},{"code":"CloudFileSystem","type":"codeVoice"},{"type":"text","text":" protocol that stores sync data on "},{"isActive":true,"type":"reference","identifier":"https:\/\/www.box.com"},{"type":"text","text":". It uses the official Box Swift SDK ("},{"code":"BoxSdkGen","type":"codeVoice"},{"text":") for all API operations.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Box is widely used in enterprise environments and offers strong administrative controls, compliance features, and large storage quotas."}],"type":"paragraph"},{"level":3,"text":"The ID Problem","type":"heading","anchor":"The-ID-Problem"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Unlike path-based services (pCloud, WebDAV, S3), Box identifies every file and folder by a numeric ID. The Ensembles "},{"type":"codeVoice","code":"CloudFileSystem"},{"type":"text","text":" protocol uses string paths like "},{"type":"codeVoice","code":"ensembleId\/events\/file.json"},{"type":"text","text":". "},{"identifier":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem","isActive":true,"type":"reference"},{"type":"text","text":" bridges this gap by walking the folder hierarchy to resolve paths to Box IDs, caching the mappings to minimize API calls."}]},{"level":3,"anchor":"Authentication","type":"heading","text":"Authentication"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Box supports multiple authentication methods (OAuth 2.0, Developer Token, Client Credentials Grant, JWT). Your app creates and configures a "},{"type":"codeVoice","code":"BoxClient"},{"type":"text","text":" with the appropriate auth, then injects it:"}]},{"code":["import EnsemblesBox","import BoxSdkGen","","\/\/ Developer token (for testing)","let auth = BoxDeveloperTokenAuth(token: \"your-dev-token\")","let boxClient = BoxClient(auth: auth)","let cloudFileSystem = BoxCloudFileSystem(client: boxClient)"],"type":"codeListing","syntax":"swift"},{"level":3,"text":"Setup","type":"heading","anchor":"Setup"},{"code":["let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MainStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: BoxCloudFileSystem(client: boxClient)",")","try await ensemble?.attachPersistentStore()"],"type":"codeListing","syntax":"swift"},{"level":3,"text":"Path Resolution and Caching","type":"heading","anchor":"Path-Resolution-and-Caching"},{"type":"paragraph","inlineContent":[{"text":"When Ensembles requests an operation on path ","type":"text"},{"code":"\/ensembleId\/events\/file.json","type":"codeVoice"},{"text":", the backend:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Starts at the Box root folder (ID "},{"type":"codeVoice","code":"\"0\""},{"type":"text","text":")."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Lists the root folder to find "},{"type":"codeVoice","code":"ensembleId"},{"type":"text","text":" and gets its folder ID."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Lists that folder to find "},{"type":"codeVoice","code":"events"},{"type":"text","text":" and gets its folder ID."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Lists that folder to find "},{"type":"codeVoice","code":"file.json"},{"type":"text","text":" and gets its file ID."}],"type":"paragraph"}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each resolved ID is cached in an internal dictionary. Subsequent operations on the same path skip the API calls. The cache is invalidated when items are deleted or when not-found errors suggest staleness."}]},{"inlineContent":[{"type":"text","text":"Folder listings are paginated automatically (up to 1000 items per page) to handle large directories."}],"type":"paragraph"},{"level":3,"text":"Error Handling","type":"heading","anchor":"Error-Handling"},{"inlineContent":[{"text":"Box SDK errors are mapped to ","type":"text"},{"code":"EnsembleError","type":"codeVoice"},{"text":" cases:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Authentication failures (401, unauthorized) map to ","type":"text"},{"type":"codeVoice","code":"EnsembleError\/authenticationFailure"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Not-found errors (404) map to "},{"type":"codeVoice","code":"EnsembleError\/fileAccessFailed"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Conflict errors (409, item already exists) are handled internally with retry logic."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"All other errors map to "},{"type":"codeVoice","code":"EnsembleError\/serverError"},{"type":"text","text":"."}]}]}],"type":"unorderedList"},{"level":3,"anchor":"Dependencies","type":"heading","text":"Dependencies"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This module depends on the "},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/box\/box-ios-sdk"},{"type":"text","text":" v10+ ("},{"type":"codeVoice","code":"BoxSdkGen"},{"type":"text","text":" module). The SDK has zero external dependencies of its own."}]}]}],"variants":[{"paths":["\/documentation\/ensemblesbox"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://EnsemblesBox/documentation/EnsemblesBox/BoxCloudFileSystem":{"abstract":[{"type":"text","text":"A cloud file system backed by Box, using the Box Swift SDK ("},{"type":"codeVoice","code":"BoxSdkGen"},{"type":"text","text":")."}],"identifier":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem","title":"BoxCloudFileSystem","fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"kind":"identifier","text":"BoxCloudFileSystem"}],"type":"topic","url":"\/documentation\/ensemblesbox\/boxcloudfilesystem","kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"BoxCloudFileSystem"}]},"https://github.com/box/box-ios-sdk":{"identifier":"https:\/\/github.com\/box\/box-ios-sdk","title":"Box iOS SDK","url":"https:\/\/github.com\/box\/box-ios-sdk","titleInlineContent":[{"type":"text","text":"Box iOS SDK"}],"type":"link"},"https://www.box.com":{"identifier":"https:\/\/www.box.com","title":"Box","url":"https:\/\/www.box.com","titleInlineContent":[{"type":"text","text":"Box"}],"type":"link"},"doc://EnsemblesBox/documentation/EnsemblesBox":{"kind":"symbol","abstract":[{"text":"A Box-based cloud backend for Ensembles.","type":"text"}],"title":"EnsemblesBox","url":"\/documentation\/ensemblesbox","type":"topic","identifier":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox","role":"collection"}}}