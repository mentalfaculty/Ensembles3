{"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"EnsemblesBox provides "},{"type":"reference","isActive":true,"identifier":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem"},{"type":"text","text":", an implementation of the Ensembles "},{"type":"codeVoice","code":"CloudFileSystem"},{"type":"text","text":" protocol that stores sync data on "},{"type":"reference","isActive":true,"identifier":"https:\/\/www.box.com"},{"type":"text","text":". It uses the official Box Swift SDK ("},{"type":"codeVoice","code":"BoxSdkGen"},{"type":"text","text":") for all API operations."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Box is widely used in enterprise environments and offers strong administrative controls, compliance features, and large storage quotas."}]},{"type":"heading","anchor":"The-ID-Problem","level":3,"text":"The ID Problem"},{"type":"paragraph","inlineContent":[{"text":"Unlike path-based services (pCloud, WebDAV, S3), Box identifies every file and folder by a numeric ID. The Ensembles ","type":"text"},{"code":"CloudFileSystem","type":"codeVoice"},{"text":" protocol uses string paths like ","type":"text"},{"code":"ensembleId\/events\/file.json","type":"codeVoice"},{"text":". ","type":"text"},{"isActive":true,"identifier":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem","type":"reference"},{"text":" bridges this gap by walking the folder hierarchy to resolve paths to Box IDs, caching the mappings to minimize API calls.","type":"text"}]},{"type":"heading","anchor":"Authentication","level":3,"text":"Authentication"},{"type":"paragraph","inlineContent":[{"text":"Box supports multiple authentication methods (OAuth 2.0, Developer Token, Client Credentials Grant, JWT). Your app creates and configures a ","type":"text"},{"code":"BoxClient","type":"codeVoice"},{"text":" with the appropriate auth, then injects it:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import EnsemblesBox","import BoxSdkGen","","\/\/ Developer token (for testing)","let auth = BoxDeveloperTokenAuth(token: \"your-dev-token\")","let boxClient = BoxClient(auth: auth)","let cloudFileSystem = BoxCloudFileSystem(client: boxClient)"]},{"type":"heading","anchor":"Setup","level":3,"text":"Setup"},{"type":"codeListing","syntax":"swift","code":["let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MainStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: BoxCloudFileSystem(client: boxClient)",")","try await ensemble?.attachPersistentStore()"]},{"type":"heading","anchor":"Path-Resolution-and-Caching","text":"Path Resolution and Caching","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"When Ensembles requests an operation on path "},{"type":"codeVoice","code":"\/ensembleId\/events\/file.json"},{"type":"text","text":", the backend:"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Starts at the Box root folder (ID "},{"type":"codeVoice","code":"\"0\""},{"type":"text","text":")."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Lists the root folder to find "},{"type":"codeVoice","code":"ensembleId"},{"type":"text","text":" and gets its folder ID."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Lists that folder to find "},{"type":"codeVoice","code":"events"},{"type":"text","text":" and gets its folder ID."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Lists that folder to find "},{"type":"codeVoice","code":"file.json"},{"type":"text","text":" and gets its file ID."}],"type":"paragraph"}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each resolved ID is cached in an internal dictionary. Subsequent operations on the same path skip the API calls. The cache is invalidated when items are deleted or when not-found errors suggest staleness."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Folder listings are paginated automatically (up to 1000 items per page) to handle large directories."}]},{"type":"heading","anchor":"Error-Handling","level":3,"text":"Error Handling"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Box SDK errors are mapped to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/EnsembleError"},{"type":"text","text":" cases:"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Authentication failures (401, unauthorized) map to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/EnsembleError\/authenticationFailure"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Not-found errors (404) map to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/EnsembleError\/fileAccessFailed"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Conflict errors (409, item already exists) are handled internally with retry logic."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"All other errors map to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/EnsembleError\/serverError"},{"type":"text","text":"."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"heading","anchor":"Dependencies","level":3,"text":"Dependencies"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This module depends on the "},{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/box\/box-ios-sdk"},{"type":"text","text":" v10+ ("},{"type":"codeVoice","code":"BoxSdkGen"},{"type":"text","text":" module). The SDK has zero external dependencies of its own."}]}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ensemblesbox"]}],"metadata":{"externalID":"EnsemblesBox","role":"collection","title":"EnsemblesBox","symbolKind":"module","modules":[{"name":"EnsemblesBox"}],"roleHeading":"Framework"},"sections":[],"hierarchy":{"paths":[[]]},"kind":"symbol","abstract":[{"type":"text","text":"A Box-based cloud backend for Ensembles."}],"topicSections":[{"anchor":"Cloud-File-System","identifiers":["doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem"],"title":"Cloud File System"},{"anchor":"Classes","identifiers":["doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/CoreDataEnsemble","doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/CoreDataEnsembleContainer","doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/EventFileSet","doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/LegacyDataFile","doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/LegacyEventRevision","doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/LegacyGlobalIdentifier","doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/LegacyObjectChange","doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/LegacyStoreModificationEvent","doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/PropertyChangeValue","doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/PropertyChangeValueTransformer","doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/SQLiteDatabase"],"title":"Classes","generated":true},{"identifiers":["doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/CloudFileSystem","doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/CloudFileSystemBatchOperations","doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/CloudFileSystemSetup","doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/CloudItem","doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/CoreDataEnsembleDelegate","doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/DataFileStoring","doc:\/\/EnsemblesBox