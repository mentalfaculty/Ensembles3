{"sections":[],"kind":"symbol","metadata":{"externalID":"EnsemblesBox","title":"EnsemblesBox","symbolKind":"module","modules":[{"name":"EnsemblesBox"}],"roleHeading":"Framework","role":"collection"},"topicSections":[{"anchor":"Cloud-File-System","identifiers":["doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem"],"title":"Cloud File System"}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"EnsemblesBox provides ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem"},{"text":", an implementation of the Ensembles ","type":"text"},{"code":"CloudFileSystem","type":"codeVoice"},{"text":" protocol that stores sync data on ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/www.box.com"},{"text":". It uses the official Box Swift SDK (","type":"text"},{"code":"BoxSdkGen","type":"codeVoice"},{"text":") for all API operations.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Box is widely used in enterprise environments and offers strong administrative controls, compliance features, and large storage quotas.","type":"text"}]},{"type":"heading","text":"The ID Problem","anchor":"The-ID-Problem","level":3},{"type":"paragraph","inlineContent":[{"text":"Unlike path-based services (pCloud, WebDAV, S3), Box identifies every file and folder by a numeric ID. The Ensembles ","type":"text"},{"code":"CloudFileSystem","type":"codeVoice"},{"text":" protocol uses string paths like ","type":"text"},{"code":"ensembleId\/events\/file.json","type":"codeVoice"},{"text":". ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem"},{"type":"text","text":" bridges this gap by walking the folder hierarchy to resolve paths to Box IDs, caching the mappings to minimize API calls."}]},{"type":"heading","text":"Authentication","anchor":"Authentication","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Box supports multiple authentication methods (OAuth 2.0, Developer Token, Client Credentials Grant, JWT). Your app creates and configures a "},{"type":"codeVoice","code":"BoxClient"},{"type":"text","text":" with the appropriate auth, then injects it:"}]},{"type":"codeListing","syntax":"swift","code":["import EnsemblesBox","import BoxSdkGen","","\/\/ Developer token (for testing)","let auth = BoxDeveloperTokenAuth(token: \"your-dev-token\")","let boxClient = BoxClient(auth: auth)","let cloudFileSystem = BoxCloudFileSystem(client: boxClient)"]},{"type":"heading","text":"Setup","anchor":"Setup","level":3},{"type":"codeListing","syntax":"swift","code":["let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MainStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: BoxCloudFileSystem(client: boxClient)",")","try await ensemble?.attachPersistentStore()"]},{"type":"heading","text":"Path Resolution and Caching","anchor":"Path-Resolution-and-Caching","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"When Ensembles requests an operation on path "},{"type":"codeVoice","code":"\/ensembleId\/events\/file.json"},{"type":"text","text":", the backend:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Starts at the Box root folder (ID ","type":"text"},{"code":"\"0\"","type":"codeVoice"},{"text":").","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Lists the root folder to find ","type":"text"},{"code":"ensembleId","type":"codeVoice"},{"text":" and gets its folder ID.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Lists that folder to find ","type":"text"},{"code":"events","type":"codeVoice"},{"text":" and gets its folder ID.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Lists that folder to find ","type":"text"},{"code":"file.json","type":"codeVoice"},{"text":" and gets its file ID.","type":"text"}]}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each resolved ID is cached in an internal dictionary. Subsequent operations on the same path skip the API calls. The cache is invalidated when items are deleted or when not-found errors suggest staleness."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Folder listings are paginated automatically (up to 1000 items per page) to handle large directories."}]},{"type":"heading","text":"Error Handling","anchor":"Error-Handling","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Box SDK errors are mapped to "},{"type":"codeVoice","code":"EnsembleError"},{"type":"text","text":" cases:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Authentication failures (401, unauthorized) map to ","type":"text"},{"code":"EnsembleError\/authenticationFailure","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Not-found errors (404) map to ","type":"text"},{"code":"EnsembleError\/fileAccessFailed","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Conflict errors (409, item already exists) are handled internally with retry logic."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"All other errors map to ","type":"text"},{"type":"codeVoice","code":"EnsembleError\/serverError"},{"text":".","type":"text"}]}]}],"type":"unorderedList"},{"type":"heading","text":"Dependencies","anchor":"Dependencies","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"This module depends on the "},{"identifier":"https:\/\/github.com\/box\/box-ios-sdk","type":"reference","isActive":true},{"type":"text","text":" v10+ ("},{"type":"codeVoice","code":"BoxSdkGen"},{"type":"text","text":" module). The SDK has zero external dependencies of its own."}]}]}],"variants":[{"paths":["\/documentation\/ensemblesbox"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[[]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox"},"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"type":"text","text":"A Box-based cloud backend for Ensembles."}],"references":{"doc://EnsemblesBox/documentation/EnsemblesBox":{"kind":"symbol","title":"EnsemblesBox","url":"\/documentation\/ensemblesbox","type":"topic","identifier":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox","role":"collection","abstract":[{"type":"text","text":"A Box-based cloud backend for Ensembles."}]},"https://www.box.com":{"identifier":"https:\/\/www.box.com","type":"link","title":"Box","url":"https:\/\/www.box.com","titleInlineContent":[{"type":"text","text":"Box"}]},"doc://EnsemblesBox/documentation/EnsemblesBox/BoxCloudFileSystem":{"type":"topic","abstract":[{"type":"text","text":"A cloud file system backed by Box, using the Box Swift SDK ("},{"type":"codeVoice","code":"BoxSdkGen"},{"type":"text","text":")."}],"role":"symbol","identifier":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem","navigatorTitle":[{"kind":"identifier","text":"BoxCloudFileSystem"}],"kind":"symbol","url":"\/documentation\/ensemblesbox\/boxcloudfilesystem","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"text":"BoxCloudFileSystem","kind":"identifier"}],"title":"BoxCloudFileSystem"},"https://github.com/box/box-ios-sdk":{"identifier":"https:\/\/github.com\/box\/box-ios-sdk","type":"link","title":"Box iOS SDK","url":"https:\/\/github.com\/box\/box-ios-sdk","titleInlineContent":[{"type":"text","text":"Box iOS SDK"}]}}}