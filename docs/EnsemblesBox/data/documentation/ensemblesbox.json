{"kind":"symbol","hierarchy":{"paths":[[]]},"abstract":[{"text":"A Box-based cloud backend for Ensembles.","type":"text"}],"topicSections":[{"title":"Cloud File System","identifiers":["doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem"],"anchor":"Cloud-File-System"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ensemblesbox"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox"},"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"symbolKind":"module","modules":[{"name":"EnsemblesBox"}],"roleHeading":"Framework","role":"collection","title":"EnsemblesBox","externalID":"EnsemblesBox"},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"EnsemblesBox provides ","type":"text"},{"identifier":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem","type":"reference","isActive":true},{"text":", an implementation of the Ensembles ","type":"text"},{"type":"codeVoice","code":"CloudFileSystem"},{"text":" protocol that stores sync data on ","type":"text"},{"identifier":"https:\/\/www.box.com","type":"reference","isActive":true},{"text":". It uses the official Box Swift SDK (","type":"text"},{"type":"codeVoice","code":"BoxSdkGen"},{"text":") for all API operations.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Box is widely used in enterprise environments and offers strong administrative controls, compliance features, and large storage quotas.","type":"text"}]},{"text":"The ID Problem","type":"heading","level":3,"anchor":"The-ID-Problem"},{"type":"paragraph","inlineContent":[{"text":"Unlike path-based services (pCloud, WebDAV, S3), Box identifies every file and folder by a numeric ID. The Ensembles ","type":"text"},{"type":"codeVoice","code":"CloudFileSystem"},{"text":" protocol uses string paths like ","type":"text"},{"type":"codeVoice","code":"ensembleId\/events\/file.json"},{"text":". ","type":"text"},{"identifier":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem","type":"reference","isActive":true},{"text":" bridges this gap by walking the folder hierarchy to resolve paths to Box IDs, caching the mappings to minimize API calls.","type":"text"}]},{"text":"Authentication","type":"heading","level":3,"anchor":"Authentication"},{"type":"paragraph","inlineContent":[{"text":"Box supports multiple authentication methods (OAuth 2.0, Developer Token, Client Credentials Grant, JWT). Your app creates and configures a ","type":"text"},{"type":"codeVoice","code":"BoxClient"},{"text":" with the appropriate auth, then injects it:","type":"text"}]},{"syntax":"swift","code":["import EnsemblesBox","import BoxSdkGen","","\/\/ Developer token (for testing)","let auth = BoxDeveloperTokenAuth(token: \"your-dev-token\")","let boxClient = BoxClient(auth: auth)","let cloudFileSystem = BoxCloudFileSystem(client: boxClient)"],"type":"codeListing"},{"text":"Setup","type":"heading","level":3,"anchor":"Setup"},{"syntax":"swift","code":["let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MainStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: BoxCloudFileSystem(client: boxClient)",")","try await ensemble?.attachPersistentStore()"],"type":"codeListing"},{"text":"Path Resolution and Caching","type":"heading","level":3,"anchor":"Path-Resolution-and-Caching"},{"type":"paragraph","inlineContent":[{"text":"When Ensembles requests an operation on path ","type":"text"},{"type":"codeVoice","code":"\/ensembleId\/events\/file.json"},{"text":", the backend:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Starts at the Box root folder (ID "},{"code":"\"0\"","type":"codeVoice"},{"type":"text","text":")."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Lists the root folder to find "},{"code":"ensembleId","type":"codeVoice"},{"type":"text","text":" and gets its folder ID."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Lists that folder to find "},{"code":"events","type":"codeVoice"},{"type":"text","text":" and gets its folder ID."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Lists that folder to find "},{"code":"file.json","type":"codeVoice"},{"type":"text","text":" and gets its file ID."}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Each resolved ID is cached in an internal dictionary. Subsequent operations on the same path skip the API calls. The cache is invalidated when items are deleted or when not-found errors suggest staleness.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Folder listings are paginated automatically (up to 1000 items per page) to handle large directories.","type":"text"}]},{"text":"Error Handling","type":"heading","level":3,"anchor":"Error-Handling"},{"type":"paragraph","inlineContent":[{"text":"Box SDK errors are mapped to ","type":"text"},{"type":"codeVoice","code":"EnsembleError"},{"text":" cases:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Authentication failures (401, unauthorized) map to "},{"code":"EnsembleError\/authenticationFailure","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Not-found errors (404) map to "},{"code":"EnsembleError\/fileAccessFailed","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Conflict errors (409, item already exists) are handled internally with retry logic."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"All other errors map to "},{"code":"EnsembleError\/serverError","type":"codeVoice"},{"type":"text","text":"."}]}]}]},{"text":"Dependencies","type":"heading","level":3,"anchor":"Dependencies"},{"type":"paragraph","inlineContent":[{"text":"This module depends on the ","type":"text"},{"identifier":"https:\/\/github.com\/box\/box-ios-sdk","type":"reference","isActive":true},{"text":" v10+ (","type":"text"},{"type":"codeVoice","code":"BoxSdkGen"},{"text":" module). The SDK has zero external dependencies of its own.","type":"text"}]}]}],"references":{"doc://EnsemblesBox/documentation/EnsemblesBox/BoxCloudFileSystem":{"url":"\/documentation\/ensemblesbox\/boxcloudfilesystem","title":"BoxCloudFileSystem","kind":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"BoxCloudFileSystem"}],"abstract":[{"text":"A cloud file system backed by Box, using the Box Swift SDK (","type":"text"},{"code":"BoxSdkGen","type":"codeVoice"},{"type":"text","text":")."}],"type":"topic","identifier":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"BoxCloudFileSystem"}]},"https://www.box.com":{"titleInlineContent":[{"text":"Box","type":"text"}],"title":"Box","type":"link","identifier":"https:\/\/www.box.com","url":"https:\/\/www.box.com"},"doc://EnsemblesBox/documentation/EnsemblesBox":{"url":"\/documentation\/ensemblesbox","title":"EnsemblesBox","kind":"symbol","abstract":[{"type":"text","text":"A Box-based cloud backend for Ensembles."}],"type":"topic","identifier":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox","role":"collection"},"https://github.com/box/box-ios-sdk":{"titleInlineContent":[{"text":"Box iOS SDK","type":"text"}],"title":"Box iOS SDK","type":"link","identifier":"https:\/\/github.com\/box\/box-ios-sdk","url":"https:\/\/github.com\/box\/box-ios-sdk"}}}