{"abstract":[{"type":"text","text":"A Box-based cloud backend for Ensembles."}],"primaryContentSections":[{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"text":"EnsemblesBox provides ","type":"text"},{"type":"reference","identifier":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem","isActive":true},{"text":", an implementation of the Ensembles ","type":"text"},{"type":"codeVoice","code":"CloudFileSystem"},{"text":" protocol that stores sync data on ","type":"text"},{"type":"reference","identifier":"https:\/\/www.box.com","isActive":true},{"text":". It uses the official Box Swift SDK (","type":"text"},{"type":"codeVoice","code":"BoxSdkGen"},{"text":") for all API operations.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Box is widely used in enterprise environments and offers strong administrative controls, compliance features, and large storage quotas.","type":"text"}],"type":"paragraph"},{"level":3,"text":"The ID Problem","type":"heading","anchor":"The-ID-Problem"},{"inlineContent":[{"text":"Unlike path-based services (pCloud, WebDAV, S3), Box identifies every file and folder by a numeric ID. The Ensembles ","type":"text"},{"type":"codeVoice","code":"CloudFileSystem"},{"text":" protocol uses string paths like ","type":"text"},{"type":"codeVoice","code":"ensembleId\/events\/file.json"},{"text":". ","type":"text"},{"type":"reference","identifier":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem","isActive":true},{"text":" bridges this gap by walking the folder hierarchy to resolve paths to Box IDs, caching the mappings to minimize API calls.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Authentication","type":"heading","anchor":"Authentication"},{"inlineContent":[{"text":"Box supports multiple authentication methods (OAuth 2.0, Developer Token, Client Credentials Grant, JWT). Your app creates and configures a ","type":"text"},{"type":"codeVoice","code":"BoxClient"},{"text":" with the appropriate auth, then injects it:","type":"text"}],"type":"paragraph"},{"code":["import EnsemblesBox","import BoxSdkGen","","\/\/ Developer token (for testing)","let auth = BoxDeveloperTokenAuth(token: \"your-dev-token\")","let boxClient = BoxClient(auth: auth)","let cloudFileSystem = BoxCloudFileSystem(client: boxClient)"],"syntax":"swift","type":"codeListing"},{"level":3,"text":"Setup","type":"heading","anchor":"Setup"},{"code":["let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MainStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: BoxCloudFileSystem(client: boxClient)",")","try await ensemble?.attachPersistentStore()"],"syntax":"swift","type":"codeListing"},{"level":3,"text":"Path Resolution and Caching","type":"heading","anchor":"Path-Resolution-and-Caching"},{"inlineContent":[{"text":"When Ensembles requests an operation on path ","type":"text"},{"type":"codeVoice","code":"\/ensembleId\/events\/file.json"},{"text":", the backend:","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Starts at the Box root folder (ID ","type":"text"},{"code":"\"0\"","type":"codeVoice"},{"text":").","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Lists the root folder to find ","type":"text"},{"code":"ensembleId","type":"codeVoice"},{"text":" and gets its folder ID.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Lists that folder to find ","type":"text"},{"code":"events","type":"codeVoice"},{"text":" and gets its folder ID.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Lists that folder to find ","type":"text"},{"code":"file.json","type":"codeVoice"},{"text":" and gets its file ID.","type":"text"}]}]}]},{"inlineContent":[{"text":"Each resolved ID is cached in an internal dictionary. Subsequent operations on the same path skip the API calls. The cache is invalidated when items are deleted or when not-found errors suggest staleness.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Folder listings are paginated automatically (up to 1000 items per page) to handle large directories.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Error Handling","type":"heading","anchor":"Error-Handling"},{"inlineContent":[{"text":"Box SDK errors are mapped to ","type":"text"},{"type":"codeVoice","code":"EnsembleError"},{"text":" cases:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Authentication failures (401, unauthorized) map to ","type":"text"},{"code":"EnsembleError\/authenticationFailure","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Not-found errors (404) map to ","type":"text"},{"code":"EnsembleError\/fileAccessFailed","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Conflict errors (409, item already exists) are handled internally with retry logic.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"All other errors map to ","type":"text"},{"code":"EnsembleError\/serverError","type":"codeVoice"},{"text":".","type":"text"}]}]}]},{"level":3,"text":"Dependencies","type":"heading","anchor":"Dependencies"},{"inlineContent":[{"text":"This module depends on the ","type":"text"},{"type":"reference","identifier":"https:\/\/github.com\/box\/box-ios-sdk","isActive":true},{"text":" v10+ (","type":"text"},{"type":"codeVoice","code":"BoxSdkGen"},{"text":" module). The SDK has zero external dependencies of its own.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"topicSections":[{"title":"Cloud File System","anchor":"Cloud-File-System","identifiers":["doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem"]}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ensemblesbox"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[[]]},"metadata":{"title":"EnsemblesBox","role":"collection","roleHeading":"Framework","externalID":"EnsemblesBox","modules":[{"name":"EnsemblesBox"}],"symbolKind":"module"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox"},"sections":[],"references":{"doc://EnsemblesBox/documentation/EnsemblesBox/BoxCloudFileSystem":{"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"BoxCloudFileSystem"}],"navigatorTitle":[{"text":"BoxCloudFileSystem","kind":"identifier"}],"url":"\/documentation\/ensemblesbox\/boxcloudfilesystem","kind":"symbol","title":"BoxCloudFileSystem","identifier":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem","abstract":[{"text":"A cloud file system backed by Box, using the Box Swift SDK (","type":"text"},{"code":"BoxSdkGen","type":"codeVoice"},{"text":").","type":"text"}],"type":"topic","role":"symbol"},"doc://EnsemblesBox/documentation/EnsemblesBox":{"abstract":[{"text":"A Box-based cloud backend for Ensembles.","type":"text"}],"kind":"symbol","role":"collection","type":"topic","title":"EnsemblesBox","url":"\/documentation\/ensemblesbox","identifier":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox"},"https://github.com/box/box-ios-sdk":{"identifier":"https:\/\/github.com\/box\/box-ios-sdk","titleInlineContent":[{"text":"Box iOS SDK","type":"text"}],"title":"Box iOS SDK","type":"link","url":"https:\/\/github.com\/box\/box-ios-sdk"},"https://www.box.com":{"identifier":"https:\/\/www.box.com","titleInlineContent":[{"text":"Box","type":"text"}],"title":"Box","type":"link","url":"https:\/\/www.box.com"}}}