{"hierarchy":{"paths":[[]]},"metadata":{"title":"EnsemblesBox","externalID":"EnsemblesBox","modules":[{"name":"EnsemblesBox"}],"role":"collection","symbolKind":"module","roleHeading":"Framework"},"topicSections":[{"anchor":"Cloud-File-System","identifiers":["doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem"],"title":"Cloud File System"}],"kind":"symbol","primaryContentSections":[{"content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"EnsemblesBox provides ","type":"text"},{"type":"reference","identifier":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem","isActive":true},{"text":", an implementation of the Ensembles ","type":"text"},{"type":"codeVoice","code":"CloudFileSystem"},{"text":" protocol that stores sync data on ","type":"text"},{"type":"reference","identifier":"https:\/\/www.box.com","isActive":true},{"text":". It uses the official Box Swift SDK (","type":"text"},{"type":"codeVoice","code":"BoxSdkGen"},{"text":") for all API operations.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Box is widely used in enterprise environments and offers strong administrative controls, compliance features, and large storage quotas.","type":"text"}]},{"type":"heading","text":"The ID Problem","anchor":"The-ID-Problem","level":3},{"type":"paragraph","inlineContent":[{"text":"Unlike path-based services (pCloud, WebDAV, S3), Box identifies every file and folder by a numeric ID. The Ensembles ","type":"text"},{"type":"codeVoice","code":"CloudFileSystem"},{"text":" protocol uses string paths like ","type":"text"},{"type":"codeVoice","code":"ensembleId\/events\/file.json"},{"text":". ","type":"text"},{"type":"reference","identifier":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem","isActive":true},{"text":" bridges this gap by walking the folder hierarchy to resolve paths to Box IDs, caching the mappings to minimize API calls.","type":"text"}]},{"type":"heading","text":"Authentication","anchor":"Authentication","level":3},{"type":"paragraph","inlineContent":[{"text":"Box supports multiple authentication methods (OAuth 2.0, Developer Token, Client Credentials Grant, JWT). Your app creates and configures a ","type":"text"},{"type":"codeVoice","code":"BoxClient"},{"text":" with the appropriate auth, then injects it:","type":"text"}]},{"type":"codeListing","code":["import EnsemblesBox","import BoxSdkGen","","\/\/ Developer token (for testing)","let auth = BoxDeveloperTokenAuth(token: \"your-dev-token\")","let boxClient = BoxClient(auth: auth)","let cloudFileSystem = BoxCloudFileSystem(client: boxClient)"],"syntax":"swift"},{"type":"heading","text":"Setup","anchor":"Setup","level":3},{"type":"codeListing","code":["let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MainStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: BoxCloudFileSystem(client: boxClient)",")","try await ensemble?.attachPersistentStore()"],"syntax":"swift"},{"type":"heading","text":"Path Resolution and Caching","anchor":"Path-Resolution-and-Caching","level":3},{"type":"paragraph","inlineContent":[{"text":"When Ensembles requests an operation on path ","type":"text"},{"type":"codeVoice","code":"\/ensembleId\/events\/file.json"},{"text":", the backend:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"Starts at the Box root folder (ID ","type":"text"},{"type":"codeVoice","code":"\"0\""},{"text":").","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Lists the root folder to find "},{"code":"ensembleId","type":"codeVoice"},{"text":" and gets its folder ID.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Lists that folder to find ","type":"text"},{"type":"codeVoice","code":"events"},{"text":" and gets its folder ID.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Lists that folder to find ","type":"text"},{"type":"codeVoice","code":"file.json"},{"text":" and gets its file ID.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"Each resolved ID is cached in an internal dictionary. Subsequent operations on the same path skip the API calls. The cache is invalidated when items are deleted or when not-found errors suggest staleness.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Folder listings are paginated automatically (up to 1000 items per page) to handle large directories.","type":"text"}]},{"type":"heading","text":"Error Handling","anchor":"Error-Handling","level":3},{"type":"paragraph","inlineContent":[{"text":"Box SDK errors are mapped to ","type":"text"},{"code":"EnsembleError","type":"codeVoice"},{"text":" cases:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Authentication failures (401, unauthorized) map to ","type":"text"},{"type":"codeVoice","code":"EnsembleError\/authenticationFailure"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Not-found errors (404) map to ","type":"text"},{"code":"EnsembleError\/fileAccessFailed","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Conflict errors (409, item already exists) are handled internally with retry logic.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"All other errors map to ","type":"text"},{"code":"EnsembleError\/serverError","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","text":"Dependencies","anchor":"Dependencies","level":3},{"type":"paragraph","inlineContent":[{"text":"This module depends on the ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/box\/box-ios-sdk"},{"text":" v10+ (","type":"text"},{"type":"codeVoice","code":"BoxSdkG