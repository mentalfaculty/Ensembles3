{"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"EnsemblesBox provides ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem"},{"text":", an implementation of the Ensembles ","type":"text"},{"type":"codeVoice","code":"CloudFileSystem"},{"text":" protocol that stores sync data on ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/www.box.com"},{"text":". It uses the official Box Swift SDK (","type":"text"},{"type":"codeVoice","code":"BoxSdkGen"},{"text":") for all API operations.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Box is widely used in enterprise environments and offers strong administrative controls, compliance features, and large storage quotas.","type":"text"}]},{"type":"heading","anchor":"The-ID-Problem","level":3,"text":"The ID Problem"},{"type":"paragraph","inlineContent":[{"text":"Unlike path-based services (pCloud, WebDAV, S3), Box identifies every file and folder by a numeric ID. The Ensembles ","type":"text"},{"type":"codeVoice","code":"CloudFileSystem"},{"text":" protocol uses string paths like ","type":"text"},{"type":"codeVoice","code":"ensembleId\/events\/file.json"},{"text":". ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem"},{"text":" bridges this gap by walking the folder hierarchy to resolve paths to Box IDs, caching the mappings to minimize API calls.","type":"text"}]},{"type":"heading","anchor":"Authentication","level":3,"text":"Authentication"},{"type":"paragraph","inlineContent":[{"text":"Box supports multiple authentication methods (OAuth 2.0, Developer Token, Client Credentials Grant, JWT). Your app creates and configures a ","type":"text"},{"type":"codeVoice","code":"BoxClient"},{"text":" with the appropriate auth, then injects it:","type":"text"}]},{"code":["import EnsemblesBox","import BoxSdkGen","","\/\/ Developer token (for testing)","let auth = BoxDeveloperTokenAuth(token: \"your-dev-token\")","let boxClient = BoxClient(auth: auth)","let cloudFileSystem = BoxCloudFileSystem(client: boxClient)"],"type":"codeListing","syntax":"swift"},{"type":"heading","anchor":"Setup","level":3,"text":"Setup"},{"code":["let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MainStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: BoxCloudFileSystem(client: boxClient)",")","try await ensemble?.attachPersistentStore()"],"type":"codeListing","syntax":"swift"},{"type":"heading","anchor":"Path-Resolution-and-Caching","level":3,"text":"Path Resolution and Caching"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When Ensembles requests an operation on path "},{"type":"codeVoice","code":"\/ensembleId\/events\/file.json"},{"type":"text","text":", the backend:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Starts at the Box root folder (ID ","type":"text"},{"code":"\"0\"","type":"codeVoice"},{"text":").","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Lists the root folder to find ","type":"text"},{"code":"ensembleId","type":"codeVoice"},{"text":" and gets its folder ID.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Lists that folder to find ","type":"text"},{"code":"events","type":"codeVoice"},{"text":" and gets its folder ID.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Lists that folder to find ","type":"text"},{"code":"file.json","type":"codeVoice"},{"text":" and gets its file ID.","type":"text"}]}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each resolved ID is cached in an internal dictionary. Subsequent operations on the same path skip the API calls. The cache is invalidated when items are deleted or when not-found errors suggest staleness."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Folder listings are paginated automatically (up to 1000 items per page) to handle large directories."}]},{"type":"heading","anchor":"Error-Handling","level":3,"text":"Error Handling"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Box SDK errors are mapped to "},{"type":"codeVoice","code":"EnsembleError"},{"type":"text","text":" cases:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Authentication failures (401, unauthorized) map to ","type":"text"},{"code":"EnsembleError\/authenticationFailure","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Not-found errors (404) map to ","type":"text"},{"code":"EnsembleError\/fileAccessFailed","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Conflict errors (409, item already exists) are handled internally with retry logic.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"All other errors map to ","type":"text"},{"code":"EnsembleError\/serverError","type":"codeVoice"},{"text":".","type":"text"}]}]}],"type":"unorderedList"},{"anchor":"Dependencies","type":"heading","text":"Dependencies","level":3},{"type":"paragraph","inlineContent":[{"text":"This module depends on the ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/box\/box-ios-sdk"},{"text":" v10+ (","type":"text"},{"type":"codeVoice","code":"BoxSdkGen"},{"text":" module). The SDK has zero external dependencies of its own.","type":"text"}]}]}],"variants":[{"paths":["\/documentation\/ensemblesbox"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","hierarchy":{"paths":[[]]},"identifier":{"url":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox","interfaceLanguage":"swift"},"metadata":{"modules":[{"name":"EnsemblesBox"}],"title":"EnsemblesBox","role":"collection","roleHeading":"Framework","externalID":"EnsemblesBox","symbolKind":"module"},"abstract":[{"type":"text","text":"A Box-based cloud backend for Ensembles."}],"sections":[],"topicSections":[{"title":"Cloud File System","identifiers":["doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem"],"anchor":"Cloud-File-System"}],"references":{"doc://EnsemblesBox/documentation/EnsemblesBox/BoxCloudFileSystem":{"title":"BoxCloudFileSystem","kind":"symbol","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"BoxCloudFileSystem"}],"identifier":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem","url":"\/documentation\/ensemblesbox\/boxcloudfilesystem","navigatorTitle":[{"text":"BoxCloudFileSystem","kind":"identifier"}],"abstract":[{"type":"text","text":"A cloud file system backed by Box, using the Box Swift SDK ("},{"type":"codeVoice","code":"BoxSdkGen"},{"type":"text","text":")."}],"type":"topic"},"https://github.com/box/box-ios-sdk":{"titleInlineContent":[{"text":"Box iOS SDK","type":"text"}],"url":"https:\/\/github.com\/box\/box-ios-sdk","identifier":"https:\/\/github.com\/box\/box-ios-sdk","type":"link","title":"Box iOS SDK"},"https://www.box.com":{"titleInlineContent":[{"text":"Box","type":"text"}],"url":"https:\/\/www.box.com","identifier":"https:\/\/www.box.com","type":"link","title":"Box"},"doc://EnsemblesBox/documentation/EnsemblesBox":{"url":"\/documentation\/ensemblesbox","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"A Box-based cloud backend for Ensembles."}],"title":"EnsemblesBox","identifier":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox","role":"collection"}}}