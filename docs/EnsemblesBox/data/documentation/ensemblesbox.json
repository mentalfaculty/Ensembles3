{"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","sections":[],"hierarchy":{"paths":[[]]},"metadata":{"role":"collection","roleHeading":"Framework","title":"EnsemblesBox","modules":[{"name":"EnsemblesBox"}],"externalID":"EnsemblesBox","symbolKind":"module"},"abstract":[{"type":"text","text":"A Box-based cloud backend for Ensembles."}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"EnsemblesBox provides ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem"},{"text":", an implementation of the Ensembles ","type":"text"},{"type":"codeVoice","code":"CloudFileSystem"},{"text":" protocol that stores sync data on ","type":"text"},{"type":"reference","isActive":true,"identifier":"https:\/\/www.box.com"},{"text":". It uses the official Box Swift SDK (","type":"text"},{"type":"codeVoice","code":"BoxSdkGen"},{"text":") for all API operations.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Box is widely used in enterprise environments and offers strong administrative controls, compliance features, and large storage quotas.","type":"text"}]},{"anchor":"The-ID-Problem","type":"heading","text":"The ID Problem","level":3},{"type":"paragraph","inlineContent":[{"text":"Unlike path-based services (pCloud, WebDAV, S3), Box identifies every file and folder by a numeric ID. The Ensembles ","type":"text"},{"type":"codeVoice","code":"CloudFileSystem"},{"text":" protocol uses string paths like ","type":"text"},{"type":"codeVoice","code":"ensembleId\/events\/file.json"},{"text":". ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem"},{"text":" bridges this gap by walking the folder hierarchy to resolve paths to Box IDs, caching the mappings to minimize API calls.","type":"text"}]},{"anchor":"Authentication","type":"heading","text":"Authentication","level":3},{"type":"paragraph","inlineContent":[{"text":"Box supports multiple authentication methods (OAuth 2.0, Developer Token, Client Credentials Grant, JWT). Your app creates and configures a ","type":"text"},{"type":"codeVoice","code":"BoxClient"},{"text":" with the appropriate auth, then injects it:","type":"text"}]},{"code":["import EnsemblesBox","import BoxSdkGen","","\/\/ Developer token (for testing)","let auth = BoxDeveloperTokenAuth(token: \"your-dev-token\")","let boxClient = BoxClient(auth: auth)","let cloudFileSystem = BoxCloudFileSystem(client: boxClient)"],"type":"codeListing","syntax":"swift"},{"anchor":"Setup","type":"heading","text":"Setup","level":3},{"code":["let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MainStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: BoxCloudFileSystem(client: boxClient)",")","try await ensemble?.attachPersistentStore()"],"type":"codeListing","syntax":"swift"},{"anchor":"Path-Resolution-and-Caching","type":"heading","text":"Path Resolution and Caching","level":3},{"type":"paragraph","inlineContent":[{"text":"When Ensembles requests an operation on path ","type":"text"},{"type":"codeVoice","code":"\/ensembleId\/events\/file.json"},{"text":", the backend:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Starts at the Box root folder (ID ","type":"text"},{"code":"\"0\"","type":"codeVoice"},{"text":").","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Lists the root folder to find ","type":"text"},{"code":"ensembleId","type":"codeVoice"},{"text":" and gets its folder ID.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Lists that folder to find ","type":"text"},{"code":"events","type":"codeVoice"},{"text":" and gets its folder ID.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Lists that folder to find ","type":"text"},{"code":"file.json","type":"codeVoice"},{"text":" and gets its file ID.","type":"text"}]}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"text":"Each resolved ID is cached in an internal dictionary. Subsequent operations on the same path skip the API calls. The cache is invalidated when items are deleted or when not-found errors suggest staleness.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Folder listings are paginated automatically (up to 1000 items per page) to handle large directories.","type":"text"}]},{"anchor":"Error-Handling","type":"heading","text":"Error Handling","level":3},{"type":"paragraph","inlineContent":[{"text":"Box SDK errors are mapped to ","type":"text"},{"type":"codeVoice","code":"EnsembleError"},{"text":" cases:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Authentication failures (401, unauthorized) map to ","type":"text"},{"code":"EnsembleError\/authenticationFailure","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Not-found errors (404) map to ","type":"text"},{"code":"EnsembleError\/fileAccessFailed","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Conflict errors (409, item already exists) are handled internally with retry logic.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"All other errors map to ","type":"text"},{"code":"EnsembleError\/serverError","type":"codeVoice"},{"text":".","type":"text"}]}]}],"type":"unorderedList"},{"anchor":"Dependencies","type":"heading","text":"Dependencies","level":3},{"type":"paragraph","inlineContent":[{"text":"This module depends on the ","type":"text"},{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/box\/box-ios-sdk"},{"text":" v10+ (","type":"text"},{"type":"codeVoice","code":"BoxSdkGen"},{"text":" module). The SDK has zero external dependencies of its own.","type":"text"}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ensemblesbox"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox"},"topicSections":[{"anchor":"Cloud-File-System","title":"Cloud File System","identifiers":["doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem"]}],"references":{"https://www.box.com":{"titleInlineContent":[{"type":"text","text":"Box"}],"identifier":"https:\/\/www.box.com","title":"Box","url":"https:\/\/www.box.com","type":"link"},"doc://EnsemblesBox/documentation/EnsemblesBox/BoxCloudFileSystem":{"kind":"symbol","title":"BoxCloudFileSystem","role":"symbol","identifier":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem","abstract":[{"text":"A cloud file system backed by Box, using the Box Swift SDK (","type":"text"},{"code":"BoxSdkGen","type":"codeVoice"},{"text":").","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"BoxCloudFileSystem"}],"navigatorTitle":[{"kind":"identifier","text":"BoxCloudFileSystem"}],"type":"topic","url":"\/documentation\/ensemblesbox\/boxcloudfilesystem"},"https://github.com/box/box-ios-sdk":{"titleInlineContent":[{"type":"text","text":"Box iOS SDK"}],"identifier":"https:\/\/github.com\/box\/box-ios-sdk","title":"Box iOS SDK","url":"https:\/\/github.com\/box\/box-ios-sdk","type":"link"},"doc://EnsemblesBox/documentation/EnsemblesBox":{"role":"collection","type":"topic","identifier":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox","abstract":[{"text":"A Box-based cloud backend for Ensembles.","type":"text"}],"title":"EnsemblesBox","kind":"symbol","url":"\/documentation\/ensemblesbox"}}}