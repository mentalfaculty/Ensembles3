{"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox"},"hierarchy":{"paths":[[]]},"abstract":[{"text":"A Box-based cloud backend for Ensembles.","type":"text"}],"topicSections":[{"anchor":"Cloud-File-System","identifiers":["doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem"],"title":"Cloud File System"}],"variants":[{"paths":["\/documentation\/ensemblesbox"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"text":"EnsemblesBox provides ","type":"text"},{"identifier":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem","isActive":true,"type":"reference"},{"text":", an implementation of the Ensembles ","type":"text"},{"code":"CloudFileSystem","type":"codeVoice"},{"text":" protocol that stores sync data on ","type":"text"},{"identifier":"https:\/\/www.box.com","isActive":true,"type":"reference"},{"text":". It uses the official Box Swift SDK (","type":"text"},{"code":"BoxSdkGen","type":"codeVoice"},{"text":") for all API operations.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Box is widely used in enterprise environments and offers strong administrative controls, compliance features, and large storage quotas.","type":"text"}],"type":"paragraph"},{"text":"The ID Problem","anchor":"The-ID-Problem","level":3,"type":"heading"},{"inlineContent":[{"text":"Unlike path-based services (pCloud, WebDAV, S3), Box identifies every file and folder by a numeric ID. The Ensembles ","type":"text"},{"code":"CloudFileSystem","type":"codeVoice"},{"text":" protocol uses string paths like ","type":"text"},{"code":"ensembleId\/events\/file.json","type":"codeVoice"},{"text":". ","type":"text"},{"identifier":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem","isActive":true,"type":"reference"},{"text":" bridges this gap by walking the folder hierarchy to resolve paths to Box IDs, caching the mappings to minimize API calls.","type":"text"}],"type":"paragraph"},{"text":"Authentication","anchor":"Authentication","level":3,"type":"heading"},{"inlineContent":[{"text":"Box supports multiple authentication methods (OAuth 2.0, Developer Token, Client Credentials Grant, JWT). Your app creates and configures a ","type":"text"},{"code":"BoxClient","type":"codeVoice"},{"text":" with the appropriate auth, then injects it:","type":"text"}],"type":"paragraph"},{"code":["import EnsemblesBox","import BoxSdkGen","","\/\/ Developer token (for testing)","let auth = BoxDeveloperTokenAuth(token: \"your-dev-token\")","let boxClient = BoxClient(auth: auth)","let cloudFileSystem = BoxCloudFileSystem(client: boxClient)"],"type":"codeListing","syntax":"swift"},{"text":"Setup","anchor":"Setup","level":3,"type":"heading"},{"code":["let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MainStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: BoxCloudFileSystem(client: boxClient)",")","try await ensemble?.attachPersistentStore()"],"type":"codeListing","syntax":"swift"},{"text":"Path Resolution and Caching","anchor":"Path-Resolution-and-Caching","level":3,"type":"heading"},{"inlineContent":[{"text":"When Ensembles requests an operation on path ","type":"text"},{"code":"\/ensembleId\/events\/file.json","type":"codeVoice"},{"text":", the backend:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Starts at the Box root folder (ID "},{"type":"codeVoice","code":"\"0\""},{"type":"text","text":")."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Lists the root folder to find "},{"type":"codeVoice","code":"ensembleId"},{"type":"text","text":" and gets its folder ID."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Lists that folder to find "},{"type":"codeVoice","code":"events"},{"type":"text","text":" and gets its folder ID."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Lists that folder to find "},{"type":"codeVoice","code":"file.json"},{"type":"text","text":" and gets its file ID."}]}]}],"type":"orderedList"},{"inlineContent":[{"text":"Each resolved ID is cached in an internal dictionary. Subsequent operations on the same path skip the API calls. The cache is invalidated when items are deleted or when not-found errors suggest staleness.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Folder listings are paginated automatically (up to 1000 items per page) to handle large directories.","type":"text"}],"type":"paragraph"},{"text":"Error Handling","anchor":"Error-Handling","level":3,"type":"heading"},{"inlineContent":[{"text":"Box SDK errors are mapped to ","type":"text"},{"code":"EnsembleError","type":"codeVoice"},{"text":" cases:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Authentication failures (401, unauthorized) map to "},{"type":"codeVoice","code":"EnsembleError\/authenticationFailure"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Not-found errors (404) map to "},{"type":"codeVoice","code":"EnsembleError\/fileAccessFailed"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Conflict errors (409, item already exists) are handled internally with retry logic."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"All other errors map to "},{"type":"codeVoice","code":"EnsembleError\/serverError"},{"type":"text","text":"."}]}]}],"type":"unorderedList"},{"text":"Dependencies","anchor":"Dependencies","level":3,"type":"heading"},{"inlineContent":[{"text":"This module depends on the ","type":"text"},{"identifier":"https:\/\/github.com\/box\/box-ios-sdk","isActive":true,"type":"reference"},{"text":" v10+ (","type":"text"},{"code":"BoxSdkGen","type":"codeVoice"},{"text":" module). The SDK has zero external dependencies of its own.","type":"text"}],"type":"paragraph"}]}],"kind":"symbol","metadata":{"roleHeading":"Framework","externalID":"EnsemblesBox","role":"collection","title":"EnsemblesBox","modules":[{"name":"EnsemblesBox"}],"symbolKind":"module"},"references":{"doc://EnsemblesBox/documentation/EnsemblesBox/BoxCloudFileSystem":{"title":"BoxCloudFileSystem","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"BoxCloudFileSystem"}],"identifier":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox\/BoxCloudFileSystem","url":"\/documentation\/ensemblesbox\/boxcloudfilesystem","abstract":[{"type":"text","text":"A cloud file system backed by Box, using the Box Swift SDK ("},{"code":"BoxSdkGen","type":"codeVoice"},{"text":").","type":"text"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"BoxCloudFileSystem"}],"role":"symbol","kind":"symbol"},"doc://EnsemblesBox/documentation/EnsemblesBox":{"type":"topic","abstract":[{"type":"text","text":"A Box-based cloud backend for Ensembles."}],"identifier":"doc:\/\/EnsemblesBox\/documentation\/EnsemblesBox","role":"collection","kind":"symbol","title":"EnsemblesBox","url":"\/documentation\/ensemblesbox"},"https://github.com/box/box-ios-sdk":{"url":"https:\/\/github.com\/box\/box-ios-sdk","titleInlineContent":[{"text":"Box iOS SDK","type":"text"}],"type":"link","identifier":"https:\/\/github.com\/box\/box-ios-sdk","title":"Box iOS SDK"},"https://www.box.com":{"url":"https:\/\/www.box.com","titleInlineContent":[{"text":"Box","type":"text"}],"type":"link","identifier":"https:\/\/www.box.com","title":"Box"}}}