{"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted"},"topicSections":[{"identifiers":["doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptedCloudFileSystem"],"anchor":"Cloud-File-System","title":"Cloud File System"},{"identifiers":["doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/VaultInfo"],"anchor":"Structures","title":"Structures","generated":true},{"identifiers":["doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptionError","doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptionFormat","doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/FileEncryptor"],"anchor":"Enumerations","title":"Enumerations","generated":true}],"hierarchy":{"paths":[[]]},"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"EnsemblesEncrypted provides ","type":"text"},{"isActive":true,"identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptedCloudFileSystem","type":"reference"},{"text":", a wrapper that encrypts files before uploading and decrypts after downloading. It can wrap any ","type":"text"},{"code":"CloudFileSystem","type":"codeVoice"},{"text":" implementation — CloudKit, Google Drive, WebDAV, or your own custom backend — to provide end-to-end encryption for sync data.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Encrypted files are stored in a password-derived vault directory with a ","type":"text"},{"code":".cdecrypt","type":"codeVoice"},{"text":" extension. This is backward compatible with the Ensembles 2 Objective-C ","type":"text"},{"code":"CDEEncryptedCloudFileSystem","type":"codeVoice"},{"text":".","type":"text"}]},{"level":3,"type":"heading","text":"Encryption Formats","anchor":"Encryption-Formats"},{"type":"paragraph","inlineContent":[{"text":"Two encryption formats are available:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":".modern","type":"codeVoice"}]},{"text":" (default) — AES-256-GCM. Fast, authenticated encryption using Apple’s CryptoKit. Recommended for new apps.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":".legacy","type":"codeVoice"}]},{"text":" — RNCryptor v3 format. Use this for backward compatibility with Ensembles 2 encrypted data.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"The backend auto-detects the encryption format when downloading, so a ","type":"text"},{"code":".modern","type":"codeVoice"},{"text":" client can read ","type":"text"},{"code":".legacy","type":"codeVoice"},{"text":" files and vice versa. The format setting only controls how ","type":"text"},{"inlineContent":[{"type":"text","text":"new"}],"type":"emphasis"},{"text":" files are encrypted.","type":"text"}]},{"level":3,"type":"heading","text":"Setup","anchor":"Setup"},{"type":"paragraph","inlineContent":[{"text":"Wrap any cloud file system with encryption:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import Ensembles","import EnsemblesEncrypted","import EnsemblesCloudKit","","\/\/ Wrap CloudKit with encryption","let cloudKitFS = CloudKitFileSystem(","    privateDatabaseForUbiquityContainerIdentifier: \"iCloud.com.yourcompany.yourapp\",","    schemaVersion: .v2",")","let encryptedFS = EncryptedCloudFileSystem(","    cloudFileSystem: cloudKitFS,","    password: \"user-supplied-password\"",")","","let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MainStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: encryptedFS!",")","try await ensemble?.attachPersistentStore()"]},{"type":"paragraph","inlineContent":[{"text":"For more control over the vault, use the ","type":"text"},{"code":"VaultInfo","type":"codeVoice"},{"text":" initializer:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let encryptedFS = EncryptedCloudFileSystem(","    cloudFileSystem: innerFS,","    vaultInfo: vaultInfo,","    encryptionFormat: .modern",")"]},{"level":3,"type":"heading","text":"When to Use Encryption","anchor":"When-to-Use-Encryption"},{"type":"paragraph","inlineContent":[{"text":"Ensembles sync data is stored as opaque binary files, so even without encryption the raw data is not human-readable. However, it could be deserialized by someone with access to your cloud storage.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For ","type":"text"},{"inlineContent":[{"type":"text","text":"CloudKit"}],"type":"strong"},{"text":", Apple encrypts ","type":"text"},{"code":"CKAsset","type":"codeVoice"},{"text":" data at rest. With Advanced Data Protection (ADP) enabled, assets are end-to-end encrypted. Wrapping CloudKit with ","type":"text"},{"code":"EncryptedCloudFileSystem","type":"codeVoice"},{"text":" adds a layer of protection that doesn’t depend on the user enabling ADP.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For ","type":"text"},{"inlineContent":[{"type":"text","text":"third-party backends"}],"type":"strong"},{"text":" (Google Drive, OneDrive, WebDAV, etc.), the storage provider can see the raw files. Wrapping with ","type":"text"},{"code":"EncryptedCloudFileSystem","type":"codeVoice"},{"text":" ensures data is encrypted before it leaves the device, regardless of what the provider does.","type":"text"}]},{"level":3,"type":"heading","text":"How It Works","anchor":"How-It-Works"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Vault directory","type":"text"}]},{"text":" — All encrypted files are stored inside a vault directory in the cloud, derived from the password. Different passwords create different vaults, so the same cloud account can host multiple independent encrypted sync stores.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Upload","type":"text"}]},{"text":" — When Ensembles uploads a file, the wrapper encrypts it to a local temporary file, uploads the encrypted version with a ","type":"text"},{"type":"codeVoice","code":".cdecrypt"},{"text":" extension, then removes the temporary file.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Download","type":"text"}],"type":"strong"},{"type":"text","text":" — When Ensembles downloads a file, the wrapper downloads the encrypted "},{"type":"codeVoice","code":".cdecrypt"},{"type":"text","text":" file, auto-detects the format (modern or legacy), decrypts it to a local temporary file, and returns the decrypted content."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Backward compatibility"}],"type":"strong"},{"text":" — The ","type":"text"},{"code":".legacy","type":"codeVoice"},{"text":" format uses RNCryptor v3, the same encryption format used by Ensembles 2’s ","type":"text"},{"code":"CDEEncryptedCloudFileSystem","type":"codeVoice"},{"text":". Apps migrating from E2 to E3 can read existing encrypted cloud data without re-encrypting.","type":"text"}]}]}],"type":"orderedList"},{"level":3,"anchor":"Wrapping-Other-Backends","type":"heading","text":"Wrapping Other Backends"},{"type":"paragraph","inlineContent":[{"text":"The wrapper works with any ","type":"text"},{"code":"CloudFileSystem","type":"codeVoice"},{"text":":","type":"text"}]},{"code":["\/\/ Wrap Google Drive","let encryptedGDrive = EncryptedCloudFileSystem(","    cloudFileSystem: GoogleDriveCloudFileSystem(authenticator: gdAuthenticator),","    password: password",")","","\/\/ Wrap WebDAV","let encryptedWebDAV = EncryptedCloudFileSystem(","    cloudFileSystem: WebDAVCloudFileSystem(baseURL: webdavURL, username: user, password: pass),","    password: encryptionPassword",")"],"type":"codeListing","syntax":"swift"},{"anchor":"Dependencies","text":"Dependencies","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"This module has ","type":"text"},{"inlineContent":[{"text":"no external dependencies","type":"text"}],"type":"strong"},{"text":" beyond Foundation, CryptoKit, and the core ","type":"text"},{"code":"Ensembles","type":"codeVoice"},{"text":" framework.","type":"text"}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/ensemblesencrypted"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"An encryption wrapper for any Ensembles cloud backend.","type":"text"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"roleHeading":"Framework","role":"collection","symbolKind":"module","title":"EnsemblesEncrypted","externalID":"EnsemblesEncrypted","modules":[{"name":"EnsemblesEncrypted"}]},"kind":"symbol","references":{"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/EncryptionError":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EncryptionError","kind":"identifier"}],"identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptionError","navigatorTitle":[{"text":"EncryptionError","kind":"identifier"}],"title":"EncryptionError","url":"\/documentation\/ensemblesencrypted\/encryptionerror","type":"topic","abstract":[{"text":"Errors that can occur during encryption or decryption.","type":"text"}],"role":"symbol","kind":"symbol"},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted":{"identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted","kind":"symbol","title":"EnsemblesEncrypted","role":"collection","abstract":[{"type":"text","text":"An encryption wrapper for any Ensembles cloud backend."}],"url":"\/documentation\/ensemblesencrypted","type":"topic"},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/EncryptionFormat":{"title":"EncryptionFormat","identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptionFormat","kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EncryptionFormat","kind":"identifier"}],"abstract":[{"text":"The encryption format to use when encrypting data.","type":"text"}],"role":"symbol","navigatorTitle":[{"text":"EncryptionFormat","kind":"identifier"}],"url":"\/documentation\/ensemblesencrypted\/encryptionformat","type":"topic"},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/EncryptedCloudFileSystem":{"fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"text":"EncryptedCloudFileSystem","kind":"identifier"}],"role":"symbol","url":"\/documentation\/ensemblesencrypted\/encryptedcloudfilesystem","type":"topic","navigatorTitle":[{"text":"EncryptedCloudFileSystem","kind":"identifier"}],"title":"EncryptedCloudFileSystem","kind":"symbol","identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptedCloudFileSystem","abstract":[{"type":"text","text":"A cloud file system wrapper that encrypts files before uploading"},{"text":" ","type":"text"},{"type":"text","text":"and decrypts them after downloading."}]},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/FileEncryptor":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"FileEncryptor"}],"role":"symbol","url":"\/documentation\/ensemblesencrypted\/fileencryptor","type":"topic","navigatorTitle":[{"kind":"identifier","text":"FileEncryptor"}],"kind":"symbol","title":"FileEncryptor","identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/FileEncryptor","abstract":[{"text":"Unified encryption\/decryption interface with automatic format detection on decrypt.","type":"text"}]},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/VaultInfo":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"VaultInfo","kind":"identifier"}],"abstract":[{"type":"text","text":"Represents a vault in an encrypted cloud file system."}],"title":"VaultInfo","type":"topic","identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/VaultInfo","url":"\/documentation\/ensemblesencrypted\/vaultinfo","navigatorTitle":[{"text":"VaultInfo","kind":"identifier"}],"role":"symbol","kind":"symbol"}}}