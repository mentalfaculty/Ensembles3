{"schemaVersion":{"minor":3,"major":0,"patch":0},"topicSections":[{"anchor":"Cloud-File-System","identifiers":["doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptedCloudFileSystem"],"title":"Cloud File System"},{"anchor":"Structures","identifiers":["doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/VaultInfo"],"generated":true,"title":"Structures"},{"anchor":"Enumerations","identifiers":["doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptionError","doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptionFormat","doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/FileEncryptor"],"generated":true,"title":"Enumerations"}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"EnsemblesEncrypted provides ","type":"text"},{"identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptedCloudFileSystem","isActive":true,"type":"reference"},{"text":", a wrapper that encrypts files before uploading and decrypts after downloading. It can wrap any ","type":"text"},{"code":"CloudFileSystem","type":"codeVoice"},{"text":" implementation — CloudKit, Google Drive, WebDAV, or your own custom backend — to provide end-to-end encryption for sync data.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Encrypted files are stored in a password-derived vault directory with a ","type":"text"},{"code":".cdecrypt","type":"codeVoice"},{"text":" extension. This is backward compatible with the Ensembles 2 Objective-C ","type":"text"},{"code":"CDEEncryptedCloudFileSystem","type":"codeVoice"},{"text":".","type":"text"}]},{"anchor":"Encryption-Formats","level":3,"text":"Encryption Formats","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Two encryption formats are available:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".modern"}]},{"type":"text","text":" (default) — AES-256-GCM. Fast, authenticated encryption using Apple’s CryptoKit. Recommended for new apps."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".legacy"}]},{"type":"text","text":" — RNCryptor v3 format. Use this for backward compatibility with Ensembles 2 encrypted data."}]}]}]},{"type":"paragraph","inlineContent":[{"text":"The backend auto-detects the encryption format when downloading, so a ","type":"text"},{"code":".modern","type":"codeVoice"},{"text":" client can read ","type":"text"},{"code":".legacy","type":"codeVoice"},{"text":" files and vice versa. The format setting only controls how ","type":"text"},{"inlineContent":[{"text":"new","type":"text"}],"type":"emphasis"},{"text":" files are encrypted.","type":"text"}]},{"anchor":"Setup","level":3,"text":"Setup","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Wrap any cloud file system with encryption:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import Ensembles","import EnsemblesEncrypted","import EnsemblesCloudKit","","\/\/ Wrap CloudKit with encryption","let cloudKitFS = CloudKitFileSystem(","    privateDatabaseForUbiquityContainerIdentifier: \"iCloud.com.yourcompany.yourapp\",","    schemaVersion: .v2",")","let encryptedFS = EncryptedCloudFileSystem(","    cloudFileSystem: cloudKitFS,","    password: \"user-supplied-password\"",")","","let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MainStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: encryptedFS!",")","try await ensemble?.attachPersistentStore()"]},{"type":"paragraph","inlineContent":[{"text":"For more control over the vault, use the ","type":"text"},{"code":"VaultInfo","type":"codeVoice"},{"text":" initializer:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let encryptedFS = EncryptedCloudFileSystem(","    cloudFileSystem: innerFS,","    vaultInfo: vaultInfo,","    encryptionFormat: .modern",")"]},{"anchor":"When-to-Use-Encryption","level":3,"text":"When to Use Encryption","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Ensembles sync data is stored as opaque binary files, so even without encryption the raw data is not human-readable. However, it could be deserialized by someone with access to your cloud storage."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For "},{"type":"strong","inlineContent":[{"type":"text","text":"CloudKit"}]},{"type":"text","text":", Apple encrypts "},{"type":"codeVoice","code":"CKAsset"},{"type":"text","text":" data at rest. With Advanced Data Protection (ADP) enabled, assets are end-to-end encrypted. Wrapping CloudKit with "},{"type":"codeVoice","code":"EncryptedCloudFileSystem"},{"type":"text","text":" adds a layer of protection that doesn’t depend on the user enabling ADP."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For "},{"type":"strong","inlineContent":[{"text":"third-party backends","type":"text"}]},{"type":"text","text":" (Google Drive, OneDrive, WebDAV, etc.), the storage provider can see the raw files. Wrapping with "},{"type":"codeVoice","code":"EncryptedCloudFileSystem"},{"type":"text","text":" ensures data is encrypted before it leaves the device, regardless of what the provider does."}]},{"anchor":"How-It-Works","level":3,"text":"How It Works","type":"heading"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Vault directory","type":"text"}]},{"type":"text","text":" — All encrypted files are stored inside a vault directory in the cloud, derived from the password. Different passwords create different vaults, so the same cloud account can host multiple independent encrypted sync stores."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Upload","type":"text"}]},{"type":"text","text":" — When Ensembles uploads a file, the wrapper encrypts it to a local temporary file, uploads the encrypted version with a "},{"code":".cdecrypt","type":"codeVoice"},{"type":"text","text":" extension, then removes the temporary file."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Download","type":"text"}]},{"type":"text","text":" — When Ensembles downloads a file, the wrapper downloads the encrypted "},{"code":".cdecrypt","type":"codeVoice"},{"type":"text","text":" file, auto-detects the format (modern or legacy), decrypts it to a local temporary file, and returns the decrypted content."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Backward compatibility","type":"text"}]},{"type":"text","text":" — The "},{"code":".legacy","type":"codeVoice"},{"type":"text","text":" format uses RNCryptor v3, the same encryption format used by Ensembles 2’s "},{"code":"CDEEncryptedCloudFileSystem","type":"codeVoice"},{"type":"text","text":". Apps migrating from E2 to E3 can read existing encrypted cloud data without re-encrypting."}],"type":"paragraph"}]}]},{"type":"heading","level":3,"text":"Wrapping Other Backends","anchor":"Wrapping-Other-Backends"},{"type":"paragraph","inlineContent":[{"text":"The wrapper works with any ","type":"text"},{"type":"codeVoice","code":"CloudFileSystem"},{"text":":","type":"text"}]},{"type":"codeListing","code":["\/\/ Wrap Google Drive","let encryptedGDrive = EncryptedCloudFileSystem(","    cloudFileSystem: GoogleDriveCloudFileSystem(authenticator: gdAuthenticator),","    password: password",")","","\/\/ Wrap WebDAV","let encryptedWebDAV = EncryptedCloudFileSystem(","    cloudFileSystem: WebDAVCloudFileSystem(baseURL: webdavURL, username: user, password: pass),","    password: encryptionPassword",")"],"syntax":"swift"},{"type":"heading","level":3,"text":"Dependencies","anchor":"Dependencies"},{"type":"paragraph","inlineContent":[{"text":"This module has ","type":"text"},{"inlineContent":[{"type":"text","text":"no external dependencies"}],"type":"strong"},{"text":" beyond Foundation, CryptoKit, and the core ","type":"text"},{"type":"codeVoice","code":"Ensembles"},{"text":" framework.","type":"text"}]}]}],"metadata":{"title":"EnsemblesEncrypted","role":"collection","modules":[{"name":"EnsemblesEncrypted"}],"roleHeading":"Framework","externalID":"EnsemblesEncrypted","symbolKind":"module"},"sections":[],"hierarchy":{"paths":[[]]},"kind":"symbol","identifier":{"url":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"An encryption wrapper for any Ensembles cloud backend."}],"variants":[{"paths":["\/documentation\/ensemblesencrypted"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/EncryptionFormat":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"EncryptionFormat"}],"role":"symbol","abstract":[{"type":"text","text":"The encryption format to use when encrypting data."}],"identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptionFormat","url":"\/documentation\/ensemblesencrypted\/encryptionformat","kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"EncryptionFormat"}],"title":"EncryptionFormat"},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/FileEncryptor":{"role":"symbol","url":"\/documentation\/ensemblesencrypted\/fileencryptor","title":"FileEncryptor","kind":"symbol","navigatorTitle":[{"text":"FileEncryptor","kind":"identifier"}],"identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/FileEncryptor","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FileEncryptor","kind":"identifier"}],"abstract":[{"text":"Unified encryption\/decryption interface with automatic format detection on decrypt.","type":"text"}]},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/EncryptedCloudFileSystem":{"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"text":"EncryptedCloudFileSystem","kind":"identifier"}],"kind":"symbol","role":"symbol","navigatorTitle":[{"text":"EncryptedCloudFileSystem","kind":"identifier"}],"identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptedCloudFileSystem","title":"EncryptedCloudFileSystem","url":"\/documentation\/ensemblesencrypted\/encryptedcloudfilesystem","type":"topic","abstract":[{"text":"A cloud file system wrapper that encrypts files before uploading","type":"text"},{"type":"text","text":" "},{"text":"and decrypts them after downloading.","type":"text"}]},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/VaultInfo":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"VaultInfo"}],"kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"VaultInfo"}],"identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/VaultInfo","title":"VaultInfo","url":"\/documentation\/ensemblesencrypted\/vaultinfo","type":"topic","abstract":[{"text":"Represents a vault in an encrypted cloud file system.","type":"text"}]},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/EncryptionError":{"role":"symbol","url":"\/documentation\/ensemblesencrypted\/encryptionerror","kind":"symbol","title":"EncryptionError","navigatorTitle":[{"kind":"identifier","text":"EncryptionError"}],"identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptionError","type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"EncryptionError"}],"abstract":[{"text":"Errors that can occur during encryption or decryption.","type":"text"}]},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted":{"role":"collection","url":"\/documentation\/ensemblesencrypted","kind":"symbol","title":"EnsemblesEncrypted","identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted","type":"topic","abstract":[{"type":"text","text":"An encryption wrapper for any Ensembles cloud backend."}]}}}