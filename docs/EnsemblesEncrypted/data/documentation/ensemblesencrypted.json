{"topicSections":[{"title":"Cloud File System","anchor":"Cloud-File-System","identifiers":["doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptedCloudFileSystem"]},{"title":"Structures","generated":true,"anchor":"Structures","identifiers":["doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/VaultInfo"]},{"title":"Enumerations","generated":true,"anchor":"Enumerations","identifiers":["doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptionError","doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptionFormat","doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/FileEncryptor"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted"},"variants":[{"paths":["\/documentation\/ensemblesencrypted"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","metadata":{"title":"EnsemblesEncrypted","modules":[{"name":"EnsemblesEncrypted"}],"role":"collection","roleHeading":"Framework","externalID":"EnsemblesEncrypted","symbolKind":"module"},"abstract":[{"type":"text","text":"An encryption wrapper for any Ensembles cloud backend."}],"hierarchy":{"paths":[[]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"inlineContent":[{"type":"text","text":"EnsemblesEncrypted provides "},{"type":"reference","isActive":true,"identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptedCloudFileSystem"},{"type":"text","text":", a wrapper that encrypts files before uploading and decrypts after downloading. It can wrap any "},{"code":"CloudFileSystem","type":"codeVoice"},{"type":"text","text":" implementation — CloudKit, Google Drive, WebDAV, or your own custom backend — to provide end-to-end encryption for sync data."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Encrypted files are stored in a password-derived vault directory with a "},{"type":"codeVoice","code":".cdecrypt"},{"type":"text","text":" extension. This is backward compatible with the Ensembles 2 Objective-C "},{"type":"codeVoice","code":"CDEEncryptedCloudFileSystem"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Encryption-Formats","type":"heading","level":3,"text":"Encryption Formats"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Two encryption formats are available:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".modern"}]},{"type":"text","text":" (default) — AES-256-GCM. Fast, authenticated encryption using Apple’s CryptoKit. Recommended for new apps."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".legacy"}]},{"type":"text","text":" — RNCryptor v3 format. Use this for backward compatibility with Ensembles 2 encrypted data."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The backend auto-detects the encryption format when downloading, so a "},{"type":"codeVoice","code":".modern"},{"type":"text","text":" client can read "},{"type":"codeVoice","code":".legacy"},{"type":"text","text":" files and vice versa. The format setting only controls how "},{"type":"emphasis","inlineContent":[{"type":"text","text":"new"}]},{"type":"text","text":" files are encrypted."}]},{"type":"heading","text":"Setup","anchor":"Setup","level":3},{"inlineContent":[{"type":"text","text":"Wrap any cloud file system with encryption:"}],"type":"paragraph"},{"code":["import Ensembles","import EnsemblesEncrypted","import EnsemblesCloudKit","","\/\/ Wrap CloudKit with encryption","let cloudKitFS = CloudKitFileSystem(","    privateDatabaseForUbiquityContainerIdentifier: \"iCloud.com.yourcompany.yourapp\",","    schemaVersion: .v2",")","let encryptedFS = EncryptedCloudFileSystem(","    cloudFileSystem: cloudKitFS,","    password: \"user-supplied-password\"",")","","let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MainStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: encryptedFS!",")","try await ensemble?.attachPersistentStore()"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"For more control over the vault, use the "},{"type":"codeVoice","code":"VaultInfo"},{"type":"text","text":" initializer:"}],"type":"paragraph"},{"code":["let encryptedFS = EncryptedCloudFileSystem(","    cloudFileSystem: innerFS,","    vaultInfo: vaultInfo,","    encryptionFormat: .modern",")"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"When to Use Encryption","anchor":"When-to-Use-Encryption","level":3},{"inlineContent":[{"type":"text","text":"Ensembles sync data is stored as opaque binary files, so even without encryption the raw data is not human-readable. However, it could be deserialized by someone with access to your cloud storage."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For "},{"type":"strong","inlineContent":[{"type":"text","text":"CloudKit"}]},{"type":"text","text":", Apple encrypts "},{"type":"codeVoice","code":"CKAsset"},{"type":"text","text":" data at rest. With Advanced Data Protection (ADP) enabled, assets are end-to-end encrypted. Wrapping CloudKit with "},{"type":"codeVoice","code":"EncryptedCloudFileSystem"},{"type":"text","text":" adds a layer of protection that doesn’t depend on the user enabling ADP."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For "},{"type":"strong","inlineContent":[{"type":"text","text":"third-party backends"}]},{"type":"text","text":" (Google Drive, OneDrive, WebDAV, etc.), the storage provider can see the raw files. Wrapping with "},{"type":"codeVoice","code":"EncryptedCloudFileSystem"},{"type":"text","text":" ensures data is encrypted before it leaves the device, regardless of what the provider does."}],"type":"paragraph"},{"type":"heading","text":"How It Works","anchor":"How-It-Works","level":3},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Vault directory"}]},{"type":"text","text":" — All encrypted files are stored inside a vault directory in the cloud, derived from the password. Different passwords create different vaults, so the same cloud account can host multiple independent encrypted sync stores."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Upload"}]},{"type":"text","text":" — When Ensembles uploads a file, the wrapper encrypts it to a local temporary file, uploads the encrypted version with a "},{"code":".cdecrypt","type":"codeVoice"},{"type":"text","text":" extension, then removes the temporary file."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Download"}]},{"type":"text","text":" — When Ensembles downloads a file, the wrapper downloads the encrypted "},{"code":".cdecrypt","type":"codeVoice"},{"type":"text","text":" file, auto-detects the format (modern or legacy), decrypts it to a local temporary file, and returns the decrypted content."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Backward compatibility"}]},{"type":"text","text":" — The "},{"code":".legacy","type":"codeVoice"},{"type":"text","text":" format uses RNCryptor v3, the same encryption format used by Ensembles 2’s "},{"code":"CDEEncryptedCloudFileSystem","type":"codeVoice"},{"type":"text","text":". Apps migrating from E2 to E3 can read existing encrypted cloud data without re-encrypting."}]}]}]},{"type":"heading","text":"Wrapping Other Backends","anchor":"Wrapping-Other-Backends","level":3},{"inlineContent":[{"type":"text","text":"The wrapper works with any "},{"type":"codeVoice","code":"CloudFileSystem"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["\/\/ Wrap Google Drive","let encryptedGDrive = EncryptedCloudFileSystem(","    cloudFileSystem: GoogleDriveCloudFileSystem(authenticator: gdAuthenticator),","    password: password",")","","\/\/ Wrap WebDAV","let encryptedWebDAV = EncryptedCloudFileSystem(","    cloudFileSystem: WebDAVCloudFileSystem(baseURL: webdavURL, username: user, password: pass),","    password: encryptionPassword",")"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"Dependencies","anchor":"Dependencies","level":3},{"inlineContent":[{"type":"text","text":"This module has "},{"type":"strong","inlineContent":[{"type":"text","text":"no external dependencies"}]},{"type":"text","text":" beyond Foundation, CryptoKit, and the core "},{"type":"codeVoice","code":"Ensembles"},{"type":"text","text":" framework."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/EncryptionError":{"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"Errors that can occur during encryption or decryption."}],"type":"topic","identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptionError","url":"\/documentation\/ensemblesencrypted\/encryptionerror","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"text":"EncryptionError","kind":"identifier"}],"title":"EncryptionError","navigatorTitle":[{"text":"EncryptionError","kind":"identifier"}]},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted":{"kind":"symbol","role":"collection","abstract":[{"type":"text","text":"An encryption wrapper for any Ensembles cloud backend."}],"url":"\/documentation\/ensemblesencrypted","identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted","type":"topic","title":"EnsemblesEncrypted"},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/EncryptedCloudFileSystem":{"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"A cloud file system wrapper that encrypts files before uploading"},{"type":"text","text":" "},{"text":"and decrypts them after downloading.","type":"text"}],"url":"\/documentation\/ensemblesencrypted\/encryptedcloudfilesystem","identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptedCloudFileSystem","type":"topic","fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"text":"EncryptedCloudFileSystem","kind":"identifier"}],"title":"EncryptedCloudFileSystem","navigatorTitle":[{"text":"EncryptedCloudFileSystem","kind":"identifier"}]},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/VaultInfo":{"identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/VaultInfo","navigatorTitle":[{"text":"VaultInfo","kind":"identifier"}],"type":"topic","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"kind":"identifier","text":"VaultInfo"}],"abstract":[{"text":"Represents a vault in an encrypted cloud file system.","type":"text"}],"title":"VaultInfo","url":"\/documentation\/ensemblesencrypted\/vaultinfo"},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/EncryptionFormat":{"type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"EncryptionFormat"}],"url":"\/documentation\/ensemblesencrypted\/encryptionformat","role":"symbol","abstract":[{"text":"The encryption format to use when encrypting data.","type":"text"}],"kind":"symbol","title":"EncryptionFormat","identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptionFormat","navigatorTitle":[{"kind":"identifier","text":"EncryptionFormat"}]},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/FileEncryptor":{"url":"\/documentation\/ensemblesencrypted\/fileencryptor","identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/FileEncryptor","title":"FileEncryptor","abstract":[{"text":"Unified encryption\/decryption interface with automatic format detection on decrypt.","type":"text"}],"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"FileEncryptor"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"FileEncryptor"}]}}}