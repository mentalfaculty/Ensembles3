{"topicSections":[{"title":"Cloud File System","identifiers":["doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptedCloudFileSystem"],"anchor":"Cloud-File-System"},{"title":"Structures","generated":true,"identifiers":["doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/VaultInfo"],"anchor":"Structures"},{"title":"Enumerations","generated":true,"identifiers":["doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptionError","doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptionFormat","doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/FileEncryptor"],"anchor":"Enumerations"}],"kind":"symbol","metadata":{"externalID":"EnsemblesEncrypted","symbolKind":"module","modules":[{"name":"EnsemblesEncrypted"}],"role":"collection","roleHeading":"Framework","title":"EnsemblesEncrypted"},"abstract":[{"text":"An encryption wrapper for any Ensembles cloud backend.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ensemblesencrypted"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"EnsemblesEncrypted provides ","type":"text"},{"isActive":true,"identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptedCloudFileSystem","type":"reference"},{"text":", a wrapper that encrypts files before uploading and decrypts after downloading. It can wrap any ","type":"text"},{"code":"CloudFileSystem","type":"codeVoice"},{"text":" implementation — CloudKit, Google Drive, WebDAV, or your own custom backend — to provide end-to-end encryption for sync data.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Encrypted files are stored in a password-derived vault directory with a ","type":"text"},{"code":".cdecrypt","type":"codeVoice"},{"text":" extension. This is backward compatible with the Ensembles 2 Objective-C ","type":"text"},{"code":"CDEEncryptedCloudFileSystem","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Encryption-Formats","level":3,"text":"Encryption Formats","type":"heading"},{"inlineContent":[{"text":"Two encryption formats are available:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".modern"}],"type":"strong"},{"text":" (default) — AES-256-GCM. Fast, authenticated encryption using Apple’s CryptoKit. Recommended for new apps.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".legacy"}],"type":"strong"},{"text":" — RNCryptor v3 format. Use this for backward compatibility with Ensembles 2 encrypted data.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"The backend auto-detects the encryption format when downloading, so a ","type":"text"},{"code":".modern","type":"codeVoice"},{"text":" client can read ","type":"text"},{"code":".legacy","type":"codeVoice"},{"text":" files and vice versa. The format setting only controls how ","type":"text"},{"inlineContent":[{"text":"new","type":"text"}],"type":"emphasis"},{"text":" files are encrypted.","type":"text"}],"type":"paragraph"},{"anchor":"Setup","level":3,"text":"Setup","type":"heading"},{"inlineContent":[{"text":"Wrap any cloud file system with encryption:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import Ensembles","import EnsemblesEncrypted","import EnsemblesCloudKit","","\/\/ Wrap CloudKit with encryption","let cloudKitFS = CloudKitFileSystem(","    privateDatabaseForUbiquityContainerIdentifier: \"iCloud.com.yourcompany.yourapp\",","    schemaVersion: .v2",")","let encryptedFS = EncryptedCloudFileSystem(","    cloudFileSystem: cloudKitFS,","    password: \"user-supplied-password\"",")","","let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MainStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: encryptedFS!",")","try await ensemble?.attachPersistentStore()"],"type":"codeListing"},{"inlineContent":[{"text":"For more control over the vault, use the ","type":"text"},{"code":"VaultInfo","type":"codeVoice"},{"text":" initializer:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let encryptedFS = EncryptedCloudFileSystem(","    cloudFileSystem: innerFS,","    vaultInfo: vaultInfo,","    encryptionFormat: .modern",")"],"type":"codeListing"},{"anchor":"When-to-Use-Encryption","level":3,"text":"When to Use Encryption","type":"heading"},{"inlineContent":[{"text":"Ensembles sync data is stored as opaque binary files, so even without encryption the raw data is not human-readable. However, it could be deserialized by someone with access to your cloud storage.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For ","type":"text"},{"inlineContent":[{"text":"CloudKit","type":"text"}],"type":"strong"},{"text":", Apple encrypts ","type":"text"},{"code":"CKAsset","type":"codeVoice"},{"text":" data at rest. With Advanced Data Protection (ADP) enabled, assets are end-to-end encrypted. Wrapping CloudKit with ","type":"text"},{"code":"EncryptedCloudFileSystem","type":"codeVoice"},{"text":" adds a layer of protection that doesn’t depend on the user enabling ADP.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For ","type":"text"},{"inlineContent":[{"text":"third-party backends","type":"text"}],"type":"strong"},{"text":" (Google Drive, OneDrive, WebDAV, etc.), the storage provider can see the raw files. Wrapping with ","type":"text"},{"code":"EncryptedCloudFileSystem","type":"codeVoice"},{"text":" ensures data is encrypted before it leaves the device, regardless of what the provider does.","type":"text"}],"type":"paragraph"},{"anchor":"How-It-Works","level":3,"text":"How It Works","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Vault directory"}],"type":"strong"},{"text":" — All encrypted files are stored inside a vault directory in the cloud, derived from the password. Different passwords create different vaults, so the same cloud account can host multiple independent encrypted sync stores.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Upload"}],"type":"strong"},{"text":" — When Ensembles uploads a file, the wrapper encrypts it to a local temporary file, uploads the encrypted version with a ","type":"text"},{"code":".cdecrypt","type":"codeVoice"},{"text":" extension, then removes the temporary file.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Download"}],"type":"strong"},{"text":" — When Ensembles downloads a file, the wrapper downloads the encrypted ","type":"text"},{"code":".cdecrypt","type":"codeVoice"},{"text":" file, auto-detects the format (modern or legacy), decrypts it to a local temporary file, and returns the decrypted content.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Backward compatibility"}],"type":"strong"},{"text":" — The ","type":"text"},{"code":".legacy","type":"codeVoice"},{"text":" format uses RNCryptor v3, the same encryption format used by Ensembles 2’s ","type":"text"},{"code":"CDEEncryptedCloudFileSystem","type":"codeVoice"},{"text":". Apps migrating from E2 to E3 can read existing encrypted cloud data without re-encrypting.","type":"text"}]}]}],"type":"orderedList"},{"anchor":"Wrapping-Other-Backends","level":3,"text":"Wrapping Other Backends","type":"heading"},{"inlineContent":[{"text":"The wrapper works with any ","type":"text"},{"code":"CloudFileSystem","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Wrap Google Drive","let encryptedGDrive = EncryptedCloudFileSystem(","    cloudFileSystem: GoogleDriveCloudFileSystem(authenticator: gdAuthenticator),","    password: password",")","","\/\/ Wrap WebDAV","let encryptedWebDAV = EncryptedCloudFileSystem(","    cloudFileSystem: WebDAVCloudFileSystem(baseURL: webdavURL, username: user, password: pass),","    password: encryptionPassword",")"],"type":"codeListing"},{"anchor":"Dependencies","level":3,"text":"Dependencies","type":"heading"},{"inlineContent":[{"text":"This module has ","type":"text"},{"inlineContent":[{"text":"no external dependencies","type":"text"}],"type":"strong"},{"text":" beyond Foundation, CryptoKit, and the core ","type":"text"},{"code":"Ensembles","type":"codeVoice"},{"text":" framework.","type":"text"}],"type":"paragraph"}]}],"identifier":{"url":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted","interfaceLanguage":"swift"},"hierarchy":{"paths":[[]]},"sections":[],"references":{"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/FileEncryptor":{"url":"\/documentation\/ensemblesencrypted\/fileencryptor","identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/FileEncryptor","title":"FileEncryptor","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FileEncryptor","kind":"identifier"}],"abstract":[{"type":"text","text":"Unified encryption\/decryption interface with automatic format detection on decrypt."}],"type":"topic","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"FileEncryptor","kind":"identifier"}]},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted":{"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"An encryption wrapper for any Ensembles cloud backend."}],"identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted","title":"EnsemblesEncrypted","role":"collection","url":"\/documentation\/ensemblesencrypted"},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/EncryptedCloudFileSystem":{"title":"EncryptedCloudFileSystem","abstract":[{"type":"text","text":"A cloud file system wrapper that encrypts files before uploading"},{"text":" ","type":"text"},{"type":"text","text":"and decrypts them after downloading."}],"kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptedCloudFileSystem","fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"kind":"identifier","text":"EncryptedCloudFileSystem"}],"navigatorTitle":[{"text":"EncryptedCloudFileSystem","kind":"identifier"}],"url":"\/documentation\/ensemblesencrypted\/encryptedcloudfilesystem"},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/EncryptionFormat":{"title":"EncryptionFormat","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"EncryptionFormat"}],"abstract":[{"text":"The encryption format to use when encrypting data.","type":"text"}],"role":"symbol","kind":"symbol","type":"topic","url":"\/documentation\/ensemblesencrypted\/encryptionformat","identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptionFormat","navigatorTitle":[{"kind":"identifier","text":"EncryptionFormat"}]},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/VaultInfo":{"title":"VaultInfo","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"VaultInfo"}],"abstract":[{"type":"text","text":"Represents a vault in an encrypted cloud file system."}],"role":"symbol","kind":"symbol","type":"topic","url":"\/documentation\/ensemblesencrypted\/vaultinfo","identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/VaultInfo","navigatorTitle":[{"kind":"identifier","text":"VaultInfo"}]},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/EncryptionError":{"title":"EncryptionError","type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"EncryptionError"}],"identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptionError","role":"symbol","kind":"symbol","abstract":[{"text":"Errors that can occur during encryption or decryption.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"EncryptionError"}],"url":"\/documentation\/ensemblesencrypted\/encryptionerror"}}}