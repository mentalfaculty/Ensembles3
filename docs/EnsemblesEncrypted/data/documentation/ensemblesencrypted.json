{"abstract":[{"type":"text","text":"An encryption wrapper for any Ensembles cloud backend."}],"topicSections":[{"title":"Cloud File System","identifiers":["doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptedCloudFileSystem"],"anchor":"Cloud-File-System"},{"title":"Structures","identifiers":["doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/VaultInfo"],"anchor":"Structures","generated":true},{"title":"Enumerations","identifiers":["doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptionError","doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptionFormat","doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/FileEncryptor"],"anchor":"Enumerations","generated":true}],"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"roleHeading":"Framework","modules":[{"name":"EnsemblesEncrypted"}],"role":"collection","title":"EnsemblesEncrypted","externalID":"EnsemblesEncrypted","symbolKind":"module"},"hierarchy":{"paths":[[]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ensemblesencrypted"]}],"kind":"symbol","sections":[],"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"EnsemblesEncrypted provides ","type":"text"},{"identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptedCloudFileSystem","isActive":true,"type":"reference"},{"text":", a wrapper that encrypts files before uploading and decrypts after downloading. It can wrap any ","type":"text"},{"code":"CloudFileSystem","type":"codeVoice"},{"text":" implementation — CloudKit, Google Drive, WebDAV, or your own custom backend — to provide end-to-end encryption for sync data.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Encrypted files are stored in a password-derived vault directory with a "},{"code":".cdecrypt","type":"codeVoice"},{"type":"text","text":" extension. This is backward compatible with the Ensembles 2 Objective-C "},{"code":"CDEEncryptedCloudFileSystem","type":"codeVoice"},{"type":"text","text":"."}]},{"text":"Encryption Formats","type":"heading","anchor":"Encryption-Formats","level":3},{"type":"paragraph","inlineContent":[{"text":"Two encryption formats are available:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"code":".modern","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" (default) — AES-256-GCM. Fast, authenticated encryption using Apple’s CryptoKit. Recommended for new apps."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".legacy"}]},{"type":"text","text":" — RNCryptor v3 format. Use this for backward compatibility with Ensembles 2 encrypted data."}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"The backend auto-detects the encryption format when downloading, so a ","type":"text"},{"type":"codeVoice","code":".modern"},{"text":" client can read ","type":"text"},{"type":"codeVoice","code":".legacy"},{"text":" files and vice versa. The format setting only controls how ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"new","type":"text"}]},{"text":" files are encrypted.","type":"text"}],"type":"paragraph"},{"anchor":"Setup","type":"heading","text":"Setup","level":3},{"inlineContent":[{"text":"Wrap any cloud file system with encryption:","type":"text"}],"type":"paragraph"},{"code":["import Ensembles","import EnsemblesEncrypted","import EnsemblesCloudKit","","\/\/ Wrap CloudKit with encryption","let cloudKitFS = CloudKitFileSystem(","    privateDatabaseForUbiquityContainerIdentifier: \"iCloud.com.yourcompany.yourapp\",","    schemaVersion: .v2",")","let encryptedFS = EncryptedCloudFileSystem(","    cloudFileSystem: cloudKitFS,","    password: \"user-supplied-password\"",")","","let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MainStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: encryptedFS!",")","try await ensemble?.attachPersistentStore()"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"For more control over the vault, use the "},{"type":"codeVoice","code":"VaultInfo"},{"type":"text","text":" initializer:"}],"type":"paragraph"},{"code":["let encryptedFS = EncryptedCloudFileSystem(","    cloudFileSystem: innerFS,","    vaultInfo: vaultInfo,","    encryptionFormat: .modern",")"],"type":"codeListing","syntax":"swift"},{"anchor":"When-to-Use-Encryption","type":"heading","text":"When to Use Encryption","level":3},{"inlineContent":[{"type":"text","text":"Ensembles sync data is stored as opaque binary files, so even without encryption the raw data is not human-readable. However, it could be deserialized by someone with access to your cloud storage."}],"type":"paragraph"},{"inlineContent":[{"text":"For ","type":"text"},{"type":"strong","inlineContent":[{"text":"CloudKit","type":"text"}]},{"text":", Apple encrypts ","type":"text"},{"type":"codeVoice","code":"CKAsset"},{"text":" data at rest. With Advanced Data Protection (ADP) enabled, assets are end-to-end encrypted. Wrapping CloudKit with ","type":"text"},{"type":"codeVoice","code":"EncryptedCloudFileSystem"},{"text":" adds a layer of protection that doesn’t depend on the user enabling ADP.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For "},{"type":"strong","inlineContent":[{"type":"text","text":"third-party backends"}]},{"type":"text","text":" (Google Drive, OneDrive, WebDAV, etc.), the storage provider can see the raw files. Wrapping with "},{"code":"EncryptedCloudFileSystem","type":"codeVoice"},{"text":" ensures data is encrypted before it leaves the device, regardless of what the provider does.","type":"text"}]},{"type":"heading","anchor":"How-It-Works","text":"How It Works","level":3},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Vault directory"}]},{"type":"text","text":" — All encrypted files are stored inside a vault directory in the cloud, derived from the password. Different passwords create different vaults, so the same cloud account can host multiple independent encrypted sync stores."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Upload","type":"text"}]},{"text":" — When Ensembles uploads a file, the wrapper encrypts it to a local temporary file, uploads the encrypted version with a ","type":"text"},{"code":".cdecrypt","type":"codeVoice"},{"text":" extension, then removes the temporary file.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Download"}]},{"type":"text","text":" — When Ensembles downloads a file, the wrapper downloads the encrypted "},{"type":"codeVoice","code":".cdecrypt"},{"type":"text","text":" file, auto-detects the format (modern or legacy), decrypts it to a local temporary file, and returns the decrypted content."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Backward compatibility"}]},{"type":"text","text":" — The "},{"code":".legacy","type":"codeVoice"},{"type":"text","text":" format uses RNCryptor v3, the same encryption format used by Ensembles 2’s "},{"code":"CDEEncryptedCloudFileSystem","type":"codeVoice"},{"type":"text","text":". Apps migrating from E2 to E3 can read existing encrypted cloud data without re-encrypting."}]}]}]},{"type":"heading","anchor":"Wrapping-Other-Backends","text":"Wrapping Other Backends","level":3},{"type":"paragraph","inlineContent":[{"text":"The wrapper works with any ","type":"text"},{"type":"codeVoice","code":"CloudFileSystem"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Wrap Google Drive","let encryptedGDrive = EncryptedCloudFileSystem(","    cloudFileSystem: GoogleDriveCloudFileSystem(authenticator: gdAuthenticator),","    password: password",")","","\/\/ Wrap WebDAV","let encryptedWebDAV = EncryptedCloudFileSystem(","    cloudFileSystem: WebDAVCloudFileSystem(baseURL: webdavURL, username: user, password: pass),","    password: encryptionPassword",")"]},{"type":"heading","level":3,"anchor":"Dependencies","text":"Dependencies"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This module has "},{"inlineContent":[{"type":"text","text":"no external dependencies"}],"type":"strong"},{"type":"text","text":" beyond Foundation, CryptoKit, and the core "},{"code":"Ensembles","type":"codeVoice"},{"type":"text","text":" framework."}]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted"},"references":{"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/VaultInfo":{"abstract":[{"type":"text","text":"Represents a vault in an encrypted cloud file system."}],"url":"\/documentation\/ensemblesencrypted\/vaultinfo","identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/VaultInfo","navigatorTitle":[{"kind":"identifier","text":"VaultInfo"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"VaultInfo","kind":"identifier"}],"kind":"symbol","title":"VaultInfo","type":"topic"},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/EncryptionFormat":{"abstract":[{"type":"text","text":"The encryption format to use when encrypting data."}],"role":"symbol","title":"EncryptionFormat","type":"topic","kind":"symbol","identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptionFormat","navigatorTitle":[{"text":"EncryptionFormat","kind":"identifier"}],"url":"\/documentation\/ensemblesencrypted\/encryptionformat","fragments":[{"text":"enum","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"EncryptionFormat"}]},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/FileEncryptor":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FileEncryptor","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"FileEncryptor"}],"title":"FileEncryptor","abstract":[{"text":"Unified encryption\/decryption interface with automatic format detection on decrypt.","type":"text"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/FileEncryptor","role":"symbol","url":"\/documentation\/ensemblesencrypted\/fileencryptor"},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/EncryptionError":{"kind":"symbol","type":"topic","url":"\/documentation\/ensemblesencrypted\/encryptionerror","abstract":[{"text":"Errors that can occur during encryption or decryption.","type":"text"}],"identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptionError","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"EncryptionError"}],"navigatorTitle":[{"kind":"identifier","text":"EncryptionError"}],"title":"EncryptionError"},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/EncryptedCloudFileSystem":{"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"text":"EncryptedCloudFileSystem","kind":"identifier"}],"abstract":[{"type":"text","text":"A cloud file system wrapper that encrypts files before uploading"},{"type":"text","text":" "},{"type":"text","text":"and decrypts them after downloading."}],"navigatorTitle":[{"text":"EncryptedCloudFileSystem","kind":"identifier"}],"type":"topic","role":"symbol","kind":"symbol","url":"\/documentation\/ensemblesencrypted\/encryptedcloudfilesystem","identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptedCloudFileSystem","title":"EncryptedCloudFileSystem"},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted":{"title":"EnsemblesEncrypted","role":"collection","type":"topic","url":"\/documentation\/ensemblesencrypted","abstract":[{"text":"An encryption wrapper for any Ensembles cloud backend.","type":"text"}],"identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted","kind":"symbol"}}}