{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ensemblesencrypted"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted"},"abstract":[{"type":"text","text":"An encryption wrapper for any Ensembles cloud backend."}],"topicSections":[{"title":"Cloud File System","anchor":"Cloud-File-System","identifiers":["doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptedCloudFileSystem"]},{"generated":true,"title":"Structures","anchor":"Structures","identifiers":["doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/VaultInfo"]},{"generated":true,"title":"Enumerations","anchor":"Enumerations","identifiers":["doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptionError","doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptionFormat","doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/FileEncryptor"]}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"text":"EnsemblesEncrypted provides ","type":"text"},{"isActive":true,"identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptedCloudFileSystem","type":"reference"},{"text":", a wrapper that encrypts files before uploading and decrypts after downloading. It can wrap any ","type":"text"},{"code":"CloudFileSystem","type":"codeVoice"},{"text":" implementation — CloudKit, Google Drive, WebDAV, or your own custom backend — to provide end-to-end encryption for sync data.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Encrypted files are stored in a password-derived vault directory with a ","type":"text"},{"code":".cdecrypt","type":"codeVoice"},{"text":" extension. This is backward compatible with the Ensembles 2 Objective-C ","type":"text"},{"code":"CDEEncryptedCloudFileSystem","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Encryption Formats","anchor":"Encryption-Formats","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"Two encryption formats are available:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":".modern","type":"codeVoice"}]},{"text":" (default) — AES-256-GCM. Fast, authenticated encryption using Apple’s CryptoKit. Recommended for new apps.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".legacy","type":"codeVoice"}],"type":"strong"},{"text":" — RNCryptor v3 format. Use this for backward compatibility with Ensembles 2 encrypted data.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"The backend auto-detects the encryption format when downloading, so a "},{"type":"codeVoice","code":".modern"},{"type":"text","text":" client can read "},{"type":"codeVoice","code":".legacy"},{"type":"text","text":" files and vice versa. The format setting only controls how "},{"type":"emphasis","inlineContent":[{"type":"text","text":"new"}]},{"type":"text","text":" files are encrypted."}],"type":"paragraph"},{"anchor":"Setup","type":"heading","text":"Setup","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Wrap any cloud file system with encryption:"}]},{"syntax":"swift","code":["import Ensembles","import EnsemblesEncrypted","import EnsemblesCloudKit","","\/\/ Wrap CloudKit with encryption","let cloudKitFS = CloudKitFileSystem(","    privateDatabaseForUbiquityContainerIdentifier: \"iCloud.com.yourcompany.yourapp\",","    schemaVersion: .v2",")","let encryptedFS = EncryptedCloudFileSystem(","    cloudFileSystem: cloudKitFS,","    password: \"user-supplied-password\"",")","","let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MainStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: encryptedFS!",")","try await ensemble?.attachPersistentStore()"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"For more control over the vault, use the "},{"type":"codeVoice","code":"VaultInfo"},{"type":"text","text":" initializer:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let encryptedFS = EncryptedCloudFileSystem(","    cloudFileSystem: innerFS,","    vaultInfo: vaultInfo,","    encryptionFormat: .modern",")"]},{"text":"When to Use Encryption","anchor":"When-to-Use-Encryption","type":"heading","level":3},{"inlineContent":[{"text":"Ensembles sync data is stored as opaque binary files, so even without encryption the raw data is not human-readable. However, it could be deserialized by someone with access to your cloud storage.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For "},{"inlineContent":[{"type":"text","text":"CloudKit"}],"type":"strong"},{"text":", Apple encrypts ","type":"text"},{"code":"CKAsset","type":"codeVoice"},{"type":"text","text":" data at rest. With Advanced Data Protection (ADP) enabled, assets are end-to-end encrypted. Wrapping CloudKit with "},{"type":"codeVoice","code":"EncryptedCloudFileSystem"},{"type":"text","text":" adds a layer of protection that doesn’t depend on the user enabling ADP."}],"type":"paragraph"},{"inlineContent":[{"text":"For ","type":"text"},{"type":"strong","inlineContent":[{"text":"third-party backends","type":"text"}]},{"type":"text","text":" (Google Drive, OneDrive, WebDAV, etc.), the storage provider can see the raw files. Wrapping with "},{"code":"EncryptedCloudFileSystem","type":"codeVoice"},{"text":" ensures data is encrypted before it leaves the device, regardless of what the provider does.","type":"text"}],"type":"paragraph"},{"level":3,"text":"How It Works","type":"heading","anchor":"How-It-Works"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Vault directory"}]},{"type":"text","text":" — All encrypted files are stored inside a vault directory in the cloud, derived from the password. Different passwords create different vaults, so the same cloud account can host multiple independent encrypted sync stores."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Upload"}]},{"type":"text","text":" — When Ensembles uploads a file, the wrapper encrypts it to a local temporary file, uploads the encrypted version with a "},{"code":".cdecrypt","type":"codeVoice"},{"type":"text","text":" extension, then removes the temporary file."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Download","type":"text"}],"type":"strong"},{"type":"text","text":" — When Ensembles downloads a file, the wrapper downloads the encrypted "},{"code":".cdecrypt","type":"codeVoice"},{"type":"text","text":" file, auto-detects the format (modern or legacy), decrypts it to a local temporary file, and returns the decrypted content."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Backward compatibility","type":"text"}]},{"type":"text","text":" — The "},{"type":"codeVoice","code":".legacy"},{"type":"text","text":" format uses RNCryptor v3, the same encryption format used by Ensembles 2’s "},{"type":"codeVoice","code":"CDEEncryptedCloudFileSystem"},{"type":"text","text":". Apps migrating from E2 to E3 can read existing encrypted cloud data without re-encrypting."}],"type":"paragraph"}]}],"type":"orderedList"},{"level":3,"text":"Wrapping Other Backends","type":"heading","anchor":"Wrapping-Other-Backends"},{"inlineContent":[{"text":"The wrapper works with any ","type":"text"},{"code":"CloudFileSystem","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Wrap Google Drive","let encryptedGDrive = EncryptedCloudFileSystem(","    cloudFileSystem: GoogleDriveCloudFileSystem(authenticator: gdAuthenticator),","    password: password",")","","\/\/ Wrap WebDAV","let encryptedWebDAV = EncryptedCloudFileSystem(","    cloudFileSystem: WebDAVCloudFileSystem(baseURL: webdavURL, username: user, password: pass),","    password: encryptionPassword",")"],"type":"codeListing"},{"text":"Dependencies","anchor":"Dependencies","level":3,"type":"heading"},{"inlineContent":[{"text":"This module has ","type":"text"},{"inlineContent":[{"text":"no external dependencies","type":"text"}],"type":"strong"},{"text":" beyond Foundation, CryptoKit, and the core ","type":"text"},{"code":"Ensembles","type":"codeVoice"},{"text":" framework.","type":"text"}],"type":"paragraph"}]}],"hierarchy":{"paths":[[]]},"kind":"symbol","metadata":{"role":"collection","modules":[{"name":"EnsemblesEncrypted"}],"title":"EnsemblesEncrypted","externalID":"EnsemblesEncrypted","symbolKind":"module","roleHeading":"Framework"},"references":{"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/VaultInfo":{"navigatorTitle":[{"kind":"identifier","text":"VaultInfo"}],"identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/VaultInfo","title":"VaultInfo","url":"\/documentation\/ensemblesencrypted\/vaultinfo","abstract":[{"text":"Represents a vault in an encrypted cloud file system.","type":"text"}],"kind":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"VaultInfo"}],"role":"symbol"},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/EncryptedCloudFileSystem":{"navigatorTitle":[{"text":"EncryptedCloudFileSystem","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"A cloud file system wrapper that encrypts files before uploading","type":"text"},{"text":" ","type":"text"},{"text":"and decrypts them after downloading.","type":"text"}],"role":"symbol","title":"EncryptedCloudFileSystem","type":"topic","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"EncryptedCloudFileSystem"}],"identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptedCloudFileSystem","url":"\/documentation\/ensemblesencrypted\/encryptedcloudfilesystem"},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/FileEncryptor":{"navigatorTitle":[{"kind":"identifier","text":"FileEncryptor"}],"identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/FileEncryptor","title":"FileEncryptor","url":"\/documentation\/ensemblesencrypted\/fileencryptor","kind":"symbol","abstract":[{"type":"text","text":"Unified encryption\/decryption interface with automatic format detection on decrypt."}],"type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"kind":"text","text":" "},{"text":"FileEncryptor","kind":"identifier"}],"role":"symbol"},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/EncryptionError":{"navigatorTitle":[{"text":"EncryptionError","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"text","text":"Errors that can occur during encryption or decryption."}],"role":"symbol","title":"EncryptionError","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"EncryptionError"}],"identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptionError","url":"\/documentation\/ensemblesencrypted\/encryptionerror"},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/EncryptionFormat":{"identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptionFormat","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EncryptionFormat","kind":"identifier"}],"kind":"symbol","role":"symbol","url":"\/documentation\/ensemblesencrypted\/encryptionformat","title":"EncryptionFormat","abstract":[{"text":"The encryption format to use when encrypting data.","type":"text"}],"navigatorTitle":[{"text":"EncryptionFormat","kind":"identifier"}]},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted":{"kind":"symbol","abstract":[{"text":"An encryption wrapper for any Ensembles cloud backend.","type":"text"}],"role":"collection","title":"EnsemblesEncrypted","type":"topic","identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted","url":"\/documentation\/ensemblesencrypted"}}}