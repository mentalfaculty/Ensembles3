{"primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"EnsemblesEncrypted provides ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptedCloudFileSystem"},{"text":", a wrapper that encrypts files before uploading and decrypts after downloading. It can wrap any ","type":"text"},{"type":"codeVoice","code":"CloudFileSystem"},{"type":"text","text":" implementation — CloudKit, Google Drive, WebDAV, or your own custom backend — to provide end-to-end encryption for sync data."}]},{"inlineContent":[{"type":"text","text":"Encrypted files are stored in a password-derived vault directory with a "},{"type":"codeVoice","code":".cdecrypt"},{"type":"text","text":" extension. This is backward compatible with the Ensembles 2 Objective-C "},{"type":"codeVoice","code":"CDEEncryptedCloudFileSystem"},{"text":".","type":"text"}],"type":"paragraph"},{"level":3,"type":"heading","anchor":"Encryption-Formats","text":"Encryption Formats"},{"type":"paragraph","inlineContent":[{"text":"Two encryption formats are available:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":".modern","type":"codeVoice"}]},{"text":" (default) — AES-256-GCM. Fast, authenticated encryption using Apple’s CryptoKit. Recommended for new apps.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".legacy"}],"type":"strong"},{"text":" — RNCryptor v3 format. Use this for backward compatibility with Ensembles 2 encrypted data.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The backend auto-detects the encryption format when downloading, so a "},{"type":"codeVoice","code":".modern"},{"type":"text","text":" client can read "},{"code":".legacy","type":"codeVoice"},{"type":"text","text":" files and vice versa. The format setting only controls how "},{"type":"emphasis","inlineContent":[{"text":"new","type":"text"}]},{"type":"text","text":" files are encrypted."}]},{"type":"heading","level":3,"text":"Setup","anchor":"Setup"},{"inlineContent":[{"type":"text","text":"Wrap any cloud file system with encryption:"}],"type":"paragraph"},{"type":"codeListing","code":["import Ensembles","import EnsemblesEncrypted","import EnsemblesCloudKit","","\/\/ Wrap CloudKit with encryption","let cloudKitFS = CloudKitFileSystem(","    privateDatabaseForUbiquityContainerIdentifier: \"iCloud.com.yourcompany.yourapp\",","    schemaVersion: .v2",")","let encryptedFS = EncryptedCloudFileSystem(","    cloudFileSystem: cloudKitFS,","    password: \"user-supplied-password\"",")","","let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MainStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: encryptedFS!",")","try await ensemble?.attachPersistentStore()"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"For more control over the vault, use the "},{"type":"codeVoice","code":"VaultInfo"},{"type":"text","text":" initializer:"}],"type":"paragraph"},{"type":"codeListing","code":["let encryptedFS = EncryptedCloudFileSystem(","    cloudFileSystem: innerFS,","    vaultInfo: vaultInfo,","    encryptionFormat: .modern",")"],"syntax":"swift"},{"text":"When to Use Encryption","anchor":"When-to-Use-Encryption","type":"heading","level":3},{"inlineContent":[{"text":"Ensembles sync data is stored as opaque binary files, so even without encryption the raw data is not human-readable. However, it could be deserialized by someone with access to your cloud storage.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For "},{"inlineContent":[{"type":"text","text":"CloudKit"}],"type":"strong"},{"type":"text","text":", Apple encrypts "},{"code":"CKAsset","type":"codeVoice"},{"type":"text","text":" data at rest. With Advanced Data Protection (ADP) enabled, assets are end-to-end encrypted. Wrapping CloudKit with "},{"code":"EncryptedCloudFileSystem","type":"codeVoice"},{"type":"text","text":" adds a layer of protection that doesn’t depend on the user enabling ADP."}],"type":"paragraph"},{"inlineContent":[{"text":"For ","type":"text"},{"inlineContent":[{"text":"third-party backends","type":"text"}],"type":"strong"},{"type":"text","text":" (Google Drive, OneDrive, WebDAV, etc.), the storage provider can see the raw files. Wrapping with "},{"type":"codeVoice","code":"EncryptedCloudFileSystem"},{"type":"text","text":" ensures data is encrypted before it leaves the device, regardless of what the provider does."}],"type":"paragraph"},{"level":3,"anchor":"How-It-Works","type":"heading","text":"How It Works"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Vault directory","type":"text"}],"type":"strong"},{"text":" — All encrypted files are stored inside a vault directory in the cloud, derived from the password. Different passwords create different vaults, so the same cloud account can host multiple independent encrypted sync stores.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Upload","type":"text"}],"type":"strong"},{"type":"text","text":" — When Ensembles uploads a file, the wrapper encrypts it to a local temporary file, uploads the encrypted version with a "},{"type":"codeVoice","code":".cdecrypt"},{"text":" extension, then removes the temporary file.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Download"}]},{"type":"text","text":" — When Ensembles downloads a file, the wrapper downloads the encrypted "},{"type":"codeVoice","code":".cdecrypt"},{"type":"text","text":" file, auto-detects the format (modern or legacy), decrypts it to a local temporary file, and returns the decrypted content."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Backward compatibility"}],"type":"strong"},{"type":"text","text":" — The "},{"type":"codeVoice","code":".legacy"},{"type":"text","text":" format uses RNCryptor v3, the same encryption format used by Ensembles 2’s "},{"type":"codeVoice","code":"CDEEncryptedCloudFileSystem"},{"type":"text","text":". Apps migrating from E2 to E3 can read existing encrypted cloud data without re-encrypting."}]}]}]},{"text":"Wrapping Other Backends","anchor":"Wrapping-Other-Backends","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"The wrapper works with any "},{"type":"codeVoice","code":"CloudFileSystem"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["\/\/ Wrap Google Drive","let encryptedGDrive = EncryptedCloudFileSystem(","    cloudFileSystem: GoogleDriveCloudFileSystem(authenticator: gdAuthenticator),","    password: password",")","","\/\/ Wrap WebDAV","let encryptedWebDAV = EncryptedCloudFileSystem(","    cloudFileSystem: WebDAVCloudFileSystem(baseURL: webdavURL, username: user, password: pass),","    password: encryptionPassword",")"],"type":"codeListing","syntax":"swift"},{"type":"heading","anchor":"Dependencies","text":"Dependencies","level":3},{"inlineContent":[{"type":"text","text":"This module has "},{"type":"strong","inlineContent":[{"type":"text","text":"no external dependencies"}]},{"type":"text","text":" beyond Foundation, CryptoKit, and the core "},{"type":"codeVoice","code":"Ensembles"},{"type":"text","text":" framework."}],"type":"paragraph"}],"kind":"content"}],"metadata":{"role":"collection","title":"EnsemblesEncrypted","modules":[{"name":"EnsemblesEncrypted"}],"externalID":"EnsemblesEncrypted","symbolKind":"module","roleHeading":"Framework"},"topicSections":[{"title":"Cloud File System","identifiers":["doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptedCloudFileSystem"],"anchor":"Cloud-File-System"},{"anchor":"Structures","identifiers":["doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/VaultInfo"],"generated":true,"title":"Structures"},{"anchor":"Enumerations","generated":true,"title":"Enumerations","identifiers":["doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptionError","doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptionFormat","doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/FileEncryptor"]}],"variants":[{"paths":["\/documentation\/ensemblesencrypted"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[[]]},"sections":[],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted"},"abstract":[{"type":"text","text":"An encryption wrapper for any Ensembles cloud backend."}],"references":{"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted":{"url":"\/documentation\/ensemblesencrypted","kind":"symbol","identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted","abstract":[{"text":"An encryption wrapper for any Ensembles cloud backend.","type":"text"}],"role":"collection","type":"topic","title":"EnsemblesEncrypted"},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/EncryptionError":{"type":"topic","title":"EncryptionError","navigatorTitle":[{"text":"EncryptionError","kind":"identifier"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EncryptionError","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/ensemblesencrypted\/encryptionerror","role":"symbol","abstract":[{"type":"text","text":"Errors that can occur during encryption or decryption."}],"identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptionError"},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/EncryptionFormat":{"abstract":[{"type":"text","text":"The encryption format to use when encrypting data."}],"title":"EncryptionFormat","fragments":[{"text":"enum","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"EncryptionFormat"}],"type":"topic","identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptionFormat","url":"\/documentation\/ensemblesencrypted\/encryptionformat","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"EncryptionFormat"}],"kind":"symbol"},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/EncryptedCloudFileSystem":{"identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptedCloudFileSystem","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"EncryptedCloudFileSystem"}],"type":"topic","kind":"symbol","url":"\/documentation\/ensemblesencrypted\/encryptedcloudfilesystem","title":"EncryptedCloudFileSystem","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"EncryptedCloudFileSystem"}],"abstract":[{"type":"text","text":"A cloud file system wrapper that encrypts files before uploading"},{"type":"text","text":" "},{"type":"text","text":"and decrypts them after downloading."}]},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/VaultInfo":{"identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/VaultInfo","abstract":[{"type":"text","text":"Represents a vault in an encrypted cloud file system."}],"title":"VaultInfo","type":"topic","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"VaultInfo"}],"role":"symbol","url":"\/documentation\/ensemblesencrypted\/vaultinfo","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"VaultInfo"}]},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/FileEncryptor":{"url":"\/documentation\/ensemblesencrypted\/fileencryptor","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FileEncryptor","kind":"identifier"}],"navigatorTitle":[{"text":"FileEncryptor","kind":"identifier"}],"identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/FileEncryptor","abstract":[{"type":"text","text":"Unified encryption\/decryption interface with automatic format detection on decrypt."}],"title":"FileEncryptor","type":"topic","kind":"symbol","role":"symbol"}}}