{"sections":[],"topicSections":[{"anchor":"Cloud-File-System","title":"Cloud File System","identifiers":["doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptedCloudFileSystem"]},{"anchor":"Structures","title":"Structures","generated":true,"identifiers":["doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/VaultInfo"]},{"anchor":"Enumerations","title":"Enumerations","generated":true,"identifiers":["doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptionError","doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptionFormat","doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/FileEncryptor"]}],"kind":"symbol","abstract":[{"type":"text","text":"An encryption wrapper for any Ensembles cloud backend."}],"metadata":{"title":"EnsemblesEncrypted","modules":[{"name":"EnsemblesEncrypted"}],"role":"collection","externalID":"EnsemblesEncrypted","symbolKind":"module","roleHeading":"Framework"},"hierarchy":{"paths":[[]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ensemblesencrypted"]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"EnsemblesEncrypted provides "},{"type":"reference","identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptedCloudFileSystem","isActive":true},{"type":"text","text":", a wrapper that encrypts files before uploading and decrypts after downloading. It can wrap any "},{"code":"CloudFileSystem","type":"codeVoice"},{"type":"text","text":" implementation — CloudKit, Google Drive, WebDAV, or your own custom backend — to provide end-to-end encryption for sync data."}]},{"type":"paragraph","inlineContent":[{"text":"Encrypted files are stored in a password-derived vault directory with a ","type":"text"},{"code":".cdecrypt","type":"codeVoice"},{"text":" extension. This is backward compatible with the Ensembles 2 Objective-C ","type":"text"},{"code":"CDEEncryptedCloudFileSystem","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"heading","level":3,"text":"Encryption Formats","anchor":"Encryption-Formats"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Two encryption formats are available:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":".modern","type":"codeVoice"}]},{"type":"text","text":" (default) — AES-256-GCM. Fast, authenticated encryption using Apple’s CryptoKit. Recommended for new apps."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".legacy"}]},{"type":"text","text":" — RNCryptor v3 format. Use this for backward compatibility with Ensembles 2 encrypted data."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"The backend auto-detects the encryption format when downloading, so a ","type":"text"},{"type":"codeVoice","code":".modern"},{"text":" client can read ","type":"text"},{"code":".legacy","type":"codeVoice"},{"type":"text","text":" files and vice versa. The format setting only controls how "},{"inlineContent":[{"type":"text","text":"new"}],"type":"emphasis"},{"text":" files are encrypted.","type":"text"}]},{"level":3,"anchor":"Setup","type":"heading","text":"Setup"},{"inlineContent":[{"type":"text","text":"Wrap any cloud file system with encryption:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import Ensembles","import EnsemblesEncrypted","import EnsemblesCloudKit","","\/\/ Wrap CloudKit with encryption","let cloudKitFS = CloudKitFileSystem(","    privateDatabaseForUbiquityContainerIdentifier: \"iCloud.com.yourcompany.yourapp\",","    schemaVersion: .v2",")","let encryptedFS = EncryptedCloudFileSystem(","    cloudFileSystem: cloudKitFS,","    password: \"user-supplied-password\"",")","","let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MainStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: encryptedFS!",")","try await ensemble?.attachPersistentStore()"]},{"type":"paragraph","inlineContent":[{"text":"For more control over the vault, use the ","type":"text"},{"type":"codeVoice","code":"VaultInfo"},{"text":" initializer:","type":"text"}]},{"type":"codeListing","code":["let encryptedFS = EncryptedCloudFileSystem(","    cloudFileSystem: innerFS,","    vaultInfo: vaultInfo,","    encryptionFormat: .modern",")"],"syntax":"swift"},{"type":"heading","level":3,"anchor":"When-to-Use-Encryption","text":"When to Use Encryption"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Ensembles sync data is stored as opaque binary files, so even without encryption the raw data is not human-readable. However, it could be deserialized by someone with access to your cloud storage."}]},{"inlineContent":[{"type":"text","text":"For "},{"inlineContent":[{"type":"text","text":"CloudKit"}],"type":"strong"},{"text":", Apple encrypts ","type":"text"},{"type":"codeVoice","code":"CKAsset"},{"type":"text","text":" data at rest. With Advanced Data Protection (ADP) enabled, assets are end-to-end encrypted. Wrapping CloudKit with "},{"type":"codeVoice","code":"EncryptedCloudFileSystem"},{"type":"text","text":" adds a layer of protection that doesn’t depend on the user enabling ADP."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For "},{"type":"strong","inlineContent":[{"type":"text","text":"third-party backends"}]},{"text":" (Google Drive, OneDrive, WebDAV, etc.), the storage provider can see the raw files. Wrapping with ","type":"text"},{"type":"codeVoice","code":"EncryptedCloudFileSystem"},{"text":" ensures data is encrypted before it leaves the device, regardless of what the provider does.","type":"text"}],"type":"paragraph"},{"type":"heading","level":3,"anchor":"How-It-Works","text":"How It Works"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Vault directory"}],"type":"strong"},{"text":" — All encrypted files are stored inside a vault directory in the cloud, derived from the password. Different passwords create different vaults, so the same cloud account can host multiple independent encrypted sync stores.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Upload","type":"text"}]},{"text":" — When Ensembles uploads a file, the wrapper encrypts it to a local temporary file, uploads the encrypted version with a ","type":"text"},{"type":"codeVoice","code":".cdecrypt"},{"type":"text","text":" extension, then removes the temporary file."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Download"}],"type":"strong"},{"type":"text","text":" — When Ensembles downloads a file, the wrapper downloads the encrypted "},{"type":"codeVoice","code":".cdecrypt"},{"type":"text","text":" file, auto-detects the format (modern or legacy), decrypts it to a local temporary file, and returns the decrypted content."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Backward compatibility"}],"type":"strong"},{"type":"text","text":" — The "},{"type":"codeVoice","code":".legacy"},{"type":"text","text":" format uses RNCryptor v3, the same encryption format used by Ensembles 2’s "},{"type":"codeVoice","code":"CDEEncryptedCloudFileSystem"},{"type":"text","text":". Apps migrating from E2 to E3 can read existing encrypted cloud data without re-encrypting."}]}]}]},{"level":3,"type":"heading","text":"Wrapping Other Backends","anchor":"Wrapping-Other-Backends"},{"inlineContent":[{"text":"The wrapper works with any ","type":"text"},{"code":"CloudFileSystem","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Wrap Google Drive","let encryptedGDrive = EncryptedCloudFileSystem(","    cloudFileSystem: GoogleDriveCloudFileSystem(authenticator: gdAuthenticator),","    password: password",")","","\/\/ Wrap WebDAV","let encryptedWebDAV = EncryptedCloudFileSystem(","    cloudFileSystem: WebDAVCloudFileSystem(baseURL: webdavURL, username: user, password: pass),","    password: encryptionPassword",")"],"type":"codeListing"},{"type":"heading","level":3,"anchor":"Dependencies","text":"Dependencies"},{"inlineContent":[{"type":"text","text":"This module has "},{"type":"strong","inlineContent":[{"type":"text","text":"no external dependencies"}]},{"text":" beyond Foundation, CryptoKit, and the core ","type":"text"},{"type":"codeVoice","code":"Ensembles"},{"text":" framework.","type":"text"}],"type":"paragraph"}]}],"references":{"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/EncryptionFormat":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"EncryptionFormat"}],"role":"symbol","identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptionFormat","url":"\/documentation\/ensemblesencrypted\/encryptionformat","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"EncryptionFormat"}],"title":"EncryptionFormat","type":"topic","abstract":[{"type":"text","text":"The encryption format to use when encrypting data."}]},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted":{"kind":"symbol","type":"topic","url":"\/documentation\/ensemblesencrypted","identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted","title":"EnsemblesEncrypted","abstract":[{"text":"An encryption wrapper for any Ensembles cloud backend.","type":"text"}],"role":"collection"},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/VaultInfo":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"VaultInfo"}],"title":"VaultInfo","url":"\/documentation\/ensemblesencrypted\/vaultinfo","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"VaultInfo"}],"type":"topic","identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/VaultInfo","abstract":[{"text":"Represents a vault in an encrypted cloud file system.","type":"text"}],"role":"symbol"},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/EncryptionError":{"identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptionError","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"EncryptionError"}],"title":"EncryptionError","navigatorTitle":[{"text":"EncryptionError","kind":"identifier"}],"type":"topic","kind":"symbol","url":"\/documentation\/ensemblesencrypted\/encryptionerror","role":"symbol","abstract":[{"text":"Errors that can occur during encryption or decryption.","type":"text"}]},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/EncryptedCloudFileSystem":{"url":"\/documentation\/ensemblesencrypted\/encryptedcloudfilesystem","title":"EncryptedCloudFileSystem","identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptedCloudFileSystem","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"EncryptedCloudFileSystem"}],"abstract":[{"type":"text","text":"A cloud file system wrapper that encrypts files before uploading"},{"type":"text","text":" "},{"type":"text","text":"and decrypts them after downloading."}],"type":"topic","role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"EncryptedCloudFileSystem"}]},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/FileEncryptor":{"url":"\/documentation\/ensemblesencrypted\/fileencryptor","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FileEncryptor","kind":"identifier"}],"navigatorTitle":[{"text":"FileEncryptor","kind":"identifier"}],"identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/FileEncryptor","kind":"symbol","title":"FileEncryptor","type":"topic","role":"symbol","abstract":[{"type":"text","text":"Unified encryption\/decryption interface with automatic format detection on decrypt."}]}}}