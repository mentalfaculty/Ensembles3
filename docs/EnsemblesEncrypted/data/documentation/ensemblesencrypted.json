{"topicSections":[{"identifiers":["doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptedCloudFileSystem"],"title":"Cloud File System","anchor":"Cloud-File-System"},{"anchor":"Structures","identifiers":["doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/VaultInfo"],"generated":true,"title":"Structures"},{"anchor":"Enumerations","identifiers":["doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptionError","doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptionFormat","doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/FileEncryptor"],"generated":true,"title":"Enumerations"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"inlineContent":[{"text":"EnsemblesEncrypted provides ","type":"text"},{"type":"reference","identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptedCloudFileSystem","isActive":true},{"type":"text","text":", a wrapper that encrypts files before uploading and decrypts after downloading. It can wrap any "},{"code":"CloudFileSystem","type":"codeVoice"},{"type":"text","text":" implementation — CloudKit, Google Drive, WebDAV, or your own custom backend — to provide end-to-end encryption for sync data."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Encrypted files are stored in a password-derived vault directory with a "},{"code":".cdecrypt","type":"codeVoice"},{"type":"text","text":" extension. This is backward compatible with the Ensembles 2 Objective-C "},{"type":"codeVoice","code":"CDEEncryptedCloudFileSystem"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Encryption-Formats","type":"heading","text":"Encryption Formats","level":3},{"inlineContent":[{"type":"text","text":"Two encryption formats are available:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":".modern","type":"codeVoice"}]},{"type":"text","text":" (default) — AES-256-GCM. Fast, authenticated encryption using Apple’s CryptoKit. Recommended for new apps."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":".legacy","type":"codeVoice"}]},{"type":"text","text":" — RNCryptor v3 format. Use this for backward compatibility with Ensembles 2 encrypted data."}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"The backend auto-detects the encryption format when downloading, so a "},{"type":"codeVoice","code":".modern"},{"type":"text","text":" client can read "},{"code":".legacy","type":"codeVoice"},{"type":"text","text":" files and vice versa. The format setting only controls how "},{"inlineContent":[{"text":"new","type":"text"}],"type":"emphasis"},{"text":" files are encrypted.","type":"text"}],"type":"paragraph"},{"text":"Setup","level":3,"type":"heading","anchor":"Setup"},{"inlineContent":[{"type":"text","text":"Wrap any cloud file system with encryption:"}],"type":"paragraph"},{"type":"codeListing","code":["import Ensembles","import EnsemblesEncrypted","import EnsemblesCloudKit","","\/\/ Wrap CloudKit with encryption","let cloudKitFS = CloudKitFileSystem(","    privateDatabaseForUbiquityContainerIdentifier: \"iCloud.com.yourcompany.yourapp\",","    schemaVersion: .v2",")","let encryptedFS = EncryptedCloudFileSystem(","    cloudFileSystem: cloudKitFS,","    password: \"user-supplied-password\"",")","","let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MainStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: encryptedFS!",")","try await ensemble?.attachPersistentStore()"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For more control over the vault, use the "},{"code":"VaultInfo","type":"codeVoice"},{"type":"text","text":" initializer:"}]},{"syntax":"swift","type":"codeListing","code":["let encryptedFS = EncryptedCloudFileSystem(","    cloudFileSystem: innerFS,","    vaultInfo: vaultInfo,","    encryptionFormat: .modern",")"]},{"text":"When to Use Encryption","anchor":"When-to-Use-Encryption","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Ensembles sync data is stored as opaque binary files, so even without encryption the raw data is not human-readable. However, it could be deserialized by someone with access to your cloud storage."}]},{"inlineContent":[{"type":"text","text":"For "},{"inlineContent":[{"type":"text","text":"CloudKit"}],"type":"strong"},{"text":", Apple encrypts ","type":"text"},{"type":"codeVoice","code":"CKAsset"},{"type":"text","text":" data at rest. With Advanced Data Protection (ADP) enabled, assets are end-to-end encrypted. Wrapping CloudKit with "},{"code":"EncryptedCloudFileSystem","type":"codeVoice"},{"type":"text","text":" adds a layer of protection that doesn’t depend on the user enabling ADP."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For "},{"inlineContent":[{"type":"text","text":"third-party backends"}],"type":"strong"},{"text":" (Google Drive, OneDrive, WebDAV, etc.), the storage provider can see the raw files. Wrapping with ","type":"text"},{"code":"EncryptedCloudFileSystem","type":"codeVoice"},{"type":"text","text":" ensures data is encrypted before it leaves the device, regardless of what the provider does."}]},{"anchor":"How-It-Works","type":"heading","text":"How It Works","level":3},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Vault directory","type":"text"}],"type":"strong"},{"text":" — All encrypted files are stored inside a vault directory in the cloud, derived from the password. Different passwords create different vaults, so the same cloud account can host multiple independent encrypted sync stores.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Upload","type":"text"}],"type":"strong"},{"text":" — When Ensembles uploads a file, the wrapper encrypts it to a local temporary file, uploads the encrypted version with a ","type":"text"},{"code":".cdecrypt","type":"codeVoice"},{"text":" extension, then removes the temporary file.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Download","type":"text"}],"type":"strong"},{"text":" — When Ensembles downloads a file, the wrapper downloads the encrypted ","type":"text"},{"code":".cdecrypt","type":"codeVoice"},{"text":" file, auto-detects the format (modern or legacy), decrypts it to a local temporary file, and returns the decrypted content.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Backward compatibility"}],"type":"strong"},{"text":" — The ","type":"text"},{"code":".legacy","type":"codeVoice"},{"text":" format uses RNCryptor v3, the same encryption format used by Ensembles 2’s ","type":"text"},{"code":"CDEEncryptedCloudFileSystem","type":"codeVoice"},{"text":". Apps migrating from E2 to E3 can read existing encrypted cloud data without re-encrypting.","type":"text"}]}]}]},{"level":3,"anchor":"Wrapping-Other-Backends","text":"Wrapping Other Backends","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The wrapper works with any "},{"type":"codeVoice","code":"CloudFileSystem"},{"type":"text","text":":"}]},{"code":["\/\/ Wrap Google Drive","let encryptedGDrive = EncryptedCloudFileSystem(","    cloudFileSystem: GoogleDriveCloudFileSystem(authenticator: gdAuthenticator),","    password: password",")","","\/\/ Wrap WebDAV","let encryptedWebDAV = EncryptedCloudFileSystem(","    cloudFileSystem: WebDAVCloudFileSystem(baseURL: webdavURL, username: user, password: pass),","    password: encryptionPassword",")"],"type":"codeListing","syntax":"swift"},{"level":3,"anchor":"Dependencies","text":"Dependencies","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This module has "},{"type":"strong","inlineContent":[{"text":"no external dependencies","type":"text"}]},{"type":"text","text":" beyond Foundation, CryptoKit, and the core "},{"type":"codeVoice","code":"Ensembles"},{"type":"text","text":" framework."}]}],"kind":"content"}],"metadata":{"modules":[{"name":"EnsemblesEncrypted"}],"role":"collection","externalID":"EnsemblesEncrypted","roleHeading":"Framework","title":"EnsemblesEncrypted","symbolKind":"module"},"kind":"symbol","hierarchy":{"paths":[[]]},"abstract":[{"text":"An encryption wrapper for any Ensembles cloud backend.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted"},"sections":[],"variants":[{"paths":["\/documentation\/ensemblesencrypted"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/EncryptedCloudFileSystem":{"kind":"symbol","title":"EncryptedCloudFileSystem","identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptedCloudFileSystem","abstract":[{"type":"text","text":"A cloud file system wrapper that encrypts files before uploading"},{"type":"text","text":" "},{"type":"text","text":"and decrypts them after downloading."}],"role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"EncryptedCloudFileSystem"}],"url":"\/documentation\/ensemblesencrypted\/encryptedcloudfilesystem","type":"topic","navigatorTitle":[{"kind":"identifier","text":"EncryptedCloudFileSystem"}]},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/VaultInfo":{"abstract":[{"type":"text","text":"Represents a vault in an encrypted cloud file system."}],"title":"VaultInfo","url":"\/documentation\/ensemblesencrypted\/vaultinfo","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"VaultInfo","kind":"identifier"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"VaultInfo"}],"identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/VaultInfo"},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted":{"identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted","kind":"symbol","title":"EnsemblesEncrypted","abstract":[{"type":"text","text":"An encryption wrapper for any Ensembles cloud backend."}],"role":"collection","url":"\/documentation\/ensemblesencrypted","type":"topic"},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/FileEncryptor":{"abstract":[{"type":"text","text":"Unified encryption\/decryption interface with automatic format detection on decrypt."}],"title":"FileEncryptor","url":"\/documentation\/ensemblesencrypted\/fileencryptor","kind":"symbol","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FileEncryptor","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"FileEncryptor","kind":"identifier"}],"identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/FileEncryptor"},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/EncryptionFormat":{"url":"\/documentation\/ensemblesencrypted\/encryptionformat","abstract":[{"type":"text","text":"The encryption format to use when encrypting data."}],"identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptionFormat","kind":"symbol","role":"symbol","title":"EncryptionFormat","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"text":"EncryptionFormat","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"EncryptionFormat","kind":"identifier"}]},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/EncryptionError":{"kind":"symbol","identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptionError","abstract":[{"text":"Errors that can occur during encryption or decryption.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"EncryptionError"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"EncryptionError"}],"title":"EncryptionError","url":"\/documentation\/ensemblesencrypted\/encryptionerror","type":"topic","role":"symbol"}}}