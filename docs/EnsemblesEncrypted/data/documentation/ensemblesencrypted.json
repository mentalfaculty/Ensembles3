{"hierarchy":{"paths":[[]]},"topicSections":[{"identifiers":["doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptedCloudFileSystem"],"anchor":"Cloud-File-System","title":"Cloud File System"},{"identifiers":["doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/VaultInfo"],"anchor":"Structures","title":"Structures","generated":true},{"identifiers":["doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptionError","doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptionFormat","doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/FileEncryptor"],"anchor":"Enumerations","title":"Enumerations","generated":true}],"metadata":{"externalID":"EnsemblesEncrypted","role":"collection","symbolKind":"module","roleHeading":"Framework","modules":[{"name":"EnsemblesEncrypted"}],"title":"EnsemblesEncrypted"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"EnsemblesEncrypted provides ","type":"text"},{"identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptedCloudFileSystem","type":"reference","isActive":true},{"text":", a wrapper that encrypts files before uploading and decrypts after downloading. It can wrap any ","type":"text"},{"type":"codeVoice","code":"CloudFileSystem"},{"text":" implementation — CloudKit, Google Drive, WebDAV, or your own custom backend — to provide end-to-end encryption for sync data.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Encrypted files are stored in a password-derived vault directory with a ","type":"text"},{"type":"codeVoice","code":".cdecrypt"},{"text":" extension. This is backward compatible with the Ensembles 2 Objective-C ","type":"text"},{"type":"codeVoice","code":"CDEEncryptedCloudFileSystem"},{"text":".","type":"text"}]},{"type":"heading","anchor":"Encryption-Formats","level":3,"text":"Encryption Formats"},{"type":"paragraph","inlineContent":[{"text":"Two encryption formats are available:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".modern"}]},{"type":"text","text":" (default) — AES-256-GCM. Fast, authenticated encryption using Apple’s CryptoKit. Recommended for new apps."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".legacy"}]},{"type":"text","text":" — RNCryptor v3 format. Use this for backward compatibility with Ensembles 2 encrypted data."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"The backend auto-detects the encryption format when downloading, so a ","type":"text"},{"type":"codeVoice","code":".modern"},{"text":" client can read ","type":"text"},{"type":"codeVoice","code":".legacy"},{"text":" files and vice versa. The format setting only controls how ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"new","type":"text"}]},{"text":" files are encrypted.","type":"text"}]},{"type":"heading","anchor":"Setup","level":3,"text":"Setup"},{"type":"paragraph","inlineContent":[{"text":"Wrap any cloud file system with encryption:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import Ensembles","import EnsemblesEncrypted","import EnsemblesCloudKit","","\/\/ Wrap CloudKit with encryption","let cloudKitFS = CloudKitFileSystem(","    privateDatabaseForUbiquityContainerIdentifier: \"iCloud.com.yourcompany.yourapp\",","    schemaVersion: .v2",")","let encryptedFS = EncryptedCloudFileSystem(","    cloudFileSystem: cloudKitFS,","    password: \"user-supplied-password\"",")","","let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MainStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: encryptedFS!",")","try await ensemble?.attachPersistentStore()"]},{"type":"paragraph","inlineContent":[{"text":"For more control over the vault, use the ","type":"text"},{"type":"codeVoice","code":"VaultInfo"},{"text":" initializer:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let encryptedFS = EncryptedCloudFileSystem(","    cloudFileSystem: innerFS,","    vaultInfo: vaultInfo,","    encryptionFormat: .modern",")"]},{"type":"heading","anchor":"When-to-Use-Encryption","level":3,"text":"When to Use Encryption"},{"type":"paragraph","inlineContent":[{"text":"Ensembles sync data is stored as opaque binary files, so even without encryption the raw data is not human-readable. However, it could be deserialized by someone with access to your cloud storage.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For ","type":"text"},{"inlineContent":[{"type":"text","text":"CloudKit"}],"type":"strong"},{"text":", Apple encrypts ","type":"text"},{"type":"codeVoice","code":"CKAsset"},{"text":" data at rest. With Advanced Data Protection (ADP) enabled, assets are end-to-end encrypted. Wrapping CloudKit with ","type":"text"},{"type":"codeVoice","code":"EncryptedCloudFileSystem"},{"text":" adds a layer of protection that doesn’t depend on the user enabling ADP.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For "},{"inlineContent":[{"text":"third-party backends","type":"text"}],"type":"strong"},{"text":" (Google Drive, OneDrive, WebDAV, etc.), the storage provider can see the raw files. Wrapping with ","type":"text"},{"code":"EncryptedCloudFileSystem","type":"codeVoice"},{"text":" ensures data is encrypted before it leaves the device, regardless of what the provider does.","type":"text"}]},{"type":"heading","anchor":"How-It-Works","level":3,"text":"How It Works"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Vault directory"}],"type":"strong"},{"text":" — All encrypted files are stored inside a vault directory in the cloud, derived from the password. Different passwords create different vaults, so the same cloud account can host multiple independent encrypted sync stores.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Upload","type":"text"}],"type":"strong"},{"text":" — When Ensembles uploads a file, the wrapper encrypts it to a local temporary file, uploads the encrypted version with a ","type":"text"},{"type":"codeVoice","code":".cdecrypt"},{"text":" extension, then removes the temporary file.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Download","type":"text"}]},{"text":" — When Ensembles downloads a file, the wrapper downloads the encrypted ","type":"text"},{"type":"codeVoice","code":".cdecrypt"},{"text":" file, auto-detects the format (modern or legacy), decrypts it to a local temporary file, and returns the decrypted content.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Backward compatibility","type":"text"}],"type":"strong"},{"text":" — The ","type":"text"},{"type":"codeVoice","code":".legacy"},{"text":" format uses RNCryptor v3, the same encryption format used by Ensembles 2’s ","type":"text"},{"type":"codeVoice","code":"CDEEncryptedCloudFileSystem"},{"text":". Apps migrating from E2 to E3 can read existing encrypted cloud data without re-encrypting.","type":"text"}]}]}]},{"type":"heading","anchor":"Wrapping-Other-Backends","level":3,"text":"Wrapping Other Backends"},{"type":"paragraph","inlineContent":[{"text":"The wrapper works with any ","type":"text"},{"code":"CloudFileSystem","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Wrap Google Drive","let encryptedGDrive = EncryptedCloudFileSystem(","    cloudFileSystem: GoogleDriveCloudFileSystem(authenticator: gdAuthenticator),","    password: password",")","","\/\/ Wrap WebDAV","let encryptedWebDAV = EncryptedCloudFileSystem(","    cloudFileSystem: WebDAVCloudFileSystem(baseURL: webdavURL, username: user, password: pass),","    password: encryptionPassword",")"]},{"type":"heading","anchor":"Dependencies","level":3,"text":"Dependencies"},{"type":"paragraph","inlineContent":[{"text":"This module has ","type":"text"},{"inlineContent":[{"type":"text","text":"no external dependencies"}],"type":"strong"},{"text":" beyond Foundation, CryptoKit, and the core ","type":"text"},{"code":"Ensembles","type":"codeVoice"},{"text":" framework.","type":"text"}]}]}],"variants":[{"paths":["\/documentation\/ensemblesencrypted"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"An encryption wrapper for any Ensembles cloud backend.","type":"text"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted"},"sections":[],"kind":"symbol","references":{"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/EncryptionFormat":{"title":"EncryptionFormat","abstract":[{"type":"text","text":"The encryption format to use when encrypting data."}],"url":"\/documentation\/ensemblesencrypted\/encryptionformat","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"EncryptionFormat"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptionFormat","navigatorTitle":[{"kind":"identifier","text":"EncryptionFormat"}],"type":"topic"},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/EncryptedCloudFileSystem":{"role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"text":"EncryptedCloudFileSystem","kind":"identifier"}],"navigatorTitle":[{"text":"EncryptedCloudFileSystem","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/ensemblesencrypted\/encryptedcloudfilesystem","type":"topic","identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptedCloudFileSystem","abstract":[{"text":"A cloud file system wrapper that encrypts files before uploading","type":"text"},{"text":" ","type":"text"},{"text":"and decrypts them after downloading.","type":"text"}],"title":"EncryptedCloudFileSystem"},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/FileEncryptor":{"role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"text":"FileEncryptor","kind":"identifier"}],"navigatorTitle":[{"text":"FileEncryptor","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/ensemblesencrypted\/fileencryptor","type":"topic","title":"FileEncryptor","abstract":[{"text":"Unified encryption\/decryption interface with automatic format detection on decrypt.","type":"text"}],"identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/FileEncryptor"},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted":{"role":"collection","kind":"symbol","url":"\/documentation\/ensemblesencrypted","type":"topic","identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted","abstract":[{"text":"An encryption wrapper for any Ensembles cloud backend.","type":"text"}],"title":"EnsemblesEncrypted"},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/VaultInfo":{"role":"symbol","abstract":[{"text":"Represents a vault in an encrypted cloud file system.","type":"text"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"VaultInfo"}],"title":"VaultInfo","type":"topic","navigatorTitle":[{"text":"VaultInfo","kind":"identifier"}],"url":"\/documentation\/ensemblesencrypted\/vaultinfo","identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/VaultInfo"},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/EncryptionError":{"kind":"symbol","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EncryptionError","kind":"identifier"}],"navigatorTitle":[{"text":"EncryptionError","kind":"identifier"}],"identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptionError","role":"symbol","abstract":[{"text":"Errors that can occur during encryption or decryption.","type":"text"}],"title":"EncryptionError","url":"\/documentation\/ensemblesencrypted\/encryptionerror"}}}