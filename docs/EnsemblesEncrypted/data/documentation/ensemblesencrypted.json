{"sections":[],"topicSections":[{"anchor":"Cloud-File-System","identifiers":["doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptedCloudFileSystem"],"title":"Cloud File System"},{"identifiers":["doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/VaultInfo"],"generated":true,"title":"Structures","anchor":"Structures"},{"anchor":"Enumerations","identifiers":["doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptionError","doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptionFormat","doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/FileEncryptor"],"generated":true,"title":"Enumerations"}],"hierarchy":{"paths":[[]]},"kind":"symbol","primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"EnsemblesEncrypted provides "},{"identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptedCloudFileSystem","isActive":true,"type":"reference"},{"type":"text","text":", a wrapper that encrypts files before uploading and decrypts after downloading. It can wrap any "},{"type":"codeVoice","code":"CloudFileSystem"},{"type":"text","text":" implementation — CloudKit, Google Drive, WebDAV, or your own custom backend — to provide end-to-end encryption for sync data."}],"type":"paragraph"},{"inlineContent":[{"text":"Encrypted files are stored in a password-derived vault directory with a ","type":"text"},{"type":"codeVoice","code":".cdecrypt"},{"text":" extension. This is backward compatible with the Ensembles 2 Objective-C ","type":"text"},{"code":"CDEEncryptedCloudFileSystem","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Encryption-Formats","type":"heading","text":"Encryption Formats","level":3},{"type":"paragraph","inlineContent":[{"text":"Two encryption formats are available:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".modern"}]},{"type":"text","text":" (default) — AES-256-GCM. Fast, authenticated encryption using Apple’s CryptoKit. Recommended for new apps."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":".legacy","type":"codeVoice"}]},{"type":"text","text":" — RNCryptor v3 format. Use this for backward compatibility with Ensembles 2 encrypted data."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The backend auto-detects the encryption format when downloading, so a "},{"type":"codeVoice","code":".modern"},{"type":"text","text":" client can read "},{"type":"codeVoice","code":".legacy"},{"type":"text","text":" files and vice versa. The format setting only controls how "},{"type":"emphasis","inlineContent":[{"type":"text","text":"new"}]},{"type":"text","text":" files are encrypted."}]},{"text":"Setup","anchor":"Setup","level":3,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Wrap any cloud file system with encryption:"}]},{"syntax":"swift","code":["import Ensembles","import EnsemblesEncrypted","import EnsemblesCloudKit","","\/\/ Wrap CloudKit with encryption","let cloudKitFS = CloudKitFileSystem(","    privateDatabaseForUbiquityContainerIdentifier: \"iCloud.com.yourcompany.yourapp\",","    schemaVersion: .v2",")","let encryptedFS = EncryptedCloudFileSystem(","    cloudFileSystem: cloudKitFS,","    password: \"user-supplied-password\"",")","","let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MainStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: encryptedFS!",")","try await ensemble?.attachPersistentStore()"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"For more control over the vault, use the ","type":"text"},{"type":"codeVoice","code":"VaultInfo"},{"text":" initializer:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let encryptedFS = EncryptedCloudFileSystem(","    cloudFileSystem: innerFS,","    vaultInfo: vaultInfo,","    encryptionFormat: .modern",")"]},{"text":"When to Use Encryption","type":"heading","level":3,"anchor":"When-to-Use-Encryption"},{"type":"paragraph","inlineContent":[{"text":"Ensembles sync data is stored as opaque binary files, so even without encryption the raw data is not human-readable. However, it could be deserialized by someone with access to your cloud storage.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"CloudKit"}]},{"text":", Apple encrypts ","type":"text"},{"type":"codeVoice","code":"CKAsset"},{"text":" data at rest. With Advanced Data Protection (ADP) enabled, assets are end-to-end encrypted. Wrapping CloudKit with ","type":"text"},{"type":"codeVoice","code":"EncryptedCloudFileSystem"},{"text":" adds a layer of protection that doesn’t depend on the user enabling ADP.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For "},{"type":"strong","inlineContent":[{"type":"text","text":"third-party backends"}]},{"type":"text","text":" (Google Drive, OneDrive, WebDAV, etc.), the storage provider can see the raw files. Wrapping with "},{"type":"codeVoice","code":"EncryptedCloudFileSystem"},{"type":"text","text":" ensures data is encrypted before it leaves the device, regardless of what the provider does."}]},{"anchor":"How-It-Works","level":3,"text":"How It Works","type":"heading"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Vault directory"}],"type":"strong"},{"type":"text","text":" — All encrypted files are stored inside a vault directory in the cloud, derived from the password. Different passwords create different vaults, so the same cloud account can host multiple independent encrypted sync stores."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Upload"}],"type":"strong"},{"text":" — When Ensembles uploads a file, the wrapper encrypts it to a local temporary file, uploads the encrypted version with a ","type":"text"},{"type":"codeVoice","code":".cdecrypt"},{"text":" extension, then removes the temporary file.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Download","type":"text"}]},{"text":" — When Ensembles downloads a file, the wrapper downloads the encrypted ","type":"text"},{"code":".cdecrypt","type":"codeVoice"},{"text":" file, auto-detects the format (modern or legacy), decrypts it to a local temporary file, and returns the decrypted content.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Backward compatibility"}],"type":"strong"},{"type":"text","text":" — The "},{"type":"codeVoice","code":".legacy"},{"type":"text","text":" format uses RNCryptor v3, the same encryption format used by Ensembles 2’s "},{"type":"codeVoice","code":"CDEEncryptedCloudFileSystem"},{"type":"text","text":". Apps migrating from E2 to E3 can read existing encrypted cloud data without re-encrypting."}]}]}],"type":"orderedList"},{"level":3,"text":"Wrapping Other Backends","type":"heading","anchor":"Wrapping-Other-Backends"},{"inlineContent":[{"type":"text","text":"The wrapper works with any "},{"type":"codeVoice","code":"CloudFileSystem"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ Wrap Google Drive","let encryptedGDrive = EncryptedCloudFileSystem(","    cloudFileSystem: GoogleDriveCloudFileSystem(authenticator: gdAuthenticator),","    password: password",")","","\/\/ Wrap WebDAV","let encryptedWebDAV = EncryptedCloudFileSystem(","    cloudFileSystem: WebDAVCloudFileSystem(baseURL: webdavURL, username: user, password: pass),","    password: encryptionPassword",")"]},{"type":"heading","level":3,"text":"Dependencies","anchor":"Dependencies"},{"inlineContent":[{"text":"This module has ","type":"text"},{"inlineContent":[{"text":"no external dependencies","type":"text"}],"type":"strong"},{"text":" beyond Foundation, CryptoKit, and the core ","type":"text"},{"code":"Ensembles","type":"codeVoice"},{"text":" framework.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"metadata":{"title":"EnsemblesEncrypted","role":"collection","modules":[{"name":"EnsemblesEncrypted"}],"roleHeading":"Framework","symbolKind":"module","externalID":"EnsemblesEncrypted"},"abstract":[{"text":"An encryption wrapper for any Ensembles cloud backend.","type":"text"}],"variants":[{"paths":["\/documentation\/ensemblesencrypted"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted"},"references":{"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/EncryptionFormat":{"url":"\/documentation\/ensemblesencrypted\/encryptionformat","abstract":[{"type":"text","text":"The encryption format to use when encrypting data."}],"identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptionFormat","navigatorTitle":[{"text":"EncryptionFormat","kind":"identifier"}],"type":"topic","title":"EncryptionFormat","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EncryptionFormat","kind":"identifier"}],"role":"symbol","kind":"symbol"},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/EncryptionError":{"navigatorTitle":[{"text":"EncryptionError","kind":"identifier"}],"abstract":[{"text":"Errors that can occur during encryption or decryption.","type":"text"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"EncryptionError"}],"url":"\/documentation\/ensemblesencrypted\/encryptionerror","title":"EncryptionError","identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptionError","kind":"symbol","type":"topic","role":"symbol"},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/FileEncryptor":{"role":"symbol","title":"FileEncryptor","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"FileEncryptor"}],"url":"\/documentation\/ensemblesencrypted\/fileencryptor","type":"topic","abstract":[{"text":"Unified encryption\/decryption interface with automatic format detection on decrypt.","type":"text"}],"identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/FileEncryptor","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"FileEncryptor"}]},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/VaultInfo":{"url":"\/documentation\/ensemblesencrypted\/vaultinfo","abstract":[{"type":"text","text":"Represents a vault in an encrypted cloud file system."}],"identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/VaultInfo","navigatorTitle":[{"text":"VaultInfo","kind":"identifier"}],"type":"topic","title":"VaultInfo","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"VaultInfo"}],"role":"symbol","kind":"symbol"},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted":{"url":"\/documentation\/ensemblesencrypted","kind":"symbol","identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted","title":"EnsemblesEncrypted","type":"topic","role":"collection","abstract":[{"type":"text","text":"An encryption wrapper for any Ensembles cloud backend."}]},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/EncryptedCloudFileSystem":{"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"EncryptedCloudFileSystem"}],"type":"topic","title":"EncryptedCloudFileSystem","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EncryptedCloudFileSystem","kind":"identifier"}],"identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptedCloudFileSystem","url":"\/documentation\/ensemblesencrypted\/encryptedcloudfilesystem","abstract":[{"text":"A cloud file system wrapper that encrypts files before uploading","type":"text"},{"type":"text","text":" "},{"type":"text","text":"and decrypts them after downloading."}],"role":"symbol"}}}