{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ensemblesencrypted"]}],"kind":"symbol","sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[[]]},"abstract":[{"type":"text","text":"An encryption wrapper for any Ensembles cloud backend."}],"topicSections":[{"title":"Cloud File System","identifiers":["doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptedCloudFileSystem"],"anchor":"Cloud-File-System"},{"title":"Structures","identifiers":["doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/VaultInfo"],"generated":true,"anchor":"Structures"},{"title":"Enumerations","generated":true,"anchor":"Enumerations","identifiers":["doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptionError","doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptionFormat","doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/FileEncryptor"]}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"inlineContent":[{"type":"text","text":"EnsemblesEncrypted provides "},{"isActive":true,"type":"reference","identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptedCloudFileSystem"},{"text":", a wrapper that encrypts files before uploading and decrypts after downloading. It can wrap any ","type":"text"},{"type":"codeVoice","code":"CloudFileSystem"},{"type":"text","text":" implementation — CloudKit, Google Drive, WebDAV, or your own custom backend — to provide end-to-end encryption for sync data."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Encrypted files are stored in a password-derived vault directory with a "},{"code":".cdecrypt","type":"codeVoice"},{"text":" extension. This is backward compatible with the Ensembles 2 Objective-C ","type":"text"},{"type":"codeVoice","code":"CDEEncryptedCloudFileSystem"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Encryption-Formats","level":3,"type":"heading","text":"Encryption Formats"},{"inlineContent":[{"type":"text","text":"Two encryption formats are available:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":".modern","type":"codeVoice"}]},{"text":" (default) — AES-256-GCM. Fast, authenticated encryption using Apple’s CryptoKit. Recommended for new apps.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":".legacy","type":"codeVoice"}]},{"text":" — RNCryptor v3 format. Use this for backward compatibility with Ensembles 2 encrypted data.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"The backend auto-detects the encryption format when downloading, so a ","type":"text"},{"code":".modern","type":"codeVoice"},{"text":" client can read ","type":"text"},{"code":".legacy","type":"codeVoice"},{"type":"text","text":" files and vice versa. The format setting only controls how "},{"type":"emphasis","inlineContent":[{"type":"text","text":"new"}]},{"type":"text","text":" files are encrypted."}]},{"level":3,"type":"heading","text":"Setup","anchor":"Setup"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Wrap any cloud file system with encryption:"}]},{"code":["import Ensembles","import EnsemblesEncrypted","import EnsemblesCloudKit","","\/\/ Wrap CloudKit with encryption","let cloudKitFS = CloudKitFileSystem(","    privateDatabaseForUbiquityContainerIdentifier: \"iCloud.com.yourcompany.yourapp\",","    schemaVersion: .v2",")","let encryptedFS = EncryptedCloudFileSystem(","    cloudFileSystem: cloudKitFS,","    password: \"user-supplied-password\"",")","","let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MainStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: encryptedFS!",")","try await ensemble?.attachPersistentStore()"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"For more control over the vault, use the "},{"code":"VaultInfo","type":"codeVoice"},{"type":"text","text":" initializer:"}],"type":"paragraph"},{"code":["let encryptedFS = EncryptedCloudFileSystem(","    cloudFileSystem: innerFS,","    vaultInfo: vaultInfo,","    encryptionFormat: .modern",")"],"syntax":"swift","type":"codeListing"},{"text":"When to Use Encryption","anchor":"When-to-Use-Encryption","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Ensembles sync data is stored as opaque binary files, so even without encryption the raw data is not human-readable. However, it could be deserialized by someone with access to your cloud storage."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For "},{"inlineContent":[{"type":"text","text":"CloudKit"}],"type":"strong"},{"type":"text","text":", Apple encrypts "},{"code":"CKAsset","type":"codeVoice"},{"text":" data at rest. With Advanced Data Protection (ADP) enabled, assets are end-to-end encrypted. Wrapping CloudKit with ","type":"text"},{"code":"EncryptedCloudFileSystem","type":"codeVoice"},{"text":" adds a layer of protection that doesn’t depend on the user enabling ADP.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"For ","type":"text"},{"inlineContent":[{"text":"third-party backends","type":"text"}],"type":"strong"},{"text":" (Google Drive, OneDrive, WebDAV, etc.), the storage provider can see the raw files. Wrapping with ","type":"text"},{"code":"EncryptedCloudFileSystem","type":"codeVoice"},{"type":"text","text":" ensures data is encrypted before it leaves the device, regardless of what the provider does."}]},{"type":"heading","anchor":"How-It-Works","text":"How It Works","level":3},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Vault directory"}]},{"type":"text","text":" — All encrypted files are stored inside a vault directory in the cloud, derived from the password. Different passwords create different vaults, so the same cloud account can host multiple independent encrypted sync stores."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Upload"}],"type":"strong"},{"type":"text","text":" — When Ensembles uploads a file, the wrapper encrypts it to a local temporary file, uploads the encrypted version with a "},{"code":".cdecrypt","type":"codeVoice"},{"text":" extension, then removes the temporary file.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Download"}]},{"type":"text","text":" — When Ensembles downloads a file, the wrapper downloads the encrypted "},{"type":"codeVoice","code":".cdecrypt"},{"type":"text","text":" file, auto-detects the format (modern or legacy), decrypts it to a local temporary file, and returns the decrypted content."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Backward compatibility"}],"type":"strong"},{"text":" — The ","type":"text"},{"code":".legacy","type":"codeVoice"},{"text":" format uses RNCryptor v3, the same encryption format used by Ensembles 2’s ","type":"text"},{"code":"CDEEncryptedCloudFileSystem","type":"codeVoice"},{"type":"text","text":". Apps migrating from E2 to E3 can read existing encrypted cloud data without re-encrypting."}]}]}]},{"level":3,"text":"Wrapping Other Backends","type":"heading","anchor":"Wrapping-Other-Backends"},{"type":"paragraph","inlineContent":[{"text":"The wrapper works with any ","type":"text"},{"type":"codeVoice","code":"CloudFileSystem"},{"text":":","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Wrap Google Drive","let encryptedGDrive = EncryptedCloudFileSystem(","    cloudFileSystem: GoogleDriveCloudFileSystem(authenticator: gdAuthenticator),","    password: password",")","","\/\/ Wrap WebDAV","let encryptedWebDAV = EncryptedCloudFileSystem(","    cloudFileSystem: WebDAVCloudFileSystem(baseURL: webdavURL, username: user, password: pass),","    password: encryptionPassword",")"]},{"level":3,"text":"Dependencies","type":"heading","anchor":"Dependencies"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This module has "},{"type":"strong","inlineContent":[{"type":"text","text":"no external dependencies"}]},{"type":"text","text":" beyond Foundation, CryptoKit, and the core "},{"code":"Ensembles","type":"codeVoice"},{"type":"text","text":" framework."}]}]}],"metadata":{"title":"EnsemblesEncrypted","externalID":"EnsemblesEncrypted","roleHeading":"Framework","symbolKind":"module","modules":[{"name":"EnsemblesEncrypted"}],"role":"collection"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted"},"references":{"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/FileEncryptor":{"url":"\/documentation\/ensemblesencrypted\/fileencryptor","role":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"FileEncryptor"}],"kind":"symbol","identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/FileEncryptor","abstract":[{"text":"Unified encryption\/decryption interface with automatic format detection on decrypt.","type":"text"}],"title":"FileEncryptor","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"FileEncryptor"}]},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/VaultInfo":{"url":"\/documentation\/ensemblesencrypted\/vaultinfo","role":"symbol","type":"topic","navigatorTitle":[{"text":"VaultInfo","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/VaultInfo","abstract":[{"text":"Represents a vault in an encrypted cloud file system.","type":"text"}],"title":"VaultInfo","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"VaultInfo"}]},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/EncryptionError":{"url":"\/documentation\/ensemblesencrypted\/encryptionerror","role":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"EncryptionError"}],"kind":"symbol","identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptionError","abstract":[{"type":"text","text":"Errors that can occur during encryption or decryption."}],"title":"EncryptionError","fragments":[{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"text":"EncryptionError","kind":"identifier"}]},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/EncryptedCloudFileSystem":{"kind":"symbol","identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptedCloudFileSystem","abstract":[{"text":"A cloud file system wrapper that encrypts files before uploading","type":"text"},{"text":" ","type":"text"},{"text":"and decrypts them after downloading.","type":"text"}],"role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"EncryptedCloudFileSystem"}],"navigatorTitle":[{"kind":"identifier","text":"EncryptedCloudFileSystem"}],"url":"\/documentation\/ensemblesencrypted\/encryptedcloudfilesystem","title":"EncryptedCloudFileSystem"},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted":{"title":"EnsemblesEncrypted","type":"topic","url":"\/documentation\/ensemblesencrypted","abstract":[{"text":"An encryption wrapper for any Ensembles cloud backend.","type":"text"}],"identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted","kind":"symbol","role":"collection"},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/EncryptionFormat":{"title":"EncryptionFormat","type":"topic","url":"\/documentation\/ensemblesencrypted\/encryptionformat","abstract":[{"type":"text","text":"The encryption format to use when encrypting data."}],"fragments":[{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"text":"EncryptionFormat","kind":"identifier"}],"identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptionFormat","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"EncryptionFormat","kind":"identifier"}]}}}