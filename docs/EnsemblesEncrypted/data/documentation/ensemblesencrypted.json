{"topicSections":[{"identifiers":["doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptedCloudFileSystem"],"anchor":"Cloud-File-System","title":"Cloud File System"},{"generated":true,"identifiers":["doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/VaultInfo"],"anchor":"Structures","title":"Structures"},{"generated":true,"identifiers":["doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptionError","doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptionFormat","doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/FileEncryptor"],"anchor":"Enumerations","title":"Enumerations"}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ensemblesencrypted"]}],"metadata":{"symbolKind":"module","modules":[{"name":"EnsemblesEncrypted"}],"externalID":"EnsemblesEncrypted","roleHeading":"Framework","title":"EnsemblesEncrypted","role":"collection"},"hierarchy":{"paths":[[]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted"},"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"EnsemblesEncrypted provides "},{"identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptedCloudFileSystem","isActive":true,"type":"reference"},{"type":"text","text":", a wrapper that encrypts files before uploading and decrypts after downloading. It can wrap any "},{"code":"CloudFileSystem","type":"codeVoice"},{"type":"text","text":" implementation — CloudKit, Google Drive, WebDAV, or your own custom backend — to provide end-to-end encryption for sync data."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Encrypted files are stored in a password-derived vault directory with a "},{"code":".cdecrypt","type":"codeVoice"},{"type":"text","text":" extension. This is backward compatible with the Ensembles 2 Objective-C "},{"code":"CDEEncryptedCloudFileSystem","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"level":3,"text":"Encryption Formats","anchor":"Encryption-Formats","type":"heading"},{"inlineContent":[{"type":"text","text":"Two encryption formats are available:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".modern"}],"type":"strong"},{"text":" (default) — AES-256-GCM. Fast, authenticated encryption using Apple’s CryptoKit. Recommended for new apps.","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":".legacy","type":"codeVoice"}],"type":"strong"},{"text":" — RNCryptor v3 format. Use this for backward compatibility with Ensembles 2 encrypted data.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"The backend auto-detects the encryption format when downloading, so a ","type":"text"},{"code":".modern","type":"codeVoice"},{"text":" client can read ","type":"text"},{"code":".legacy","type":"codeVoice"},{"text":" files and vice versa. The format setting only controls how ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"new"}]},{"text":" files are encrypted.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Setup","anchor":"Setup","type":"heading"},{"inlineContent":[{"text":"Wrap any cloud file system with encryption:","type":"text"}],"type":"paragraph"},{"code":["import Ensembles","import EnsemblesEncrypted","import EnsemblesCloudKit","","\/\/ Wrap CloudKit with encryption","let cloudKitFS = CloudKitFileSystem(","    privateDatabaseForUbiquityContainerIdentifier: \"iCloud.com.yourcompany.yourapp\",","    schemaVersion: .v2",")","let encryptedFS = EncryptedCloudFileSystem(","    cloudFileSystem: cloudKitFS,","    password: \"user-supplied-password\"",")","","let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MainStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: encryptedFS!",")","try await ensemble?.attachPersistentStore()"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"For more control over the vault, use the ","type":"text"},{"code":"VaultInfo","type":"codeVoice"},{"text":" initializer:","type":"text"}],"type":"paragraph"},{"code":["let encryptedFS = EncryptedCloudFileSystem(","    cloudFileSystem: innerFS,","    vaultInfo: vaultInfo,","    encryptionFormat: .modern",")"],"syntax":"swift","type":"codeListing"},{"level":3,"text":"When to Use Encryption","anchor":"When-to-Use-Encryption","type":"heading"},{"inlineContent":[{"text":"Ensembles sync data is stored as opaque binary files, so even without encryption the raw data is not human-readable. However, it could be deserialized by someone with access to your cloud storage.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For ","type":"text"},{"inlineContent":[{"type":"text","text":"CloudKit"}],"type":"strong"},{"text":", Apple encrypts ","type":"text"},{"code":"CKAsset","type":"codeVoice"},{"text":" data at rest. With Advanced Data Protection (ADP) enabled, assets are end-to-end encrypted. Wrapping CloudKit with ","type":"text"},{"type":"codeVoice","code":"EncryptedCloudFileSystem"},{"text":" adds a layer of protection that doesn’t depend on the user enabling ADP.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For "},{"inlineContent":[{"text":"third-party backends","type":"text"}],"type":"strong"},{"type":"text","text":" (Google Drive, OneDrive, WebDAV, etc.), the storage provider can see the raw files. Wrapping with "},{"code":"EncryptedCloudFileSystem","type":"codeVoice"},{"text":" ensures data is encrypted before it leaves the device, regardless of what the provider does.","type":"text"}],"type":"paragraph"},{"level":3,"type":"heading","text":"How It Works","anchor":"How-It-Works"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Vault directory"}]},{"type":"text","text":" — All encrypted files are stored inside a vault directory in the cloud, derived from the password. Different passwords create different vaults, so the same cloud account can host multiple independent encrypted sync stores."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Upload"}]},{"type":"text","text":" — When Ensembles uploads a file, the wrapper encrypts it to a local temporary file, uploads the encrypted version with a "},{"code":".cdecrypt","type":"codeVoice"},{"type":"text","text":" extension, then removes the temporary file."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Download"}]},{"type":"text","text":" — When Ensembles downloads a file, the wrapper downloads the encrypted "},{"code":".cdecrypt","type":"codeVoice"},{"type":"text","text":" file, auto-detects the format (modern or legacy), decrypts it to a local temporary file, and returns the decrypted content."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Backward compatibility"}]},{"type":"text","text":" — The "},{"code":".legacy","type":"codeVoice"},{"type":"text","text":" format uses RNCryptor v3, the same encryption format used by Ensembles 2’s "},{"code":"CDEEncryptedCloudFileSystem","type":"codeVoice"},{"type":"text","text":". Apps migrating from E2 to E3 can read existing encrypted cloud data without re-encrypting."}]}]}],"type":"orderedList"},{"level":3,"text":"Wrapping Other Backends","anchor":"Wrapping-Other-Backends","type":"heading"},{"inlineContent":[{"text":"The wrapper works with any ","type":"text"},{"code":"CloudFileSystem","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Wrap Google Drive","let encryptedGDrive = EncryptedCloudFileSystem(","    cloudFileSystem: GoogleDriveCloudFileSystem(authenticator: gdAuthenticator),","    password: password",")","","\/\/ Wrap WebDAV","let encryptedWebDAV = EncryptedCloudFileSystem(","    cloudFileSystem: WebDAVCloudFileSystem(baseURL: webdavURL, username: user, password: pass),","    password: encryptionPassword",")"],"type":"codeListing"},{"level":3,"text":"Dependencies","anchor":"Dependencies","type":"heading"},{"inlineContent":[{"text":"This module has ","type":"text"},{"inlineContent":[{"type":"text","text":"no external dependencies"}],"type":"strong"},{"text":" beyond Foundation, CryptoKit, and the core ","type":"text"},{"code":"Ensembles","type":"codeVoice"},{"text":" framework.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"text":"An encryption wrapper for any Ensembles cloud backend.","type":"text"}],"references":{"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/FileEncryptor":{"url":"\/documentation\/ensemblesencrypted\/fileencryptor","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FileEncryptor","kind":"identifier"}],"title":"FileEncryptor","kind":"symbol","abstract":[{"text":"Unified encryption\/decryption interface with automatic format detection on decrypt.","type":"text"}],"role":"symbol","identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/FileEncryptor","navigatorTitle":[{"text":"FileEncryptor","kind":"identifier"}]},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/VaultInfo":{"url":"\/documentation\/ensemblesencrypted\/vaultinfo","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"VaultInfo","kind":"identifier"}],"title":"VaultInfo","kind":"symbol","abstract":[{"text":"Represents a vault in an encrypted cloud file system.","type":"text"}],"role":"symbol","identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/VaultInfo","navigatorTitle":[{"text":"VaultInfo","kind":"identifier"}]},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/EncryptionError":{"type":"topic","identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptionError","title":"EncryptionError","role":"symbol","url":"\/documentation\/ensemblesencrypted\/encryptionerror","fragments":[{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"text":"EncryptionError","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"Errors that can occur during encryption or decryption.","type":"text"}],"navigatorTitle":[{"text":"EncryptionError","kind":"identifier"}]},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/EncryptionFormat":{"url":"\/documentation\/ensemblesencrypted\/encryptionformat","role":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"EncryptionFormat"}],"identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptionFormat","title":"EncryptionFormat","kind":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"EncryptionFormat"}],"abstract":[{"text":"The encryption format to use when encrypting data.","type":"text"}]},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/EncryptedCloudFileSystem":{"url":"\/documentation\/ensemblesencrypted\/encryptedcloudfilesystem","abstract":[{"text":"A cloud file system wrapper that encrypts files before uploading","type":"text"},{"text":" ","type":"text"},{"text":"and decrypts them after downloading.","type":"text"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"EncryptedCloudFileSystem"}],"role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"text":"EncryptedCloudFileSystem","kind":"identifier"}],"title":"EncryptedCloudFileSystem","identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptedCloudFileSystem"},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted":{"role":"collection","url":"\/documentation\/ensemblesencrypted","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"An encryption wrapper for any Ensembles cloud backend."}],"title":"EnsemblesEncrypted","identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted"}}}