{"metadata":{"role":"collection","title":"EnsemblesEncrypted","modules":[{"name":"EnsemblesEncrypted"}],"roleHeading":"Framework","externalID":"EnsemblesEncrypted","symbolKind":"module"},"kind":"symbol","hierarchy":{"paths":[[]]},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"EnsemblesEncrypted provides "},{"identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptedCloudFileSystem","type":"reference","isActive":true},{"type":"text","text":", a wrapper that encrypts files before uploading and decrypts after downloading. It can wrap any "},{"code":"CloudFileSystem","type":"codeVoice"},{"type":"text","text":" implementation — CloudKit, Google Drive, WebDAV, or your own custom backend — to provide end-to-end encryption for sync data."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Encrypted files are stored in a password-derived vault directory with a ","type":"text"},{"code":".cdecrypt","type":"codeVoice"},{"text":" extension. This is backward compatible with the Ensembles 2 Objective-C ","type":"text"},{"code":"CDEEncryptedCloudFileSystem","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"heading","text":"Encryption Formats","level":3,"anchor":"Encryption-Formats"},{"type":"paragraph","inlineContent":[{"text":"Two encryption formats are available:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":".modern","type":"codeVoice"}]},{"type":"text","text":" (default) — AES-256-GCM. Fast, authenticated encryption using Apple’s CryptoKit. Recommended for new apps."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".legacy","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" — RNCryptor v3 format. Use this for backward compatibility with Ensembles 2 encrypted data."}]}]}]},{"inlineContent":[{"text":"The backend auto-detects the encryption format when downloading, so a ","type":"text"},{"code":".modern","type":"codeVoice"},{"text":" client can read ","type":"text"},{"type":"codeVoice","code":".legacy"},{"text":" files and vice versa. The format setting only controls how ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"new","type":"text"}]},{"text":" files are encrypted.","type":"text"}],"type":"paragraph"},{"anchor":"Setup","level":3,"text":"Setup","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Wrap any cloud file system with encryption:","type":"text"}]},{"code":["import Ensembles","import EnsemblesEncrypted","import EnsemblesCloudKit","","\/\/ Wrap CloudKit with encryption","let cloudKitFS = CloudKitFileSystem(","    privateDatabaseForUbiquityContainerIdentifier: \"iCloud.com.yourcompany.yourapp\",","    schemaVersion: .v2",")","let encryptedFS = EncryptedCloudFileSystem(","    cloudFileSystem: cloudKitFS,","    password: \"user-supplied-password\"",")","","let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MainStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: encryptedFS!",")","try await ensemble?.attachPersistentStore()"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"For more control over the vault, use the ","type":"text"},{"code":"VaultInfo","type":"codeVoice"},{"type":"text","text":" initializer:"}]},{"type":"codeListing","syntax":"swift","code":["let encryptedFS = EncryptedCloudFileSystem(","    cloudFileSystem: innerFS,","    vaultInfo: vaultInfo,","    encryptionFormat: .modern",")"]},{"anchor":"When-to-Use-Encryption","type":"heading","level":3,"text":"When to Use Encryption"},{"inlineContent":[{"text":"Ensembles sync data is stored as opaque binary files, so even without encryption the raw data is not human-readable. However, it could be deserialized by someone with access to your cloud storage.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For ","type":"text"},{"inlineContent":[{"type":"text","text":"CloudKit"}],"type":"strong"},{"text":", Apple encrypts ","type":"text"},{"code":"CKAsset","type":"codeVoice"},{"text":" data at rest. With Advanced Data Protection (ADP) enabled, assets are end-to-end encrypted. Wrapping CloudKit with ","type":"text"},{"code":"EncryptedCloudFileSystem","type":"codeVoice"},{"text":" adds a layer of protection that doesn’t depend on the user enabling ADP.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"third-party backends"}]},{"type":"text","text":" (Google Drive, OneDrive, WebDAV, etc.), the storage provider can see the raw files. Wrapping with "},{"code":"EncryptedCloudFileSystem","type":"codeVoice"},{"type":"text","text":" ensures data is encrypted before it leaves the device, regardless of what the provider does."}],"type":"paragraph"},{"anchor":"How-It-Works","type":"heading","level":3,"text":"How It Works"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Vault directory"}],"type":"strong"},{"type":"text","text":" — All encrypted files are stored inside a vault directory in the cloud, derived from the password. Different passwords create different vaults, so the same cloud account can host multiple independent encrypted sync stores."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Upload"}],"type":"strong"},{"text":" — When Ensembles uploads a file, the wrapper encrypts it to a local temporary file, uploads the encrypted version with a ","type":"text"},{"code":".cdecrypt","type":"codeVoice"},{"text":" extension, then removes the temporary file.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Download"}],"type":"strong"},{"type":"text","text":" — When Ensembles downloads a file, the wrapper downloads the encrypted "},{"type":"codeVoice","code":".cdecrypt"},{"type":"text","text":" file, auto-detects the format (modern or legacy), decrypts it to a local temporary file, and returns the decrypted content."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Backward compatibility"}]},{"text":" — The ","type":"text"},{"code":".legacy","type":"codeVoice"},{"text":" format uses RNCryptor v3, the same encryption format used by Ensembles 2’s ","type":"text"},{"code":"CDEEncryptedCloudFileSystem","type":"codeVoice"},{"text":". Apps migrating from E2 to E3 can read existing encrypted cloud data without re-encrypting.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"level":3,"text":"Wrapping Other Backends","anchor":"Wrapping-Other-Backends","type":"heading"},{"inlineContent":[{"type":"text","text":"The wrapper works with any "},{"type":"codeVoice","code":"CloudFileSystem"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Wrap Google Drive","let encryptedGDrive = EncryptedCloudFileSystem(","    cloudFileSystem: GoogleDriveCloudFileSystem(authenticator: gdAuthenticator),","    password: password",")","","\/\/ Wrap WebDAV","let encryptedWebDAV = EncryptedCloudFileSystem(","    cloudFileSystem: WebDAVCloudFileSystem(baseURL: webdavURL, username: user, password: pass),","    password: encryptionPassword",")"],"type":"codeListing"},{"level":3,"anchor":"Dependencies","text":"Dependencies","type":"heading"},{"inlineContent":[{"text":"This module has ","type":"text"},{"inlineContent":[{"text":"no external dependencies","type":"text"}],"type":"strong"},{"text":" beyond Foundation, CryptoKit, and the core ","type":"text"},{"code":"Ensembles","type":"codeVoice"},{"text":" framework.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/ensemblesencrypted"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"title":"Cloud File System","anchor":"Cloud-File-System","identifiers":["doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptedCloudFileSystem"]},{"title":"Structures","anchor":"Structures","generated":true,"identifiers":["doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/VaultInfo"]},{"title":"Enumerations","anchor":"Enumerations","generated":true,"identifiers":["doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptionError","doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptionFormat","doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/FileEncryptor"]}],"sections":[],"identifier":{"url":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"An encryption wrapper for any Ensembles cloud backend."}],"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/EncryptionError":{"url":"\/documentation\/ensemblesencrypted\/encryptionerror","title":"EncryptionError","identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptionError","kind":"symbol","abstract":[{"text":"Errors that can occur during encryption or decryption.","type":"text"}],"type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EncryptionError","kind":"identifier"}],"navigatorTitle":[{"text":"EncryptionError","kind":"identifier"}],"role":"symbol"},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/EncryptionFormat":{"identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptionFormat","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EncryptionFormat","kind":"identifier"}],"abstract":[{"type":"text","text":"The encryption format to use when encrypting data."}],"url":"\/documentation\/ensemblesencrypted\/encryptionformat","kind":"symbol","role":"symbol","type":"topic","navigatorTitle":[{"text":"EncryptionFormat","kind":"identifier"}],"title":"EncryptionFormat"},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/VaultInfo":{"title":"VaultInfo","kind":"symbol","url":"\/documentation\/ensemblesencrypted\/vaultinfo","role":"symbol","abstract":[{"text":"Represents a vault in an encrypted cloud file system.","type":"text"}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"VaultInfo"}],"navigatorTitle":[{"text":"VaultInfo","kind":"identifier"}],"identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/VaultInfo"},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/EncryptedCloudFileSystem":{"identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptedCloudFileSystem","fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"kind":"identifier","text":"EncryptedCloudFileSystem"}],"abstract":[{"text":"A cloud file system wrapper that encrypts files before uploading","type":"text"},{"text":" ","type":"text"},{"text":"and decrypts them after downloading.","type":"text"}],"url":"\/documentation\/ensemblesencrypted\/encryptedcloudfilesystem","kind":"symbol","role":"symbol","type":"topic","navigatorTitle":[{"text":"EncryptedCloudFileSystem","kind":"identifier"}],"title":"EncryptedCloudFileSystem"},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/FileEncryptor":{"navigatorTitle":[{"text":"FileEncryptor","kind":"identifier"}],"identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/FileEncryptor","type":"topic","url":"\/documentation\/ensemblesencrypted\/fileencryptor","title":"FileEncryptor","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"FileEncryptor"}],"abstract":[{"type":"text","text":"Unified encryption\/decryption interface with automatic format detection on decrypt."}],"role":"symbol","kind":"symbol"},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted":{"abstract":[{"text":"An encryption wrapper for any Ensembles cloud backend.","type":"text"}],"url":"\/documentation\/ensemblesencrypted","kind":"symbol","role":"collection","type":"topic","title":"EnsemblesEncrypted","identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted"}}}