{"primaryContentSections":[{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"EnsemblesEncrypted provides ","type":"text"},{"identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptedCloudFileSystem","type":"reference","isActive":true},{"text":", a wrapper that encrypts files before uploading and decrypts after downloading. It can wrap any ","type":"text"},{"code":"CloudFileSystem","type":"codeVoice"},{"text":" implementation — CloudKit, Google Drive, WebDAV, or your own custom backend — to provide end-to-end encryption for sync data.","type":"text"}]},{"inlineContent":[{"text":"Encrypted files are stored in a password-derived vault directory with a ","type":"text"},{"code":".cdecrypt","type":"codeVoice"},{"text":" extension. This is backward compatible with the Ensembles 2 Objective-C ","type":"text"},{"code":"CDEEncryptedCloudFileSystem","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"level":3,"text":"Encryption Formats","type":"heading","anchor":"Encryption-Formats"},{"type":"paragraph","inlineContent":[{"text":"Two encryption formats are available:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".modern","type":"codeVoice"}],"type":"strong"},{"text":" (default) — AES-256-GCM. Fast, authenticated encryption using Apple’s CryptoKit. Recommended for new apps.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".legacy","type":"codeVoice"}],"type":"strong"},{"text":" — RNCryptor v3 format. Use this for backward compatibility with Ensembles 2 encrypted data.","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"The backend auto-detects the encryption format when downloading, so a ","type":"text"},{"code":".modern","type":"codeVoice"},{"text":" client can read ","type":"text"},{"code":".legacy","type":"codeVoice"},{"text":" files and vice versa. The format setting only controls how ","type":"text"},{"inlineContent":[{"text":"new","type":"text"}],"type":"emphasis"},{"text":" files are encrypted.","type":"text"}]},{"anchor":"Setup","text":"Setup","level":3,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Wrap any cloud file system with encryption:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import Ensembles","import EnsemblesEncrypted","import EnsemblesCloudKit","","\/\/ Wrap CloudKit with encryption","let cloudKitFS = CloudKitFileSystem(","    privateDatabaseForUbiquityContainerIdentifier: \"iCloud.com.yourcompany.yourapp\",","    schemaVersion: .v2",")","let encryptedFS = EncryptedCloudFileSystem(","    cloudFileSystem: cloudKitFS,","    password: \"user-supplied-password\"",")","","let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MainStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: encryptedFS!",")","try await ensemble?.attachPersistentStore()"]},{"type":"paragraph","inlineContent":[{"text":"For more control over the vault, use the ","type":"text"},{"code":"VaultInfo","type":"codeVoice"},{"type":"text","text":" initializer:"}]},{"type":"codeListing","syntax":"swift","code":["let encryptedFS = EncryptedCloudFileSystem(","    cloudFileSystem: innerFS,","    vaultInfo: vaultInfo,","    encryptionFormat: .modern",")"]},{"text":"When to Use Encryption","level":3,"type":"heading","anchor":"When-to-Use-Encryption"},{"inlineContent":[{"text":"Ensembles sync data is stored as opaque binary files, so even without encryption the raw data is not human-readable. However, it could be deserialized by someone with access to your cloud storage.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For ","type":"text"},{"inlineContent":[{"text":"CloudKit","type":"text"}],"type":"strong"},{"text":", Apple encrypts ","type":"text"},{"code":"CKAsset","type":"codeVoice"},{"text":" data at rest. With Advanced Data Protection (ADP) enabled, assets are end-to-end encrypted. Wrapping CloudKit with ","type":"text"},{"code":"EncryptedCloudFileSystem","type":"codeVoice"},{"text":" adds a layer of protection that doesn’t depend on the user enabling ADP.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For ","type":"text"},{"inlineContent":[{"text":"third-party backends","type":"text"}],"type":"strong"},{"type":"text","text":" (Google Drive, OneDrive, WebDAV, etc.), the storage provider can see the raw files. Wrapping with "},{"code":"EncryptedCloudFileSystem","type":"codeVoice"},{"type":"text","text":" ensures data is encrypted before it leaves the device, regardless of what the provider does."}],"type":"paragraph"},{"text":"How It Works","level":3,"type":"heading","anchor":"How-It-Works"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Vault directory","type":"text"}],"type":"strong"},{"text":" — All encrypted files are stored inside a vault directory in the cloud, derived from the password. Different passwords create different vaults, so the same cloud account can host multiple independent encrypted sync stores.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Upload"}],"type":"strong"},{"text":" — When Ensembles uploads a file, the wrapper encrypts it to a local temporary file, uploads the encrypted version with a ","type":"text"},{"code":".cdecrypt","type":"codeVoice"},{"text":" extension, then removes the temporary file.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Download","type":"text"}],"type":"strong"},{"type":"text","text":" — When Ensembles downloads a file, the wrapper downloads the encrypted "},{"code":".cdecrypt","type":"codeVoice"},{"type":"text","text":" file, auto-detects the format (modern or legacy), decrypts it to a local temporary file, and returns the decrypted content."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Backward compatibility"}],"type":"strong"},{"type":"text","text":" — The "},{"type":"codeVoice","code":".legacy"},{"text":" format uses RNCryptor v3, the same encryption format used by Ensembles 2’s ","type":"text"},{"code":"CDEEncryptedCloudFileSystem","type":"codeVoice"},{"text":". Apps migrating from E2 to E3 can read existing encrypted cloud data without re-encrypting.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"anchor":"Wrapping-Other-Backends","text":"Wrapping Other Backends","level":3,"type":"heading"},{"inlineContent":[{"text":"The wrapper works with any ","type":"text"},{"code":"CloudFileSystem","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ Wrap Google Drive","let encryptedGDrive = EncryptedCloudFileSystem(","    cloudFileSystem: GoogleDriveCloudFileSystem(authenticator: gdAuthenticator),","    password: password",")","","\/\/ Wrap WebDAV","let encryptedWebDAV = EncryptedCloudFileSystem(","    cloudFileSystem: WebDAVCloudFileSystem(baseURL: webdavURL, username: user, password: pass),","    password: encryptionPassword",")"]},{"text":"Dependencies","anchor":"Dependencies","type":"heading","level":3},{"inlineContent":[{"text":"This module has ","type":"text"},{"inlineContent":[{"text":"no external dependencies","type":"text"}],"type":"strong"},{"text":" beyond Foundation, CryptoKit, and the core ","type":"text"},{"code":"Ensembles","type":"codeVoice"},{"text":" framework.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted"},"topicSections":[{"title":"Cloud File System","anchor":"Cloud-File-System","identifiers":["doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptedCloudFileSystem"]},{"generated":true,"title":"Structures","anchor":"Structures","identifiers":["doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/VaultInfo"]},{"generated":true,"title":"Enumerations","anchor":"Enumerations","identifiers":["doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptionError","doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptionFormat","doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/FileEncryptor"]}],"kind":"symbol","abstract":[{"text":"An encryption wrapper for any Ensembles cloud backend.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ensemblesencrypted"]}],"sections":[],"metadata":{"roleHeading":"Framework","role":"collection","modules":[{"name":"EnsemblesEncrypted"}],"title":"EnsemblesEncrypted","symbolKind":"module","externalID":"EnsemblesEncrypted"},"hierarchy":{"paths":[[]]},"references":{"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/EncryptionFormat":{"title":"EncryptionFormat","role":"symbol","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"The encryption format to use when encrypting data."}],"identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptionFormat","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EncryptionFormat","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"EncryptionFormat"}],"url":"\/documentation\/ensemblesencrypted\/encryptionformat"},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/VaultInfo":{"title":"VaultInfo","role":"symbol","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Represents a vault in an encrypted cloud file system."}],"identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/VaultInfo","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"text":"VaultInfo","kind":"identifier"}],"navigatorTitle":[{"text":"VaultInfo","kind":"identifier"}],"url":"\/documentation\/ensemblesencrypted\/vaultinfo"},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/FileEncryptor":{"abstract":[{"type":"text","text":"Unified encryption\/decryption interface with automatic format detection on decrypt."}],"type":"topic","navigatorTitle":[{"text":"FileEncryptor","kind":"identifier"}],"title":"FileEncryptor","url":"\/documentation\/ensemblesencrypted\/fileencryptor","kind":"symbol","identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/FileEncryptor","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FileEncryptor","kind":"identifier"}]},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/EncryptionError":{"role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"EncryptionError"}],"identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptionError","abstract":[{"text":"Errors that can occur during encryption or decryption.","type":"text"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"EncryptionError"}],"type":"topic","title":"EncryptionError","url":"\/documentation\/ensemblesencrypted\/encryptionerror"},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted":{"url":"\/documentation\/ensemblesencrypted","title":"EnsemblesEncrypted","role":"collection","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"An encryption wrapper for any Ensembles cloud backend."}],"identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted"},"doc://EnsemblesEncrypted/documentation/EnsemblesEncrypted/EncryptedCloudFileSystem":{"title":"EncryptedCloudFileSystem","role":"symbol","kind":"symbol","type":"topic","abstract":[{"text":"A cloud file system wrapper that encrypts files before uploading","type":"text"},{"text":" ","type":"text"},{"text":"and decrypts them after downloading.","type":"text"}],"identifier":"doc:\/\/EnsemblesEncrypted\/documentation\/EnsemblesEncrypted\/EncryptedCloudFileSystem","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"EncryptedCloudFileSystem"}],"navigatorTitle":[{"text":"EncryptedCloudFileSystem","kind":"identifier"}],"url":"\/documentation\/ensemblesencrypted\/encryptedcloudfilesystem"}}}