ctURI: \"com.googleusercontent.apps.YOUR-CLIENT-ID:\/oauthredirect\"",")","let authenticator = GoogleDriveAuthenticator(configuration: config)","try await authenticator.authorize(presenting: window)","","let cloudFS = GoogleDriveCloudFileSystem(authenticator: authenticator)","let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MyStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: cloudFS",")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The authenticator stores tokens in the Keychain and refreshes them automatically","type":"text"},{"text":" ","type":"text"},{"text":"when they expire. The default scope is ","type":"text"},{"code":"drive.file","type":"codeVoice"},{"text":" (per-file access), which","type":"text"},{"text":" ","type":"text"},{"text":"limits the app to files it creates.","type":"text"}]},{"type":"heading","level":2,"text":"Threading","anchor":"Threading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This class is "},{"type":"codeVoice","code":"@unchecked Sendable"},{"type":"text","text":". All network calls go through a shared"},{"type":"text","text":" "},{"code":"URLSession","type":"codeVoice"},{"text":" instance, which is thread-safe. Mutable state (caches, ","type":"text"},{"type":"codeVoice","code":"loggedIn"},{"type":"text","text":" flag)"},{"type":"text","text":" "},{"type":"text","text":"is accessed only from async methods that are serialized by the ensemble’s operation queue."}]}],"kind":"content"}],"seeAlsoSections":[{"identifiers":["doc:\/\/EnsemblesGoogleDrive\/documentation\/EnsemblesGoogleDrive\/GoogleDriveAuthenticator"],"anchor":"Cloud-File-System","title":"Cloud File System","generated":true}],"metadata":{"externalID":"s:20EnsemblesGoogleDrive0bC15CloudFileSystemC","modules":[{"name":"EnsemblesGoogleDrive"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GoogleDriveCloudFileSystem","kind":"identifier"}],"