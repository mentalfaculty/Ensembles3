le":"Default Implementations","generated":true,"anchor":"Default-Implementations"}],"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/EnsemblesGoogleDrive\/documentation\/EnsemblesGoogleDrive\/GoogleDriveAuthenticator"],"anchor":"Cloud-File-System","title":"Cloud File System"}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"final","kind":"keyword"},{"text":" ","kind":"text"},{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GoogleDriveCloudFileSystem","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This backend communicates directly with Google’s REST API — no third-party SDK"},{"type":"text","text":" "},{"type":"text","text":"is required. Authentication is handled via an OAuth 2.0 access token passed as"},{"type":"text","text":" "},{"type":"text","text":"a "},{"type":"codeVoice","code":"Bearer"},{"type":"text","text":" header on every request."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Google Drive uses file IDs rather than paths to identify files and folders."},{"type":"text","text":" "},{"type":"text","text":"This backend bridges the path-based "},{"code":"CloudFileSystem","type":"codeVoice"},{"type":"text","text":" protocol onto Google Drive’s"},{"type":"text","text":" "},{"type":"text","text":"ID-based API by walking the folder hierarchy to resolve Ensembles paths"},{"type":"text","text":" "},{"type":"text","text":"(e.g. "},{"code":"ensembleId\/events\/file.json","type":"codeVoice"},{"text":") to Google Drive folder and file IDs.","type":"text"}]},{"inlineContent":[{"type":"text","text":"Resolved IDs are cached in internal dictionaries to minimize API calls. The cache"},{"type":"text","text":" "},{"type":"text","text":"is invalidated when items are deleted or when not-found errors indicate stale entries."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Two initialization paths are available:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ Simple: static access token (app manages refresh externally)","let cloudFS = GoogleDriveCloudFileSystem(accessToken: \"your-token\")","","\/\/ Authenticator: auto-refreshes expired tokens","let cloudFS = GoogleDriveCloudFileSystem(authenticator: authenticator)"]},{"anchor":"Setup","level":2,"type":"heading","text":"Setup"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Go to the "},{"identifier":"https:\/\/console.cloud.google.com\/","isActive":true,"type":"reference"},{"type":"text","text":" and create a project"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Enable the ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Google Drive API"}]},{"text":" under ","type":"text"},{"inlineContent":[{"text":"APIs & Services → Library","type":"text"}],"type":"emphasis"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Create an "},{"type":"strong","inlineContent":[{"text":"OAuth 2.0 Client ID","type":"text"}]},{"type":"text","text":" under "},{"type":"emphasis","inlineContent":[{"text":"APIs & Services → Credentials","type":"text"}]}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"For iOS\/macOS apps, choose “iOS” application type and enter your bundle ID","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Set the redirect URI (typically "},{"code":"com.googleusercontent.apps.YOUR-CLIENT-ID:\/oauthredirect","type":"codeVoice"},{"text":")","type":"text"}]}]}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Configure the authenticator and file system:"}]}]}],"type":"orderedList"},{"syntax":"swift","code":["let config = GoogleDriveAuthenticator.Configuration(","    clientID: \"YOUR-CLIENT-ID.apps.googleusercontent.com\",","    redirectURI: \"com.googleusercontent.apps.YOUR-CLIENT-ID:\/oauthredirect\"",")","let authenticator = GoogleDriveAuthenticator(configuration: config)","try await authenticator.authorize(presenting: window)","","let cloudFS = GoogleDriveCloudFileSystem(authenticator: authenticator)","let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MyStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: cloudFS",")"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The authenticator stores tokens in the Keychain and refreshes them automatically"},{"type":"text","text":" "},{"type":"text","text":"when they expire. The default scope is "},{"type":"codeVoice","code":"drive.file"},{"type":"text","text":" (per-file access), which"},{"type":"text","text":" "},{"type":"text","text":"limits the app to files it creates."}],"type":"paragraph"},{"text":"Threading","anchor":"Threading","level":2,"type":"heading"},{"inlineContent":[{"text":"This class is ","type":"text"},{"type":"codeVoice","code":"@unchecked Sendable"},{"text":". All network calls go through a shared","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"URLSession"},{"text":" instance, which is thread-safe. Mutable state (caches, ","type":"text"},{"type":"codeVoice","code":"loggedIn"},{"text":" flag)","type":"text"},{"text":" ","type":"text"},{"text":"is accessed only from async methods that are serialized by the ensemble’s operation queue.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"text":"A cloud file system backed by the Google Drive REST API v3 using ","type":"text"},{"code":"URLSession","type":"codeVoice"},{"text":".","type":"text"}],"relationshipsSections":[{"identifiers":["doc:\/\/EnsemblesGoogleDrive\/9Ensembles15CloudFileSystemP","doc:\/\/EnsemblesGoogleDrive\/s8SendableP","doc:\/\/EnsemblesGoogleDrive\/s16SendableMetatypeP"],"kind":"relationships","title":"Conforms To","type