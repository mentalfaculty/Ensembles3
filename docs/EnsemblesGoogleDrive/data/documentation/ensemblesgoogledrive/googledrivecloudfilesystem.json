},{"type":"text","text":" "},{"type":"text","text":"a "},{"code":"Bearer","type":"codeVoice"},{"type":"text","text":" header on every request."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Google Drive uses file IDs rather than paths to identify files and folders."},{"type":"text","text":" "},{"type":"text","text":"This backend bridges the path-based "},{"code":"CloudFileSystem","type":"codeVoice"},{"type":"text","text":" protocol onto Google Drive’s"},{"type":"text","text":" "},{"type":"text","text":"ID-based API by walking the folder hierarchy to resolve Ensembles paths"},{"type":"text","text":" "},{"type":"text","text":"(e.g. "},{"code":"ensembleId\/events\/file.json","type":"codeVoice"},{"type":"text","text":") to Google Drive folder and file IDs."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Resolved IDs are cached in internal dictionaries to minimize API calls. The cache"},{"type":"text","text":" "},{"type":"text","text":"is invalidated when items are deleted or when not-found errors indicate stale entries."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Two initialization paths are available:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Simple: static access token (app manages refresh externally)","let cloudFS = GoogleDriveCloudFileSystem(accessToken: \"your-token\")","","\/\/ Authenticator: auto-refreshes expired tokens","let cloudFS = GoogleDriveCloudFileSystem(authenticator: authenticator)"],"type":"codeListing"},{"anchor":"Setup","level":2,"type":"heading","text":"Setup"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Go to the "},{"isActive":true,"type":"reference","identifier":"https:\/\/console.cloud.google.com\/"},{"type":"text","text":" and create a project"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Enable the "},{"type":"strong","inlineContent":[{"text":"Google Drive API","type":"text"}]},{"type":"text","text":" under "},{"type":"emphasis","inlineContent":[{"text":"APIs & Services → Library","type":"text"}]}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Create an "},{"type":"strong","inlineContent":[{"text":"OAuth 2.0 Client ID","type":"text"}]},{"type":"text","text":" under "},{"type":"emphasis","inlineContent":[{"text":"APIs & Services → Credentials","type":"text"}]}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"For iOS\/macOS apps, choose “iOS” application type and enter your bundle ID"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Set the redirect URI (typically "},{"type":"codeVoice","code":"com.googleusercontent.apps.YOUR-CLIENT-ID:\/oauthredirect"},{"type":"text","text":")"}],"type":"paragraph"}]}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Configure the authenticator and file system:"}]}]}],"type":"orderedList"},{"syntax":"swift","code":["let config = GoogleDriveAuthenticator.Configuration(","    clientID: \"YOUR-CLIENT-ID.apps.googleusercontent.com\",","    redirectURI: \"com.googleusercontent.apps.YOUR-CLIENT-ID:\/oauthredirect\"",")","let authenticator = GoogleDriveAuthenticator(configuration: config)","try await authenticator.authorize(presenting: window)","","let cloudFS = GoogleDriveCloudFileSystem(authenticator: authenticator)","let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MyStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: cloudFS",")"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The authenticator stores tokens in the Keychain and refreshes them automatically"},{"type":"text","text":" "},{"type":"text","text":"when they expire. The default scope is "},{"code":"drive.file","type":"codeVoice"},{"type":"text","text":" (per-file access), which"},{"type":"text","text":" "},{"type":"text","text":"limits the app to files it creates."}],"type":"paragraph"},{"anchor":"Threading","level":2,"type":"heading","text":"Threading"},{"inlineContent":[{"type":"text","text":"This class is "},{"code":"@unchecked Sendable","type":"codeVoice"},{"type":"text","text":". All network calls go through a shared"},{"type":"text","text":" "},{"code":"URLSession","type":"codeVoice"},{"type":"text","text":" instance, which is thread-safe. Mutable state (caches, "},{"code":"loggedIn","type":"codeVoice"},{"type":"text","text":" flag)"},{"type":"text","text":" "},{"type":"text","text":"is accessed only from async methods that are serialized by the ensemble’s operation queue."}],"type":"paragraph"}]}],"references":{"doc://EnsemblesGoogleDrive/documentation/EnsemblesGoogleDrive/GoogleDriveCloudFileSystem/fetchUserIdentity()":{"type":"topic","role":"symbol","url":"\/documentation\/ensemblesgoogledrive\/googledrivecloudfilesystem\/fetchuseridentity()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"fetchUserIdentity"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"text":" ","kind":"text"},{"kind":"keyword","text":"throws"},{"text":" -> sending (any ","kind":"text"},{"text":"NSCoding","kind":"typeIdentifier","preciseIdentifier":"c:objc(pl)NSCoding"},{"text":" & ","kind":"text"},{"text":"NSCopying","kind":"typeIdentifier","preciseIdentifier":"c:objc(pl)NSCopying"},{"text":" & ","kind":"text"},{"text":"NSObjectProtocol","kind":"typeIdentifier","preciseIdentifier":"c:objc(pl)NSObject"},{"kind":"text","text":")?"}],"abstract":[{"type":"text","text":"Fetches a token representing the current user of the cloud file system."},{"type":"text","text":" "},{"type":"text","text":"Often this will be the user or login name."}],"kind":"symbol","title":"fetchUserIdentity()","identifier":"doc:\/\/EnsemblesGoogleDrive\/documentation\/EnsemblesGoogleDrive\/GoogleDriveCloudFileSystem\/fetchUserIdentity()"},"doc://EnsemblesGoogleDrive/documentation/EnsemblesGoogleDrive/GoogleDriveAuthenticator