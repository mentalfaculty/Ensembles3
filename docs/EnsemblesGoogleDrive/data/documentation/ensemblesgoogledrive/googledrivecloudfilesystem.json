ice","code":"Bearer"},{"text":" header on every request.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Google Drive uses file IDs rather than paths to identify files and folders.","type":"text"},{"text":" ","type":"text"},{"text":"This backend bridges the path-based ","type":"text"},{"type":"codeVoice","code":"CloudFileSystem"},{"text":" protocol onto Google Drive’s","type":"text"},{"text":" ","type":"text"},{"text":"ID-based API by walking the folder hierarchy to resolve Ensembles paths","type":"text"},{"text":" ","type":"text"},{"text":"(e.g. ","type":"text"},{"type":"codeVoice","code":"ensembleId\/events\/file.json"},{"text":") to Google Drive folder and file IDs.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Resolved IDs are cached in internal dictionaries to minimize API calls. The cache"},{"type":"text","text":" "},{"type":"text","text":"is invalidated when items are deleted or when not-found errors indicate stale entries."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Two initialization paths are available:"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Simple: static access token (app manages refresh externally)","let cloudFS = GoogleDriveCloudFileSystem(accessToken: \"your-token\")","","\/\/ Authenticator: auto-refreshes expired tokens","let cloudFS = GoogleDriveCloudFileSystem(authenticator: authenticator)"]},{"type":"heading","level":2,"text":"Setup","anchor":"Setup"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Go to the ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/console.cloud.google.com\/"},{"text":" and create a project","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Enable the ","type":"text"},{"type":"strong","inlineContent":[{"text":"Google Drive API","type":"text"}]},{"type":"text","text":" under "},{"type":"emphasis","inlineContent":[{"text":"APIs & Services → Library","type":"text"}]}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Create an "},{"inlineContent":[{"text":"OAuth 2.0 Client ID","type":"text"}],"type":"strong"},{"type":"text","text":" under "},{"inlineContent":[{"type":"text","text":"APIs & Services → Credentials"}],"type":"emphasis"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For iOS\/macOS apps, choose “iOS” application type and enter your bundle ID"}]}]},{"content":[{"inlineContent":[{"text":"Set the redirect URI (typically ","type":"text"},{"code":"com.googleusercontent.apps.YOUR-CLIENT-ID:\/oauthredirect","type":"codeVoice"},{"text":")","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}]},{"content":[{"inlineContent":[{"type":"text","text":"Configure the authenticator and file system:"}],"type":"paragraph"}]}]},{"type":"codeListing","syntax":"swift","code":["let config = GoogleDriveAuthenticator.Configuration(","    clientID: \"YOUR-CLIENT-ID.apps.googleusercontent.com\",","    redirectURI: \"com.googleusercontent.apps.YOUR-CLIENT-ID:\/oauthredirect\"",")","let authenticator = GoogleDriveAuthenticator(configuration: config)","try await authenticator.authorize(presenting: window)","","let cloudFS = GoogleDriveCloudFileSystem(authenticator: authenticator)","let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MyStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: cloudFS",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The authenticator stores tokens in the Keychain and refreshes them automatically"},{"type":"text","text":" "},{"type":"text","text":"when they expire. The default scope is "},{"type":"codeVoice","code":"drive.file"},{"type":"text","text":" (per-file access), which"},{"type":"text","text":" "},{"type":"text","text":"limits the app to files it creates."}]},{"level":2,"type":"heading","text":"Threading","anchor":"Threadin