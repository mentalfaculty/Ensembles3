-ID:\/oauthredirect\"",")","let authenticator = GoogleDriveAuthenticator(configuration: config)","try await authenticator.authorize(presenting: window)","","let cloudFS = GoogleDriveCloudFileSystem(authenticator: authenticator)","let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MyStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: cloudFS",")"]},{"type":"paragraph","inlineContent":[{"text":"The authenticator stores tokens in the Keychain and refreshes them automatically","type":"text"},{"text":" ","type":"text"},{"text":"when they expire. The default scope is ","type":"text"},{"type":"codeVoice","code":"drive.file"},{"text":" (per-file access), which","type":"text"},{"text":" ","type":"text"},{"text":"limits the app to files it creates.","type":"text"}]},{"level":2,"text":"Threading","type":"heading","anchor":"Threading"},{"inlineContent":[{"type":"text","text":"This class is "},{"code":"@unchecked Sendable","type":"codeVoice"},{"type":"text","text":". All network calls go through a shared"},{"type":"text","text":" "},{"type":"codeVoice","code":"URLSession"},{"type":"text","text":" instance, which is thread-safe. Mutable state (caches, "},{"type":"codeVoice","code":"loggedIn"},{"type":"text","text":" flag)"},{"type":"text","text":" "},{"type":"text","text":"is accessed only from async methods that are serialized by the ensemble’s operation queue."}],"type":"paragraph"}],"kind":"content"}],"metadata":{"modules":[{"name":"EnsemblesGoogleDrive"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GoogleDriveCloudFileSystem","kind":"identifier"}],"externalID":"s:20EnsemblesGoogleDrive0bC15CloudFileSystemC","role":"symbol","symbolKind":"class","roleHeading":"Class","title":"GoogleDriveCloudFileSystem","navigatorTitle":[{"kind":"identifier","text":"GoogleDriveCloudFileSystem"}]},"abstract":[{"type":"text","text":"A cloud file system backed by the Google Drive REST API v3 usi