h 2.0 access token passed as","type":"text"},{"text":" ","type":"text"},{"text":"a ","type":"text"},{"code":"Bearer","type":"codeVoice"},{"text":" header on every request.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Google Drive uses file IDs rather than paths to identify files and folders.","type":"text"},{"text":" ","type":"text"},{"text":"This backend bridges the path-based ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/EnsemblesGoogleDrive\/documentation\/EnsemblesGoogleDrive\/CloudFileSystem"},{"text":" protocol onto Google Drive’s","type":"text"},{"text":" ","type":"text"},{"text":"ID-based API by walking the folder hierarchy to resolve Ensembles paths","type":"text"},{"text":" ","type":"text"},{"text":"(e.g. ","type":"text"},{"code":"ensembleId\/events\/file.json","type":"codeVoice"},{"text":") to Google Drive folder and file IDs.","type":"text"}]},{"inlineContent":[{"type":"text","text":"Resolved IDs are cached in internal dictionaries to minimize API calls. The cache"},{"type":"text","text":" "},{"type":"text","text":"is invalidated when items are deleted or when not-found errors indicate stale entries."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Two initialization paths are available:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ Simple: static access token (app manages refresh externally)","let cloudFS = GoogleDriveCloudFileSystem(accessToken: \"your-token\")","","\/\/ Authenticator: auto-refreshes expired tokens","let cloudFS = GoogleDriveCloudFileSystem(authenticator: authenticator)"]},{"anchor":"Setup","level":2,"text":"Setup","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Go to the "},{"type":"reference","isActive":true,"identifier":"https:\/\/console.cloud.google.com\/"},{"type":"text","text":" and create a project"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Enable the "},{"type":"strong","inlineContent":[{"type":"text","text":"Google Drive API"}]},{"type":"text","text":" under "},{"type":"emphasis","inlineContent":[{"type":"text","text":"APIs & Services → Library"}]}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Create an "},{"type":"strong","inlineContent":[{"type":"text","text":"OAuth 2.0 Client ID"}]},{"type":"text","text":" under "},{"type":"emphasis","inlineContent":[{"type":"text","text":"APIs & Services → Credentials"}]}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For iOS\/macOS apps, choose “iOS” application type and enter your bundle ID"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Set the redirect URI (typically "},{"code":"com.googleusercontent.apps.YOUR-CLIENT-ID:\/oauthredirect","type":"codeVoice"},{"type":"text","text":")"}]}]}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Configure the authenticator and file system:"}]}]}],"type":"orderedList"},{"syntax":"swift","type":"codeListing","code":["let config = GoogleDriveAuthenticator.Configuration(","    clientID: \"YOUR-CLIENT-ID.apps.googleusercontent.com\",","    redirectURI: \"com.googleusercontent.apps.YOUR-CLIENT-ID:\/oauthredirect\"",")","let authenticator = GoogleDriveAuthenticator(configuration: config)","try await authenticator.authorize(presenting: window)","","let cloudFS = GoogleDriveCloudFileSystem(authenticator: authenticator)","let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MyStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: cloudFS",")"]},{"inlineContent":[{"type":"text","text":"The authenticator stores tokens in the Keychain and refreshes them automatically"},{"type":"text","text":" "},{"type":"text","text":"when they expire. The default scope is "},{"code":"drive.file","type":"codeVoice"},{"type":"text","text":" (per-file access), which"},{"type":"text","text":" "},{"type":"text","text":"limits the app to files it creates."}],"type":"paragraph"},{"anchor":"Threading","level":2,"text":"Threading","type":"heading"},{"inlineContent":[{"type":"text","text":"This class is "},{"code":"@unchecked Sendable","type":"codeVoice"},{"type":"text","text":". All network calls go through a shared"},{"type":"text","text":" "},{"code":"URLSession","type":"codeVoice"},{"type":"text","text":" instance, which is thread-safe. Mutable state (caches, "},{"type":"codeVoice","code":"loggedIn"},{"type":"text","text":" flag)"},{"type":"text","text":" "},{"type":"text","text":"is accessed only from async methods that are serialized by the ensemble’s operation queue."}],"type":"paragraph"}]}],"references":{"doc://EnsemblesGoogleDrive/documentation/EnsemblesGoogleDrive/CloudFileSystem":{"kind":"symbol","title":"CloudFileSystem","type":"topic","role":"symbol","identifier":"doc:\/\/EnsemblesGoogleDrive\/documentation\/EnsemblesGoogleDrive\/CloudFileSystem","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CloudFileSystem","kind":"identifier"}],"navigatorTitle":[{"text":"CloudFileSystem","kind":"identifier"}],"url":"\/documentation\/ensemblesgoogledrive\/cloudfilesystem","abstract":[]},"doc://EnsemblesGoogleDrive/documentation/EnsemblesGoogleDrive/GoogleDriveCloudFileSystem/fileExists(atPath:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"fileExists","kind":"identifier"},{"text":"(","kind":"text"},{"text":"atPath","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:9Ensembles13FileExistenceV","text":"FileExistence","kind":"typeIdentifier"}],"kind":"symbol","abstract":[],"identifier":"doc:\/\/EnsemblesGoogleD