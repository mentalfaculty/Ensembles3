{"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"final","kind":"keyword"},{"text":" ","kind":"text"},{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GoogleDriveCloudFileSystem","kind":"identifier"}]}],"kind":"declarations"},{"content":[{"anchor":"overview","type":"heading","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"This backend communicates directly with Google’s REST API — no third-party SDK","type":"text"},{"text":" ","type":"text"},{"text":"is required. Authentication is handled via an OAuth 2.0 access token passed as","type":"text"},{"text":" ","type":"text"},{"text":"a ","type":"text"},{"code":"Bearer","type":"codeVoice"},{"text":" header on every request.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Google Drive uses file IDs rather than paths to identify files and folders.","type":"text"},{"text":" ","type":"text"},{"text":"This backend bridges the path-based ","type":"text"},{"code":"CloudFileSystem","type":"codeVoice"},{"text":" protocol onto Google Drive’s","type":"text"},{"text":" ","type":"text"},{"text":"ID-based API by walking the folder hierarchy to resolve Ensembles paths","type":"text"},{"text":" ","type":"text"},{"text":"(e.g. ","type":"text"},{"code":"ensembleId\/events\/file.json","type":"codeVoice"},{"text":") to Google Drive folder and file IDs.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Resolved IDs are cached in internal dictionaries to minimize API calls. The cache","type":"text"},{"text":" ","type":"text"},{"text":"is invalidated when items are deleted or when not-found errors indicate stale entries.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Two initialization paths are available:","type":"text"}]},{"type":"codeListing","code":["\/\/ Simple: static access token (app manages refresh externally)","let cloudFS = GoogleDriveCloudFileSystem(accessToken: \"your-token\")","","\/\/ Authenticator: auto-refreshes expired tokens","let cloudFS = GoogleDriveCloudFileSystem(authenticator: authenticator)"],"syntax":"swift"},{"anchor":"Setup","type":"heading","text":"Setup","level":2},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Go to the "},{"type":"reference","identifier":"https:\/\/console.cloud.google.com\/","isActive":true},{"type":"text","text":" and create a project"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Enable the "},{"type":"strong","inlineContent":[{"type":"text","text":"Google Drive API"}]},{"type":"text","text":" under "},{"type":"emphasis","inlineContent":[{"type":"text","text":"APIs & Services → Library"}]}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Create an "},{"type":"strong","inlineContent":[{"type":"text","text":"OAuth 2.0 Client ID"}]},{"type":"text","text":" under "},{"type":"emphasis","inlineContent":[{"type":"text","text":"APIs & Services → Credentials"}]}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For iOS\/macOS apps, choose “iOS” application type and enter your bundle ID"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Set the redirect URI (typically "},{"type":"codeVoice","code":"com.googleusercontent.apps.YOUR-CLIENT-ID:\/oauthredirect"},{"type":"text","text":")"}]}]}],"type":"unorderedList"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Configure the authenticator and file system:"}]}]}]},{"type":"codeListing","code":["let config = GoogleDriveAuthenticator.Configuration(","    clientID: \"YOUR-CLIENT-ID.apps.googleusercontent.com\",","    redirectURI: \"com.googleusercontent.apps.YOUR-CLIENT-ID:\/oauthredirect\"",")","let authenticator = GoogleDriveAuthenticator(configuration: config)","try await authenticator.authorize(presenting: window)","","let cloudFS = GoogleDriveCloudFileSystem(authenticator: authenticator)","let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MyStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: cloudFS",")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The authenticator stores tokens in the Keychain and refreshes them automatically","type":"text"},{"text":" ","type":"text"},{"text":"when they expire. The default scope is ","type":"text"},{"code":"drive.file","type":"codeVoice"},{"text":" (per-file access), which","type":"text"},{"text":" ","type":"text"},{"text":"limits the app to files it creates.","type":"text"}]},{"anchor":"Threading","type":"heading","text":"Threading","level":2},{"type":"paragraph","inlineContent":[{"text":"This class is ","type":"text"},{"code":"@unchecked Sendable","type":"codeVoice"},{"text":". All network calls go through a shared","type":"text"},{"text":" ","type":"text"},{"code":"URLSession","type":"codeVoice"},{"text":" instance, which is thread-safe. Mutable state (caches, ","type":"text"},{"code":"loggedIn","type":"codeVoice"},{"text":" flag)","type":"text"},{"text":" ","type":"text"},{"text":"is accessed only from async methods that are serialized by the ensemble’s operation queue.","type":"text"}]}],"kind":"content"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"topicSections":[{"identifiers":["doc:\/\/EnsemblesGoogleDrive\/documentation\/EnsemblesGoogleDrive\/GoogleDriveCloudFileSystem\/init(accessToken:)","doc:\/\/EnsemblesGoogleDrive\/documentation\/EnsemblesGoogleDrive\/GoogleDriveCloudFileSystem\/init(authenticator:)"],"anchor":"Initializers","title":"Initializers","generated":true},{"identifiers":["doc:\/\/EnsemblesGoogleDrive\/documentation\/EnsemblesGoogleDrive\/GoogleDriveCloudFileSystem\/isConnected"],"anchor":"Instance-Properties","title":"Instance Properties","generated":true},{"identifiers":["doc:\/\/EnsemblesGoogleDrive\/documentation\/EnsemblesGoogleDrive\/GoogleDriveCloudFileSystem\/connect()","d