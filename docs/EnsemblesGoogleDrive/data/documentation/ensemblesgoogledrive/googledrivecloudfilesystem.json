ype":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Google Drive uses file IDs rather than paths to identify files and folders.","type":"text"},{"text":" ","type":"text"},{"text":"This backend bridges the path-based ","type":"text"},{"code":"CloudFileSystem","type":"codeVoice"},{"text":" protocol onto Google Drive’s","type":"text"},{"text":" ","type":"text"},{"text":"ID-based API by walking the folder hierarchy to resolve Ensembles paths","type":"text"},{"text":" ","type":"text"},{"text":"(e.g. ","type":"text"},{"code":"ensembleId\/events\/file.json","type":"codeVoice"},{"text":") to Google Drive folder and file IDs.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Resolved IDs are cached in internal dictionaries to minimize API calls. The cache","type":"text"},{"text":" ","type":"text"},{"text":"is invalidated when items are deleted or when not-found errors indicate stale entries.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Two initialization paths are available:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Simple: static access token (app manages refresh externally)","let cloudFS = GoogleDriveCloudFileSystem(accessToken: \"your-token\")","","\/\/ Authenticator: auto-refreshes expired tokens","let cloudFS = GoogleDriveCloudFileSystem(authenticator: authenticator)"]},{"anchor":"Setup","level":2,"type":"heading","text":"Setup"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Go to the "},{"type":"reference","identifier":"https:\/\/console.cloud.google.com\/","isActive":true},{"type":"text","text":" and create a project"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Enable the "},{"type":"strong","inlineContent":[{"text":"Google Drive API","type":"text"}]},{"type":"text","text":" under "},{"type":"emphasis","inlineContent":[{"text":"APIs & Services → Library","type":"text"}]}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"typ