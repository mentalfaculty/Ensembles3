{"schemaVersion":{"minor":3,"patch":0,"major":0},"relationshipsSections":[{"identifiers":["doc:\/\/EnsemblesGoogleDrive\/documentation\/EnsemblesGoogleDrive\/CloudFileSystem","doc:\/\/EnsemblesGoogleDrive\/s8SendableP","doc:\/\/EnsemblesGoogleDrive\/s16SendableMetatypeP"],"title":"Conforms To","type":"conformsTo","kind":"relationships"}],"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/EnsemblesGoogleDrive\/documentation\/EnsemblesGoogleDrive\/GoogleDriveAuthenticator"],"anchor":"Cloud-File-System","title":"Cloud File System"}],"metadata":{"roleHeading":"Class","role":"symbol","navigatorTitle":[{"text":"GoogleDriveCloudFileSystem","kind":"identifier"}],"externalID":"s:20EnsemblesGoogleDrive0bC15CloudFileSystemC","title":"GoogleDriveCloudFileSystem","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"GoogleDriveCloudFileSystem"}],"modules":[{"name":"EnsemblesGoogleDrive"}],"symbolKind":"class"},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"final","kind":"keyword"},{"text":" ","kind":"text"},{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"GoogleDriveCloudFileSystem"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Overview","type":"heading","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"text":"This backend communicates directly with Google’s REST API — no third-party SDK","type":"text"},{"text":" ","type":"text"},{"text":"is required. Authentication is handled via an OAuth 2.0 access token passed as","type":"text"},{"type":"text","text":" "},{"type":"text","text":"a "},{"type":"codeVoice","code":"Bearer"},{"text":" header on every request.","type":"text"}]},{"inlineContent":[{"type":"text","text":"Google Drive uses file IDs rather than paths to identify files and folders."},{"type":"text","text":" "},{"type":"text","text":"This backend bridges the path-based "},{"isActive":true,"type":"reference","identifier":"doc:\/\/EnsemblesGoogleDrive\/documentation\/EnsemblesGoogleDrive\/CloudFileSystem"},{"type":"text","text":" protocol onto Google Drive’s"},{"type":"text","text":" "},{"type":"text","text":"ID-based API by walking the folder hierarchy to resolve Ensembles paths"},{"type":"text","text":" "},{"type":"text","text":"(e.g. "},{"type":"codeVoice","code":"ensembleId\/events\/file.json"},{"type":"text","text":") to Google Drive folder and file IDs."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Resolved IDs are cached in internal dictionaries to minimize API calls. The cache"},{"type":"text","text":" "},{"type":"text","text":"is invalidated when items are deleted or when not-found errors indicate stale entries."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Two initialization paths are available:"}]},{"type":"codeListing","code":["\/\/ Simple: static access token (app manages refresh externally)","let cloudFS = GoogleDriveCloudFileSystem(accessToken: \"your-token\")","","\/\/ Authenticator: auto-refreshes expired tokens","let cloudFS = GoogleDriveCloudFileSystem(authenticator: authenticator)"],"syntax":"swift"},{"type":"heading","level":2,"text":"Setup","anchor":"Setup"},{"items":[{"content":[{"inlineContent":[{"text":"Go to the ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/console.cloud.google.com\/"},{"type":"text","text":" and create a project"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Enable the "},{"inlineContent":[{"type":"text","text":"Google Drive API"}],"type":"strong"},{"type":"text","text":" under "},{"inlineContent":[{"type":"text","text":"APIs & Services → Library"}],"type":"emphasis"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Create an "},{"inlineContent":[{"type":"text","text":"OAuth 2.0 Client ID"}],"type":"strong"},{"type":"text","text":" under "},{"inlineContent":[{"type":"text","text":"APIs & Services → Credentials"}],"type":"emphasis"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"For iOS\/macOS apps, choose “iOS” application type and enter your bundle ID","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Set the redirect URI (typically ","type":"text"},{"type":"codeVoice","code":"com.googleusercontent.apps.YOUR-CLIENT-ID:\/oauthredirect"},{"text":")","type":"text"}]}]}],"type":"unorderedList"}]},{"content":[{"inlineContent":[{"type":"text","text":"Configure the authenticator and file system:"}],"type":"paragraph"}]}],"type":"orderedList"},{"type":"codeListing","code":["let config = GoogleDriveAuthenticator.Configuration(","    clientID: \"YOUR-CLIENT-ID.apps.googleusercontent.com\",","    redirectURI: \"com.googleusercontent.apps.YOUR-CLIENT-ID:\/oauthredirect\"",")","let authenticator = GoogleDriveAuthenticator(configuration: config)","try await authenticator.authorize(presenting: window)","","let cloudFS = GoogleDriveCloudFileSystem(authenticator: authenticator)","let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MyStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: cloudFS",")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The authenticator stores tokens in the Keychain and refreshes them automatically","type":"text"},{"text":" ","type":"text"},{"text":"when they expire. The default scope is ","type":"text"},{"code":"drive.file","type":"codeVoice"},{"text":" (per-file access), which","type":"text"},{"text":" ","type":"text"},{"text":"limits the app to files it creates.","type":"text"}]},{"type":"heading","level":2,"text":"Threading","anchor":"Threading"},{"type":"paragraph","inlineContent":[{"text":"This class is ","type":"text"},{"code":"@unchecked Sendable","type":"codeVoice"},{"text":". All network calls go through a shared","type":"text"},{"text":" ","type":"text"},{"code":"URL