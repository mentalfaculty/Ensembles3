t","text":" "},{"type":"text","text":"a "},{"type":"codeVoice","code":"Bearer"},{"type":"text","text":" header on every request."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Google Drive uses file IDs rather than paths to identify files and folders."},{"type":"text","text":" "},{"type":"text","text":"This backend bridges the path-based "},{"type":"codeVoice","code":"CloudFileSystem"},{"type":"text","text":" protocol onto Google Drive’s"},{"type":"text","text":" "},{"type":"text","text":"ID-based API by walking the folder hierarchy to resolve Ensembles paths"},{"type":"text","text":" "},{"type":"text","text":"(e.g. "},{"type":"codeVoice","code":"ensembleId\/events\/file.json"},{"type":"text","text":") to Google Drive folder and file IDs."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Resolved IDs are cached in internal dictionaries to minimize API calls. The cache"},{"type":"text","text":" "},{"type":"text","text":"is invalidated when items are deleted or when not-found errors indicate stale entries."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Two initialization paths are available:"}],"type":"paragraph"},{"code":["\/\/ Simple: static access token (app manages refresh externally)","let cloudFS = GoogleDriveCloudFileSystem(accessToken: \"your-token\")","","\/\/ Authenticator: auto-refreshes expired tokens","let cloudFS = GoogleDriveCloudFileSystem(authenticator: authenticator)"],"syntax":"swift","type":"codeListing"},{"level":2,"text":"Setup","anchor":"Setup","type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Go to the "},{"type":"reference","identifier":"https:\/\/console.cloud.google.com\/","isActive":true},{"type":"text","text":" and create a project"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Enable the "},{"type":"strong","inlineContent":[{"type":"text","text":"Google Drive API"}]},{"text":" under ","type":"text"},{"type":"emphasis","inlineConte