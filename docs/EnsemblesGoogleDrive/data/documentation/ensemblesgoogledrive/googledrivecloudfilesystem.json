ext","text":" "},{"type":"text","text":"ID-based API by walking the folder hierarchy to resolve Ensembles paths"},{"type":"text","text":" "},{"type":"text","text":"(e.g. "},{"type":"codeVoice","code":"ensembleId\/events\/file.json"},{"type":"text","text":") to Google Drive folder and file IDs."}]},{"inlineContent":[{"type":"text","text":"Resolved IDs are cached in internal dictionaries to minimize API calls. The cache"},{"type":"text","text":" "},{"type":"text","text":"is invalidated when items are deleted or when not-found errors indicate stale entries."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Two initialization paths are available:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ Simple: static access token (app manages refresh externally)","let cloudFS = GoogleDriveCloudFileSystem(accessToken: \"your-token\")","","\/\/ Authenticator: auto-refreshes expired tokens","let cloudFS = GoogleDriveCloudFileSystem(authenticator: authenticator)"]},{"text":"Setup","anchor":"Setup","type":"heading","level":2},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Go to the "},{"type":"reference","isActive":true,"identifier":"https:\/\/console.cloud.google.com\/"},{"type":"text","text":" and create a project"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Enable the ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Google Drive API"}]},{"text":" under ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"APIs & Services → Library"}]}]}]},{"content":[{"inlineContent":[{"text":"Create an ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"OAuth 2.0 Client ID"}]},{"type":"text","text":" under "},{"type":"emphasis","inlineContent":[{"type":"text","text":"APIs & Services → Credentials"}]}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"For iOS\/macOS apps, choose “iOS” application type and enter your bundle ID"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Set the redirect URI (typically ","type":"text"},{"code":"com.googleusercontent.apps.YOUR-CLIENT-ID:\/oauthredirect","type":"codeVoice"},{"text":")","type":"text"}]}]}],"type":"unorderedList"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Configure the authenticator and file system:","type":"text"}]}]}],"type":"orderedList"},{"syntax":"swift","type":"codeListing","code":["let config = GoogleDriveAuthenticator.Configuration(","    clientID: \"YOUR-CLIENT-ID.apps.googleusercontent.com\",","    redirectURI: \"com.googleusercontent.apps.YOUR-CLIENT-ID:\/oauthredirect\"",")","let authenticator = GoogleDriveAuthenticator(configuration: config)","try await authenticator.authorize(presenting: window)","","let cloudFS = GoogleDriveCloudFileSystem(authenticator: authenticator)","let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MyStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: cloudFS",")"]},{"inlineContent":[{"text":"The authenticator stores tokens in the Keychain and refreshes them automatically","type":"text"},{"text":" ","type":"text"},{"text":"when they expire. The default scope is ","type":"text"},{"type":"codeVoice","code":"drive.file"},{"text":" (per-file access), which","type":"text"},{"text":" ","type":"text"},{"text":"limits the app to files it creates.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Threading","anchor":"Threading","type":"heading"},{"inlineContent":[{"type":"text","text":"This class is "},{"code":"@unchecked Sendable","type":"codeVoice"},{"type":"text","text":". All network calls go through a shared"},{"type":"text","text":" "},{"code":"URLSession","type":"codeVoice"},{"type":"text","text":" instance, which is thread-safe. Mutable state (caches, "},{"code":"loggedIn","type":"codeVoice"},{"type":"text","text":" flag)"},{"text":" ","type":"text"},{"text"