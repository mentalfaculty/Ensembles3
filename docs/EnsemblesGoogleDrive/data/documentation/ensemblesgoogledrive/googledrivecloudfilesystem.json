[["doc:\/\/EnsemblesGoogleDrive\/documentation\/EnsemblesGoogleDrive"]]},"sections":[],"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/EnsemblesGoogleDrive\/9Ensembles15CloudFileSystemP","doc:\/\/EnsemblesGoogleDrive\/s8SendableP","doc:\/\/EnsemblesGoogleDrive\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships"}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"GoogleDriveCloudFileSystem"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This backend communicates directly with Google’s REST API — no third-party SDK"},{"type":"text","text":" "},{"type":"text","text":"is required. Authentication is handled via an OAuth 2.0 access token passed as"},{"type":"text","text":" "},{"type":"text","text":"a "},{"code":"Bearer","type":"codeVoice"},{"type":"text","text":" header on every request."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Google Drive uses file IDs rather than paths to identify files and folders."},{"type":"text","text":" "},{"type":"text","text":"This backend bridges the path-based "},{"code":"CloudFileSystem","type":"codeVoice"},{"type":"text","text":" protocol onto Google Drive’s"},{"type":"text","text":" "},{"type":"text","text":"ID-based API by walking the folder hierarchy to resolve Ensembles paths"},{"type":"text","text":" "},{"type":"text","text":"(e.g. "},{"code":"ensembleId\/events\/file.json","type":"codeVoice"},{"type":"text","text":") to Google Drive folder and file IDs."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Resolved IDs are cached in internal dictionaries to minimize API calls. The cache"},{"type":"text","text":" "},{"type":"text","text":"is invalidated when items are deleted or when not-found errors indicate stale entries."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Two initialization paths are available:"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Simple: static access token (app manages refresh externally)","let cloudFS = GoogleDriveCloudFileSystem(accessToken: \"your-token\")","","\/\/ Authenticator: auto-refreshes expired tokens","let cloudFS = GoogleDriveCloudFileSystem(authenticator: authenticator)"]},{"level":2,"type":"heading","text":"Setup","anchor":"Setup"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"Go to the ","type":"text"},{"isActive":true,"identifier":"https:\/\/console.cloud.google.com\/","type":"reference"},{"text":" and create a project","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Enable the ","type":"text"},{"inlineContent":[{"text":"Google Drive API","type":"text"}],"type":"strong"},{"text":" under ","type":"text"},{"inlineContent":[{"text":"APIs & Services → Library","type":"text"}],"type":"emphasis"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Create an ","type":"text"},{"inlineContent":[{"text":"OAuth 2.0 Client ID","type":"text"}],"type":"strong"},{"text":" under ","type":"text"},{"inlineContent":[{"text":"APIs & Services → Credentials","type":"text"}],"type":"emphasis"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"For iOS\/macOS apps, choose “iOS” application type and enter your bundle ID"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Set the redirect URI (typically "},{"code":"com.googleusercontent.apps.YOUR-CLIENT-ID:\/oauthredirect","type":"codeVoice"},{"type":"text","text":")"}],"type":"paragraph"}]}]}]},{"content":[{"inlineContent":[{"text":"Configure the authenticator and file system:","type":"text"}],"type":"paragraph"}]}]},{"syntax":"swift","type":"codeListing","code":["let config = GoogleDriveAuthenticator.Configuration(","    clientID: \"YOUR-CLIENT-ID.apps.googleusercontent.com\",","    redirectURI: \"com.googleusercontent.apps.YOUR-CLIENT-ID:\/oauthredirect\"",")","let authenticator = GoogleDriveAuthenticator(configuration: config)","try await authenticator.authorize(presenting: window)","","let cloudFS = GoogleDriveCloudFileSystem(authenticator: authenticator)","let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MyStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: cloudFS",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The authenticator stores tokens in the Keychain and refreshes them automatically"},{"type":"text","text":" "},{"type":"text","text":"when they expire. The default scope is "},{"code":"drive.file","type":"codeVoice"},{"type":"text","text":" (per-file access), which"},{"type":"text","text":" "},{"type":"text","text":"limits the app to files it creates."}]},{"level":2,"type":"heading","text":"Threading","anchor":"Threading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This class is "},{"code":"@unchecked Sendable","type":"codeVoice"},{"type":"text","text":". All network calls go through a shared"},{"type":"text","text":" "},{"code":"URLSession","type":"codeVoice"},{"type":"text","text":" instance, which is thread-safe. Mutable state (caches, "},{"code":"loggedIn","type":"codeVoice"},{"type":"text","text":" flag)"},{"type":"text","text":" "},{"type":"text","text":"is accessed only from async methods that are serialized by the ensemble’s operation queue."}]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/EnsemblesGoogleDrive\/documentation\/EnsemblesGoogleDrive\/GoogleDriveCloudFileSystem"},"abstract":[{"type":"text","text":"A cloud file system backed by the Google Drive REST API v3 using "},{"type":"codeVoice","code":"URLSession"},{"type":"text","text":"."}],"metadata":{"fragments":[{"kind":"keyword