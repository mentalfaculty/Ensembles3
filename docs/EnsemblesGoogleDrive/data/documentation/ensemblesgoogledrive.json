codeVoice","code":"com.googleusercontent.apps.YOUR-CLIENT-ID:\/oauthredirect"}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Code:","type":"text"}]}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import EnsemblesGoogleDrive","","let config = GoogleDriveAuthenticator.Configuration(","    clientID: \"YOUR-CLIENT-ID.apps.googleusercontent.com\",","    redirectURI: \"com.googleusercontent.apps.YOUR-CLIENT-ID:\/oauthredirect\"",")","let authenticator = GoogleDriveAuthenticator(configuration: config)","","\/\/ One-time interactive authorization (presents a web sign-in sheet)","try await authenticator.authorize(presenting: window)","","\/\/ Create the cloud file system","let cloudFS = GoogleDriveCloudFileSystem(authenticator: authenticator)"]},{"type":"paragraph","inlineContent":[{"text":"On subsequent launches, the authenticator restores tokens from the Keychain and refreshes them automatically. Call ","type":"text"},{"code":"authenticator.isAuthorized","type":"codeVoice"},{"type":"text","text":" to check if stored credentials exist."}]},{"inlineContent":[{"type":"text","text":"For apps that manage tokens externally, pass a static access token instead:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let cloudFS = GoogleDriveCloudFileSystem(accessToken: \"your-token\")"]},{"type":"heading","level":3,"anchor":"Setup","text":"Setup"},{"type":"codeListing","syntax":"swift","code":["import Ensembles","import EnsemblesGoogleDrive","","let cloudFS = GoogleDriveCloudFileSystem(authenticator: authenticator)","let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MainStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: cloudFS",")","try await ensemble?.attachPersistentStore()"]},{"type":"heading","level":3,"anchor":"API-Details","text":"API Details"},{"type":"paragraph","inlineContent":[{"text":"The backend uses the Google Drive REST API v3 with the ","type":"text"},{"code":"drive.file","type":"codeVoice"},{"text":" scope, which limits access to files the app creates. Ensembles paths are resolved to Google Drive file IDs via folder traversal, with results cached in memory.","type":"text"}]},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Operation","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Google Drive API","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Connect \/ Identity","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"GET \/about?fields=user","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"File existence","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"GET \/files","type":"codeVoice"},{"text":" (query by name + parent)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Create directory","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"POST \/files","type":"codeVoice"},{"text":" (folder MIME type)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"List directory","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"GET \/files","type":"codeVoice"},{"text":" (query by parent)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Remove item","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"DELETE \/files\/{id}","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Upload","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"POST \/upload\/files","type":"codeVoice"},{"text":" (multipart)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Download","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"GET \/files\/{id}?alt=media","type":"codeVoice"}]}]]],"header":"row"},{"level":3,"type":"heading","text":"Error Handling","anchor":"Error-Handling"},{"type":"paragraph","inlineContent":[{"type":"text","text":"HTT