{"hierarchy":{"paths":[[]]},"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"EnsemblesGoogleDrive provides ","type":"text"},{"isActive":true,"identifier":"doc:\/\/EnsemblesGoogleDrive\/documentation\/EnsemblesGoogleDrive\/GoogleDriveCloudFileSystem","type":"reference"},{"text":", an implementation of the Ensembles ","type":"text"},{"code":"CloudFileSystem","type":"codeVoice"},{"text":" protocol that stores sync data on Google Drive. It communicates directly with the Google Drive REST API v3 using ","type":"text"},{"code":"URLSession","type":"codeVoice"},{"text":" — no third-party SDK required.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Google Drive uses file IDs rather than paths internally. The backend transparently bridges between Ensembles’ path-based "},{"type":"codeVoice","code":"CloudFileSystem"},{"type":"text","text":" protocol and Google Drive’s ID-based system, caching folder and file IDs to minimize API calls."}]},{"type":"heading","text":"Authentication","level":3,"anchor":"Authentication"},{"type":"paragraph","inlineContent":[{"text":"The included ","type":"text"},{"identifier":"doc:\/\/EnsemblesGoogleDrive\/documentation\/EnsemblesGoogleDrive\/GoogleDriveAuthenticator","type":"reference","isActive":true},{"text":" handles the full OAuth 2.0 authorization code flow, stores tokens in the Keychain, and automatically refreshes expired tokens.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Google Cloud Console setup:","type":"text"}]}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Go to ","type":"text"},{"isActive":true,"identifier":"https:\/\/console.cloud.google.com\/","type":"reference"},{"type":"text","text":" and create a project (or select an existing one)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Enable the "},{"type":"strong","inlineContent":[{"text":"Google Drive API","type":"text"}]},{"type":"text","text":" under "},{"type":"emphasis","inlineContent":[{"text":"APIs & Services → Library","type":"text"}]},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Go to "},{"inlineContent":[{"text":"APIs & Services → Credentials","type":"text"}],"type":"emphasis"},{"type":"text","text":" and create an "},{"inlineContent":[{"text":"OAuth 2.0 Client ID","type":"text"}],"type":"strong"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Select "},{"type":"strong","inlineContent":[{"text":"iOS","type":"text"}]},{"type":"text","text":" as the application type and enter your app’s bundle identifier."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Note the ","type":"text"},{"type":"strong","inlineContent":[{"text":"Client ID","type":"text"}]},{"type":"text","text":" (looks like "},{"type":"codeVoice","code":"123456789-abc.apps.googleusercontent.com"},{"type":"text","text":")."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Set the redirect URI to: "},{"type":"codeVoice","code":"com.googleusercontent.apps.YOUR-CLIENT-ID:\/oauthredirect"}]}]}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Code:"}],"type":"strong"}]},{"type":"codeListing","syntax":"swift","code":["import EnsemblesGoogleDrive","","let config = GoogleDriveAuthenticator.Configuration(","    clientID: \"YOUR-CLIENT-ID.apps.googleusercontent.com\",","    redirectURI: \"com.googleusercontent.apps.YOUR-CLIENT-ID:\/oauthredirect\"",")","let authenticator = GoogleDriveAuthenticator(configuration: config)","","\/\/ One-time interactive authorization (presents a web sign-in sheet)","try await authenticator.authorize(presenting: window)","","\/\/ Create the cloud file system","let cloudFS = GoogleDriveCloudFileSystem(authenticator: authenticator)"]},{"type":"paragraph","inlineContent":[{"text":"On subsequent launches, the authenticator restores tokens from the Keychain and refreshes them automatically. Call ","type":"text"},{"code":"authenticator.isAuthorized","type":"codeVoice"},{"type":"text","text":" to check if stored credentials exist."}]},{"type":"paragraph","inlineContent":[{"text":"For apps that manage tokens externally, pass a static access token instead:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let cloudFS = GoogleDriveCloudFileSystem(accessToken: \"your-token\")"]},{"type":"heading","level":3,"anchor":"Setup","text":"Setup"},{"syntax":"swift","type":"codeListing","code":["import Ensembles","import EnsemblesGoogleDrive","","let cloudFS = GoogleDriveCloudFileSystem(authenticator: authenticator)","let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MainStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: cloudFS",")","try await ensemble?.attachPersistentStore()"]},{"type":"heading","level":3,"anchor":"API-Details","text":"API Details"},{"inlineContent":[{"type":"text","text":"The backend uses the Google Drive REST API v3 with the "},{"code":"drive.file","type":"codeVoice"},{"type":"text","text":" scope, which limits access to files the app creates. Ensembles paths are resolved to Google Drive file IDs via folder traversal, with results cached in memory."}],"type":"paragraph"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Operation"}]}],[{"type":"paragraph","inlineContent":[{"text":"Google Drive API","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Connect \/ Identity","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"GET \/about?fields=user"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"File existence","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"GET \/files"},{"