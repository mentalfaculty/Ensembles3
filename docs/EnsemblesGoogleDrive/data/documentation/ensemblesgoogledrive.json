{"sections":[],"kind":"symbol","variants":[{"paths":["\/documentation\/ensemblesgoogledrive"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"topicSections":[{"title":"Cloud File System","identifiers":["doc:\/\/EnsemblesGoogleDrive\/documentation\/EnsemblesGoogleDrive\/GoogleDriveCloudFileSystem","doc:\/\/EnsemblesGoogleDrive\/documentation\/EnsemblesGoogleDrive\/GoogleDriveAuthenticator"],"anchor":"Cloud-File-System"}],"abstract":[{"type":"text","text":"A Google Drive cloud backend for Ensembles."}],"metadata":{"title":"EnsemblesGoogleDrive","modules":[{"name":"EnsemblesGoogleDrive"}],"symbolKind":"module","externalID":"EnsemblesGoogleDrive","role":"collection","roleHeading":"Framework"},"identifier":{"url":"doc:\/\/EnsemblesGoogleDrive\/documentation\/EnsemblesGoogleDrive","interfaceLanguage":"swift"},"hierarchy":{"paths":[[]]},"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"EnsemblesGoogleDrive provides "},{"identifier":"doc:\/\/EnsemblesGoogleDrive\/documentation\/EnsemblesGoogleDrive\/GoogleDriveCloudFileSystem","type":"reference","isActive":true},{"type":"text","text":", an implementation of the Ensembles "},{"type":"codeVoice","code":"CloudFileSystem"},{"type":"text","text":" protocol that stores sync data on Google Drive. It communicates directly with the Google Drive REST API v3 using "},{"type":"codeVoice","code":"URLSession"},{"text":" — no third-party SDK required.","type":"text"}]},{"inlineContent":[{"type":"text","text":"Google Drive uses file IDs rather than paths internally. The backend transparently bridges between Ensembles’ path-based "},{"type":"codeVoice","code":"CloudFileSystem"},{"type":"text","text":" protocol and Google Drive’s ID-based system, caching folder and file IDs to minimize API calls."}],"type":"paragraph"},{"level":3,"type":"heading","anchor":"Authentication","text":"Authentication"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The included "},{"type":"reference","isActive":true,"identifier":"doc:\/\/EnsemblesGoogleDrive\/documentation\/EnsemblesGoogleDrive\/GoogleDriveAuthenticator"},{"type":"text","text":" handles the full OAuth 2.0 authorization code flow, stores tokens in the Keychain, and automatically refreshes expired tokens."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Google Cloud Console setup:"}]}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Go to "},{"identifier":"https:\/\/console.cloud.google.com\/","type":"reference","isActive":true},{"type":"text","text":" and create a project (or select an existing one)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Enable the "},{"inlineContent":[{"type":"text","text":"Google Drive API"}],"type":"strong"},{"type":"text","text":" under "},{"inlineContent":[{"type":"text","text":"APIs & Services → Library"}],"type":"emphasis"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Go to "},{"inlineContent":[{"type":"text","text":"APIs & Services → Credentials"}],"type":"emphasis"},{"type":"text","text":" and create an "},{"inlineContent":[{"type":"text","text":"OAuth 2.0 Client ID"}],"type":"strong"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Select "},{"inlineContent":[{"type":"text","text":"iOS"}],"type":"strong"},{"type":"text","text":" as the application type and enter your app’s bundle identifier."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Note the "},{"inlineContent":[{"type":"text","text":"Client ID"}],"type":"strong"},{"type":"text","text":" (looks like "},{"type":"codeVoice","code":"123456789-abc.apps.googleusercontent.com"},{"type":"text","text":")."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Set the redirect URI to: "},{"type":"codeVoice","code":"com.googleusercontent.apps.YOUR-CLIENT-ID:\/oauthredirect"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Code:","type":"text"}]}]},{"code":["import EnsemblesGoogleDrive","","let config = GoogleDriveAuthenticator.Configuration(","    clientID: \"YOUR-CLIENT-ID.apps.googleusercontent.com\",","    redirectURI: \"com.googleusercontent.apps.YOUR-CLIENT-ID:\/oauthredirect\"",")","let authenticator = GoogleDriveAuthenticator(configuration: config)","","\/\/ One-time interactive authorization (presents a web sign-in sheet)","try await authenticator.authorize(presenting: window)","","\/\/ Create the cloud file system","let cloudFS = GoogleDriveCloudFileSystem(authenticator: authenticator)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"On subsequent launches, the authenticator restores tokens from the Keychain and refreshes them automatically. Call ","type":"text"},{"type":"codeVoice","code":"authenticator.isAuthorized"},{"text":" to check if stored credentials exist.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For apps that manage tokens externally, pass a static access token instead:","type":"text"}]},{"code":["let cloudFS = GoogleDriveCloudFileSystem(accessToken: \"your-token\")"],"type":"codeListing","syntax":"swift"},{"anchor":"Setup","type":"heading","level":3,"text":"Setup"},{"code":["import Ensembles","import EnsemblesGoogleDrive","","let cloudFS = GoogleDriveCloudFileSystem(authenticator: authenticator)","let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MainStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: cloudFS",")","try await ensemble?.attachPersistentStore()"],"type":"codeListing","syntax":"swift"},{"anchor":"API-Details","type":"heading","level":3,"text":"API Details"},{"type":"paragraph","inlineContent":[{"text":"The backend uses the Google Drive REST API v3 with the ","type":"text"},{"type":"codeVoice","code":"drive.file"},{"text":" scope, which limits access to files the app creates. Ensembles paths are resolved to Google Drive file IDs via folder traversal, with results cached in memory.","type":"text"}]},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"text":"Operation","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Google Drive API"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Connect \/ Identity"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"GET \/about?fields=user"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"File existence","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"GET \/files"},{"text":" (query by name + parent)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Create directory"}],"type":"paragraph"}],[{"inlineContent":[{"code":"POST \/files","type":"codeVoice"},{"type":"text","text":" (folder MIME type)"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"List directory","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"GET \/files","type":"codeVoice"},{"text":" (query by parent)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Remove item","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"DELETE \/files\/{id}","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Upload","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"POST \/upload\/files","type":"codeVoice"},{"text":" (multipart)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Download","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"GET \/files\/{id}?alt=media","type":"codeVoice"}],"type":"paragraph"}]]]},{"anchor":"Error-Handling","type":"heading","level":3,"text":"Error Handling"},{"type":"paragraph","inlineContent":[{"type":"text","text":"HTTP errors are mapped to "},{"type":"codeVoice","code":"EnsembleError"},{"type":"text","text":" cases:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"401 Unauthorized"}],"type":"strong"},{"type":"text","text":" maps to "},{"type":"codeVoice","code":"EnsembleError.authenticationFailure"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"404 Not Found"}],"type":"strong"},{"type":"text","text":" maps to "},{"type":"codeVoice","code":"EnsembleError.fileAccessFailed"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Other HTTP errors map to "},{"type":"codeVoice","code":"EnsembleError.serverError"},{"type":"text","text":"."}],"type":"paragraph"}]}]},{"anchor":"Dependencies","type":"heading","level":3,"text":"Dependencies"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This module has "},{"inlineContent":[{"text":"no external dependencies","type":"text"}],"type":"strong"},{"type":"text","text":" beyond Foundation and the core "},{"type":"codeVoice","code":"Ensembles"},{"type":"text","text":" framework. All network communication uses "},{"type":"codeVoice","code":"URLSession"},{"type":"text","text":"."}]}]}],"references":{"doc://EnsemblesGoogleDrive/documentation/EnsemblesGoogleDrive/GoogleDriveAuthenticator":{"role":"symbol","kind":"symbol","abstract":[{"text":"Manages OAuth 2.0 authentication for Google Drive.","type":"text"}],"title":"GoogleDriveAuthenticator","url":"\/documentation\/ensemblesgoogledrive\/googledriveauthenticator","type":"topic","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GoogleDriveAuthenticator","kind":"identifier"}],"navigatorTitle":[{"text":"GoogleDriveAuthenticator","kind":"identifier"}],"identifier":"doc:\/\/EnsemblesGoogleDrive\/documentation\/Ensembl