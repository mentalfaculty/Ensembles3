{"hierarchy":{"paths":[[]]},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"EnsemblesGoogleDrive provides ","type":"text"},{"isActive":true,"identifier":"doc:\/\/EnsemblesGoogleDrive\/documentation\/EnsemblesGoogleDrive\/GoogleDriveCloudFileSystem","type":"reference"},{"type":"text","text":", an implementation of the Ensembles "},{"code":"CloudFileSystem","type":"codeVoice"},{"type":"text","text":" protocol that stores sync data on Google Drive. It communicates directly with the Google Drive REST API v3 using "},{"type":"codeVoice","code":"URLSession"},{"type":"text","text":" — no third-party SDK required."}]},{"inlineContent":[{"type":"text","text":"Google Drive uses file IDs rather than paths internally. The backend transparently bridges between Ensembles’ path-based "},{"code":"CloudFileSystem","type":"codeVoice"},{"type":"text","text":" protocol and Google Drive’s ID-based system, caching folder and file IDs to minimize API calls."}],"type":"paragraph"},{"level":3,"anchor":"Authentication","type":"heading","text":"Authentication"},{"inlineContent":[{"type":"text","text":"The included "},{"type":"reference","identifier":"doc:\/\/EnsemblesGoogleDrive\/documentation\/EnsemblesGoogleDrive\/GoogleDriveAuthenticator","isActive":true},{"type":"text","text":" handles the full OAuth 2.0 authorization code flow, stores tokens in the Keychain, and automatically refreshes expired tokens."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Google Cloud Console setup:"}],"type":"strong"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Go to "},{"type":"reference","identifier":"https:\/\/console.cloud.google.com\/","isActive":true},{"type":"text","text":" and create a project (or select an existing one)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Enable the "},{"type":"strong","inlineContent":[{"type":"text","text":"Google Drive API"}]},{"type":"text","text":" under "},{"type":"emphasis","inlineContent":[{"type":"text","text":"APIs & Services → Library"}]},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Go to "},{"type":"emphasis","inlineContent":[{"type":"text","text":"APIs & Services → Credentials"}]},{"type":"text","text":" and create an "},{"type":"strong","inlineContent":[{"type":"text","text":"OAuth 2.0 Client ID"}]},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Select "},{"type":"strong","inlineContent":[{"type":"text","text":"iOS"}]},{"type":"text","text":" as the application type and enter your app’s bundle identifier."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Note the "},{"type":"strong","inlineContent":[{"type":"text","text":"Client ID"}]},{"type":"text","text":" (looks like "},{"type":"codeVoice","code":"123456789-abc.apps.googleusercontent.com"},{"type":"text","text":")."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Set the redirect URI to: "},{"type":"codeVoice","code":"com.googleusercontent.apps.YOUR-CLIENT-ID:\/oauthredirect"}]}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Code:"}]}]},{"syntax":"swift","type":"codeListing","code":["import EnsemblesGoogleDrive","","let config = GoogleDriveAuthenticator.Configuration(","    clientID: \"YOUR-CLIENT-ID.apps.googleusercontent.com\",","    redirectURI: \"com.googleusercontent.apps.YOUR-CLIENT-ID:\/oauthredirect\"",")","let authenticator = GoogleDriveAuthenticator(configuration: config)","","\/\/ One-time interactive authorization (presents a web sign-in sheet)","try await authenticator.authorize(presenting: window)","","\/\/ Create the cloud file system","let cloudFS = GoogleDriveCloudFileSystem(authenticator: authenticator)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"On subsequent launches, the authenticator restores tokens from the Keychain and refreshes them automatically. Call "},{"code":"authenticator.isAuthorized","type":"codeVoice"},{"type":"text","text":" to check if stored credentials exist."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For apps that manage tokens externally, pass a static access token instead:"}]},{"syntax":"swift","type":"codeListing","code":["let cloudFS = GoogleDriveCloudFileSystem(accessToken: \"your-token\")"]},{"type":"heading","level":3,"text":"Setup","anchor":"Setup"},{"syntax":"swift","type":"codeListing","code":["import Ensembles","import EnsemblesGoogleDrive","","let cloudFS = GoogleDriveCloudFileSystem(authenticator: authenticator)","let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MainStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: cloudFS",")","try await ensemble?.attachPersistentStore()"]},{"type":"heading","level":3,"text":"API Details","anchor":"API-Details"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The backend uses the Google Drive REST API v3 with the "},{"code":"drive.file","type":"codeVoice"},{"type":"text","text":" scope, which limits access to files the app creates. Ensembles paths are resolved to Google Drive file IDs via folder traversal, with results cached in memory."}]},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Operation"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Google Drive API"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Connect \/ Identity"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"GET \/about?fields=user"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"File existence"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"GET \/files"},{"type":"text","text":" (query by name + parent)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Create directory"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"POST \/files"},{"type":"text","text":" (folder MIME type)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"List directory"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"GET \/files"},{"type":"text","text":" (query by parent)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Remove item"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"DELETE \/files\/{id}"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Upload"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"POST \/upload\/files"},{"type":"text","text":" (multipart)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Download"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"GET \/files\/{id}?alt=media"}]}]]],"header":"row"},{"type":"heading","level":3,"text":"Error Handling","anchor":"Error-Handling"},{"type":"paragraph","inlineContent":[{"type":"text","text":"HTTP errors are mapped to "},{"code":"EnsembleError","type":"codeVoice"},{"type":"text","text":" cases:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"401 Unauthorized","type":"text"}],"type":"strong"},{"type":"text","text":" maps to "},{"code":"EnsembleError.authenticationFailure","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"404 Not Found","type":"text"}],"type":"strong"},{"type":"text","text":" maps to "},{"code":"EnsembleError.fileAccessFailed","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Other HTTP errors map to "},{"code":"EnsembleError.serverError","type":"codeVoice"},{"type":"text","text":"."}]}]}]},{"type":"heading","level":3,"text":"Dependencies","anchor":"Dependencies"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This module has "},{"type":"strong","inlineContent":[{"type":"text","text":"no external dependencies"}]},{"type":"text","text":" beyond Foundation and the core "},{"code":"Ensembles","type":"codeVoice"},{"type":"text","text":" framework. All network communication uses "},{"code":"URLSession","type":"codeVoice"},{"type":"text","text":"."}]}]}],"variants":[{"paths":["\/documentation\/ensemblesgoogledrive"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/EnsemblesGoogleDrive\/documentation\/EnsemblesGoogleDrive"},"kind":"symbol","sections":[],"metadata":{"role":"collection","externalID":"EnsemblesGoogleDrive","modules":[{"name":"EnsemblesGoogleDrive"}],"symbolKind":"module","roleHeading":"Framework","title":"EnsemblesGoogleDrive"},"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"text":"A Google Drive cloud backend for Ensembles.","type":"text"}],"topicSections":[{"anchor":"Cloud-File-System","identifiers":["doc:\/\/EnsemblesGoogleDrive\/documentation\/EnsemblesGoogleDrive\/GoogleDriveCloudFileSystem","doc:\/\/EnsemblesGoogleDrive\/documentation\/EnsemblesGoogleDrive\/GoogleDriveAuthenticator"],"title":"Cloud File System"}],"references":{"doc://EnsemblesGoogleDrive/documentation/EnsemblesGoogleDrive":{"identifier":"doc:\/\/EnsemblesGoogleDrive\/documentation\/EnsemblesGoogleDrive","abstract":[{"text":"A Google Drive cloud backend for Ensembles.","type":"text"}],"kind":"symbol","url":"\/documentation\/ensemblesgoogledrive","type":"topic","title":"EnsemblesGoogleDrive","role":"collection"},"doc://EnsemblesGoogleDrive/documentation/EnsemblesGoogleDrive/GoogleDriveCloudFileSystem":{"identifier":"doc:\/\/EnsemblesGoogleDrive\/documentation\/EnsemblesGoogleDrive\/GoogleDriveCloudFileSystem","title":"GoogleDriveCloudFileSystem","role":"sy