tent":[{"inlineContent":[{"text":"Set the redirect URI to: ","type":"text"},{"code":"com.googleusercontent.apps.YOUR-CLIENT-ID:\/oauthredirect","type":"codeVoice"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Code:","type":"text"}]}],"type":"paragraph"},{"type":"codeListing","code":["import EnsemblesGoogleDrive","","let config = GoogleDriveAuthenticator.Configuration(","    clientID: \"YOUR-CLIENT-ID.apps.googleusercontent.com\",","    redirectURI: \"com.googleusercontent.apps.YOUR-CLIENT-ID:\/oauthredirect\"",")","let authenticator = GoogleDriveAuthenticator(configuration: config)","","\/\/ One-time interactive authorization (presents a web sign-in sheet)","try await authenticator.authorize(presenting: window)","","\/\/ Create the cloud file system","let cloudFS = GoogleDriveCloudFileSystem(authenticator: authenticator)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"On subsequent launches, the authenticator restores tokens from the Keychain and refreshes them automatically. Call "},{"type":"codeVoice","code":"authenticator.isAuthorized"},{"type":"text","text":" to check if stored credentials exist."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For apps that manage tokens externally, pass a static access token instead:"}]},{"type":"codeListing","code":["let cloudFS = GoogleDriveCloudFileSystem(accessToken: \"your-token\")"],"syntax":"swift"},{"type":"heading","level":3,"anchor":"Setup","text":"Setup"},{"type":"codeListing","code":["import Ensembles","import EnsemblesGoogleDrive","","let cloudFS = GoogleDriveCloudFileSystem(authenticator: authenticator)","let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MainStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: cloudFS",")","try await ensemble?.attachPersistentStore()"],"syntax":"swift"},{"type":"heading","level":3,"anchor":"API-Details","text":"API Details"},{"ty