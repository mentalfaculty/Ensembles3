{"abstract":[{"text":"Assume that the current task is executing on this actor’s serial executor,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"or stop program execution otherwise."}],"hierarchy":{"paths":[["doc:\/\/EnsemblesMemory\/documentation\/EnsemblesMemory","doc:\/\/EnsemblesMemory\/documentation\/EnsemblesMemory\/MemoryCloudFileSystem"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"nonisolated","kind":"attribute"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"assumeIsolated","kind":"identifier"},{"text":"<","kind":"text"},{"text":"T","kind":"genericParameter"},{"text":">(","kind":"text"},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"operation"},{"kind":"text","text":": ("},{"kind":"keyword","text":"isolated"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"T"},{"kind":"text","text":", "},{"kind":"externalParam","text":"file"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"StaticString","preciseIdentifier":"s:s12StaticStringV"},{"kind":"text","text":" = "},{"kind":"keyword","text":"#fileID"},{"kind":"text","text":", "},{"kind":"externalParam","text":"line"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"UInt","preciseIdentifier":"s:Su"},{"kind":"text","text":" = "},{"kind":"keyword","text":"#line"},{"kind":"text","text":") "},{"kind":"keyword","text":"rethrows"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"T"},{"kind":"text","text":" "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"T"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Sendable","preciseIdentifier":"s:s8SendableP"}],"platforms":["macOS"]}]},{"kind":"parameters","parameters":[{"name":"operation","content":[{"type":"paragraph","inlineContent":[{"text":"The operation that will be executed if the current context","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"is executing on the actors serial executor."}]}]},{"name":"file","content":[{"inlineContent":[{"text":"The file name to print if the assertion fails. The default is","type":"text"},{"type":"text","text":" "},{"text":"where this method was called.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The line number to print if the assertion fails The default is"},{"type":"text","text":" "},{"type":"text","text":"where this method was called."}]}],"name":"line"}]},{"kind":"content","content":[{"text":"Return Value","type":"heading","anchor":"return-value","level":2},{"type":"paragraph","inlineContent":[{"text":"The return value of the ","type":"text"},{"type":"codeVoice","code":"operation"}]}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"You call this method to "},{"type":"emphasis","inlineContent":[{"type":"text","text":"assume and verify"}]},{"type":"text","text":" that the currently"},{"type":"text","text":" "},{"type":"text","text":"executing synchronous function is actually executing on the serial"},{"type":"text","text":" "},{"type":"text","text":"executor of this actor."}]},{"type":"paragraph","inlineContent":[{"text":"If that is the case, the operation is invoked with an ","type":"text"},{"type":"codeVoice","code":"isolated"},{"type":"text","text":" version"},{"type":"text","text":" "},{"text":"of the actor, allowing synchronous access to actor local state without","type":"text"},{"text":" ","type":"text"},{"text":"hopping through asynchronous boundaries.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the current context is not running on the actor’s serial executor, or"},{"text":" ","type":"text"},{"type":"text","text":"if the actor is a reference to a remote actor, this method will crash"},{"text":" ","type":"text"},{"text":"with a fatal error (similar to ","type":"text"},{"type":"codeVoice","code":"preconditionIsolated()"},{"text":").","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note that this check is performed against the passed in actor’s serial"},{"text":" ","type":"text"},{"type":"text","text":"executor, meaning that if another actor uses the same serial executor–by"},{"text":" ","type":"text"},{"text":"using that actor’s ","type":"text"},{"type":"codeVoice","code":"Actor\/unownedExecutor"},{"text":" as its own","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"Actor\/unownedExecutor"},{"text":"–this check will succeed, as from a concurrency","type":"text"},{"type":"text","text":" "},{"type":"text","text":"safety perspective, the serial executor guarantees mutual exclusion of"},{"type":"text","text":" "},{"type":"text","text":"those two actors."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This method can only be used from synchronous functions, as asynchronous"},{"type":"text","text":" "},{"type":"text","text":"functions should instead perform a normal method call to the actor, which"},{"type":"text","text":" "},{"type":"text","text":"will hop task execution to the target actor if necessary."}]},{"style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"This check is performed against the actor’s serial executor,","type":"text"},{"type":"text","text":" "},{"text":"meaning that \/ if another actor uses the same serial executor–by using","type":"text"},{"type":"text","text":" "},{"text":"another actor’s executor as its own ","type":"text"},{"type":"codeVoice","code":"Actor\/unownedExecutor"},{"text":" ","type":"text"},{"text":"–this check will succeed , as from a concurrency safety perspective,","type":"text"},{"text":" ","type":"text"},{"text":"the serial executor guarantees mutual exclusion of those two actors.","type":"text"}]}],"name":"Note"},{"style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"Rethrows the ","type":"text"},{"type":"codeVoice","code":"Error"},{"text":" thrown by the operation if it threw","type":"text"}]}],"name":"Throws"}]}],"sections":[],"metadata":{"externalID":"s:ScA12_ConcurrencyE14assumeIsolated_4file4lineqd__qd__xYiKXE_s12StaticStringVSutKs8SendableRd__lF::SYNTHESIZED::s:15EnsemblesMemory0B15CloudFileSystemC","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"assumeIsolated","kind":"identifier"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"T"},{"kind":"text","text":">(("},{"kind":"keyword","text":"isolated"},{"text":" ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"T"},{"text":", ","kind":"text"},{"kind":"externalParam","text":"file"},{"text":": ","kind":"text"},{"text":"StaticString","kind":"typeIdentifier","preciseIdentifier":"s:s12StaticStringV"},{"text":", ","kind":"text"},{"text":"line","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"UInt","kind":"typeIdentifier","preciseIdentifier":"s:Su"},{"text":") ","kind":"text"},{"text":"rethrows","kind":"keyword"},{"text":" -> ","kind":"text"},{"kind":"typeIdentifier","text":"T"}],"title":"assumeIsolated(_:file:line:)","role":"symbol","extendedModule":"_Concurrency","symbolKind":"method","modules":[{"relatedModules":["_Concurrency"],"name":"EnsemblesMemory"}],"platforms":[{"deprecated":false,"name":"iOS","beta":false,"unavailable":false,"introducedAt":"13.0"},{"introducedAt":"10.15","name":"macOS","unavailable":false,"beta":false,"deprecated":false},{"name":"tvOS","introducedAt":"13.0","unavailable":false,"beta":false,"deprecated":false},{"introducedAt":"6.0","beta":fal