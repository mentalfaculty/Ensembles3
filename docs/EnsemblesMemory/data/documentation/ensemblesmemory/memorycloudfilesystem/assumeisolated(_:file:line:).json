 will succeed , as from a concurrency safety perspective,"},{"type":"text","text":" "},{"type":"text","text":"the serial executor guarantees mutual exclusion of those two actors."}],"type":"paragraph"}],"name":"Note","type":"aside"},{"type":"aside","name":"Throws","style":"note","content":[{"inlineContent":[{"text":"Rethrows the ","type":"text"},{"code":"Error","type":"codeVoice"},{"text":" thrown by the operation if it threw","type":"text"}],"type":"paragraph"}]}]}],"references":{"doc://EnsemblesMemory/documentation/EnsemblesMemory/MemoryCloudFileSystem/assumeIsolated(_:file:line:)":{"kind":"symbol","abstract":[{"type":"text","text":"Assume that the current task is executing on this actor’s serial executor,"},{"type":"text","text":" "},{"type":"text","text":"or stop program execution otherwise."}],"title":"assumeIsolated(_:file:line:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"assumeIsolated"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"T"},{"kind":"text","text":">(("},{"kind":"keyword","text":"isolated"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"T"},{"kind":"text","text":", "},{"kind":"externalParam","text":"file"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:s12StaticStringV","text":"StaticString"},{"kind":"text","text":", "},{"kind":"externalParam","text":"line"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Su","text":"UInt"},{"kind":"text","text":") "},{"kind":"keyword","text":"rethrows"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"T"}],"type":"topic","identifier":"doc:\/\/EnsemblesMemory\/documentation\/EnsemblesMemory\/MemoryCloudFileSystem\/assumeIsolated(_:file:line:)","url":"\/documentation\/ensemblesmemory\/memorycloudfilesystem\/assumeisolated(_:file