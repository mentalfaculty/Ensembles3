{"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"Assume that the current task is executing on this actor’s serial executor,"},{"type":"text","text":" "},{"type":"text","text":"or stop program execution otherwise."}],"kind":"symbol","metadata":{"externalID":"s:ScA12_ConcurrencyE14assumeIsolated_4file4lineqd__qd__xYiKXE_s12StaticStringVSutKs8SendableRd__lF::SYNTHESIZED::s:15EnsemblesMemory0B15CloudFileSystemC","roleHeading":"Instance Method","fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"assumeIsolated"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"T"},{"kind":"text","text":">(("},{"text":"isolated","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"typeIdentifier","text":"Self"},{"text":") ","kind":"text"},{"kind":"keyword","text":"throws"},{"text":" -> ","kind":"text"},{"kind":"typeIdentifier","text":"T"},{"kind":"text","text":", "},{"kind":"externalParam","text":"file"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:s12StaticStringV","text":"StaticString","kind":"typeIdentifier"},{"kind":"text","text":", "},{"kind":"externalParam","text":"line"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Su","kind":"typeIdentifier","text":"UInt"},{"kind":"text","text":") "},{"kind":"keyword","text":"rethrows"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"T"}],"role":"symbol","platforms":[{"introducedAt":"13.0","deprecated":false,"unavailable":false,"beta":false,"name":"iOS"},{"introducedAt":"10.15","deprecated":false,"unavailable":false,"beta":false,"name":"macOS"},{"beta":false,"name":"tvOS","introducedAt":"13.0","deprecated":false,"unavailable":false},{"deprecated":false,"beta":false,"name":"watchOS","introducedAt":"6.0","unavailable":false}],"extendedModule":"_Concurrency","symbolKind":"method","modules":[{"relatedModules":["_Concurrency"],"name":"EnsemblesMemory"}],"title":"assumeIsolated(_:file:line:)"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"attribute","text":"nonisolated"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"assumeIsolated","kind":"identifier"},{"kind":"text","text":"<"},{"text":"T","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"operation","kind":"internalParam"},{"text":": (","kind":"text"},{"text":"isolated","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"file","kind":"externalParam"},{"kind":"text","text":": "},{"text":"StaticString","preciseIdentifier":"s:s12StaticStringV","kind":"typeIdentifier"},{"kind":"text","text":" = "},{"text":"#fileID","kind":"keyword"},{"text":", ","kind":"text"},{"text":"line","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Su","kind":"typeIdentifier","text":"UInt"},{"text":" = ","kind":"text"},{"kind":"keyword","text":"#line"},{"text":") ","kind":"text"},{"kind":"keyword","text":"rethrows"},{"text":" -> ","kind":"text"},{"kind":"typeIdentifier","text":"T"},{"kind":"text","text":" "},{"kind":"keyword","text":"where"},{"text":" ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"kind":"text","text":" : "},{"text":"Sendable","preciseIdentifier":"s:s8SendableP","kind":"typeIdentifier"}],"languages":["swift"]}]},{"parameters":[{"content":[{"inlineContent":[{"text":"The operation that will be executed if the current context","type":"text"},{"type":"text","text":" "},{"type":"text","text":"is executing on the actors serial executor."}],"type":"paragraph"}],"name":"operation"},{"content":[{"inlineContent":[{"type":"text","text":"The file name to print if the assertion fails. The default is"},{"type":"text","text":" "},{"type":"text","text":"where this method was called."}],"type":"paragraph"}],"name":"file"},{"content":[{"inlineContent":[{"text":"The line number to print if the assertion fails The default is","type":"text"},{"text":" ","type":"text"},{"text":"where this method was called.","type":"text"}],"type":"paragraph"}],"name":"line"}],"kind":"parameters"},{"kind":"content","content":[{"text":"Return Value","anchor":"return-value","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"The return value of the ","type":"text"},{"code":"operation","type":"codeVoice"}]}]},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"inlineContent":[{"text":"You call this method to ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"assume and verify","type":"text"}]},{"text":" that the currently","type":"text"},{"type":"text","text":" "},{"type":"text","text":"executing synchronous function is actually executing on the serial"},{"text":" ","type":"text"},{"text":"executor of this actor.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If that is the case, the operation is invoked with an ","type":"text"},{"type":"codeVoice","code":"isolated"},{"text":" version","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"of the actor, allowing synchronous access to actor local state without"},{"type":"text","text":" "},{"text":"hopping through asynchronous boundaries.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"If the current context is not running on the actor’s serial executor, or","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"if the actor is a reference to a remote actor, this method will crash"},{"text":" ","type":"text"},{"type":"text","text":"with a fatal error (similar to "},{"code":"preconditionIsolated()","type":"codeVoice"},{"text":").","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note that this check is performed against the passed in actor’s serial"},{"type":"text","text":" "},{"text":"executor, meaning that if another actor uses the same serial executor–by","type":"text"},{"type":"text","text":" "},{"type":"text","text":"using that actor’s "},{"code":"Actor\/unownedExecutor","type":"codeVoice"},{"type":"text","text":" as its own"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Actor\/unownedExecutor"},{"type":"text","text":"–this check will succeed, as from a concurrency"},{"type":"text","text":" "},{"type":"text","text":"safety perspective, the serial executor guarantees mutual exclusion of"},{"type":"text","text":" "},{"type":"text","text":"those two actors."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This method can only be used from synchronous functions, as asynchronous"},{"type":"text","text":" "},{"type":"text","text":"functions should instead perform a normal method call to the actor, which"},{"type":"text","text":" "},{"type":"text","text":"will hop task execution to the target actor if necessary."}]},{"name":"Note","content":[{"inlineContent":[{"type":"text","text":"This check is performed against the actor’s serial executor,"},{"text":" ","type":"text"},{"type":"text","text":"meaning that \/ if another actor uses the same serial executor–by using"},{"text":" ","type":"text"},{"type":"text","text":"another actor’s executor as its own "},{"code":"Actor\/unownedExecutor","type":"codeVoice"},{"text":" ","type":"text"},{"text":"–this check will succeed , as from a concurrency safety perspective,","type":"text"},{"type":"text","text":" "},{"text":"the serial executor guarantees mutual exclusion of those two actors.","type":"text"}],"type":"paragraph"}],"type":"aside","style":"note"},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":"Rethrows the "},{"type":"codeVoice","code":"Error"},{"text":" thrown by the operation if it threw","type":"text"}],"type":"paragraph"}],"style":"note","name":"Throws"}],"kind":"content"}],"variants":[{"paths":