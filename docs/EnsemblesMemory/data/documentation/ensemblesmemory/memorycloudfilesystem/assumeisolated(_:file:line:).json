r","preciseIdentifier":"s:s8SendableP","text":"Sendable"}]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The operation that will be executed if the current context"},{"type":"text","text":" "},{"type":"text","text":"is executing on the actors serial executor."}],"type":"paragraph"}],"name":"operation"},{"content":[{"inlineContent":[{"type":"text","text":"The file name to print if the assertion fails. The default is"},{"type":"text","text":" "},{"type":"text","text":"where this method was called."}],"type":"paragraph"}],"name":"file"},{"content":[{"inlineContent":[{"type":"text","text":"The line number to print if the assertion fails The default is"},{"type":"text","text":" "},{"type":"text","text":"where this method was called."}],"type":"paragraph"}],"name":"line"}]},{"content":[{"level":2,"anchor":"return-value","type":"heading","text":"Return Value"},{"type":"paragraph","inlineContent":[{"text":"The return value of the ","type":"text"},{"code":"operation","type":"codeVoice"}]}],"kind":"content"},{"content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"You call this method to ","type":"text"},{"inlineContent":[{"type":"text","text":"assume and verify"}],"type":"emphasis"},{"text":" that the currently","type":"text"},{"text":" ","type":"text"},{"text":"executing synchronous function is actually executing on the serial","type":"text"},{"text":" ","type":"text"},{"text":"executor of this actor.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If that is the case, the operation is invoked with an ","type":"text"},{"code":"isolated","type":"codeVoice"},{"text":" version","type":"text"},{"text":" ","type":"text"},{"text":"of the actor, allowing synchronous access to actor local state without","type":"text"},{"text":" ","type":"text"},{"text":"hopping through asynchronous boundaries.","type":"text"}]},{"type":"paragraph","inlineContent":[{"t