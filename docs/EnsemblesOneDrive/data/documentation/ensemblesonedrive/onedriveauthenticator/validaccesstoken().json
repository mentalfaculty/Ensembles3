":"heading"},{"inlineContent":[{"text":"Token refresh is single-flight: when the cached token is expired,","type":"text"},{"text":" ","type":"text"},{"text":"concurrent callers join one in-flight refresh ","type":"text"},{"code":"Task","type":"codeVoice"},{"text":" rather than","type":"text"},{"text":" ","type":"text"},{"text":"each firing their own ","type":"text"},{"code":"\/token","type":"codeVoice"},{"text":" request. Microsoft Graph rotates the","type":"text"},{"text":" ","type":"text"},{"text":"refresh token on every refresh, so two parallel refreshes can race —","type":"text"},{"text":" ","type":"text"},{"text":"the first response invalidates the refresh token sent in the second,","type":"text"},{"type":"text","text":" "},{"text":"leaving the credential broken on the next call.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://EnsemblesOneDrive/documentation/EnsemblesOneDrive/OneDriveAuthenticator/validAccessToken()":{"abstract":[{"type":"text","text":"Returns a valid access token, refreshing if expired."},{"text":" ","type":"text"},{"type":"text","text":"Called by "},{"identifier":"doc:\/\/EnsemblesOneDrive\/documentation\/EnsemblesOneDrive\/OneDriveCloudFileSystem","isActive":true,"type":"reference"},{"type":"text","text":" before each API request."}],"url":"\/documentation\/ensemblesonedrive\/onedriveauthenticator\/validaccesstoken()","title":"validAccessToken()","identifier":"doc:\/\/EnsemblesOneDrive\/documentation\/EnsemblesOneDrive\/OneDriveAuthenticator\/validAccessToken()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"validAccessToken"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"}],"type":"topic","role":"symbol","kind":"symbol"},"doc://EnsemblesOneDrive/documentation/EnsemblesOneDrive/OneDriv