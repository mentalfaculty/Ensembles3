":"heading"},{"inlineContent":[{"type":"text","text":"Token refresh is single-flight: when the cached token is expired,"},{"text":" ","type":"text"},{"text":"concurrent callers join one in-flight refresh ","type":"text"},{"code":"Task","type":"codeVoice"},{"text":" rather than","type":"text"},{"text":" ","type":"text"},{"text":"each firing their own ","type":"text"},{"code":"\/token","type":"codeVoice"},{"text":" request. Microsoft Graph rotates the","type":"text"},{"text":" ","type":"text"},{"text":"refresh token on every refresh, so two parallel refreshes can race —","type":"text"},{"text":" ","type":"text"},{"text":"the first response invalidates the refresh token sent in the second,","type":"text"},{"text":" ","type":"text"},{"text":"leaving the credential broken on the next call.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://EnsemblesOneDrive/documentation/EnsemblesOneDrive":{"role":"collection","title":"EnsemblesOneDrive","identifier":"doc:\/\/EnsemblesOneDrive\/documentation\/EnsemblesOneDrive","type":"topic","abstract":[{"type":"text","text":"A Microsoft OneDrive cloud backend for Ensembles."}],"kind":"symbol","url":"\/documentation\/ensemblesonedrive"},"doc://EnsemblesOneDrive/documentation/EnsemblesOneDrive/OneDriveAuthenticator":{"role":"symbol","abstract":[{"type":"text","text":"Manages OAuth 2.0 authentication for Microsoft OneDrive via Microsoft Identity Platform."}],"title":"OneDriveAuthenticator","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OneDriveAuthenticator","kind":"identifier"}],"url":"\/documentation\/ensemblesonedrive\/onedriveauthenticator","navigatorTitle":[{"kind":"identifier","text":"OneDriveAuthenticator"}],"identifier":"doc:\/\/EnsemblesOneDrive\/documentation\/EnsemblesOneDrive\/OneDriveAuthenticator","kind":"symbol","type":"topic"},"doc://EnsemblesOneDrive/documentation/EnsemblesOneDrive/OneDriveCloudFileSystem":{"type":"topic","navigatorTitle":[{"text":"OneDriveClo