ive paths without any ID resolution or caching — similar to the pCloud backend."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Two initialization paths are available:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ Simple: static access token (app manages refresh externally)","let cloudFS = OneDriveCloudFileSystem(accessToken: \"your-token\")","","\/\/ Authenticator: auto-refreshes expired tokens","let cloudFS = OneDriveCloudFileSystem(authenticator: authenticator)"]},{"anchor":"Setup","type":"heading","level":2,"text":"Setup"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Register an app in the "},{"isActive":true,"type":"reference","identifier":"https:\/\/portal.azure.com\/"},{"type":"text","text":" under"},{"type":"text","text":" "},{"inlineContent":[{"type":"text","text":"Azure Active Directory → App registrations → New registration"}],"type":"emphasis"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Under "},{"inlineContent":[{"type":"text","text":"Authentication"}],"type":"emphasis"},{"type":"text","text":", add a platform: "},{"inlineContent":[{"type":"text","text":"Mobile and desktop applications"}],"type":"strong"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Set the redirect URI (e.g. "},{"type":"codeVoice","code":"msauth.com.yourapp:\/\/auth"},{"type":"text","text":")"}]}]}],"type":"unorderedList"}]},{"content":[{"inlineContent":[{"type":"text","text":"Note the "},{"inlineContent":[{"type":"text","text":"Application (client) ID"}],"type":"strong"},{"type":"text","text":" from the overview page"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Configure the authenticator and file system:"}],"type":"paragraph"}]}]},{"type":"codeListing","syntax":"swift","code":["let config = OneDriveAuthenticator.Configuration(","    clientID: \"your-app-client-id\",","    redirectURI: \"msauth.com.yourapp:\/\/auth\"",")","let authenticator = OneDriveAuthenticator(configuration: config)","try await authenticator.authorize(presenting: window)","","let cloudFS = OneDriveCloudFileSystem(authenticator: authenticator)","let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MyStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: cloudFS",")"]},{"inlineContent":[{"type":"text","text":"The authenticator stores tokens in the Keychain and refreshes them automatically."},{"type":"text","text":" "},{"type":"text","text":"The default scopes are "},{"type":"codeVoice","code":"Files.ReadWrite"},{"type":"text","text":" and "},{"type":"codeVoice","code":"offline_access"},{"type":"text","text":" (required for refresh"},{"type":"text","text":" "},{"type":"text","text":"tokens). The default tenant is "},{"type":"codeVoice","code":"common"},{"type":"text","text":" (supports both personal and work accounts)."}],"type":"paragraph"},{"anchor":"Threading","type":"heading","level":2,"text":"Threading"},{"inlineContent":[{"type":"text","text":"This class is "},{"type":"codeVoice","code":"@unchecked Sendable"},{"type":"text","text":". All network calls go through a shared"},{"type":"text","text":" "},{"type":"codeVoice","code":"URLSession"},{"type":"text","text":" instance, which is thread-safe. Mutable state ("},{"type":"codeVoice","code":"loggedIn"},{"type":"text","text":" flag)"},{"type":"text","text":" "},{"type":"text","text":"is accessed only from async methods that are serialized by the ensemble’s operation queue."}],"type":"paragraph"}]}],"kind":"symbol","identifier":{"url":"doc:\/\/EnsemblesOneDrive\/documentation\/EnsemblesOneDrive\/OneDriveCloudFileSystem","interfaceLanguage":"swift"},"seeAlsoSections":[{"generated":true,"title":"Cloud File System","identifiers":["doc:\/\/EnsemblesOneDrive\/documentation\/EnsemblesOneDrive\/OneDriveAuthenticator"],"anchor":"Cloud-File-System"}],"references":{"doc:/