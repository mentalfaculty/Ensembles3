{"primaryContentSections":[{"content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"EnsemblesOneDrive provides ","type":"text"},{"isActive":true,"identifier":"doc:\/\/EnsemblesOneDrive\/documentation\/EnsemblesOneDrive\/OneDriveCloudFileSystem","type":"reference"},{"text":", an implementation of the Ensembles ","type":"text"},{"code":"CloudFileSystem","type":"codeVoice"},{"text":" protocol that stores sync data on Microsoft OneDrive. It communicates directly with the Microsoft Graph REST API v1.0 using ","type":"text"},{"code":"URLSession","type":"codeVoice"},{"text":" — no third-party SDK required.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"OneDrive supports native path-based addressing via the colon syntax ("},{"code":"\/me\/drive\/root:\/path\/to\/item:","type":"codeVoice"},{"text":"), so Ensembles paths map directly without ID resolution.","type":"text"}]},{"text":"Authentication","level":3,"anchor":"Authentication","type":"heading"},{"inlineContent":[{"text":"The included ","type":"text"},{"type":"reference","identifier":"doc:\/\/EnsemblesOneDrive\/documentation\/EnsemblesOneDrive\/OneDriveAuthenticator","isActive":true},{"text":" handles the full OAuth 2.0 authorization code flow for the Microsoft Identity Platform, stores tokens in the Keychain, and automatically refreshes expired tokens.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Azure Portal setup:"}],"type":"strong"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Go to ","type":"text"},{"identifier":"https:\/\/portal.azure.com\/","isActive":true,"type":"reference"},{"text":" → ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"Azure Active Directory → App registrations","type":"text"}]},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Click "},{"type":"strong","inlineContent":[{"text":"New registration","type":"text"}]},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Enter a name for your app."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Under "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Supported account types"}]},{"type":"text","text":", select "},{"type":"strong","inlineContent":[{"type":"text","text":"Accounts in any organizational directory and personal Microsoft accounts"}]},{"type":"text","text":" (or a narrower scope if appropriate)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Click "},{"type":"strong","inlineContent":[{"type":"text","text":"Register"}]},{"type":"text","text":" and note the "},{"type":"strong","inlineContent":[{"type":"text","text":"Application (client) ID"}]},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Go to "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Authentication → Add a platform → Mobile and desktop applications"}]},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Set the redirect URI (e.g., "},{"type":"codeVoice","code":"msauth.com.yourapp:\/\/auth"},{"type":"text","text":")."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Ensure "},{"type":"strong","inlineContent":[{"type":"text","text":"Access tokens"}]},{"type":"text","text":" and "},{"type":"strong","inlineContent":[{"type":"text","text":"Refresh tokens"}]},{"type":"text","text":" are enabled under "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Implicit grant and hybrid flows"}]},{"type":"text","text":" if needed."}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"inlineContent":[{"text":"Code:","type":"text"}],"type":"strong"}],"type":"paragraph"},{"code":["import EnsemblesOneDrive","","let config = OneDriveAuthenticator.Configuration(","    clientID: \"YOUR-CLIENT-ID\",","    redirectURI: \"msauth.com.yourapp:\/\/auth\"",")","let authenticator = OneDriveAuthenticator(configuration: config)","","\/\/ One-time interactive authorization (presents a web sign-in sheet)","try await authenticator.authorize(presenting: window)","","\/\/ Create the cloud file system","let cloudFS = OneDriveCloudFileSystem(authenticator: authenticator)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"On subsequent launches, the authenticator restores tokens from the Keychain and refreshes them automatically. The default scopes are ","type":"text"},{"code":"Files.ReadWrite","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"offline_access","type":"codeVoice"},{"text":" (the latter is required for refresh tokens).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For multi-tenant scenarios, configure the ","type":"text"},{"code":"tenant","type":"codeVoice"},{"text":" parameter:","type":"text"}],"type":"paragraph"},{"code":["let config = OneDriveAuthenticator.Configuration(","    clientID: \"YOUR-CLIENT-ID\",","    redirectURI: \"msauth.com.yourapp:\/\/auth\",","    tenant: \"organizations\"  \/\/ or a specific tenant ID",")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"For apps that manage tokens externally, pass a static access token:","type":"text"}],"type":"paragraph"},{"code":["let cloudFS = OneDriveCloudFileSystem(accessToken: \"your-token\")"],"syntax":"swift","type":"codeListing"},{"text":"Setup","level":3,"anchor":"Setup","type":"heading"},{"code":["import Ensembles","import EnsemblesOneDrive","","let cloudFS = OneDriveCloudFileSystem(authenticator: authenticator)","let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MainStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: cloudFS",")","try await ensemble?.attachPersistentStore()"],"syntax":"swift","type":"codeListing"},{"