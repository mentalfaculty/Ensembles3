{"kind":"symbol","primaryContentSections":[{"content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"EnsemblesOneDrive provides "},{"isActive":true,"type":"reference","identifier":"doc:\/\/EnsemblesOneDrive\/documentation\/EnsemblesOneDrive\/OneDriveCloudFileSystem"},{"type":"text","text":", an implementation of the Ensembles "},{"type":"codeVoice","code":"CloudFileSystem"},{"type":"text","text":" protocol that stores sync data on Microsoft OneDrive. It communicates directly with the Microsoft Graph REST API v1.0 using "},{"type":"codeVoice","code":"URLSession"},{"type":"text","text":" — no third-party SDK required."}],"type":"paragraph"},{"inlineContent":[{"text":"OneDrive supports native path-based addressing via the colon syntax (","type":"text"},{"type":"codeVoice","code":"\/me\/drive\/root:\/path\/to\/item:"},{"type":"text","text":"), so Ensembles paths map directly without ID resolution."}],"type":"paragraph"},{"text":"Authentication","type":"heading","level":3,"anchor":"Authentication"},{"inlineContent":[{"type":"text","text":"The included "},{"isActive":true,"type":"reference","identifier":"doc:\/\/EnsemblesOneDrive\/documentation\/EnsemblesOneDrive\/OneDriveAuthenticator"},{"type":"text","text":" handles the full OAuth 2.0 authorization code flow for the Microsoft Identity Platform, stores tokens in the Keychain, and automatically refreshes expired tokens."}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"Azure Portal setup:","type":"text"}],"type":"strong"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"Go to ","type":"text"},{"type":"reference","identifier":"https:\/\/portal.azure.com\/","isActive":true},{"text":" → ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"Azure Active Directory → App registrations"}]},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Click ","