{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/EnsemblesCloudKit\/documentation\/EnsemblesCloudKit"},"topicSections":[{"title":"Cloud File System","anchor":"Cloud-File-System","identifiers":["doc:\/\/EnsemblesCloudKit\/documentation\/EnsemblesCloudKit\/CloudKitFileSystem","doc:\/\/EnsemblesCloudKit\/documentation\/EnsemblesCloudKit\/CloudKitFileSystemDelegate"]},{"title":"Enumerations","anchor":"Enumerations","identifiers":["doc:\/\/EnsemblesCloudKit\/documentation\/EnsemblesCloudKit\/CloudKitSchemaVersion","doc:\/\/EnsemblesCloudKit\/documentation\/EnsemblesCloudKit\/DatabaseScope"],"generated":true}],"abstract":[{"text":"A CloudKit-based cloud backend for Ensembles.","type":"text"}],"kind":"symbol","metadata":{"symbolKind":"module","role":"collection","modules":[{"name":"EnsemblesCloudKit"}],"roleHeading":"Framework","title":"EnsemblesCloudKit","externalID":"EnsemblesCloudKit"},"hierarchy":{"paths":[[]]},"primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"EnsemblesCloudKit provides ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/EnsemblesCloudKit\/documentation\/EnsemblesCloudKit\/CloudKitFileSystem"},{"text":", an implementation of the Ensembles ","type":"text"},{"type":"codeVoice","code":"CloudFileSystem"},{"text":" protocol that stores sync data in iCloud using CloudKit. It handles file upload, download, and directory management through CloudKit record operations.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"CloudKit is the recommended backend for most apps — it requires no server setup, no authentication UI, and syncs automatically across all of a user’s iCloud devices.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Xcode Setup","anchor":"Xcode-Setup","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Open your Xcode project and select the app target.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Go to ","type":"text"},{"inlineContent":[{"text":"Signing & Capabilities","type":"text"}],"type":"emphasis"},{"text":" and click ","type":"text"},{"inlineContent":[{"text":"+ Capability","type":"text"}],"type":"strong"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Add ","type":"text"},{"inlineContent":[{"text":"iCloud","type":"text"}],"type":"strong"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Check ","type":"text"},{"inlineContent":[{"text":"CloudKit","type":"text"}],"type":"strong"},{"text":" under iCloud services.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Create or select a CloudKit container (e.g., ","type":"text"},{"code":"iCloud.com.yourcompany.yourapp","type":"codeVoice"},{"text":"). The container identifier must be unique across all apps.","type":"text"}]}]}],"type":"orderedList"},{"level":3,"text":"Quick Start","anchor":"Quick-Start","type":"heading"},{"code":["import Ensembles","import EnsemblesCloudKit","","let cloudFS = CloudKitFileSystem(","    privateDatabaseForUbiquityContainerIdentifier: \"iCloud.com.yourcompany.yourapp\",","    schemaVersion: .v2",")","","let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MainStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: cloudFS",")","try await ensemble?.attachPersistentStore()","try await ensemble?.sync()"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Or use the container for a simpler setup:","type":"text"}],"type":"paragraph"},{"code":["let container = CoreDataEnsembleContainer(","    name: \"MainStore\",","    storeURL: storeURL,","    modelURL: modelURL,","    cloudFileSystem: CloudKitFileSystem(","        privateDatabaseForUbiquityContainerIdentifier: \"iCloud.com.yourcompany.yourapp\",","        schemaVersion: .v2","    )",")"],"syntax":"swift","type":"codeListing"},{"level":3,"text":"Database Scope","anchor":"Database-Scope","type":"heading"},{"inlineContent":[{"text":"CloudKit offers three database scopes:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Private database","type":"text"}],"type":"strong"},{"text":" (default) — Syncs across the current user’s own iCloud devices. Data is only accessible to the signed-in iCloud account. This is the recommended scope for most apps.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Public database","type":"text"}],"type":"strong"},{"text":" — Data is accessible to all users of the app, even without iCloud sign-in. Uses different quota limits (per-app rather than per-user). Useful for shared reference data.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Shared database","type":"text"}],"type":"strong"},{"text":" — Used with ","type":"text"},{"code":"CKShare","type":"codeVoice"},{"text":" for sharing specific data between users.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"code":["\/\/ Private database, custom zone (recommended)","let cloudFS = CloudKitFileSystem(","    privateDatabaseForUbiquityContainerIdentifier: \"iCloud.com.yourcompany.yourapp\",","    schemaVersion: .v2",")","","\/\/ Private database, default zone","\/\/ (use this when migrating an Ensembles 2 fleet that was on the default zone)","let cloudFS = CloudKitFileSystem(","    ubiquityContainerIdentifier: \"iCloud.com.yourcompany.yourapp\",","    rootDirectory: \"\/\",","    usePublicDatabase: false,","    schemaVersion: .v2",")","","\/\/ Public database","let cloudFS = CloudKitFileSystem(","    ubiquityContainerIdentifier: \"iCloud.com.yourcompany.yourapp\",","    rootDirectory: \"SharedData\",","    usePublicDatabase: true,","    schemaVersion: .v2",")"],"syntax":"swift","type":"codeListing"},{"level":3,"text":"Schema Versions","anchor":"Schema-Versions","type":"heading"},{"inlineContent":[{"text":"CloudKit uses record types to store sync data. Two schema versions are available:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"code":".v1","type":"codeVoice"}],"type":"strong"},{"text":" — The original schema with three record types: ","type":"text"},{"code":"CDEFileSystemNode","type":"codeVoice"},{"text":", ","type":"text"},{"code":"CDEItem","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"CDEDataFile","type":"codeVoice"},{"text":". Use this when continuing an existing Ensembles 2 deployment that was on schema 1.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":".v2","type":"codeVoice"}],"type":"strong"},{"text":" — A simplified schema that removes the ","type":"text"},{"code":"CDEDataFile","type":"codeVoice"},{"text":" record type. Slightly more efficient. Use this for new apps and for E2 fleets that were already on schema 2.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"There is no implicit default — every initializer requires an explicit ","type":"text"},{"type":"codeVoice","code":"schemaVersion"},{"text":". For new apps, use ","type":"text"},{"type":"codeVoice","code":".v2"},{"text":".","type":"text"}],"type":"paragraph"},{"level":3,"text":"Publishing Schema to Production","anchor":"Publishing-Schema-to-Production","type":"heading"},{"style":"important","content":[{"inlineContent":[{"text":"You ","type":"text"},{"type":"strong","inlineContent":[{"text":"must","type":"text"}]},{"text":" deploy the CloudKit schema to production before submitting your app to the App Store. Without this step, the app will fail to sync for end users.","type":"text"}],"type":"paragraph"}],"name":"Important","type":"aside"},{"inlineContent":[{"text":"In the ","type":"text"},{"inlineContent":[{"text":"development environment","type":"text"}],"type":"strong"},{"text":", CloudKit creates record types automatically on first use. Before submitting to the App Store:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Run your app at least once in the development environment so that CloudKit creates the necessary record types.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Open ","type":"text"},{"identifier":"https:\/\/icloud.developer.apple.com\/dashboard\/","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Select your container.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Go to ","type":"text"},{"inlineContent":[{"text":"Schema → Deploy to Production","type":"text"}],"type":"emphasis"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Review and deploy.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"text":"The production schema cannot be modified once deployed (only extended with new fields), so test thoroughly in development first.","type":"text"}],"type":"paragraph"},{"text":"Sharing with CKShare","anchor":"Sharing-with-CKShare","type":"heading","level":3},{"inlineContent":[{"text":"For apps that share data between users via ","type":"text"},{"code":"CKShare","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["let cloudFS = CloudKitFileSystem(","    ubiquityContainerIdentifier: \"iCloud.com.yourcompany.yourapp\",","    sharingIdentifier: \"com.yourcompany.yourapp.shared\",","    shareOwnerName: ownerRecordName",")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Implement ","type":"text"},{"identifier":"doc:\/\/EnsemblesCloudKit\/documentation\/EnsemblesCloudKit\/CloudKitFileSystemDelegate","type":"reference","isActive":true},{"text":" to handle share setup and participant management.","type":"text"}],"type":"paragraph"},{"text":"Data Security","level":3,"anchor":"Data-Security","type":"heading"},{"inlineContent":[{"text":"Ensembles stores all sync data as ","type":"text"},{"type":"codeVoice","code":"CKAsset"},{"text":" binary files attached to CloudKit records — not as structured record fields. The contents are opaque serialized event logs that are not human-readable, even without encryption.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"CloudKit encrypts all data at rest on Apple’s servers. With ","type":"text"},{"identifier":"https:\/\/support.apple.com\/en-us\/102651","type":"reference","isActive":true},{"text":" (ADP) enabled, ","type":"text"},{"type":"codeVoice","code":"CKAsset"},{"text":" data is end-to-end encrypted — Apple cannot read it. Without ADP, Apple manages the encryption keys and could theoretically access the data.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For apps that need end-to-end encryption regardless of the user’s ADP setting, wrap the CloudKit backend with ","type":"text"},{"type":"codeVoice","code":"EnsemblesEncrypted"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["import EnsemblesEncrypted","","let encryptedFS = EncryptedCloudFileSystem(","    cloudFileSystem: CloudKitFileSystem(","        privateDatabaseForUbiquityContainerIdentifier: \"iCloud.com.yourcompany.yourapp\",","        schemaVersion: .v2","    ),","    password: \"user-supplied-password\"",")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"This encrypts data with AES-256-GCM before it ever reaches CloudKit, so security does not depend on Apple’s infrastructure.","type":"text"}],"type":"paragraph"},{"text":"Custom Zones","level":3,"anchor":"Custom-Zones","type":"heading"},{"inlineContent":[{"text":"The two private-database initializers write to different CloudKit zones:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"init(ubiquityContainerIdentifier:rootDirectory:usePublicDatabase:schemaVersion:)","type":"codeVoice"},{"text":" writes to CloudKit’s default zone (","type":"text"},{"code":"_defaultZone","type":"codeVoice"},{"text":").","type":"text"}]}]},{"content":[{"inlineContent":[{"code":"init(privateDatabaseForUbiquityContainerIdentifier:schemaVersion:)","type":"codeVoice"},{"text":" writes to a custom zone, ","type":"text"},{"code":"com.mentalfaculty.ensembles.zone.schema2","type":"codeVoice"},{"text":". This is the recommended choice for new apps because the custom zone supports efficient change tracking via ","type":"text"},{"code":"CKServerChangeToken","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"When migrating an existing Ensembles 2 fleet, your E3 build must use the same initializer that your E2 build used. Devices in different zones cannot see each other’s records, even when pointing at the same iCloud container with the same schema version. See ","type":"text"},{"text":"doc:MigratingFromEnsembles2","type":"text"},{"text":" for details.","type":"text"}],"type":"paragraph"},{"text":"Delegate","level":3,"anchor":"Delegate","type":"heading"},{"inlineContent":[{"text":"Implement ","type":"text"},{"identifier":"doc:\/\/EnsemblesCloudKit\/documentation\/EnsemblesCloudKit\/CloudKitFileSystemDelegate","type":"reference","isActive":true},{"text":" to customize CloudKit behavior, handle errors, and manage sharing:","type":"text"}],"type":"paragraph"},{"code":["cloudFS.delegate = self"],"syntax":"swift","type":"codeListing"}],"kind":"content"}],"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"paths":["\/documentation\/ensemblescloudkit"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://EnsemblesCloudKit/documentation/EnsemblesCloudKit/CloudKitFileSystemDelegate":{"role":"symbol","type":"topic","identifier":"doc:\/\/EnsemblesCloudKit\/documentation\/EnsemblesCloudKit\/CloudKitFileSystemDelegate","title":"CloudKitFileSystemDelegate","abstract":[{"text":"Delegate protocol for CloudKit file system sharing and configuration callbacks.","type":"text"}],"url":"\/documentation\/ensemblescloudkit\/cloudkitfilesystemdelegate","kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CloudKitFileSystemDelegate","kind":"identifier"}],"navigatorTitle":[{"text":"CloudKitFileSystemDelegate","kind":"identifier"}]},"https://icloud.developer.apple.com/dashboard/":{"title":"CloudKit Console","type":"link","identifier":"https:\/\/icloud.developer.apple.com\/dashboard\/","url":"https:\/\/icloud.developer.apple.com\/dashboard\/","titleInlineContent":[{"text":"CloudKit Console","type":"text"}]},"doc://EnsemblesCloudKit/documentation/EnsemblesCloudKit":{"role":"collection","identifier":"doc:\/\/EnsemblesCloudKit\/documentation\/EnsemblesCloudKit","title":"EnsemblesCloudKit","url":"\/documentation\/ensemblescloudkit","abstract":[{"text":"A CloudKit-based cloud backend for Ensembles.","type":"text"}],"type":"topic","kind":"symbol"},"doc://EnsemblesCloudKit/documentation/EnsemblesCloudKit/CloudKitFileSystem":{"identifier":"doc:\/\/EnsemblesCloudKit\/documentation\/EnsemblesCloudKit\/CloudKitFileSystem","abstract":[{"text":"A CloudKit-backed cloud file system.","type":"text"}],"navigatorTitle":[{"text":"CloudKitFileSystem","kind":"identifier"}],"title":"CloudKitFileSystem","role":"symbol","kind":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CloudKitFileSystem","kind":"identifier"}],"type":"topic","url":"\/documentation\/ensemblescloudkit\/cloudkitfilesystem"},"https://support.apple.com/en-us/102651":{"url":"https:\/\/support.apple.com\/en-us\/102651","titleInlineContent":[{"text":"Advanced Data Protection","type":"text"}],"type":"link","identifier":"https:\/\/support.apple.com\/en-us\/102651","title":"Advanced Data Protection"},"doc://EnsemblesCloudKit/documentation/EnsemblesCloudKit/CloudKitSchemaVersion":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"CloudKitSchemaVersion"}],"abstract":[{"type":"text","text":"CloudKit schema version for data storage format."}],"type":"topic","title":"CloudKitSchemaVersion","kind":"symbol","identifier":"doc:\/\/EnsemblesCloudKit\/documentation\/EnsemblesCloudKit\/CloudKitSchemaVersion","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"CloudKitSchemaVersion"}],"url":"\/documentation\/ensemblescloudkit\/cloudkitschemaversion"},"doc://EnsemblesCloudKit/documentation/EnsemblesCloudKit/DatabaseScope":{"abstract":[{"type":"text","text":"The CloudKit database scope being used."}],"type":"topic","url":"\/documentation\/ensemblescloudkit\/databasescope","kind":"symbol","role":"symbol","identifier":"doc:\/\/EnsemblesCloudKit\/documentation\/EnsemblesCloudKit\/DatabaseScope","navigatorTitle":[{"text":"DatabaseScope","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"text":"DatabaseScope","kind":"identifier"}],"title":"DatabaseScope"}}}