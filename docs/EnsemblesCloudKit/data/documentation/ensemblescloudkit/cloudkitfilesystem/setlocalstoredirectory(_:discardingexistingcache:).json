{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/EnsemblesCloudKit\/documentation\/EnsemblesCloudKit\/CloudKitFileSystem\/setLocalStoreDirectory(_:discardingExistingCache:)"},"kind":"symbol","abstract":[{"text":"Binds the listing cache to the event store’s directory, loading any cache already","type":"text"},{"text":" ","type":"text"},{"text":"written there for this zone. Called by the ensemble before priming.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"setLocalStoreDirectory"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"path"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"discardingExistingCache"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":")"}],"platforms":["macOS"]}]},{"content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"Rebinding to a different directory drops the in-memory listing and token: they"},{"type":"text","text":" "},{"type":"text","text":"describe the previous store and must not leak across."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"With "},{"type":"codeVoice","code":"discardingExistingCache"},{"type":"text","text":", any cache file already in the directory is deleted"},{"type":"text","text":" "},{"type":"text","text":"instead of loaded. The ensemble passes this when the store is being rebuilt. The"},{"type":"text","text":" "},{"text":"deletion is explicit rather than relying on the rebuilt directory happening to be","type":"text"},{"text":" ","type":"text"},{"text":"empty: whether a cache file is present at that moment depends on the or