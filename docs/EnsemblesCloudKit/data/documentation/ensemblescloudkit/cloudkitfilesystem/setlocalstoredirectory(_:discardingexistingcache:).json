. Called by the ensemble before priming."}],"kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"setLocalStoreDirectory","kind":"identifier"},{"text":"(","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"discardingExistingCache","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":")","kind":"text"}],"role":"symbol","identifier":"doc:\/\/EnsemblesCloudKit\/documentation\/EnsemblesCloudKit\/CloudKitFileSystem\/setLocalStoreDirectory(_:discardingExistingCache:)","type":"topic"},"doc://EnsemblesCloudKit/documentation/EnsemblesCloudKit/CloudKitFileSystem":{"url":"\/documentation\/ensemblescloudkit\/cloudkitfilesystem","title":"CloudKitFileSystem","abstract":[{"type":"text","text":"A CloudKit-backed cloud file system."}],"kind":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CloudKitFileSystem","kind":"identifier"}],"navigatorTitle":[{"text":"CloudKitFileSystem","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/EnsemblesCloudKit\/documentation\/EnsemblesCloudKit\/CloudKitFileSystem","type":"topic"},"doc://EnsemblesCloudKit/documentation/EnsemblesCloudKit":{"type":"topic","abstract":[{"text":"A CloudKit-based cloud backend for Ensembles.","type":"text"}],"kind":"symbol","title":"EnsemblesCloudKit","identifier":"doc:\/\/EnsemblesCloudKit\/documentation\/EnsemblesCloudKit","url":"\/documentation\/ensemblescloudkit","role":"collection"}}}