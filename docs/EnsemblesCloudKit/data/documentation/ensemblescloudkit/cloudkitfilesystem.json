ext","text":" attachments. Supports custom"},{"type":"text","text":" "},{"type":"text","text":"zones, server change token caching for efficient incremental fetches, and"},{"type":"text","text":" "},{"type":"codeVoice","code":"CKShare"},{"type":"text","text":"-based sharing."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Preserves exact "},{"type":"codeVoice","code":"CKRecord"},{"type":"text","text":" type names ("},{"type":"codeVoice","code":"CDEFileSystemNode"},{"type":"text","text":", "},{"type":"codeVoice","code":"CDEItem"},{"text":") and field","type":"text"},{"text":" ","type":"text"},{"text":"names from the original Objective-C implementation for backwards compatibility.","type":"text"}],"type":"paragraph"},{"text":"Setup","anchor":"Setup","level":2,"type":"heading"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Enable the "},{"type":"strong","inlineContent":[{"text":"iCloud","type":"text"}]},{"type":"text","text":" capability in your Xcode project"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Check ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"CloudKit"}]},{"text":" under iCloud services","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Create or select a CloudKit container (e.g. "},{"type":"codeVoice","code":"iCloud.com.yourcompany.yourapp"},{"type":"text","text":")"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Initialize the file system:"}],"type":"paragraph"}]}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Custom zone in private database (recommended)","let cloudFS = CloudKitFileSystem(","    privateDatabaseForUbiquityContainerIdentifier: \"iCloud.com.yourcompany.yourapp\",","    schemaVersion: .v2",")","","\/\/ Or: default zone with explicit database choice","let cloudFS = CloudKitFileSystem(","    ubiquityContainerIdentifier: \"iCloud.com.yourcompany.yourapp\",","    rootDirectory: \"ensembles\",","    usePublicDatabase: false,","    schemaVersion: .v2",")","","let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MyStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: cloudFS",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"No API keys or OAuth tokens are needed — CloudKit uses the device’s iCloud"},{"text":" ","type":"text"},{"text":"account automatically.","type":"text"}]},{"anchor":"Schema-Versions","type":"heading","text":"Schema Versions","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/EnsemblesCloudKit\/documentation\/EnsemblesCloudKit\/CloudKitSchemaVersion\/v1"},{"text":" — Original schema with separate ","type":"text"},{"type":"codeVoice","code":"CDEDataFile"},{"text":" ","type":"text"},{"text":"records. Use this for backward compatibility with existing Ensembles 2","type":"text"},{"text":" ","type":"text"},{"text":"CloudKit data.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/EnsemblesCloudKit\/documentation\/EnsemblesCloudKit\/CloudKitSchemaVersion\/v2","isActive":true,"type":"reference"},{"text":" — Simplified schema without ","type":"text"},{"code":"CDEDataFile","type":"codeVoice"},{"text":" ","type":"text"},{"text":"records. Recommended for new apps.","type":"text"}]}]}]},{"anchor":"Database-Scope","type":"heading","text":"Database Scope","level":2},{"inlineContent":[{"type":"text","text":"Use "},{"code":"usePublicDatabase: false","type":"codeVoice"},{"type":"text","text":" (private database) for most apps. The private"},{"type":"text","text":" "},{"type":"text","text":"database syncs across the user’s own devices via their iCloud account."},{"type":"text","text":" "},{"type":"text","text":"The public database is shared across all users and requires no iCloud"},{"type":"text","text":" "},{"type":"text","text":"sign-in, but has different quota limits."}],"type":"paragraph"},{"anchor":"Zone-Lifetime","type":"heading","text":"Zone Lifetime","level":2},{"inlineContent":[{"type":"text","text":"An instance is bound to the CloudKit zone incarnation it was primed against: its"},{"text":" ","type":"text"},{"text":"cached listing and server change token describe that zone’s history and no other.","type":"text"},{"text":" ","type":"text"},{"text":"If the zone is deleted or recreated outside the framework — in the CloudKit","type":"text"},{"text":" ","type":"text"},{"text":"Console, with your own CloudKit code, or by the user removing the app’s iCloud","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"data in Settings — discard the instance and create a fresh one, and treat the"},{"type":"text","text":" "},{"type":"text","text":"deletion as a full cloud reset: detach and re-attach every device that ever"},{"type":"text","text":" "},{"type":"text","text":"synced with the zone. Prefer "},{"code":"CoreDataEnsemble.removeEnsemble(withIdentifier:in:)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"for resets you control; it deletes records through the framework, so all local"},{"type":"text","text":" "},{"type":"text","text":"caches follow along and the zone itself is never destroyed."}],"type":"paragraph"},{"type":"heading","anchor":"Migrating-from-Ensembles-2","level":2,"text":"Migrating from Ensembles 2"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The two private-database initializers write to "},{"inlineContent":[{"text":"different CloudKit zones","type":"text"}],"type":"strong"},{"text":":","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"init(ubiquityContainerIdentifier:rootDirectory:usePublicDatabase:schemaVersion:)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"uses CloudKit’s default zone ("},{"code":"_defaultZone","type":"codeVoice"},{"type":"text","text":")."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"init(privateDatabaseForUbiquityContainerIdentifier:schemaVersion:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"uses a custom zone named ","type":"text"},{"code":"com.mentalfaculty.ensembles.zone.schema2","type":"codeVoice"},{"text":".","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"E2 had the same two initializers with the same zone behaviour. If you are"},{"type":"text","text":" "},{"type":"text","text":"migrating an existing E2 fleet to E3 and some users may still be running"},{"type":"text","text":" "},{"type":"text","text":"E2 during the rollout, "},{"type":"strong","inlineContent":[{"type":"text","text":"use the same initializer in E3 that your E2 build"},{"type":"text","text":" "},{"type":"text","text":"used"}]},{"type":"text","text":". Devices in different zones cannot see each other’s records, even"},{"type":"text","text":" "},{"type":"text","text":"when pointing at the same iCloud container with the same schema version."},{"type":"text","text":" "},{"type":"text","text":"Switch to the recommended custom-zone form only after your fleet has fully"},{"type":"text","text":" "},{"type":"text","text":"migrated."}]},{"type":"heading","level":2,"text":"Publishing the Schema","anchor":"Publishing-the-Schema"},{"type":"paragraph","inlineContent":[{"text":"CloudKit schemas must be deployed to production before your app ships.","type":"text"},{"text":" ","type":"text"},{"text":"After testing in the Development environment:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Open ","type":"text"},{"isActive":true,"identifier":"https:\/\/icloud.developer.apple.com\/","type":"reference"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Select your container"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Go to "},{"inlineContent":[{"type":"text","text":"Deploy Schema to Production"}],"type":"emphasis"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Review the record types and deploy","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The schema is created automatically in Development when you first run"},{"type":"text","text":" "},{"type":"text","text":"the app, but it won’t be visible to production users until you deploy it."}]},{"type":"heading","level":2,"text":"Sharing","anchor":"Sharing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For "},{"type":"codeVoice","code":"CKShare"},{"type":"text","text":"-based sharing with a custom zone:"}]},{"type":"codeListing","code":["let cloudFS = CloudKitFileSystem(","    ubiquityContainerIdentifier: \"iCloud.com.yourcompany.yourapp\",","    sharingIdentifier: \"com.yourcompany.yourapp.sharing\",","    shareOwnerName: CKCurrentUserDefaultName",")"],"syntax":"swift"}]}],"relationshipsSections":[{"identifiers":["doc:\/\/EnsemblesCloudKit\/9Ensembles15CloudFileSystemP","doc:\/\/EnsemblesCloudKit\/9Ensembles30CloudFileSystemBatchOperationsP","doc:\/\/EnsemblesCloudKit\/9Ensembles20CloudFileSystemSetupP","doc:\/\/EnsemblesCloudKit\/s8CopyableP","doc:\/\/EnsemblesCloudKit\/s9EscapableP","doc:\/\/EnsemblesCloudKit\/s8SendableP","doc:\/\/EnsemblesCloudKit\/s16SendableMetatypeP"],"kind":"relationships","title":"Conforms To","type":"conformsTo"}],"identifier":{"url":"doc:\/\/EnsemblesCloudKit\/documentation\/EnsemblesCloudKit\/CloudKitFileSystem","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/EnsemblesCloudKit\/documentation\/EnsemblesCloudKit"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ensemblescloudkit\/cloudkitfilesystem"]}],"abstract":[{"text":"A CloudKit-backed cloud file system.","type":"text"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://EnsemblesCloudKit/documentation/EnsemblesCloudKit/CloudKitFileSystemDeleg