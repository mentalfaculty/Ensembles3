ext":"Stores files as ","type":"text"},{"code":"CKRecord","type":"codeVoice"},{"text":" objects with ","type":"text"},{"code":"CKAsset","type":"codeVoice"},{"text":" attachments. Supports custom","type":"text"},{"text":" ","type":"text"},{"text":"zones, server change token caching for efficient incremental fetches, and","type":"text"},{"text":" ","type":"text"},{"code":"CKShare","type":"codeVoice"},{"text":"-based sharing.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Preserves exact "},{"type":"codeVoice","code":"CKRecord"},{"type":"text","text":" type names ("},{"type":"codeVoice","code":"CDEFileSystemNode"},{"type":"text","text":", "},{"type":"codeVoice","code":"CDEItem"},{"type":"text","text":") and field"},{"type":"text","text":" "},{"type":"text","text":"names from the original Objective-C implementation for backwards compatibility."}]},{"text":"Setup","type":"heading","anchor":"Setup","level":2},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Enable the "},{"inlineContent":[{"type":"text","text":"iCloud"}],"type":"strong"},{"type":"text","text":" capability in your Xcode project"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Check ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"CloudKit"}]},{"type":"text","text":" under iCloud services"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Create or select a CloudKit container (e.g. "},{"code":"iCloud.com.yourcompany.yourapp","type":"codeVoice"},{"type":"text","text":")"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Initialize the file system:"}]}]}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Custom zone in private database (recommended)","let cloudFS = CloudKitFileSystem(","    privateDatabaseForUbiquityContainerIdentifier: \"iCloud.com.yourcompany.yourapp\",","    schemaVersion: .v2",")","","\/\/ Or: default zone with explicit database choice","let cloudFS = CloudKitFileSystem(","    ubiquityContainerIdentifier: \"iCloud.com.yourcompany.yourapp\",","    rootDirectory: \"ensembles\",","    usePublicDatabase: false,","    schemaVersion: .v2",")","","let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MyStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: cloudFS",")"]},{"type":"paragraph","inlineContent":[{"text":"No API keys or OAuth tokens are needed — CloudKit uses the device’s iCloud","type":"text"},{"type":"text","text":" "},{"type":"text","text":"account automatically."}]},{"anchor":"Schema-Versions","text":"Schema Versions","level":2,"type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/EnsemblesCloudKit\/documentation\/EnsemblesCloudKit\/CloudKitSchemaVersion\/v1","isActive":true,"type":"reference"},{"type":"text","text":" — Original schema with separate "},{"type":"codeVoice","code":"CDEDataFile"},{"text":" ","type":"text"},{"text":"records. Use this for backward compatibility with existing Ensembles 2","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"CloudKit data."}]}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/EnsemblesCloudKit\/documentation\/EnsemblesCloudKit\/CloudKitSchemaVersion\/v2"},{"type":"text","text":" — Simplified schema without "},{"type":"codeVoice","code":"CDEDataFile"},{"type":"text","text":" "},{"type":"text","text":"records. Recommended for new apps."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"heading","level":2,"text":"Database Scope","anchor":"Database-Scope"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"usePublicDatabase: false"},{"type":"text","text":" (private database) for most apps. The private"},{"text":" ","type":"text"},{"text":"database syncs across the user’s own devices via their iCloud account.","type":"text"},{"text":" ","type":"text"},{"text":"The public database is shared across all users and requires no iCloud","type":"text"},{"type":"text","text":" "},{"text":"sign-in, but has different quota limits.","type":"text"}]},{"anchor":"Zone-Lifetime","level":2,"text":"Zone Lifetime","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An instance is bound to the CloudKit zone incarnation it was primed against: its"},{"type":"text","text":" "},{"text":"cached listing and server change token describe that zone’s history and no other.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"If the zone is deleted or recreated outside the framework — in the CloudKit"},{"type":"text","text":" "},{"text":"Console, with your own CloudKit code, or by the user removing the app’s iCloud","type":"text"},{"type":"text","text":" "},{"type":"text","text":"data in Settings — discard the instance and create a fresh one, and treat the"},{"type":"text","text":" "},{"text":"deletion as a full cloud reset: detach and re-attach every device that ever","type":"text"},{"text":" ","type":"text"},{"text":"synced with the zone. Prefer ","type":"text"},{"code":"CoreDataEnsemble.removeEnsemble(withIdentifier:in:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"for resets you control; it deletes records through the framework, so all local","type":"text"},{"text":" ","type":"text"},{"text":"caches follow along and the zone itself is never destroyed.","type":"text"}]},{"anchor":"Migrating-from-Ensembles-2","level":2,"type":"heading","text":"Migrating from Ensembles 2"},{"type":"paragraph","inlineContent":[{"text":"The two private-database initializers write to ","type":"text"},{"inlineContent":[{"text":"different CloudKit zones","type":"text"}],"type":"strong"},{"text":":","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"init(ubiquityContainerIdentifier:rootDirectory:usePublicDatabase:schemaVersion:)"},{"text":" ","type":"text"},{"type":"text","text":"uses CloudKit’s default zone ("},{"type":"codeVoice","code":"_defaultZone"},{"type":"text","text":")."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"init(privateDatabaseForUbiquityContainerIdentifier:schemaVersion:)"},{"type":"text","text":" "},{"type":"text","text":"uses a custom zone named "},{"code":"com.mentalfaculty.ensembles.zone.schema2","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"E2 had the same two initializers with the same zone behaviour. If you are","type":"text"},{"text":" ","type":"text"},{"text":"migrating an existing E2 fleet to E3 and some users may still be running","type":"text"},{"type":"text","text":" "},{"text":"E2 during the rollout, ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"use the same initializer in E3 that your E2 build"},{"type":"text","text":" "},{"type":"text","text":"used"}]},{"type":"text","text":". Devices in different zones cannot see each other’s records, even"},{"type":"text","text":" "},{"type":"text","text":"when pointing at the same iCloud container with the same schema version."},{"type":"text","text":" "},{"type":"text","text":"Switch to the recommended custom-zone form only after your fleet has fully"},{"type":"text","text":" "},{"type":"text","text":"migrated."}]},{"level":2,"type":"heading","text":"Publishing the Schema","anchor":"Publishing-the-Schema"},{"type":"paragraph","inlineContent":[{"text":"CloudKit schemas must be deployed to production before your app ships.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"After testing in the Development environment:"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Open "},{"isActive":true,"type":"reference","identifier":"https:\/\/icloud.developer.apple.com\/"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Select your container","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Go to "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Deploy Schema to Production"}]}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Review the record types and deploy","type":"text"}]}]}],"type":"orderedList"},{"inlineContent":[{"text":"The schema is created automatically in Development when you first run","type":"text"},{"text":" ","type":"text"},{"text":"the app, but it won’t be visible to production users until you deploy it.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"Sharing","anchor":"Sharing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For "},{"code":"CKShare","type":"codeVoice"},{"type":"text","text":"-based sharing with a custom zone:"}]},{"syntax":"swift","type":"codeListing","code":["let cloudFS = CloudKitFileSystem(","    ubiquityContainerIdentifier: \"iCloud.com.yourcompany.yourapp\",","    sharingIdentifier: \"com.yourcompany.yourapp.sharing\",","    shareOwnerName: CKCurrentUserDefaultName",")"]}]}],"sections":[],"metadata":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CloudKitFileSystem","kind":"identifier"}],"navigatorTitle":[{"text":"CloudKitFileSystem","kind":"identifier"}],"modules":[{"name":"EnsemblesCloudKit"}],"title":"CloudKitFileSystem","externalID":"s:17EnsemblesCloudKit0bC10FileSystemC","symbolKind":"class","roleHeading":"Class","role":"symbol"},"variants":[{"paths":["\/documentation\/ensemblescloudkit\/cloudkitfilesystem"],"traits":[{"interfaceLanguage":"swift"}]}],"seeAlsoSections":[{"identifiers":["doc:\/\/EnsemblesCloudKit\/documentation\/EnsemblesCloudKit\/CloudKitFileSystemDelegate"],"anchor":"Cloud-File-System","title":"Cloud File System","generated":true}],"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://EnsemblesCloudKit/s8SendableP":{"title":"Swift.Sendable","identifier":"do