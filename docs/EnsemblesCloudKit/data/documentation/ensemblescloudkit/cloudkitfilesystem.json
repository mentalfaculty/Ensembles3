erfaceLanguage":"swift"}],"paths":["\/documentation\/ensemblescloudkit\/cloudkitfilesystem"]}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"CloudKitFileSystem"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"anchor":"overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Stores files as "},{"type":"codeVoice","code":"CKRecord"},{"type":"text","text":" objects with "},{"type":"codeVoice","code":"CKAsset"},{"type":"text","text":" attachments. Supports custom"},{"type":"text","text":" "},{"type":"text","text":"zones, server change token caching for efficient incremental fetches, and"},{"type":"text","text":" "},{"type":"codeVoice","code":"CKShare"},{"type":"text","text":"-based sharing."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Preserves exact "},{"type":"codeVoice","code":"CKRecord"},{"type":"text","text":" type names ("},{"type":"codeVoice","code":"CDEFileSystemNode"},{"type":"text","text":", "},{"type":"codeVoice","code":"CDEItem"},{"type":"text","text":") and field"},{"type":"text","text":" "},{"type":"text","text":"names from the original Objective-C implementation for backwards compatibility."}],"type":"paragraph"},{"anchor":"Setup","text":"Setup","level":2,"type":"heading"},{"items":[{"content":[{"inlineContent":[{"text":"Enable the ","type":"text"},{"inlineContent":[{"type":"text","text":"iCloud"}],"type":"strong"},{"text":" capability in your Xcode project","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Check ","type":"text"},{"inlineContent":[{"type":"text","text":"CloudKit"}],"type":"strong"},{"type":"text","text":" under iCloud services"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Create or select a CloudKit container (e.g. "},{"type":"codeVoice","code":"iCloud.com.yourcompany.yourapp"},{"type":"text","text":")"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Initialize the file system:"}],"type":"paragraph"}]}],"type":"orderedList"},{"code":["\/\/ Custom zone in private database (recommended)","let cloudFS = CloudKitFileSystem(","    privateDatabaseForUbiquityContainerIdentifier: \"iCloud.com.yourcompany.yourapp\",","    schemaVersion: .v2",")","","\/\/ Or: default zone with explicit database choice","let cloudFS = CloudKitFileSystem(","    ubiquityContainerIdentifier: \"iCloud.com.yourcompany.yourapp\",","    rootDirectory: \"ensembles\",","    usePublicDatabase: false,","    schemaVersion: .v2",")","","let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MyStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: cloudFS",")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"No API keys or OAuth tokens are needed — CloudKit uses the device’s iCloud"},{"type":"text","text":" "},{"type":"text","text":"account automatically."}],"type":"paragraph"},{"text":"Schema Versions","anchor":"Schema-Versions","type":"heading","level":2},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/EnsemblesCloudKit\/documentation\/EnsemblesCloudKit\/CloudKitSchemaVersion\/v1"},{"type":"text","text":" — Original schema with separate "},{"type":"codeVoice","code":"CDEDataFile"},{"type":"text","text":" "},{"type":"text","text":"records. Use this for backward compatibility with existing Ensembles 2"},{"type":"text","text":" "},{"type":"text","text":"CloudKit data."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/EnsemblesCloudKit\/documentation\/EnsemblesCloudKit\/CloudKitSchemaVersion\/v2"},{"type":"text","text":" — Simplified schema without "},{"type":"codeVoice","code":"CDEDataFile"},{"type":"text","text":" "},{"type":"text","text":"records. Recommended for new apps."}]}]}],"type":"unorderedList"},{"text":"Database Scope","anchor":"Database-Scope","type":"heading","level":2},{"inlineContent":[{"text":"Use ","type":"text"},{"code":"usePublicDatabase: false","type":"codeVoice"},{"text":" (private database) for most apps. The private","type":"text"},{"text":" ","type":"text"},{"text":"database syncs across the user’s own devices via their iCloud account.","type":"text"},{"text":" ","type":"text"},{"text":"The public database is shared across all users and requires no iCloud","type":"text"},{"text":" ","type":"text"},{"text":"sign-in, but has different quota limits.","type":"text"}],"type":"paragraph"},{"text":"Zone Lifetime","anchor":"Zone-Lifetime","type":"heading","level":2},{"inlineContent":[{"text":"An instance is bound to the CloudKit zone incarnation it was primed against: its","type":"text"},{"text":" ","type":"text"},{"text":"cached listing and server change token describe that zone’s history and no other.","type":"text"},{"text":" ","type":"text"},{"text":"If the zone is deleted or recreated outside the framework — in the CloudKit","type":"text"},{"text":" ","type":"text"},{"text":"Console, with your own CloudKit code, or by the user removing the app’s iCloud","type":"text"},{"text":" ","type":"text"},{"text":"data in Settings — discard the instance and create a fresh one, and treat the","type":"text"},{"text":" ","type":"text"},{"text":"deletion as a full cloud reset: detach and re-attach every device that ever","type":"text"},{"text":" ","type":"text"},{"text":"synced with the zone. Prefer ","type":"text"},{"code":"CoreDataEnsemble.removeEnsemble(withIdentifier:in:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"for resets you control; it deletes records through the framework, so all local","type":"text"},{"text":" ","type":"text"},{"text":"caches follow along and the zone itself is never destroyed.","type":"text"}],"type":"paragraph"},{"text":"Migrating from Ensembles 2","anchor":"Migrating-from-Ensembles-2","type":"heading","level":2},{"inlineContent":[{"text":"The two private-database initializers write to ","type":"text"},{"inlineContent":[{"type":"text","text":"different CloudKit zones"}],"type":"strong"},{"text":":","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"init(ubiquityContainerIdentifier:rootDirectory:usePublicDatabase:schemaVersion:)"},{"type":"text","text":" "},{"type":"text","text":"uses CloudKit’s default zone ("},{"type":"codeVoice","code":"_defaultZone"},{"type":"text","text":")."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"init(privateDatabaseForUbiquityContainerIdentifier:schemaVersion:)"},{"type":"text","text":" "},{"type":"text","text":"uses a custom zone named "},{"type":"codeVoice","code":"com.mentalfaculty.ensembles.zone.schema2"},{"type":"text","text":"."}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"E2 had the same two initializers with the same zone behaviour. If you are","type":"text"},{"text":" ","type":"text"},{"text":"migrating an existing E2 fleet to E3 and some users may still be running","type":"text"},{"text":" ","type":"text"},{"text":"E2 during the rollout, ","type":"text"},{"inlineContent":[{"type":"text","text":"use the same initializer in E3 that your E2 build"},{"type":"text","text":" "},{"type":"text","text":"used"}],"type":"strong"},{"text":". Devices in different zones cannot see each other’s records, even","type":"text"},{"text":" ","type":"text"},{"text":"when pointing at the same iCloud container with the same schema version.","type":"text"},{"text":" ","type":"text"},{"text":"Switch to the recommended custom-zone form only after your fleet has fully","type":"text"},{"text":" ","type":"text"},{"text":"migrated.","type":"text"}],"type":"paragraph"},{"text":"Publishing the Schema","anchor":"Publishing-the-Schema","type":"heading","level":2},{"inlineContent":[{"text":"CloudKit schemas must be deployed to production before your app ships.","type":"text"},{"text":" ","type":"text"},{"text":"After testing in the Development environment:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Open "},{"type":"reference","isActive":true,"identifier":"https:\/\/icloud.developer.apple.com\/"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Select your container"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Go to "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Deploy Schema to Production"}]}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Review the record types and deploy"}]}]}],"type":"orderedList"},{"inlineContent":[{"text":"The schema is created automatically in Development when you first run","type":"text"},{"text":" ","type":"text"},{"text":"the app, but it won’t be visible to production users until you deploy it.","type":"text"}],"type":"paragraph"},{"text":"Sharing","anchor":"Sharing","type":"heading","level":2},{"inlineContent":[{"text":"For ","type":"text"},{"code":"CKShare","type":"codeVoice"},{"text":"-based sharing with a custom zone:","type":"text"}],"type":"paragraph"},{"code":["let cloudFS = CloudKitFileSystem(","    ubiquityContainerIdentifier: \"iCloud.com.yourcompany.yourapp\",","    sharingIdentifier: \"com.yourcompany.yourapp.sharing\",","    shareOwnerName: CKCurrentUserDefaultName",")"],"syntax":"swift","type":"codeListing"}],"kind":"content"}],"abstract":[{"text":"A CloudKit-backed cloud file system.","type":"text"}],"identifier":{"url":"doc:\/\/EnsemblesCloudKit\/documentation\/EnsemblesCloudKit\/CloudKitFileSystem","interfaceLanguage":"swift"},"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"references":{"doc://EnsemblesCloudKit/documentation/EnsemblesCloudKit/CloudKitSchemaVersion/v