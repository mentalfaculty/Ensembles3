ntentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"final","kind":"keyword"},{"text":" ","kind":"text"},{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CloudKitFileSystem","kind":"identifier"}],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"inlineContent":[{"text":"Stores files as ","type":"text"},{"code":"CKRecord","type":"codeVoice"},{"text":" objects with ","type":"text"},{"code":"CKAsset","type":"codeVoice"},{"type":"text","text":" attachments. Supports custom"},{"text":" ","type":"text"},{"type":"text","text":"zones, server change token caching for efficient incremental fetches, and"},{"type":"text","text":" "},{"code":"CKShare","type":"codeVoice"},{"type":"text","text":"-based sharing."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Preserves exact "},{"type":"codeVoice","code":"CKRecord"},{"type":"text","text":" type names ("},{"type":"codeVoice","code":"CDEFileSystemNode"},{"type":"text","text":", "},{"type":"codeVoice","code":"CDEItem"},{"type":"text","text":") and field"},{"type":"text","text":" "},{"type":"text","text":"names from the original Objective-C implementation for backwards compatibility."}],"type":"paragraph"},{"level":2,"text":"Setup","anchor":"Setup","type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Enable the "},{"inlineContent":[{"type":"text","text":"iCloud"}],"type":"strong"},{"type":"text","text":" capability in your Xcode project"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Check "},{"inlineContent":[{"type":"text","text":"CloudKit"}],"type":"strong"},{"text":" under iCloud services","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Create or select a CloudKit container (e.g. ","type":"text"},{"type":"codeVoice","code":"iCloud.com.yourcompany.yourapp"},{"type":"text","text":")"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Initialize the file system:","type":"text"}]}]}],"type":"orderedList"},{"syntax":"swift","code":["\/\/ Custom zone in private database (recommended)","let cloudFS = CloudKitFileSystem(","    privateDatabaseForUbiquityContainerIdentifier: \"iCloud.com.yourcompany.yourapp\",","    schemaVersion: .v2",")","","\/\/ Or: default zone with explicit database choice","let cloudFS = CloudKitFileSystem(","    ubiquityContainerIdentifier: \"iCloud.com.yourcompany.yourapp\",","    rootDirectory: \"ensembles\",","    usePublicDatabase: false,","    schemaVersion: .v2",")","","let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MyStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: cloudFS",")"],"type":"codeListing"},{"inlineContent":[{"text":"No API keys or OAuth tokens are needed — CloudKit uses the device’s iCloud","type":"text"},{"text":" ","type":"text"},{"text":"account automatically.","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"text":"Schema Versions","anchor":"Schema-Versions"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/EnsemblesCloudKit\/documentation\/EnsemblesCloudKit\/CloudKitSchemaVersion\/v1","isActive":true},{"text":" — Original schema with separate ","type":"text"},{"type":"codeVoice","code":"CDEDataFile"},{"text":" ","type":"text"},{"type":"text","text":"records. Use this for backward compatibility with existing Ensembles 2"},{"text":" ","type":"text"},{"type":"text","text":"CloudKit data."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/EnsemblesCloudKit\/documentation\/EnsemblesCloudKit\/CloudKitSchemaVersion\/v2","isActive":true,"type":"reference"},{"text":" — Simplified schema without ","type":"text"},{"code":"CDEDataFile","type":"codeVoice"},{"text":" ","type":"text"},{"text":"records. Recommended for new apps.","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","level":2,"text":"Database Scope","anchor":"Database-Scope"},{"inlineContent":[{"text":"Use ","type":"text"},{"code":"usePublicDatabase: false","type":"codeVoice"},{"text":" (private database) for most apps. The private","type":"text"},{"text":" ","type":"text"},{"text":"database syncs across the user’s own devices via their iCloud account.","type":"text"},{"text":" ","type":"text"},{"text":"The public database is shared across all users and requires no iCloud","type":"text"},{"text":" ","type":"text"},{"text":"sign-in, but has different quota limits.","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"text":"Zone Lifetime","anchor":"Zone-Lifetime"},{"inlineContent":[{"text":"An instance is bound to the CloudKit zone incarnation it was primed against: its","type":"text"},{"type":"text","text":" "},{"text":"cached listing and server change token describe that zone’s history and no other.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"If the zone is deleted or recreated outside the framework — in the CloudKit"},{"text":" ","type":"text"},{"text":"Console, with your own CloudKit code, or by the user removing the app’s iCloud","type":"text"},{"text":" ","type":"text"},{"text":"data in Settings — discard the instance and create a fresh one, and treat the","type":"text"},{"text":" ","type":"text"},{"text":"deletion as a full cloud reset: detach and re-attach every device that ever","type":"text"},{"text":" ","type":"text"},{"text":"synced with the zone. Prefer ","type":"text"},{"type":"codeVoice","code":"CoreDataEnsemble.removeEnsemble(withIdentifier:in:)"},{"text":" ","type":"text"},{"text":"for resets you control; it deletes records through the framework, so all local","type":"text"},{"text":" ","type":"text"},{"text":"caches follow along and the zone itself is never destroyed.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"Migrating from Ensembles 2","anchor":"Migrating-from-Ensembles-2"},{"inlineContent":[{"text":"The two private-database initializers write to ","type":"text"},{"inlineContent":[{"text":"different CloudKit zones","type":"text"}],"type":"strong"},{"text":":","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"code":"init(ubiquityContainerIdentifier:rootDirectory:usePublicDatabase:schemaVersion:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"uses CloudKit’s default zone (","type":"text"},{"code":"_defaultZone","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"init(privateDatabaseForUbiquityContainerIdentifier:schemaVersion:)"},{"type":"text","text":" "},{"type":"text","text":"uses a custom zone named "},{"type":"codeVoice","code":"com.mentalfaculty.ensembles.zone.schema2"},{"type":"text","text":"."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"E2 had the same two initializers with the same zone behaviour. If you are","type":"text"},{"text":" ","type":"text"},{"text":"migrating an existing E2 fleet to E3 and some users may still be running","type":"text"},{"text":" ","type":"text"},{"text":"E2 during the rollout, ","type":"text"},{"inlineContent":[{"type":"text","text":"use the same initializer in E3 that your E2 build"},{"type":"text","text":" "},{"type":"text","text":"used"}],"type":"strong"},{"text":". Devices in different zones cannot see each other’s records, even","type":"text"},{"text":" ","type":"text"},{"text":"when pointing at the same iCloud container with the same schema version.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Switch to the recommended custom-zone form only after your fleet has fully"},{"type":"text","text":" "},{"type":"text","text":"migrated."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Publishing the Schema","anchor":"Publishing-the-Schema"},{"inlineContent":[{"type":"text","text":"CloudKit schemas mus