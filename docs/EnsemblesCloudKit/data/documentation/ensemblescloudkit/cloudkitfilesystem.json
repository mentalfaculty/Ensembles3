ice"},{"text":") and field","type":"text"},{"text":" ","type":"text"},{"text":"names from the original Objective-C implementation for backwards compatibility.","type":"text"}]},{"type":"heading","level":2,"text":"Setup","anchor":"Setup"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Enable the "},{"type":"strong","inlineContent":[{"text":"iCloud","type":"text"}]},{"type":"text","text":" capability in your Xcode project"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Check "},{"type":"strong","inlineContent":[{"text":"CloudKit","type":"text"}]},{"type":"text","text":" under iCloud services"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Create or select a CloudKit container (e.g. "},{"type":"codeVoice","code":"iCloud.com.yourcompany.yourapp"},{"type":"text","text":")"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Initialize the file system:"}],"type":"paragraph"}]}]},{"type":"codeListing","code":["\/\/ Custom zone in private database (recommended)","let cloudFS = CloudKitFileSystem(","    privateDatabaseForUbiquityContainerIdentifier: \"iCloud.com.yourcompany.yourapp\",","    schemaVersion: .v2",")","","\/\/ Or: default zone with explicit database choice","let cloudFS = CloudKitFileSystem(","    ubiquityContainerIdentifier: \"iCloud.com.yourcompany.yourapp\",","    rootDirectory: \"ensembles\",","    usePublicDatabase: false,","    schemaVersion: .v2",")","","let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MyStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: cloudFS",")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"No API keys or OAuth tokens are needed — CloudKit uses the device’s iCloud","type":"text"},{"text":" ","type":"text"},{"text":"account automatically.","type":"text"}]},{"type":"heading","level":2,"text":"Schema Versions","anchor":"Schema-Vers