{"sections":[],"metadata":{"symbolKind":"method","title":"suspendSync()","externalID":"s:9Ensembles16CoreDataEnsembleC11suspendSyncyyF","role":"symbol","roleHeading":"Instance Method","modules":[{"name":"Ensembles"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"suspendSync","kind":"identifier"},{"text":"()","kind":"text"}]},"variants":[{"paths":["\/documentation\/ensembles\/coredataensemble\/suspendsync()"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"suspendSync","kind":"identifier"},{"text":"()","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The sync pauses at the next internal checkpoint and waits until"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/resumeSync()"},{"type":"text","text":" is called. Use this from a background-task expiration"},{"type":"text","text":" "},{"type":"text","text":"handler to avoid being killed while keeping progress."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Calls need not be balanced: suspending twice, or resuming when nothing"},{"type":"text","text":" "},{"type":"text","text":"is suspended, is harmless. The next "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/resumeSync()"},{"type":"text","text":" releases the sync"},{"type":"text","text":" "},{"type":"text","text":"whatever came before it."}],"type":"paragraph"}],"kind":"content"}],"identifier":{"url":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/suspendSync()","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Ensembles\/documentation\/Ensembl