mbles\/coredataensemble\/rebasemetrics()","title":"rebaseMetrics()","abstract":[{"type":"text","text":"The figures the framework uses to decide whether a rebase is due."}],"kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/rebaseMetrics()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rebaseMetrics","kind":"identifier"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:9Ensembles13RebaseMetricsV","text":"RebaseMetrics"}]},"doc://Ensembles/documentation/Ensembles/EnsembleError/disallowedStateChange":{"role":"symbol","type":"topic","kind":"symbol","title":"EnsembleError.disallowedStateChange","url":"\/documentation\/ensembles\/ensembleerror\/disallowedstatechange","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"disallowedStateChange"}],"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/EnsembleError\/disallowedStateChange","abstract":[{"type":"text","text":"An invalid state transition was attempted (e.g., merging while not attached, or attaching while attached). Permanent — fix the calling sequence. The containers absorb the one benign instance (two sync triggers racing to attach) internally, so container apps only see this for genuine sequencing mistakes."}]}}}