{"abstract":[{"type":"text","text":"The figures the framework uses to decide whether a rebase is due."}],"hierarchy":{"paths":[["doc:\/\/Ensembles\/documentation\/Ensembles","doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ensembles\/coredataensemble\/rebasemetrics()"]}],"identifier":{"url":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/rebaseMetrics()","interfaceLanguage":"swift"},"kind":"symbol","metadata":{"title":"rebaseMetrics()","role":"symbol","modules":[{"name":"Ensembles"}],"symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rebaseMetrics","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"RebaseMetrics","preciseIdentifier":"s:9Ensembles13RebaseMetricsV","kind":"typeIdentifier"}],"roleHeading":"Instance Method","externalID":"s:9Ensembles16CoreDataEnsembleC13rebaseMetricsAA06RebaseF0VyYaKF"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"rebaseMetrics"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/RebaseMetrics","preciseIdentifier":"s:9Ensembles13RebaseMetricsV","text":"RebaseMetrics"}],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Return Value","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The current metrics. See "},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/RebaseMetrics","type":"reference"},{"type":"text","text":"."}]}]},{"kind":"mentions","mentions":["doc:\/\/Ensembles\/documentation\/Ensembles\/GettingStarted"]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Most apps never need this: a sync rebases when it is worthwhile. Use it to"},{"type":"text","text":" "},{"type":"text","text":"choose the moment yourself. Sync with "},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SyncOptions\/suppressRebase","type":"reference"},{"type":"text","text":" in normal"},{"type":"text","text":" "},{"type":"text","text":"use, and when conditions suit an expensive sync (the device is charging, a"},{"type":"text","text":" "},{"type":"text","text":"background processing task is running), read the metrics and pass"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SyncOptions\/forceRebase","type":"reference"},{"type":"text","text":" if they warrant it."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The call takes its turn with attach, sync and detach, so it never reads the"},{"type":"text","text":" "},{"type":"text","text":"event store while one of those is changing it. If a sync is running it"},{"type":"text","text":" "},{"type":"text","text":"returns after that sync finishes, and if that sync is suspended"},{"type":"text","text":" "},{"type":"text","text":"("},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/suspendSync()","type":"reference"},{"type":"text","text":") it waits until the sync has resumed and finished. It"},{"type":"text","text":" "},{"type":"text","text":"reads only; it does not start a rebase."}]},{"type":"aside","name":"Throws","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/EnsembleError\/disallowedStateChange","isActive":true,"type":"reference"},{"text":" if not attached.","type":"text"}]}]}]}],"references":{"doc://Ensembles/documentation/Ensembles/SyncOptions/suppressRebase":{"role":"symbol","kind":"symbol","url":"\/documentation\/ensembles\/syncoptions\/suppressrebase","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"suppressRebase"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:9Ensembles11SyncOptionsV","text":"SyncOptions"}],"abstract":[{"type":"text","text":"Suppress rebasing, even if it would normally be carried out."}],"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SyncOptions\/suppressRebase","type":"topic","title":"suppressRebase"},"doc://Ensembles/documentation/Ensembles/CoreDataEnsemble":{"type":"topic","url":"\/documentation\/ensembles\/coredataensemble","kind":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CoreDataEnsemble","kind":"identifier"}],"title":"CoreDataEnsemble","role":"symbol","navigatorTitle":[{"text":"CoreDataEnsemble","kind":"identifier"}],"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble","abstract":[{"type":"text","text":"The central class of Ensembles, representing a set of synchronizing persistent stores."}]},"doc://Ensembles/documentation/Ensembles/SyncOptions/forceRebase":{"role":"symbol","type":"topic","title":"forceRebase","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SyncOptions\/forceRebase","abstract":[{"type":"text","text":"Force a rebase to compress sync data. More expensive but reduces storage."}],"url":"\/documentation\/ensembles\/syncoptions\/forcerebase","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"forceRebase"},{"kind":"text","text