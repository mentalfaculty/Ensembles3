{"sections":[],"abstract":[{"type":"text","text":"The figures the framework uses to decide whether a rebase is due."}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ensembles\/coredataensemble\/rebasemetrics()"]}],"identifier":{"url":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/rebaseMetrics()","interfaceLanguage":"swift"},"metadata":{"title":"rebaseMetrics()","roleHeading":"Instance Method","role":"symbol","modules":[{"name":"Ensembles"}],"externalID":"s:9Ensembles16CoreDataEnsembleC13rebaseMetricsAA06RebaseF0VyYaKF","fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"text":"rebaseMetrics","kind":"identifier"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:9Ensembles13RebaseMetricsV","kind":"typeIdentifier","text":"RebaseMetrics"}],"symbolKind":"method"},"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/Ensembles\/documentation\/Ensembles","doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble"]]},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"rebaseMetrics"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/RebaseMetrics","preciseIdentifier":"s:9Ensembles13RebaseMetricsV","text":"RebaseMetrics"}]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Return Value","level":2,"anchor":"return-value"},{"inlineContent":[{"type":"text","text":"The current metrics. See "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/RebaseMetrics","isActive":true,"type":"reference"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"},{"kind":"mentions","mentions":["doc:\/\/Ensembles\/documentation\/Ensembles\/GettingStarted"]},{"content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Most apps never need this: a sync rebases when it is worthwhile. Use it to"},{"type":"text","text":" "},{"type":"text","text":"choose the moment yourself. Sync with "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SyncOptions\/suppressRebase","isActive":true,"type":"reference"},{"type":"text","text":" in normal"},{"type":"text","text":" "},{"type":"text","text":"use, and when conditions suit an expensive sync (the device is charging, a"},{"text":" ","type":"text"},{"text":"background processing task is running), read the metrics and pass","type":"text"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SyncOptions\/forceRebase","isActive":true},{"text":" if they warrant it.","type":"text"}]},{"inlineContent":[{"text":"The call takes its turn with attach, sync and detach, so it never reads the","type":"text"},{"type":"text","text":" "},{"text":"event store while one of those is changing it. If a sync is running it","type":"text"},{"type":"text","text":" "},{"text":"returns after that sync finishes, and if that sync is suspended","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"("},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/suspendSync()","isActive":true},{"type":"text","text":") it waits until the sync has resumed and finished. It"},{"type":"text","text":" "},{"type":"text","text":"reads only; it does not start a rebase."}],"type":"paragraph"},{"style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/EnsembleError\/disallowedStateChange","isActive":true,"type":"reference"},{"type":"text","text":" if not attached."}]}],"name":"Throws"}],"kind":"content"}],"references":{"doc://Ensembles/documentation/Ensembles/SyncOptions/forceRebase":{"abstract":[{"type":"text","text":"Force a rebase to compress sync data. More expensive but reduces storage."}],"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"forceRebase"},{"kind":"text","text":": "},{"preciseIdentifier":"s:9Ensembles11SyncOptionsV","kind":"typeIdentifier","text":"SyncOptions"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SyncOptions\/forceRebase","type":"topic","title":"forceRebase","url":"\/documentation\/ensembles\/syncoptions\/forcerebase"},"doc://Ensembles/documentation/Ensembles/EnsembleError/disallowedStateChange":{"abstract":[{"type":"text","text":"An invalid state transition was attempted (e.g., merging while not attached, or attaching while attached). Permanent — fix the calling sequence. The containers absorb the one benign instance (two sync triggers racing to attach) internally, so container apps only see this for genuine sequencing mistakes."}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"disallowedStateChange"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/EnsembleError\/disallowedStateChange","type":"topic","title":"EnsembleError.disallowedStateChange","url":"\/documentation\/ensembles\/ensembleerror\/disallowedstatechange"},"doc://Ensembles/documentation/Ensembles/CoreDataEnsemble/suspendSync()":{"title":"suspendSync()","type":"topic","role":"symbol","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/suspendSync()","kind":"symbol","url":"\/documentation\/ensembles\/coredataensemble\/suspendsync()","abstract":[{"type":"text","text":"Suspend a sync in progress."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"suspendSync"},{"kind":"text","text":"()"}]},"doc://Ensembles/documentation/Ensembles/RebaseMetrics":{"title":"RebaseMetrics","type":"topic","role":"symbol","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/RebaseMetrics","kind":"symbol","url":"\/documentation\/ensembles\/rebasemetrics","abstract":[{"text":"A snapshot of the figures the framework uses to decide whether a rebase is due.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"RebaseMetrics"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RebaseMetrics"}]},"doc://Ensembles/documentation/Ensembles":{"title":"Ensembles","type":"topic","role":"collection","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles","kind":"symbol","url":"\/documentation\/ensembles","abstract":[{"type":"text","text":"Sync Core Data and SwiftData stores across devices using event sourcing."}]},"doc://Ensembles/documentation/Ensembles/CoreDataEnsemble/rebaseMetrics()":{"title":"rebaseMetrics()","type":"topic","role":"symbol","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/rebaseMetrics()","kind":"symbol","url":"\/documentation\/ensembles\/coredataensemble\/rebasemetrics()","abstract":[{"text":"The figures the framework uses to decide whether a rebase is due.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"rebaseMetrics"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"RebaseMetrics","preciseIdentifier":"s:9Ensembles13RebaseMetricsV"}]},"doc://Ensembles/documentation/Ensembles/GettingStarted":{"type":"topic","url":"\/documentation\/ensembles\/gettingstarted","abstract":[{"type":"text","text":"