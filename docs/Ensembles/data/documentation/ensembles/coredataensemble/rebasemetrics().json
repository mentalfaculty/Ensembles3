rn with attach, sync and detach, so it never reads the"},{"type":"text","text":" "},{"type":"text","text":"event store while one of those is changing it. If a sync is running it"},{"type":"text","text":" "},{"type":"text","text":"returns after that sync finishes, and if that sync is suspended"},{"type":"text","text":" "},{"type":"text","text":"("},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/suspendSync()","type":"reference","isActive":true},{"type":"text","text":") it waits until the sync has resumed and finished. It"},{"type":"text","text":" "},{"type":"text","text":"reads only; it does not start a rebase."}]},{"name":"Throws","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/EnsembleError\/disallowedStateChange","isActive":true,"type":"reference"},{"text":" if not attached.","type":"text"}]}],"style":"note"}]}],"hierarchy":{"paths":[["doc:\/\/Ensembles\/documentation\/Ensembles","doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"The figures the framework uses to decide whether a rebase is due."}],"kind":"symbol","variants":[{"paths":["\/documentation\/ensembles\/coredataensemble\/rebasemetrics()"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"metadata":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rebaseMetrics","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"RebaseMetrics","kind":"typeIdentifier","preciseIdentifier":"s:9Ensembles13RebaseMetricsV"}],"externalID":"s:9Ensembles16CoreDataEnsembleC13rebaseMetricsAA06RebaseF0VyYaKF","modules":[{"name":"Ensembles"}],"symbolKind":"method","role":"symbol","title":"rebaseMetrics()","roleHeading":"Instance Method"