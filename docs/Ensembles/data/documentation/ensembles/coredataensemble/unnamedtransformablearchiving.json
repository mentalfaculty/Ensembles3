{"hierarchy":{"paths":[["doc:\/\/Ensembles\/documentation\/Ensembles","doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble"]]},"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"type":"text","text":"How transformable attributes that name no value transformer in the model are"},{"text":" ","type":"text"},{"type":"text","text":"archived into events and unarchived when merging. Defaults to"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/UnnamedTransformableArchiving\/secureCoding","type":"reference"},{"text":".","type":"text"}],"sections":[],"variants":[{"paths":["\/documentation\/ensembles\/coredataensemble\/unnamedtransformablearchiving"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"unnamedTransformableArchiving"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/UnnamedTransformableArchiving","text":"UnnamedTransformableArchiving","preciseIdentifier":"s:9Ensembles29UnnamedTransformableArchivingO"},{"kind":"text","text":" { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" "},{"kind":"keyword","text":"set"},{"kind":"text","text":" }"}]}]},{"kind":"mentions","mentions":["doc:\/\/Ensembles\/documentation\/Ensembles\/MigratingFromEnsembles2"]},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Core Data itself saves such an attribute with a keyed archive WITHOUT secure coding,"},{"type":"text","text":" "},{"type":"text","text":"as did Ensembles 2. With the default, only Foundation property-list values and the"},{"type":"text","text":" "},{"type":"text","text":"attribute’s declared value class sync; any other value (a class that adopts only"},{"type":"text","text":" "},{"type":"codeVoice","code":"NSCoding"},{"type":"text","text":", or an "},{"type":"codeVoice","code":"NSPredicate"},{"type":"text","text":", "},{"type":"codeVoice","code":"NSAttributedString"},{"type":"text","text":" or colour on an attribute with no"},{"type":"text","text":" "},{"type":"text","text":"declared class) is logged and not synced. If your attributes hold such values, or the"},{"type":"text","text":" "},{"type":"text","text":"cloud holds Ensembles 2 data for them, set this to"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/UnnamedTransformableArchiving\/keyedArchiver"},{"type":"text","text":". Attributes that name a transformer are"},{"type":"text","text":" "},{"type":"text","text":"not affected. Set it before the first attach, and the same on every device. A value"},{"type":"text","text":" "},{"type":"text","text":"refused before the change syncs only when the attribute next changes, or when the"},{"type":"text","text":" "},{"type":"text","text":"store is detached and attached again."}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/unnamedTransformableArchiving","interfaceLanguage":"swift"},"metadata":{"modules":[{"name":"Ensembles"}],"roleHeading":"Instance Property","symbolKind":"property","externalID":"s:9Ensembles16CoreDataEnsembleC29unnamedTransformableArchivingAA07UnnamedfG0Ovp","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"kind":"text","text":" "},{"text":"unnamedTransformableArchiving","kind":"identifier"},{"text":": ","kind":"text"},{"text":"UnnamedTransformableArchiving","kind":"typeIdentifier","preciseIdentifier":"s:9Ensembles29UnnamedTransformableArchivingO"}],"title":"unnamedTransformableArchiving"},"references":{"doc://Ensembles/documentation/Ensembles/UnnamedTransformableArchiving/secureCoding":{"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"secureCoding","kind":"identifier"}],"abstract":[{"type":"text","text":"Secure coding ("},{"code":"NSSecureUnarchiveFromDataTransformer","type":"codeVoice"},{"type":"text","text":" behaviour). Values are decoded"},{"type":"text","text":" "},{"type":"text","text":"against the Foundation plist classes plus the attribute’s declared value class (its"},{"type":"text","text":" "},{"type":"text","text":"Custom Class in the model). Any other value, such as a class that adopts only"},{"type":"text","text":" "},{"code":"NSCoding","type":"codeVoice"},{"type":"text","text":", or an "},{"code":"NSPredicate","type":"codeVoice"},{"type":"text","text":" or "},{"code":"NSAttributedString","type":"codeVoice"},{"type":"text","text":" on an attribute that declares"},{"type":"text","text":" "},{"type":"text","text":"no class, is not synced: its change is logged as an error and left out of the event,"},{"type":"text","text":" "},{"type":"text","text":"so other devices keep their own value. Default."}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/UnnamedTransformableArchiving\/secureCoding","url":"\/documentation\/ensembles\/unnamedtransformablearchiving\/securecoding","type":"topic","title":"UnnamedTransformableArchiving.secureCoding"},"doc://Ensembles/documentation/Ensembles/UnnamedTransformableArchiving/keyedArchiver":{"title":"UnnamedTransformableArchiving.keyedArchiver","url":"\/documentation\/ensembles\/unnamedtransformablearchiving\/keyedarchiver","type":"topic","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/UnnamedTransformableArchiving\/keyedArchiver","abstract":[{"type":"text","text":"Core Data’s own behaviour for a transformable attribute with no transformer name, and"},{"type":"text","text":" "},{"type":"text","text":"that of Ensembles 2: a keyed archive without secure coding. Use it when such an"},{"type":"text","text":" "},{"type":"text","text":"attribute holds classes that adopt only "},{"code":"NSCoding","type":"codeVoice"},{"type":"text","text":", or when the cloud holds data"},{"type":"text","text":" "},{"type":"text","text":"written by Ensembles 2 for such an attribute. Unarchiving instantiates whatever"},{"type":"text","text":" "},{"type":"text","text":"classes the archive names, so use it only for data your own app writes. Give such"},{"type":"text","text":" "},{"type":"text","text":"classes a value-based "},{"code":"isEqual(_:)","type":"codeVoice"},{"type":"text","text":", so that re-applying an unchanged value during a"},{"type":"text","text":" "},{"type":"text","text":"merge is recognised as no change (Core Data relies on the same)."}],"kind":"symbol","role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"keyedArchiver","kind":"identifier"}]},"doc://Ensembles/documentation/Ensembles/MigratingFromEnsembles2":{"abstract":[{"text":"Transition an existing Ensembles 2 (Objective-C) app to Ensembles 3.","type":"text"}],"type":"topic","title":"Migrating from Ensembles 2","kind":"article","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/MigratingFromEnsembles2","url":"\/documentation\/ensembles\/migratingfromensembles2","role":"article"},"doc://Ensembles/documentation/Ensembles":{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles","url":"\/documentation\/ensembles","abstract":[{"type":"text","text":"Sync Core Data and SwiftData stores across devices using event sourcing."}],"type":"topic","kind":"symbol","title":"Ensembles","role":"collection"},"doc://Ensembles/documentation/Ensembles/CoreDataEnsemble":{"title":"CoreDataEnsemble","navigatorTitle":[{"text":"CoreDataEnsemble","kind":"identifier"}],"abstract":[{"type":"text","text":"The central class of Ensembles, representing a set of synchronizing persistent stores."}],"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble","url":"\/documentation\/ensembles\/coredataensemble","type":"topic","role":"symbol","kind":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CoreDataEnsemble","kind":"identifier"}]},"doc://Ensembles/documentation/Ensembles/CoreDataEnsemble/unnamedTransformableArchiving":{"kind":"symbol","abstract":[{"type":"text","text":"How transformable attributes that name no value transformer in the model are"},{"type":"text","text":" "},{"type":"text","text":"archived into events and unarchived when merging. Defaults to"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/UnnamedTransformableArchiving\/secureCoding","type":"reference"},{"type":"text","text":"."}],"url":"\/documentation\/ensembles\/coredataensemble\/unnamedtransformablearchiving","type":"topic","role":"symbol","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/unnamedTransformableArchiving","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"unnamedTransformableArchiving"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"UnnamedTransformableArchiving","preciseIdentifier":"s:9Ensembles29UnnamedTransformableArchivingO"}],"title":"unnamedTransformableArchiving"},"doc://Ensembles/documentation/Ensembles/UnnamedTransformableArchiving":{"title":"UnnamedTransformableArchiving","navigatorTitle":[{"text":"UnnamedTransformableArchiving","kind":"identifier"}],"abstract":[{"text":"How an ensemble archives and unarchives a transformable attribute that names no value","type":"text"},{"text":" ","type":"text"},{"text":"transformer in the model.","type":"text"}],"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/UnnamedTransformableArchiving","url":"\/documentation\/ensembles\/unnamedtransformablearchiving","type":"topic","role":"symbol","kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UnnamedTransformableArchiving","kind":"identifier"}]}}}