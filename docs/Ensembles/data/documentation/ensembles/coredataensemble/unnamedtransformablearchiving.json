that name a transformer are"},{"type":"text","text":" "},{"type":"text","text":"not affected. Set it before the first attach, and the same on every device. A value"},{"type":"text","text":" "},{"type":"text","text":"refused before the change syncs only when the attribute next changes, or when the"},{"type":"text","text":" "},{"type":"text","text":"store is detached and attached again."}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Ensembles\/documentation\/Ensembles","doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/unnamedTransformableArchiving"},"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"unnamedTransformableArchiving"},{"kind":"text","text":": "},{"preciseIdentifier":"s:9Ensembles29UnnamedTransformableArchivingO","kind":"typeIdentifier","text":"UnnamedTransformableArchiving"}],"roleHeading":"Instance Property","role":"symbol","modules":[{"name":"Ensembles"}],"symbolKind":"property","externalID":"s:9Ensembles16CoreDataEnsembleC29unnamedTransformableArchivingAA07UnnamedfG0Ovp","title":"unnamedTransformableArchiving"},"abstract":[{"text":"How transformable attributes that name no value transformer in the model are","type":"text"},{"text":" ","type":"text"},{"text":"archived into events and unarchived when merging. Defaults to","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/UnnamedTransformableArchiving\/secureCoding"},{"text":".","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ensembles\/coredataensemble\/unnamedtransformablearchiving"]}],"references":{"doc://Ensembles/documentation/Ensembles/CoreDataEnsemble":{"title":"CoreDataEnsemble","type":"topic","role":"symbol","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble","kind":"symbol","url":"\/documentation\/ensembles\/coredataensemble","abstract":[{"type":"text","text":"The central class of Ensembles, representing a set of synchronizing persistent stores."}],"navigatorTitle":[{"kind":"identifier","text":"CoreDataEnsemble"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"CoreDataEnsemble"}]},"doc://Ensembles/documentation/Ensembles":{"title":"Ensembles","type":"topic","role":"collection","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles","kind":"symbol","url":"\/documentation\/ensembles","abstract":[{"type":"text","text":"Sync Core Data and SwiftData stores across devices using event sourcing."}]},"doc://Ensembles/documentation/Ensembles/UnnamedTransformableArchiving":{"navigatorTitle":[{"kind":"identifier","text":"UnnamedTransformableArchiving"}],"abstract":[{"type":"text","text":"How an ensemble archives and unarchives a transformable attribute that names no value"},{"type":"text","text":" "},{"type":"text","text":"transformer in the model."}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"UnnamedTransformableArchiving"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/UnnamedTransformableArchiving","type":"topic","title":"UnnamedTransformableArchiving","url":"\/documentation\/ensembles\/unnamedtransformablearchiving"},"doc://Ensembles/documentation/Ensembles/CoreDataEnsemble/unnamedTransformableArchiving":{"abstract":[{"type":"text","text":"How transformable attributes that name no value transformer in the model are"},{"type":"text","text":" "},{"type":"text","text":"archived into events and unarchived when merging. Defaults to"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/UnnamedTransformableArchiving\/secureCoding","isActive":true},{"type":"text","text":"."}],"role":"symbol","title":"unnamedTransformableArchiving","kind":"symbol","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/unnamedTransformableArchiving","type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"unnamedTransformableArchiving"},{"kind":"text","text":": "},{"text":"UnnamedTransformableArchiving","kind":"typeIdentifier","preciseIdentifier":"s:9Ensembles29UnnamedTransformableArchivingO"}],"url":"\/documentation\/ensembles\/coredataensemble\/unnamedtransformablearchiving"},"doc://Ensembles/documentation/Ensembles/MigratingFromEnsembles2":{"url":"\/documentation\/ensembles\/migratingfromensembles2","type":"topic","abstract":[{"text":"Transition an existing Ensembles 2 (Objective-C) app to Ensembles 3.","type":"text"}],"role":"article","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/MigratingFromEnsembles2","title":"Migrating from Ensembles 2","kind":"article"},"doc://Ensembles/documentation/Ensembles/UnnamedTransformableArchiving/keyedArchiver":{"title":"UnnamedTransformableArchiving.keyedArchiver","url":"\/documentation\/ensembles\/unnamedtransformablearchiving\/keyedarchiver","abstract":[{"text":"Core Data’s own behaviour for a transformable attribute with no transformer name, and","type":"text"},{"type":"text","text":" "},{"type":"text","text":"that of Ensembles 2: a keyed archive without secure coding. Use it when such an"},{"text":" ","type":"text"},{"text":"attribute holds classes that adopt only ","type":"text"},{"code":"NSCoding","type":"codeVoice"},{"text":", or when the cloud holds data","type":"text"},{"type":"text","text":" "},{"type":"text","text":"written by Ensembles 2 for such an attribute. Unarchiving instantiates whatever"},{"text":" ","type":"text"},{"text":"classes the archive names, so use it only for data your own app writes. Give such","type":"text"},{"text":" ","type":"text"},{"text":"classes a value-based ","type":"text"},{"type":"codeVoice","code":"isEqual(_:)"},{"text":", so that re-applying an unchanged value during a","type":"text"},{"text":" ","type":"text"},{"text":"merge is recognised as no change (Core Data relies on the same).","type":"text"}],"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/UnnamedTransformableArchiving\/keyedArchiver","role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"keyedArchiver"}],"kind":"symbol","type":"topic"},"doc://Ensembles/documentation/Ensembles/UnnamedTransformableArchiving/secureCoding":{"type":"topic","title":"UnnamedTransformableArchiving.secureCoding","abstract":[{"type":"text","text":"Secure coding ("},{"code":"NSSecureUnarchiveFromDataTransformer","type":"codeVoice"},{"type":"text","text":" behaviour). Values are decoded"},{"type":"text","text":" "},{"type":"text","text":"against the Foundation plist classes plus the attribute’s declared value class (its"},{"text":" ","type":"text"},{"type":"text","text":"Custom Class in the model). Any other value, such as a class that adopts only"},{"type":"text","text":" "},{"code":"NSCoding","type":"codeVoice"},{"type":"text","text":", or an "},{"code":"NSPredicate","type":"codeVoice"},{"type":"text","text":" or "},{"code":"NSAttributedString","type":"codeVoice"},{"type":"text","text":" on an attribute that declares"},{"type":"text","text":" "},{"type":"text","text":"no class, is not synced: its change is logged as an error and left out of the event,"},{"type":"text","text":" "},{"type":"text","text":"so other devices keep their own value. Default."}],"url":"\/documentation\/ensembles\/unnamedtransformablearchiving\/securecoding","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/UnnamedTransformableArchiving\/secureCoding","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"secureCoding"}]}}}