{"abstract":[{"type":"text","text":"How transformable attributes that name no value transformer in the model are"},{"type":"text","text":" "},{"type":"text","text":"archived into events and unarchived when merging. Defaults to"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/UnnamedTransformableArchiving\/secureCoding","isActive":true},{"type":"text","text":"."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ensembles\/coredataensemble\/unnamedtransformablearchiving"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"unnamedTransformableArchiving"},{"kind":"text","text":": "},{"preciseIdentifier":"s:9Ensembles29UnnamedTransformableArchivingO","kind":"typeIdentifier","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/UnnamedTransformableArchiving","text":"UnnamedTransformableArchiving"},{"kind":"text","text":" { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" "},{"kind":"keyword","text":"set"},{"kind":"text","text":" }"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"mentions","mentions":["doc:\/\/Ensembles\/documentation\/Ensembles\/MigratingFromEnsembles2"]},{"content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"inlineContent":[{"text":"Core Data itself saves such an attribute with a keyed archive WITHOUT secure coding,","type":"text"},{"text":" ","type":"text"},{"text":"as did Ensembles 2. With the default, only Foundation property-list values and the","type":"text"},{"text":" ","type":"text"},{"text":"attribute’s declared value class sync; any other value (a class that adopts only","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"NSCoding"},{"text":", or an ","type":"text"},{"type":"codeVoice","code":"NSPredicate"},{"text":", ","type":"text"},{"type":"codeVoice","code":"NSAttributedString"},{"text":" or colour on an attribute with no","type":"text"},{"text":" ","type":"text"},{"text":"declared class) is logged and not synced. If your attributes hold such values, or the","type":"text"},{"text":" ","type":"text"},{"text":"cloud holds Ensembles 2 data for them, set this to","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/UnnamedTransformableArchiving\/keyedArchiver","type":"reference","isActive":true},{"text":". Attributes that name a transformer are","type":"text"},{"text":" ","type":"text"},{"text":"not affected. Set it before the first attach, and the same on every device. A value","type":"text"},{"text":" ","type":"text"},{"text":"refused before the change syncs only when the attribute next changes, or when the","type":"text"},{"text":" ","type":"text"},{"text":"store is detached and attached again.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","metadata":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"unnamedTransformableArchiving","kind":"identifier"},{"text":": ","kind":"text"},{"text":"UnnamedTransformableArchiving","kind":"typeIdentifier","preciseIdentifier":"s:9Ensembles29UnnamedTransformableArchivingO"}],"modules":[{"name":"Ensembles"}],"symbolKind":"property","role":"symbol","externalID":"s:9Ensembles16CoreDataEnsembleC29unnamedTransformableArchivingAA07UnnamedfG0Ovp","title":"unnamedTransformableArchiving","roleHeading":"Instance Property"},"hierarchy":{"paths":[["doc:\/\/Ensembles\/documentation\/Ensembles","doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/unnamedTransformableArchiving"},"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://Ensembles/documentation/Ensembles/UnnamedTransformableArchiving/secureCoding":{"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"secureCoding"}],"role":"symbol","title":"UnnamedTransformableArchiving.secureCoding","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/UnnamedTransformableArchiving\/secureCoding","abstract":[{"text":"Secure coding (","type":"text"},{"type":"codeVoice","code":"NSSecureUnarchiveFromDataTransformer"},{"type":"text","text":" behaviour). Values are decoded"},{"type":"text","text":" "},{"type":"text","text":"against the Foundation plist classes plus the attribute’s declared value class (its"},{"text":" ","type":"text"},{"text":"Custom Class in the model). Any other value, such as a class that adopts only","type":"text"},{"text":" ","type":"text"},{"code":"NSCoding","type":"codeVoice"},{"text":", or an ","type":"text"},{"code":"NSPredicate","type":"codeVoice"},{"type":"text","text":" or "},{"type":"codeVoice","code":"NSAttributedString"},{"type":"text","text":" on an attribute that declares"},{"type":"text","text":" "},{"type":"text","text":"no class, is not synced: its change is logged as an error and left out of the event,"},{"type":"text","text":" "},{"type":"text","text":"so other devices keep their own value. Default."}],"type":"topic","url":"\/documentation\/ensembles\/unnamedtransformablearchiving\/securecoding","kind":"symbol"},"doc://Ensembles/documentation/Ensembles/MigratingFromEnsembles2":{"title":"Migrating from Ensembles 2","type":"topic","kind":"article","role":"article","url":"\/documentation\/ensembles\/migratingfromensembles2","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/MigratingFromEnsembles2","abstract":[{"text":"Transition an existing Ensembles 2 (Objective-C) app to Ensembles 3.","type":"text"}]},"doc://Ensembles/documentation/Ensembles/CoreDataEnsemble":{"title":"CoreDataEnsemble","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CoreDataEnsemble","kind":"identifier"}],"type":"topic","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"CoreDataEnsemble","kind":"identifier"}],"url":"\/documentation\/ensembles\/coredataensemble","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble","abstract":[{"text":"The central class of Ensembles, representing a set of synchronizing persistent stores.","type":"text"}]},"doc://Ensembles/documentation/Ensembles":{"kind":"symbol","url":"\/documentation\/ensembles","type":"topic","title":"Ensembles","role":"collection","abstract":[{"type":"text","text":"Sync Core Data and SwiftData stores across devices using event sourcing."}],"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles"},"doc://Ensembles/documentation/Ensembles/CoreDataEnsemble/unnamedTransformableArchiving":{"type":"topic","url":"\/documentation\/ensembles\/coredataensemble\/unnamedtransformablearchiving","role":"symbol","abstract":[{"type":"text","text":"How transformable attributes that name no value transformer in the model are"},{"type":"text","text":" "},{"text":"archived into events and unarchived when merging. Defaults to","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/UnnamedTransformableArchiving\/secureCoding","type":"reference","isActive":true},{"type":"text","text":"."}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"unnamedTransformableArchiving"},{"kind":"text","text":": "},{"text":"UnnamedTransformableArchiving","preciseIdentifier":"s:9Ensembles29UnnamedTransformableArchivingO","kind":"typeIdentifier"}],"title":"unnamedTransformableArchiving","kind":"symbol","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/unnamedTransformableArchiving"},"doc://Ensembles/documentation/Ensembles/UnnamedTransformableArchiving/keyedArchiver":{"type":"topic","url":"\/documentation\/ensembles\/unnamedtransformablearchiving\/keyedarchiver","role":"symbol","abstract":[{"type":"text","text":"Core Data’s own behaviour for a transformable attribute with no transformer name, and"},{"type":"text","text":" "},{"type":"text","text":"that of Ensembles 2: a keyed archive without secure coding. Use it when such an"},{"type":"text","text":" "},{"type":"text","text":"attribute holds classes that adopt only "},{"code":"NSCoding","type":"codeVoice"},{"type":"text","text":", or when the cloud holds data"},{"type":"text","text":" "},{"type":"text","text":"written by Ensembles 2 for such an attribute. Unarchiving instantiates whatever"},{"type":"text","text":" "},{"type":"text","text":"classes the archive names, so use it only for data your own app writes. Give such"},{"type":"text","text":" "},{"type":"text","text":"classes a value-based "},{"code":"isEqual(_:)","type":"codeVoice"},{"type":"text","text":", so that re-applying an unchanged value during a"},{"type":"text","text":" "},{"type":"text","text":"merge is recognised as no change (Core Data relies on the same)."}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"keyedArchiver"}],"title":"UnnamedTransformableArchiving.keyedArchiver","kind":"symbol","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/UnnamedTransformableArchiving\/keyedArchiver"},"doc://Ensembles/documentation/Ensembles/UnnamedTransformableArchiving":{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/UnnamedTransformableArchiving","abstract":[{"text":"How an ensemble archives and unarchives a transformable attribute that names no value","type":"text"},{"text":" ","type":"text"},{"text":"transformer in the model.","type":"text"}],"url":"\/documentation\/ensembles\/unnamedtransformablearchiving","type":"topic","title":"UnnamedTransformableArchiving","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UnnamedTransformableArchiving","kind":"identifier"}],"navigatorTitle":[{"text":"UnnamedTransformableArchiving","kind":"identifier"}],"kind":"symbol"}}}