{"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dismantle","kind":"identifier"},{"text":"()","kind":"text"}]}]},{"kind":"content","content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"Normally dismantling happens at deallocation. Call this explicitly when you need to","type":"text"},{"text":" ","type":"text"},{"text":"create a replacement ensemble for the same store, to prevent two ensembles from","type":"text"},{"text":" ","type":"text"},{"text":"accessing the same data concurrently.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Returns at once. Captures stop and queued work is cancelled immediately. With no","type":"text"},{"text":" ","type":"text"},{"text":"operation running, the event store is closed before this returns, so a","type":"text"},{"text":" ","type":"text"},{"text":"replacement ensemble can open the same store straight away. While an operation","type":"text"},{"text":" ","type":"text"},{"text":"is running, it finishes its current step and the event store is closed on the","type":"text"},{"text":" ","type":"text"},{"text":"operation queue once it has, so the database is never taken away from work","type":"text"},{"text":" ","type":"text"},{"text":"still using it. A replacement ensemble created straight away opens the store","type":"text"},{"text":" ","type":"text"},{"text":"once the old operation’s current transaction ends, which blocks the creating","type":"text"},{"text":" ","type":"text"},{"text":"thread for that long. If an attach was running, wait for the old ensemble’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"coreDataEnsembleWillEndActivity"},{"text":" notification before creating a replacement","type":"text"},{"text":" ","type":"text"},{"text":"at the same local data root: a stopped attach removes the event store","type":"text"},{"text":" ","type":"text"},{"text":"directory it was building, as any failed attach does.","type":"text"}]}]}],"sections":[],"metadata":{"modules":[{"name":"Ensembles"}],"title":"dismantle()","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dismantle","kind":"identifier"},{"text":"()","kind":"text"}],"roleHeading":"Instance Method","externalID":"s:9Ensembles16CoreDataEnsembleC9dismantleyyF","role":"symbol"},"hierarchy":{"paths":[["doc:\/\/Ensembles\/documentation\/Ensembles","doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble"]]},"identifier":{"url":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/dismantle()","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Forces the ensemble to dismantle, releasing all resources."}],"variants":[{"paths":["\/documentation\/ensembles\/coredataensemble\/dismantle()"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Ensembles/documentation/Ensembles/CoreDataEnsemble":{"title":"CoreDataEnsemble","type":"topic","role":"symbol","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble","kind":"symbol","url":"\/documentation\/ensembles\/coredataensemble","abstract":[{"type":"text","text":"The central class of Ensembles, representing a set of synchronizing persistent stores."}],"navigatorTitle":[{"kind":"identifier","text":"CoreDataEnsemble"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"CoreDataEnsemble"}]},"doc://Ensembles/documentation/Ensembles":{"title":"Ensembles","type":"topic","role":"collection","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles","kind":"symbol","url":"\/documentation\/ensembles","abstract":[{"type":"text","text":"Sync Core Data and SwiftData stores across devices using event sourcing."}]},"doc://Ensembles/documentation/Ensembles/CoreDataEnsemble/dismantle()":{"type":"topic","title":"dismantle()","abstract":[{"text":"Forces the ensemble to dismantle, releasing all resources.","type":"text"}],"url":"\/documentation\/ensembles\/coredataensemble\/dismantle()","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/dismantle()","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"dismantle"},{"kind":"text","text":"()"}]}}}