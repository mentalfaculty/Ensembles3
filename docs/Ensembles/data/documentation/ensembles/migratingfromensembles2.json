mbles","abstract":[{"type":"text","text":"Sync Core Data and SwiftData stores across devices using event sourcing."}],"kind":"symbol","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles","title":"Ensembles","type":"topic"},"doc://Ensembles/documentation/Ensembles/EnsembleError/hardwareIdentityChanged":{"type":"topic","kind":"symbol","title":"EnsembleError.hardwareIdentityChanged","abstract":[{"text":"The hardware identity changed unexpectedly (e.g., restored from a backup to a different device). Forces a detach. Permanent — re-attach to register the new identity.","type":"text"}],"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/EnsembleError\/hardwareIdentityChanged","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hardwareIdentityChanged","kind":"identifier"}],"url":"\/documentation\/ensembles\/ensembleerror\/hardwareidentitychanged","role":"symbol"},"doc://Ensembles/documentation/Ensembles/CoreDataEnsemble/compressModelHashes":{"type":"topic","kind":"symbol","title":"compressModelHashes","abstract":[{"text":"When ","type":"text"},{"type":"codeVoice","code":"true"},{"text":", uses a compressed model hash that ignores entities and properties","type":"text"},{"text":" ","type":"text"},{"text":"marked with the Ensembles ignore key. Defaults to ","type":"text"},{"type":"codeVoice","code":"false"},{"text":".","type":"text"}],"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/compressModelHashes","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"compressModelHashes","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"url":"\/documentation\/ensembles\/coredataensemble\/compressmodelhashes","role":"symbol"},"doc://Ensembles/documentation/Ensembles/ConflictResolution":{"type":"topic","kind":"article","title":"Conflict Resolution","abstract":[{"text":"Understand how Ensembles resolves conflicts and how to customize the process.","type":"text"}],"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/ConflictResolution","url":"\/documentation\/ensembles\/conflictresolution","role":"article"},"doc://Ensembles/documentation/Ensembles/CoreDataEnsemble/detachPersistentStore()":{"type":"topic","role":"symbol","url":"\/documentation\/ensembles\/coredataensemble\/detachpersistentstore()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"detachPersistentStore"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"}],"kind":"symbol","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/detachPersistentStore()","abstract":[{"text":"Detaches the ensemble from peers, terminating syncing.","type":"text"}],"title":"detachPersistentStore()"},"doc://Ensembles/documentation/Ensembles/CoreDataEnsembleDelegate/coreDataEnsemble(_:didDetachWithError:)":{"type":"topic","role":"symbol","defaultImplementations":1,"url":"\/documentation\/ensembles\/coredataensembledelegate\/coredataensemble(_:diddetachwitherror:)","required":true,"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"coreDataEnsemble"},{"kind":"text","text":"("},{"text":"CoreDataEnsemble","kind":"typeIdentifier","preciseIdentifier":"s:9Ensembles16CoreDataEnsembleC"},{"text":", ","kind":"text"},{"text":"didDetachWithError","kind":"externalParam"},{"text":": any ","kind":"text"},{"text":"Error","kind":"typeIdentifier","preciseIdentifier":"s:s5ErrorP"},{"text":")","kind":"text"}],"kind":"symbol","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleDelegate\/coreDataEnsemble(_:didDetachWithError:)","abstract":[{"text":"Invoked when the ensemble is forced to detach due to an unexpected issue.","type":"text"}],"title":"coreDataEnsemble(_:didDetachWithError:)"},"doc://Ensembles/documentation/Ensembles/CompatibilityMode/ensembles2Compatible":{"type":"topic","kind":"symbol","title":"CompatibilityMode.ensembles2Compatible","abstract":[{"text":"Restrict exports to formats parseable by Ensembles 2 peers.","type":"text"}],"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CompatibilityMode\/ensembles2Compatible","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ensembles2Compatible","kind":"identifier"}],"url":"\/documentation\/ensembles\/compatibilitymode\/ensembles2compatible","role":"symbol"},"doc://Ensembles/documentation/Ensembles/CoreDataEnsemble/sync(options:)":{"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sync","kind":"identifier"},{"text":"(","kind":"text"},{"text":"options","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"SyncOptions","preciseIdentifier":"s:9Ensembles11SyncOptionsV","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}],"kind":"symbol","url":"\/documentation\/ensembles\/coredataensemble\/sync(options:)","type":"topic","abstract":[{"text":"Syncs changes with other peers.","type":"text"}],"title":"sync(options:)","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/sync(options:)"},"doc://Ensembles/documentation/Ensembles/EnsembleError/cloudIdentityChanged":{"abstract":[{"text":"The cloud identity changed (e.g., the user signed out of iCloud). Forces a detach. Permanent — re-attach after the user signs back in.","type":"text"}],"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/EnsembleError\/cloudIdentityChanged","title":"EnsembleError.cloudIdentityChanged","role":"symbol","kind":"symbol","type":"topic","url":"\/documentation\/ensembles\/ensembleerror\/cloudidentitychanged","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cloudIdentityChanged","kind":"identifier"}]},"doc://Ensembles/documentation/Ensembles/CoreDataEnsemble":{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble","url":"\/documentation\/ensembles\/coredataensemble","role":"symbol","navigatorTitle":[{"text":"CoreDataEnsemble","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"CoreDataEnsemble"}],"abstract":[{"type":"text","text":"The central class of Ensembles, representing a set of synchronizing persistent stores."}],"type":"topic","kind":"symbol","title":"CoreDataEnsemble"},"doc://Ensembles/documentation/Ensembles/CloudFileSystem":{"kind":"symbol","abstract":[{"text":"A cloud file system facilitates data transfer between devices.","type":"text"}],"role":"symbol","type":"topic","url":"\/documentation\/ensembles\/cloudfilesystem","title":"CloudFileSystem","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CloudFileSystem","kind":"identifier"}],"navigatorTitle":[{"text":"CloudFileSystem","kind":"identifier"}]}}}