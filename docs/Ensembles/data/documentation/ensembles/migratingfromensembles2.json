{"metadata":{"roleHeading":"Article","modules":[{"name":"Ensembles"}],"role":"article","title":"Migrating from Ensembles 2"},"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"url":"doc:\/\/Ensembles\/documentation\/Ensembles\/MigratingFromEnsembles2","interfaceLanguage":"swift"},"sections":[],"abstract":[{"text":"Transition an existing Ensembles 2 (Objective-C) app to Ensembles 3.","type":"text"}],"kind":"article","seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/Ensembles\/documentation\/Ensembles\/CompatibilityMode","doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble","doc:\/\/Ensembles\/documentation\/Ensembles\/GettingStarted"],"anchor":"Related-Documentation"},{"title":"Articles","identifiers":["doc:\/\/Ensembles\/documentation\/Ensembles\/Architecture","doc:\/\/Ensembles\/documentation\/Ensembles\/ConflictResolution","doc:\/\/Ensembles\/documentation\/Ensembles\/SyncLifecycle","doc:\/\/Ensembles\/documentation\/Ensembles\/CustomCloudBackends"],"generated":true,"anchor":"Articles"}],"hierarchy":{"paths":[["doc:\/\/Ensembles\/documentation\/Ensembles"]]},"primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Ensembles 3 is fully backward compatible with Ensembles 2 "},{"type":"emphasis","inlineContent":[{"type":"text","text":"cloud"}]},{"type":"text","text":" data — existing cloud files and CloudKit records are all readable by E3 out of the box, so a migrated device picks up the rest of the ensemble’s history from the cloud on its first sync. The local event store does not carry across; see "},{"inlineContent":[{"type":"text","text":"What Resets on Migration"}],"type":"emphasis"},{"type":"text","text":" below."}]},{"type":"heading","level":3,"text":"What’s Backward Compatible","anchor":"Whats-Backward-Compatible"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Cloud files"}]},{"type":"text","text":" — The directory structure and file formats in the cloud are identical. E3 reads all E2 cloud data."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"JSON format","type":"text"}]},{"type":"text","text":" — Property change values use the same JSON serialization."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"CloudKit records"}]},{"type":"text","text":" — Record types ("},{"type":"codeVoice","code":"CDEFileSystemNode"},{"type":"text","text":", "},{"type":"codeVoice","code":"CDEItem"},{"type":"text","text":", "},{"type":"codeVoice","code":"CDEDataFile"},{"type":"text","text":") and field names are preserved."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Encryption","type":"text"}]},{"type":"text","text":" — E3’s "},{"type":"codeVoice","code":".legacy"},{"type":"text","text":" encryption format (RNCryptor v3) matches E2’s "},{"type":"codeVoice","code":"CDEEncryptedCloudFileSystem"},{"type":"text","text":"."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Reading E2 data works regardless of compatibility mode — compatibility mode only restricts what E3 "},{"type":"emphasis","inlineContent":[{"type":"text","text":"exports"}]},{"type":"text","text":"."}]},{"level":3,"type":"heading","text":"What Resets on Migration","anchor":"What-Resets-on-Migration"},{"inlineContent":[{"type":"text","text":"The local event store does "},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" carry across. E3 uses a different on-disk database format (raw SQLite vs. E2’s Core Data store), and there is no automatic conversion. On the first call to "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/attachPersistentStore(seedPolicy:)","isActive":true},{"type":"text","text":" after the swap, E3 deletes the existing event-data directory and registers as a fresh peer with the cloud. Your app’s persistent store (your own Core Data or SwiftData SQLite) is untouched — only Ensembles’ internal event-tracking database is reset."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Practically, this means:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A new "},{"type":"codeVoice","code":"CoreDataEnsemble\/persistentStoreIdentifier"},{"type":"text","text":" is generated, so to the cloud and to other peers the migrated device looks like a new device joining the ensemble."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"E3 pulls the current baseline from the cloud and integrates it, so the user’s data ends up consistent with the rest of the ensemble."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The user’s data is not at risk: the attach imports the "},{"type":"strong","inlineContent":[{"type":"text","text":"entire local store"}]},{"type":"text","text":" (with the default "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SeedPolicy\/mergeAllData","isActive":true},{"type":"text","text":") and merges it with the cloud by global identifier, so local changes survive even if the E2 build never got to upload them. The one thing that cannot carry across is an unsynced "},{"type":"emphasis","inlineContent":[{"type":"text","text":"deletion"}]},{"type":"text","text":": an object deleted in E2 whose deletion event never reached the cloud no longer exists in the local store, so the re-import cannot know about it, and the object returns from the cloud after migration. If clean deletions matter for your migration window, have the E2 build sync to completion before the upgrade; otherwise migration order doesn’t matter."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The first attach also produces a forced detach with "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/EnsembleError\/cloudIdentityChanged","isActive":true},{"type":"text","text":" — see step 5 below."}]},{"level":3,"type":"heading","text":"Transformable Attributes","anchor":"Transformable-Attributes"},{"inlineContent":[{"type":"text","text":"If your model has a transformable attribute (for example a "},{"type":"codeVoice","code":"CLLocation"},{"type":"text","text":" stored via a value transformer), E3 reads the value E2 wrote: the value is archived to "},{"type":"codeVoice","code":"Data"},{"type":"text","text":" and stored as a base64 blob in the cloud event. There is no format-level migration to do. (Note: Ensembles 2 base64-encodes those blobs in line-wrapped form; reading them correctly requires Ensembles 3 "},{"type":"codeVoice","code":"3.0.0"},{"type":"text","text":" or later — earlier builds dropped line-wrapped transformable values on import, which surfaced as the attribute arriving nil on the E3 device.)"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A couple of things to get right:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Use a named transformer."}]},{"type":"text","text":" Give the attribute a "},{"type":"codeVoice","code":"valueTransformerName"},{"type":"text","text":" in your model and an "},{"type":"codeVoice","code":"NSSecureUnarchiveFromDataTransformer"},{"type":"text","text":" subclass that lists the stored class in "},{"type":"codeVoice","code":"allowedTopLevelClasses"},{"type":"text","text":". Mark the class "},{"type":"codeVoice","code":"@objc(YourTransformerName)"},{"type":"text","text":" so the runtime name matches the model. This is the same setup E2 used."}]},{"type":"codeListing","syntax":"swift","code":["@objc(CLLocationValueTransformer)","final class CLLocationValueTransformer: NSSecureUnarchiveFromDataTransformer {","    static let name = NSValueTransformerName(\"CLLocationValueTransformer\")","    override class var allowedTopLevelClasses: [AnyClass] { [CLLocation.self] }","    static func register() {","        ValueTransformer.setValueTransformer(CLLocationValueTransformer(), forName: name)","    }","}"]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Register before sync, on every launch, on every device."}]},{"type":"text","text":" Transformer registration is a process-global table that does not persist, so call "},{"type":"codeVoice","code":"register()"},{"type":"text","text":" early — at the top of "},{"type":"codeVoice","code":"application(_:didFinishLaunchingWithOptions:)"},{"type":"text","text":" or your "},{"type":"codeVoice","code":"App"},{"type":"text","text":" "},{"type":"codeVoice","code":"init()"},{"type":"text","text":", before you create the ensemble. If the transformer is missing when E3 integrates a remote event, the attribute decodes to nil and that nil merges into the local store, blanking the value. With verbose logging on ("},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/setLoggingLevel(_:)","isActive":true},{"type":"text","text":" with "},{"type":"codeVoice","code":".verbose"},{"type":"text","text":"), the line to look for is "},{"type":"codeVoice","code":"Failed to retrieve value transformer:"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"A blank Transformer field works, with a caveat.","type":"text"}]},{"type":"text","text":" If you leave the model’s Transformer field empty, E3 falls back to a secure unarchive that allows the attribute’s declared value class plus the Foundation property-list types. A value whose class is neither (and with no declared value class on the attribute) decodes to nil rather than being deserialized. A non-decodable or foreign blob always degrades to nil and logs; it never crashes. For a custom class, prefer a named transformer so the class is explicitly allowlisted."}]}]}]},{"type":"heading","level":3,"text":"Step-by-Step Migration","anchor":"Step-by-Step-Migration"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"1. Swap the dependency"}],"type":"strong"}]},{"type":"paragraph","inlineContent":[{"text":"Replace the Ensembles 2 CocoaPod or framework with the Ensembles 3 Swift package:","type":"text"}]},{"code":["\/\/ Package.swift",".package(url: \"https:\/\/github.com\/mentalfaculty\/Ensembles3.git\", from: \"3.0.0\")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Or add it via Xcode’s ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"Add Package Dependencies"}]},{"text":" menu.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"2. Set compatibility mode","type":"text"}]}]},{"type":"paragraph","inlineContent":[{"text":"If some users may still be running the E2 version of your app, set ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CompatibilityMode\/ensembles2Compatible"},{"text":" so E3 restricts its exports to formats E2 peers can parse:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ With a container","let config = EnsembleContainerConfiguration(","    compatibilityMode: .ensembles2Compatible",")","let container = CoreDataEnsembleContainer(","    name: \"MainStore\",","    storeURL: storeURL,","    modelURL: modelURL,","    cloudFileSystem: cloudFS,","    configuration: config",")","","\/\/ Or directly on an ensemble","ensemble.compatibilityMode = .ensembles2Compatible"]},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"3. Match your existing CloudKit zone (CloudKit users only)"}]}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If your existing E2 fleet uses "},{"code":"CloudKitFileSystem","type":"codeVoice"},{"type":"text","text":", the most important thing to get right is which initializer you call. Both E2 and E3 expose two private-database initializers, and they pick different CloudKit zones:"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Initializer"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Zone"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"init(ubiquityContainerIdentifier:rootDirectory:usePublicDatabase:schemaVersion:)"}]}],[{"inlineContent":[{"type":"text","text":"CloudKit’s default zone ("},{"type":"codeVoice","code":"_defaultZone"},{"type":"text","text":")"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"init(privateDatabaseForUbiquityContainerIdentifier:schemaVersion:)"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Custom zone "},{"type":"codeVoice","code":"com.mentalfaculty.ensembles.zone.schema2"}]}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Your E3 build must use the "},{"type":"strong","inlineContent":[{"type":"text","text":"same initializer"}]},{"type":"text","text":" as the E2 build it is replacing. If the two devices end up in different zones they cannot see each other’s records, even though they are pointed at the same iCloud container with the same schema version. The symptom is "},{"type":"codeVoice","code":"❌ SYNC ERROR Code: 2 - Description: Failed to fetch some records"},{"type":"text","text":" on the still-E2 devices, with the repair path’s “Located some items in CloudKit without data” log."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To find out which zone your E2 fleet is on, look at the "},{"type":"codeVoice","code":"CDECloudKitFileSystem"},{"type":"text","text":" init in your existing E2 source. If it calls "},{"type":"codeVoice","code":"initWithUbiquityContainerIdentifier:rootDirectory:usePublicDatabase:schemaVersion:"},{"type":"text","text":", you’re on the default zone — call the matching E3 init. If it calls "},{"code":"initWithPrivateDatabaseForUbiquityContainerIdentifier:schemaVersion:","type":"codeVoice"},{"type":"text","text":", you’re on the custom zone — call the matching E3 init. Don’t switch initializers as part of the migration; switch only after the entire fleet is on E3."}]},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"4. Update API names"}]}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Ensembles 3 uses different class and method names:"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Ensembles 2 (Objective-C)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Ensembles 3 (Swift)"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"CDEPersistentStoreEnsemble","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble","isActive":true}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"CDEPersistentStoreEnsembleDelegate"}]}],[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleDelegate","isActive":true}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"leechPersistentStore(...)"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"CoreDataEnsemble\/attachPersistentStore()"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"deleechPersistentStore(...)"}]}],[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/detachPersistentStore()","isActive":true}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"mergeWithCompletion:"}]}],[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/sync(options:)","isActive":true}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"CDECloudFileSystem"}]}],[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem","isActive":true}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"CDEEncryptedCloudFileSystem"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"EncryptedCloudFileSystem"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"CDECloudKitFileSystem"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"CloudKitFileSystem"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"CDEICloudFileSystem"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ICloudDriveFileSystem"},{"type":"text","text":" (module "},{"type":"codeVoice","code":"EnsemblesiCloudDrive"},{"type":"text","text":")"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"CDELocalCloudFileSystem"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"LocalCloudFileSystem"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"CDEMultipeerCloudFileSystem"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MultipeerCloudFileSystem"},{"type":"text","text":" (package trait "},{"type":"codeVoice","code":"Multipeer"},{"type":"text","text":")"}]}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A note on the iCloud Drive backend: "},{"code":"ICloudDriveFileSystem","type":"codeVoice"},{"type":"text","text":" is deprecated in favor of CloudKit for new apps, but it is fully supported and exists precisely so an E2 app that syncs via "},{"code":"CDEICloudFileSystem","type":"codeVoice"},{"type":"text","text":" can migrate against the "},{"inlineContent":[{"type":"text","text":"same cloud data"}],"type":"strong"},{"type":"text","text":". Do not switch backends as part of the migration — a backend is a separate cloud location, so switching resets sync data for the fleet. Keep iCloud Drive while migrating; if you later want CloudKit, plan it as its own coordinated transition."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"5. Handle the first-launch identity detach"}]}]},{"inlineContent":[{"type":"text","text":"On the first launch after migrating from E2, expect a forced detach with "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/EnsembleError\/cloudIdentityChanged","isActive":true},{"type":"text","text":" (code 202). The first attach in E3 wipes the existing E2 event store and registers a fresh peer, but the cached cloud identity token is not carried across either. The first identity check after attach sees no stored token, treats it as an account change, and forces a detach."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Re-attaching immediately captures the current identity and steady state resumes. If your app responds to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleDelegate\/coreDataEnsemble(_:didDetachWithError:)"},{"type":"text","text":" by disabling sync, every migrating user will silently lose sync until they toggle it back on. Handle this case explicitly:"}]},{"syntax":"swift","type":"codeListing","code":["func coreDataEnsemble(","    _ ensemble: CoreDataEnsemble,","    didDetachWithError error: Error",") {","    if let error = error as? EnsembleError, error == .cloudIdentityChanged {","        \/\/ First launch after E2 → E3 migration, or a real account change.","        \/\/ Re-attach rather than disabling sync.","        Task {","            try? await Task.sleep(for: .seconds(1))","            try? await ensemble.attachPersistentStore()","        }","        return","    }","    \/\/ Other errors: disable sync and surface to the user.","}"]},{"inlineContent":[{"type":"text","text":"The same pattern applies to "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/EnsembleError\/hardwareIdentityChanged","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/EnsembleError\/storeUnregistered","isActive":true},{"type":"text","text":" in general — all three are recoverable by re-attaching. Errors like "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/EnsembleError\/dataCorruptionDetected","isActive":true},{"type":"text","text":" do warrant disabling sync until the user intervenes."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"6. Test thoroughly"}],"type":"strong"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Verify your app can read existing cloud data from E2 peers."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Confirm that E2 peers can still read data exported by your E3 build (while in "},{"type":"codeVoice","code":".ensembles2Compatible"},{"type":"text","text":" mode)."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Test attachment, sync, and detach cycles."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Test the first-launch reset on a device that previously ran E2 — including the "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/EnsembleError\/cloudIdentityChanged","isActive":true},{"type":"text","text":" recovery path."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"7. Switch to full E3 mode"}]}]},{"inlineContent":[{"type":"text","text":"Once all users have upgraded to the E3 version of your app, change the compatibility mode so future E3-only features become available:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["ensemble.compatibilityMode = .ensembles3  \/\/ the default"]},{"type":"aside","style":"important","content":[{"inlineContent":[{"type":"text","text":"Only flip back to "},{"type":"codeVoice","code":".ensembles3"},{"type":"text","text":" once your E2 fleet is gone. Today the practical effect is small — the only wire-level difference is gated by "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/compressModelHashes","isActive":true},{"type":"text","text":", which defaults to "},{"type":"codeVoice","code":"false"},{"type":"text","text":" even in "},{"type":"codeVoice","code":".ensembles3"},{"type":"text","text":" mode, so until you opt in to that flag the two modes produce identical exports. But if any E3 device starts producing compressed-hash exports, E2 peers can’t parse them and stop receiving updates from that device — effectively forcing the E2 holdouts to upgrade."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Two E3 devices in different compatibility modes (one "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CompatibilityMode\/ensembles2Compatible"},{"type":"text","text":", one "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CompatibilityMode\/ensembles3"},{"type":"text","text":") sync with each other normally — the mode setting only restricts "},{"inlineContent":[{"type":"text","text":"writes"}],"type":"emphasis"},{"type":"text","text":"; reads handle both formats unconditionally. Mixing modes within an E3 fleet is safe."}]}],"name":"Important"},{"type":"heading","level":3,"text":"Coming from the Idiomatic Sample (`IDMSyncManager`)","anchor":"Coming-from-the-Idiomatic-Sample-IDMSyncManager"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Many Ensembles 1.x and 2 apps are structured around the old Idiomatic sample’s "},{"type":"codeVoice","code":"IDMSyncManager"},{"type":"text","text":" singleton. The current Idiomatic example is a from-scratch SwiftData app, so it is "},{"type":"emphasis","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" a useful migration template for those apps — map your existing sync manager’s responsibilities instead. Most of what "},{"code":"IDMSyncManager","type":"codeVoice"},{"type":"text","text":" did by hand is now built into "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleContainer"},{"type":"text","text":":"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"IDMSyncManager"},{"type":"text","text":" responsibility"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Ensembles 3 equivalent"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"+sharedSyncManager"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"setup"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Create one "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleContainer","isActive":true},{"type":"text","text":" at launch"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"connectToSyncService:withCompletion:"},{"type":"text","text":" (create file system + leech)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Pass the backend to the container; the first "},{"type":"codeVoice","code":"sync()"},{"type":"text","text":" attaches automatically"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"synchronizeWithCompletion:"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"container.sync()"},{"type":"text","text":" — and "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/AutoSyncPolicy","isActive":true},{"type":"text","text":" replaces the hand-rolled save\/timer\/activation triggers"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"disconnectFromSyncServiceWithCompletion:"},{"type":"text","text":" (deleech)"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"container.detach()"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"persistentStoreEnsemble:didSaveMergeChangesWithNotification:"},{"type":"text","text":" (merge into main context)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Handled automatically by the container’s view-context merging; use its "},{"type":"codeVoice","code":"didSaveMergeChanges"},{"type":"text","text":" callback only for extra work"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"persistentStoreEnsemble:globalIdentifiersForManagedObjects:"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The container’s "},{"type":"codeVoice","code":"globalIdentifiers"},{"type":"text","text":" closure, or "},{"type":"codeVoice","code":"Syncable"},{"type":"text","text":" conformances"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"persistentStoreEnsemble:didDeleechWithError:"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The container’s "},{"type":"codeVoice","code":"didForceDetach"},{"type":"text","text":" callback"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"reset"},{"type":"text","text":" (deleech + remove local data)"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"container.detach()"},{"type":"text","text":"; to remove the cloud data too, "},{"type":"codeVoice","code":"CoreDataEnsemble.removeEnsemble(withIdentifier:in:)"}]}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"One behavioral difference to plan for: Ensembles 3 "},{"inlineContent":[{"type":"text","text":"requires"}],"type":"strong"},{"type":"text","text":" a source of global identifiers — the container’s "},{"type":"codeVoice","code":"globalIdentifiers"},{"type":"text","text":" closure or "},{"type":"codeVoice","code":"Syncable"},{"type":"text","text":" conformances — and refuses to attach without one ("},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/EnsembleError\/missingGlobalIdentifierSource","isActive":true},{"type":"text","text":", code 220). Ensembles 2 allowed returning nil. If your "},{"type":"codeVoice","code":"IDMSyncManager"},{"type":"text","text":" already implements "},{"type":"codeVoice","code":"globalIdentifiersForManagedObjects:"},{"type":"text","text":", port that logic; the identifiers must be stable and match what your E2 build supplied, or objects will duplicate."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"These steps apply equally if you are still on the open-source Ensembles 1.x: Ensembles 2 retained Ensembles 1’s cloud formats, and Ensembles 3 reads both the same way."}]},{"type":"heading","level":3,"text":"Using Ensembles 3 from Objective-C","anchor":"Using-Ensembles-3-from-Objective-C"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Ensembles 3 is a Swift framework with async\/await APIs and is not callable from Objective-C directly. That does not mean rewriting your app: keep the app in Objective-C, and replace the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"internals"}]},{"type":"text","text":" of your sync manager with a small Swift file that exposes an "},{"code":"@objc","type":"codeVoice"},{"type":"text","text":" interface. Your existing call sites stay untouched:"}]},{"type":"codeListing","syntax":"swift","code":["import Ensembles","import EnsemblesiCloudDrive","","@objc(IDMSyncManager)","final class SyncManager: NSObject {","    @objc static let shared = SyncManager()","","    private var container: CoreDataEnsembleContainer?","","    @objc func setup(storeURL: URL, modelURL: URL) {","        let config = EnsembleContainerConfiguration(","            compatibilityMode: .ensembles2Compatible","        )","        container = CoreDataEnsembleContainer(","            name: \"MainStore\",","            storeURL: storeURL,","            modelURL: modelURL,","            cloudFileSystem: ICloudDriveFileSystem(),   \/\/ default iCloud container, E2's data path","            configuration: config","        )","        container?.globalIdentifiers = { objects in","            \/\/ Port your globalIdentifiersForManagedObjects: logic here.","            objects.map { $0.value(forKey: \"uniqueIdentifier\") as! String }","        }","    }","","    @objc func synchronize(completion: @escaping (Bool) -> Void) {","        Task {","            let success = await container?.sync() ?? false","            completion(success)","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"With "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/AutoSyncPolicy\/all","isActive":true},{"type":"text","text":" (the default), the explicit "},{"type":"codeVoice","code":"synchronize"},{"type":"text","text":" call is only needed where your UI wants a completion — the container already syncs on save, on a timer, and on app activation."}]},{"type":"heading","level":3,"text":"What `ensembles2Compatible` Restricts","anchor":"What-ensembles2Compatible-Restricts"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Currently, "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CompatibilityMode\/ensembles2Compatible","isActive":true},{"type":"text","text":" applies one restriction:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Model hashes","type":"text"}],"type":"strong"},{"type":"text","text":": Forces "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/compressModelHashes"},{"type":"text","text":" to "},{"type":"codeVoice","code":"false"},{"type":"text","text":", so model version hashes use the full XML property list format that E2 peers can parse."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"No other export behavior is changed. As E3 evolves, additional restrictions may be added to this mode to maintain E2 compatibility."}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ensembles\/migratingfromensembles2"]}],"references":{"doc://Ensembles/documentation/Ensembles/AutoSyncPolicy":{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/AutoSyncPolicy","url":"\/documentation\/ensembles\/autosyncpolicy","title":"AutoSyncPolicy","type":"topic","abstract":[{"type":"text","text":"Controls when automatic merges occur."}],"kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AutoSyncPolicy","kind":"identifier"}],"navigatorTitle":[{"text":"AutoSyncPolicy","kind":"identifier"}]},"doc://Ensembles/documentation/Ensembles/CoreDataEnsemble":{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble","url":"\/documentation\/ensembles\/coredataensemble","type":"topic","title":"CoreDataEnsemble","abstract":[{"type":"text","text":"The central class of Ensembles, representing a set of synchronizing persistent stores."}],"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"CoreDataEnsemble"}],"navigatorTitle":[{"kind":"identifier","text":"CoreDataEnsemble"}]},"doc://Ensembles/documentation/Ensembles/CoreDataEnsembleDelegate":{"role":"symbol","type":"topic","url":"\/documentation\/ensembles\/coredataensembledelegate","identif