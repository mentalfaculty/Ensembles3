{"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"storeURI","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?","kind":"text"}],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"inlineContent":[{"type":"text","text":"Device-local by design: it must never be synced, exported, or adopted"},{"type":"text","text":" "},{"type":"text","text":"from another device’s data. Object URIs carry a store UUID and primary"},{"type":"text","text":" "},{"type":"text","text":"key, so a foreign URI is meaningless here at best — and on a device"},{"type":"text","text":" "},{"type":"text","text":"restored from another device’s backup (matching store UUID) it can"},{"type":"text","text":" "},{"type":"text","text":"resolve to the wrong object. Entries are disposable: a missing or stale"},{"type":"text","text":" "},{"type":"text","text":"URI is re-populated wherever the object surfaces next — attach import,"},{"type":"text","text":" "},{"type":"text","text":"save capture, or integration creating the object for an insert change."},{"type":"text","text":" "},{"type":"text","text":"(An update or delete change whose identifier has no usable URI is"},{"type":"text","text":" "},{"type":"text","text":"skipped for that pass, not re-resolved.)"}],"type":"paragraph"}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"type":"text","text":"The local object’s "},{"type":"codeVoice","code":"NSManagedObjectID"},{"type":"text","text":" URI — the essential mapping from"},{"type":"text","text":" "},{"text":"this global identifier to its row in THIS device’s persistent store,","type":"text"},{"text":" ","type":"text"},{"text":"used by integration to locate the object for incoming changes.","type":"text"}],"metadata":{"externalID":"s:9Ensembles16GlobalIdentifierV8storeURISSSgvp","symbolKind":"property","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"storeURI","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?","kind":"text"}],"modules":[{"name":"Ensembles"}],"title":"storeURI","roleHeading":"Instance Property"},"sections":[],"kind":"symbol","identifier":{"url":"doc:\/\/Ensembles\/documentation\/Ensembles\/GlobalIdentifier\/storeURI","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Ensembles\/documentation\/Ensembles","doc:\/\/Ensembles\/documentation\/Ensembles\/GlobalIdentifier"]]},"variants":[{"paths":["\/documentation\/ensembles\/globalidentifier\/storeuri"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Ensembles/documentation/Ensembles/GlobalIdentifier/storeURI":{"type":"topic","abstract":[{"type":"text","text":"The local object’s "},{"type":"codeVoice","code":"NSManagedObjectID"},{"type":"text","text":" URI — the essential mapping from"},{"type":"text","text":" "},{"type":"text","text":"this global identifier to its row in THIS device’s persistent store,"},{"type":"text","text":" "},{"type":"text","text":"used by integration to locate the object for incoming changes."}],"url":"\/documentation\/ensembles\/globalidentifier\/storeuri","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"storeURI"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?"}],"title":"storeURI","kind":"symbol","role":"symbol","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/GlobalIdentifier\/storeURI"},"doc://Ensembles/documentation/Ensembles/GlobalIdentifier":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GlobalIdentifier","kind":"identifier"}],"type":"topic","kind":"symbol","identifier":"doc:\/