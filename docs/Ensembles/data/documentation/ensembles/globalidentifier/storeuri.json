{"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/Ensembles\/documentation\/Ensembles\/GlobalIdentifier\/storeURI","interfaceLanguage":"swift"},"sections":[],"hierarchy":{"paths":[["doc:\/\/Ensembles\/documentation\/Ensembles","doc:\/\/Ensembles\/documentation\/Ensembles\/GlobalIdentifier"]]},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"storeURI"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?"}]}],"kind":"declarations"},{"content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"Device-local by design: it must never be synced, exported, or adopted","type":"text"},{"type":"text","text":" "},{"type":"text","text":"from another device’s data. Object URIs carry a store UUID and primary"},{"type":"text","text":" "},{"text":"key, so a foreign URI is meaningless here at best — and on a device","type":"text"},{"text":" ","type":"text"},{"text":"restored from another device’s backup (matching store UUID) it can","type":"text"},{"text":" ","type":"text"},{"text":"resolve to the wrong object. Entries are disposable: a missing or stale","type":"text"},{"text":" ","type":"text"},{"text":"URI is re-populated wherever the object surfaces next — attach import,","type":"text"},{"text":" ","type":"text"},{"text":"save capture, or integration creating the object for an insert change.","type":"text"},{"text":" ","type":"text"},{"text":"(An update or delete change whose identifier has no usable URI is","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"skipped for that pass, not re-resolved.)"}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ensembles\/globalidentifier\/storeuri"]}],"metadata":{"role":"symbol",