":"retrieveEnsembleIdentifiers(from:)","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Queries a cloud file system for the identifiers of the ensembles it contains."}],"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/retrieveEnsembleIdentifiers(from:)","url":"\/documentation\/ensembles\/coredataensemble\/retrieveensembleidentifiers(from:)"},"doc://Ensembles/documentation/Ensembles/CustomCloudBackends":{"kind":"article","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CustomCloudBackends","abstract":[{"type":"text","text":"Implement the CloudFileSystem protocol to sync via any storage service."}],"url":"\/documentation\/ensembles\/customcloudbackends","title":"Custom Cloud Backends","type":"topic","role":"article"},"doc://Ensembles/documentation/Ensembles/CloudFileSystemSetup/setLocalStoreDirectory(_:discardingExistingCache:)-1faby":{"abstract":[{"type":"text","text":"Backends that keep no persistent listing cache need do nothing here."}],"type":"topic","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup\/setLocalStoreDirectory(_:discardingExistingCache:)-1faby","title":"setLocalStoreDirectory(_:discardingExistingCache:)","url":"\/documentation\/ensembles\/cloudfilesystemsetup\/setlocalstoredirectory(_:discardingexistingcache:)-1faby","kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"setLocalStoreDirectory","kind":"identifier"},{"text":"(","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?, ","kind":"text"},{"text":"discardingExistingCache","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":")","kind":"text"}]}}}