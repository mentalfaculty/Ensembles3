{"abstract":[{"type":"text","text":"Tells the file system which local directory belongs to the event store it is serving."}],"metadata":{"role":"symbol","roleHeading":"Instance Method","externalID":"s:9Ensembles20CloudFileSystemSetupP22setLocalStoreDirectory_23discardingExistingCacheySSSg_SbtF","required":true,"symbolKind":"method","modules":[{"name":"Ensembles"}],"title":"setLocalStoreDirectory(_:discardingExistingCache:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"setLocalStoreDirectory"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"discardingExistingCache"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":")"}]},"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"setLocalStoreDirectory","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"path","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?, ","kind":"text"},{"text":"discardingExistingCache","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":")","kind":"text"}],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"path","content":[{"inlineContent":[{"type":"text","text":"The event store’s directory, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" when no store is available."}],"type":"paragraph"}]},{"name":"discardingExistingCache","content":[{"inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"true"},{"type":"text","text":", any cache already present for this"},{"type":"text","text":" "},{"type":"text","text":"directory must be deleted rather than loaded, and the backend must behave as"},{"type":"text","text":" "},{"type":"text","text":"though it had never cached anything. The ensemble passes "},{"type":"codeVoice","code":"true"},{"type":"text","text":" whenever the"},{"type":"text","text":" "},{"type":"text","text":"store is being rebuilt, so a device starting over is guaranteed a full fetch"},{"type":"text","text":" "},{"type":"text","text":"rather than a delta against a cursor from a previous incarnation."}],"type":"paragraph"}]}],"kind":"parameters"},{"mentions":["doc:\/\/Ensembles\/documentation\/Ensembles\/CustomCloudBackends"],"kind":"mentions"},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Backends that cache remote state between launches should store that cache inside","type":"text"},{"text":" ","type":"text"},{"text":"this directory. Doing so ties the cache’s lifetime to the event store’s: when the","type":"text"},{"text":" ","type":"text"},{"text":"store is removed or rebuilt, the stale cache goes with it.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Caching remote state anywhere with an independent lifetime (the system caches","type":"text"},{"text":" ","type":"text"},{"text":"directory, for instance) is unsafe. Such a cache can outlive the event store it","type":"text"},{"text":" ","type":"text"},{"text":"describes — surviving even app deletion — and a backend that then resumes an","type":"text"},{"text":" ","type":"text"},{"text":"incremental fetch against a rebuilt cloud may never be told about files that","type":"text"},{"text":" ","type":"text"},{"text":"predate its stale cursor. The device sees a partial cloud and reports no error.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Called before priming, whenever the ensemble knows its event store. It is not","type":"text"},{"text":" ","type":"text"},{"text":"called for ensemble-independent operations such as","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/retrieveEnsembleIdentifiers(from:)","isActive":true,"type":"reference"},{"text":", so implementations must","type":"text"},{"text":" ","type":"text"},{"text":"tolerate priming without it and simply forgo persistent caching in that case.","type":"text"}]}],"kind":"content"}],"defaultImplementationsSections":[{"title":"CloudFileSystemSetup Implementations","identifiers":["doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup\/setLocalStoreDirectory(_:discardingExistingCache:)-1faby"],"anchor":"CloudFileSystemSetup-Implementations"}],"hierarchy":{"paths":[["doc:\/\/Ensembles\/documentation\/Ensembles","doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"url":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup\/setLocalStoreDirectory(_:discardingExistingCache:)","interfaceLanguage":"swift"},"sections":[],"variants":[{"paths":["\/documentation\/ensembles\/cloudfilesystemsetup\/setlocalstoredirectory(_:discardingexistingcache:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Ensembles/documentation/Ensembles/CloudFileSystemSetup":{"role":"symbol","url":"\/documentation\/ensembles\/cloudfilesystemsetup","type":"topic","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup","abstract":[{"text":"Optional setup and maintenance operations for cloud file systems.","type":"text"}],"title":"CloudFileSystemSetup","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CloudFileSystemSetup","kind":"identifier"}],"navigatorTitle":[{"text":"CloudFileSystemSetup","kind":"identifier"}],"kind":"symbol"},"doc://Ensembles/documentation/Ensembles":{"url":"\/documentation\/ensembles","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles","kind":"symbol","role":"collection","abstract":[{"text":"Sync Core Data and SwiftData stores across devices using event sourcing.","type":"text"}],"type":"topic","title":"Ensembles"},"doc://Ensembles/documentation/Ensembles/CloudFileSystemSetup/setLocalStoreDirectory(_:discardingExistingCache:)":{"role":"symbol","url":"\/documentation\/ensembles\/cloudfilesystemsetup\/setlocalstoredirectory(_:discardingexistingcache:)","type":"topic","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup\/setLocalStoreDirectory(_:discardingExistingCache:)","defaultImplementations":1,"abstract":[{"type":"text","text":"Tells the file system which local directory belongs to the event store it is serving."}],"title":"setLocalStoreDirectory(_:discardingExistingCache:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"setLocalStoreDirectory","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"discardingExistingCache","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":")","kind":"text"}],"required":true,"kind":"symbol"},"doc://Ensembles/documentation/Ensembles/CoreDataEnsemble/retrieveEnsembleIdentifiers(from:)":{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/retrieveEnsembleIdentifiers(from:)","url":"\/documentation\/ensembles\/coredataensemble\/retrieveensembleidentifiers(from:)","abstract":[{"type":"text","text":"Queries a cloud file system for the identifiers of the ensembles it contains."}],"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"retrieveEnsembleIdentifiers","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": any ","kind":"text"},{"preciseIdentifier":"s:9Ensembles15CloudFileSystemP","text"