{"kind":"symbol","schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"setLocalStoreDirectory","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"path","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?, ","kind":"text"},{"text":"discardingExistingCache","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":")","kind":"text"}],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"path","content":[{"inlineContent":[{"type":"text","text":"The event store’s directory, or "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" when no store is available."}],"type":"paragraph"}]},{"name":"discardingExistingCache","content":[{"inlineContent":[{"type":"text","text":"When "},{"code":"true","type":"codeVoice"},{"type":"text","text":", any cache already present for this"},{"type":"text","text":" "},{"type":"text","text":"directory must be deleted rather than loaded, and the backend must behave as"},{"type":"text","text":" "},{"type":"text","text":"though it had never cached anything. The ensemble passes "},{"code":"true","type":"codeVoice"},{"type":"text","text":" whenever the"},{"type":"text","text":" "},{"type":"text","text":"store is being rebuilt, so a device starting over is guaranteed a full fetch"},{"type":"text","text":" "},{"type":"text","text":"rather than a delta against a cursor from a previous incarnation."}],"type":"paragraph"}]}]},{"mentions":["doc:\/\/Ensembles\/documentation\/Ensembles\/CustomCloudBackends"],"kind":"mentions"},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"Backends that cache remote state between launches should store that cache inside","type":"text"},{"text":" ","type":"text"},{"text":"this directory. Doing so ties the cache’s lifetime to the event store’s: when the","type":"text"},{"text":" ","type":"text"},{"text":"store is removed or rebuilt, the stale cache goes with it.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Caching remote state anywhere with an independent lifetime (the system caches","type":"text"},{"text":" ","type":"text"},{"text":"directory, for instance) is unsafe. Such a cache can outlive the event store it","type":"text"},{"text":" ","type":"text"},{"text":"describes — surviving even app deletion — and a backend that then resumes an","type":"text"},{"text":" ","type":"text"},{"text":"incremental fetch against a rebuilt cloud may never be told about files that","type":"text"},{"text":" ","type":"text"},{"text":"predate its stale cursor. The device sees a partial cloud and reports no error.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Called before priming, whenever the ensemble knows its event store. It is not","type":"text"},{"text":" ","type":"text"},{"text":"called for ensemble-independent operations such as","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/retrieveEnsembleIdentifiers(from:)","type":"reference","isActive":true},{"text":", so implementations must","type":"text"},{"text":" ","type":"text"},{"text":"tolerate priming without it and simply forgo persistent caching in that case.","type":"text"}]}]}],"sections":[],"defaultImplementationsSections":[{"identifiers":["doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup\/setLocalStoreDirectory(_:discardingExistingCache:)-1faby"],"title":"CloudFileSystemSetup Implementations","anchor":"CloudFileSystemSetup-Implementations"}],"metadata":{"modules":[{"name":"Ensembles"}],"title":"setLocalStoreDirectory(_:discardingExistingCache:)","symbolKind":"method","required":true,"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"setLocalStoreDirectory"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"discardingExistingCache"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":")"}],"roleHeading":"Instance Method","externalID":"s:9Ensembles20CloudFileSystemSetupP22setLocalStoreDirectory_23discardingExistingCacheySSSg_SbtF","role":"symbol"},"hierarchy":{"paths":[["doc:\/\/Ensembles\/documentation\/Ensembles","doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup"]]},"identifier":{"url":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup\/setLocalStoreDirectory(_:discardingExistingCache:)","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Tells the file system which local directory belongs to the event store it is serving."}],"variants":[{"paths":["\/documentation\/ensembles\/cloudfilesystemsetup\/setlocalstoredirectory(_:discardingexistingcache:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Ensembles/documentation/Ensembles/CloudFileSystemSetup/setLocalStoreDirectory(_:discardingExistingCache:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"setLocalStoreDirectory"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"discardingExistingCache"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":")"}],"required":true,"url":"\/documentation\/ensembles\/cloudfilesystemsetup\/setlocalstoredirectory(_:discardingexistingcache:)","type":"topic","abstract":[{"text":"Tells the file system which local directory belongs to the event store it is serving.","type":"text"}],"role":"symbol","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup\/setLocalStoreDirectory(_:discardingExistingCache:)","defaultImplementations":1,"title":"setLocalStoreDirectory(_:discardingExistingCache:)","kind":"symbol"},"doc://Ensembles/documentation/Ensembles/CloudFileSystemSetup":{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup","type":"topic","kind":"symbol","title":"CloudFileSystemSetup","navigatorTitle":[{"kind":"identifier","text":"CloudFileSystemSetup"}],"role":"symbol","abstract":[{"type":"text","text":"Optional setup and maintenance operations for cloud file systems."}],"url":"\/documentation\/ensembles\/cloudfilesystemsetup","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CloudFileSystemSetup","kind":"identifier"}]},"doc://Ensembles/documentation/Ensembles/CloudFileSystemSetup/setLocalStoreDirectory(_:discardingExistingCache:)-1faby":{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup\/setLocalStoreDirectory(_:discardingExistingCache:)-1faby","type":"topic","kind":"symbol","title":"setLocalStoreDirectory(_:discardingExistingCache:)","role":"symbol","abstract":[{"text":"Backends that keep no persistent listing cache need do nothing here.","type":"text"}],"url":"\/documentation\/ensembles\/cloudfilesystemsetup\/setlocalstoredirectory(_:discardingexistingcache:)-1faby","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"setLocalStoreDirectory","kind":"identifier"},{"kind":"text","text":"("},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"discardingExistingCache"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":")"}]},"doc://Ensembles/documentation/Ensembles/CoreDataEnsemble/ret