{"sections":[],"metadata":{"title":"setLocalStoreDirectory(_:discardingExistingCache:)","modules":[{"name":"Ensembles"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"setLocalStoreDirectory","kind":"identifier"},{"text":"(","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?, ","kind":"text"},{"text":"discardingExistingCache","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":")","kind":"text"}],"role":"symbol","symbolKind":"method","externalID":"s:9Ensembles20CloudFileSystemSetupP22setLocalStoreDirectory_23discardingExistingCacheySSSg_SbtF","roleHeading":"Instance Method","required":true},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ensembles\/cloudfilesystemsetup\/setlocalstoredirectory(_:discardingexistingcache:)"]}],"kind":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"setLocalStoreDirectory","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"path","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"discardingExistingCache","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":")","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"path","content":[{"inlineContent":[{"type":"text","text":"The event store’s directory, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" when no store is available."}],"type":"paragraph"}]},{"name":"discardingExistingCache","content":[{"inlineContent":[{"type":"text","text":"When "},{"code":"true","type":"codeVoice"},{"type":"text","text":", any cache already present for this"},{"type":"text","text":" "},{"type":"text","text":"directory must be deleted rather than loaded, and the backend must behave as"},{"type":"text","text":" "},{"type":"text","text":"though it had never cached anything. The ensemble passes "},{"code":"true","type":"codeVoice"},{"type":"text","text":" whenever the"},{"type":"text","text":" "},{"type":"text","text":"store is being rebuilt, so a device starting over is guaranteed a full fetch"},{"type":"text","text":" "},{"type":"text","text":"rather than a delta against a cursor from a previous incarnation."}],"type":"paragraph"}]}],"kind":"parameters"},{"kind":"mentions","mentions":["doc:\/\/Ensembles\/documentation\/Ensembles\/CustomCloudBackends"]},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Backends that cache remote state between launches should store that cache inside"},{"type":"text","text":" "},{"type":"text","text":"this directory. Doing so ties the cache’s lifetime to the event store’s: when the"},{"type":"text","text":" "},{"type":"text","text":"store is removed or rebuilt, the stale cache goes with it."}],"type":"paragraph"},{"inlineContent":[{"text":"Caching remote state anywhere with an independent lifetime (the system caches","type":"text"},{"text":" ","type":"text"},{"text":"directory, for instance) is unsafe. Such a cache can outlive the event store it","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"describes — surviving even app deletion — and a backend that then resumes an"},{"type":"text","text":" "},{"type":"text","text":"incremental fetch against a rebuilt cloud may never be told about files that"},{"type":"text","text":" "},{"type":"text","text":"predate its stale cursor. The device sees a partial cloud and reports no error."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Called before priming, whenever the ensemble knows its event store. It is not","type":"text"},{"text":" ","type":"text"},{"text":"called for ensemble-independent operations such as","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/retrieveEnsembleIdentifiers(from:)","isActive":true,"type":"reference"},{"text":", so implementations must","type":"text"},{"text":" ","type":"text"},{"text":"tolerate priming without it and simply forgo persistent caching in that case.","type":"text"}]}]}],"defaultImplementationsSections":[{"anchor":"CloudFileSystemSetup-Implementations","title":"CloudFileSystemSetup Implementations","identifiers":["doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup\/setLocalStoreDirectory(_:discardingExistingCache:)-1faby"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup\/setLocalStoreDirectory(_:discardingExistingCache:)"},"hierarchy":{"paths":[["doc:\/\/Ensembles\/documentation\/Ensembles","doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"Tells the file system which local directory belongs to the event store it is serving."}],"references":{"doc://Ensembles/documentation/Ensembles":{"kind":"symbol","url":"\/documentation\/ensembles","type":"topic","title":"Ensembles","role":"collection","abstract":[{"type":"text","text":"Sync Core Data and SwiftData stores across devices using event sourcing."}],"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles"},"doc://Ensembles/documentation/Ensembles/CoreDataEnsemble/retrieveEnsembleIdentifiers(from:)":{"role":"symbol","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/retrieveEnsembleIdentifiers(from:)","abstract":[{"type":"text","text":"Queries a cloud file system for the identifiers of the ensembles it contains."}],"url":"\/documentation\/ensembles\/coredataensemble\/retrieveensembleidentifiers(from:)","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"kind":"identifier","text":"retrieveEnsembleIdentifiers"},{"kind":"text","text":"("},{"text":"from","kind":"externalParam"},{"text":": any ","kind":"text"},{"text":"CloudFileSystem","preciseIdentifier":"s:9Ensembles15CloudFileSystemP","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> [","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"type":"topic","kind":"symbol","title":"retrieveEnsembleIdentifiers(from:)"},"doc://Ensembles/documentation/Ensembles/CloudFileSystemSetup":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CloudFileSystemSetup","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"CloudFileSystemSetup","kind":"identifier"}],"title":"CloudFileSystemSetup","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup","abstract":[{"text":"Optional setup and maintenance operations for cloud file systems.","type":"text"}],"url":"\/documentation\/ensembles\/cloudfilesystemsetup","type":"topic","kind":"symbol"},"doc://Ensembles/documentation/Ensembles/CustomCloudBackends":{"role":"article","abstract":[{"text":"Implement the CloudFileSystem protocol to sync via any storage service.","type":"text"}],"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CustomCloudBackends","url":"\/documentation\/ensembles\/customcloudbackends","kind":"article","type":"topic","title":"Custom Cloud Backends"},"doc://Ensembles/documentation/Ensembles/CloudFileSystemSetup/setLocalStoreDirectory(_:discardingExistingCache:)-1faby":{"abstract":[{"type":"text","text":"Backends that keep no persistent listing cache need do nothing here."}],"url":"\/documentation\/ensembles\/cloudfilesystemsetup\/setlocalstoredirectory(_:discardingexistingcache:)-1faby","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"setLocalStoreDirectory"},{"kind":"text","text":"("},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"discardingExistingCache"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":")"}],"type":"topic","title":"setLocalStoreDirectory(_:discardingExistingCache:)","role":"symbol","kind":"symbol","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup\/setLocalStoreDirectory(_:discardingExistingCache:)-1faby"},"doc://Ensembles/documentation/Ensembles/CloudFileSystemSetup/setLocalStoreDirectory(_:discardingExistingCache:)":{"title":"setLocalStoreDirectory(_:discardingExistingCache:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"setLocalStoreDirectory","kind":"identifier"},{"kind":"text","text":"("},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"discardingExistingCache"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":")"}],"kind":"symbol","type":"topic","role":"symbol","url":"\/documentation\/ensembles\/cloudfilesystemsetup\/setlocalstoredirectory(_:discardingexistingcache:)","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup\/setLocalStoreDirectory(_:discardingExistingCache:)","defaultImplementations":1,"required":true,"abstract":[{"text":"Tells the file system which local directory belongs to the event store it is serving.","type":"text"}]}}}