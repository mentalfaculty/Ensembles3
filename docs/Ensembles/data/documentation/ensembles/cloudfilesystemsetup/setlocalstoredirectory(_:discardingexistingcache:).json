{"metadata":{"symbolKind":"method","required":true,"modules":[{"name":"Ensembles"}],"externalID":"s:9Ensembles20CloudFileSystemSetupP22setLocalStoreDirectory_23discardingExistingCacheySSSg_SbtF","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"setLocalStoreDirectory"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"discardingExistingCache"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":")"}],"roleHeading":"Instance Method","title":"setLocalStoreDirectory(_:discardingExistingCache:)","role":"symbol"},"abstract":[{"text":"Tells the file system which local directory belongs to the event store it is serving.","type":"text"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"setLocalStoreDirectory","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"path","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?, ","kind":"text"},{"text":"discardingExistingCache","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":")","kind":"text"}]}],"kind":"declarations"},{"parameters":[{"name":"path","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The event store’s directory, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" when no store is available."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"When "},{"code":"true","type":"codeVoice"},{"text":", any cache already present for this","type":"text"},{"text":" ","type":"text"},{"text":"directory must be deleted rather than loaded, and the backend must behave as","type":"text"},{"text":" ","type":"text"},{"text":"though it had never cached anything. The ensemble passes ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" whenever the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"store is being rebuilt, so a device starting over is guaranteed a full fetch"},{"text":" ","type":"text"},{"type":"text","text":"rather than a delta against a cursor from a previous incarnation."}],"type":"paragraph"}],"name":"discardingExistingCache"}],"kind":"parameters"},{"mentions":["doc:\/\/Ensembles\/documentation\/Ensembles\/CustomCloudBackends"],"kind":"mentions"},{"content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Backends that cache remote state between launches should store that cache inside"},{"type":"text","text":" "},{"type":"text","text":"this directory. Doing so ties the cache’s lifetime to the event store’s: when the"},{"type":"text","text":" "},{"type":"text","text":"store is removed or rebuilt, the stale cache goes with it."}]},{"type":"paragraph","inlineContent":[{"text":"Caching remote state anywhere with an independent lifetime (the system caches","type":"text"},{"text":" ","type":"text"},{"text":"directory, for instance) is unsafe. Such a cache can outlive the event store it","type":"text"},{"type":"text","text":" "},{"text":"describes — surviving even app deletion — and a backend that then resumes an","type":"text"},{"type":"text","text":" "},{"text":"incremental fetch against a rebuilt cloud may never be told about files that","type":"text"},{"type":"text","text":" "},{"type":"text","text":"predate its stale cursor. The device sees a partial cloud and reports no error."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Called before priming, whenever the ensemble knows its event store. It is not"},{"type":"text","text":" "},{"type":"text","text":"called for ensemble-independent operations such as"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/retrieveEnsembleIdentifiers(from:)","type":"reference"},{"text":", so implementations must","type":"text"},{"text":" ","type":"text"},{"text":"tolerate priming without it and simply forgo persistent caching in that case.","type":"text"}]}],"kind":"content"}],"defaultImplementationsSections":[{"anchor":"CloudFileSystemSetup-Implementations","title":"CloudFileSystemSetup Implementations","identifiers":["doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup\/setLocalStoreDirectory(_:discardingExistingCache:)-1faby"]}],"hierarchy":{"paths":[["doc:\/\/Ensembles\/documentation\/Ensembles","doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup"]]},"kind":"symbol","identifier":{"url":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup\/setLocalStoreDirectory(_:discardingExistingCache:)","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/ensembles\/cloudfilesystemsetup\/setlocalstoredirectory(_:discardingexistingcache:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Ensembles/documentation/Ensembles":{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles","url":"\/documentation\/ensembles","abstract":[{"type":"text","text":"Sync Core Data and SwiftData stores across devices using event sourcing."}],"type":"topic","kind":"symbol","title":"Ensembles","role":"collection"},"doc://Ensembles/documentation/Ensembles/CustomCloudBackends":{"title":"Custom Cloud Backends","abstract":[{"text":"Implement the CloudFileSystem protocol to sync via any storage service.","type":"text"}],"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CustomCloudBackends","url":"\/documentation\/ensembles\/customcloudbackends","type":"topic","role":"article","kind":"article"},"doc://Ensembles/documenta