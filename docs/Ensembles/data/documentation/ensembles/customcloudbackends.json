{"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"text":"Implement the CloudFileSystem protocol to sync via any storage service.","type":"text"}],"primaryContentSections":[{"content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"Ensembles exchanges sync data through a ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem"},{"type":"text","text":" — a protocol that abstracts file storage behind a simple path-based API. Any service that can store and retrieve files at paths can serve as a backend: cloud storage (S3, Google Cloud Storage), file servers (WebDAV, SFTP), databases, or even peer-to-peer connections with a local cache."}],"type":"paragraph"},{"text":"The CloudFileSystem Protocol","level":2,"anchor":"The-CloudFileSystem-Protocol","type":"heading"},{"inlineContent":[{"text":"The core protocol has 8 requirements organized into four groups:","type":"text"}],"type":"paragraph"},{"type":"heading","level":3,"text":"Connection","anchor":"Connection"},{"syntax":"swift","code":["public protocol CloudFileSystem: AnyObject, Sendable {","    var isConnected: Bool { get }","    func connect() async throws","    func fetchUserIdentity() async throws","        -> sending (any NSObjectProtocol & NSCoding & NSCopying)?","}"],"type":"codeListing"},{"items":[{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/isConnected"},{"text":" — Return whether the backend is ready for operations.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/connect()"},{"text":" — Establish a connection. Called before each attach or merge.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/fetchUserIdentity()"},{"text":" — Return a token identifying the current user, or ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" if identity tracking is not supported. Ensembles uses this to detect account changes (e.g., signing out of iCloud).","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"File-Operations","text":"File Operations","level":3,"type":"heading"},{"syntax":"swift","code":["func fileExists(atPath path: String) async throws -> FileExistence","func createDirectory(atPath path: String) async throws","func contentsOfDirectory(atPath path: String) async throws -> [any CloudItem]","func removeItem(atPath path: String) async throws"],"type":"codeListing"},{"inlineContent":[{"text":"Paths are forward-slash separated, rooted at ","type":"text"},{"code":"\/","type":"codeVoice"},{"text":". The ensemble creates a directory structure like ","type":"text"},{"code":"\/MyEnsemble\/events\/","type":"codeVoice"},{"text":", ","type":"text"},{"code":"\/MyEnsemble\/baselines\/","type":"codeVoice"},{"text":", etc.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Directory listings should return ","type":"text"},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFile","isActive":true,"type":"reference"},{"text":" or ","type":"text"},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudDirectory","isActive":true,"type":"reference"},{"text":" items with their ","type":"text"},{"code":"path","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"name","type":"codeVoice"},{"text":" populated. Only list immediate children — do not recurse.","type":"text"}],"type":"paragraph"},{"text":"File Transfer","type":"heading","anchor":"File-Transfer","level":3},{"syntax":"swift","type":"codeListing","code":["func uploadLocalFile(atPath localPath: String, toPath remotePath: String) async throws","func downloadFile(atPath remotePath: String, toLocalFile localPath: String) async throws"]},{"inlineContent":[{"text":"Upload copies a local file to the remote path. Download copies a remote file to the local path. Both paths are absolute on their respective systems (local paths are filesystem paths; remote paths are within the cloud file system’s namespace).","type":"text"}],"type":"paragraph"},{"text":"A Minimal Example","type":"heading","anchor":"A-Minimal-Example","level":2},{"inlineContent":[{"type":"text","text":"Here is a skeleton implementation to illustrate the structure:"}],"type":"paragraph"},{"syntax":"swift","code":["import Ensembles","","public final class MyCloudFileSystem: CloudFileSystem, @unchecked Sendable {","","    public var isConnected: Bool { true }","","    public func connect() async throws {","        \/\/ Authenticate or establish a session","    }","","    public func fetchUserIdentity() async throws","        -> sending (any NSObjectProtocol & NSCoding & NSCopying)? {","        \/\/ Return a user token, or nil","        return nil","    }","","    public func fileExists(atPath path: String) async throws -> FileExistence {","        \/\/ Check your storage and return the result","    }","","    public func createDirectory(atPath path: String) async throws {","        \/\/ Create a directory marker or equivalent","    }","","    public func contentsOfDirectory(atPath path: String) async throws","        -> [any CloudItem] {","        \/\/ List immediate children as CloudFile\/CloudDirectory items","    }","","    public func removeItem(atPath path: String) async throws {","        \/\/ Delete a file or directory (and its contents)","    }","","    public func uploadLocalFile(","        atPath localPath: String,","        toPath remotePath: String","    ) async throws {","        let data = try Data(contentsOf: URL(fileURLWithPath: localPath))","        \/\/ Store data at remotePath in your backend","    }","","    public func downloadFile(","        atPath remotePath: String,","        toLocalFile localPath: String","    ) async throws {","        \/\/ Retrieve data from remotePath in your backend","        let data: Data = \/\/ ...fetch from backend","        try data.write(to: URL(fileURLWithPath: localPath), options: .atomic)","    }","}"],"type":"codeListing"},{"anchor":"Reference-Implementations","text":"Reference Implementations","level":2,"type":"heading"},{"inlineContent":[{"text":"Study the built-in backends as starting points:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"code":"MemoryCloudFileSystem","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" (in "},{"type":"codeVoice","code":"EnsemblesMemory"},{"type":"text","text":") — The simplest implementation. An actor that stores files in a dictionary. Good for understanding the protocol’s expectations."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":"LocalCloudFileSystem","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" (in "},{"type":"codeVoice","code":"EnsemblesLocalFile"},{"type":"text","text":") — Uses "},{"type":"codeVoice","code":"FileManager"},{"type":"text","text":" to store files in a local directory. Shows how to map the protocol onto a real file system."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":"CloudKitFileSystem","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" (in "},{"type":"codeVoice","code":"EnsemblesCloudKit"},{"type":"text","text":") — A production backend using CloudKit. Shows how to implement batch operations and setup hooks."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":"PCloudCloudFileSystem","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" (in "},{"type":"codeVoice","code":"EnsemblesPCloud"},{"type":"text","text":") — A URLSession-based REST client with no SDK dependency. A good model for building backends against any REST API."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":"BoxCloudFileSystem","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" (in "},{"type":"codeVoice","code":"EnsemblesBox"},{"type":"text","text":") — Wraps the Box Swift SDK. Demonstrates how to bridge an ID-based API (where files are identified by numeric IDs, not paths) onto the path-based "},{"type":"codeVoice","code":"CloudFileSystem"},{"type":"text","text":" protocol using folder-walking and caching."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":"S3CloudFileSystem","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" (in "},{"type":"codeVoice","code":"EnsemblesS3"},{"type":"text","text":") — Wraps the AWS SDK for Swift. Shows how to simulate directory semantics on a flat key-value store using key prefixes and delimiters."}],"type":"paragraph"}]}],"type":"unorderedList"},{"style":"note","content":[{"inlineContent":[{"type":"text","text":""},{"code":"EnsemblesBox","type":"codeVoice"},{"type":"text","text":" and "},{"code":"EnsemblesS3","type":"codeVoice"},{"type":"text","text":" (along with "},{"code":"EnsemblesDropbox","type":"codeVoice"},{"type":"text","text":", "},{"code":"EnsemblesZip","type":"codeVoice"},{"type":"text","text":", and "},{"code":"EnsemblesMultipeer","type":"codeVoice"},{"type":"text","text":") require an external SDK. With the source distribution, enabling the corresponding package trait resolves this automatically. With the binary distribution (XCFrameworks), you must add the external SDK as a separate package dependency — see the Available Backends table in the README for details."}],"type":"paragraph"}],"name":"Note","type":"aside"},{"anchor":"Optional-Batch-Operations","text":"Optional: Batch Operations","level":2,"type":"heading"},{"inlineContent":[{"text":"If your backend can handle multiple files in a single request (reducing round trips), adopt ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemBatchOperations"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["extension MyCloudFileSystem: CloudFileSystemBatchOperations {","    public var fileUploadMaximumBatchSize: Int { 20 }","    public var fileDownloadMaximumBatchSize: Int { 20 }","","    public func uploadLocalFiles(","        atPaths localPaths: [String],","        toPaths remotePaths: [String]","    ) async throws {","        \/\/ Upload multiple files in one request","    }","","    public func downloadFiles(","        atPaths remotePaths: [String],","        toLocalFiles localPaths: [String]","    ) async throws {","        \/\/ Download multiple files in one request","    }","","    public func removeItems(atPaths paths: [String]) async throws {","        \/\/ Delete multiple items in one request","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"fileUploadMaximumBatchSize"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"fileDownloadMaximumBatchSize"},{"text":" properties control how many files Ensembles passes per batch call. Default is 10 if you don’t override them.","type":"text"}],"type":"paragraph"},{"anchor":"Optional-Setup-Hooks","text":"Optional: Setup Hooks","level":2,"type":"heading"},{"inlineContent":[{"text":"For backends that need initialization, caching, or repair logic, adopt ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["extension MyCloudFileSystem: CloudFileSystemSetup {","    public func performInitialPreparation() async throws {","        \/\/ One-time setup (e.g., create root directories)","    }","","    public func primeForActivity() async throws {","        \/\/ Called before each operation (e.g., refresh auth tokens,","        \/\/ cache directory listings)","    }","","    public func directoryExists(atPath path: String) async throws -> Bool {","        \/\/ Check directory existence","    }","","    public func repairEnsembleDirectory(atPath path: String) async throws {","        \/\/ Fix up issues like iCloud duplicates or stale locks","    }","}"],"type":"codeListing"},{"anchor":"Threading-and-Sendable","text":"Threading and Sendable","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Cloud file systems must conform to "},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":". If your implementation uses mutable state, you have several options:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"actor"},{"type":"text","text":" isolation (as "},{"type":"codeVoice","code":"MemoryCloudFileSystem"},{"type":"text","text":" does)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"@unchecked Sendable"},{"type":"text","text":" with explicit locking (as "},{"type":"codeVoice","code":"LocalCloudFileSystem"},{"type":"text","text":" does)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Make the type stateless, delegating state to a thread-safe service"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"All protocol methods are "},{"code":"async throws","type":"codeVoice"},{"type":"text","text":", so you can freely call async APIs in your implementation."}],"type":"paragraph"}],"kind":"content"}],"metadata":{"roleHeading":"Article","title":"Custom Cloud Backends","modules":[{"name":"Ensembles"}],"role":"article"},"kind":"article","hierarchy":{"paths":[["doc:\/\/Ensembles\/documentation\/Ensembles"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Ensembles\/documentation\/Ensembles\/CustomCloudBackends"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ensembles\/customcloudbackends"]}],"seeAlsoSections":[{"title":"Cloud Backends","generated":true,"anchor":"Cloud-Backends","identifiers":["doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem","doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemBatchOperations","doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup"]}],"sections":[],"references":{"doc://Ensembles/documentation/Ensembles/CloudFileSystem/fetchUserIdentity()":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"fetchUserIdentity"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> sending (any "},{"preciseIdentifier":"c:objc(pl)NSCoding","kind":"typeIdentifier","text":"NSCoding"},{"kind":"text","text":" & "},{"preciseIdentifier":"c:objc(pl)NSCopying","kind":"typeIdentifier","text":"NSCopying"},{"kind":"text","text":" & "},{"preciseIdentifier":"c:objc(pl)NSObject","kind":"typeIdentifier","text":"NSObjectProtocol"},{"kind":"text","text":")?"}],"url":"\/documentation\/ensembles\/cloudfilesystem\/fetchuseridentity()","abstract":[{"text":"Fetches a token representing the current user of the cloud file system.","type":"text"},{"text":" ","type":"text"},{"text":"Often this will be the user or login name.","type":"text"}],"type":"topic","title":"fetchUserIdentity()","kind":"symbol","required":true,"role":"symbol","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/fetchUserIdentity()"},"doc://Ensembles/documentation/Ensembles/CloudFile":{"kind":"symbol","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFile","navigatorTitle":[{"kind":"identifier","text":"CloudFile"}],"url":"\/documentation\/ensembles\/cloudfile","role":"symbol","type":"topic","title":"CloudFile","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CloudFile"}],"abstract":[{"type":"text","text":"Represents a file in a cloud file system."}]},"doc://Ensembles/documentation/Ensembles/CloudFileSystem":{"kind":"symbol","navigatorTitle":[{"text":"CloudFileSystem","kind":"identifier"}],"abstract":[{"text":"A cloud file system facilitates data transfer between devices.","type":"text"}],"title":"CloudFileSystem","url":"\/documentation\/ensembles\/cloudfilesystem","type":"topic","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CloudFileSystem","kind":"identifier"}],"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem"},"doc://Ensembles/documentation/Ensembles/CloudFileSystem/connect()":{"abstract":[{"text":"Attempts to connect to the cloud backend.","type":"text"}],"url":"\/documentation\/ensembles\/cloudfilesystem\/connect()","role":"symbol","type":"topic","kind":"symbol","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/connect()","title":"connect()","required":true,"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"connect","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}]},"doc://Ensembles/documentation/Ensembles":{"abstract":[{"text":"Sync Core Data and SwiftData stores across devices using event sourcing.","type":"text"}],"url":"\/documentation\/ensembles","kind":"symbol","type":"topic","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles","role":"collection","title":"Ensembles"},"doc://Ensembles/documentation/Ensembles/CloudDirectory":{"title":"CloudDirectory","kind":"symbol","abstract":[{"text":"Represents a directory in a cloud file system.","type":"text"}],"type":"topic","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudDirectory","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CloudDirectory"}],"role":"symbol","url":"\/documentation\/ensembles\/clouddirectory","navigatorTitle":[{"kind":"identifier","text":"CloudDirectory"}]},"doc://Ensembles/documentation/Ensembles/CloudFileSystem/isConnected":{"role":"symbol","required":true,"type":"topic","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/isConnected","abstract":[{"type":"text","text":"Whether the file system is connected and ready for file transactions."}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isConnected","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"url":"\/documentation\/ensembles\/cloudfilesystem\/isconnected","title":"isConnected","kind":"symbol"},"doc://Ensembles/documentation/Ensembles/CloudFileSystemBatchOperations":{"kind":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"CloudFileSystemBatchOperations"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"CloudFileSystemBatchOperations"}],"title":"CloudFileSystemBatchOperations","type":"topic","abstract":[{"type":"text","text":"Optional batch and setup operations for cloud file systems."}],"url":"\/documentation\/ensembles\/cloudfilesystembatchoperations","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemBatchOperations"},"doc://Ensembles/documentation/Ensembles/CloudFileSystemSetup":{"title":"CloudFileSystemSetup","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Optional setup and maintenance operations for cloud file systems."}],"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CloudFileSystemSetup","kind":"identifier"}],"role":"symbol","url":"\/documentation\/ensembles\/cloudfilesystemsetup","navigatorTitle":[{"kind":"identifier","text":"CloudFileSystemSetup"}]}}}