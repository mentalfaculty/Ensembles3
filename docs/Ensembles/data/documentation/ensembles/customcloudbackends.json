{"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Ensembles exchanges sync data through a "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem","type":"reference","isActive":true},{"type":"text","text":" — a protocol that abstracts file storage behind a simple path-based API. Any service that can store and retrieve files at paths can serve as a backend: cloud storage (S3, Google Cloud Storage), file servers (WebDAV, SFTP), databases, or even peer-to-peer connections with a local cache."}]},{"type":"heading","anchor":"The-CloudFileSystem-Protocol","level":2,"text":"The CloudFileSystem Protocol"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The core protocol has 8 requirements organized into four groups:"}]},{"type":"heading","anchor":"Connection","level":3,"text":"Connection"},{"type":"codeListing","syntax":"swift","code":["public protocol CloudFileSystem: AnyObject, Sendable {","    var isConnected: Bool { get }","    func connect() async throws","    func fetchUserIdentity() async throws","        -> sending (any NSObjectProtocol & NSCoding & NSCopying)?","}"]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/isConnected","isActive":true,"type":"reference"},{"text":" — Return whether the backend is ready for operations.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/connect()","isActive":true,"type":"reference"},{"text":" — Establish a connection. Called before each attach or merge.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/fetchUserIdentity()","isActive":true,"type":"reference"},{"text":" — Return a token identifying the current user, or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" if identity tracking is not supported. Ensembles uses this to detect account changes (e.g., signing out of iCloud).","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","anchor":"File-Operations","level":3,"text":"File Operations"},{"type":"codeListing","syntax":"swift","code":["func fileExists(atPath path: String) async throws -> FileExistence","func createDirectory(atPath path: String) async throws","func contentsOfDirectory(atPath path: String) async throws -> [any CloudItem]","func removeItem(atPath path: String) async throws"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Paths are forward-slash separated, rooted at "},{"code":"\/","type":"codeVoice"},{"type":"text","text":". The ensemble creates a directory structure like "},{"code":"\/MyEnsemble\/events\/","type":"codeVoice"},{"type":"text","text":", "},{"code":"\/MyEnsemble\/baselines\/","type":"codeVoice"},{"type":"text","text":", etc."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Directory listings should return "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFile","type":"reference","isActive":true},{"type":"text","text":" or "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudDirectory","type":"reference","isActive":true},{"type":"text","text":" items with their "},{"code":"path","type":"codeVoice"},{"type":"text","text":" and "},{"code":"name","type":"codeVoice"},{"type":"text","text":" populated. Only list immediate children — do not recurse."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"There is one optional existence check, "},{"code":"confirmFileExists(atPath:)","type":"codeVoice"},{"type":"text","text":", with a default implementation that calls "},{"code":"fileExists(atPath:)","type":"codeVoice"},{"type":"text","text":". The framework uses it for checks whose consequences are drastic, such as the per-sync store-registration check that detects a reset cloud. If your backend answers "},{"code":"fileExists","type":"codeVoice"},{"type":"text","text":" from a local cache of remote state, implement "},{"code":"confirmFileExists","type":"codeVoice"},{"type":"text","text":" to consult the server directly; if "},{"code":"fileExists","type":"codeVoice"},{"type":"text","text":" is already authoritative, the default is correct. Wrapper backends that delegate to another file system must forward "},{"code":"confirmFileExists","type":"codeVoice"},{"type":"text","text":" to the wrapped backend’s "},{"code":"confirmFileExists","type":"codeVoice"},{"type":"text","text":" — the default cannot see through a wrapper, and would quietly downgrade the confirmation to the wrapped backend’s cached check."}]},{"type":"heading","anchor":"File-Transfer","level":3,"text":"File Transfer"},{"type":"codeListing","syntax":"swift","code":["func uploadLocalFile(atPath localPath: String, toPath remotePath: String) async throws","func downloadFile(atPath remotePath: String, toLocalFile localPath: String) async throws"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Upload copies a local file to the remote path. Download copies a remote file to the local path. Both paths are absolute on their respective systems (local paths are filesystem paths; remote paths are within the cloud file system’s namespace)."}]},{"text":"A Minimal Example","type":"heading","level":2,"anchor":"A-Minimal-Example"},{"inlineContent":[{"text":"Here is a skeleton implementation to illustrate the structure:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import Ensembles","","public final class MyCloudFileSystem: CloudFileSystem, @unchecked Sendable {","","    public var isConnected: Bool { true }","","    public func connect() async throws {","        \/\/ Authenticate or establish a session","    }","","    public func fetchUserIdentity() async throws","        -> sending (any NSObjectProtocol & NSCoding & NSCopying)? {","        \/\/ Return a user token, or nil","        return nil","    }","","    public func fileExists(atPath path: String) async throws -> FileExistence {","        \/\/ Check your storage and return the result","    }","","    public func createDirectory(atPath path: String) async throws {","        \/\/ Create a directory marker or equivalent","    }","","    public func contentsOfDirectory(atPath path: String) async throws","        -> [any CloudItem] {","        \/\/ List immediate children as CloudFile\/CloudDirectory items","    }","","    public func removeItem(atPath path: String) async throws {","        \/\/ Delete a file or directory (and its contents)","    }","","    public func uploadLocalFile(","        atPath localPath: String,","        toPath remotePath: String","    ) async throws {","        let data = try Data(contentsOf: URL(fileURLWithPath: localPath))","        \/\/ Store data at remotePath in your backend","    }","","    public func downloadFile(","        atPath remotePath: String,","        toLocalFile localPath: String","    ) async throws {","        \/\/ Retrieve data from remotePath in your backend","        let data: Data = \/\/ ...fetch from backend","        try data.write(to: URL(fileURLWithPath: localPath), options: .atomic)","    }","}"],"type":"codeListing"},{"type":"heading","anchor":"Reference-Implementations","level":2,"text":"Reference Implementations"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Study the built-in backends as starting points:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"MemoryCloudFileSystem"}],"type":"strong"},{"text":" (in ","type":"text"},{"code":"EnsemblesMemory","type":"codeVoice"},{"text":") — The simplest implementation. An actor that stores files in a dictionary. Good for understanding the protocol’s expectations.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"LocalCloudFileSystem"}],"type":"strong"},{"text":" (in ","type":"text"},{"code":"EnsemblesLocalFile","type":"codeVoice"},{"text":") — Uses ","type":"text"},{"code":"FileManager","type":"codeVoice"},{"text":" to store files in a local directory. Shows how to map the protocol onto a real file system.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"CloudKitFileSystem"}],"type":"strong"},{"text":" (in ","type":"text"},{"code":"EnsemblesCloudKit","type":"codeVoice"},{"text":") — A production backend using CloudKit. Shows how to implement batch operations and setup hooks.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"PCloudCloudFileSystem"}],"type":"strong"},{"text":" (in ","type":"text"},{"code":"EnsemblesPCloud","type":"codeVoice"},{"text":") — A URLSession-based REST client with no SDK dependency. A good model for building backends against any REST API.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"BoxCloudFileSystem"}],"type":"strong"},{"text":" (in ","type":"text"},{"code":"EnsemblesBox","type":"codeVoice"},{"text":") — Wraps the Box Swift SDK. Demonstrates how to bridge an ID-based API (where files are identified by numeric IDs, not paths) onto the path-based ","type":"text"},{"code":"CloudFileSystem","type":"codeVoice"},{"text":" protocol using folder-walking and caching.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"S3CloudFileSystem"}],"type":"strong"},{"text":" (in ","type":"text"},{"code":"EnsemblesS3","type":"codeVoice"},{"text":") — Wraps the AWS SDK for Swift. Shows how to simulate directory semantics on a flat key-value store using key prefixes and delimiters.","type":"text"}],"type":"paragraph"}]}]},{"style":"note","type":"aside","content":[{"inlineContent":[{"text":"","type":"text"},{"code":"EnsemblesBox","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"EnsemblesS3","type":"codeVoice"},{"text":" (along with ","type":"text"},{"code":"EnsemblesDropbox","type":"codeVoice"},{"text":", ","type":"text"},{"code":"EnsemblesZip","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"EnsemblesMultipeer","type":"codeVoice"},{"text":") require an external SDK. With the source distribution, enabling the corresponding package trait resolves this automatically. With the binary distribution (XCFrameworks), you must add the external SDK as a separate package dependency — see the Available Backends table in the README for details.","type":"text"}],"type":"paragraph"}],"name":"Note"},{"type":"heading","anchor":"Optional-Batch-Operations","level":2,"text":"Optional: Batch Operations"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If your backend can handle multiple files in a single request (reducing round trips), adopt "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemBatchOperations","type":"reference","isActive":true},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["extension MyCloudFileSystem: CloudFileSystemBatchOperations {","    public var fileUploadMaximumBatchSize: Int { 20 }","    public var fileDownloadMaximumBatchSize: Int { 20 }","","    public func uploadLocalFiles(","        atPaths localPaths: [String],","        toPaths remotePaths: [String]","    ) async throws {","        \/\/ Upload multiple files in one request","    }","","    public func downloadFiles(","        atPaths remotePaths: [String],","        toLocalFiles localPaths: [String]","    ) async throws {","        \/\/ Download multiple files in one request","    }","","    public func removeItems(atPaths paths: [String]) async throws {","        \/\/ Delete multiple items in one request","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"fileUploadMaximumBatchSize","type":"codeVoice"},{"type":"text","text":" and "},{"code":"fileDownloadMaximumBatchSize","type":"codeVoice"},{"type":"text","text":" properties control how many files Ensembles passes per batch call. Default is 10 if you don’t override them."}]},{"type":"heading","anchor":"Optional-Setup-Hooks","level":2,"text":"Optional: Setup Hooks"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For backends that need initialization, caching, or repair logic, adopt "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup","type":"reference","isActive":true},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["extension MyCloudFileSystem: CloudFileSystemSetup {","    public func performInitialPreparation() async throws {","        \/\/ One-time setup (e.g., create root directories)","    }","","    public func primeForActivity() async throws {","        \/\/ Called before each operation (e.g., refresh auth tokens,","        \/\/ cache directory listings)","    }","","    public func directoryExists(atPath path: String) async throws -> Bool {","        \/\/ Check directory existence","    }","","    public func repairEnsembleDirectory(atPath path: String) async throws {","        \/\/ Fix up issues like iCloud duplicates or stale locks","    }","","    public func setLocalStoreDirectory(_ path: String?, discardingExistingCache: Bool) {","        \/\/ Where to keep any cache of remote state (see below).","        \/\/ Has a default no-op implementation; only implement it if you cache.","    }","}"]},{"type":"heading","anchor":"Caching-Remote-State","level":2,"text":"Caching Remote State"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Backends that fetch changes incrementally — keeping a cursor, change token, or cached"},{"type":"text","text":" "},{"type":"text","text":"listing between launches — must store that state "},{"inlineContent":[{"text":"inside the event store’s directory","type":"text"}],"type":"strong"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"supplied by "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup\/setLocalStoreDirectory(_:discardingExistingCache:)","type":"reference","isActive":true},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The reason is lifetime. A cache describes one particular event store at one point in its"},{"type":"text","text":" "},{"type":"text","text":"history. Put it anywhere with an independent lifetime — the system caches directory is"},{"type":"text","text":" "},{"type":"text","text":"the tempting choice — and it can outlive the store it describes. Deleting the app,"},{"type":"text","text":" "},{"type":"text","text":"removing the local store, or resetting the cloud data then leaves the cache behind, and"},{"type":"text","text":" "},{"type":"text","text":"the next launch resumes an incremental fetch from a cursor that no longer matches the"},{"type":"text","text":" "},{"type":"text","text":"cloud. The server answers truthfully that nothing has changed since that cursor, so"},{"type":"text","text":" "},{"type":"text","text":"files that predate it are never mentioned again. The device ends up with a silently"},{"type":"text","text":" "},{"type":"text","text":"partial view of the cloud and no error to report, which is far harder to diagnose than"},{"type":"text","text":" "},{"type":"text","text":"an outright failure."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Keeping the cache in the event store directory ties the two together: removing the store"},{"type":"text","text":" "},{"type":"text","text":"removes the cache, so a rebuilt store always starts from a full fetch."}]},{"type":"codeListing","syntax":"swift","code":["public func setLocalStoreDirectory(_ path: String?, discardingExistingCache: Bool) {","    localStoreDirectory = path","    inMemoryCache = nil          \/\/ never carry state across stores","    guard path != nil else { return }","","    if discardingExistingCache {","        deleteCacheFromDisk()    \/\/ the store is being rebuilt: start clean","        return","    }","    loadCacheFromDisk()","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Three details matter. The method is called before priming whenever an ensemble knows its"},{"type":"text","text":" "},{"type":"text","text":"store, and it is "},{"inlineContent":[{"text":"not","type":"text"}],"type":"emphasis"},{"type":"text","text":" called for ensemble-independent operations such as"},{"type":"text","text":" "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/retrieveEnsembleIdentifiers(from:)","type":"reference","isActive":true},{"type":"text","text":" — so tolerate priming without a"},{"type":"text","text":" "},{"type":"text","text":"directory by simply not caching. When "},{"code":"discardingExistingCache","type":"codeVoice"},{"type":"text","text":" is "},{"code":"true","type":"codeVoice"},{"type":"text","text":" the store is"},{"type":"text","text":" "},{"type":"text","text":"being rebuilt, so delete any cache you find rather than loading it; do the deletion"},{"type":"text","text":" "},{"type":"text","text":"yourself rather than assuming the directory is empty. And never recreate the directory in"},{"type":"text","text":" "},{"type":"text","text":"order to write the cache: if it is gone, the store is gone, and the cache must go with"},{"type":"text","text":" "},{"type":"text","text":"it."}]},{"type":"heading","anchor":"Threading-and-Sendable","level":2,"text":"Threading and Sendable"},{"inlineContent":[{"text":"Cloud file systems must conform to ","type":"text"},{"type":"codeVoice","code":"Sendable"},{"text":". If your implementation uses mutable state, you have several options:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"actor"},{"text":" isolation (as ","type":"text"},{"type":"codeVoice","code":"MemoryCloudFileSystem"},{"text":" does)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"@unchecked Sendable"},{"text":" with explicit locking (as ","type":"text"},{"type":"codeVoice","code":"LocalCloudFileSystem"},{"text":" does)","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Make the type stateless, delegating state to a thread-safe service"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"All protocol methods are "},{"type":"codeVoice","code":"async throws"},{"type":"text","text":", so you can freely call async APIs in your implementation."}],"type":"paragraph"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Ensembles\/documentation\/Ensembles\/CustomCloudBackends"},"sections":[],"kind":"article","variants":[{"paths":["\/documentation\/ensembles\/customcloudbackends"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"seeAlsoSections":[{"title":"Cloud Backends","identifiers":["doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem","doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemBatchOperations","doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup"],"generated":true,"anchor":"Cloud-Backends"}],"abstract":[{"type":"text","text":"Implement the CloudFileSystem protocol to sync via any storage service."}],"hierarchy":{"paths":[["doc:\/\/Ensembles\/documentation\/Ensembles"]]},"metadata":{"role":"article","modules":[{"name":"Ensembles"}],"title":"Custom Cloud Backends","roleHeading":"Article"},"references":{"doc://Ensembles/documentation/Ensembles/CloudDirectory":{"title":"CloudDirectory","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudDirectory","kind":"symbol","navigatorTitle":[{"text":"CloudDirectory","kind":"identifier"}],"url":"\/documentation\/ensembles\/clouddirectory","type":"topic","abstract":[{"type":"text","text":"Represents a directory in a cloud file system."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CloudDirectory","kind":"identifier"}]},"doc://Ensembles/documentation/Ensembles/CloudFileSystem/fetchUserIdentity()":{"role":"symbol","url":"\/documentation\/ensembles\/cloudfilesystem\/fetchuseridentity()","type":"topic","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/fetchUserIdentity()","abstract":[{"type":"text","text":"Fetches a token representing the current user of the cloud file system."},{"type":"text","text":" "},{"type":"text","text":"Often this will be the user or login name."}],"title":"fetchUserIdentity()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"fetchUserIdentity","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> sending (any ","kind":"text"},{"text":"NSCoding","preciseIdentifier":"c:objc(pl)NSCoding","kind":"typeIdentifier"},{"text":" & ","kind":"text"},{"text":"NSCopying","preciseIdentifier":"c:objc(pl)NSCopying","kind":"typeIdentifier"},{"text":" & ","kind":"text"},{"text":"NSObjectProtocol","preciseIdentifier":"c:objc(pl)NSObject","kind":"typeIdentifier"},{"text":")?","kind":"text"}],"required":true,"kind":"symbol"},"doc://Ensembles/documentation/Ensembles/CloudFileSystemSetup/setLocalStoreDirectory(_:discardingExistingCache:)":{"role":"symbol","url":"\/documentation\/ensembles\/cloudfilesystemsetup\/setlocalstoredirectory(_:discardingexistingcache:)","type":"topic","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup\/setLocalStoreDirectory(_:discardingExistingCache:)","defaultImplementations":1,"abstract":[{"type":"text","text":"Tells the file system which local directory belongs to the event store it is serving."}],"title":"setLocalStoreDirectory(_:discardingExistingCache:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"setLocalStoreDirectory","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"discardingExistingCache","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":")","kind":"text"}],"required":true,"kind":"symbol"},"doc://Ensembles/documentation/Ensembles/CloudFileSystemBatchOperations":{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemBatchOperations","kind":"symbol","title":"CloudFileSystemBatchOperations","navigatorTitle":[{"text":"CloudFileSystemBatchOperations","kind":"identifier"}],"url":"\/documentation\/ensembles\/cloudfilesystembatchoperations","type":"topic","abstract":[{"type":"text","text":"Optional batch and setup operations for cloud file systems."}],"role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CloudFileSystemBatchOperations","kind":"identifier"}]},"doc://Ensembles/documentation/Ensembles/CoreDataEnsemble/retrieveEnsembleIdentifiers(from:)":{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/retrieveEnsembleIdentifiers(from:)","url":"\/documentation\/ensembles\/coredataensemble\/retrieveensembleidentifiers(from:)","abstract":[{"type":"text","text":"Queries a cloud file system for the identifiers of the ensembles it contains."}],"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"retrieveEnsembleIdentifiers","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": any ","kind":"text"},{"preciseIdentifier":"s:9Ensembles15CloudFileSystemP","text":"CloudFileSystem","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> [","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"type":"topic","role":"symbol","kind":"symbol","title":"retrieveEnsembleIdentifiers(from:)"},"doc://Ensembles/documentation/Ensembles/CloudFileSystemSetup":{"role":"symbol","url":"\/documentation\/ensembles\/cloudfilesystemsetup","type":"topic","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup","abstract":[{"text":"Optional setup and maintenance operations for cloud file systems.","type":"text"}],"title":"CloudFileSystemSetup","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CloudFileSystemSetup","kind":"identifier"}],"navigatorTitle":[{"text":"CloudFileSystemSetup","kind":"identifier"}],"kind":"symbol"},"doc://Ensembles/documentation/Ensembles/CloudFile":{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFile","navigatorTitle":[{"text":"CloudFile","kind":"identifier"}],"url":"\/documentation\/ensembles\/cloudfile","abstract":[{"type":"text","text":"Represents a file in a cloud file system."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CloudFile","kind":"identifier"}],"type":"topic","role":"symbol","kind":"symbol","title":"CloudFile"},"doc://Ensembles/documentation/Ensembles/CloudFileSystem/connect()":{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/connect()","required":true,"url":"\/documentation\/ensembles\/cloudfilesystem\/connect()","abstract":[{"type":"text","text":"Attempts to connect to the cloud backend."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"connect","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}],"type":"topic","role":"symbol","kind":"symbol","title":"connect()"},"doc://Ensembles/documentation/Ensembles":{"url":"\/documentation\/ensembles","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles","kind":"symbol","role":"collection","abstract":[{"text":"Sync Core Data and SwiftData stores across devices using event sourcing.","type":"text"}],"type":"topic","title":"Ensembles"},"doc://Ensembles/documentation/Ensembles/CloudFileSystem":{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem","kind":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"CloudFileSystem"}],"abstract":[{"type":"text","text":"A cloud file system facilitates data transfer between devices."}],"url":"\/documentation\/ensembles\/cloudfilesystem","title":"CloudFileSystem","role":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"CloudFileSystem"}]},"doc://Ensembles/documentation/Ensembles/CloudFileSystem/isConnected":{"url":"\/documentation\/ensembles\/cloudfilesystem\/isconnected","abstract":[{"text":"Whether the file system is connected and ready for file transactions.","type":"text"}],"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/isConnected","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isConnected"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"kind":"symbol","title":"isConnected","role":"symbol","type":"topic","required":true}}}