{"hierarchy":{"paths":[["doc:\/\/Ensembles\/documentation\/Ensembles"]]},"identifier":{"url":"doc:\/\/Ensembles\/documentation\/Ensembles\/CustomCloudBackends","interfaceLanguage":"swift"},"metadata":{"role":"article","title":"Custom Cloud Backends","modules":[{"name":"Ensembles"}],"roleHeading":"Article"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Ensembles exchanges sync data through a "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem","isActive":true,"type":"reference"},{"type":"text","text":" — a protocol that abstracts file storage behind a simple path-based API. Any service that can store and retrieve files at paths can serve as a backend: cloud storage (S3, Google Cloud Storage), file servers (WebDAV, SFTP), databases, or even peer-to-peer connections with a local cache."}]},{"type":"heading","anchor":"The-CloudFileSystem-Protocol","level":2,"text":"The CloudFileSystem Protocol"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The core protocol has 8 requirements organized into four groups:"}]},{"type":"heading","anchor":"Connection","level":3,"text":"Connection"},{"type":"codeListing","syntax":"swift","code":["public protocol CloudFileSystem: AnyObject, Sendable {","    var isConnected: Bool { get }","    func connect() async throws","    func fetchUserIdentity() async throws","        -> sending (any NSObjectProtocol & NSCoding & NSCopying)?","}"]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/isConnected","isActive":true},{"type":"text","text":" — Return whether the backend is ready for operations."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/connect()","isActive":true},{"type":"text","text":" — Establish a connection. Called before each attach or merge."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/fetchUserIdentity()","isActive":true},{"type":"text","text":" — Return a token identifying the current user, or "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" if identity tracking is not supported. Ensembles uses this to detect account changes (e.g., signing out of iCloud)."}],"type":"paragraph"}]}]},{"type":"heading","anchor":"File-Operations","level":3,"text":"File Operations"},{"type":"codeListing","syntax":"swift","code":["func fileExists(atPath path: String) async throws -> FileExistence","func createDirectory(atPath path: String) async throws","func contentsOfDirectory(atPath path: String) async throws -> [any CloudItem]","func removeItem(atPath path: String) async throws"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Paths are forward-slash separated, rooted at "},{"code":"\/","type":"codeVoice"},{"type":"text","text":". The ensemble creates a directory structure like "},{"code":"\/MyEnsemble\/events\/","type":"codeVoice"},{"type":"text","text":", "},{"code":"\/MyEnsemble\/baselines\/","type":"codeVoice"},{"type":"text","text":", etc."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Directory listings should return "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFile","isActive":true,"type":"reference"},{"type":"text","text":" or "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudDirectory","isActive":true,"type":"reference"},{"type":"text","text":" items with their "},{"code":"path","type":"codeVoice"},{"type":"text","text":" and "},{"code":"name","type":"codeVoice"},{"type":"text","text":" populated. Only list immediate children — do not recurse."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"There is one optional existence check, "},{"code":"confirmFileExists(atPath:)","type":"codeVoice"},{"type":"text","text":", with a default implementation that calls "},{"code":"fileExists(atPath:)","type":"codeVoice"},{"type":"text","text":". The framework uses it for checks whose consequences are drastic, such as the per-sync store-registration check that detects a reset cloud. If your backend answers "},{"code":"fileExists","type":"codeVoice"},{"type":"text","text":" from a local cache of remote state, implement "},{"code":"confirmFileExists","type":"codeVoice"},{"type":"text","text":" to consult the server directly; if "},{"code":"fileExists","type":"codeVoice"},{"type":"text","text":" is already authoritative, the default is correct. Wrapper backends that delegate to another file system must forward "},{"code":"confirmFileExists","type":"codeVoice"},{"type":"text","text":" to the wrapped backend’s "},{"code":"confirmFileExists","type":"codeVoice"},{"type":"text","text":" — the default cannot see through a wrapper, and would quietly downgrade the confirmation to the wrapped backend’s cached check."}]},{"type":"heading","anchor":"File-Transfer","level":3,"text":"File Transfer"},{"type":"codeListing","syntax":"swift","code":["func uploadLocalFile(atPath localPath: String, toPath remotePath: String) async throws","func downloadFile(atPath remotePath: String, toLocalFile localPath: String) async throws"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Upload copies a local file to the remote path. Download copies a remote file to the local path. Both paths are absolute on their respective systems (local paths are filesystem paths; remote paths are within the cloud file system’s namespace)."}]},{"type":"heading","anchor":"A-Minimal-Example","level":2,"text":"A Minimal Example"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Here is a skeleton implementation to illustrate the structure:"}]},{"type":"codeListing","syntax":"swift","code":["import Ensembles","","public final class MyCloudFileSystem: CloudFileSystem, @unchecked Sendable {","","    public var isConnected: Bool { true }","","    public func connect() async throws {","        \/\/ Authenticate or establish a session","    }","","    public func fetchUserIdentity() async throws","        -> sending (any NSObjectProtocol & NSCoding & NSCopying)? {","        \/\/ Return a user token, or nil","        return nil","    }","","    public func fileExists(atPath path: String) async throws -> FileExistence {","        \/\/ Check your storage and return the result","    }","","    public func createDirectory(atPath path: String) async throws {","        \/\/ Create a directory marker or equivalent","    }","","    public func contentsOfDirectory(atPath path: String) async throws","        -> [any CloudItem] {","        \/\/ List immediate children as CloudFile\/CloudDirectory items","    }","","    public func removeItem(atPath path: String) async throws {","        \/\/ Delete a file or directory (and its contents)","    }","","    public func uploadLocalFile(","        atPath localPath: String,","        toPath remotePath: String","    ) async throws {","        let data = try Data(contentsOf: URL(fileURLWithPath: localPath))","        \/\/ Store data at remotePath in your backend","    }","","    public func downloadFile(","        atPath remotePath: String,","        toLocalFile localPath: String","    ) async throws {","        \/\/ Retrieve data from remotePath in your backend","        let data: Data = \/\/ ...fetch from backend","        try data.write(to: URL(fileURLWithPath: localPath), options: .atomic)","    }","}"]},{"type":"heading","anchor":"Reference-Implementations","level":2,"text":"Reference Implementations"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Study the built-in backends as starting points:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":"MemoryCloudFileSystem","type":"codeVoice"}]},{"type":"text","text":" (in "},{"code":"EnsemblesMemory","type":"codeVoice"},{"type":"text","text":") — The simplest implementation. An actor that stores files in a dictionary. Good for understanding the protocol’s expectations."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":"LocalCloudFileSystem","type":"codeVoice"}]},{"type":"text","text":" (in "},{"code":"EnsemblesLocalFile","type":"codeVoice"},{"type":"text","text":") — Uses "},{"code":"FileManager","type":"codeVoice"},{"type":"text","text":" to store files in a local directory. Shows how to map the protocol onto a real file system."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":"CloudKitFileSystem","type":"codeVoice"}]},{"type":"text","text":" (in "},{"code":"EnsemblesCloudKit","type":"codeVoice"},{"type":"text","text":") — A production backend using CloudKit. Shows how to implement batch operations and setup hooks."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":"PCloudCloudFileSystem","type":"codeVoice"}]},{"type":"text","text":" (in "},{"code":"EnsemblesPCloud","type":"codeVoice"},{"type":"text","text":") — A URLSession-based REST client with no SDK dependency. A good model for building backends against any REST API."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":"BoxCloudFileSystem","type":"codeVoice"}]},{"type":"text","text":" (in "},{"code":"EnsemblesBox","type":"codeVoice"},{"type":"text","text":") — Wraps the Box Swift SDK. Demonstrates how to bridge an ID-based API (where files are identified by numeric IDs, not paths) onto the path-based "},{"code":"CloudFileSystem","type":"codeVoice"},{"type":"text","text":" protocol using folder-walking and caching."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":"S3CloudFileSystem","type":"codeVoice"}]},{"type":"text","text":" (in "},{"code":"EnsemblesS3","type":"codeVoice"},{"type":"text","text":") — Wraps the AWS SDK for Swift. Shows how to simulate directory semantics on a flat key-value store using key prefixes and delimiters."}],"type":"paragraph"}]}]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"EnsemblesBox","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"EnsemblesS3","type":"codeVoice"},{"text":" (along with ","type":"text"},{"code":"EnsemblesDropbox","type":"codeVoice"},{"text":", ","type":"text"},{"code":"EnsemblesZip","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"EnsemblesMultipeer","type":"codeVoice"},{"text":") require an external SDK. With the source distribution, enabling the corresponding package trait resolves this automatically. With the binary distribution (XCFrameworks), you must add the external SDK as a separate package dependency — see the Available Backends table in the README for details.","type":"text"}]}],"style":"note","name":"Note"},{"type":"heading","anchor":"Optional-Batch-Operations","level":2,"text":"Optional: Batch Operations"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If your backend can handle multiple files in a single request (reducing round trips), adopt "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemBatchOperations","isActive":true,"type":"reference"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["extension MyCloudFileSystem: CloudFileSystemBatchOperations {","    public var fileUploadMaximumBatchSize: Int { 20 }","    public var fileDownloadMaximumBatchSize: Int { 20 }","","    public func uploadLocalFiles(","        atPaths localPaths: [String],","        toPaths remotePaths: [String]","    ) async throws {","        \/\/ Upload multiple files in one request","    }","","    public func downloadFiles(","        atPaths remotePaths: [String],","        toLocalFiles localPaths: [String]","    ) async throws {","        \/\/ Download multiple files in one request","    }","","    public func removeItems(atPaths paths: [String]) async throws {","        \/\/ Delete multiple items in one request","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"fileUploadMaximumBatchSize","type":"codeVoice"},{"type":"text","text":" and "},{"code":"fileDownloadMaximumBatchSize","type":"codeVoice"},{"type":"text","text":" properties control how many files Ensembles passes per batch call. Default is 10 if you don’t override them."}]},{"type":"heading","anchor":"Optional-Setup-Hooks","level":2,"text":"Optional: Setup Hooks"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For backends that need initialization, caching, or repair logic, adopt "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup","isActive":true,"type":"reference"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["extension MyCloudFileSystem: CloudFileSystemSetup {","    public func performInitialPreparation() async throws {","        \/\/ One-time setup (e.g., create root directories)","    }","","    public func primeForActivity() async throws {","        \/\/ Called before each operation (e.g., refresh auth tokens,","        \/\/ cache directory listings)","    }","","    public func directoryExists(atPath path: String) async throws -> Bool {","        \/\/ Check directory existence","    }","","    public func repairEnsembleDirectory(atPath path: String) async throws {","        \/\/ Fix up issues like iCloud duplicates or stale locks","    }","","    public func setLocalStoreDirectory(_ path: String?, discardingExistingCache: Bool) {","        \/\/ Where to keep any cache of remote state (see below).","        \/\/ Has a default no-op implementation; only implement it if you cache.","    }","}"]},{"type":"heading","anchor":"Caching-Remote-State","level":2,"text":"Caching Remote State"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Backends that fetch changes incrementally — keeping a cursor, change token, or cached"},{"type":"text","text":" "},{"type":"text","text":"listing between launches — must store that state "},{"type":"strong","inlineContent":[{"text":"inside the event store’s directory","type":"text"}]},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"supplied by "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup\/setLocalStoreDirectory(_:discardingExistingCache:)","isActive":true,"type":"reference"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The reason is lifetime. A cache describes one particular event store at one point in its"},{"type":"text","text":" "},{"type":"text","text":"history. Put it anywhere with an independent lifetime — the system caches directory is"},{"type":"text","text":" "},{"type":"text","text":"the tempting choice — and it can outlive the store it describes. Deleting the app,"},{"type":"text","text":" "},{"type":"text","text":"removing the local store, or resetting the cloud data then leaves the cache behind, and"},{"type":"text","text":" "},{"type":"text","text":"the next launch resumes an incremental fetch from a cursor that no longer matches the"},{"type":"text","text":" "},{"type":"text","text":"cloud. The server answers truthfully that nothing has changed since that cursor, so"},{"type":"text","text":" "},{"type":"text","text":"files that predate it are never mentioned again. The device ends up with a silently"},{"type":"text","text":" "},{"type":"text","text":"partial view of the cloud and no error to report, which is far harder to diagnose than"},{"type":"text","text":" "},{"type":"text","text":"an outright failure."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Keeping the cache in the event store directory ties the two together: removing the store"},{"type":"text","text":" "},{"type":"text","text":"removes the cache, so a rebuilt store always starts from a full fetch."}]},{"type":"codeListing","syntax":"swift","code":["public func setLocalStoreDirectory(_ path: String?, discardingExistingCache: Bool) {","    localStoreDirectory = path","    inMemoryCache = nil          \/\/ never carry state across stores","    guard path != nil else { return }","","    if discardingExistingCache {","        deleteCacheFromDisk()    \/\/ the store is being rebuilt: start clean","        return","    }","    loadCacheFromDisk()","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Three details matter. The method is called before priming whenever an ensemble knows its"},{"type":"text","text":" "},{"type":"text","text":"store, and it is "},{"type":"emphasis","inlineContent":[{"text":"not","type":"text"}]},{"type":"text","text":" called for ensemble-independent operations such as"},{"type":"text","text":" "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/retrieveEnsembleIdentifiers(from:)","isActive":true,"type":"reference"},{"type":"text","text":" — so tolerate priming without a"},{"type":"text","text":" "},{"type":"text","text":"directory by simply not caching. When "},{"code":"discardingExistingCache","type":"codeVoice"},{"type":"text","text":" is "},{"code":"true","type":"codeVoice"},{"type":"text","text":" the store is"},{"type":"text","text":" "},{"type":"text","text":"being rebuilt, so delete any cache you find rather than loading it; do the deletion"},{"type":"text","text":" "},{"type":"text","text":"yourself rather than assuming the directory is empty. And never recreate the directory in"},{"type":"text","text":" "},{"type":"text","text":"order to write the cache: if it is gone, the store is gone, and the cache must go with"},{"type":"text","text":" "},{"type":"text","text":"it."}]},{"type":"heading","anchor":"Threading-and-Sendable","level":2,"text":"Threading and Sendable"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Cloud file systems must conform to "},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":". If your implementation uses mutable state, you have several options:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Use "},{"code":"actor","type":"codeVoice"},{"type":"text","text":" isolation (as "},{"code":"MemoryCloudFileSystem","type":"codeVoice"},{"type":"text","text":" does)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Use "},{"code":"@unchecked Sendable","type":"codeVoice"},{"type":"text","text":" with explicit locking (as "},{"code":"LocalCloudFileSystem","type":"codeVoice"},{"type":"text","text":" does)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Make the type stateless, delegating state to a thread-safe service"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"All protocol methods are "},{"code":"async throws","type":"codeVoice"},{"type":"text","text":", so you can freely call async APIs in your implementation."}]}]}],"kind":"article","sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ensembles\/customcloudbackends"]}],"abstract":[{"type":"text","text":"Implement the CloudFileSystem protocol to sync via any storage service."}],"seeAlsoSections":[{"title":"Cloud Backends","generated":true,"anchor":"Cloud-Backends","identifiers":["doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem","doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemBatchOperations","doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup"]}],"references":{"doc://Ensembles/documentation/Ensembles/CoreDataEnsemble/retrieveEnsembleIdentifiers(from:)":{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/retrieveEnsembleIdentifiers(from:)","role":"symbol","abstract":[{"type":"text","text":"Queries a cloud file system for the identifiers of the ensembles it contains."}],"kind":"symbol","type":"topic","url":"\/documentation\/ensembles\/coredataensemble\/retrieveensembleidentifiers(from:)","title":"retrieveEnsembleIdentifiers(from:)","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"retrieveEnsembleIdentifiers","kind":"identifier"},{"kind":"text","text":"("},{"text":"from","kind":"externalParam"},{"text":": any ","kind":"text"},{"text":"CloudFileSystem","kind":"typeIdentifier","preciseIdentifier":"s:9Ensembles15CloudFileSystemP"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"kind":"text","text":" -> ["},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"]"}]},"doc://Ensembles/documentation/Ensembles/CloudFileSystemSetup":{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup","type":"topic","kind":"symbol","title":"CloudFileSystemSetup","navigatorTitle":[{"kind":"identifier","text":"CloudFileSystemSetup"}],"role":"symbol","abstract":[{"type":"text","text":"Optional setup and maintenance operations for cloud file systems."}],"url":"\/documentation\/ensembles\/cloudfilesystemsetup","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CloudFileSystemSetup","kind":"identifier"}]},"doc://Ensembles/documentation/Ensembles":{"title":"Ensembles","type":"topic","role":"collection","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles","kind":"symbol","url":"\/documentation\/ensembles","abstract":[{"type":"text","text":"Sync Core Data and SwiftData stores across devices using event sourcing."}]},"doc://Ensembles/documentation/Ensembles/CloudFileSystem/fetchUserIdentity()":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"fetchUserIdentity"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> sending (any "},{"kind":"typeIdentifier","text":"NSCoding","preciseIdentifier":"c:objc(pl)NSCoding"},{"kind":"text","text":" & "},{"kind":"typeIdentifier","preciseIdentifier":"c:objc(pl)NSCopying","text":"NSCopying"},{"kind":"text","text":" & "},{"kind":"typeIdentifier","preciseIdentifier":"c:objc(pl)NSObject","text":"NSObjectProtocol"},{"kind":"text","text":")?"}],"required":true,"type":"topic","url":"\/documentation\/ensembles\/cloudfilesystem\/fetchuseridentity()","abstract":[{"text":"Fetches a token representing the current user of the cloud file system.","type":"text"},{"text":" ","type":"text"},{"text":"Often this will be the user or login name.","type":"text"}],"role":"symbol","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/fetchUserIdentity()","title":"fetchUserIdentity()","kind":"symbol"},"doc://Ensembles/documentation/Ensembles/CloudFileSystem/connect()":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"connect"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"}],"required":true,"url":"\/documentation\/ensembles\/cloudfilesystem\/connect()","type":"topic","abstract":[{"text":"Attempts to connect to the cloud backend.","type":"text"}],"role":"symbol","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/connect()","title":"connect()","kind":"symbol"},"doc://Ensembles/documentation/Ensembles/CloudFileSystem":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"CloudFileSystem"}],"navigatorTitle":[{"kind":"identifier","text":"CloudFileSystem"}],"url":"\/documentation\/ensembles\/cloudfilesystem","type":"topic","abstract":[{"text":"A cloud file system facilitates data transfer between devices.","type":"text"}],"role":"symbol","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem","title":"CloudFileSystem","kind":"symbol"},"doc://Ensembles/documentation/Ensembles/CloudFile":{"title":"CloudFile","type":"topic","role":"symbol","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFile","kind":"symbol","url":"\/documentation\/ensembles\/cloudfile","abstract":[{"type":"text","text":"Represents a file in a cloud file system."}],"navigatorTitle":[{"text":"CloudFile","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"text":"CloudFile","kind":"identifier"}]},"doc://Ensembles/documentation/Ensembles/CloudDirectory":{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudDirectory","type":"topic","kind":"symbol","title":"CloudDirectory","navigatorTitle":[{"text":"CloudDirectory","kind":"identifier"}],"role":"symbol","abstract":[{"type":"text","text":"Represents a directory in a cloud file system."}],"url":"\/documentation\/ensembles\/clouddirectory","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CloudDirectory","kind":"identifier"}]},"doc://Ensembles/documentation/Ensembles/CloudFileSystemBatchOperations":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CloudFileSystemBatchOperations","kind":"identifier"}],"navigatorTitle":[{"text":"CloudFileSystemBatchOperations","kind":"identifier"}],"type":"topic","url":"\/documentation\/ensembles\/cloudfilesystembatchoperations","abstract":[{"text":"Optional batch and setup operations for cloud file systems.","type":"text"}],"role":"symbol","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemBatchOperations","title":"CloudFileSystemBatchOperations","kind":"symbol"},"doc://Ensembles/documentation/Ensembles/CloudFileSystemSetup/setLocalStoreDirectory(_:discardingExistingCache:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"setLocalStoreDirectory"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"discardingExistingCache"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":")"}],"required":true,"url":"\/documentation\/ensembles\/cloudfilesystemsetup\/setlocalstoredirectory(_:discardingexistingcache:)","type":"topic","abstract":[{"text":"Tells the file system which local directory belongs to the event store it is serving.","type":"text"}],"role":"symbol","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup\/setLocalStoreDirectory(_:discardingExistingCache:)","defaultImplementations":1,"title":"setLocalStoreDirectory(_:discardingExistingCache:)","kind":"symbol"},"doc://Ensembles/documentation/Ensembles/CloudFileSystem/isConnected":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isConnected"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"required":true,"url":"\/documentation\/ensembles\/cloudfilesystem\/isconnected","type":"topic","abstract":[{"text":"Whether the file system is connected and ready for file transactions.","type":"text"}],"role":"symbol","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/isConnected","title":"isConnected","kind":"symbol"}}}