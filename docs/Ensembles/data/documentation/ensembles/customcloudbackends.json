{"identifier":{"url":"doc:\/\/Ensembles\/documentation\/Ensembles\/CustomCloudBackends","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Ensembles exchanges sync data through a "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem","type":"reference","isActive":true},{"type":"text","text":" — a protocol that abstracts file storage behind a simple path-based API. Any service that can store and retrieve files at paths can serve as a backend: cloud storage (S3, Google Cloud Storage), file servers (WebDAV, SFTP), databases, or even peer-to-peer connections with a local cache."}]},{"text":"The CloudFileSystem Protocol","type":"heading","level":2,"anchor":"The-CloudFileSystem-Protocol"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The core protocol has 8 requirements organized into four groups:"}]},{"text":"Connection","type":"heading","level":3,"anchor":"Connection"},{"type":"codeListing","syntax":"swift","code":["public protocol CloudFileSystem: AnyObject, Sendable {","    var isConnected: Bool { get }","    func connect() async throws","    func fetchUserIdentity() async throws","        -> sending (any NSObjectProtocol & NSCoding & NSCopying)?","}"]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/isConnected","type":"reference","isActive":true},{"type":"text","text":" — Return whether the backend is ready for operations."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/connect()","type":"reference","isActive":true},{"type":"text","text":" — Establish a connection. Called before each attach or merge."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/fetchUserIdentity()","type":"reference","isActive":true},{"type":"text","text":" — Return a token identifying the current user, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" if identity tracking is not supported. Ensembles uses this to detect account changes (e.g., signing out of iCloud)."}]}]}]},{"text":"File Operations","type":"heading","level":3,"anchor":"File-Operations"},{"type":"codeListing","syntax":"swift","code":["func fileExists(atPath path: String) async throws -> FileExistence","func createDirectory(atPath path: String) async throws","func contentsOfDirectory(atPath path: String) async throws -> [any CloudItem]","func removeItem(atPath path: String) async throws"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Paths are forward-slash separated, rooted at "},{"code":"\/","type":"codeVoice"},{"type":"text","text":". The ensemble creates a directory structure like "},{"code":"\/MyEnsemble\/events\/","type":"codeVoice"},{"type":"text","text":", "},{"code":"\/MyEnsemble\/baselines\/","type":"codeVoice"},{"type":"text","text":", etc."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Directory listings should return "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFile","type":"reference","isActive":true},{"type":"text","text":" or "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudDirectory","type":"reference","isActive":true},{"type":"text","text":" items with their "},{"code":"path","type":"codeVoice"},{"type":"text","text":" and "},{"code":"name","type":"codeVoice"},{"type":"text","text":" populated. Only list immediate children — do not recurse."}]},{"text":"File Transfer","type":"heading","level":3,"anchor":"File-Transfer"},{"type":"codeListing","syntax":"swift","code":["func uploadLocalFile(atPath localPath: String, toPath remotePath: String) async throws","func downloadFile(atPath remotePath: String, toLocalFile localPath: String) async throws"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Upload copies a local file to the remote path. Download copies a remote file to the local path. Both paths are absolute on their respective systems (local paths are filesystem paths; remote paths are within the cloud file system’s namespace)."}]},{"text":"A Minimal Example","type":"heading","level":2,"anchor":"A-Minimal-Example"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Here is a skeleton implementation to illustrate the structure:"}]},{"type":"codeListing","syntax":"swift","code":["import Ensembles","","public final class MyCloudFileSystem: CloudFileSystem, @unchecked Sendable {","","    public var isConnected: Bool { true }","","    public func connect() async throws {","        \/\/ Authenticate or establish a session","    }","","    public func fetchUserIdentity() async throws","        -> sending (any NSObjectProtocol & NSCoding & NSCopying)? {","        \/\/ Return a user token, or nil","        return nil","    }","","    public func fileExists(atPath path: String) async throws -> FileExistence {","        \/\/ Check your storage and return the result","    }","","    public func createDirectory(atPath path: String) async throws {","        \/\/ Create a directory marker or equivalent","    }","","    public func contentsOfDirectory(atPath path: String) async throws","        -> [any CloudItem] {","        \/\/ List immediate children as CloudFile\/CloudDirectory items","    }","","    public func removeItem(atPath path: String) async throws {","        \/\/ Delete a file or directory (and its contents)","    }","","    public func uploadLocalFile(","        atPath localPath: String,","        toPath remotePath: String","    ) async throws {","        let data = try Data(contentsOf: URL(fileURLWithPath: localPath))","        \/\/ Store data at remotePath in your backend","    }","","    public func downloadFile(","        atPath remotePath: String,","        toLocalFile localPath: String","    ) async throws {","        \/\/ Retrieve data from remotePath in your backend","        let data: Data = \/\/ ...fetch from backend","        try data.write(to: URL(fileURLWithPath: localPath), options: .atomic)","    }","}"]},{"text":"Reference Implementations","type":"heading","level":2,"anchor":"Reference-Implementations"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Study the built-in backends as starting points:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"MemoryCloudFileSystem"}],"type":"strong"},{"type":"text","text":" (in "},{"type":"codeVoice","code":"EnsemblesMemory"},{"type":"text","text":") — The simplest implementation. An actor that stores files in a dictionary. Good for understanding the protocol’s expectations."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"LocalCloudFileSystem"}],"type":"strong"},{"type":"text","text":" (in "},{"type":"codeVoice","code":"EnsemblesLocalFile"},{"type":"text","text":") — Uses "},{"type":"codeVoice","code":"FileManager"},{"type":"text","text":" to store files in a local directory. Shows how to map the protocol onto a real file system."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"CloudKitFileSystem"}],"type":"strong"},{"type":"text","text":" (in "},{"type":"codeVoice","code":"EnsemblesCloudKit"},{"type":"text","text":") — A production backend using CloudKit. Shows how to implement batch operations and setup hooks."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"PCloudCloudFileSystem"}],"type":"strong"},{"type":"text","text":" (in "},{"type":"codeVoice","code":"EnsemblesPCloud"},{"type":"text","text":") — A URLSession-based REST client with no SDK dependency. A good model for building backends against any REST API."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"BoxCloudFileSystem"}],"type":"strong"},{"type":"text","text":" (in "},{"type":"codeVoice","code":"EnsemblesBox"},{"type":"text","text":") — Wraps the Box Swift SDK. Demonstrates how to bridge an ID-based API (where files are identified by numeric IDs, not paths) onto the path-based "},{"type":"codeVoice","code":"CloudFileSystem"},{"type":"text","text":" protocol using folder-walking and caching."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"S3CloudFileSystem"}],"type":"strong"},{"type":"text","text":" (in "},{"type":"codeVoice","code":"EnsemblesS3"},{"type":"text","text":") — Wraps the AWS SDK for Swift. Shows how to simulate directory semantics on a flat key-value store using key prefixes and delimiters."}]}]}]},{"type":"aside","name":"Note","style":"note","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"EnsemblesBox"},{"type":"text","text":" and "},{"type":"codeVoice","code":"EnsemblesS3"},{"type":"text","text":" (along with "},{"type":"codeVoice","code":"EnsemblesDropbox"},{"type":"text","text":", "},{"type":"codeVoice","code":"EnsemblesZip"},{"type":"text","text":", and "},{"type":"codeVoice","code":"EnsemblesMultipeer"},{"type":"text","text":") require an external SDK. With the source distribution, enabling the corresponding package trait resolves this automatically. With the binary distribution (XCFrameworks), you must add the external SDK as a separate package dependency — see the Available Backends table in the README for details."}],"type":"paragraph"}]},{"text":"Optional: Batch Operations","type":"heading","level":2,"anchor":"Optional-Batch-Operations"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If your backend can handle multiple files in a single request (reducing round trips), adopt "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemBatchOperations","type":"reference","isActive":true},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["extension MyCloudFileSystem: CloudFileSystemBatchOperations {","    public var fileUploadMaximumBatchSize: Int { 20 }","    public var fileDownloadMaximumBatchSize: Int { 20 }","","    public func uploadLocalFiles(","        atPaths localPaths: [String],","        toPaths remotePaths: [String]","    ) async throws {","        \/\/ Upload multiple files in one request","    }","","    public func downloadFiles(","        atPaths remotePaths: [String],","        toLocalFiles localPaths: [String]","    ) async throws {","        \/\/ Download multiple files in one request","    }","","    public func removeItems(atPaths paths: [String]) async throws {","        \/\/ Delete multiple items in one request","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"fileUploadMaximumBatchSize","type":"codeVoice"},{"type":"text","text":" and "},{"code":"fileDownloadMaximumBatchSize","type":"codeVoice"},{"type":"text","text":" properties control how many files Ensembles passes per batch call. Default is 10 if you don’t override them."}]},{"text":"Optional: Setup Hooks","type":"heading","level":2,"anchor":"Optional-Setup-Hooks"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For backends that need initialization, caching, or repair logic, adopt "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup","type":"reference","isActive":true},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["extension MyCloudFileSystem: CloudFileSystemSetup {","    public func performInitialPreparation() async throws {","        \/\/ One-time setup (e.g., create root directories)","    }","","    public func primeForActivity() async throws {","        \/\/ Called before each operation (e.g., refresh auth tokens,","        \/\/ cache directory listings)","    }","","    public func directoryExists(atPath path: String) async throws -> Bool {","        \/\/ Check directory existence","    }","","    public func repairEnsembleDirectory(atPath path: String) async throws {","        \/\/ Fix up issues like iCloud duplicates or stale locks","    }","","    public func setLocalStoreDirectory(_ path: String?, discardingExistingCache: Bool) {","        \/\/ Where to keep any cache of remote state (see below).","        \/\/ Has a default no-op implementation; only implement it if you cache.","    }","}"]},{"text":"Caching Remote State","type":"heading","level":2,"anchor":"Caching-Remote-State"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Backends that fetch changes incrementally — keeping a cursor, change token, or cached"},{"type":"text","text":" "},{"type":"text","text":"listing between launches — must store that state "},{"inlineContent":[{"type":"text","text":"inside the event store’s directory"}],"type":"strong"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"supplied by "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup\/setLocalStoreDirectory(_:discardingExistingCache:)","type":"reference","isActive":true},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The reason is lifetime. A cache describes one particular event store at one point in its"},{"type":"text","text":" "},{"type":"text","text":"history. Put it anywhere with an independent lifetime — the system caches directory is"},{"type":"text","text":" "},{"type":"text","text":"the tempting choice — and it can outlive the store it describes. Deleting the app,"},{"type":"text","text":" "},{"type":"text","text":"removing the local store, or resetting the cloud data then leaves the cache behind, and"},{"type":"text","text":" "},{"type":"text","text":"the next launch resumes an incremental fetch from a cursor that no longer matches the"},{"type":"text","text":" "},{"type":"text","text":"cloud. The server answers truthfully that nothing has changed since that cursor, so"},{"type":"text","text":" "},{"type":"text","text":"files that predate it are never mentioned again. The device ends up with a silently"},{"type":"text","text":" "},{"type":"text","text":"partial view of the cloud and no error to report, which is far harder to diagnose than"},{"type":"text","text":" "},{"type":"text","text":"an outright failure."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Keeping the cache in the event store directory ties the two together: removing the store"},{"type":"text","text":" "},{"type":"text","text":"removes the cache, so a rebuilt store always starts from a full fetch."}]},{"type":"codeListing","syntax":"swift","code":["public func setLocalStoreDirectory(_ path: String?, discardingExistingCache: Bool) {","    localStoreDirectory = path","    inMemoryCache = nil          \/\/ never carry state across stores","    guard path != nil else { return }","","    if discardingExistingCache {","        deleteCacheFromDisk()    \/\/ the store is being rebuilt: start clean","        return","    }","    loadCacheFromDisk()","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Three details matter. The method is called before priming whenever an ensemble knows its"},{"type":"text","text":" "},{"type":"text","text":"store, and it is "},{"inlineContent":[{"type":"text","text":"not"}],"type":"emphasis"},{"type":"text","text":" called for ensemble-independent operations such as"},{"type":"text","text":" "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/retrieveEnsembleIdentifiers(from:)","type":"reference","isActive":true},{"type":"text","text":" — so tolerate priming without a"},{"type":"text","text":" "},{"type":"text","text":"directory by simply not caching. When "},{"code":"discardingExistingCache","type":"codeVoice"},{"type":"text","text":" is "},{"code":"true","type":"codeVoice"},{"type":"text","text":" the store is"},{"type":"text","text":" "},{"type":"text","text":"being rebuilt, so delete any cache you find rather than loading it; do the deletion"},{"type":"text","text":" "},{"type":"text","text":"yourself rather than assuming the directory is empty. And never recreate the directory in"},{"type":"text","text":" "},{"type":"text","text":"order to write the cache: if it is gone, the store is gone, and the cache must go with"},{"type":"text","text":" "},{"type":"text","text":"it."}]},{"text":"Threading and Sendable","type":"heading","level":2,"anchor":"Threading-and-Sendable"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Cloud file systems must conform to "},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":". If your implementation uses mutable state, you have several options:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"actor"},{"type":"text","text":" isolation (as "},{"type":"codeVoice","code":"MemoryCloudFileSystem"},{"type":"text","text":" does)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"@unchecked Sendable"},{"type":"text","text":" with explicit locking (as "},{"type":"codeVoice","code":"LocalCloudFileSystem"},{"type":"text","text":" does)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Make the type stateless, delegating state to a thread-safe service"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"All protocol methods are "},{"code":"async throws","type":"codeVoice"},{"type":"text","text":", so you can freely call async APIs in your implementation."}]}],"kind":"content"}],"kind":"article","hierarchy":{"paths":[["doc:\/\/Ensembles\/documentation\/Ensembles"]]},"sections":[],"seeAlsoSections":[{"title":"Cloud Backends","anchor":"Cloud-Backends","identifiers":["doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem","doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemBatchOperations","doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup"],"generated":true}],"metadata":{"role":"article","modules":[{"name":"Ensembles"}],"title":"Custom Cloud Backends","roleHeading":"Article"},"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"text":"Implement the CloudFileSystem protocol to sync via any storage service.","type":"text"}],"variants":[{"paths":["\/documentation\/ensembles\/customcloudbackends"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Ensembles/documentation/Ensembles":{"kind":"symbol","url":"\/documentation\/ensembles","type":"topic","role":"collection","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles","title":"Ensembles","abstract":[{"type":"text","text":"Sync Core Data and SwiftData stores across devices using event sourcing."}]},"doc://Ensembles/documentation/Ensembles/CloudFileSystemBatchOperations":{"navigatorTitle":[{"kind":"identifier","text":"CloudFileSystemBatchOperations"}],"url":"\/documentation\/ensembles\/cloudfilesystembatchoperations","type":"topic","title":"CloudFileSystemBatchOperations","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"CloudFileSystemBatchOperations"}],"abstract":[{"text":"Optional batch and setup operations for cloud file systems.","type":"text"}],"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemBatchOperations","kind":"symbol"},"doc://Ensembles/documentation/Ensembles/CloudDirectory":{"navigatorTitle":[{"text":"CloudDirectory","kind":"identifier"}],"abstract":[{"type":"text","text":"Represents a directory in a cloud file system."}],"title":"CloudDirectory","type":"topic","kind":"symbol","url":"\/documentation\/ensembles\/clouddirectory","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CloudDirectory"}],"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudDirectory"},"doc://Ensembles/documentation/Ensembles/CloudFileSystem/connect()":{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/connect()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"connect","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}],"role":"symbol","url":"\/documentation\/ensembles\/cloudfilesystem\/connect()","title":"connect()","required":true,"abstract":[{"type":"text","text":"Attempts to connect to the cloud backend."}],"type":"topic","kind":"symbol"},"doc://Ensembles/documentation/Ensembles/CloudFileSystem":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"CloudFileSystem"}],"navigatorTitle":[{"kind":"identifier","text":"CloudFileSystem"}],"url":"\/documentation\/ensembles\/cloudfilesystem","role":"symbol","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem","title":"CloudFileSystem","kind":"symbol","abstract":[{"type":"text","text":"A cloud file system facilitates data transfer between devices."}],"type":"topic"},"doc://Ensembles/documentation/Ensembles/CloudFileSystem/isConnected":{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/isConnected","abstract":[{"text":"Whether the file system is connected and ready for file transactions.","type":"text"}],"required":true,"kind":"symbol","title":"isConnected","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isConnected","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"url":"\/documentation\/ensembles\/cloudfilesystem\/isconnected","role":"symbol","type":"topic"},"doc://Ensembles/documentation/Ensembles/CloudFileSystemSetup/setLocalStoreDirectory(_:discardingExistingCache:)":{"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"setLocalStoreDirectory"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"discardingExistingCache"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":")"}],"required":true,"url":"\/documentation\/ensembles\/cloudfilesystemsetup\/setlocalstoredirectory(_:discardingexistingcache:)","type":"topic","kind":"symbol","defaultImplementations":1,"title":"setLocalStoreDirectory(_:discardingExistingCache:)","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup\/setLocalStoreDirectory(_:discardingExistingCache:)","abstract":[{"type":"text","text":"Tells the file system which local directory belongs to the event store it is serving."}]},"doc://Ensembles/documentation/Ensembles/CloudFileSystem/fetchUserIdentity()":{"kind":"symbol","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/fetchUserIdentity()","url":"\/documentation\/ensembles\/cloudfilesystem\/fetchuseridentity()","type":"topic","title":"fetchUserIdentity()","abstract":[{"text":"Fetches a token representing the current user of the cloud file system.","type":"text"},{"text":" ","type":"text"},{"text":"Often this will be the user or login name.","type":"text"}],"required":true,"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"fetchUserIdentity"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> sending (any "},{"preciseIdentifier":"c:objc(pl)NSCoding","kind":"typeIdentifier","text":"NSCoding"},{"kind":"text","text":" & "},{"preciseIdentifier":"c:objc(pl)NSCopying","kind":"typeIdentifier","text":"NSCopying"},{"kind":"text","text":" & "},{"preciseIdentifier":"c:objc(pl)NSObject","kind":"typeIdentifier","text":"NSObjectProtocol"},{"kind":"text","text":")?"}]},"doc://Ensembles/documentation/Ensembles/CloudFileSystemSetup":{"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"CloudFileSystemSetup"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"CloudFileSystemSetup"}],"url":"\/documentation\/ensembles\/cloudfilesystemsetup","type":"topic","kind":"symbol","title":"CloudFileSystemSetup","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup","abstract":[{"type":"text","text":"Optional setup and maintenance operations for cloud file systems."}]},"doc://Ensembles/documentation/Ensembles/CoreDataEnsemble/retrieveEnsembleIdentifiers(from:)":{"role":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"retrieveEnsembleIdentifiers"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": any "},{"kind":"typeIdentifier","preciseIdentifier":"s:9Ensembles15CloudFileSystemP","text":"CloudFileSystem"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> ["},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"]"}],"url":"\/documentation\/ensembles\/coredataensemble\/retrieveensembleidentifiers(from:)","type":"topic","kind":"symbol","title":"retrieveEnsembleIdentifiers(from:)","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/retrieveEnsembleIdentifiers(from:)","abstract":[{"type":"text","text":"Queries a cloud file system for the identifiers of the ensembles it contains."}]},"doc://Ensembles/documentation/Ensembles/CloudFile":{"title":"CloudFile","url":"\/documentation\/ensembles\/cloudfile","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CloudFile","kind":"identifier"}],"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFile","type":"topic","abstract":[{"type":"text","text":"Represents a file in a cloud file system."}],"navigatorTitle":[{"text":"CloudFile","kind":"identifier"}],"kind":"symbol","role":"symbol"}}}