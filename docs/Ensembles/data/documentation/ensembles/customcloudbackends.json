{"hierarchy":{"paths":[["doc:\/\/Ensembles\/documentation\/Ensembles"]]},"variants":[{"paths":["\/documentation\/ensembles\/customcloudbackends"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"Implement the CloudFileSystem protocol to sync via any storage service.","type":"text"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"article","metadata":{"title":"Custom Cloud Backends","role":"article","roleHeading":"Article","modules":[{"name":"Ensembles"}]},"seeAlsoSections":[{"title":"Cloud Backends","generated":true,"identifiers":["doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem","doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemBatchOperations","doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup"],"anchor":"Cloud-Backends"}],"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"inlineContent":[{"text":"Ensembles exchanges sync data through a ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem"},{"text":" — a protocol that abstracts file storage behind a simple path-based API. Any service that can store and retrieve files at paths can serve as a backend: cloud storage (S3, Google Cloud Storage), file servers (WebDAV, SFTP), databases, or even peer-to-peer connections with a local cache.","type":"text"}],"type":"paragraph"},{"level":2,"text":"The CloudFileSystem Protocol","type":"heading","anchor":"The-CloudFileSystem-Protocol"},{"type":"paragraph","inlineContent":[{"text":"The core protocol has 8 requirements organized into four groups:","type":"text"}]},{"level":3,"text":"Connection","type":"heading","anchor":"Connection"},{"type":"codeListing","code":["public protocol CloudFileSystem: AnyObject, Sendable {","    var isConnected: Bool { get }","    func connect() async throws","    func fetchUserIdentity() async throws","        -> sending (any NSObjectProtocol & NSCoding & NSCopying)?","}"],"syntax":"swift"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/isConnected"},{"text":" — Return whether the backend is ready for operations.","type":"text"}]}]},{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/connect()","type":"reference"},{"text":" — Establish a connection. Called before each attach or merge.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/fetchUserIdentity()"},{"type":"text","text":" — Return a token identifying the current user, or "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" if identity tracking is not supported. Ensembles uses this to detect account changes (e.g., signing out of iCloud)."}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"File Operations","type":"heading","level":3,"anchor":"File-Operations"},{"type":"codeListing","code":["func fileExists(atPath path: String) async throws -> FileExistence","func createDirectory(atPath path: String) async throws","func contentsOfDirectory(atPath path: String) async throws -> [any CloudItem]","func removeItem(atPath path: String) async throws"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Paths are forward-slash separated, rooted at ","type":"text"},{"code":"\/","type":"codeVoice"},{"text":". The ensemble creates a directory structure like ","type":"text"},{"type":"codeVoice","code":"\/MyEnsemble\/events\/"},{"text":", ","type":"text"},{"type":"codeVoice","code":"\/MyEnsemble\/baselines\/"},{"text":", etc.","type":"text"}]},{"inlineContent":[{"text":"Directory listings should return ","type":"text"},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFile","isActive":true,"type":"reference"},{"text":" or ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudDirectory","type":"reference"},{"text":" items with their ","type":"text"},{"type":"codeVoice","code":"path"},{"text":" and ","type":"text"},{"code":"name","type":"codeVoice"},{"text":" populated. Only list immediate children — do not recurse.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"There is one optional existence check, ","type":"text"},{"code":"confirmFileExists(atPath:)","type":"codeVoice"},{"text":", with a default implementation that calls ","type":"text"},{"code":"fileExists(atPath:)","type":"codeVoice"},{"text":". The framework uses it for checks whose consequences are drastic, such as the per-sync store-registration check that detects a reset cloud. If your backend answers ","type":"text"},{"code":"fileExists","type":"codeVoice"},{"text":" from a local cache of remote state, implement ","type":"text"},{"code":"confirmFileExists","type":"codeVoice"},{"text":" to consult the server directly; if ","type":"text"},{"code":"fileExists","type":"codeVoice"},{"text":" is already authoritative, the default is correct. Wrapper backends that delegate to another file system must forward ","type":"text"},{"code":"confirmFileExists","type":"codeVoice"},{"text":" to the wrapped backend’s ","type":"text"},{"code":"confirmFileExists","type":"codeVoice"},{"text":" — the default cannot see through a wrapper, and would quietly downgrade the confirmation to the wrapped backend’s cached check.","type":"text"}],"type":"paragraph"},{"text":"File Transfer","type":"heading","level":3,"anchor":"File-Transfer"},{"type":"codeListing","code":["func uploadLocalFile(atPath localPath: String, toPath remotePath: String) async throws","func downloadFile(atPath remotePath: String, toLocalFile localPath: String) async throws"],"syntax":"swift"},{"inlineContent":[{"text":"Upload copies a local file to the remote path. Download copies a remote file to the local path. Both paths are absolute on their respective systems (local paths are filesystem paths; remote paths are within the cloud file system’s namespace).","type":"text"}],"type":"paragraph"},{"text":"A Minimal Example","type":"heading","level":2,"anchor":"A-Minimal-Example"},{"inlineContent":[{"text":"Here is a skeleton implementation to illustrate the structure:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["import Ensembles","","public final class MyCloudFileSystem: CloudFileSystem, @unchecked Sendable {","","    public var isConnected: Bool { true }","","    public func connect() async throws {","        \/\/ Authenticate or establish a session","    }","","    public func fetchUserIdentity() async throws","        -> sending (any NSObjectProtocol & NSCoding & NSCopying)? {","        \/\/ Return a user token, or nil","        return nil","    }","","    public func fileExists(atPath path: String) async throws -> FileExistence {","        \/\/ Check your storage and return the result","    }","","    public func createDirectory(atPath path: String) async throws {","        \/\/ Create a directory marker or equivalent","    }","","    public func contentsOfDirectory(atPath path: String) async throws","        -> [any CloudItem] {","        \/\/ List immediate children as CloudFile\/CloudDirectory items","    }","","    public func removeItem(atPath path: String) async throws {","        \/\/ Delete a file or directory (and its contents)","    }","","    public func uploadLocalFile(","        atPath localPath: String,","        toPath remotePath: String","    ) async throws {","        let data = try Data(contentsOf: URL(fileURLWithPath: localPath))","        \/\/ Store data at remotePath in your backend","    }","","    public func downloadFile(","        atPath remotePath: String,","        toLocalFile localPath: String","    ) async throws {","        \/\/ Retrieve data from remotePath in your backend","        let data: Data = \/\/ ...fetch from backend","        try data.write(to: URL(fileURLWithPath: localPath), options: .atomic)","    }","}"],"syntax":"swift"},{"text":"Reference Implementations","type":"heading","level":2,"anchor":"Reference-Implementations"},{"inlineContent":[{"text":"Study the built-in backends as starting points:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"MemoryCloudFileSystem"}]},{"text":" (in ","type":"text"},{"type":"codeVoice","code":"EnsemblesMemory"},{"text":") — The simplest implementation. An actor that stores files in a dictionary. Good for understanding the protocol’s expectations.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"LocalCloudFileSystem"}]},{"text":" (in ","type":"text"},{"type":"codeVoice","code":"EnsemblesLocalFile"},{"text":") — Uses ","type":"text"},{"type":"codeVoice","code":"FileManager"},{"text":" to store files in a local directory. Shows how to map the protocol onto a real file system.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"CloudKitFileSystem"}]},{"text":" (in ","type":"text"},{"type":"codeVoice","code":"EnsemblesCloudKit"},{"text":") — A production backend using CloudKit. Shows how to implement batch operations and setup hooks.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"PCloudCloudFileSystem"}]},{"text":" (in ","type":"text"},{"type":"codeVoice","code":"EnsemblesPCloud"},{"text":") — A URLSession-based REST client with no SDK dependency. A good model for building backends against any REST API.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"BoxCloudFileSystem"}]},{"text":" (in ","type":"text"},{"type":"codeVoice","code":"EnsemblesBox"},{"text":") — Wraps the Box Swift SDK. Demonstrates how to bridge an ID-based API (where files are identified by numeric IDs, not paths) onto the path-based ","type":"text"},{"type":"codeVoice","code":"CloudFileSystem"},{"text":" protocol using folder-walking and caching.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"S3CloudFileSystem"}]},{"text":" (in ","type":"text"},{"type":"codeVoice","code":"EnsemblesS3"},{"text":") — Wraps the AWS SDK for Swift. Shows how to simulate directory semantics on a flat key-value store using key prefixes and delimiters.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"content":[{"inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"EnsemblesBox"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"EnsemblesS3"},{"text":" (along with ","type":"text"},{"type":"codeVoice","code":"EnsemblesDropbox"},{"text":", ","type":"text"},{"type":"codeVoice","code":"EnsemblesZip"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"EnsemblesMultipeer"},{"text":") require an external SDK. With the source distribution, enabling the corresponding package trait resolves this automatically. With the binary distribution (XCFrameworks), you must add the external SDK as a separate package dependency — see the Available Backends table in the README for details.","type":"text"}],"type":"paragraph"}],"style":"note","type":"aside","name":"Note"},{"text":"Optional: Batch Operations","type":"heading","level":2,"anchor":"Optional-Batch-Operations"},{"inlineContent":[{"text":"If your backend can handle multiple files in a single request (reducing round trips), adopt ","type":"text"},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemBatchOperations","isActive":true,"type":"reference"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["extension MyCloudFileSystem: CloudFileSystemBatchOperations {","    public var fileUploadMaximumBatchSize: Int { 20 }","    public var fileDownloadMaximumBatchSize: Int { 20 }","","    public func uploadLocalFiles(","        atPaths localPaths: [String],","        toPaths remotePaths: [String]","    ) async throws {","        \/\/ Upload multiple files in one request","    }","","    public func downloadFiles(","        atPaths remotePaths: [String],","        toLocalFiles localPaths: [String]","    ) async throws {","        \/\/ Download multiple files in one request","    }","","    public func removeItems(atPaths paths: [String]) async throws {","        \/\/ Delete multiple items in one request","    }","}"],"syntax":"swift"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"fileUploadMaximumBatchSize","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"fileDownloadMaximumBatchSize","type":"codeVoice"},{"text":" properties control how many files Ensembles passes per batch call. Default is 10 if you don’t override them.","type":"text"}],"type":"paragraph"},{"text":"Optional: Setup Hooks","type":"heading","level":2,"anchor":"Optional-Setup-Hooks"},{"inlineContent":[{"text":"For backends that need initialization, caching, or repair logic, adopt ","type":"text"},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup","isActive":true,"type":"reference"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["extension MyCloudFileSystem: CloudFileSystemSetup {","    public func performInitialPreparation() async throws {","        \/\/ One-time setup (e.g., create root directories)","    }","","    public func primeForActivity() async throws {","        \/\/ Called before each operation (e.g., refresh auth tokens,","        \/\/ cache directory listings)","    }","","    public func directoryExists(atPath path: String) async throws -> Bool {","        \/\/ Check directory existence","    }","","    public func repairEnsembleDirectory(atPath path: String) async throws {","        \/\/ Fix up issues like iCloud duplicates or stale locks","    }","","    public func setLocalStoreDirectory(_ path: String?, discardingExistingCache: Bool) {","        \/\/ Where to keep any cache of remote state (see below).","        \/\/ Has a default no-op implementation; only implement it if you cache.","    }","}"],"syntax":"swift"},{"text":"Caching Remote State","type":"heading","level":2,"anchor":"Caching-Remote-State"},{"inlineContent":[{"text":"Backends that fetch changes incrementally — keeping a cursor, change token, or cached","type":"text"},{"text":" ","type":"text"},{"text":"listing between launches — must store that state ","type":"text"},{"inlineContent":[{"text":"inside the event store’s directory","type":"text"}],"type":"strong"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"supplied by ","type":"text"},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup\/setLocalStoreDirectory(_:discardingExistingCache:)","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The reason is lifetime. A cache describes one particular event store at one point in its","type":"text"},{"text":" ","type":"text"},{"text":"history. Put it anywhere with an independent lifetime — the system caches directory is","type":"text"},{"text":" ","type":"text"},{"text":"the tempting choice — and it can outlive the store it describes. Deleting the app,","type":"text"},{"text":" ","type":"text"},{"text":"removing the local store, or resetting the cloud data then leaves the cache behind, and","type":"text"},{"text":" ","type":"text"},{"text":"the next launch resumes an incremental fetch from a cursor that no longer matches the","type":"text"},{"text":" ","type":"text"},{"text":"cloud. The server answers truthfully that nothing has changed since that cursor, so","type":"text"},{"text":" ","type":"text"},{"text":"files that predate it are never mentioned again. The device ends up with a silently","type":"text"},{"text":" ","type":"text"},{"text":"partial view of the cloud and no error to report, which is far harder to diagnose than","type":"text"},{"text":" ","type":"text"},{"text":"an outright failure.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Keeping the cache in the event store directory ties the two together: removing the store","type":"text"},{"text":" ","type":"text"},{"text":"removes the cache, so a rebuilt store always starts from a full fetch.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["public func setLocalStoreDirectory(_ path: String?, discardingExistingCache: Bool) {","    localStoreDirectory = path","    inMemoryCache = nil          \/\/ never carry state across stores","    guard path != nil else { return }","","    if discardingExistingCache {","        deleteCacheFromDisk()    \/\/ the store is being rebuilt: start clean","        return","    }","    loadCacheFromDisk()","}"],"syntax":"swift"},{"inlineContent":[{"text":"Three details matter. The method is called before priming whenever an ensemble knows its","type":"text"},{"text":" ","type":"text"},{"text":"store, and it is ","type":"text"},{"inlineContent":[{"text":"not","type":"text"}],"type":"emphasis"},{"text":" called for ensemble-independent operations such as","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/retrieveEnsembleIdentifiers(from:)","isActive":true,"type":"reference"},{"text":" — so tolerate priming without a","type":"text"},{"text":" ","type":"text"},{"text":"directory by simply not caching. When ","type":"text"},{"code":"discardingExistingCache","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" the store is","type":"text"},{"text":" ","type":"text"},{"text":"being rebuilt, so delete any cache you find rather than loading it; do the deletion","type":"text"},{"text":" ","type":"text"},{"text":"yourself rather than assuming the directory is empty. And never recreate the directory in","type":"text"},{"text":" ","type":"text"},{"text":"order to write the cache: if it is gone, the store is gone, and the cache must go with","type":"text"},{"text":" ","type":"text"},{"text":"it.","type":"text"}],"type":"paragraph"},{"text":"Threading and Sendable","type":"heading","level":2,"anchor":"Threading-and-Sendable"},{"inlineContent":[{"text":"Cloud file systems must conform to ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":". If your implementation uses mutable state, you have several options:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"actor"},{"text":" isolation (as ","type":"text"},{"type":"codeVoice","code":"MemoryCloudFileSystem"},{"text":" does)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"@unchecked Sendable"},{"text":" with explicit locking (as ","type":"text"},{"type":"codeVoice","code":"LocalCloudFileSystem"},{"text":" does)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Make the type stateless, delegating state to a thread-safe service","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"All protocol methods are ","type":"text"},{"code":"async throws","type":"codeVoice"},{"text":", so you can freely call async APIs in your implementation.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Ensembles\/documentation\/Ensembles\/CustomCloudBackends"},"references":{"doc://Ensembles/documentation/Ensembles/CloudFileSystem":{"title":"CloudFileSystem","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem","url":"\/documentation\/ensembles\/cloudfilesystem","abstract":[{"text":"A cloud file system facilitates data transfer between devices.","type":"text"}],"type":"topic","navigatorTitle":[{"text":"CloudFileSystem","kind":"identifier"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CloudFileSystem","kind":"identifier"}],"kind":"symbol","role":"symbol"},"doc://Ensembles/documentation/Ensembles/CloudFileSystem/fetchUserIdentity()":{"required":true,"role":"symbol","abstract":[{"type":"text","text":"Fetches a token representing the current user of the cloud file system."},{"text":" ","type":"text"},{"text":"Often this will be the user or login name.","type":"text"}],"url":"\/documentation\/ensembles\/cloudfilesystem\/fetchuseridentity()","title":"fetchUserIdentity()","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"fetchUserIdentity"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> sending (any "},{"kind":"typeIdentifier","preciseIdentifier":"c:objc(pl)NSCoding","text":"NSCoding"},{"kind":"text","text":" & "},{"text":"NSCopying","preciseIdentifier":"c:objc(pl)NSCopying","kind":"typeIdentifier"},{"text":" & ","kind":"text"},{"text":"NSObjectProtocol","preciseIdentifier":"c:objc(pl)NSObject","kind":"typeIdentifier"},{"text":")?","kind":"text"}],"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/fetchUserIdentity()","kind":"symbol"},"doc://Ensembles/documentation/Ensembles/CoreDataEnsemble/retrieveEnsembleIdentifiers(from:)":{"role":"symbol","abstract":[{"text":"Queries a cloud file system for the identifiers of the ensembles it contains.","type":"text"}],"url":"\/documentation\/ensembles\/coredataensemble\/retrieveensembleidentifiers(from:)","type":"topic","title":"retrieveEnsembleIdentifiers(from:)","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"retrieveEnsembleIdentifiers","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": any ","kind":"text"},{"text":"CloudFileSystem","preciseIdentifier":"s:9Ensembles15CloudFileSystemP","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> [","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/retrieveEnsembleIdentifiers(from:)","kind":"symbol"},"doc://Ensembles/documentation/Ensembles":{"abstract":[{"type":"text","text":"Sync Core Data and SwiftData stores across devices using event sourcing."}],"type":"topic","role":"collection","url":"\/documentation\/ensembles","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles","kind":"symbol","title":"Ensembles"},"doc://Ensembles/documentation/Ensembles/CloudDirectory":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CloudDirectory","kind":"identifier"}],"abstract":[{"text":"Represents a directory in a cloud file system.","type":"text"}],"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudDirectory","title":"CloudDirectory","type":"topic","role":"symbol","navigatorTitle":[{"text":"CloudDirectory","kind":"identifier"}],"url":"\/documentation\/ensembles\/clouddirectory","kind":"symbol"},"doc://Ensembles/documentation/Ensembles/CloudFileSystem/isConnected":{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/isConnected","role":"symbol","url":"\/documentation\/ensembles\/cloudfilesystem\/isconnected","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isConnected","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"title":"isConnected","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Whether the file system is connected and ready for file transactions."}],"required":true},"doc://Ensembles/documentation/Ensembles/CloudFileSystemSetup/setLocalStoreDirectory(_:discardingExistingCache:)":{"abstract":[{"type":"text","text":"Tells the file system which local directory belongs to the event store it is serving."}],"title":"setLocalStoreDirectory(_:discardingExistingCache:)","required":true,"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"setLocalStoreDirectory","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"kind":"externalParam","text":"discardingExistingCache"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":")","kind":"text"}],"url":"\/documentation\/ensembles\/cloudfilesystemsetup\/setlocalstoredirectory(_:discardingexistingcache:)","defaultImplementations":1,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup\/setLocalStoreDirectory(_:discardingExistingCache:)","kind":"symbol","type":"topic"},"doc://Ensembles/documentation/Ensembles/CloudFileSystemSetup":{"title":"CloudFileSystemSetup","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup","url":"\/documentation\/ensembles\/cloudfilesystemsetup","abstract":[{"type":"text","text":"Optional setup and maintenance operations for cloud file systems."}],"type":"topic","navigatorTitle":[{"text":"CloudFileSystemSetup","kind":"identifier"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CloudFileSystemSetup","kind":"identifier"}],"kind":"symbol","role":"symbol"},"doc://Ensembles/documentation/Ensembles/CloudFileSystem/connect()":{"type":"topic","kind":"symbol","title":"connect()","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"connect"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"}],"url":"\/documentation\/ensembles\/cloudfilesystem\/connect()","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/connect()","required":true,"abstract":[{"type":"text","text":"Attempts to connect to the cloud backend."}]},"doc://Ensembles/documentation/Ensembles/CloudFileSystemBatchOperations":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"CloudFileSystemBatchOperations"}],"abstract":[{"type":"text","text":"Optional batch and setup operations for cloud file systems."}],"type":"topic","role":"symbol","url":"\/documentation\/ensembles\/cloudfilesystembatchoperations","navigatorTitle":[{"kind":"identifier","text":"CloudFileSystemBatchOperations"}],"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemBatchOperations","kind":"symbol","title":"CloudFileSystemBatchOperations"},"doc://Ensembles/documentation/Ensembles/CloudFile":{"title":"CloudFile","abstract":[{"text":"Represents a file in a cloud file system.","type":"text"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CloudFile","kind":"identifier"}],"url":"\/documentation\/ensembles\/cloudfile","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFile","kind":"symbol","type":"topic","navigatorTitle":[{"text":"CloudFile","kind":"identifier"}]}}}