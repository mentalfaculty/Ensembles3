{"kind":"article","schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Ensembles exchanges sync data through a "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem","isActive":true},{"type":"text","text":" — a protocol that abstracts file storage behind a simple path-based API. Any service that can store and retrieve files at paths can serve as a backend: cloud storage (S3, Google Cloud Storage), file servers (WebDAV, SFTP), databases, or even peer-to-peer connections with a local cache."}],"type":"paragraph"},{"text":"The CloudFileSystem Protocol","anchor":"The-CloudFileSystem-Protocol","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The core protocol has 8 requirements organized into four groups:"}],"type":"paragraph"},{"text":"Connection","anchor":"Connection","level":3,"type":"heading"},{"code":["public protocol CloudFileSystem: AnyObject, Sendable {","    var isConnected: Bool { get }","    func connect() async throws","    func fetchUserIdentity() async throws","        -> sending (any NSObjectProtocol & NSCoding & NSCopying)?","}"],"syntax":"swift","type":"codeListing"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/isConnected","isActive":true},{"type":"text","text":" — Return whether the backend is ready for operations."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/connect()"},{"type":"text","text":" — Establish a connection. Called before each attach or merge."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/fetchUserIdentity()"},{"text":" — Return a token identifying the current user, or ","type":"text"},{"code":"nil","type":"codeVoice"},{"type":"text","text":" if identity tracking is not supported. Ensembles uses this to detect account changes (e.g., signing out of iCloud)."}]}]}],"type":"unorderedList"},{"type":"heading","text":"File Operations","anchor":"File-Operations","level":3},{"type":"codeListing","code":["func fileExists(atPath path: String) async throws -> FileExistence","func createDirectory(atPath path: String) async throws","func contentsOfDirectory(atPath path: String) async throws -> [any CloudItem]","func removeItem(atPath path: String) async throws"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Paths are forward-slash separated, rooted at "},{"type":"codeVoice","code":"\/"},{"type":"text","text":". The ensemble creates a directory structure like "},{"type":"codeVoice","code":"\/MyEnsemble\/events\/"},{"type":"text","text":", "},{"type":"codeVoice","code":"\/MyEnsemble\/baselines\/"},{"type":"text","text":", etc."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Directory listings should return "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFile"},{"type":"text","text":" or "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudDirectory"},{"type":"text","text":" items with their "},{"type":"codeVoice","code":"path"},{"type":"text","text":" and "},{"type":"codeVoice","code":"name"},{"type":"text","text":" populated. Only list immediate children — do not recurse."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"There is one optional existence check, "},{"code":"confirmFileExists(atPath:)","type":"codeVoice"},{"type":"text","text":", with a default implementation that calls "},{"code":"fileExists(atPath:)","type":"codeVoice"},{"text":". The framework uses it for checks whose consequences are drastic, such as the per-sync store-registration check that detects a reset cloud. If your backend answers ","type":"text"},{"code":"fileExists","type":"codeVoice"},{"text":" from a local cache of remote state, implement ","type":"text"},{"code":"confirmFileExists","type":"codeVoice"},{"text":" to consult the server directly; if ","type":"text"},{"code":"fileExists","type":"codeVoice"},{"text":" is already authoritative, the default is correct. Wrapper backends that delegate to another file system must forward ","type":"text"},{"code":"confirmFileExists","type":"codeVoice"},{"text":" to the wrapped backend’s ","type":"text"},{"code":"confirmFileExists","type":"codeVoice"},{"text":" — the default cannot see through a wrapper, and would quietly downgrade the confirmation to the wrapped backend’s cached check.","type":"text"}]},{"level":3,"type":"heading","anchor":"File-Transfer","text":"File Transfer"},{"type":"codeListing","syntax":"swift","code":["func uploadLocalFile(atPath localPath: String, toPath remotePath: String) async throws","func downloadFile(atPath remotePath: String, toLocalFile localPath: String) async throws"]},{"type":"paragraph","inlineContent":[{"text":"Upload copies a local file to the remote path. Download copies a remote file to the local path. Both paths are absolute on their respective systems (local paths are filesystem paths; remote paths are within the cloud file system’s namespace).","type":"text"}]},{"level":2,"type":"heading","anchor":"A-Minimal-Example","text":"A Minimal Example"},{"type":"paragraph","inlineContent":[{"text":"Here is a skeleton implementation to illustrate the structure:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import Ensembles","","public final class MyCloudFileSystem: CloudFileSystem, @unchecked Sendable {","","    public var isConnected: Bool { true }","","    public func connect() async throws {","        \/\/ Authenticate or establish a session","    }","","    public func fetchUserIdentity() async throws","        -> sending (any NSObjectProtocol & NSCoding & NSCopying)? {","        \/\/ Return a user token, or nil","        return nil","    }","","    public func fileExists(atPath path: String) async throws -> FileExistence {","        \/\/ Check your storage and return the result","    }","","    public func createDirectory(atPath path: String) async throws {","        \/\/ Create a directory marker or equivalent","    }","","    public func contentsOfDirectory(atPath path: String) async throws","        -> [any CloudItem] {","        \/\/ List immediate children as CloudFile\/CloudDirectory items","    }","","    public func removeItem(atPath path: String) async throws {","        \/\/ Delete a file or directory (and its contents)","    }","","    public func uploadLocalFile(","        atPath localPath: String,","        toPath remotePath: String","    ) async throws {","        let data = try Data(contentsOf: URL(fileURLWithPath: localPath))","        \/\/ Store data at remotePath in your backend","    }","","    public func downloadFile(","        atPath remotePath: String,","        toLocalFile localPath: String","    ) async throws {","        \/\/ Retrieve data from remotePath in your backend","        let data: Data = \/\/ ...fetch from backend","        try data.write(to: URL(fileURLWithPath: localPath), options: .atomic)","    }","}"]},{"level":2,"type":"heading","anchor":"Reference-Implementations","text":"Reference Implementations"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Study the built-in backends as starting points:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"MemoryCloudFileSystem"}]},{"type":"text","text":" (in "},{"type":"codeVoice","code":"EnsemblesMemory"},{"type":"text","text":") — The simplest implementation. An actor that stores files in a dictionary. Good for understanding the protocol’s expectations."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"LocalCloudFileSystem"}],"type":"strong"},{"type":"text","text":" (in "},{"code":"EnsemblesLocalFile","type":"codeVoice"},{"type":"text","text":") — Uses "},{"code":"FileManager","type":"codeVoice"},{"type":"text","text":" to store files in a local directory. Shows how to map the protocol onto a real file system."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":"CloudKitFileSystem","type":"codeVoice"}],"type":"strong"},{"text":" (in ","type":"text"},{"code":"EnsemblesCloudKit","type":"codeVoice"},{"text":") — A production backend using CloudKit. Shows how to implement batch operations and setup hooks.","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"PCloudCloudFileSystem"}],"type":"strong"},{"type":"text","text":" (in "},{"type":"codeVoice","code":"EnsemblesPCloud"},{"type":"text","text":") — A URLSession-based REST client with no SDK dependency. A good model for building backends against any REST API."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"BoxCloudFileSystem"}],"type":"strong"},{"text":" (in ","type":"text"},{"code":"EnsemblesBox","type":"codeVoice"},{"text":") — Wraps the Box Swift SDK. Demonstrates how to bridge an ID-based API (where files are identified by numeric IDs, not paths) onto the path-based ","type":"text"},{"code":"CloudFileSystem","type":"codeVoice"},{"text":" protocol using folder-walking and caching.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"S3CloudFileSystem","type":"codeVoice"}]},{"type":"text","text":" (in "},{"code":"EnsemblesS3","type":"codeVoice"},{"type":"text","text":") — Wraps the AWS SDK for Swift. Shows how to simulate directory semantics on a flat key-value store using key prefixes and delimiters."}]}]}],"type":"unorderedList"},{"style":"note","name":"Note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"EnsemblesBox","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"EnsemblesS3","type":"codeVoice"},{"text":" (along with ","type":"text"},{"code":"EnsemblesDropbox","type":"codeVoice"},{"text":", ","type":"text"},{"code":"EnsemblesZip","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"EnsemblesMultipeer","type":"codeVoice"},{"text":") require an external SDK. With the source distribution, enabling the corresponding package trait resolves this automatically. With the binary distribution (XCFrameworks), you must add the external SDK as a separate package dependency — see the Available Backends table in the README for details.","type":"text"}]}]},{"text":"Optional: Batch Operations","anchor":"Optional-Batch-Operations","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"If your backend can handle multiple files in a single request (reducing round trips), adopt ","type":"text"},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemBatchOperations","isActive":true,"type":"reference"},{"text":":","type":"text"}]},{"code":["extension MyCloudFileSystem: CloudFileSystemBatchOperations {","    public var fileUploadMaximumBatchSize: Int { 20 }","    public var fileDownloadMaximumBatchSize: Int { 20 }","","    public func uploadLocalFiles(","        atPaths localPaths: [String],","        toPaths remotePaths: [String]","    ) async throws {","        \/\/ Upload multiple files in one request","    }","","    public func downloadFiles(","        atPaths remotePaths: [String],","        toLocalFiles localPaths: [String]","    ) async throws {","        \/\/ Download multiple files in one request","    }","","    public func removeItems(atPaths paths: [String]) async throws {","        \/\/ Delete multiple items in one request","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"fileUploadMaximumBatchSize","type":"codeVoice"},{"type":"text","text":" and "},{"code":"fileDownloadMaximumBatchSize","type":"codeVoice"},{"type":"text","text":" properties control how many files Ensembles passes per batch call. Default is 10 if you don’t override them."}]},{"text":"Optional: Setup Hooks","anchor":"Optional-Setup-Hooks","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"For backends that need initialization, caching, or repair logic, adopt "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup","type":"reference","isActive":true},{"type":"text","text":":"}]},{"code":["extension MyCloudFileSystem: CloudFileSystemSetup {","    public func performInitialPreparation() async throws {","        \/\/ One-time setup (e.g., create root directories)","    }","","    public func primeForActivity() async throws {","        \/\/ Called before each operation (e.g., refresh auth tokens,","        \/\/ cache directory listings)","    }","","    public func directoryExists(atPath path: String) async throws -> Bool {","        \/\/ Check directory existence","    }","","    public func repairEnsembleDirectory(atPath path: String) async throws {","        \/\/ Fix up issues like iCloud duplicates or stale locks","    }","","    public func setLocalStoreDirectory(_ path: String?, discardingExistingCache: Bool) {","        \/\/ Where to keep any cache of remote state (see below).","        \/\/ Has a default no-op implementation; only implement it if you cache.","    }","}"],"type":"codeListing","syntax":"swift"},{"text":"Caching Remote State","anchor":"Caching-Remote-State","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Backends that fetch changes incrementally — keeping a cursor, change token, or cached"},{"type":"text","text":" "},{"type":"text","text":"listing between launches — must store that state "},{"type":"strong","inlineContent":[{"type":"text","text":"inside the event store’s directory"}]},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"supplied by ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup\/setLocalStoreDirectory(_:discardingExistingCache:)"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The reason is lifetime. A cache describes one particular event store at one point in its"},{"type":"text","text":" "},{"type":"text","text":"history. Put it anywhere with an independent lifetime — the system caches directory is"},{"type":"text","text":" "},{"type":"text","text":"the tempting choice — and it can outlive the store it describes. Deleting the app,"},{"type":"text","text":" "},{"type":"text","text":"removing the local store, or resetting the cloud data then leaves the cache behind, and"},{"type":"text","text":" "},{"type":"text","text":"the next launch resumes an incremental fetch from a cursor that no longer matches the"},{"type":"text","text":" "},{"type":"text","text":"cloud. The server answers truthfully that nothing has changed since that cursor, so"},{"type":"text","text":" "},{"type":"text","text":"files that predate it are never mentioned again. The device ends up with a silently"},{"type":"text","text":" "},{"type":"text","text":"partial view of the cloud and no error to report, which is far harder to diagnose than"},{"type":"text","text":" "},{"type":"text","text":"an outright failure."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Keeping the cache in the event store directory ties the two together: removing the store"},{"type":"text","text":" "},{"type":"text","text":"removes the cache, so a rebuilt store always starts from a full fetch."}]},{"code":["public func setLocalStoreDirectory(_ path: String?, discardingExistingCache: Bool) {","    localStoreDirectory = path","    inMemoryCache = nil          \/\/ never carry state across stores","    guard path != nil else { return }","","    if discardingExistingCache {","        deleteCacheFromDisk()    \/\/ the store is being rebuilt: start clean","        return","    }","    loadCacheFromDisk()","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Three details matter. The method is called before priming whenever an ensemble knows its"},{"type":"text","text":" "},{"type":"text","text":"store, and it is "},{"type":"emphasis","inlineContent":[{"type":"text","text":"not"}]},{"text":" called for ensemble-independent operations such as","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/retrieveEnsembleIdentifiers(from:)","type":"reference","isActive":true},{"text":" — so tolerate priming without a","type":"text"},{"text":" ","type":"text"},{"text":"directory by simply not caching. When ","type":"text"},{"code":"discardingExistingCache","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" the store is","type":"text"},{"text":" ","type":"text"},{"text":"being rebuilt, so delete any cache you find rather than loading it; do the deletion","type":"text"},{"text":" ","type":"text"},{"text":"yourself rather than assuming the directory is empty. And never recreate the directory in","type":"text"},{"text":" ","type":"text"},{"text":"order to write the cache: if it is gone, the store is gone, and the cache must go with","type":"text"},{"text":" ","type":"text"},{"text":"it.","type":"text"}]},{"level":2,"anchor":"Threading-and-Sendable","text":"Threading and Sendable","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Cloud file systems must conform to ","type":"text"},{"type":"codeVoice","code":"Sendable"},{"text":". If your implementation uses mutable state, you have several options:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"actor"},{"text":" isolation (as ","type":"text"},{"type":"codeVoice","code":"MemoryCloudFileSystem"},{"text":" does)","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Use "},{"code":"@unchecked Sendable","type":"codeVoice"},{"type":"text","text":" with explicit locking (as "},{"code":"LocalCloudFileSystem","type":"codeVoice"},{"text":" does)","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Make the type stateless, delegating state to a thread-safe service","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"All protocol methods are ","type":"text"},{"code":"async throws","type":"codeVoice"},{"text":", so you can freely call async APIs in your implementation.","type":"text"}]}]}],"sections":[],"identifier":{"url":"doc:\/\/Ensembles\/documentation\/Ensembles\/CustomCloudBackends","interfaceLanguage":"swift"},"seeAlsoSections":[{"generated":true,"anchor":"Cloud-Backends","identifiers":["doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem","doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemBatchOperations","doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup"],"title":"Cloud Backends"}],"metadata":{"modules":[{"name":"Ensembles"}],"role":"article","roleHeading":"Article","title":"Custom Cloud Backends"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ensembles\/customcloudbackends"]}],"hierarchy":{"paths":[["doc:\/\/Ensembles\/documentation\/Ensembles"]]},"abstract":[{"text":"Implement the CloudFileSystem protocol to sync via any storage service.","type":"text"}],"references":{"doc://Ensembles/documentation/Ensembles/CloudFileSystemBatchOperations":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"CloudFileSystemBatchOperations"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"CloudFileSystemBatchOperations"}],"title":"CloudFileSystemBatchOperations","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemBatchOperations","abstract":[{"text":"Optional batch and setup operations for cloud file systems.","type":"text"}],"type":"topic","url":"\/documentation\/ensembles\/cloudfilesystembatchoperations","kind":"symbol"},"doc://Ensembles/documentation/Ensembles/CloudFileSystem/connect()":{"url":"\/documentation\/ensembles\/cloudfilesystem\/connect()","type":"topic","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/connect()","abstract":[{"type":"text","text":"Attempts to connect to the cloud backend."}],"required":true,"role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"connect"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"}],"title":"connect()"},"doc://Ensembles/documentation/Ensembles/CloudFileSystemSetup":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CloudFileSystemSetup","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"CloudFileSystemSetup","kind":"identifier"}],"title":"CloudFileSystemSetup","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup","abstract":[{"text":"Optional setup and maintenance operations for cloud file systems.","type":"text"}],"url":"\/documentation\/ensembles\/cloudfilesystemsetup","type":"topic","kind":"symbol"},"doc://Ensembles/documentation/Ensembles/CloudFileSystem/isConnected":{"title":"isConnected","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isConnected","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"type":"topic","kind":"symbol","role":"symbol","url":"\/documentation\/ensembles\/cloudfilesystem\/isconnected","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/isConnected","required":true,"abstract":[{"text":"Whether the file system is connected and ready for file transactions.","type":"text"}]},"doc://Ensembles/documentation/Ensembles/CloudFile":{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFile","abstract":[{"type":"text","text":"Represents a file in a cloud file system."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CloudFile","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/ensembles\/cloudfile","navigatorTitle":[{"text":"CloudFile","kind":"identifier"}],"title":"CloudFile","type":"topic","role":"symbol"},"doc://Ensembles/documentation/Ensembles/CloudFileSystem/fetchUserIdentity()":{"type":"topic","url":"\/documentation\/ensembles\/cloudfilesystem\/fetchuseridentity()","required":true,"abstract":[{"text":"Fetches a token representing the current user of the cloud file system.","type":"text"},{"text":" ","type":"text"},{"text":"Often this will be the user or login name.","type":"text"}],"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"fetchUserIdentity","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> sending (any ","kind":"text"},{"text":"NSCoding","preciseIdentifier":"c:objc(pl)NSCoding","kind":"typeIdentifier"},{"text":" & ","kind":"text"},{"text":"NSCopying","preciseIdentifier":"c:objc(pl)NSCopying","kind":"typeIdentifier"},{"text":" & ","kind":"text"},{"text":"NSObjectProtocol","preciseIdentifier":"c:objc(pl)NSObject","kind":"typeIdentifier"},{"text":")?","kind":"text"}],"title":"fetchUserIdentity()","kind":"symbol","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/fetchUserIdentity()"},"doc://Ensembles/documentation/Ensembles":{"kind":"symbol","url":"\/documentation\/ensembles","type":"topic","title":"Ensembles","role":"collection","abstract":[{"type":"text","text":"Sync Core Data and SwiftData stores across devices using event sourcing."}],"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles"},"doc://Ensembles/documentation/Ensembles/CloudFileSystemSetup/setLocalStoreDirectory(_:discardingExistingCache:)":{"title":"setLocalStoreDirectory(_:discardingExistingCache:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"setLocalStoreDirectory","kind":"identifier"},{"kind":"text","text":"("},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"discardingExistingCache"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":")"}],"kind":"symbol","type":"topic","role":"symbol","url":"\/documentation\/ensembles\/cloudfilesystemsetup\/setlocalstoredirectory(_:discardingexistingcache:)","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup\/setLocalStoreDirectory(_:discardingExistingCache:)","defaultImplementations":1,"required":true,"abstract":[{"text":"Tells the file system which local directory belongs to the event store it is serving.","type":"text"}]},"doc://Ensembles/documentation/Ensembles/CoreDataEnsemble/retrieveEnsembleIdentifiers(from:)":{"role":"symbol","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/retrieveEnsembleIdentifiers(from:)","abstract":[{"type":"text","text":"Queries a cloud file system for the identifiers of the ensembles it contains."}],"url":"\/documentation\/ensembles\/coredataensemble\/retrieveensembleidentifiers(from:)","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"kind":"identifier","text":"retrieveEnsembleIdentifiers"},{"kind":"text","text":"("},{"text":"from","kind":"externalParam"},{"text":": any ","kind":"text"},{"text":"CloudFileSystem","preciseIdentifier":"s:9Ensembles15CloudFileSystemP","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> [","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"type":"topic","kind":"symbol","title":"retrieveEnsembleIdentifiers(from:)"},"doc://Ensembles/documentation/Ensembles/CloudFileSystem":{"navigatorTitle":[{"kind":"identifier","text":"CloudFileSystem"}],"type":"topic","url":"\/documentation\/ensembles\/cloudfilesystem","role":"symbol","abstract":[{"text":"A cloud file system facilitates data transfer between devices.","type":"text"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"CloudFileSystem"}],"title":"CloudFileSystem","kind":"symbol","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem"},"doc://Ensembles/documentation/Ensembles/CloudDirectory":{"role":"symbol","abstract":[{"text":"Represents a directory in a cloud file system.","type":"text"}],"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudDirectory","url":"\/documentation\/ensembles\/clouddirectory","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CloudDirectory","kind":"identifier"}],"type":"topic","kind":"symbol","title":"CloudDirectory","navigatorTitle":[{"text":"CloudDirectory","kind":"identifier"}]}}}