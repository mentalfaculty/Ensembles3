{"abstract":[{"type":"text","text":"Implement the CloudFileSystem protocol to sync via any storage service."}],"seeAlsoSections":[{"identifiers":["doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem","doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemBatchOperations","doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup"],"anchor":"Cloud-Backends","generated":true,"title":"Cloud Backends"}],"metadata":{"role":"article","title":"Custom Cloud Backends","roleHeading":"Article","modules":[{"name":"Ensembles"}]},"sections":[],"hierarchy":{"paths":[["doc:\/\/Ensembles\/documentation\/Ensembles"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Ensembles\/documentation\/Ensembles\/CustomCloudBackends"},"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Ensembles exchanges sync data through a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem"},{"type":"text","text":" — a protocol that abstracts file storage behind a simple path-based API. Any service that can store and retrieve files at paths can serve as a backend: cloud storage (S3, Google Cloud Storage), file servers (WebDAV, SFTP), databases, or even peer-to-peer connections with a local cache."}],"type":"paragraph"},{"text":"The CloudFileSystem Protocol","anchor":"The-CloudFileSystem-Protocol","type":"heading","level":2},{"inlineContent":[{"text":"The core protocol has 8 requirements organized into four groups:","type":"text"}],"type":"paragraph"},{"text":"Connection","anchor":"Connection","type":"heading","level":3},{"type":"codeListing","syntax":"swift","code":["public protocol CloudFileSystem: AnyObject, Sendable {","    var isConnected: Bool { get }","    func connect() async throws","    func fetchUserIdentity() async throws","        -> sending (any NSObjectProtocol & NSCoding & NSCopying)?","}"]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/isConnected","isActive":true},{"type":"text","text":" — Return whether the backend is ready for operations."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/connect()","type":"reference","isActive":true},{"text":" — Establish a connection. Called before each attach or merge.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/fetchUserIdentity()","isActive":true},{"type":"text","text":" — Return a token identifying the current user, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" if identity tracking is not supported. Ensembles uses this to detect account changes (e.g., signing out of iCloud)."}]}]}]},{"text":"File Operations","anchor":"File-Operations","type":"heading","level":3},{"type":"codeListing","syntax":"swift","code":["func fileExists(atPath path: String) async throws -> FileExistence","func createDirectory(atPath path: String) async throws","func contentsOfDirectory(atPath path: String) async throws -> [any CloudItem]","func removeItem(atPath path: String) async throws"]},{"inlineContent":[{"text":"Paths are forward-slash separated, rooted at ","type":"text"},{"code":"\/","type":"codeVoice"},{"text":". The ensemble creates a directory structure like ","type":"text"},{"code":"\/MyEnsemble\/events\/","type":"codeVoice"},{"text":", ","type":"text"},{"code":"\/MyEnsemble\/baselines\/","type":"codeVoice"},{"text":", etc.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Directory listings should return ","type":"text"},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFile","isActive":true},{"text":" or ","type":"text"},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudDirectory","isActive":true},{"text":" items with their ","type":"text"},{"code":"path","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"name","type":"codeVoice"},{"text":" populated. Only list immediate children — do not recurse.","type":"text"}],"type":"paragraph"},{"text":"File Transfer","type":"heading","level":3,"anchor":"File-Transfer"},{"syntax":"swift","type":"codeListing","code":["func uploadLocalFile(atPath localPath: String, toPath remotePath: String) async throws","func downloadFile(atPath remotePath: String, toLocalFile localPath: String) async throws"]},{"inlineContent":[{"type":"text","text":"Upload copies a local file to the remote path. Download copies a remote file to the local path. Both paths are absolute on their respective systems (local paths are filesystem paths; remote paths are within the cloud file system’s namespace)."}],"type":"paragraph"},{"text":"A Minimal Example","type":"heading","level":2,"anchor":"A-Minimal-Example"},{"inlineContent":[{"type":"text","text":"Here is a skeleton implementation to illustrate the structure:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import Ensembles","","public final class MyCloudFileSystem: CloudFileSystem, @unchecked Sendable {","","    public var isConnected: Bool { true }","","    public func connect() async throws {","        \/\/ Authenticate or establish a session","    }","","    public func fetchUserIdentity() async throws","        -> sending (any NSObjectProtocol & NSCoding & NSCopying)? {","        \/\/ Return a user token, or nil","        return nil","    }","","    public func fileExists(atPath path: String) async throws -> FileExistence {","        \/\/ Check your storage and return the result","    }","","    public func createDirectory(atPath path: String) async throws {","        \/\/ Create a directory marker or equivalent","    }","","    public func contentsOfDirectory(atPath path: String) async throws","        -> [any CloudItem] {","        \/\/ List immediate children as CloudFile\/CloudDirectory items","    }","","    public func removeItem(atPath path: String) async throws {","        \/\/ Delete a file or directory (and its contents)","    }","","    public func uploadLocalFile(","        atPath localPath: String,","        toPath remotePath: String","    ) async throws {","        let data = try Data(contentsOf: URL(fileURLWithPath: localPath))","        \/\/ Store data at remotePath in your backend","    }","","    public func downloadFile(","        atPath remotePath: String,","        toLocalFile localPath: String","    ) async throws {","        \/\/ Retrieve data from remotePath in your backend","        let data: Data = \/\/ ...fetch from backend","        try data.write(to: URL(fileURLWithPath: localPath), options: .atomic)","    }","}"]},{"text":"Reference Implementations","type":"heading","level":2,"anchor":"Reference-Implementations"},{"inlineContent":[{"text":"Study the built-in backends as starting points:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":"MemoryCloudFileSystem","type":"codeVoice"}],"type":"strong"},{"text":" (in ","type":"text"},{"code":"EnsemblesMemory","type":"codeVoice"},{"text":") — The simplest implementation. An actor that stores files in a dictionary. Good for understanding the protocol’s expectations.","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"LocalCloudFileSystem"}],"type":"strong"},{"type":"text","text":" (in "},{"type":"codeVoice","code":"EnsemblesLocalFile"},{"type":"text","text":") — Uses "},{"type":"codeVoice","code":"FileManager"},{"type":"text","text":" to store files in a local directory. Shows how to map the protocol onto a real file system."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"CloudKitFileSystem","type":"codeVoice"}]},{"type":"text","text":" (in "},{"type":"codeVoice","code":"EnsemblesCloudKit"},{"type":"text","text":") — A production backend using CloudKit. Shows how to implement batch operations and setup hooks."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"PCloudCloudFileSystem","type":"codeVoice"}]},{"type":"text","text":" (in "},{"type":"codeVoice","code":"EnsemblesPCloud"},{"type":"text","text":") — A URLSession-based REST client with no SDK dependency. A good model for building backends against any REST API."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"BoxCloudFileSystem"}]},{"type":"text","text":" (in "},{"type":"codeVoice","code":"EnsemblesBox"},{"type":"text","text":") — Wraps the Box Swift SDK. Demonstrates how to bridge an ID-based API (where files are identified by numeric IDs, not paths) onto the path-based "},{"type":"codeVoice","code":"CloudFileSystem"},{"type":"text","text":" protocol using folder-walking and caching."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":"S3CloudFileSystem","type":"codeVoice"}]},{"text":" (in ","type":"text"},{"code":"EnsemblesS3","type":"codeVoice"},{"text":") — Wraps the AWS SDK for Swift. Shows how to simulate directory semantics on a flat key-value store using key prefixes and delimiters.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"EnsemblesBox"},{"type":"text","text":" and "},{"type":"codeVoice","code":"EnsemblesS3"},{"type":"text","text":" (along with "},{"type":"codeVoice","code":"EnsemblesDropbox"},{"type":"text","text":", "},{"type":"codeVoice","code":"EnsemblesZip"},{"type":"text","text":", and "},{"type":"codeVoice","code":"EnsemblesMultipeer"},{"type":"text","text":") require an external SDK. With the source distribution, enabling the corresponding package trait resolves this automatically. With the binary distribution (XCFrameworks), you must add the external SDK as a separate package dependency — see the Available Backends table in the README for details."}]}],"style":"note","name":"Note"},{"level":2,"type":"heading","text":"Optional: Batch Operations","anchor":"Optional-Batch-Operations"},{"inlineContent":[{"type":"text","text":"If your backend can handle multiple files in a single request (reducing round trips), adopt "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemBatchOperations","type":"reference","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["extension MyCloudFileSystem: CloudFileSystemBatchOperations {","    public var fileUploadMaximumBatchSize: Int { 20 }","    public var fileDownloadMaximumBatchSize: Int { 20 }","","    public func uploadLocalFiles(","        atPaths localPaths: [String],","        toPaths remotePaths: [String]","    ) async throws {","        \/\/ Upload multiple files in one request","    }","","    public func downloadFiles(","        atPaths remotePaths: [String],","        toLocalFiles localPaths: [String]","    ) async throws {","        \/\/ Download multiple files in one request","    }","","    public func removeItems(atPaths paths: [String]) async throws {","        \/\/ Delete multiple items in one request","    }","}"]},{"inlineContent":[{"text":"The ","type":"text"},{"code":"fileUploadMaximumBatchSize","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"fileDownloadMaximumBatchSize","type":"codeVoice"},{"text":" properties control how many files Ensembles passes per batch call. Default is 10 if you don’t override them.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"Optional: Setup Hooks","anchor":"Optional-Setup-Hooks"},{"inlineContent":[{"type":"text","text":"For backends that need initialization, caching, or repair logic, adopt "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup","type":"reference","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["extension MyCloudFileSystem: CloudFileSystemSetup {","    public func performInitialPreparation() async throws {","        \/\/ One-time setup (e.g., create root directories)","    }","","    public func primeForActivity() async throws {","        \/\/ Called before each operation (e.g., refresh auth tokens,","        \/\/ cache directory listings)","    }","","    public func directoryExists(atPath path: String) async throws -> Bool {","        \/\/ Check directory existence","    }","","    public func repairEnsembleDirectory(atPath path: String) async throws {","        \/\/ Fix up issues like iCloud duplicates or stale locks","    }","}"],"type":"codeListing"},{"anchor":"Threading-and-Sendable","level":2,"type":"heading","text":"Threading and Sendable"},{"inlineContent":[{"type":"text","text":"Cloud file systems must conform to "},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":". If your implementation uses mutable state, you have several options:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"actor"},{"text":" isolation (as ","type":"text"},{"type":"codeVoice","code":"MemoryCloudFileSystem"},{"text":" does)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"@unchecked Sendable"},{"text":" with explicit locking (as ","type":"text"},{"type":"codeVoice","code":"LocalCloudFileSystem"},{"text":" does)","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Make the type stateless, delegating state to a thread-safe service","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"All protocol methods are "},{"type":"codeVoice","code":"async throws"},{"type":"text","text":", so you can freely call async APIs in your implementation."}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ensembles\/customcloudbackends"]}],"kind":"article","schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://Ensembles/documentation/Ensembles/CloudFile":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CloudFile","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/ensembles\/cloudfile","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFile","navigatorTitle":[{"kind":"identifier","text":"CloudFile"}],"title":"CloudFile","role":"symbol","abstract":[{"text":"Represents a file in a cloud file system.","type":"text"}],"type":"topic"},"doc://Ensembles/documentation/Ensembles/CloudDirectory":{"fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"CloudDirectory"}],"kind":"symbol","url":"\/documentation\/ensembles\/clouddirectory","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudDirectory","navigatorTitle":[{"text":"CloudDirectory","kind":"identifier"}],"title":"CloudDirectory","role":"symbol","abstract":[{"text":"Represents a directory in a cloud file system.","type":"text"}],"type":"topic"},"doc://Ensembles/documentation/Ensembles/CloudFileSystem":{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem","kind":"symbol","role":"symbol","type":"topic","navigatorTitle":[{"text":"CloudFileSystem","kind":"identifier"}],"url":"\/documentation\/ensembles\/cloudfilesystem","title":"CloudFileSystem","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CloudFileSystem","kind":"identifier"}],"abstract":[{"text":"A cloud file system facilitates data transfer between devices.","type":"text"}]},"doc://Ensembles/documentation/Ensembles/CloudFileSystem/isConnected":{"id