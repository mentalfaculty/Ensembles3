atch Operations","level":2,"anchor":"Optional-Batch-Operations"},{"type":"paragraph","inlineContent":[{"text":"If your backend can handle multiple files in a single request (reducing round trips), adopt ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemBatchOperations"},{"text":":","type":"text"}]},{"type":"codeListing","code":["extension MyCloudFileSystem: CloudFileSystemBatchOperations {","    public var fileUploadMaximumBatchSize: Int { 20 }","    public var fileDownloadMaximumBatchSize: Int { 20 }","","    public func uploadLocalFiles(","        atPaths localPaths: [String],","        toPaths remotePaths: [String]","    ) async throws {","        \/\/ Upload multiple files in one request","    }","","    public func downloadFiles(","        atPaths remotePaths: [String],","        toLocalFiles localPaths: [String]","    ) async throws {","        \/\/ Download multiple files in one request","    }","","    public func removeItems(atPaths paths: [String]) async throws {","        \/\/ Delete multiple items in one request","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"fileUploadMaximumBatchSize","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"fileDownloadMaximumBatchSize","type":"codeVoice"},{"text":" properties control how many files Ensembles passes per batch call. Default is 10 if you don’t override them.","type":"text"}]},{"type":"heading","text":"Optional: Setup Hooks","level":2,"anchor":"Optional-Setup-Hooks"},{"type":"paragraph","inlineContent":[{"text":"For backends that need initialization, caching, or repair logic, adopt ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup"},{"text":":","type":"text"}]},{"type":"codeListing","code":["extension MyCloudFileSystem: CloudFileSystemSetup {","    public func performInitialPreparation() async throws {","        \/\/ One-time setup (e.g., create root directories)","    }","","    public func primeForActivity() async throws {","        \/\/ Called before each operation (e.g., refresh auth tokens,","        \/\/ cache directory listings)","    }","","    public func directoryExists(atPath path: String) async throws -> Bool {","        \/\/ Check directory existence","    }","","    public func repairEnsembleDirectory(atPath path: String) async throws {","        \/\/ Fix up issues like iCloud duplicates or stale locks","    }","}"],"syntax":"swift"},{"type":"heading","text":"Threading and Sendable","level":2,"anchor":"Threading-and-Sendable"},{"type":"paragraph","inlineContent":[{"text":"Cloud file systems must conform to ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":". If your implementation uses mutable state, you have several options:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"actor"},{"type":"text","text":" isolation (as "},{"type":"codeVoice","code":"MemoryCloudFileSystem"},{"type":"text","text":" does)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"@unchecked Sendable"},{"type":"text","text":" with explicit locking (as "},{"type":"codeVoice","code":"LocalCloudFileSystem"},{"type":"text","text":" does)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Make the type stateless, delegating state to a thread-safe service"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"All protocol methods are ","type":"text"},{"code":"async throws","type":"codeVoice"},{"text":", so you can freely call async APIs in your implementation.","type":"text"}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Ensembles\/documentation\/Ensembles"]]},"sections":[],"metadata":{"roleHeading":"Article","modules":[{"name":"Ensembles"}],"title":"Cu