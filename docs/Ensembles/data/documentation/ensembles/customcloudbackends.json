{"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"modules":[{"name":"Ensembles"}],"roleHeading":"Article","role":"article","title":"Custom Cloud Backends"},"identifier":{"url":"doc:\/\/Ensembles\/documentation\/Ensembles\/CustomCloudBackends","interfaceLanguage":"swift"},"sections":[],"hierarchy":{"paths":[["doc:\/\/Ensembles\/documentation\/Ensembles"]]},"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ensembles\/customcloudbackends"]}],"seeAlsoSections":[{"generated":true,"title":"Cloud Backends","identifiers":["doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem","doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemBatchOperations","doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup"],"anchor":"Cloud-Backends"}],"abstract":[{"type":"text","text":"Implement the CloudFileSystem protocol to sync via any storage service."}],"primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Ensembles exchanges sync data through a "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem","isActive":true},{"type":"text","text":" — a protocol that abstracts file storage behind a simple path-based API. Any service that can store and retrieve files at paths can serve as a backend: cloud storage (S3, Google Cloud Storage), file servers (WebDAV, SFTP), databases, or even peer-to-peer connections with a local cache."}],"type":"paragraph"},{"level":2,"text":"The CloudFileSystem Protocol","anchor":"The-CloudFileSystem-Protocol","type":"heading"},{"inlineContent":[{"type":"text","text":"The core protocol has 8 requirements organized into four groups:"}],"type":"paragraph"},{"type":"heading","anchor":"Connection","level":3,"text":"Connection"},{"type":"codeListing","code":["public protocol CloudFileSystem: AnyObject, Sendable {","    var isConnected: Bool { get }","    func connect() async throws","    func fetchUserIdentity() async throws","        -> sending (any NSObjectProtocol & NSCoding & NSCopying)?","}"],"syntax":"swift"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/isConnected"},{"type":"text","text":" — Return whether the backend is ready for operations."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/connect()","isActive":true,"type":"reference"},{"type":"text","text":" — Establish a connection. Called before each attach or merge."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/fetchUserIdentity()"},{"text":" — Return a token identifying the current user, or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" if identity tracking is not supported. Ensembles uses this to detect account changes (e.g., signing out of iCloud).","type":"text"}]}]}]},{"type":"heading","anchor":"File-Operations","level":3,"text":"File Operations"},{"type":"codeListing","code":["func fileExists(atPath path: String) async throws -> FileExistence","func createDirectory(atPath path: String) async throws","func contentsOfDirectory(atPath path: String) async throws -> [any CloudItem]","func removeItem(atPath path: String) async throws"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Paths are forward-slash separated, rooted at ","type":"text"},{"code":"\/","type":"codeVoice"},{"text":". The ensemble creates a directory structure like ","type":"text"},{"code":"\/MyEnsemble\/events\/","type":"codeVoice"},{"text":", ","type":"text"},{"code":"\/MyEnsemble\/baselines\/","type":"codeVoice"},{"text":", etc.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Directory listings should return "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFile","isActive":true},{"type":"text","text":" or "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudDirectory","isActive":true},{"type":"text","text":" items with their "},{"type":"codeVoice","code":"path"},{"type":"text","text":" and "},{"code":"name","type":"codeVoice"},{"type":"text","text":" populated. Only list immediate children — do not recurse."}]},{"level":3,"text":"File Transfer","anchor":"File-Transfer","type":"heading"},{"syntax":"swift","type":"codeListing","code":["func uploadLocalFile(atPath localPath: String, toPath remotePath: String) async throws","func downloadFile(atPath remotePath: String, toLocalFile localPath: String) async throws"]},{"inlineContent":[{"type":"text","text":"Upload copies a local file to the remote path. Download copies a remote file to the local path. Both paths are absolute on their respective systems (local paths are filesystem paths; remote paths are within the cloud file system’s namespace)."}],"type":"paragraph"},{"level":2,"text":"A Minimal Example","anchor":"A-Minimal-Example","type":"heading"},{"inlineContent":[{"type":"text","text":"Here is a skeleton implementation to illustrate the structure:"}],"type":"paragraph"},{"code":["import Ensembles","","public final class MyCloudFileSystem: CloudFileSystem, @unchecked Sendable {","","    public var isConnected: Bool { true }","","    public func connect() async throws {","        \/\/ Authenticate or establish a session","    }","","    public func fetchUserIdentity() async throws","        -> sending (any NSObjectProtocol & NSCoding & NSCopying)? {","        \/\/ Return a user token, or nil","        return nil","    }","","    public func fileExists(atPath path: String) async throws -> FileExistence {","        \/\/ Check your storage and return the result","    }","","    public func createDirectory(atPath path: String) async throws {","        \/\/ Create a directory marker or equivalent","    }","","    public func contentsOfDirectory(atPath path: String) async throws","        -> [any CloudItem] {","        \/\/ List immediate children as CloudFile\/CloudDirectory items","    }","","    public func removeItem(atPath path: String) async throws {","        \/\/ Delete a file or directory (and its contents)","    }","","    public func uploadLocalFile(","        atPath localPath: String,","        toPath remotePath: String","    ) async throws {","        let data = try Data(contentsOf: URL(fileURLWithPath: localPath))","        \/\/ Store data at remotePath in your backend","    }","","    public func downloadFile(","        atPath remotePath: String,","        toLocalFile localPath: String","    ) async throws {","        \/\/ Retrieve data from remotePath in your backend","        let data: Data = \/\/ ...fetch from backend","        try data.write(to: URL(fileURLWithPath: localPath), options: .atomic)","    }","}"],"type":"codeListing","syntax":"swift"},{"level":2,"text":"Reference Implementations","anchor":"Reference-Implementations","type":"heading"},{"inlineContent":[{"type":"text","text":"Study the built-in backends as starting points:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"MemoryCloudFileSystem"}]},{"type":"text","text":" (in "},{"code":"EnsemblesMemory","type":"codeVoice"},{"type":"text","text":") — The simplest implementation. An actor that stores files in a dictionary. Good for understanding the protocol’s expectations."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"LocalCloudFileSystem","type":"codeVoice"}]},{"type":"text","text":" (in "},{"type":"codeVoice","code":"EnsemblesLocalFile"},{"type":"text","text":") — Uses "},{"type":"codeVoice","code":"FileManager"},{"type":"text","text":" to store files in a local directory. Shows how to map the protocol onto a real file system."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"CloudKitFileSystem"}]},{"type":"text","text":" (in "},{"code":"EnsemblesCloudKit","type":"codeVoice"},{"type":"text","text":") — A production backend using CloudKit. Shows how to implement batch operations and setup hooks."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"PCloudCloudFileSystem","type":"codeVoice"}]},{"type":"text","text":" (in "},{"type":"codeVoice","code":"EnsemblesPCloud"},{"type":"text","text":") — A URLSession-based REST client with no SDK dependency. A good model for building backends against any REST API."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"BoxCloudFileSystem"}]},{"type":"text","text":" (in "},{"code":"EnsemblesBox","type":"codeVoice"},{"type":"text","text":") — Wraps the Box Swift SDK. Demonstrates how to bridge an ID-based API (where files are identified by numeric IDs, not paths) onto the path-based "},{"code":"CloudFileSystem","type":"codeVoice"},{"type":"text","text":" protocol using folder-walking and caching."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"S3CloudFileSystem","type":"codeVoice"}]},{"type":"text","text":" (in "},{"type":"codeVoice","code":"EnsemblesS3"},{"type":"text","text":") — Wraps the AWS SDK for Swift. Shows how to simulate directory semantics on a flat key-value store using key prefixes and delimiters."}]}]}],"type":"unorderedList"},{"name":"Note","style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"EnsemblesBox"},{"type":"text","text":" and "},{"type":"codeVoice","code":"EnsemblesS3"},{"type":"text","text":" (along with "},{"type":"codeVoice","code":"EnsemblesDropbox"},{"type":"text","text":", "},{"type":"codeVoice","code":"EnsemblesZip"},{"type":"text","text":", and "},{"type":"codeVoice","code":"EnsemblesMultipeer"},{"type":"text","text":") require an external SDK. With the source distribution, enabling the corresponding package trait resolves this automatically. With the binary distribution (XCFrameworks), you must add the external SDK as a separate package dependency — see the Available Backends table in the README for details."}]}]},{"type":"heading","level":2,"text":"Optional: Batch Operations","anchor":"Optional-Batch-Operations"},{"inlineContent":[{"type":"text","text":"If your backend can handle multiple files in a single request (reducing round trips), adopt "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemBatchOperations","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["extension MyCloudFileSystem: CloudFileSystemBatchOperations {","    public var fileUploadMaximumBatchSize: Int { 20 }","    public var fileDownloadMaximumBatchSize: Int { 20 }","","    public func uploadLocalFiles(","        atPaths localPaths: [String],","        toPaths remotePaths: [String]","    ) async throws {","        \/\/ Upload multiple files in one request","    }","","    public func downloadFiles(","        atPaths remotePaths: [String],","        toLocalFiles localPaths: [String]","    ) async throws {","        \/\/ Download multiple files in one request","    }","","    public func removeItems(atPaths paths: [String]) async throws {","        \/\/ Delete multiple items in one request","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"fileUploadMaximumBatchSize"},{"text":" and ","type":"text"},{"code":"fileDownloadMaximumBatchSize","type":"codeVoice"},{"text":" properties control how many files Ensembles passes per batch call. Default is 10 if you don’t override them.","type":"text"}]},{"type":"heading","level":2,"text":"Optional: Setup Hooks","anchor":"Optional-Setup-Hooks"},{"type":"paragraph","inlineContent":[{"text":"For backends that need initialization, caching, or repair logic, adopt ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup"},{"type":"text","text":":"}]},{"code":["extension MyCloudFileSystem: CloudFileSystemSetup {","    public func performInitialPreparation() async throws {","        \/\/ One-time setup (e.g., create root directories)","    }","","    public func primeForActivity() async throws {","        \/\/ Called before each operation (e.g., refresh auth tokens,","        \/\/ cache directory listings)","    }","","    public func directoryExists(atPath path: String) async throws -> Bool {","        \/\/ Check directory existence","    }","","    public func repairEnsembleDirectory(atPath path: String) async throws {","        \/\/ Fix up issues like iCloud duplicates or stale locks","    }","}"],"syntax":"swift","type":"codeListing"},{"level":2,"text":"Threading and Sendable","anchor":"Threading-and-Sendable","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Cloud file systems must conform to "},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":". If your implementation uses mutable state, you have several options:"}]},{"items":[{"content":[{"inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"actor"},{"text":" isolation (as ","type":"text"},{"code":"MemoryCloudFileSystem","type":"codeVoice"},{"text":" does)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Use ","type":"text"},{"code":"@unchecked Sendable","type":"codeVoice"},{"text":" with explicit locking (as ","type":"text"},{"code":"LocalCloudFileSystem","type":"codeVoice"},{"type":"text","text":" does)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Make the type stateless, delegating state to a thread-safe service"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"All protocol methods are "},{"type":"codeVoice","code":"async throws"},{"text":", so you can freely call async APIs in your implementation.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://Ensembles/documentation/Ensembles/CloudFileSystemBatchOperations":{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemBatchOperations","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"CloudFileSystemBatchOperations"}],"navigatorTitle":[{"kind":"identifier","text":"CloudFileSystemBatchOperations"}],"title":"CloudFileSystemBatchOperations","kind":"symbol","type":"topic","abstract":[{"text":"Optional batch and setup operations for cloud file systems.","type":"text"}],"url":"\/documentation\/ensembles\/cloudfilesystembatchoperations"},"doc://Ensembles/documentation/Ensembles/CloudFileSystem/isConnected":{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/isConnected","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isConnected"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"required":true,"title":"isConnected","kind":"symbol","type":"topic","abstract":[{"text":"Whether the file system is connected and ready for file transactions.","type":"text"}],"url":"\/documentation\/ensembles\/cloudfilesystem\/isconnected"},"doc://Ensembles/documentation/Ensembles/CloudDirectory":{"url":"\/documentation\/ensembles\/clouddirectory","title":"CloudDirectory","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CloudDirectory"}],"abstract":[{"text":"Represents a directory in a cloud file system.","type":"text"}],"kind":"symbol","role":"symbol","naviga