{"primaryContentSections":[{"content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Ensembles exchanges sync data through a "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem","isActive":true},{"type":"text","text":" — a protocol that abstracts file storage behind a simple path-based API. Any service that can store and retrieve files at paths can serve as a backend: cloud storage (S3, Google Cloud Storage), file servers (WebDAV, SFTP), databases, or even peer-to-peer connections with a local cache."}],"type":"paragraph"},{"level":2,"type":"heading","text":"The CloudFileSystem Protocol","anchor":"The-CloudFileSystem-Protocol"},{"inlineContent":[{"type":"text","text":"The core protocol has 8 requirements organized into four groups:"}],"type":"paragraph"},{"text":"Connection","level":3,"anchor":"Connection","type":"heading"},{"syntax":"swift","code":["public protocol CloudFileSystem: AnyObject, Sendable {","    var isConnected: Bool { get }","    func connect() async throws","    func fetchUserIdentity() async throws","        -> sending (any NSObjectProtocol & NSCoding & NSCopying)?","}"],"type":"codeListing"},{"items":[{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/isConnected","type":"reference"},{"type":"text","text":" — Return whether the backend is ready for operations."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/connect()","isActive":true},{"text":" — Establish a connection. Called before each attach or merge.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/fetchUserIdentity()","isActive":true},{"type":"text","text":" — Return a token identifying the current user, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" if identity tracking is not supported. Ensembles uses this to detect account changes (e.g., signing out of iCloud)."}]}]}],"type":"unorderedList"},{"text":"File Operations","level":3,"anchor":"File-Operations","type":"heading"},{"syntax":"swift","code":["func fileExists(atPath path: String) async throws -> FileExistence","func createDirectory(atPath path: String) async throws","func contentsOfDirectory(atPath path: String) async throws -> [any CloudItem]","func removeItem(atPath path: String) async throws"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Paths are forward-slash separated, rooted at "},{"type":"codeVoice","code":"\/"},{"type":"text","text":". The ensemble creates a directory structure like "},{"type":"codeVoice","code":"\/MyEnsemble\/events\/"},{"type":"text","text":", "},{"type":"codeVoice","code":"\/MyEnsemble\/baselines\/"},{"type":"text","text":", etc."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Directory listings should return "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFile","isActive":true},{"type":"text","text":" or "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudDirectory","isActive":true},{"type":"text","text":" items with their "},{"type":"codeVoice","code":"path"},{"type":"text","text":" and "},{"type":"codeVoice","code":"name"},{"type":"text","text":" populated. Only list immediate children — do not recurse."}],"type":"paragraph"},{"text":"File Transfer","level":3,"anchor":"File-Transfer","type":"heading"},{"syntax":"swift","code":["func uploadLocalFile(atPath localPath: String, toPath remotePath: String) async throws","func downloadFile(atPath remotePath: String, toLocalFile localPath: String) async throws"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Upload copies a local file to the remote path. Download copies a remote file to the local path. Both paths are absolute on their respective systems (local paths are filesystem paths; remote paths are within the cloud file system’s namespace)."}],"type":"paragraph"},{"text":"A Minimal Example","level":2,"anchor":"A-Minimal-Example","type":"heading"},{"inlineContent":[{"type":"text","text":"Here is a skeleton implementation to illustrate the structure:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import Ensembles","","public final class MyCloudFileSystem: CloudFileSystem, @unchecked Sendable {","","    public var isConnected: Bool { true }","","    public func connect() async throws {","        \/\/ Authenticate or establish a session","    }","","    public func fetchUserIdentity() async throws","        -> sending (any NSObjectProtocol & NSCoding & NSCopying)? {","        \/\/ Return a user token, or nil","        return nil","    }","","    public func fileExists(atPath path: String) async throws -> FileExistence {","        \/\/ Check your storage and return the result","    }","","    public func createDirectory(atPath path: String) async throws {","        \/\/ Create a directory marker or equivalent","    }","","    public func contentsOfDirectory(atPath path: String) async throws","        -> [any CloudItem] {","        \/\/ List immediate children as CloudFile\/CloudDirectory items","    }","","    public func removeItem(atPath path: String) async throws {","        \/\/ Delete a file or directory (and its contents)","    }","","    public func uploadLocalFile(","        atPath localPath: String,","        toPath remotePath: String","    ) async throws {","        let data = try Data(contentsOf: URL(fileURLWithPath: localPath))","        \/\/ Store data at remotePath in your backend","    }","","    public func downloadFile(","        atPath remotePath: String,","        toLocalFile localPath: String","    ) async throws {","        \/\/ Retrieve data from remotePath in your backend","        let data: Data = \/\/ ...fetch from backend","        try data.write(to: URL(fileURLWithPath: localPath), options: .atomic)","    }","}"]},{"text":"Reference Implementations","level":2,"anchor":"Reference-Implementations","type":"heading"},{"inlineContent":[{"type":"text","text":"Study the built-in backends as starting points:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":"MemoryCloudFileSystem","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" (in "},{"type":"codeVoice","code":"EnsemblesMemory"},{"type":"text","text":") — The simplest implementation. An actor that stores files in a dictionary. Good for understanding the protocol’s expectations."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":"LocalCloudFileSystem","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" (in "},{"type":"codeVoice","code":"EnsemblesLocalFile"},{"type":"text","text":") — Uses "},{"type":"codeVoice","code":"FileManager"},{"type":"text","text":" to store files in a local directory. Shows how to map the protocol onto a real file system."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":"CloudKitFileSystem","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" (in "},{"type":"codeVoice","code":"EnsemblesCloudKit"},{"type":"text","text":") — A production backend using CloudKit. Shows how to implement batch operations and setup hooks."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":"PCloudCloudFileSystem","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" (in "},{"type":"codeVoice","code":"EnsemblesPCloud"},{"type":"text","text":") — A URLSession-based REST client with no SDK dependency. A good model for building backends against any REST API."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":"BoxCloudFileSystem","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" (in "},{"type":"codeVoice","code":"EnsemblesBox"},{"type":"text","text":") — Wraps the Box Swift SDK. Demonstrates how to bridge an ID-based API (where files are identified by numeric IDs, not paths) onto the path-based "},{"type":"codeVoice","code":"CloudFileSystem"},{"type":"text","text":" protocol using folder-walking and caching."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":"S3CloudFileSystem","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" (in "},{"type":"codeVoice","code":"EnsemblesS3"},{"type":"text","text":") — Wraps the AWS SDK for Swift. Shows how to simulate directory semantics on a flat key-value store using key prefixes and delimiters."}]}]}],"type":"unorderedList"},{"content":[{"inlineContent":[{"type":"text","text":""},{"code":"EnsemblesBox","type":"codeVoice"},{"type":"text","text":" and "},{"code":"EnsemblesS3","type":"codeVoice"},{"type":"text","text":" (along with "},{"code":"EnsemblesDropbox","type":"codeVoice"},{"type":"text","text":", "},{"code":"EnsemblesZip","type":"codeVoice"},{"type":"text","text":", and "},{"code":"EnsemblesMultipeer","type":"codeVoice"},{"type":"text","text":") require an external SDK. With the source distribution, enabling the corresponding package trait resolves this automatically. With the binary distribution (XCFrameworks), you must add the external SDK as a separate package dependency — see the Available Backends table in the README for details."}],"type":"paragraph"}],"name":"Note","type":"aside","style":"note"},{"text":"Optional: Batch Operations","level":2,"anchor":"Optional-Batch-Operations","type":"heading"},{"inlineContent":[{"type":"text","text":"If your backend can handle multiple files in a single request (reducing round trips), adopt "},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemBatchOperations","type":"reference"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["extension MyCloudFileSystem: CloudFileSystemBatchOperations {","    public var fileUploadMaximumBatchSize: Int { 20 }","    public var fileDownloadMaximumBatchSize: Int { 20 }","","    public func uploadLocalFiles(","        atPaths localPaths: [String],","        toPaths remotePaths: [String]","    ) async throws {","        \/\/ Upload multiple files in one request","    }","","    public func downloadFiles(","        atPaths remotePaths: [String],","        toLocalFiles localPaths: [String]","    ) async throws {","        \/\/ Download multiple files in one request","    }","","    public func removeItems(atPaths paths: [String]) async throws {","        \/\/ Delete multiple items in one request","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"fileUploadMaximumBatchSize"},{"type":"text","text":" and "},{"type":"codeVoice","code":"fileDownloadMaximumBatchSize"},{"type":"text","text":" properties control how many files Ensembles passes per batch call. Default is 10 if you don’t override them."}],"type":"paragraph"},{"text":"Optional: Setup Hooks","level":2,"anchor":"Optional-Setup-Hooks","type":"heading"},{"inlineContent":[{"type":"text","text":"For backends that need initialization, caching, or repair logic, adopt "},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup","type":"reference"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["extension MyCloudFileSystem: CloudFileSystemSetup {","    public func performInitialPreparation() async throws {","        \/\/ One-time setup (e.g., create root directories)","    }","","    public func primeForActivity() async throws {","        \/\/ Called before each operation (e.g., refresh auth tokens,","        \/\/ cache directory listings)","    }","","    public func directoryExists(atPath path: String) async throws -> Bool {","        \/\/ Check directory existence","    }","","    public func repairEnsembleDirectory(atPath path: String) async throws {","        \/\/ Fix up issues like iCloud duplicates or stale locks","    }","}"],"type":"codeListing"},{"text":"Threading and Sendable","level":2,"anchor":"Threading-and-Sendable","type":"heading"},{"inlineContent":[{"type":"text","text":"Cloud file systems must conform to "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":". If your implementation uses mutable state, you have several options:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"actor"},{"type":"text","text":" isolation (as "},{"type":"codeVoice","code":"MemoryCloudFileSystem"},{"type":"text","text":" does)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"@unchecked Sendable"},{"type":"text","text":" with explicit locking (as "},{"type":"codeVoice","code":"LocalCloudFileSystem"},{"type":"text","text":" does)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Make the type stateless, delegating state to a thread-safe service"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"All protocol methods are "},{"type":"codeVoice","code":"async throws"},{"type":"text","text":", so you can freely call async APIs in your implementation."}],"type":"paragraph"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Ensembles\/documentation\/Ensembles\/CustomCloudBackends"},"hierarchy":{"paths":[["doc:\/\/Ensembles\/documentation\/Ensembles"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"type":"text","text":"Implement the CloudFileSystem protocol to sync via any storage service."}],"variants":[{"paths":["\/documentation\/ensembles\/customcloudbackends"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"metadata":{"role":"article","roleHeading":"Article","modules":[{"name":"Ensembles"}],"title":"Custom Cloud Backends"},"kind":"article","seeAlsoSections":[{"anchor":"Cloud-Backends","title":"Cloud Backends","identifiers":["doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem","doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemBatchOperations","doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup"],"generated":true}],"references":{"doc://Ensembles/documentation/Ensembles/CloudDirectory":{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudDirectory","type":"topic","navigatorTitle":[{"text":"CloudDirectory","kind":"identifier"}],"abstract":[{"text":"Represents a directory in a cloud file system.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CloudDirectory","kind":"identifier"}],"url":"\/documentation\/ensembles\/clouddirectory","title":"CloudDirectory","kind":"symbol","role":"symbol"},"doc://Ensembles/documentation/Ensembles/CloudFile":{"type":"topic","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFile","url":"\/documentation\/ensembles\/cloudfile","title":"CloudFile","abstract":[{"type":"text","text":"Represents a file in a cloud file system."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CloudFile","kind":"identifier"}],"navigatorTitle":[{"text":"CloudFile","kind":"identifier"}],"kind":"symbol"},"doc://Ensembles/documentation/Ensembles/CloudFileSystemBatchOperations":{"type":"topic","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemBatchOperations","url":"\/documentation\/ensembles\/cloudfilesystembatchoperations","title":"CloudFileSystemBatchOperations","abstract":[{"type":"text","text":"Optional batch and setup operations for cloud file systems."}],"role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CloudFileSystemBatchOperations","kind":"identifier"}],"navigatorTitle":[{"text":"CloudFileSystemBatchOperations","kind":"identifier"}],"kind":"symbol"},"doc://Ensembles/documentation/Ensembles/CloudFileSystem/connect()":{"abstract":[{"type":"text","text":"Attempts to connect to the cloud backend."}],"type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"connect","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}],"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/connect()","role":"symbol","title":"connect()","kind":"symbol","required":true,"url":"\/documentation\/ensembles\/cloudfilesystem\/connect()"},"doc://Ensembles/documentation/Ensembles":{"url":"\/documentation\/ensembles","type":"topic","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles","title":"Ensembles","role":"collection","kind":"symbol","abstract":[{"type":"text","text":"Sync Core Data and SwiftData stores across devices using event sourcing."}]},"doc://Ensembles/documentation/Ensembles/CloudFileSystemSetup":{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup","url":"\/documentation\/ensembles\/cloudfilesystemsetup","kind":"symbol","abstract":[{"type":"text","text":"Optional setup and maintenance operations for cloud file systems."}],"title":"CloudFileSystemSetup","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CloudFileSystemSetup","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"CloudFileSystemSetup","kind":"identifier"}]},"doc://Ensembles/documentation/Ensembles/CloudFileSystem/fetchUserIdentity()":{"role":"symbol","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/fetchUserIdentity()","type":"topic","abstract":[{"text":"Fetches a token representing the current user of the cloud file system.","type":"text"},{"text":" ","type":"text"},{"text":"Often this will be the user or login name.","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"fetchUserIdentity","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> sending (any ","kind":"text"},{"text":"NSCoding","kind":"typeIdentifier","preciseIdentifier":"c:objc(pl)NSCoding"},{"text":" & ","kind":"text"},{"text":"NSCopying","kind":"typeIdentifier","preciseIdentifier":"c:objc(pl)NSCopying"},{"text":" & ","kind":"text"},{"text":"NSObjectProtocol","kind":"typeIdentifier","preciseIdentifier":"c:objc(pl)NSObject"},{"text":")?","kind":"text"}],"url":"\/documentation\/ensembles\/cloudfilesystem\/fetchuseridentity()","kind":"symbol","title":"fetchUserIdentity()","required":true},"doc://Ensembles/documentation/Ensembles/CloudFileSystem/isConnected":{"role":"symbol","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/isConnected","type":"topic","abstract":[{"type":"text","text":"Whether the file system is connected and ready for file transactions."}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isConnected","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"title":"isConnected","kind":"symbol","url":"\/documentation\/ensembles\/cloudfilesystem\/isconnected","required":true},"doc://Ensembles/documentation/Ensembles/CloudFileSystem":{"type":"topic","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem","url":"\/documentation\/ensembles\/cloudfilesystem","title":"CloudFileSystem","abstract":[{"type":"text","text":"A cloud file system facilitates data transfer between devices."}],"role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CloudFileSystem","kind":"identifier"}],"navigatorTitle":[{"text":"CloudFileSystem","kind":"identifier"}],"kind":"symbol"}}}