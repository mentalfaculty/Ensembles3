{"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"roleHeading":"Article","modules":[{"name":"Ensembles"}],"title":"Custom Cloud Backends","role":"article"},"abstract":[{"text":"Implement the CloudFileSystem protocol to sync via any storage service.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"text":"Ensembles exchanges sync data through a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem","type":"reference"},{"text":" — a protocol that abstracts file storage behind a simple path-based API. Any service that can store and retrieve files at paths can serve as a backend: cloud storage (S3, Google Cloud Storage), file servers (WebDAV, SFTP), databases, or even peer-to-peer connections with a local cache.","type":"text"}],"type":"paragraph"},{"anchor":"The-CloudFileSystem-Protocol","level":2,"type":"heading","text":"The CloudFileSystem Protocol"},{"inlineContent":[{"type":"text","text":"The core protocol has 8 requirements organized into four groups:"}],"type":"paragraph"},{"text":"Connection","type":"heading","level":3,"anchor":"Connection"},{"syntax":"swift","type":"codeListing","code":["public protocol CloudFileSystem: AnyObject, Sendable {","    var isConnected: Bool { get }","    func connect() async throws","    func fetchUserIdentity() async throws","        -> sending (any NSObjectProtocol & NSCoding & NSCopying)?","}"]},{"items":[{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/isConnected","isActive":true},{"text":" — Return whether the backend is ready for operations.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/connect()","type":"reference","isActive":true},{"type":"text","text":" — Establish a connection. Called before each attach or merge."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/fetchUserIdentity()"},{"text":" — Return a token identifying the current user, or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" if identity tracking is not supported. Ensembles uses this to detect account changes (e.g., signing out of iCloud).","type":"text"}]}]}],"type":"unorderedList"},{"anchor":"File-Operations","level":3,"type":"heading","text":"File Operations"},{"type":"codeListing","code":["func fileExists(atPath path: String) async throws -> FileExistence","func createDirectory(atPath path: String) async throws","func contentsOfDirectory(atPath path: String) async throws -> [any CloudItem]","func removeItem(atPath path: String) async throws"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"Paths are forward-slash separated, rooted at "},{"code":"\/","type":"codeVoice"},{"type":"text","text":". The ensemble creates a directory structure like "},{"type":"codeVoice","code":"\/MyEnsemble\/events\/"},{"type":"text","text":", "},{"type":"codeVoice","code":"\/MyEnsemble\/baselines\/"},{"type":"text","text":", etc."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Directory listings should return "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFile","type":"reference","isActive":true},{"type":"text","text":" or "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudDirectory"},{"type":"text","text":" items with their "},{"type":"codeVoice","code":"path"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"name"},{"type":"text","text":" populated. Only list immediate children — do not recurse."}]},{"inlineContent":[{"text":"There is one optional existence check, ","type":"text"},{"type":"codeVoice","code":"confirmFileExists(atPath:)"},{"type":"text","text":", with a default implementation that calls "},{"code":"fileExists(atPath:)","type":"codeVoice"},{"text":". The framework uses it for checks whose consequences are drastic, such as the per-sync store-registration check that detects a reset cloud. If your backend answers ","type":"text"},{"code":"fileExists","type":"codeVoice"},{"text":" from a local cache of remote state, implement ","type":"text"},{"type":"codeVoice","code":"confirmFileExists"},{"text":" to consult the server directly; if ","type":"text"},{"code":"fileExists","type":"codeVoice"},{"type":"text","text":" is already authoritative, the default is correct. Wrapper backends that delegate to another file system must forward "},{"type":"codeVoice","code":"confirmFileExists"},{"text":" to the wrapped backend’s ","type":"text"},{"type":"codeVoice","code":"confirmFileExists"},{"type":"text","text":" — the default cannot see through a wrapper, and would quietly downgrade the confirmation to the wrapped backend’s cached check."}],"type":"paragraph"},{"type":"heading","level":3,"anchor":"File-Transfer","text":"File Transfer"},{"type":"codeListing","syntax":"swift","code":["func uploadLocalFile(atPath localPath: String, toPath remotePath: String) async throws","func downloadFile(atPath remotePath: String, toLocalFile localPath: String) async throws"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Upload copies a local file to the remote path. Download copies a remote file to the local path. Both paths are absolute on their respective systems (local paths are filesystem paths; remote paths are within the cloud file system’s namespace)."}]},{"level":2,"anchor":"A-Minimal-Example","type":"heading","text":"A Minimal Example"},{"type":"paragraph","inlineContent":[{"text":"Here is a skeleton implementation to illustrate the structure:","type":"text"}]},{"code":["import Ensembles","","public final class MyCloudFileSystem: CloudFileSystem, @unchecked Sendable {","","    public var isConnected: Bool { true }","","    public func connect() async throws {","        \/\/ Authenticate or establish a session","    }","","    public func fetchUserIdentity() async throws","        -> sending (any NSObjectProtocol & NSCoding & NSCopying)? {","        \/\/ Return a user token, or nil","        return nil","    }","","    public func fileExists(atPath path: String) async throws -> FileExistence {","        \/\/ Check your storage and return the result","    }","","    public func createDirectory(atPath path: String) async throws {","        \/\/ Create a directory marker or equivalent","    }","","    public func contentsOfDirectory(atPath path: String) async throws","        -> [any CloudItem] {","        \/\/ List immediate children as CloudFile\/CloudDirectory items","    }","","    public func removeItem(atPath path: String) async throws {","        \/\/ Delete a file or directory (and its contents)","    }","","    public func uploadLocalFile(","        atPath localPath: String,","        toPath remotePath: String","    ) async throws {","        let data = try Data(contentsOf: URL(fileURLWithPath: localPath))","        \/\/ Store data at remotePath in your backend","    }","","    public func downloadFile(","        atPath remotePath: String,","        toLocalFile localPath: String","    ) async throws {","        \/\/ Retrieve data from remotePath in your backend","        let data: Data = \/\/ ...fetch from backend","        try data.write(to: URL(fileURLWithPath: localPath), options: .atomic)","    }","}"],"type":"codeListing","syntax":"swift"},{"anchor":"Reference-Implementations","level":2,"text":"Reference Implementations","type":"heading"},{"inlineContent":[{"text":"Study the built-in backends as starting points:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"MemoryCloudFileSystem","type":"codeVoice"}]},{"type":"text","text":" (in "},{"code":"EnsemblesMemory","type":"codeVoice"},{"type":"text","text":") — The simplest implementation. An actor that stores files in a dictionary. Good for understanding the protocol’s expectations."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"LocalCloudFileSystem"}]},{"type":"text","text":" (in "},{"type":"codeVoice","code":"EnsemblesLocalFile"},{"text":") — Uses ","type":"text"},{"type":"codeVoice","code":"FileManager"},{"text":" to store files in a local directory. Shows how to map the protocol onto a real file system.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"CloudKitFileSystem"}]},{"text":" (in ","type":"text"},{"type":"codeVoice","code":"EnsemblesCloudKit"},{"text":") — A production backend using CloudKit. Shows how to implement batch operations and setup hooks.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"PCloudCloudFileSystem"}]},{"type":"text","text":" (in "},{"code":"EnsemblesPCloud","type":"codeVoice"},{"text":") — A URLSession-based REST client with no SDK dependency. A good model for building backends against any REST API.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"BoxCloudFileSystem","type":"codeVoice"}]},{"type":"text","text":" (in "},{"type":"codeVoice","code":"EnsemblesBox"},{"type":"text","text":") — Wraps the Box Swift SDK. Demonstrates how to bridge an ID-based API (where files are identified by numeric IDs, not paths) onto the path-based "},{"type":"codeVoice","code":"CloudFileSystem"},{"type":"text","text":" protocol using folder-walking and caching."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"S3CloudFileSystem"}]},{"text":" (in ","type":"text"},{"type":"codeVoice","code":"EnsemblesS3"},{"type":"text","text":") — Wraps the AWS SDK for Swift. Shows how to simulate directory semantics on a flat key-value store using key prefixes and delimiters."}],"type":"paragraph"}]}],"type":"unorderedList"},{"style":"note","type":"aside","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"EnsemblesBox","type":"codeVoice"},{"type":"text","text":" and "},{"type":"codeVoice","code":"EnsemblesS3"},{"text":" (along with ","type":"text"},{"code":"EnsemblesDropbox","type":"codeVoice"},{"text":", ","type":"text"},{"code":"EnsemblesZip","type":"codeVoice"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"EnsemblesMultipeer"},{"type":"text","text":") require an external SDK. With the source distribution, enabling the corresponding package trait resolves this automatically. With the binary distribution (XCFrameworks), you must add the external SDK as a separate package dependency — see the Available Backends table in the README for details."}]}]},{"level":2,"type":"heading","text":"Optional: Batch Operations","anchor":"Optional-Batch-Operations"},{"type":"paragraph","inlineContent":[{"text":"If your backend can handle multiple files in a single request (reducing round trips), adopt ","type":"text"},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemBatchOperations","isActive":true,"type":"reference"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["extension MyCloudFileSystem: CloudFileSystemBatchOperations {","    public var fileUploadMaximumBatchSize: Int { 20 }","    public var fileDownloadMaximumBatchSize: Int { 20 }","","    public func uploadLocalFiles(","        atPaths localPaths: [String],","        toPaths remotePaths: [String]","    ) async throws {","        \/\/ Upload multiple files in one request","    }","","    public func downloadFiles(","        atPaths remotePaths: [String],","        toLocalFiles localPaths: [String]","    ) async throws {","        \/\/ Download multiple files in one request","    }","","    public func removeItems(atPaths paths: [String]) async throws {","        \/\/ Delete multiple items in one request","    }","}"]},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"fileUploadMaximumBatchSize"},{"type":"text","text":" and "},{"type":"codeVoice","code":"fileDownloadMaximumBatchSize"},{"type":"text","text":" properties control how many files Ensembles passes per batch call. Default is 10 if you don’t override them."}],"type":"paragraph"},{"level":2,"text":"Optional: Setup Hooks","type":"heading","anchor":"Optional-Setup-Hooks"},{"inlineContent":[{"type":"text","text":"For backends that need initialization, caching, or repair logic, adopt "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["extension MyCloudFileSystem: CloudFileSystemSetup {","    public func performInitialPreparation() async throws {","        \/\/ One-time setup (e.g., create root directories)","    }","","    public func primeForActivity() async throws {","        \/\/ Called before each operation (e.g., refresh auth tokens,","        \/\/ cache directory listings)","    }","","    public func directoryExists(atPath path: String) async throws -> Bool {","        \/\/ Check directory existence","    }","","    public func repairEnsembleDirectory(atPath path: String) async throws {","        \/\/ Fix up issues like iCloud duplicates or stale locks","    }","","    public func setLocalStoreDirectory(_ path: String?, discardingExistingCache: Bool) {","        \/\/ Where to keep any cache of remote state (see below).","        \/\/ Has a default no-op implementation; only implement it if you cache.","    }","}"],"type":"codeListing"},{"level":2,"text":"Caching Remote State","type":"heading","anchor":"Caching-Remote-State"},{"inlineContent":[{"type":"text","text":"Backends that fetch changes incrementally — keeping a cursor, change token, or cached"},{"text":" ","type":"text"},{"type":"text","text":"listing between launches — must store that state "},{"type":"strong","inlineContent":[{"type":"text","text":"inside the event store’s directory"}]},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"supplied by ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup\/setLocalStoreDirectory(_:discardingExistingCache:)","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"The reason is lifetime. A cache describes one particular event store at one point in its","type":"text"},{"text":" ","type":"text"},{"text":"history. Put it anywhere with an independent lifetime — the system caches directory is","type":"text"},{"text":" ","type":"text"},{"text":"the tempting choice — and it can outlive the store it describes. Deleting the app,","type":"text"},{"text":" ","type":"text"},{"text":"removing the local store, or resetting the cloud data then leaves the cache behind, and","type":"text"},{"text":" ","type":"text"},{"text":"the next launch resumes an incremental fetch from a cursor that no longer matches the","type":"text"},{"text":" ","type":"text"},{"text":"cloud. The server answers truthfully that nothing has changed since that cursor, so","type":"text"},{"text":" ","type":"text"},{"text":"files that predate it are never mentioned again. The device ends up with a silently","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"partial view of the cloud and no error to report, which is far harder to diagnose than"},{"text":" ","type":"text"},{"type":"text","text":"an outright failure."}]},{"inlineContent":[{"text":"Keeping the cache in the event store directory ties the two together: removing the store","type":"text"},{"type":"text","text":" "},{"text":"removes the cache, so a rebuilt store always starts from a full fetch.","type":"text"}],"type":"paragraph"},{"code":["public func setLocalStoreDirectory(_ path: String?, discardingExistingCache: Bool) {","    localStoreDirectory = path","    inMemoryCache = nil          \/\/ never carry state across stores","    guard path != nil else { return }","","    if discardingExistingCache {","        deleteCacheFromDisk()    \/\/ the store is being rebuilt: start clean","        return","    }","    loadCacheFromDisk()","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Three details matter. The method is called before priming whenever an ensemble knows its"},{"text":" ","type":"text"},{"text":"store, and it is ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}],"type":"emphasis"},{"text":" called for ensemble-independent operations such as","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/retrieveEnsembleIdentifiers(from:)","isActive":true},{"type":"text","text":" — so tolerate priming without a"},{"type":"text","text":" "},{"type":"text","text":"directory by simply not caching. When "},{"type":"codeVoice","code":"discardingExistingCache"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" the store is"},{"text":" ","type":"text"},{"text":"being rebuilt, so delete any cache you find rather than loading it; do the deletion","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"yourself rather than assuming the directory is empty. And never recreate the directory in"},{"type":"text","text":" "},{"type":"text","text":"order to write the cache: if it is gone, the store is gone, and the cache must go with"},{"type":"text","text":" "},{"type":"text","text":"it."}]},{"type":"heading","text":"Threading and Sendable","anchor":"Threading-and-Sendable","level":2},{"inlineContent":[{"type":"text","text":"Cloud file systems must conform to "},{"code":"Sendable","type":"codeVoice"},{"text":". If your implementation uses mutable state, you have several options:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"actor"},{"type":"text","text":" isolation (as "},{"type":"codeVoice","code":"MemoryCloudFileSystem"},{"type":"text","text":" does)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"code":"@unchecked Sendable","type":"codeVoice"},{"type":"text","text":" with explicit locking (as "},{"code":"LocalCloudFileSystem","type":"codeVoice"},{"type":"text","text":" does)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Make the type stateless, delegating state to a thread-safe service","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"All protocol methods are "},{"code":"async throws","type":"codeVoice"},{"type":"text","text":", so you can freely call async APIs in your implementation."}],"type":"paragraph"}]}],"identifier":{"url":"doc:\/\/Ensembles\/documentation\/Ensembles\/CustomCloudBackends","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ensembles\/customcloudbackends"]}],"sections":[],"seeAlsoSections":[{"generated":true,"anchor":"Cloud-Backends","identifiers":["doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem","doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemBatchOperations","doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup"],"title":"Cloud Backends"}],"kind":"article","hierarchy":{"paths":[["doc:\/\/Ensembles\/documentation\/Ensembles"]]},"references":{"doc://Ensembles/documentation/Ensembles/CloudFile":{"abstract":[{"text":"Represents a file in a cloud file system.","type":"text"}],"type":"topic","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFile","title":"CloudFile","url":"\/documentation\/ensembles\/cloudfile","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CloudFile","kind":"identifier"}],"navigatorTitle":[{"text":"CloudFile","kind":"identifier"}]},"doc://Ensembles/documentation/Ensembles/CloudFileSystemSetup/setLocalStoreDirectory(_:discardingExistingCache:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"setLocalStoreDirectory"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?, "},{"text":"discardingExistingCache","kind":"externalParam"},{"kind":"text","text":": "},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":")","kind":"text"}],"abstract":[{"type":"text","text":"Tells the file system which local directory belongs to the event store it is serving."}],"title":"setLocalStoreDirectory(_:discardingExistingCache:)","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup\/setLocalStoreDirectory(_:discardingExistingCache:)","role":"symbol","defaultImplementations":1,"type":"topic","url":"\/documentation\/ensembles\/cloudfilesystemsetup\/setlocalstoredirectory(_:discardingexistingcache:)","kind":"symbol","required":true},"doc://Ensembles/documentation/Ensembles/CloudFileSystem/fetchUserIdentity()":{"abstract":[{"type":"text","text":"Fetches a token representing the current user of the cloud file system."},{"type":"text","text":" "},{"type":"text","text":"Often this will be the user or login name."}],"type":"topic","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/fetchUserIdentity()","title":"fetchUserIdentity()","kind":"symbol","url":"\/documentation\/ensembles\/cloudfilesystem\/fetchuseridentity()","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"fetchUserIdentity","kind":"identifier"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> sending (any "},{"kind":"typeIdentifier","preciseIdentifier":"c:objc(pl)NSCoding","text":"NSCoding"},{"kind":"text","text":" & "},{"kind":"typeIdentifier","preciseIdentifier":"c:objc(pl)NSCopying","text":"NSCopying"},{"kind":"text","text":" & "},{"kind":"typeIdentifier","preciseIdentifier":"c:objc(pl)NSObject","text":"NSObjectProtocol"},{"kind":"text","text":")?"}],"required":true},"doc://Ensembles/documentation/Ensembles/CloudFileSystem/connect()":{"abstract":[{"text":"Attempts to connect to the cloud backend.","type":"text"}],"type":"topic","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/connect()","title":"connect()","url":"\/documentation\/ensembles\/cloudfilesystem\/connect()","kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"connect","kind":"identifier"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"text":"throws","kind":"keyword"}],"required":true},"doc://Ensembles/documentation/Ensembles/CloudFileSystemBatchOperations":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"CloudFileSystemBatchOperations"}],"navigatorTitle":[{"kind":"identifier","text":"CloudFileSystemBatchOperations"}],"abstract":[{"text":"Optional batch and setup operations for cloud file systems.","type":"text"}],"title":"CloudFileSystemBatchOperations","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemBatchOperations","role":"symbol","type":"topic","url":"\/documentation\/ensembles\/cloudfilesystembatchoperations","kind":"symbol"},"doc://Ensembles/documentation/Ensembles/CoreDataEnsemble/retrieveEnsembleIdentifiers(from:)":{"role":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"retrieveEnsembleIdentifiers"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": any "},{"kind":"typeIdentifier","preciseIdentifier":"s:9Ensembles15CloudFileSystemP","text":"CloudFileSystem"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> ["},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"]"}],"title":"retrieveEnsembleIdentifiers(from:)","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Queries a cloud file system for the identifiers of the ensembles it contains."}],"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/retrieveEnsembleIdentifiers(from:)","url":"\/documentation\/ensembles\/coredataensemble\/retrieveensembleidentifiers(from:)"},"doc://Ensembles/documentation/Ensembles/CloudDirectory":{"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CloudDirectory"}],"navigatorTitle":[{"kind":"identifier","text":"CloudDirectory"}],"title":"CloudDirectory","type":"topic","abstract":[{"text":"Represents a directory in a cloud file system.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudDirectory","url":"\/documentation\/ensembles\/clouddirectory"},"doc://Ensembles/documentation/Ensembles":{"type":"topic","kind":"symbol","url":"\/documentation\/ensembles","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles","role":"collection","abstract":[{"type":"text","text":"Sync Core Data and SwiftData stores across devices using event sourcing."}],"title":"Ensembles"},"doc://Ensembles/documentation/Ensembles/CloudFileSystem/isConnected":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isConnected"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"abstract":[{"type":"text","text":"Whether the file system is connected and ready for file transactions."}],"title":"isConnected","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/isConnected","role":"symbol","type":"topic","url":"\/documentation\/ensembles\/cloudfilesystem\/isconnected","kind":"symbol","required":true},"doc://Ensembles/documentation/Ensembles/CloudFileSystem":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CloudFileSystem","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"CloudFileSystem"}],"abstract":[{"text":"A cloud file system facilitates data transfer between devices.","type":"text"}],"title":"CloudFileSystem","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem","role":"symbol","type":"topic","url":"\/documentation\/ensembles\/cloudfilesystem","kind":"symbol"},"doc://Ensembles/documentation/Ensembles/CloudFileSystemSetup":{"role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CloudFileSystemSetup","kind":"identifier"}],"navigatorTitle":[{"text":"CloudFileSystemSetup","kind":"identifier"}],"title":"CloudFileSystemSetup","type":"topic","kind":"symbol","abstract":[{"text":"Optional setup and maintenance operations for cloud file systems.","type":"text"}],"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup","url":"\/documentation\/ensembles\/cloudfilesystemsetup"}}}