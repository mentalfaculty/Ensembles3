s a token representing the current user of the cloud file system.","type":"text"},{"text":" ","type":"text"},{"text":"Often this will be the user or login name.","type":"text"}],"kind":"symbol","title":"fetchUserIdentity()","type":"topic","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/fetchUserIdentity()"},"doc://Ensembles/documentation/Ensembles/CloudDirectory":{"type":"topic","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudDirectory","url":"\/documentation\/ensembles\/clouddirectory","navigatorTitle":[{"kind":"identifier","text":"CloudDirectory"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CloudDirectory"}],"role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"Represents a directory in a cloud file system."}],"title":"CloudDirectory"},"doc://Ensembles/documentation/Ensembles/CloudFile":{"type":"topic","navigatorTitle":[{"text":"CloudFile","kind":"identifier"}],"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFile","abstract":[{"text":"Represents a file in a cloud file system.","type":"text"}],"url":"\/documentation\/ensembles\/cloudfile","title":"CloudFile","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CloudFile","kind":"identifier"}],"role":"symbol","kind":"symbol"},"doc://Ensembles/documentation/Ensembles/CloudFileSystem":{"navigatorTitle":[{"text":"CloudFileSystem","kind":"identifier"}],"role":"symbol","title":"CloudFileSystem","type":"topic","url":"\/documentation\/ensembles\/cloudfilesystem","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem","abstract":[{"type":"text","text":"A cloud file system facilitates data transfer between devices."}],"kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CloudFileSystem","kind":"identifier"}]}}}