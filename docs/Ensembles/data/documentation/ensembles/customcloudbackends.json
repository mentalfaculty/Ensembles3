isActive":true,"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFile"},{"type":"text","text":" or "},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudDirectory","type":"reference"},{"text":" items with their ","type":"text"},{"code":"path","type":"codeVoice"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"name"},{"type":"text","text":" populated. Only list immediate children — do not recurse."}],"type":"paragraph"},{"anchor":"File-Transfer","level":3,"type":"heading","text":"File Transfer"},{"syntax":"swift","code":["func uploadLocalFile(atPath localPath: String, toPath remotePath: String) async throws","func downloadFile(atPath remotePath: String, toLocalFile localPath: String) async throws"],"type":"codeListing"},{"inlineContent":[{"text":"Upload copies a local file to the remote path. Download copies a remote file to the local path. Both paths are absolute on their respective systems (local paths are filesystem paths; remote paths are within the cloud file system’s namespace).","type":"text"}],"type":"paragraph"},{"anchor":"A-Minimal-Example","level":2,"type":"heading","text":"A Minimal Example"},{"inlineContent":[{"type":"text","text":"Here is a skeleton implementation to illustrate the structure:"}],"type":"paragraph"},{"syntax":"swift","code":["import Ensembles","","public final class MyCloudFileSystem: CloudFileSystem, @unchecked Sendable {","","    public var isConnected: Bool { true }","","    public func connect() async throws {","        \/\/ Authenticate or establish a session","    }","","    public func fetchUserIdentity() async throws","        -> sending (any NSObjectProtocol & NSCoding & NSCopying)? {","        \/\/ Return a user token, or nil","        return nil","    }","","    public func fileExists(atPath path: String) async throws -> FileExistence {","        \/\/ Check your storage and return the result","    }","","    public func createDirectory(atPath path: String) async throws {","        \/\/ Create a directory marker or equivalent","    }","","    public func contentsOfDirectory(atPath path: String) async throws","        -> [any CloudItem] {","        \/\/ List immediate children as CloudFile\/CloudDirectory items","    }","","    public func removeItem(atPath path: String) async throws {","        \/\/ Delete a file or directory (and its contents)","    }","","    public func uploadLocalFile(","        atPath localPath: String,","        toPath remotePath: String","    ) async throws {","        let data = try Data(contentsOf: URL(fileURLWithPath: localPath))","        \/\/ Store data at remotePath in your backend","    }","","    public func downloadFile(","        atPath remotePath: String,","        toLocalFile localPath: String","    ) async throws {","        \/\/ Retrieve data from remotePath in your backend","        let data: Data = \/\/ ...fetch from backend","        try data.write(to: URL(fileURLWithPath: localPath), options: .atomic)","    }","}"],"type":"codeListing"},{"anchor":"Reference-Implementations","level":2,"type":"heading","text":"Reference Implementations"},{"inlineContent":[{"type":"text","text":"Study the built-in backends as starting points:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"MemoryCloudFileSystem"}],"type":"strong"},{"type":"text","text":" (in "},{"type":"codeVoice","code":"EnsemblesMemory"},{"type":"text","text":") — The simplest implementation. An actor that stores files in a dictionary. Good for understanding the protocol’s expectations."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"LocalCloudFileSystem"}],"type":"strong"},{"text":" (in ","type":"text"},{"code":"EnsemblesLocalFile","type":"codeVoice"},{"text":") — Uses ","type":"text"},{"code":"FileManager","type":"codeVoice"},{"text":" to store files in a local directory. Shows how to map the protocol onto a real file system.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"CloudKitFileSystem"}]},{"text":" (in ","type":"text"},{"code":"EnsemblesCloudKit","type":"codeVoice"},{"text":") — A production backend using CloudKit. Shows how to implement batch operations and setup hooks.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":"PCloudCloudFileSystem","type":"codeVoice"}],"type":"strong"},{"text":" (in ","type":"text"},{"code":"EnsemblesPCloud","type":"codeVoice"},{"text":") — A URLSession-based REST client with no SDK dependency. A good model for building backends against any REST API.","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"BoxCloudFileSystem"}],"type":"strong"},{"text":" (in ","type":"text"},{"type":"codeVoice","code":"EnsemblesBox"},{"type":"text","text":") — Wraps the Box Swift SDK. Demonstrates how to bridge an ID-based API (where files are identified by numeric IDs, not paths) onto the path-based "},{"type":"codeVoice","code":"CloudFileSystem"},{"type":"text","text":" protocol using folder-walking and caching."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"S3CloudFileSystem"}]},{"text":" (in ","type":"text"},{"type":"codeVoice","code":"EnsemblesS3"},{"text":") — Wraps the AWS SDK for Swift. Shows how to simulate directory semantics on a flat key-value store using key prefixes and delimiters.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"style":"note","name":"Note","type":"aside","content":[{"inlineContent":[{"text":"","type":"text"},{"code":"EnsemblesBox","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"EnsemblesS3","type":"codeVoice"},{"text":" (along with ","type":"text"},{"code":"EnsemblesDropbox","type":"codeVoice"},{"type":"text","text":", "},{"type":"codeVoice","