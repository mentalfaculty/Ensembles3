{"sections":[],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Ensembles exchanges sync data through a "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem","isActive":true},{"type":"text","text":" — a protocol that abstracts file storage behind a simple path-based API. Any service that can store and retrieve files at paths can serve as a backend: cloud storage (S3, Google Cloud Storage), file servers (WebDAV, SFTP), databases, or even peer-to-peer connections with a local cache."}]},{"anchor":"The-CloudFileSystem-Protocol","type":"heading","text":"The CloudFileSystem Protocol","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The core protocol has 8 requirements organized into four groups:"}]},{"anchor":"Connection","type":"heading","text":"Connection","level":3},{"type":"codeListing","syntax":"swift","code":["public protocol CloudFileSystem: AnyObject, Sendable {","    var isConnected: Bool { get }","    func connect() async throws","    func fetchUserIdentity() async throws","        -> sending (any NSObjectProtocol & NSCoding & NSCopying)?","}"]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/isConnected"},{"type":"text","text":" — Return whether the backend is ready for operations."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/connect()"},{"type":"text","text":" — Establish a connection. Called before each attach or merge."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/fetchUserIdentity()"},{"type":"text","text":" — Return a token identifying the current user, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" if identity tracking is not supported. Ensembles uses this to detect account changes (e.g., signing out of iCloud)."}]}]}]},{"anchor":"File-Operations","type":"heading","text":"File Operations","level":3},{"type":"codeListing","syntax":"swift","code":["func fileExists(atPath path: String) async throws -> FileExistence","func createDirectory(atPath path: String) async throws","func contentsOfDirectory(atPath path: String) async throws -> [any CloudItem]","func removeItem(atPath path: String) async throws"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Paths are forward-slash separated, rooted at "},{"type":"codeVoice","code":"\/"},{"type":"text","text":". The ensemble creates a directory structure like "},{"type":"codeVoice","code":"\/MyEnsemble\/events\/"},{"type":"text","text":", "},{"type":"codeVoice","code":"\/MyEnsemble\/baselines\/"},{"type":"text","text":", etc."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Directory listings should return "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFile","isActive":true},{"type":"text","text":" or "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudDirectory","isActive":true},{"type":"text","text":" items with their "},{"type":"codeVoice","code":"path"},{"type":"text","text":" and "},{"type":"codeVoice","code":"name"},{"type":"text","text":" populated. Only list immediate children — do not recurse."}]},{"anchor":"File-Transfer","type":"heading","text":"File Transfer","level":3},{"type":"codeListing","syntax":"swift","code":["func uploadLocalFile(atPath localPath: String, toPath remotePath: String) async throws","func downloadFile(atPath remotePath: String, toLocalFile localPath: String) async throws"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Upload copies a local file to the remote path. Download copies a remote file to the local path. Both paths are absolute on their respective systems (local paths are filesystem paths; remote paths are within the cloud file system’s namespace)."}]},{"anchor":"A-Minimal-Example","type":"heading","text":"A Minimal Example","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Here is a skeleton implementation to illustrate the structure:"}]},{"type":"codeListing","syntax":"swift","code":["import Ensembles","","public final class MyCloudFileSystem: CloudFileSystem, @unchecked Sendable {","","    public var isConnected: Bool { true }","","    public func connect() async throws {","        \/\/ Authenticate or establish a session","    }","","    public func fetchUserIdentity() async throws","        -> sending (any NSObjectProtocol & NSCoding & NSCopying)? {","        \/\/ Return a user token, or nil","        return nil","    }","","    public func fileExists(atPath path: String) async throws -> FileExistence {","        \/\/ Check your storage and return the result","    }","","    public func createDirectory(atPath path: String) async throws {","        \/\/ Create a directory marker or equivalent","    }","","    public func contentsOfDirectory(atPath path: String) async throws","        -> [any CloudItem] {","        \/\/ List immediate children as CloudFile\/CloudDirectory items","    }","","    public func removeItem(atPath path: String) async throws {","        \/\/ Delete a file or directory (and its contents)","    }","","    public func uploadLocalFile(","        atPath localPath: String,","        toPath remotePath: String","    ) async throws {","        let data = try Data(contentsOf: URL(fileURLWithPath: localPath))","        \/\/ Store data at remotePath in your backend","    }","","    public func downloadFile(","        atPath remotePath: String,","        toLocalFile localPath: String","    ) async throws {","        \/\/ Retrieve data from remotePath in your backend","        let data: Data = \/\/ ...fetch from backend","        try data.write(to: URL(fileURLWithPath: localPath), options: .atomic)","    }","}"]},{"anchor":"Reference-Implementations","type":"heading","text":"Reference Implementations","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Study the built-in backends as starting points:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"MemoryCloudFileSystem"}],"type":"strong"},{"type":"text","text":" (in "},{"type":"codeVoice","code":"EnsemblesMemory"},{"type":"text","text":") — The simplest implementation. An actor that stores files in a dictionary. Good for understanding the protocol’s expectations."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"LocalCloudFileSystem"}],"type":"strong"},{"type":"text","text":" (in "},{"type":"codeVoice","code":"EnsemblesLocalFile"},{"type":"text","text":") — Uses "},{"type":"codeVoice","code":"FileManager"},{"type":"text","text":" to store files in a local directory. Shows how to map the protocol onto a real file system."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"CloudKitFileSystem"}],"type":"strong"},{"type":"text","text":" (in "},{"type":"codeVoice","code":"EnsemblesCloudKit"},{"type":"text","text":") — A production backend using CloudKit. Shows how to implement batch operations and setup hooks."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"PCloudCloudFileSystem"}],"type":"strong"},{"type":"text","text":" (in "},{"type":"codeVoice","code":"EnsemblesPCloud"},{"type":"text","text":") — A URLSession-based REST client with no SDK dependency. A good model for building backends against any REST API."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"BoxCloudFileSystem"}],"type":"strong"},{"type":"text","text":" (in "},{"type":"codeVoice","code":"EnsemblesBox"},{"type":"text","text":") — Wraps the Box Swift SDK. Demonstrates how to bridge an ID-based API (where files are identified by numeric IDs, not paths) onto the path-based "},{"type":"codeVoice","code":"CloudFileSystem"},{"type":"text","text":" protocol using folder-walking and caching."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"S3CloudFileSystem"}],"type":"strong"},{"type":"text","text":" (in "},{"type":"codeVoice","code":"EnsemblesS3"},{"type":"text","text":") — Wraps the AWS SDK for Swift. Shows how to simulate directory semantics on a flat key-value store using key prefixes and delimiters."}]}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"EnsemblesBox"},{"type":"text","text":" and "},{"type":"codeVoice","code":"EnsemblesS3"},{"type":"text","text":" (along with "},{"type":"codeVoice","code":"EnsemblesDropbox"},{"type":"text","text":", "},{"type":"codeVoice","code":"EnsemblesZip"},{"type":"text","text":", and "},{"type":"codeVoice","code":"EnsemblesMultipeer"},{"type":"text","text":") require an external SDK. With the source distribution, enabling the corresponding package trait resolves this automatically. With the binary distribution (XCFrameworks), you must add the external SDK as a separate package dependency — see the Available Backends table in the README for details."}]}],"type":"aside","name":"Note","style":"note"},{"anchor":"Optional-Batch-Operations","type":"heading","text":"Optional: Batch Operations","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"If your backend can handle multiple files in a single request (reducing round trips), adopt "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemBatchOperations","isActive":true},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["extension MyCloudFileSystem: CloudFileSystemBatchOperations {","    public var fileUploadMaximumBatchSize: Int { 20 }","    public var fileDownloadMaximumBatchSize: Int { 20 }","","    public func uploadLocalFiles(","        atPaths localPaths: [String],","        toPaths remotePaths: [String]","    ) async throws {","        \/\/ Upload multiple files in one request","    }","","    public func downloadFiles(","        atPaths remotePaths: [String],","        toLocalFiles localPaths: [String]","    ) async throws {","        \/\/ Download multiple files in one request","    }","","    public func removeItems(atPaths paths: [String]) async throws {","        \/\/ Delete multiple items in one request","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"fileUploadMaximumBatchSize"},{"type":"text","text":" and "},{"type":"codeVoice","code":"fileDownloadMaximumBatchSize"},{"type":"text","text":" properties control how many files Ensembles passes per batch call. Default is 10 if you don’t override them."}]},{"anchor":"Optional-Setup-Hooks","type":"heading","text":"Optional: Setup Hooks","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"For backends that need initialization, caching, or repair logic, adopt "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup","isActive":true},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["extension MyCloudFileSystem: CloudFileSystemSetup {","    public func performInitialPreparation() async throws {","        \/\/ One-time setup (e.g., create root directories)","    }","","    public func primeForActivity() async throws {","        \/\/ Called before each operation (e.g., refresh auth tokens,","        \/\/ cache directory listings)","    }","","    public func directoryExists(atPath path: String) async throws -> Bool {","        \/\/ Check directory existence","    }","","    public func repairEnsembleDirectory(atPath path: String) async throws {","        \/\/ Fix up issues like iCloud duplicates or stale locks","    }","}"]},{"anchor":"Threading-and-Sendable","type":"heading","text":"Threading and Sendable","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Cloud file systems must conform to "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":". If your implementation uses mutable state, you have several options:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"actor"},{"type":"text","text":" isolation (as "},{"type":"codeVoice","code":"MemoryCloudFileSystem"},{"type":"text","text":" does)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"@unchecked Sendable"},{"type":"text","text":" with explicit locking (as "},{"type":"codeVoice","code":"LocalCloudFileSystem"},{"type":"text","text":" does)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Make the type stateless, delegating state to a thread-safe service"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"All protocol methods are "},{"type":"codeVoice","code":"async throws"},{"type":"text","text":", so you can freely call async APIs in your implementation."}]}]}],"variants":[{"paths":["\/documentation\/ensembles\/customcloudbackends"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","seeAlsoSections":[{"title":"Cloud Backends","generated":true,"identifiers":["doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem","doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemBatchOperations","doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup"],"anchor":"Cloud-Backends"}],"metadata":{"title":"Custom Cloud Backends","roleHeading":"Article","modules":[{"name":"Ensembles"}],"role":"article"},"identifie