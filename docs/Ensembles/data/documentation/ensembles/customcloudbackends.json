{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Ensembles\/documentation\/Ensembles\/CustomCloudBackends"},"kind":"article","abstract":[{"text":"Implement the CloudFileSystem protocol to sync via any storage service.","type":"text"}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"title":"Custom Cloud Backends","modules":[{"name":"Ensembles"}],"roleHeading":"Article","role":"article"},"hierarchy":{"paths":[["doc:\/\/Ensembles\/documentation\/Ensembles"]]},"primaryContentSections":[{"content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Ensembles exchanges sync data through a "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem","type":"reference","isActive":true},{"type":"text","text":" — a protocol that abstracts file storage behind a simple path-based API. Any service that can store and retrieve files at paths can serve as a backend: cloud storage (S3, Google Cloud Storage), file servers (WebDAV, SFTP), databases, or even peer-to-peer connections with a local cache."}],"type":"paragraph"},{"anchor":"The-CloudFileSystem-Protocol","text":"The CloudFileSystem Protocol","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The core protocol has 8 requirements organized into four groups:"}],"type":"paragraph"},{"anchor":"Connection","text":"Connection","level":3,"type":"heading"},{"code":["public protocol CloudFileSystem: AnyObject, Sendable {","    var isConnected: Bool { get }","    func connect() async throws","    func fetchUserIdentity() async throws","        -> sending (any NSObjectProtocol & NSCoding & NSCopying)?","}"],"syntax":"swift","type":"codeListing"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/isConnected"},{"type":"text","text":" — Return whether the backend is ready for operations."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/connect()"},{"type":"text","text":" — Establish a connection. Called before each attach or merge."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/fetchUserIdentity()"},{"type":"text","text":" — Return a token identifying the current user, or "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" if identity tracking is not supported. Ensembles uses this to detect account changes (e.g., signing out of iCloud)."}]}]}]},{"anchor":"File-Operations","text":"File Operations","level":3,"type":"heading"},{"code":["func fileExists(atPath path: String) async throws -> FileExistence","func createDirectory(atPath path: String) async throws","func contentsOfDirectory(atPath path: String) async throws -> [any CloudItem]","func removeItem(atPath path: String) async throws"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Paths are forward-slash separated, rooted at "},{"type":"codeVoice","code":"\/"},{"type":"text","text":". The ensemble creates a directory structure like "},{"type":"codeVoice","code":"\/MyEnsemble\/events\/"},{"type":"text","text":", "},{"type":"codeVoice","code":"\/MyEnsemble\/baselines\/"},{"type":"text","text":", etc."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Directory listings should return "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFile","type":"reference","isActive":true},{"type":"text","text":" or "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudDirectory","type":"reference","isActive":true},{"type":"text","text":" items with their "},{"type":"codeVoice","code":"path"},{"type":"text","text":" and "},{"type":"codeVoice","code":"name"},{"type":"text","text":" populated. Only list immediate children — do not recurse."}],"type":"paragraph"},{"anchor":"File-Transfer","text":"File Transfer","level":3,"type":"heading"},{"code":["func uploadLocalFile(atPath localPath: String, toPath remotePath: String) async throws","func downloadFile(atPath remotePath: String, toLocalFile localPath: String) async throws"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Upload copies a local file to the remote path. Download copies a remote file to the local path. Both paths are absolute on their respective systems (local paths are filesystem paths; remote paths are within the cloud file system’s namespace)."}],"type":"paragraph"},{"anchor":"A-Minimal-Example","text":"A Minimal Example","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Here is a skeleton implementation to illustrate the structure:"}],"type":"paragraph"},{"code":["import Ensembles","","public final class MyCloudFileSystem: CloudFileSystem, @unchecked Sendable {","","    public var isConnected: Bool { true }","","    public func connect() async throws {","        \/\/ Authenticate or establish a session","    }","","    public func fetchUserIdentity() async throws","        -> sending (any NSObjectProtocol & NSCoding & NSCopying)? {","        \/\/ Return a user token, or nil","        return nil","    }","","    public func fileExists(atPath path: String) async throws -> FileExistence {","        \/\/ Check your storage and return the result","    }","","    public func createDirectory(atPath path: String) async throws {","        \/\/ Create a directory marker or equivalent","    }","","    public func contentsOfDirectory(atPath path: String) async throws","        -> [any CloudItem] {","        \/\/ List immediate children as CloudFile\/CloudDirectory items","    }","","    public func removeItem(atPath path: String) async throws {","        \/\/ Delete a file or directory (and its contents)","    }","","    public func uploadLocalFile(","        atPath localPath: String,","        toPath remotePath: String","    ) async throws {","        let data = try Data(contentsOf: URL(fileURLWithPath: localPath))","        \/\/ Store data at remotePath in your backend","    }","","    public func downloadFile(","        atPath remotePath: String,","        toLocalFile localPath: String","    ) async throws {","        \/\/ Retrieve data from remotePath in your backend","        let data: Data = \/\/ ...fetch from backend","        try data.write(to: URL(fileURLWithPath: localPath), options: .atomic)","    }","}"],"syntax":"swift","type":"codeListing"},{"anchor":"Reference-Implementations","text":"Reference Implementations","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Study the built-in backends as starting points:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"MemoryCloudFileSystem","type":"codeVoice"}]},{"type":"text","text":" (in "},{"code":"EnsemblesMemory","type":"codeVoice"},{"type":"text","text":") — The simplest implementation. An actor that stores files in a dictionary. Good for understanding the protocol’s expectations."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"LocalCloudFileSystem","type":"codeVoice"}]},{"type":"text","text":" (in "},{"code":"EnsemblesLocalFile","type":"codeVoice"},{"type":"text","text":") — Uses "},{"code":"FileManager","type":"codeVoice"},{"type":"text","text":" to store files in a local directory. Shows how to map the protocol onto a real file system."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"CloudKitFileSystem"}]},{"type":"text","text":" (in "},{"code":"EnsemblesCloudKit","type":"codeVoice"},{"type":"text","text":") — A production backend using CloudKit. Shows how to implement batch operations and setup hooks."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"PCloudCloudFileSystem"}]},{"type":"text","text":" (in "},{"type":"codeVoice","code":"EnsemblesPCloud"},{"type":"text","text":") — A URLSession-based REST client with no SDK dependency. A good model for building backends against any REST API."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"BoxCloudFileSystem"}]},{"type":"text","text":" (in "},{"type":"codeVoice","code":"EnsemblesBox"},{"type":"text","text":") — Wraps the Box Swift SDK. Demonstrates how to bridge an ID-based API (where files are identified by numeric IDs, not paths) onto the path-based "},{"type":"codeVoice","code":"CloudFileSystem"},{"type":"text","text":" protocol using folder-walking and caching."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"S3CloudFileSystem"}]},{"type":"text","text":" (in "},{"type":"codeVoice","code":"EnsemblesS3"},{"type":"text","text":") — Wraps the AWS SDK for Swift. Shows how to simulate directory semantics on a flat key-value store using key prefixes and delimiters."}]}]}]},{"style":"note","name":"Note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"code":"EnsemblesBox","type":"codeVoice"},{"type":"text","text":" and "},{"code":"EnsemblesS3","type":"codeVoice"},{"type":"text","text":" (along with "},{"code":"EnsemblesDropbox","type":"codeVoice"},{"type":"text","text":", "},{"code":"EnsemblesZip","type":"codeVoice"},{"type":"text","text":", and "},{"code":"EnsemblesMultipeer","type":"codeVoice"},{"type":"text","text":") require an external SDK. With the source distribution, enabling the corresponding package trait resolves this automatically. With the binary distribution (XCFrameworks), you must add the external SDK as a separate package dependency — see the Available Backends table in the README for details."}]}]},{"anchor":"Optional-Batch-Operations","text":"Optional: Batch Operations","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"If your backend can handle multiple files in a single request (reducing round trips), adopt "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemBatchOperations","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"code":["extension MyCloudFileSystem: CloudFileSystemBatchOperations {","    public var fileUploadMaximumBatchSize: Int { 20 }","    public var fileDownloadMaximumBatchSize: Int { 20 }","","    public func uploadLocalFiles(","        atPaths localPaths: [String],","        toPaths remotePaths: [String]","    ) async throws {","        \/\/ Upload multiple files in one request","    }","","    public func downloadFiles(","        atPaths remotePaths: [String],","        toLocalFiles localPaths: [String]","    ) async throws {","        \/\/ Download multiple files in one request","    }","","    public func removeItems(atPaths paths: [String]) async throws {","        \/\/ Delete multiple items in one request","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"fileUploadMaximumBatchSize"},{"type":"text","text":" and "},{"type":"codeVoice","code":"fileDownloadMaximumBatchSize"},{"type":"text","text":" properties control how many files Ensembles passes per batch call. Default is 10 if you don’t override them."}],"type":"paragraph"},{"anchor":"Optional-Setup-Hooks","text":"Optional: Setup Hooks","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"For backends that need initialization, caching, or repair logic, adopt "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup","type":"reference","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"code":["extension MyCloudFileSystem: CloudFileSystemSetup {","    public func performInitialPreparation() async throws {","        \/\/ One-time setup (e.g., create root directories)","    }","","    public func primeForActivity() async throws {","        \/\/ Called before each operation (e.g., refresh auth tokens,","        \/\/ cache directory listings)","    }","","    public func directoryExists(atPath path: String) async throws -> Bool {","        \/\/ Check directory existence","    }","","    public func repairEnsembleDirectory(atPath path: String) async throws {","        \/\/ Fix up issues like iCloud duplicates or stale locks","    }","}"],"syntax":"swift","type":"codeListing"},{"anchor":"Threading-and-Sendable","text":"Threading and Sendable","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Cloud file systems must conform to "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":". If your implementation uses mutable state, you have several options:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"actor"},{"type":"text","text":" isolation (as "},{"type":"codeVoice","code":"MemoryCloudFileSystem"},{"type":"text","text":" does)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"@unchecked Sendable"},{"type":"text","text":" with explicit locking (as "},{"type":"codeVoice","code":"LocalCloudFileSystem"},{"type":"text","text":" does)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Make the type stateless, delegating state to a thread-safe service"}]}]}]},{"inlineContent":[{"type":"text","text":"All protocol methods are "},{"type":"codeVoice","code":"async throws"},{"type":"text","text":", so you can freely call async APIs in your implementation."}],"type":"paragraph"}],"kind":"content"}],"seeAlsoSections":[{"identifiers":["doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem","doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemBatchOperations","doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup"],"anchor":"Cloud-Backends","generated":true,"title":"Cloud Backends"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ensembles\/customcloudbackends"]}],"references":{"doc://Ensembles/documentation/Ensembles/CloudFileSystemSetup":{"navigatorTitle":[{"kind":"identifier","text":"CloudFileSystemSetup"}],"abstract":[{"text":"Optional setup and maintenance operations for cloud file systems.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"CloudFileSystemSetup"}],"type":"topic","kind":"symbol","title":"CloudFileSystemSetup","url":"\/documentation\/ensembles\/cloudfilesystemsetup","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup"},"doc://Ensembles/documentation/Ensembles/CloudFileSystem/connect()":{"type":"topic","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/connect()","url":"\/documentation\/ensembles\/cloudfilesystem\/connect()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"connect","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}],"role":"symbol","kind":"symbol","abstract":[{"text":"Attempts to connect to the cloud backend.","type":"text"}],"title":"connect()","required":true},"doc://Ensembles/documentation/Ensembles":{"role":"collection","abstract":[{"type":"text","text":"Sync Core Data and SwiftData stores across devices using event sourcing."}],"url":"\/documentation\/ensembles","kind":"symbol","title":"Ensembles","type":"topic","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles"},"doc://Ensembles/documentation/Ensembles/CloudFileSystem/isConnected":{"type":"topic","identifier":"doc:\/\/Ensembles\/docu