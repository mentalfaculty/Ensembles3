{"metadata":{"role":"article","title":"Custom Cloud Backends","modules":[{"name":"Ensembles"}],"roleHeading":"Article"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ensembles\/customcloudbackends"]}],"abstract":[{"text":"Implement the CloudFileSystem protocol to sync via any storage service.","type":"text"}],"kind":"article","schemaVersion":{"patch":0,"major":0,"minor":3},"seeAlsoSections":[{"identifiers":["doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem","doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemBatchOperations","doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup"],"anchor":"Cloud-Backends","title":"Cloud Backends","generated":true}],"hierarchy":{"paths":[["doc:\/\/Ensembles\/documentation\/Ensembles"]]},"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"inlineContent":[{"type":"text","text":"Ensembles exchanges sync data through a "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem","type":"reference","isActive":true},{"type":"text","text":" — a protocol that abstracts file storage behind a simple path-based API. Any service that can store and retrieve files at paths can serve as a backend: cloud storage (S3, Google Cloud Storage), file servers (WebDAV, SFTP), databases, or even peer-to-peer connections with a local cache."}],"type":"paragraph"},{"text":"The CloudFileSystem Protocol","type":"heading","level":2,"anchor":"The-CloudFileSystem-Protocol"},{"inlineContent":[{"type":"text","text":"The core protocol has 8 requirements organized into four groups:"}],"type":"paragraph"},{"text":"Connection","type":"heading","level":3,"anchor":"Connection"},{"code":["public protocol CloudFileSystem: AnyObject, Sendable {","    var isConnected: Bool { get }","    func connect() async throws","    func fetchUserIdentity() async throws","        -> sending (any NSObjectProtocol & NSCoding & NSCopying)?","}"],"syntax":"swift","type":"codeListing"},{"items":[{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/isConnected","type":"reference"},{"type":"text","text":" — Return whether the backend is ready for operations."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/connect()","type":"reference"},{"type":"text","text":" — Establish a connection. Called before each attach or merge."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/fetchUserIdentity()","type":"reference"},{"type":"text","text":" — Return a token identifying the current user, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" if identity tracking is not supported. Ensembles uses this to detect account changes (e.g., signing out of iCloud)."}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"File Operations","type":"heading","level":3,"anchor":"File-Operations"},{"code":["func fileExists(atPath path: String) async throws -> FileExistence","func createDirectory(atPath path: String) async throws","func contentsOfDirectory(atPath path: String) async throws -> [any CloudItem]","func removeItem(atPath path: String) async throws"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Paths are forward-slash separated, rooted at "},{"type":"codeVoice","code":"\/"},{"type":"text","text":". The ensemble creates a directory structure like "},{"type":"codeVoice","code":"\/MyEnsemble\/events\/"},{"type":"text","text":", "},{"type":"codeVoice","code":"\/MyEnsemble\/baselines\/"},{"type":"text","text":", etc."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Directory listings should return "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFile","type":"reference","isActive":true},{"type":"text","text":" or "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudDirectory","type":"reference","isActive":true},{"type":"text","text":" items with their "},{"type":"codeVoice","code":"path"},{"type":"text","text":" and "},{"type":"codeVoice","code":"name"},{"type":"text","text":" populated. Only list immediate children — do not recurse."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"There is one optional existence check, "},{"type":"codeVoice","code":"confirmFileExists(atPath:)"},{"type":"text","text":", with a default implementation that calls "},{"type":"codeVoice","code":"fileExists(atPath:)"},{"type":"text","text":". The framework uses it for checks whose consequences are drastic, such as the per-sync store-registration check that detects a reset cloud. If your backend answers "},{"type":"codeVoice","code":"fileExists"},{"type":"text","text":" from a local cache of remote state, implement "},{"type":"codeVoice","code":"confirmFileExists"},{"type":"text","text":" to consult the server directly; if "},{"type":"codeVoice","code":"fileExists"},{"type":"text","text":" is already authoritative, the default is correct. Wrapper backends that delegate to another file system must forward "},{"type":"codeVoice","code":"confirmFileExists"},{"type":"text","text":" to the wrapped backend’s "},{"type":"codeVoice","code":"confirmFileExists"},{"type":"text","text":" — the default cannot see through a wrapper, and would quietly downgrade the confirmation to the wrapped backend’s cached check."}],"type":"paragraph"},{"text":"File Transfer","type":"heading","level":3,"anchor":"File-Transfer"},{"code":["func uploadLocalFile(atPath localPath: String, toPath remotePath: String) async throws","func downloadFile(atPath remotePath: String, toLocalFile localPath: String) async throws"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Upload copies a local file to the remote path. Download copies a remote file to the local path. Both paths are absolute on their respective systems (local paths are filesystem paths; remote paths are within the cloud file system’s namespace)."}],"type":"paragraph"},{"text":"A Minimal Example","type":"heading","level":2,"anchor":"A-Minimal-Example"},{"inlineContent":[{"type":"text","text":"Here is a skeleton implementation to illustrate the structure:"}],"type":"paragraph"},{"code":["import Ensembles","","public final class MyCloudFileSystem: CloudFileSystem, @unchecked Sendable {","","    public var isConnected: Bool { true }","","    public func connect() async throws {","        \/\/ Authenticate or establish a session","    }","","    public func fetchUserIdentity() async throws","        -> sending (any NSObjectProtocol & NSCoding & NSCopying)? {","        \/\/ Return a user token, or nil","        return nil","    }","","    public func fileExists(atPath path: String) async throws -> FileExistence {","        \/\/ Check your storage and return the result","    }","","    public func createDirectory(atPath path: String) async throws {","        \/\/ Create a directory marker or equivalent","    }","","    public func contentsOfDirectory(atPath path: String) async throws","        -> [any CloudItem] {","        \/\/ List immediate children as CloudFile\/CloudDirectory items","    }","","    public func removeItem(atPath path: String) async throws {","        \/\/ Delete a file or directory (and its contents)","    }","","    public func uploadLocalFile(","        atPath localPath: String,","        toPath remotePath: String","    ) async throws {","        let data = try Data(contentsOf: URL(fileURLWithPath: localPath))","        \/\/ Store data at remotePath in your backend","    }","","    public func downloadFile(","        atPath remotePath: String,","        toLocalFile localPath: String","    ) async throws {","        \/\/ Retrieve data from remotePath in your backend","        let data: Data = \/\/ ...fetch from backend","        try data.write(to: URL(fileURLWithPath: localPath), options: .atomic)","    }","}"],"type":"codeListing","syntax":"swift"},{"text":"Reference Implementations","type":"heading","level":2,"anchor":"Reference-Implementations"},{"inlineContent":[{"text":"Study the built-in backends as starting points:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"MemoryCloudFileSystem"}],"type":"strong"},{"text":" (in ","type":"text"},{"type":"codeVoice","code":"EnsemblesMemory"},{"text":") — The simplest implementation. An actor that stores files in a dictionary. Good for understanding the protocol’s expectations.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"LocalCloudFileSystem"}],"type":"strong"},{"text":" (in ","type":"text"},{"type":"codeVoice","code":"EnsemblesLocalFile"},{"text":") — Uses ","type":"text"},{"type":"codeVoice","code":"FileManager"},{"text":" to store files in a local directory. Shows how to map the protocol onto a real file system.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"CloudKitFileSystem"}]},{"type":"text","text":" (in "},{"type":"codeVoice","code":"EnsemblesCloudKit"},{"type":"text","text":") — A production backend using CloudKit. Shows how to implement batch operations and setup hooks."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"PCloudCloudFileSystem"}]},{"type":"text","text":" (in "},{"type":"codeVoice","code":"EnsemblesPCloud"},{"type":"text","text":") — A URLSession-based REST client with no SDK dependency. A good model for building backends against any REST API."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"BoxCloudFileSystem"}]},{"type":"text","text":" (in "},{"type":"codeVoice","code":"EnsemblesBox"},{"type":"text","text":") — Wraps the Box Swift SDK. Demonstrates how to bridge an ID-based API (where files are identified by numeric IDs, not paths) onto the path-based "},{"type":"codeVoice","code":"CloudFileSystem"},{"type":"text","text":" protocol using folder-walking and caching."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"S3CloudFileSystem"}]},{"type":"text","text":" (in "},{"type":"codeVoice","code":"EnsemblesS3"},{"type":"text","text":") — Wraps the AWS SDK for Swift. Shows how to simulate directory semantics on a flat key-value store using key prefixes and delimiters."}],"type":"paragraph"}]}],"type":"unorderedList"},{"content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"EnsemblesBox"},{"type":"text","text":" and "},{"type":"codeVoice","code":"EnsemblesS3"},{"type":"text","text":" (along with "},{"type":"codeVoice","code":"EnsemblesDropbox"},{"type":"text","text":", "},{"type":"codeVoice","code":"EnsemblesZip"},{"type":"text","text":", and "},{"type":"codeVoice","code":"EnsemblesMultipeer"},{"type":"text","text":") require an external SDK. With the source distribution, enabling the corresponding package trait resolves this automatically. With the binary distribution (XCFrameworks), you must add the external SDK as a separate package dependency — see the Available Backends table in the README for details."}],"type":"paragraph"}],"name":"Note","type":"aside","style":"note"},{"text":"Optional: Batch Operations","type":"heading","level":2,"anchor":"Optional-Batch-Operations"},{"inlineContent":[{"text":"If your backend can handle multiple files in a single request (reducing round trips), adopt ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemBatchOperations","type":"reference"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["extension MyCloudFileSystem: CloudFileSystemBatchOperations {","    public var fileUploadMaximumBatchSize: Int { 20 }","    public var fileDownloadMaximumBatchSize: Int { 20 }","","    public func uploadLocalFiles(","        atPaths localPaths: [String],","        toPaths remotePaths: [String]","    ) async throws {","        \/\/ Upload multiple files in one request","    }","","    public func downloadFiles(","        atPaths remotePaths: [String],","        toLocalFiles localPaths: [String]","    ) async throws {","        \/\/ Download multiple files in one request","    }","","    public func removeItems(atPaths paths: [String]) async throws {","        \/\/ Delete multiple items in one request","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"fileUploadMaximumBatchSize","type":"codeVoice"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"fileDownloadMaximumBatchSize"},{"text":" properties control how many files Ensembles passes per batch call. Default is 10 if you don’t override them.","type":"text"}],"type":"paragraph"},{"text":"Optional: Setup Hooks","type":"heading","level":2,"anchor":"Optional-Setup-Hooks"},{"inlineContent":[{"text":"For backends that need initialization, caching, or repair logic, adopt ","type":"text"},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup","type":"reference","isActive":true},{"text":":","type":"text"}],"type":"paragraph"},{"code":["extension MyCloudFileSystem: CloudFileSystemSetup {","    public func performInitialPreparation() async throws {","        \/\/ One-time setup (e.g., create root directories)","    }","","    public func primeForActivity() async throws {","        \/\/ Called before each operation (e.g., refresh auth tokens,","        \/\/ cache directory listings)","    }","","    public func directoryExists(atPath path: String) async throws -> Bool {","        \/\/ Check directory existence","    }","","    public func repairEnsembleDirectory(atPath path: String) async throws {","        \/\/ Fix up issues like iCloud duplicates or stale locks","    }","","    public func setLocalStoreDirectory(_ path: String?, discardingExistingCache: Bool) {","        \/\/ Where to keep any cache of remote state (see below).","        \/\/ Has a default no-op implementation; only implement it if you cache.","    }","}"],"syntax":"swift","type":"codeListing"},{"text":"Caching Remote State","type":"heading","level":2,"anchor":"Caching-Remote-State"},{"inlineContent":[{"text":"Backends that fetch changes incrementally — keeping a cursor, change token, or cached","type":"text"},{"text":" ","type":"text"},{"text":"listing between launches — must store that state ","type":"text"},{"inlineContent":[{"text":"inside the event store’s directory","type":"text"}],"type":"strong"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"supplied by ","type":"text"},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup\/setLocalStoreDirectory(_:discardingExistingCache:)","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The reason is lifetime. A cache describes one particular event store at one point in its","type":"text"},{"text":" ","type":"text"},{"text":"history. Put it anywhere with an independent lifetime — the system caches directory is","type":"text"},{"text":" ","type":"text"},{"text":"the tempting choice — and it can outlive the store it describes. Deleting the app,","type":"text"},{"text":" ","type":"text"},{"text":"removing the local store, or resetting the cloud data then leaves the cache behind, and","type":"text"},{"text":" ","type":"text"},{"text":"the next launch resumes an incremental fetch from a cursor that no longer matches the","type":"text"},{"text":" ","type":"text"},{"text":"cloud. The server answers truthfully that nothing has changed since that cursor, so","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"files that predate it are never mentioned again. The device ends up with a silently"},{"type":"text","text":" "},{"type":"text","text":"partial view of the cloud and no error to report, which is far harder to diagnose than"},{"type":"text","text":" "},{"type":"text","text":"an outright failure."}],"type":"paragraph"},{"inlineContent":[{"text":"Keeping the cache in the event store directory ties the two together: removing the store","type":"text"},{"text":" ","type":"text"},{"text":"removes the cache, so a rebuilt store always starts from a full fetch.","type":"text"}],"type":"paragraph"},{"code":["public func setLocalStoreDirectory(_ path: String?, discardingExistingCache: Bool) {","    localStoreDirectory = path","    inMemoryCache = nil          \/\/ never carry state across stores","    guard path != nil else { return }","","    if discardingExistingCache {","        deleteCacheFromDisk()    \/\/ the store is being rebuilt: start clean","        return","    }","    loadCacheFromDisk()","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Three details matter. The method is called before priming whenever an ensemble knows its"},{"text":" ","type":"text"},{"text":"store, and it is ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}],"type":"emphasis"},{"text":" called for ensemble-independent operations such as","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/retrieveEnsembleIdentifiers(from:)","type":"reference","isActive":true},{"text":" — so tolerate priming without a","type":"text"},{"text":" ","type":"text"},{"text":"directory by simply not caching. When ","type":"text"},{"type":"codeVoice","code":"discardingExistingCache"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" the store is","type":"text"},{"text":" ","type":"text"},{"text":"being rebuilt, so delete any cache you find rather than loading it; do the deletion","type":"text"},{"text":" ","type":"text"},{"text":"yourself rather than assuming the directory is empty. And never recreate the directory in","type":"text"},{"text":" ","type":"text"},{"text":"order to write the cache: if it is gone, the store is gone, and the cache must go with","type":"text"},{"text":" ","type":"text"},{"text":"it.","type":"text"}],"type":"paragraph"},{"text":"Threading and Sendable","type":"heading","level":2,"anchor":"Threading-and-Sendable"},{"inlineContent":[{"type":"text","text":"Cloud file systems must conform to "},{"type":"codeVoice","code":"Sendable"},{"text":". If your implementation uses mutable state, you have several options:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"actor"},{"text":" isolation (as ","type":"text"},{"type":"codeVoice","code":"MemoryCloudFileSystem"},{"text":" does)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"@unchecked Sendable"},{"text":" with explicit locking (as ","type":"text"},{"type":"codeVoice","code":"LocalCloudFileSystem"},{"text":" does)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Make the type stateless, delegating state to a thread-safe service","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"All protocol methods are "},{"type":"codeVoice","code":"async throws"},{"type":"text","text":", so you can freely call async APIs in your implementation."}],"type":"paragraph"}],"kind":"content"}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Ensembles\/documentation\/Ensembles\/CustomCloudBackends"},"references":{"doc://Ensembles/documentation/Ensembles/CloudFileSystem/isConnected":{"url":"\/documentation\/ensembles\/cloudfilesystem\/isconnected","title":"isConnected","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isConnected","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"required":true,"type":"topic","kind":"symbol","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/isConnected","abstract":[{"type":"text","text":"Whether the file system is connected and ready for file transactions."}]},"doc://Ensembles/documentation/Ensembles/CloudFile":{"type":"topic","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFile","abstract":[{"type":"text","text":"Represents a file in a cloud file system."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CloudFile"}],"kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"CloudFile"}],"url":"\/documentation\/ensembles\/cloudfile","title":"CloudFile"},"doc://Ensembles/documentation/Ensembles/CloudFileSystemSetup":{"title":"CloudFileSystemSetup","url":"\/documentation\/ensembles\/cloudfilesystemsetup","abstract":[{"text":"Optional setup and maintenance operations for cloud file systems.","type":"text"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CloudFileSystemSetup","kind":"identifier"}],"kind":"symbol","role":"symbol","navigatorTitle":[{"text":"CloudFileSystemSetup","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup"},"doc://Ensembles/documentation/Ensembles/CloudDirectory":{"type":"topic","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudDirectory","abstract":[{"type":"text","text":"Represents a directory in a cloud file system."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CloudDirectory"}],"kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"CloudDirectory"}],"url":"\/documentation\/ensembles\/clouddirectory","title":"CloudDirectory"},"doc://Ensembles/documentation/Ensembles/CloudFileSystem/connect()":{"url":"\/documentation\/ensembles\/cloudfilesystem\/connect()","title":"connect()","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"connect","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}],"required":true,"type":"topic","kind":"symbol","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/connect()","abstract":[{"type":"text","text":"Attempts to connect to the cloud backend."}]},"doc://Ensembles/documentation/Ensembles/CloudFileSystem/fetchUserIdentity()":{"url":"\/documentation\/ensembles\/cloudfilesystem\/fetchuseridentity()","title":"fetchUserIdentity()","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"fetchUserIdentity","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> sending (","kind":"text"},{"text":"any","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"c:objc(pl)NSObject","text":"NSObjectProtocol","kind":"typeIdentifier"},{"text":" & ","kind":"text"},{"preciseIdentifier":"c:objc(pl)NSCoding","text":"NSCoding","kind":"typeIdentifier"},{"text":" & ","kind":"text"},{"preciseIdentifier":"c:objc(pl)NSCopying","text":"NSCopying","kind":"typeIdentifier"},{"text":")?","kind":"text"}],"required":true,"type":"topic","kind":"symbol","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/fetchUserIdentity()","abstract":[{"type":"text","text":"Fetches a token representing the current user of the cloud file system."},{"type":"text","text":" "},{"type":"text","text":"Often this will be the user or login name."}]},"doc://Ensembles/documentation/Ensembles/CloudFileSystemBatchOperations":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"CloudFileSystemBatchOperations"}],"navigatorTitle":[{"kind":"identifier","text":"CloudFileSystemBatchOperations"}],"url":"\/documentation\/ensembles\/cloudfilesystembatchoperations","kind":"symbol","role":"symbol","type":"topic","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemBatchOperations","abstract":[{"type":"text","text":"Optional batch and setup operations for cloud file systems."}],"title":"CloudFileSystemBatchOperations"},"doc://Ensembles/documentation/Ensembles/CloudFileSystemSetup/setLocalStoreDirectory(_:discardingExistingCache:)":{"title":"setLocalStoreDirectory(_:discardingExistingCache:)","url":"\/documentation\/ensembles\/cloudfilesystemsetup\/setlocalstoredirectory(_:discardingexistingcache:)","abstract":[{"text":"Tells the file system which local directory belongs to the event store it is serving.","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"setLocalStoreDirectory","kind":"identifier"},{"text":"(","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?, ","kind":"text"},{"text":"discardingExistingCache","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":")","kind":"text"}],"kind":"symbol","role":"symbol","required":true,"defaultImplementations":1,"type":"topic","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup\/setLocalStoreDirectory(_:discardingExistingCache:)"},"doc://Ensembles/documentation/Ensembles/CloudFileSystem":{"kind":"symbol","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CloudFileSystem","kind":"identifier"}],"role":"symbol","url":"\/documentation\/ensembles\/cloudfilesystem","navigatorTitle":[{"text":"CloudFileSystem","kind":"identifier"}],"title":"CloudFileSystem","type":"topic","abstract":[{"type":"text","text":"A cloud file system facilitates data transfer between devices."}]},"doc://Ensembles/documentation/Ensembles":{"kind":"symbol","abstract":[{"text":"Sync Core Data and SwiftData stores across devices using event sourcing.","type":"text"}],"role":"collection","url":"\/documentation\/ensembles","type":"topic","title":"Ensembles","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles"},"doc://Ensembles/documentation/Ensembles/CoreDataEnsemble/retrieveEnsembleIdentifiers(from:)":{"title":"retrieveEnsembleIdentifiers(from:)","url":"\/documentation\/ensembles\/coredataensemble\/retrieveensembleidentifiers(from:)","abstract":[{"text":"Queries a cloud file system for the identifiers of the ensembles it contains.","type":"text"}],"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"retrieveEnsembleIdentifiers","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"any","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CloudFileSystem","kind":"typeIdentifier","preciseIdentifier":"s:9Ensembles15CloudFileSystemP"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> [","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"]","kind":"text"}],"kind":"symbol","role":"symbol","type":"topic","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/retrieveEnsembleIdentifiers(from:)"}}}