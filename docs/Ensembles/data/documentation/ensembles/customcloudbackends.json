{"sections":[],"identifier":{"url":"doc:\/\/Ensembles\/documentation\/Ensembles\/CustomCloudBackends","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Ensembles\/documentation\/Ensembles"]]},"seeAlsoSections":[{"anchor":"Cloud-Backends","generated":true,"title":"Cloud Backends","identifiers":["doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem","doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemBatchOperations","doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"article","abstract":[{"text":"Implement the CloudFileSystem protocol to sync via any storage service.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"inlineContent":[{"text":"Ensembles exchanges sync data through a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem","type":"reference"},{"text":" — a protocol that abstracts file storage behind a simple path-based API. Any service that can store and retrieve files at paths can serve as a backend: cloud storage (S3, Google Cloud Storage), file servers (WebDAV, SFTP), databases, or even peer-to-peer connections with a local cache.","type":"text"}],"type":"paragraph"},{"text":"The CloudFileSystem Protocol","type":"heading","level":2,"anchor":"The-CloudFileSystem-Protocol"},{"inlineContent":[{"text":"The core protocol has 8 requirements organized into four groups:","type":"text"}],"type":"paragraph"},{"text":"Connection","type":"heading","level":3,"anchor":"Connection"},{"code":["public protocol CloudFileSystem: AnyObject, Sendable {","    var isConnected: Bool { get }","    func connect() async throws","    func fetchUserIdentity() async throws","        -> sending (any NSObjectProtocol & NSCoding & NSCopying)?","}"],"syntax":"swift","type":"codeListing"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/isConnected"},{"text":" — Return whether the backend is ready for operations.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/connect()"},{"text":" — Establish a connection. Called before each attach or merge.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/fetchUserIdentity()"},{"text":" — Return a token identifying the current user, or ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" if identity tracking is not supported. Ensembles uses this to detect account changes (e.g., signing out of iCloud).","type":"text"}]}]}],"type":"unorderedList"},{"text":"File Operations","type":"heading","level":3,"anchor":"File-Operations"},{"code":["func fileExists(atPath path: String) async throws -> FileExistence","func createDirectory(atPath path: String) async throws","func contentsOfDirectory(atPath path: String) async throws -> [any CloudItem]","func removeItem(atPath path: String) async throws"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Paths are forward-slash separated, rooted at ","type":"text"},{"code":"\/","type":"codeVoice"},{"text":". The ensemble creates a directory structure like ","type":"text"},{"code":"\/MyEnsemble\/events\/","type":"codeVoice"},{"text":", ","type":"text"},{"code":"\/MyEnsemble\/baselines\/","type":"codeVoice"},{"text":", etc.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Directory listings should return ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFile","type":"reference"},{"text":" or ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudDirectory","type":"reference"},{"text":" items with their ","type":"text"},{"code":"path","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"name","type":"codeVoice"},{"text":" populated. Only list immediate children — do not recurse.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"There is one optional existence check, ","type":"text"},{"code":"confirmFileExists(atPath:)","type":"codeVoice"},{"text":", with a default implementation that calls ","type":"text"},{"code":"fileExists(atPath:)","type":"codeVoice"},{"text":". The framework uses it for checks whose consequences are drastic, such as the per-sync store-registration check that detects a reset cloud. If your backend answers ","type":"text"},{"code":"fileExists","type":"codeVoice"},{"text":" from a local cache of remote state, implement ","type":"text"},{"code":"confirmFileExists","type":"codeVoice"},{"text":" to consult the server directly; if ","type":"text"},{"code":"fileExists","type":"codeVoice"},{"text":" is already authoritative, the default is correct. Wrapper backends that delegate to another file system must forward ","type":"text"},{"code":"confirmFileExists","type":"codeVoice"},{"text":" to the wrapped backend’s ","type":"text"},{"code":"confirmFileExists","type":"codeVoice"},{"text":" — the default cannot see through a wrapper, and would quietly downgrade the confirmation to the wrapped backend’s cached check.","type":"text"}],"type":"paragraph"},{"text":"File Transfer","type":"heading","level":3,"anchor":"File-Transfer"},{"code":["func uploadLocalFile(atPath localPath: String, toPath remotePath: String) async throws","func downloadFile(atPath remotePath: String, toLocalFile localPath: String) async throws"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Upload copies a local file to the remote path. Download copies a remote file to the local path. Both paths are absolute on their respective systems (local paths are filesystem paths; remote paths are within the cloud file system’s namespace).","type":"text"}],"type":"paragraph"},{"text":"A Minimal Example","type":"heading","level":2,"anchor":"A-Minimal-Example"},{"inlineContent":[{"text":"Here is a skeleton implementation to illustrate the structure:","type":"text"}],"type":"paragraph"},{"code":["import Ensembles","","public final class MyCloudFileSystem: CloudFileSystem, @unchecked Sendable {","","    public var isConnected: Bool { true }","","    public func connect() async throws {","        \/\/ Authenticate or establish a session","    }","","    public func fetchUserIdentity() async throws","        -> sending (any NSObjectProtocol & NSCoding & NSCopying)? {","        \/\/ Return a user token, or nil","        return nil","    }","","    public func fileExists(atPath path: String) async throws -> FileExistence {","        \/\/ Check your storage and return the result","    }","","    public func createDirectory(atPath path: String) async throws {","        \/\/ Create a directory marker or equivalent","    }","","    public func contentsOfDirectory(atPath path: String) async throws","        -> [any CloudItem] {","        \/\/ List immediate children as CloudFile\/CloudDirectory items","    }","","    public func removeItem(atPath path: String) async throws {","        \/\/ Delete a file or directory (and its contents)","    }","","    public func uploadLocalFile(","        atPath localPath: String,","        toPath remotePath: String","    ) async throws {","        let data = try Data(contentsOf: URL(fileURLWithPath: localPath))","        \/\/ Store data at remotePath in your backend","    }","","    public func downloadFile(","        atPath remotePath: String,","        toLocalFile localPath: String","    ) async throws {","        \/\/ Retrieve data from remotePath in your backend","        let data: Data = \/\/ ...fetch from backend","        try data.write(to: URL(fileURLWithPath: localPath), options: .atomic)","    }","}"],"syntax":"swift","type":"codeListing"},{"text":"Reference Implementations","type":"heading","level":2,"anchor":"Reference-Implementations"},{"inlineContent":[{"type":"text","text":"Study the built-in backends as starting points:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"code":"MemoryCloudFileSystem","type":"codeVoice"}],"type":"strong"},{"text":" (in ","type":"text"},{"code":"EnsemblesMemory","type":"codeVoice"},{"text":") — The simplest implementation. An actor that stores files in a dictionary. Good for understanding the protocol’s expectations.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"LocalCloudFileSystem"}],"type":"strong"},{"text":" (in ","type":"text"},{"code":"EnsemblesLocalFile","type":"codeVoice"},{"text":") — Uses ","type":"text"},{"code":"FileManager","type":"codeVoice"},{"text":" to store files in a local directory. Shows how to map the protocol onto a real file system.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":"CloudKitFileSystem","type":"codeVoice"}],"type":"strong"},{"text":" (in ","type":"text"},{"code":"EnsemblesCloudKit","type":"codeVoice"},{"text":") — A production backend using CloudKit. Shows how to implement batch operations and setup hooks.","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"PCloudCloudFileSystem"}],"type":"strong"},{"text":" (in ","type":"text"},{"code":"EnsemblesPCloud","type":"codeVoice"},{"text":") — A URLSession-based REST client with no SDK dependency. A good model for building backends against any REST API.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":"BoxCloudFileSystem","type":"codeVoice"}],"type":"strong"},{"text":" (in ","type":"text"},{"code":"EnsemblesBox","type":"codeVoice"},{"text":") — Wraps the Box Swift SDK. Demonstrates how to bridge an ID-based API (where files are identified by numeric IDs, not paths) onto the path-based ","type":"text"},{"code":"CloudFileSystem","type":"codeVoice"},{"text":" protocol using folder-walking and caching.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"S3CloudFileSystem"}]},{"text":" (in ","type":"text"},{"type":"codeVoice","code":"EnsemblesS3"},{"text":") — Wraps the AWS SDK for Swift. Shows how to simulate directory semantics on a flat key-value store using key prefixes and delimiters.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"name":"Note","style":"note","content":[{"inlineContent":[{"text":"","type":"text"},{"code":"EnsemblesBox","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"EnsemblesS3","type":"codeVoice"},{"text":" (along with ","type":"text"},{"code":"EnsemblesDropbox","type":"codeVoice"},{"text":", ","type":"text"},{"code":"EnsemblesZip","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"EnsemblesMultipeer","type":"codeVoice"},{"text":") require an external SDK. With the source distribution, enabling the corresponding package trait resolves this automatically. With the binary distribution (XCFrameworks), you must add the external SDK as a separate package dependency — see the Available Backends table in the README for details.","type":"text"}],"type":"paragraph"}],"type":"aside"},{"level":2,"text":"Optional: Batch Operations","anchor":"Optional-Batch-Operations","type":"heading"},{"inlineContent":[{"text":"If your backend can handle multiple files in a single request (reducing round trips), adopt ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemBatchOperations"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["extension MyCloudFileSystem: CloudFileSystemBatchOperations {","    public var fileUploadMaximumBatchSize: Int { 20 }","    public var fileDownloadMaximumBatchSize: Int { 20 }","","    public func uploadLocalFiles(","        atPaths localPaths: [String],","        toPaths remotePaths: [String]","    ) async throws {","        \/\/ Upload multiple files in one request","    }","","    public func downloadFiles(","        atPaths remotePaths: [String],","        toLocalFiles localPaths: [String]","    ) async throws {","        \/\/ Download multiple files in one request","    }","","    public func removeItems(atPaths paths: [String]) async throws {","        \/\/ Delete multiple items in one request","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"fileUploadMaximumBatchSize","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"fileDownloadMaximumBatchSize","type":"codeVoice"},{"text":" properties control how many files Ensembles passes per batch call. Default is 10 if you don’t override them.","type":"text"}],"type":"paragraph"},{"text":"Optional: Setup Hooks","level":2,"anchor":"Optional-Setup-Hooks","type":"heading"},{"inlineContent":[{"text":"For backends that need initialization, caching, or repair logic, adopt ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup","type":"reference"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["extension MyCloudFileSystem: CloudFileSystemSetup {","    public func performInitialPreparation() async throws {","        \/\/ One-time setup (e.g., create root directories)","    }","","    public func primeForActivity() async throws {","        \/\/ Called before each operation (e.g., refresh auth tokens,","        \/\/ cache directory listings)","    }","","    public func directoryExists(atPath path: String) async throws -> Bool {","        \/\/ Check directory existence","    }","","    public func repairEnsembleDirectory(atPath path: String) async throws {","        \/\/ Fix up issues like iCloud duplicates or stale locks","    }","","    public func setLocalStoreDirectory(_ path: String?, discardingExistingCache: Bool) {","        \/\/ Where to keep any cache of remote state (see below).","        \/\/ Has a default no-op implementation; only implement it if you cache.","    }","}"],"type":"codeListing"},{"text":"Caching Remote State","level":2,"anchor":"Caching-Remote-State","type":"heading"},{"inlineContent":[{"text":"Backends that fetch changes incrementally — keeping a cursor, change token, or cached","type":"text"},{"text":" ","type":"text"},{"text":"listing between launches — must store that state ","type":"text"},{"inlineContent":[{"text":"inside the event store’s directory","type":"text"}],"type":"strong"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"supplied by ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup\/setLocalStoreDirectory(_:discardingExistingCache:)","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The reason is lifetime. A cache describes one particular event store at one point in its","type":"text"},{"text":" ","type":"text"},{"text":"history. Put it anywhere with an independent lifetime — the system caches directory is","type":"text"},{"text":" ","type":"text"},{"text":"the tempting choice — and it can outlive the store it describes. Deleting the app,","type":"text"},{"text":" ","type":"text"},{"text":"removing the local store, or resetting the cloud data then leaves the cache behind, and","type":"text"},{"text":" ","type":"text"},{"text":"the next launch resumes an incremental fetch from a cursor that no longer matches the","type":"text"},{"text":" ","type":"text"},{"text":"cloud. The server answers truthfully that nothing has changed since that cursor, so","type":"text"},{"text":" ","type":"text"},{"text":"files that predate it are never mentioned again. The device ends up with a silently","type":"text"},{"text":" ","type":"text"},{"text":"partial view of the cloud and no error to report, which is far harder to diagnose than","type":"text"},{"text":" ","type":"text"},{"text":"an outright failure.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Keeping the cache in the event store directory ties the two together: removing the store","type":"text"},{"text":" ","type":"text"},{"text":"removes the cache, so a rebuilt store always starts from a full fetch.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["public func setLocalStoreDirectory(_ path: String?, discardingExistingCache: Bool) {","    localStoreDirectory = path","    inMemoryCache = nil          \/\/ never carry state across stores","    guard path != nil else { return }","","    if discardingExistingCache {","        deleteCacheFromDisk()    \/\/ the store is being rebuilt: start clean","        return","    }","    loadCacheFromDisk()","}"],"type":"codeListing"},{"inlineContent":[{"text":"Three details matter. The method is called before priming whenever an ensemble knows its","type":"text"},{"text":" ","type":"text"},{"text":"store, and it is ","type":"text"},{"inlineContent":[{"text":"not","type":"text"}],"type":"emphasis"},{"text":" called for ensemble-independent operations such as","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/retrieveEnsembleIdentifiers(from:)","isActive":true,"type":"reference"},{"text":" — so tolerate priming without a","type":"text"},{"text":" ","type":"text"},{"text":"directory by simply not caching. When ","type":"text"},{"code":"discardingExistingCache","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" the store is","type":"text"},{"text":" ","type":"text"},{"text":"being rebuilt, so delete any cache you find rather than loading it; do the deletion","type":"text"},{"text":" ","type":"text"},{"text":"yourself rather than assuming the directory is empty. And never recreate the directory in","type":"text"},{"text":" ","type":"text"},{"text":"order to write the cache: if it is gone, the store is gone, and the cache must go with","type":"text"},{"text":" ","type":"text"},{"text":"it.","type":"text"}],"type":"paragraph"},{"text":"Threading and Sendable","type":"heading","level":2,"anchor":"Threading-and-Sendable"},{"inlineContent":[{"text":"Cloud file systems must conform to ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":". If your implementation uses mutable state, you have several options:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Use "},{"code":"actor","type":"codeVoice"},{"type":"text","text":" isolation (as "},{"code":"MemoryCloudFileSystem","type":"codeVoice"},{"type":"text","text":" does)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"@unchecked Sendable"},{"text":" with explicit locking (as ","type":"text"},{"type":"codeVoice","code":"LocalCloudFileSystem"},{"text":" does)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Make the type stateless, delegating state to a thread-safe service","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"All protocol methods are ","type":"text"},{"type":"codeVoice","code":"async throws"},{"text":", so you can freely call async APIs in your implementation.","type":"text"}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/ensembles\/customcloudbackends"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"Ensembles"}],"roleHeading":"Article","role":"article","title":"Custom Cloud Backends"},"references":{"doc://Ensembles/documentation/Ensembles/CloudFileSystem/connect()":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"connect"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"}],"type":"topic","kind":"symbol","role":"symbol","url":"\/documentation\/ensembles\/cloudfilesystem\/connect()","required":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/connect()","abstract":[{"type":"text","text":"Attempts to connect to the cloud backend."}],"title":"connect()"},"doc://Ensembles/documentation/Ensembles/CloudFileSystemSetup":{"url":"\/documentation\/ensembles\/cloudfilesystemsetup","abstract":[{"text":"Optional setup and maintenance operations for cloud file systems.","type":"text"}],"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup","type":"topic","navigatorTitle":[{"text":"CloudFileSystemSetup","kind":"identifier"}],"kind":"symbol","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CloudFileSystemSetup","kind":"identifier"}],"title":"CloudFileSystemSetup"},"doc://Ensembles/documentation/Ensembles/CloudFileSystemBatchOperations":{"navigatorTitle":[{"text":"CloudFileSystemBatchOperations","kind":"identifier"}],"title":"CloudFileSystemBatchOperations","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CloudFileSystemBatchOperations","kind":"identifier"}],"abstract":[{"text":"Optional batch and setup operations for cloud file systems.","type":"text"}],"url":"\/documentation\/ensembles\/cloudfilesystembatchoperations","type":"topic","kind":"symbol","role":"symbol","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemBatchOperations"},"doc://Ensembles/documentation/Ensembles/CloudDirectory":{"title":"CloudDirectory","navigatorTitle":[{"text":"CloudDirectory","kind":"identifier"}],"abstract":[{"text":"Represents a directory in a cloud file system.","type":"text"}],"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudDirectory","url":"\/documentation\/ensembles\/clouddirectory","type":"topic","role":"symbol","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CloudDirectory","kind":"identifier"}]},"doc://Ensembles/documentation/Ensembles/CloudFileSystem/fetchUserIdentity()":{"title":"fetchUserIdentity()","abstract":[{"type":"text","text":"Fetches a token representing the current user of the cloud file system."},{"text":" ","type":"text"},{"text":"Often this will be the user or login name.","type":"text"}],"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/fetchUserIdentity()","url":"\/documentation\/ensembles\/cloudfilesystem\/fetchuseridentity()","type":"topic","role":"symbol","required":true,"kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"fetchUserIdentity","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> sending (any ","kind":"text"},{"preciseIdentifier":"c:objc(pl)NSCoding","text":"NSCoding","kind":"typeIdentifier"},{"text":" & ","kind":"text"},{"preciseIdentifier":"c:objc(pl)NSCopying","text":"NSCopying","kind":"typeIdentifier"},{"text":" & ","kind":"text"},{"preciseIdentifier":"c:objc(pl)NSObject","text":"NSObjectProtocol","kind":"typeIdentifier"},{"text":")?","kind":"text"}]},"doc://Ensembles/documentation/Ensembles/CloudFileSystem/isConnected":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isConnected"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem\/isConnected","url":"\/documentation\/ensembles\/cloudfilesystem\/isconnected","type":"topic","role":"symbol","title":"isConnected","abstract":[{"text":"Whether the file system is connected and ready for file transactions.","type":"text"}],"required":true,"kind":"symbol"},"doc://Ensembles/documentation/Ensembles/CloudFile":{"navigatorTitle":[{"text":"CloudFile","kind":"identifier"}],"title":"CloudFile","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CloudFile","kind":"identifier"}],"abstract":[{"text":"Represents a file in a cloud file system.","type":"text"}],"url":"\/documentation\/ensembles\/cloudfile","type":"topic","kind":"symbol","role":"symbol","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFile"},"doc://Ensembles/documentation/Ensembles/CoreDataEnsemble/retrieveEnsembleIdentifiers(from:)":{"title":"retrieveEnsembleIdentifiers(from:)","abstract":[{"text":"Queries a cloud file system for the identifiers of the ensembles it contains.","type":"text"}],"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/retrieveEnsembleIdentifiers(from:)","url":"\/documentation\/ensembles\/coredataensemble\/retrieveensembleidentifiers(from:)","type":"topic","role":"symbol","kind":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"retrieveEnsembleIdentifiers","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": any ","kind":"text"},{"preciseIdentifier":"s:9Ensembles15CloudFileSystemP","text":"CloudFileSystem","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> [","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"]","kind":"text"}]},"doc://Ensembles/documentation/Ensembles":{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles","url":"\/documentation\/ensembles","abstract":[{"type":"text","text":"Sync Core Data and SwiftData stores across devices using event sourcing."}],"type":"topic","kind":"symbol","title":"Ensembles","role":"collection"},"doc://Ensembles/documentation/Ensembles/CloudFileSystemSetup/setLocalStoreDirectory(_:discardingExistingCache:)":{"title":"setLocalStoreDirectory(_:discardingExistingCache:)","defaultImplementations":1,"abstract":[{"type":"text","text":"Tells the file system which local directory belongs to the event store it is serving."}],"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystemSetup\/setLocalStoreDirectory(_:discardingExistingCache:)","url":"\/documentation\/ensembles\/cloudfilesystemsetup\/setlocalstoredirectory(_:discardingexistingcache:)","type":"topic","role":"symbol","required":true,"kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"setLocalStoreDirectory","kind":"identifier"},{"text":"(","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"discardingExistingCache","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":")","kind":"text"}]},"doc://Ensembles/documentation/Ensembles/CloudFileSystem":{"url":"\/documentation\/ensembles\/cloudfilesystem","abstract":[{"text":"A cloud file system facilitates data transfer between devices.","type":"text"}],"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CloudFileSystem","type":"topic","navigatorTitle":[{"text":"CloudFileSystem","kind":"identifier"}],"kind":"symbol","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CloudFileSystem","kind":"identifier"}],"title":"CloudFileSystem"}}}