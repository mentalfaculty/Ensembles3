{"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"protocol","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"Syncable"},{"text":" : AnyObject","kind":"text"}],"languages":["swift"]}]},{"mentions":["doc:\/\/Ensembles\/documentation\/Ensembles\/GettingStarted"],"kind":"mentions"},{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"inlineContent":[{"type":"text","text":"Global identifiers let Ensembles recognize when objects created independently"},{"type":"text","text":" "},{"type":"text","text":"on different devices represent the same logical entity, and merge them instead"},{"type":"text","text":" "},{"type":"text","text":"of duplicating."}],"type":"paragraph"},{"inlineContent":[{"text":"There are two ways to provide a global identifier:","type":"text"}],"type":"paragraph"},{"text":"Simple: Single Property","level":3,"type":"heading","anchor":"Simple-Single-Property"},{"inlineContent":[{"type":"text","text":"Override "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable\/globalIdentifierKey","isActive":true},{"type":"text","text":" with the name of a stored property:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ Core Data","class Note: NSManagedObject, Syncable {","    static let globalIdentifierKey = \"uniqueID\"","    @NSManaged var uniqueID: String","}","","\/\/ SwiftData","@Model","class Tag: Syncable {","    static let globalIdentifierKey = \"name\"","    var name: String","}"]},{"text":"Advanced: Computed Identifier (Core Data)","level":3,"type":"heading","anchor":"Advanced-Computed-Identifier-Core-Data"},{"inlineContent":[{"text":"Override ","type":"text"},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable\/globalIdentifier(from:)","isActive":true,"type":"reference"},{"text":" for compound or computed identifiers.","type":"text"},{"text":" ","type":"text"},{"text":"The parameter is typed as ","type":"text"},{"code":"Self","type":"codeVoice"},{"text":", so you get direct property access:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["class Person: NSManagedObject, Syncable {","    @NSManaged var firstName: String","    @NSManaged var lastName: String","","    static func globalIdentifier(from person: Person) -> String {","        \"\\(person.firstName).\\(person.lastName)\"","    }","}"]},{"content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable\/globalIdentifier(from:)","isActive":true},{"text":" only works with ","type":"text"},{"type":"codeVoice","code":"NSManagedObject"},{"type":"text","text":" subclasses"},{"type":"text","text":" "},{"type":"text","text":"(Core Data). For SwiftData models, use "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable\/globalIdentifierKey","isActive":true},{"text":" instead.","type":"text"}]}],"type":"aside","style":"note","name":"Note"},{"style":"important","content":[{"inlineContent":[{"text":"A global identifier ","type":"text"},{"type":"strong","inlineContent":[{"text":"must never change","type":"text"}]},{"type":"text","text":" once it has been assigned"},{"text":" ","type":"text"},{"text":"to an object. Changing an identifier after sync has begun will cause Ensembles","type":"text"},{"text":" ","type":"text"},{"text":"to treat the object as a different entity, leading to duplicates or data loss.","type":"text"},{"text":" ","type":"text"},{"text":"Use a value that is set once at creation time, such as a UUID string.","type":"text"}],"type":"paragraph"}],"name":"Important","type":"aside"},{"inlineContent":[{"type":"text","text":"A UUID is usually the best choice for a global identifier. Use a fixed,"},{"type":"text","text":" "},{"type":"text","text":"meaningful value (like a name) only for singleton objects or reference data"},{"type":"text","text":" "},{"type":"text","text":"like tags, where two devices might independently create the same logical object."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"When model types conform to "},{"type":"codeVoice","code":"Syncable"},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleContainer","isActive":true},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"SwiftDataEnsembleContainer"},{"type":"text","text":" discover the identifiers automatically — no"},{"type":"text","text":" "},{"type":"text","text":"delegate or closure needed. When using "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble","isActive":true},{"type":"text","text":" directly, the"},{"type":"text","text":" "},{"type":"text","text":"delegate method remains required, but it can forward to the conformances in"},{"type":"text","text":" "},{"type":"text","text":"one line via "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/syncableGlobalIdentifiers(forManagedObjects:)","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Ensembles\/documentation\/Ensembles"]]},"metadata":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Syncable","kind":"identifier"}],"symbolKind":"protocol","navigatorTitle":[{"kind":"identifier","text":"Syncable"}],"role":"symbol","title":"Syncable","roleHeading":"Protocol","modules":[{"name":"Ensembles"}],"externalID":"s:9Ensembles8SyncableP"},"identifier":{"url":"doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"A protocol for model types that declare how to derive a global identifier"},{"type":"text","text":" "},{"type":"text","text":"for Ensembles deduplication."}],"s