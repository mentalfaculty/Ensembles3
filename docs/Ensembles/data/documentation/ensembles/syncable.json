s/CoreDataEnsembleContainer":{"url":"\/documentation\/ensembles\/coredataensemblecontainer","title":"CoreDataEnsembleContainer","abstract":[{"type":"text","text":"A high-level container that sets up a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble"},{"type":"text","text":" with automatic syncing,"},{"type":"text","text":" "},{"type":"text","text":"delegate management, and optional Core Data stack creation."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"CoreDataEnsembleContainer"}],"role":"symbol","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleContainer","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"CoreDataEnsembleContainer"}]},"doc://Ensembles/documentation/Ensembles":{"role":"collection","url":"\/documentation\/ensembles","kind":"symbol","abstract":[{"type":"text","text":"Sync Core Data and SwiftData stores across devices using event sourcing."}],"type":"topic","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles","title":"Ensembles"},"doc://Ensembles/documentation/Ensembles/GettingStarted":{"role":"article","kind":"article","url":"\/documentation\/ensembles\/gettingstarted","abstract":[{"type":"text","text":"Set up Ensembles to sync a Core Data or SwiftData persistent store across devices."}],"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/GettingStarted","type":"topic","title":"Getting Started"},"doc://Ensembles/documentation/Ensembles/CoreDataEnsemble":{"type":"topic","url":"\/documentation\/ensembles\/coredataensemble","kind":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CoreDataEnsemble","kind":"identifier"}],"title":"CoreDataEnsemble","role":"symbol","navigatorTitle":[{"text":"CoreDataEnsemble","kind":"identifier"}],"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble","abstract":[{"type":"t