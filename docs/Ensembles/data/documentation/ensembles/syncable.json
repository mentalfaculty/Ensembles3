{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable"},"abstract":[{"text":"A protocol for model types that declare how to derive a global identifier","type":"text"},{"text":" ","type":"text"},{"text":"for Ensembles deduplication.","type":"text"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Syncable","kind":"identifier"},{"text":" : AnyObject","kind":"text"}],"platforms":["macOS"]}],"kind":"declarations"},{"mentions":["doc:\/\/Ensembles\/documentation\/Ensembles\/GettingStarted"],"kind":"mentions"},{"kind":"content","content":[{"level":2,"anchor":"overview","text":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Global identifiers let Ensembles recognize when objects created independently"},{"type":"text","text":" "},{"type":"text","text":"on different devices represent the same logical entity, and merge them instead"},{"type":"text","text":" "},{"type":"text","text":"of duplicating."}]},{"inlineContent":[{"type":"text","text":"There are two ways to provide a global identifier:"}],"type":"paragraph"},{"anchor":"Simple-Single-Property","type":"heading","level":3,"text":"Simple: Single Property"},{"inlineContent":[{"type":"text","text":"Override "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable\/globalIdentifierKey","type":"reference","isActive":true},{"type":"text","text":" with the name of a stored property:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ Core Data","class Note: NSManagedObject, Syncable {","    static let globalIdentifierKey = \"uniqueID\"","    @NSManaged var uniqueID: String","}","","\/\/ SwiftData","@Model","class Tag: Syncable {","    static let globalIdentifierKey = \"name\"","    var name: String","}"]},{"anchor":"Advanced-Computed-Identifier-Core-Data","type":"heading","level":3,"text":"Advanced: Com