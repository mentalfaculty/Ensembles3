":"Simple-Single-Property","type":"heading"},{"inlineContent":[{"text":"Override ","type":"text"},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable\/globalIdentifierKey","type":"reference","isActive":true},{"text":" with the name of a stored property:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ Core Data","class Note: NSManagedObject, Syncable {","    static let globalIdentifierKey = \"uniqueID\"","    @NSManaged var uniqueID: String","}","","\/\/ SwiftData","@Model","class Tag: Syncable {","    static let globalIdentifierKey = \"name\"","    var name: String","}"]},{"level":3,"text":"Advanced: Computed Identifier (Core Data)","anchor":"Advanced-Computed-Identifier-Core-Data","type":"heading"},{"inlineContent":[{"text":"Override ","type":"text"},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable\/globalIdentifier(from:)","type":"reference","isActive":true},{"text":" for compound or computed identifiers.","type":"text"},{"text":" ","type":"text"},{"text":"The parameter is typed as ","type":"text"},{"code":"Self","type":"codeVoice"},{"text":", so you get direct property access:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["class Person: NSManagedObject, Syncable {","    @NSManaged var firstName: String","    @NSManaged var lastName: String","","    static func globalIdentifier(from person: Person) -> String {","        \"\\(person.firstName).\\(person.lastName)\"","    }","}"]},{"name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable\/globalIdentifier(from:)","isActive":true},{"type":"text","text":" only works with "},{"type":"codeVoice","code":"NSManagedObject"},{"type":"text","text":" subclasses"},{"type":"text","text":" "},{"type":"text","text":"(Core Data). For SwiftData models, use "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable\/globalIdentifierKey","isActive":true},{"type":"text","text":" instead."}]}],"type":"aside","style":"note"},{"name":"Important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A global identifier "},{"type":"strong","inlineContent":[{"text":"must never change","type":"text"}]},{"type":"text","text":" once it has been assigned"},{"type":"text","text":" "},{"type":"text","text":"to an object. Changing an identifier after sync has begun will cause Ensembles"},{"type":"text","text":" "},{"type":"text","text":"to treat the object as a different entity, leading to duplicates or data loss."},{"type":"text","text":" "},{"type":"text","text":"Use a value that is set once at creation time, such as a UUID string."}]}],"type":"aside","style":"important"},{"inlineContent":[{"text":"A UUID is usually the best choice for a global identifier. Use a fixed,","type":"text"},{"text":" ","type":"text"},{"text":"meaningful value (like a name) only for singleton objects or reference data","type":"text"},{"text":" ","type":"text"},{"text":"like tags, where two devices might independently create the same logical object.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"When model types conform to ","type":"text"},{"code":"Syncable","type":"codeVoice"},{"text":", ","type":"text"},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleContainer","type":"reference","isActive":true},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"SwiftDataEnsembleContainer","type":"codeVoice"},{"text":" discover the identifiers automatically — no","type":"text"},{"text":" ","type":"text"},{"text":"delegate or closure needed.","type":"text"}],"type":"paragraph"}]}],"kind":"symbol","abstract":[{"text":"A protocol for model types that declare how to derive a global identifier","type":"text"},{"text":" ","type":"text"},{"text":"for Ensembles deduplication.","type":"text"}],"references":{"doc://