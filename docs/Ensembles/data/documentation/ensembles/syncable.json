{"abstract":[{"text":"A protocol for model types that declare how to derive a global identifier","type":"text"},{"text":" ","type":"text"},{"text":"for Ensembles deduplication.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/Ensembles\/documentation\/Ensembles"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ensembles\/syncable"]}],"identifier":{"url":"doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable","interfaceLanguage":"swift"},"topicSections":[{"anchor":"Type-Properties","title":"Type Properties","identifiers":["doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable\/globalIdentifierKey"],"generated":true},{"anchor":"Type-Methods","title":"Type Methods","identifiers":["doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable\/globalIdentifier(from:)"],"generated":true}],"kind":"symbol","metadata":{"externalID":"s:9Ensembles8SyncableP","role":"symbol","modules":[{"name":"Ensembles"}],"symbolKind":"protocol","navigatorTitle":[{"text":"Syncable","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Syncable"}],"roleHeading":"Protocol","title":"Syncable"},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Syncable"},{"kind":"text","text":" : AnyObject"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"mentions","mentions":["doc:\/\/Ensembles\/documentation\/Ensembles\/GettingStarted"]},{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Global identifiers let Ensembles recognize when objects created independently"},{"type":"text","text":" "},{"type":"text","text":"on different devices represent the same logical entity, and merge them instead"},{"type":"text","text":" "},{"type":"text","text":"of duplicating."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"There are two ways to provide a global identifier:"}],"type":"paragraph"},{"text":"Simple: Single Property","level":3,"anchor":"Simple-Single-Property","type":"heading"},{"inlineContent":[{"type":"text","text":"Override "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable\/globalIdentifierKey","type":"reference","isActive":true},{"type":"text","text":" with the name of a stored property:"}],"type":"paragraph"},{"code":["\/\/ Core Data","class Note: NSManagedObject, Syncable {","    static let globalIdentifierKey = \"uniqueID\"","    @NSManaged var uniqueID: String","}","","\/\/ SwiftData","@Model","class Tag: Syncable {","    static let globalIdentifierKey = \"name\"","    var name: String","}"],"syntax":"swift","type":"codeListing"},{"text":"Advanced: Computed Identifier (Core Data)","level":3,"anchor":"Advanced-Computed-Identifier-Core-Data","type":"heading"},{"inlineContent":[{"type":"text","text":"Override "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable\/globalIdentifier(from:)","type":"reference","isActive":true},{"type":"text","text":" for compound or computed identifiers."},{"type":"text","text":" "},{"type":"text","text":"The parameter is typed as "},{"type":"codeVoice","code":"Self"},{"type":"text","text":", so you get direct property access:"}],"type":"paragraph"},{"code":["class Person: NSManagedObject, Syncable {","    @NSManaged var firstName: String","    @NSManaged var lastName: String","","    static func globalIdentifier(from person: Person) -> String {","        \"\\(person.firstName).\\(person.lastName)\"","    }","}"],"syntax":"swift","type":"codeListing"},{"name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable\/globalIdentifier(from:)","isActive":true,"type":"reference"},{"text":" only works with ","type":"text"},{"code":"NSManagedObject","type":"codeVoice"},{"text":" subclasses","type":"text"},{"text":" ","type":"text"},{"text":"(Core Data). For SwiftData models, use ","type":"text"},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable\/globalIdentifierKey","isActive":true,"type":"reference"},{"text":" instead.","type":"text"}]}],"type":"aside","style":"note"},{"name":"Important","content":[{"type":"paragraph","inlineContent":[{"text":"A global identifier ","type":"text"},{"inlineContent":[{"type":"text","text":"must never change"}],"type":"strong"},{"text":" once it has been assigned","type":"text"},{"text":" ","type":"text"},{"text":"to an object. Changing an identifier after sync has begun will cause Ensembles","type":"text"},{"text":" ","type":"text"},{"text":"to treat the object as a different entity, leading to duplicates or data loss.","type":"text"},{"text":" ","type":"text"},{"text":"Use a value that is set once at creation time, such as a UUID string.","type":"text"}]}],"type":"aside","style":"important"},{"inlineContent":[{"type":"text","text":"A UUID is usually the best choice for a global identifier. Use a fixed,"},{"type":"text","text":" "},{"type":"text","text":"meaningful value (like a name) only for singleton objects or reference data"},{"type":"text","text":" "},{"type":"text","text":"like tags, where two devices might independently create the same logical object."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"When model types conform to "},{"type":"codeVoice","code":"Syncable"},{"type":"text","text":", "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleContainer","type":"reference","isActive":true},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"SwiftDataEnsembleContainer"},{"type":"text","text":" discover the identifiers automatically — no"},{"type":"text","text":" "},{"type":"text","text":"delegate or closure needed. When using "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble","type":"reference","isActive":true},{"type":"text","text":" directly, the"},{"type":"text","text":" "},{"type":"text","text":"delegate method remains required, but it can forward to the conformances in"},{"type":"text","text":" "},{"type":"text","text":"one line via "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/syncableGlobalIdentifiers(forManagedObjects:)","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]}],"references":{"doc://Ensembles/documentation/Ensembles/Syncable":{"role":"symbol","type":"topic","kind":"symbol","title":"Syncable","url":"\/documentation\/ensembles\/syncable","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Syncable"}],"navigatorTitle":[{"kind":"identifier","text":"Syncable"}],"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable","abstract":[{"type":"text","text":"A protocol for model types that declare how to derive a global identifier"},{"type":"text","text":" "},{"type":"text","text":"for Ensembles deduplication."}]},"doc://Ensembles/documentation/Ensembles/Syncable/globalIdentifier(from:)":{"abstract":[{"text":"Returns a global identifier from the object instance.","type":"text"}],"role":"symbol","required":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable\/globalIdentifier(from:)","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"globalIdentifier"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"}],"url":"\/documentation\/ensembles\/syncable\/globalidentifier(from:)","defaultImplementations":1,"title":"globalI