{"metadata":{"externalID":"s:9Ensembles8SyncableP","role":"symbol","modules":[{"name":"Ensembles"}],"title":"Syncable","symbolKind":"protocol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Syncable"}],"roleHeading":"Protocol","navigatorTitle":[{"kind":"identifier","text":"Syncable"}]},"abstract":[{"type":"text","text":"A protocol for model types that declare how to derive a global identifier"},{"type":"text","text":" "},{"type":"text","text":"for Ensembles deduplication."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Syncable"},{"kind":"text","text":" : AnyObject"}],"languages":["swift"]}]},{"kind":"mentions","mentions":["doc:\/\/Ensembles\/documentation\/Ensembles\/GettingStarted"]},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Global identifiers let Ensembles recognize when objects created independently","type":"text"},{"text":" ","type":"text"},{"text":"on different devices represent the same logical entity, and merge them instead","type":"text"},{"text":" ","type":"text"},{"text":"of duplicating.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"There are two ways to provide a global identifier:","type":"text"}]},{"level":3,"type":"heading","anchor":"Simple-Single-Property","text":"Simple: Single Property"},{"type":"paragraph","inlineContent":[{"text":"Override ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable\/globalIdentifierKey"},{"text":" with the name of a stored property:","type":"text"}]},{"code":["\/\/ Core Data","class Note: NSManagedObject, Syncable {","    static let globalIdentifierKey = \"uniqueID\"","    @NSManaged var uniqueID: String","}","","\/\/ SwiftData","@Model","class Tag: Syncable {","    static let globalIdentifierKey = \"name\"","    var name: String","}"],"type":"codeListing","syntax":"swift"},{"level":3,"type":"heading","anchor":"Advanced-Computed-Identifier-Core-Data","text":"Advanced: Computed Identifier (Core Data)"},{"type":"paragraph","inlineContent":[{"text":"Override ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable\/globalIdentifier(from:)"},{"text":" for compound or computed identifiers.","type":"text"},{"text":" ","type":"text"},{"text":"The parameter is typed as ","type":"text"},{"code":"Self","type":"codeVoice"},{"text":", so you get direct property access:","type":"text"}]},{"code":["class Person: NSManagedObject, Syncable {","    @NSManaged var firstName: String","    @NSManaged var lastName: String","","    static func globalIdentifier(from person: Person) -> String {","        \"\\(person.firstName).\\(person.lastName)\"","    }","}"],"type":"codeListing","syntax":"swift"},{"style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable\/globalIdentifier(from:)","isActive":true},{"type":"text","text":" only works with "},{"code":"NSManagedObject","type":"codeVoice"},{"type":"text","text":" subclasses"},{"type":"text","text":" "},{"type":"text","text":"(Core Data). For SwiftData models, use "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable\/globalIdentifierKey","isActive":true},{"type":"text","text":" instead."}]}],"type":"aside"},{"style":"important","name":"Important","content":[{"type":"paragraph","inlineContent":[{"text":"A global identifier ","type":"text"},{"type":"strong","inlineContent":[{"text":"must never change","type":"text"}]},{"text":" once it has been assigned","type":"text"},{"text":" ","type":"text"},{"text":"to an object. Changing an identifier after sync has begun will cause Ensembles","type":"text"},{"text":" ","type":"text"},{"text":"to treat the object as a different entity, leading to duplicates or data loss.","type":"text"},{"text":" ","type":"text"},{"text":"Use a value that is set once at creation time, such as a UUID string.","type":"text"}]}],"type":"aside"},{"type":"paragraph","inlineContent":[{"text":"A UUID is usually the best choice for a global identifier. Use a fixed,","type":"text"},{"text":" ","type":"text"},{"text":"meaningful value (like a name) only for singleton objects or reference data","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"like tags, where two devices might independently create the same logical object."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When model types conform to "},{"code":"Syncable","type":"codeVoice"},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleContainer","isActive":true},{"type":"text","text":" and"},{"type":"text","text":" "},{"code":"SwiftDataEnsembleContainer","type":"codeVoice"},{"type":"text","text":" discover the identifiers automatically — no"},{"text":" ","type":"text"},{"type":"text","text":"delegate or closure needed. When using "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble"},{"type":"text","text":" directly, the"},{"type":"text","text":" "},{"type":"text","text":"delegate method remains required, but it can forward to the conformances in"},{"type":"text","text":" "},{"text":"one line via ","type":"text"},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/syncableGlobalIdentifiers(forManagedObjects:)","isActive":true},{"text":".","type":"text"}]}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/Ensembles\/documentation\/Ensembles"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","identifier":{"interfaceLangu