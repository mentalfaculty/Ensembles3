sembles\/Syncable\/globalIdentifierKey","isActive":true,"type":"reference"},{"type":"text","text":" with the name of a stored property:"}]},{"syntax":"swift","code":["\/\/ Core Data","class Note: NSManagedObject, Syncable {","    static let globalIdentifierKey = \"uniqueID\"","    @NSManaged var uniqueID: String","}","","\/\/ SwiftData","@Model","class Tag: Syncable {","    static let globalIdentifierKey = \"name\"","    var name: String","}"],"type":"codeListing"},{"level":3,"anchor":"Advanced-Computed-Identifier-Core-Data","type":"heading","text":"Advanced: Computed Identifier (Core Data)"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Override "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable\/globalIdentifier(from:)","isActive":true,"type":"reference"},{"type":"text","text":" for compound or computed identifiers."},{"type":"text","text":" "},{"type":"text","text":"The parameter is typed as "},{"type":"codeVoice","code":"Self"},{"type":"text","text":", so you get direct property access:"}]},{"syntax":"swift","code":["class Person: NSManagedObject, Syncable {","    @NSManaged var firstName: String","    @NSManaged var lastName: String","","    static func globalIdentifier(from person: Person) -> String {","        \"\\(person.firstName).\\(person.lastName)\"","    }","}"],"type":"codeListing"},{"type":"aside","content":[{"inlineContent":[{"text":"","type":"text"},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable\/globalIdentifier(from:)","isActive":true,"type":"reference"},{"text":" only works with ","type":"text"},{"code":"NSManagedObject","type":"codeVoice"},{"text":" subclasses","type":"text"},{"text":" ","type":"text"},{"text":"(Core Data). For SwiftData models, use ","type":"text"},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable\/globalIdentifierKey","isActive":true,"type":"reference"},{"text":" instead.","type":"text"}],"type":"paragraph"}],"style":"note","name":"Note"},{"type":"asid