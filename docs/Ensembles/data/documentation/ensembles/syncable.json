{"abstract":[{"type":"text","text":"A protocol for model types that declare how to derive a global identifier"},{"type":"text","text":" "},{"type":"text","text":"for Ensembles deduplication."}],"variants":[{"paths":["\/documentation\/ensembles\/syncable"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Syncable","kind":"identifier"},{"text":" : AnyObject","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"mentions","mentions":["doc:\/\/Ensembles\/documentation\/Ensembles\/GettingStarted"]},{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"Global identifiers let Ensembles recognize when objects created independently","type":"text"},{"text":" ","type":"text"},{"text":"on different devices represent the same logical entity, and merge them instead","type":"text"},{"text":" ","type":"text"},{"text":"of duplicating.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"There are two ways to provide a global identifier:","type":"text"}]},{"level":3,"anchor":"Simple-Single-Property","text":"Simple: Single Property","type":"heading"},{"inlineContent":[{"type":"text","text":"Override "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable\/globalIdentifierKey","isActive":true,"type":"reference"},{"type":"text","text":" with the name of a stored property:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ Core Data","class Note: NSManagedObject, Syncable {","    static let globalIdentifierKey = \"uniqueID\"","    @NSManaged var uniqueID: String","}","","\/\/ SwiftData","@Model","class Tag: Syncable {","    static let globalIdentifierKey = \"name\"","    var name: String","}"]},{"type":"heading","text":"Advanced: Computed Identifier (Core Data)","level":3,"anchor":"Advanced-C