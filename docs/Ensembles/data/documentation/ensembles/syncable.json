 once at creation time, such as a UUID string.","type":"text"}],"type":"paragraph"}]},{"inlineContent":[{"text":"A UUID is usually the best choice for a global identifier. Use a fixed,","type":"text"},{"text":" ","type":"text"},{"text":"meaningful value (like a name) only for singleton objects or reference data","type":"text"},{"text":" ","type":"text"},{"text":"like tags, where two devices might independently create the same logical object.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"When model types conform to ","type":"text"},{"code":"Syncable","type":"codeVoice"},{"text":", ","type":"text"},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleContainer","isActive":true,"type":"reference"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"SwiftDataEnsembleContainer","type":"codeVoice"},{"text":" discover the identifiers automatically — no","type":"text"},{"text":" ","type":"text"},{"text":"delegate or closure needed.","type":"text"}],"type":"paragraph"}]}],"kind":"symbol","sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"topicSections":[{"title":"Type Properties","identifiers":["doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable\/globalIdentifierKey"],"anchor":"Type-Properties","generated":true},{"generated":true,"title":"Type Methods","anchor":"Type-Methods","identifiers":["doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable\/globalIdentifier(from:)"]}],"identifier":{"url":"doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Ensembles\/documentation\/Ensembles"]]},"metadata":{"roleHeading":"Protocol","title":"Syncable","externalID":"s:9Ensembles8SyncableP","role":"symbol","symbolKind":"protocol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Syncable","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"Syncable"}],"modules":[{"name":"Ensembles"}]},"references":{"doc://