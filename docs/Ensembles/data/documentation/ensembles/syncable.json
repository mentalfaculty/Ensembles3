Ensembles\/documentation\/Ensembles\/Syncable\/globalIdentifierKey"},{"type":"text","text":" instead."}],"type":"paragraph"}],"style":"note","type":"aside","name":"Note"},{"content":[{"inlineContent":[{"type":"text","text":"A global identifier "},{"type":"strong","inlineContent":[{"type":"text","text":"must never change"}]},{"type":"text","text":" once it has been assigned"},{"type":"text","text":" "},{"type":"text","text":"to an object. Changing an identifier after sync has begun will cause Ensembles"},{"type":"text","text":" "},{"type":"text","text":"to treat the object as a different entity, leading to duplicates or data loss."},{"type":"text","text":" "},{"type":"text","text":"Use a value that is set once at creation time, such as a UUID string."}],"type":"paragraph"}],"style":"important","type":"aside","name":"Important"},{"inlineContent":[{"type":"text","text":"A UUID is usually the best choice for a global identifier. Use a fixed,"},{"type":"text","text":" "},{"type":"text","text":"meaningful value (like a name) only for singleton objects or reference data"},{"type":"text","text":" "},{"type":"text","text":"like tags, where two devices might independently create the same logical object."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"When model types conform to "},{"type":"codeVoice","code":"Syncable"},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleContainer","isActive":true},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"SwiftDataEnsembleContainer"},{"type":"text","text":" discover the identifiers automatically — no"},{"type":"text","text":" "},{"type":"text","text":"delegate or closure needed."}],"type":"paragraph"}]}],"abstract":[{"type":"text","text":"A protocol for model types that declare how to derive a global identifier"},{"type":"text","text":" "},{"type":"text","text":"for Ensembles deduplication."}],"references":{"doc://