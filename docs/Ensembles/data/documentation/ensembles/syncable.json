{"abstract":[{"text":"A protocol for model types that declare how to derive a global identifier","type":"text"},{"type":"text","text":" "},{"type":"text","text":"for Ensembles deduplication."}],"variants":[{"paths":["\/documentation\/ensembles\/syncable"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"anchor":"Type-Properties","title":"Type Properties","identifiers":["doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable\/globalIdentifierKey"],"generated":true},{"title":"Type Methods","generated":true,"identifiers":["doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable\/globalIdentifier(from:)"],"anchor":"Type-Methods"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"protocol","kind":"keyword"},{"kind":"text","text":" "},{"text":"Syncable","kind":"identifier"},{"text":" : AnyObject","kind":"text"}]}]},{"mentions":["doc:\/\/Ensembles\/documentation\/Ensembles\/GettingStarted"],"kind":"mentions"},{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"inlineContent":[{"text":"Global identifiers let Ensembles recognize when objects created independently","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"on different devices represent the same logical entity, and merge them instead"},{"type":"text","text":" "},{"type":"text","text":"of duplicating."}],"type":"paragraph"},{"inlineContent":[{"text":"There are two ways to provide a global identifier:","type":"text"}],"type":"paragraph"},{"level":3,"text":"Simple: Single Property","anchor":"Simple-Single-Property","type":"heading"},{"inlineContent":[{"type":"text","text":"Override "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable\/globalIdentifierKey"},{"type":"text","text":" with the name of a stored property:"}],"type":"paragraph"},{"code":["\/\/ Core Data","class Note: NSManagedObject, Syncable {","    static let globalIdentifierKey = \"uniqueID\"","    @NSManaged var uniqueID: String","}","","\/\/ SwiftData","@Model","class Tag: Syncable {","    static let globalIdentifierKey = \"name\"","    var name: String","}"],"type":"codeListing","syntax":"swift"},{"level":3,"text":"Advanced: Computed Identifier (Core Data)","anchor":"Advanced-Computed-Identifier-Core-Data","type":"heading"},{"inlineContent":[{"text":"Override ","type":"text"},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable\/globalIdentifier(from:)","isActive":true},{"type":"text","text":" for compound or computed identifiers."},{"type":"text","text":" "},{"type":"text","text":"The parameter is typed as "},{"type":"codeVoice","code":"Self"},{"type":"text","text":", so you get direct property access:"}],"type":"paragraph"},{"code":["class Person: NSManagedObject, Syncable {","    @NSManaged var firstName: String","    @NSManaged var lastName: String","","    static func globalIdentifier(from person: Person) -> String {","        \"\\(person.firstName).\\(person.lastName)\"","    }","}"],"type":"codeListing","syntax":"swift"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable\/globalIdentifier(from:)","type":"reference","isActive":true},{"type":"text","text":" only works with "},{"type":"codeVoice","code":"NSManagedObject"},{"type":"text","text":" subclasses"},{"type":"text","text":" "},{"text":"(Core Data). For SwiftData models, use ","type":"text"},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable\/globalIdentifierKey","isActive":true,"type":"reference"},{"type":"text","text":" instead."}]}],"name":"Note","type":"aside"},{"name":"Important","style":"important","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"A global identifier ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"must never change"}]},{"text":" once it has been assigned","type":"text"},{"type":"text","text":" "},{"type":"text","text":"to an object. Changing an identifier after sync has begun will cause Ensembles"},{"type":"text","text":" "},{"type":"text","text":"to treat the object as a different entity, leading to duplicates or data loss."},{"text":" ","type":"text"},{"text":"Use a value that is set once at creation time, such as a UUID string.","type":"text"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A UUID is usually the best choice for a global identifier. Use a fixed,"},{"type":"text","text":" "},{"text":"meaningful value (like a name) only for singleton objects or reference data","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"like tags, where two devices might independently create the same logical object."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When model types conform to "},{"type":"codeVoice","code":"Syncable"},{"type":"text","text":", "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleContainer","isActive":true,"type":"reference"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"SwiftDataEnsembleContainer"},{"type":"text","text":" discover the identifiers automatically — no"},{"type":"text","text":" "},{"type":"text","text":"delegate or closure needed."}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Ensembles\/documentation\/Ensembles"]]},"sections":[],"metadata":{"externalID":"s:9Ensembles8SyncableP","fragments":[{"text":"protocol","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"Syncable"}],"title":"Syncable","modules":[{"name":"Ensembles"}],"roleHeading":"Protocol","symbolKind":"protocol","role":"symbol","navigatorTitle":[{"text":"Syncable","kind":"identifier"}]},"references":{"doc://