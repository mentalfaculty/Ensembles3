erence data"},{"type":"text","text":" "},{"type":"text","text":"like tags, where two devices might independently create the same logical object."}],"type":"paragraph"},{"inlineContent":[{"text":"When model types conform to ","type":"text"},{"type":"codeVoice","code":"Syncable"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleContainer"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"SwiftDataEnsembleContainer"},{"text":" discover the identifiers automatically — no","type":"text"},{"text":" ","type":"text"},{"text":"delegate or closure needed. When using ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble"},{"text":" directly, the","type":"text"},{"text":" ","type":"text"},{"text":"delegate method remains required, but it can forward to the conformances in","type":"text"},{"text":" ","type":"text"},{"text":"one line via ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/syncableGlobalIdentifiers(forManagedObjects:)"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"text":"A protocol for model types that declare how to derive a global identifier","type":"text"},{"text":" ","type":"text"},{"text":"for Ensembles deduplication.","type":"text"}],"variants":[{"paths":["\/documentation\/ensembles\/syncable"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"navigatorTitle":[{"text":"Syncable","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Syncable"}],"symbolKind":"protocol","modules":[{"name":"Ensembles"}],"title":"Syncable","externalID":"s:9Ensembles8SyncableP","roleHeading":"Protocol","role":"symbol"},"sections"