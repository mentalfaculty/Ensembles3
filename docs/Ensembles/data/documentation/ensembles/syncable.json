 once at creation time, such as a UUID string."}]}]},{"inlineContent":[{"type":"text","text":"A UUID is usually the best choice for a global identifier. Use a fixed,"},{"type":"text","text":" "},{"type":"text","text":"meaningful value (like a name) only for singleton objects or reference data"},{"type":"text","text":" "},{"type":"text","text":"like tags, where two devices might independently create the same logical object."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When model types conform to "},{"code":"Syncable","type":"codeVoice"},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleContainer","isActive":true},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"SwiftDataEnsembleContainer"},{"type":"text","text":" discover the identifiers automatically — no"},{"type":"text","text":" "},{"type":"text","text":"delegate or closure needed. When using "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble","isActive":true},{"type":"text","text":" directly, the"},{"type":"text","text":" "},{"type":"text","text":"delegate method remains required, but it can forward to the conformances in"},{"type":"text","text":" "},{"type":"text","text":"one line via "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/syncableGlobalIdentifiers(forManagedObjects:)"},{"type":"text","text":"."}]}]}],"identifier":{"url":"doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable","interfaceLanguage":"swift"},"kind":"symbol","sections":[],"metadata":{"roleHeading":"Protocol","navigatorTitle":[{"text":"Syncable","kind":"identifier"}],"symbolKind":"protocol","modules":[{"name":"Ensembles"}],"role":"symbol","title":"Syncable","externalID":"s:9Ensembles8SyncableP","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Synca