{"hierarchy":{"paths":[["doc:\/\/Ensembles\/documentation\/Ensembles"]]},"abstract":[{"text":"A protocol for model types that declare how to derive a global identifier","type":"text"},{"text":" ","type":"text"},{"text":"for Ensembles deduplication.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"protocol","kind":"keyword"},{"kind":"text","text":" "},{"text":"Syncable","kind":"identifier"},{"text":" : AnyObject","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"mentions","mentions":["doc:\/\/Ensembles\/documentation\/Ensembles\/GettingStarted"]},{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"Global identifiers let Ensembles recognize when objects created independently","type":"text"},{"text":" ","type":"text"},{"text":"on different devices represent the same logical entity, and merge them instead","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"of duplicating."}]},{"inlineContent":[{"text":"There are two ways to provide a global identifier:","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"Simple-Single-Property","type":"heading","text":"Simple: Single Property"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Override "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable\/globalIdentifierKey","isActive":true,"type":"reference"},{"type":"text","text":" with the name of a stored property:"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Core Data","class Note: NSManagedObject, Syncable {","    static let globalIdentifierKey = \"uniqueID\"","    @NSManaged var uniqueID: String","}","","\/\/ SwiftData","@Model","class Tag: Syncable {","    static let globalIdentifierKey = \"name\"","    var name: String","}"]},{"level":3,"text":"Advanced: Computed Identifier (Core Data)","anchor":"Advanced-Computed-Identifier-Core-Data","type":"heading"},{"