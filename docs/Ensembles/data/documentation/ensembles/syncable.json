{"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Syncable"},{"kind":"text","text":" : AnyObject"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"mentions":["doc:\/\/Ensembles\/documentation\/Ensembles\/GettingStarted"],"kind":"mentions"},{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Global identifiers let Ensembles recognize when objects created independently"},{"type":"text","text":" "},{"type":"text","text":"on different devices represent the same logical entity, and merge them instead"},{"type":"text","text":" "},{"type":"text","text":"of duplicating."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"There are two ways to provide a global identifier:"}],"type":"paragraph"},{"level":3,"text":"Simple: Single Property","anchor":"Simple-Single-Property","type":"heading"},{"inlineContent":[{"type":"text","text":"Override "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable\/globalIdentifierKey","isActive":true},{"type":"text","text":" with the name of a stored property:"}],"type":"paragraph"},{"code":["\/\/ Core Data","class Note: NSManagedObject, Syncable {","    static let globalIdentifierKey = \"uniqueID\"","    @NSManaged var uniqueID: String","}","","\/\/ SwiftData","@Model","class Tag: Syncable {","    static let globalIdentifierKey = \"name\"","    var name: String","}"],"type":"codeListing","syntax":"swift"},{"level":3,"text":"Advanced: Computed Identifier (Core Data)","anchor":"Advanced-Computed-Identifier-Core-Data","type":"heading"},{"inlineContent":[{"type":"text","text":"Override "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable\/globalIdentifier(from:)","isActive":true},{"type":"text","text":" for compound or computed identifiers."},{"type":"text","text":" "},{"type":"