{"abstract":[{"type":"text","text":"A protocol for model types that declare how to derive a global identifier"},{"type":"text","text":" "},{"type":"text","text":"for Ensembles deduplication."}],"topicSections":[{"anchor":"Type-Properties","identifiers":["doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable\/globalIdentifierKey"],"generated":true,"title":"Type Properties"},{"anchor":"Type-Methods","identifiers":["doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable\/globalIdentifier(from:)"],"generated":true,"title":"Type Methods"}],"variants":[{"paths":["\/documentation\/ensembles\/syncable"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Syncable"},{"kind":"text","text":" : AnyObject"}]}],"kind":"declarations"},{"mentions":["doc:\/\/Ensembles\/documentation\/Ensembles\/GettingStarted"],"kind":"mentions"},{"content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Global identifiers let Ensembles recognize when objects created independently"},{"type":"text","text":" "},{"type":"text","text":"on different devices represent the same logical entity, and merge them instead"},{"type":"text","text":" "},{"type":"text","text":"of duplicating."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"There are two ways to provide a global identifier:"}]},{"level":3,"anchor":"Simple-Single-Property","type":"heading","text":"Simple: Single Property"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Override "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable\/globalIdentifierKey"},{"type":"text","text":" with the name of a stored property:"}]},{"syntax":"swift","code":["\/\/ Core Data","class Note: NSManagedObject, Syncable {","    static let globalIdentifierKey = \"uniqueID\"","    @NSManaged var uniqueID: String","}","","\/\/ SwiftData","@Model","class Tag: Syncable {","    static let globalIdentifierKey = \"name\"","    var name: String","}"],"type":"codeListing"},{"level":3,"anchor":"Advanced-Computed-Identifier-Core-Data","type":"heading","text":"Advanced: Computed Identifier (Core Data)"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Override "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable\/globalIdentifier(from:)"},{"type":"text","text":" for compound or computed identifiers."},{"type":"text","text":" "},{"type":"text","text":"The parameter is typed as "},{"code":"Self","type":"codeVoice"},{"type":"text","text":", so you get direct property access:"}]},{"syntax":"swift","code":["class Person: NSManagedObject, Syncable {","    @NSManaged var firstName: String","    @NSManaged var lastName: String","","    static func globalIdentifier(from person: Person) -> String {","        \"\\(person.firstName).\\(person.lastName)\"","    }","}"],"type":"codeListing"},{"name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable\/globalIdentifier(from:)","type":"reference"},{"type":"text","text":" only works with "},{"code":"NSManagedObject","type":"codeVoice"},{"type":"text","text":" subclasses"},{"type":"text","text":" "},{"type":"text","text":"(Core Data). For SwiftData models, use "},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable\/globalIdentifierKey","type":"reference"},{"type":"text","text":" instead."}]}],"type":"aside","style":"note"},{"name":"Important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A global identifier "},{"type":"strong","inlineContent":[{"type":"text","text":"must never change"}]},{"type":"text","text":" once it has been assigned"},{"type":"text","text":" "},{"type":"text","text":"to an object. Changing an identifier after sync has begun will cause Ensembles"},{"type":"text","text":" "},{"type":"text","text":"to treat the object as a different entity, leading to duplicates or data loss."},{"type":"text","text":" "},{"type":"text","text":"Use a value that is set once at creation time, such as a UUID string."}]}],"type":"aside","style":"important"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A UUID is usually the best choice for a global identifier. Use a fixed,"},{"type":"text","text":" "},{"type":"text","text":"meaningful value (like a name) only for singleton objects or reference data"},{"type":"text","text":" "},{"type":"text","text":"like tags, where two devices might independently create the same logical object."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When model types conform to "},{"code":"Syncable","type":"codeVoice"},{"type":"text","text":", "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleContainer","type":"reference","isActive":true},{"type":"text","text":" and"},{"type":"text","text":" "},{"code":"SwiftDataEnsembleContainer","type":"codeVoice"},{"type":"text","text":" discover the identifiers automatically — no"},{"type":"text","text":" "},{"type":"text","text":"delegate or closure needed."}]}],"kind":"content"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/Ensembles\/documentation\/Ensembles"]]},"kind":"symbol","schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"roleHeading":"Protocol","symbolKind":"protocol","modules":[{"name":"Ensembles"}],"title":"Syncable","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Syncable"}],"externalID":"s:9Ensembles8SyncableP","role":"symbol","navigatorTitle":[{"text":"Syncable","kind":"identifier"}]},"references":{"doc://