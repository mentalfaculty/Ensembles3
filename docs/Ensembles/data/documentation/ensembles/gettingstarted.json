Ensembles\/CoreDataEnsemble","type":"reference"},{"text":" with automatic syncing,","type":"text"},{"text":" ","type":"text"},{"text":"delegate management, and optional Core Data stack creation.","type":"text"}]},"doc://Ensembles/documentation/Ensembles/CoreDataEnsemble/currentActivity":{"title":"currentActivity","url":"\/documentation\/ensembles\/coredataensemble\/currentactivity","abstract":[{"type":"text","text":"The activity currently being undertaken, if any."}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"currentActivity"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"EnsembleActivity","preciseIdentifier":"s:9Ensembles16EnsembleActivityO"}],"kind":"symbol","role":"symbol","type":"topic","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/currentActivity"},"doc://Ensembles/documentation/Ensembles/CoreDataEnsemble/sync(options:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sync","kind":"identifier"},{"text":"(","kind":"text"},{"text":"options","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:9Ensembles11SyncOptionsV","text":"SyncOptions","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}],"url":"\/documentation\/ensembles\/coredataensemble\/sync(options:)","kind":"symbol","role":"symbol","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/sync(options:)","type":"topic","abstract":[{"text":"Syncs changes with other peers.","type":"text"}],"title":"sync(options:)"},"doc://Ensembles/documentation/Ensembles/CoreDataEnsemble/activityProgress":{"url":"\/documentation\/ensembles\/coredataensemble\/activityprogress","type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"activityProgress"},{"kind":"text","text":": "},{"preciseIdent