{"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"Set up Ensembles to sync a Core Data or SwiftData persistent store across devices."}],"hierarchy":{"paths":[["doc:\/\/Ensembles\/documentation\/Ensembles"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ensembles\/gettingstarted"]}],"kind":"article","sections":[],"seeAlsoSections":[{"generated":true,"title":"Essentials","anchor":"Essentials","identifiers":["doc:\/\/Ensembles\/documentation\/Ensembles\/SwiftDataIntegration","doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleContainer","doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble","doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleDelegate"]}],"metadata":{"title":"Getting Started","modules":[{"name":"Ensembles"}],"roleHeading":"Article","role":"article"},"identifier":{"url":"doc:\/\/Ensembles\/documentation\/Ensembles\/GettingStarted","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Ensembles synchronizes SQLite stores by recording local changes as events and exchanging them through a cloud backend. It works with both Core Data and SwiftData."}]},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Using SwiftData?"}]},{"text":" See ","type":"text"},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SwiftDataIntegration","isActive":true,"type":"reference"},{"text":" for a complete guide — you never need to touch Core Data directly.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This guide covers Core Data setup, starting with a complete working example using "},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleContainer","type":"reference"},{"type":"text","text":"."}]},{"level":2,"anchor":"Develop-with-Claude-Code","text":"Develop with Claude Code","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"If you use ","type":"text"},{"identifier":"https:\/\/claude.com\/claude-code","isActive":true,"type":"reference"},{"text":", install the Ensembles skill first. It teaches Claude the API, the cloud backends, Ensembles 2 → 3 migration, the seed policy, and the common pitfalls, so it writes correct setup code and diagnoses sync issues without hand-holding:","type":"text"}]},{"type":"codeListing","code":["\/plugin marketplace add mentalfaculty\/Ensembles3","\/plugin install ensembles@ensembles"],"syntax":null},{"anchor":"Add-Ensembles-to-Your-Project","type":"heading","text":"Add Ensembles to Your Project","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the Ensembles package to your "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":" or via Xcode’s package dependencies:"}]},{"syntax":null,"code":["https:\/\/github.com\/mentalfaculty\/Ensembles3.git"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Import the core module and one cloud backend:","type":"text"}]},{"syntax":"swift","code":["import Ensembles","import EnsemblesCloudKit   \/\/ or EnsemblesLocalFile, EnsemblesMemory"],"type":"codeListing"},{"text":"Complete Example: Core Data with CloudKit","type":"heading","level":2,"anchor":"Complete-Example-Core-Data-with-CloudKit"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Here’s a complete, working setup for a SwiftUI app that syncs via CloudKit. This uses "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleContainer","isActive":true,"type":"reference"},{"type":"text","text":", which creates the Core Data stack for you and syncs automatically."}]},{"level":3,"type":"heading","anchor":"1-Create-Your-Core-Data-Model","text":"1. Create Your Core Data Model"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In Xcode, add a "},{"type":"codeVoice","code":".xcdatamodeld"},{"type":"text","text":" file to your project (e.g., "},{"type":"strong","inlineContent":[{"text":"Model.xcdatamodeld","type":"text"}]},{"text":"). Define your entities as usual. For this example, we’ll assume a ","type":"text"},{"code":"Note","type":"codeVoice"},{"text":" entity with ","type":"text"},{"code":"title","type":"codeVoice"},{"type":"text","text":" (String) and "},{"code":"uniqueID","type":"codeVoice"},{"type":"text","text":" (String) attributes."}]},{"anchor":"2-Define-Your-Model-with-Syncable","type":"heading","text":"2. Define Your Model with `Syncable`","level":3},{"type":"paragraph","inlineContent":[{"text":"For deduplication, conform your ","type":"text"},{"type":"codeVoice","code":"NSManagedObject"},{"text":" subclass to the ","type":"text"},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable","isActive":true,"type":"reference"},{"text":" protocol and specify which property holds the global identifier. A UUID assigned at creation time is usually the best choice:","type":"text"}]},{"type":"codeListing","code":["import CoreData","import Ensembles","","class Note: NSManagedObject, Syncable {","    static let globalIdentifierKey = \"uniqueID\"","    @NSManaged var uniqueID: String","    @NSManaged var title: String","}"],"syntax":"swift"},{"type":"aside","style":"important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A global identifier "},{"inlineContent":[{"text":"must never change","type":"text"}],"type":"strong"},{"type":"text","text":" once it has been assigned. Changing it after sync has begun will cause duplicates or data loss."}]}],"name":"Important"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use a fixed, meaningful value instead of a UUID for singleton objects or reference data like tags, where two devices might independently create the same logical object."}]},{"anchor":"3-Set-Up-the-Container","type":"heading","level":3,"text":"3. Set Up the Container"},{"type":"codeListing","syntax":"swift","code":["import SwiftUI","import Ensembles","import EnsemblesCloudKit","","@main","struct MyApp: App {","    let syncContainer: CoreDataEnsembleContainer","","    init() {","        \/\/ The model URL points to the .momd bundle compiled from your .xcdatamodeld","        let modelURL = Bundle.main.url(forResource: \"Model\", withExtension: \"momd\")!","","        \/\/ This creates a full Core Data stack automatically:","        \/\/ - SQLite store at Application Support\/MyNotes.sqlite","        \/\/ - Main-queue viewContext for your UI","        \/\/ - Auto-sync on save, on app activation, and on a 5-minute timer","        let container = CoreDataEnsembleContainer(","            name: \"MyNotes\",","            modelURL: modelURL,","            cloudFileSystem: CloudKitFileSystem(","                privateDatabaseForUbiquityContainerIdentifier: \"iCloud.com.example.mynotes\",","                schemaVersion: .v2","            )","        )!","","        self.syncContainer = container","    }","","    var body: some Scene {","        WindowGroup {","            ContentView()","                .environment(","                    \\.managedObjectContext,","                    syncContainer.viewContext","                )","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"That’s the complete setup. The container discovers "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable","isActive":true},{"type":"text","text":" conformances automatically, attaches to the cloud, and begins syncing. Remote changes are merged into "},{"type":"codeVoice","code":"viewContext"},{"type":"text","text":" so your UI stays up to date."}]},{"anchor":"4-Respond-to-Events-Optional","level":3,"text":"4. Respond to Events (Optional)","type":"heading"},{"syntax":"swift","code":["\/\/ Called after remote changes are merged into viewContext","container.didSaveMergeChanges = { notification in","    print(\"Merged remote changes\")","}","","\/\/ Called if a sync fails","container.didEncounterError = { error in","    print(\"Sync error: \\(error)\")","}"],"type":"codeListing"},{"text":"Using a Custom Store Location","type":"heading","level":2,"anchor":"Using-a-Custom-Store-Location"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you need control over where the SQLite file lives, pass an explicit "},{"code":"storeURL","type":"codeVoice"},{"text":":","type":"text"}]},{"code":["let appSupport = FileManager.default.urls(","    for: .applicationSupportDirectory, in: .userDomainMask",").first!","let storeURL = appSupport.appendingPathComponent(\"MyApp\/data.sqlite\")","try FileManager.default.createDirectory(","    at: storeURL.deletingLastPathComponent(),","    withIntermediateDirectories: true",")","","let container = CoreDataEnsembleContainer(","    name: \"MyNotes\",","    storeURL: storeURL,","    modelURL: Bundle.main.url(forResource: \"Model\", withExtension: \"momd\")!,","    cloudFileSystem: CloudKitFileSystem(","        privateDatabaseForUbiquityContainerIdentifier: \"iCloud.com.example.mynotes\",","        schemaVersion: .v2","    )",")!"],"syntax":"swift","type":"codeListing"},{"text":"Working with an Existing Core Data Stack","anchor":"Working-with-an-Existing-Core-Data-Stack","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"If you already have an "},{"type":"codeVoice","code":"NSPersistentContainer"},{"type":"text","text":", pass it in directly:"}],"type":"paragraph"},{"code":["let container = CoreDataEnsembleContainer(","    persistentContainer: myPersistentContainer,","    cloudFileSystem: cloudFS",")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Or if you have an existing "},{"type":"codeVoice","code":"NSManagedObjectContext"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let container = CoreDataEnsembleContainer(","    name: \"MyNotes\",","    viewContext: myContext,","    persistentStoreURL: myStoreURL,","    managedObjectModel: myContext.persistentStoreCoordinator!.managedObjectModel,","    managedObjectModels: nil,","    cloudFileSystem: cloudFS",")"]},{"anchor":"Auto-Sync-Configuration","type":"heading","level":2,"text":"Auto-Sync Configuration"},{"inlineContent":[{"type":"text","text":"Control when syncing occurs with "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/AutoSyncPolicy","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let config = EnsembleContainerConfiguration(","    autoSyncPolicy: [.onSave, .onTimer],   \/\/ Sync on save and timer, not on activation","    timerInterval: 30                       \/\/ Timer fires every 30 seconds",")","let container = CoreDataEnsembleContainer(","    name: \"MyNotes\",","    modelURL: modelURL,","    cloudFileSystem: cloudFS,","    configuration: config",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Set "},{"code":"autoSyncPolicy","type":"codeVoice"},{"type":"text","text":" to "},{"type":"codeVoice","code":".manual"},{"type":"text","text":" and call "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleContainer\/sync()","isActive":true,"type":"reference"},{"type":"text","text":" yourself for full control over timing."}]},{"type":"heading","level":2,"text":"Backward Compatibility with Ensembles 2","anchor":"Backward-Compatibility-with-Ensembles-2"},{"inlineContent":[{"type":"text","text":"If you’re transitioning from Ensembles 2 and some users may still be on E2, set the compatibility mode:"}],"type":"paragraph"},{"code":["let config = EnsembleContainerConfiguration(","    compatibilityMode: .ensembles2Compatible",")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"This restricts exports to formats that Ensembles 2 peers can parse. Switch to "},{"type":"codeVoice","code":".ensembles3"},{"text":" (the default) once all users have upgraded.","type":"text"}],"type":"paragraph"},{"level":2,"text":"The Manual Way: CoreDataEnsemble","type":"heading","anchor":"The-Manual-Way-CoreDataEnsemble"},{"inlineContent":[{"type":"text","text":"For more control over the sync lifecycle, use "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble","isActive":true},{"type":"text","text":" directly. This is useful when you need to manage attach\/detach timing, handle specific delegate methods, or integrate with a complex Core Data stack."}],"type":"paragraph"},{"level":3,"text":"Create and Attach","type":"heading","anchor":"Create-and-Attach"},{"code":["import Ensembles","import EnsemblesCloudKit","","\/\/ Get the store URL from your persistent store coordinator","let store = persistentStoreCoordinator.persistentStores.first!","let storeURL = store.url!","let modelURL = Bundle.main.url(forResource: \"Model\", withExtension: \"momd\")!","","let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MyNotes\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: CloudKitFileSystem(","        privateDatabaseForUbiquityContainerIdentifier: \"iCloud.com.example.mynotes\",","        schemaVersion: .v2","    )",")","ensemble?.delegate = self","","\/\/ Attach registers this device in the cloud","try await ensemble?.attachPersistentStore()"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/ensembleIdentifier","isActive":true,"type":"reference"},{"text":" must be the same on all devices that should sync together. If you have multiple persistent stores, create one ensemble per store with a unique identifier.","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"Avoid saving to the persistent store while attaching. If a save is detected, attachment will fail with an error and you will need to retry.","type":"text"}],"type":"paragraph"}],"style":"important","type":"aside","name":"Important"},{"level":3,"text":"Sync Changes","type":"heading","anchor":"Sync-Changes"},{"inlineContent":[{"text":"Call ","type":"text"},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/sync(options:)","isActive":true,"type":"reference"},{"text":" periodically — for example, when the app enters the foreground, on a timer, or in response to a push notification:","type":"text"}],"type":"paragraph"},{"code":["try await ensemble?.sync()"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"A sync downloads remote events, replays them into the local store, and uploads new local events. Sync errors are usually transient — just retry later.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Handle the Delegate","type":"heading","anchor":"Handle-the-Delegate"},{"inlineContent":[{"text":"Implement ","type":"text"},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleDelegate","isActive":true,"type":"reference"},{"text":" to respond to sync events. The most important method merges remote changes into your main context:","type":"text"}],"type":"paragraph"},{"code":["extension AppDelegate: CoreDataEnsembleDelegate {","    func coreDataEnsemble(","        _ ensemble: CoreDataEnsemble,","        didSaveMergeChangesWith notification: Notification","    ) {","        viewContext.perform {","            self.viewContext.mergeChanges(fromContextDidSave: notification)","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"type":"aside","style":"tip","name":"Tip","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If your "},{"type":"codeVoice","code":"NSManagedObject"},{"type":"text","text":" subclasses conform to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable"},{"type":"text","text":", you don’t need to implement "},{"type":"codeVoice","code":"globalIdentifiersForManagedObjects"},{"type":"text","text":" — the ensemble discovers identifier properties automatically. You only need the delegate method if you use "},{"type":"codeVoice","code":"CoreDataEnsemble"},{"type":"text","text":" directly without "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleContainer","isActive":true},{"type":"text","text":"."}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Other delegate methods let you:"}]},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Inspect and repair merge data","type":"text"}],"type":"strong"},{"text":" before it’s committed (","type":"text"},{"type":"codeVoice","code":"shouldSaveMergedChangesIn:reparationContext:"},{"type":"text","text":")"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Handle save failures"}]},{"type":"text","text":" during merging ("},{"code":"didFailToSaveMergedChangesIn:error:reparationContext:","type":"codeVoice"},{"type":"text","text":")"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"React to forced detaches"}]},{"type":"text","text":" caused by identity changes or data corruption ("},{"code":"didDetachWithError:","type":"codeVoice"},{"type":"text","text":")"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"See ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/ConflictResolution"},{"type":"text","text":" for more on conflict handling and the reparation context."}]},{"anchor":"Detach","type":"heading","level":3,"text":"Detach"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To stop syncing, detach from the cloud:"}]},{"syntax":"swift","type":"codeListing","code":["try await ensemble?.detachPersistentStore()"]},{"inlineContent":[{"text":"This removes local sync data (event logs and metadata). The persistent store itself is not affected. You can re-attach later to resume syncing.","type":"text"}],"type":"paragraph"},{"type":"heading","anchor":"Seed-Policies","text":"Seed Policies","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SeedPolicy","isActive":true},{"type":"text","text":" parameter controls how existing data in the store is handled during attachment:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SeedPolicy\/mergeAllData"},{"type":"text","text":" (default) — Imports local data so it can be merged with data from other devices."}]}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SeedPolicy\/excludeLocalData","isActive":true},{"type":"text","text":" — Ignores local data. Use this when you want to start fresh from cloud data."}],"type":"paragraph"}]}]},{"text":"Sync Options","type":"heading","level":3,"anchor":"Sync-Options"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For advanced control, pass "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SyncOptions","isActive":true},{"type":"text","text":":"}]},{"code":["\/\/ Download only — don't integrate or upload","try await ensemble?.sync(options: .cloudFileRetrievalOnly)","","\/\/ Force a rebase to compact sync history","try await ensemble?.sync(options: .forceRebase)"],"type":"codeListing","syntax":"swift"},{"text":"Process Pending Changes","type":"heading","level":2,"anchor":"Process-Pending-Changes"},{"type":"paragraph","inlineContent":[{"type":"text","text":"On iOS, the app may be suspended before Ensembles finishes recording a save. Call "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/processPendingChanges()","isActive":true},{"type":"text","text":" — for example, in a background task — to ensure all changes are fully stored:"}]},{"code":["try await ensemble?.processPendingChanges()"],"type":"codeListing","syntax":"swift"},{"text":"Monitor Activity","type":"heading","level":2,"anchor":"Monitor-Activity"},{"type":"paragraph","inlineContent":[{"text":"Track long-running operations via ","type":"text"},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/currentActivity","isActive":true},{"text":" and ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/activityProgress"},{"text":", or observe these notifications:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"coreDataEnsembleDidBeginActivity","type":"codeVoice"},{"type":"text","text":" — An activity started"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"coreDataEnsembleDidMakeProgressWithActivity","type":"codeVoice"},{"text":" — Progress updated (includes ","type":"text"},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SyncingPhase","isActive":true,"type":"reference"},{"type":"text","text":" or "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/AttachingPhase","type":"reference","isActive":true},{"type":"text","text":")"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"coreDataEnsembleWillEndActivity","type":"codeVoice"},{"type":"text","text":" — An activity finished (may include an error)"}]}]}]}]}],"references":{"doc://Ensembles/documentation/Ensembles/AutoSyncPolicy":{"abstract":[{"text":"Controls when automatic merges occur.","type":"text"}],"kind":"symbol","navigatorTitle":[{"text":"AutoSyncPolicy","kind":"identifier"}],"title":"AutoSyncPolicy","url":"\/do