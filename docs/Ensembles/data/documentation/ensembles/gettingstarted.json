{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Ensembles\/documentation\/Ensembles\/GettingStarted"},"kind":"article","abstract":[{"text":"Set up Ensembles to sync a Core Data or SwiftData persistent store across devices.","type":"text"}],"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"title":"Getting Started","modules":[{"name":"Ensembles"}],"roleHeading":"Article","role":"article"},"hierarchy":{"paths":[["doc:\/\/Ensembles\/documentation\/Ensembles"]]},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"text":"Ensembles synchronizes SQLite stores by recording local changes as events and exchanging them through a cloud backend. It works with both Core Data and SwiftData.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Using SwiftData?","type":"text"}]},{"text":" See ","type":"text"},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SwiftDataIntegration","isActive":true},{"text":" for a complete guide — you never need to touch Core Data directly.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"This guide covers Core Data setup, starting with a complete working example using ","type":"text"},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleContainer","isActive":true},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Add-Ensembles-to-Your-Project","text":"Add Ensembles to Your Project","type":"heading","level":2},{"inlineContent":[{"text":"Add the Ensembles package to your ","type":"text"},{"code":"Package.swift","type":"codeVoice"},{"text":" or via Xcode’s package dependencies:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["https:\/\/github.com\/mentalfaculty\/Ensembles-3.git"],"syntax":null},{"inlineContent":[{"text":"Import the core module and one cloud backend:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["import Ensembles","import EnsemblesCloudKit   \/\/ or EnsemblesLocalFile, EnsemblesMemory"],"syntax":"swift"},{"anchor":"Complete-Example-Core-Data-with-CloudKit","text":"Complete Example: Core Data with CloudKit","type":"heading","level":2},{"inlineContent":[{"text":"Here’s a complete, working setup for a SwiftUI app that syncs via CloudKit. This uses ","type":"text"},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleContainer","isActive":true},{"text":", which creates the Core Data stack for you and syncs automatically.","type":"text"}],"type":"paragraph"},{"anchor":"1-Create-Your-Core-Data-Model","text":"1. Create Your Core Data Model","type":"heading","level":3},{"inlineContent":[{"text":"In Xcode, add a ","type":"text"},{"code":".xcdatamodeld","type":"codeVoice"},{"text":" file to your project (e.g., ","type":"text"},{"type":"strong","inlineContent":[{"text":"Model.xcdatamodeld","type":"text"}]},{"text":"). Define your entities as usual. For this example, we’ll assume a ","type":"text"},{"code":"Note","type":"codeVoice"},{"text":" entity with ","type":"text"},{"code":"title","type":"codeVoice"},{"text":" (String) and ","type":"text"},{"code":"uniqueID","type":"codeVoice"},{"type":"text","text":" (String) attributes."}],"type":"paragraph"},{"anchor":"2-Define-Your-Model-with-Syncable","type":"heading","level":3,"text":"2. Define Your Model with `Syncable`"},{"inlineContent":[{"type":"text","text":"For deduplication, conform your "},{"type":"codeVoice","code":"NSManagedObject"},{"type":"text","text":" subclass to the "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable","isActive":true},{"type":"text","text":" protocol and specify which property holds the global identifier. A UUID assigned at creation time is usually the best choice:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import CoreData","import Ensembles","","class Note: NSManagedObject, Syncable {","    static let globalIdentifierKey = \"uniqueID\"","    @NSManaged var uniqueID: String","    @NSManaged var title: String","}"]},{"style":"important","content":[{"inlineContent":[{"type":"text","text":"A global identifier "},{"inlineContent":[{"type":"text","text":"must never change"}],"type":"strong"},{"text":" once it has been assigned. Changing it after sync has begun will cause duplicates or data loss.","type":"text"}],"type":"paragraph"}],"type":"aside","name":"Important"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use a fixed, meaningful value instead of a UUID for singleton objects or reference data like tags, where two devices might independently create the same logical object."}]},{"anchor":"3-Set-Up-the-Container","type":"heading","level":3,"text":"3. Set Up the Container"},{"syntax":"swift","code":["import SwiftUI","import Ensembles","import EnsemblesCloudKit","","@main","struct MyApp: App {","    let syncContainer: CoreDataEnsembleContainer","","    init() {","        \/\/ The model URL points to the .momd bundle compiled from your .xcdatamodeld","        let modelURL = Bundle.main.url(forResource: \"Model\", withExtension: \"momd\")!","","        \/\/ This creates a full Core Data stack automatically:","        \/\/ - SQLite store at Application Support\/MyNotes.sqlite","        \/\/ - Main-queue viewContext for your UI","        \/\/ - Auto-sync on save, on app activation, and on a 5-minute timer","        let container = CoreDataEnsembleContainer(","            name: \"MyNotes\",","            modelURL: modelURL,","            cloudFileSystem: CloudKitFileSystem(","                privateDatabaseForUbiquityContainerIdentifier: \"iCloud.com.example.mynotes\",","                schemaVersion: .v2","            )","        )!","","        self.syncContainer = container","    }","","    var body: some Scene {","        WindowGroup {","            ContentView()","                .environment(","                    \\.managedObjectContext,","                    syncContainer.viewContext","                )","        }","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"That’s the complete setup. The container discovers "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable"},{"type":"text","text":" conformances automatically, attaches to the cloud, and begins syncing. Remote changes are merged into "},{"code":"viewContext","type":"codeVoice"},{"type":"text","text":" so your UI stays up to date."}]},{"text":"4. Respond to Events (Optional)","type":"heading","level":3,"anchor":"4-Respond-to-Events-Optional"},{"syntax":"swift","code":["\/\/ Called after remote changes are merged into viewContext","container.didSaveMergeChanges = { notification in","    print(\"Merged remote changes\")","}","","\/\/ Called if a sync fails","container.didEncounterError = { error in","    print(\"Sync error: \\(error)\")","}"],"type":"codeListing"},{"text":"Using a Custom Store Location","type":"heading","level":2,"anchor":"Using-a-Custom-Store-Location"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you need control over where the SQLite file lives, pass an explicit "},{"code":"storeURL","type":"codeVoice"},{"type":"text","text":":"}]},{"syntax":"swift","code":["let appSupport = FileManager.default.urls(","    for: .applicationSupportDirectory, in: .userDomainMask",").first!","let storeURL = appSupport.appendingPathComponent(\"MyApp\/data.sqlite\")","try FileManager.default.createDirectory(","    at: storeURL.deletingLastPathComponent(),","    withIntermediateDirectories: true",")","","let container = CoreDataEnsembleContainer(","    name: \"MyNotes\",","    storeURL: storeURL,","    modelURL: Bundle.main.url(forResource: \"Model\", withExtension: \"momd\")!,","    cloudFileSystem: CloudKitFileSystem(","        privateDatabaseForUbiquityContainerIdentifier: \"iCloud.com.example.mynotes\",","        schemaVersion: .v2","    )",")!"],"type":"codeListing"},{"text":"Working with an Existing Core Data Stack","type":"heading","level":2,"anchor":"Working-with-an-Existing-Core-Data-Stack"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you already have an "},{"code":"NSPersistentContainer","type":"codeVoice"},{"type":"text","text":", pass it in directly:"}]},{"syntax":"swift","code":["let container = CoreDataEnsembleContainer(","    persistentContainer: myPersistentContainer,","    cloudFileSystem: cloudFS",")"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Or if you have an existing "},{"code":"NSManagedObjectContext","type":"codeVoice"},{"type":"text","text":":"}]},{"syntax":"swift","code":["let container = CoreDataEnsembleContainer(","    name: \"MyNotes\",","    viewContext: myContext,","    persistentStoreURL: myStoreURL,","    managedObjectModel: myContext.persistentStoreCoordinator!.managedObjectModel,","    managedObjectModels: nil,","    cloudFileSystem: cloudFS",")"],"type":"codeListing"},{"text":"Auto-Sync Configuration","type":"heading","level":2,"anchor":"Auto-Sync-Configuration"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Control when syncing occurs with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/AutoSyncPolicy"},{"type":"text","text":":"}]},{"syntax":"swift","code":["let config = EnsembleContainerConfiguration(","    autoSyncPolicy: [.onSave, .onTimer],   \/\/ Sync on save and timer, not on activation","    timerInterval: 30                       \/\/ Timer fires every 30 seconds",")","let container = CoreDataEnsembleContainer(","    name: \"MyNotes\",","    modelURL: modelURL,","    cloudFileSystem: cloudFS,","    configuration: config",")"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Set "},{"code":"autoSyncPolicy","type":"codeVoice"},{"type":"text","text":" to "},{"code":".manual","type":"codeVoice"},{"type":"text","text":" and call "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleContainer\/sync()"},{"type":"text","text":" yourself for full control over timing."}]},{"text":"Backward Compatibility with Ensembles 2","type":"heading","level":2,"anchor":"Backward-Compatibility-with-Ensembles-2"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you’re transitioning from Ensembles 2 and some users may still be on E2, set the compatibility mode:"}]},{"syntax":"swift","code":["let config = EnsembleContainerConfiguration(","    compatibilityMode: .ensembles2Compatible",")"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This restricts exports to formats that Ensembles 2 peers can parse. Switch to "},{"code":".ensembles3","type":"codeVoice"},{"type":"text","text":" (the default) once all users have upgraded."}]},{"text":"The Manual Way: CoreDataEnsemble","type":"heading","level":2,"anchor":"The-Manual-Way-CoreDataEnsemble"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For more control over the sync lifecycle, use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble"},{"type":"text","text":" directly. This is useful when you need to manage attach\/detach timing, handle specific delegate methods, or integrate with a complex Core Data stack."}]},{"text":"Create and Attach","type":"heading","level":3,"anchor":"Create-and-Attach"},{"syntax":"swift","type":"codeListing","code":["import Ensembles","import EnsemblesCloudKit","","\/\/ Get the store URL from your persistent store coordinator","let store = persistentStoreCoordinator.persistentStores.first!","let storeURL = store.url!","let modelURL = Bundle.main.url(forResource: \"Model\", withExtension: \"momd\")!","","let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MyNotes\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: CloudKitFileSystem(","        privateDatabaseForUbiquityContainerIdentifier: \"iCloud.com.example.mynotes\",","        schemaVersion: .v2","    )",")","ensemble?.delegate = self","","\/\/ Attach registers this device in the cloud","try await ensemble?.attachPersistentStore()"]},{"inlineContent":[{"type":"text","text":"The "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/ensembleIdentifier","isActive":true,"type":"reference"},{"type":"text","text":" must be the same on all devices that should sync together. If you have multiple persistent stores, create one ensemble per store with a unique identifier."}],"type":"paragraph"},{"style":"important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Avoid saving to the persistent store while attaching. If a save is detected, attachment will fail with an error and you will need to retry."}]}],"type":"aside","name":"Important"},{"text":"Sync Changes","type":"heading","level":3,"anchor":"Sync-Changes"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Call "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/sync(options:)","type":"reference","isActive":true},{"type":"text","text":" periodically — for example, when the app enters the foreground, on a timer, or in response to a push notification:"}]},{"syntax":"swift","type":"codeListing","code":["try await ensemble?.sync()"]},{"type":"paragraph","inlineContent":[{"text":"A sync downloads remote events, replays them into the local store, and uploads new local events. Sync errors are usually transient — just retry later.","type":"text"}]},{"text":"Handle the Delegate","type":"heading","level":3,"anchor":"Handle-the-Delegate"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Implement "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleDelegate","isActive":true,"type":"reference"},{"type":"text","text":" to respond to sync events. The most important method merges remote changes into your main context:"}]},{"syntax":"swift","code":["extension AppDelegate: CoreDataEnsembleDelegate {","    func coreDataEnsemble(","        _ ensemble: CoreDataEnsemble,","        didSaveMergeChangesWith notification: Notification","    ) {","        viewContext.perform {","            self.viewContext.mergeChanges(fromContextDidSave: notification)","        }","    }","}"],"type":"codeListing"},{"style":"tip","content":[{"inlineContent":[{"text":"If your ","type":"text"},{"code":"NSManagedObject","type":"codeVoice"},{"text":" subclasses conform to ","type":"text"},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable","isActive":true},{"type":"text","text":", you don’t need to implement "},{"code":"globalIdentifiersForManagedObjects","type":"codeVoice"},{"type":"text","text":" — the ensemble discovers identifier properties automatically. You only need the delegate method if you use "},{"type":"codeVoice","code":"CoreDataEnsemble"},{"type":"text","text":" directly without "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleContainer","isActive":true},{"text":".","type":"text"}],"type":"paragraph"}],"type":"aside","name":"Tip"},{"inlineContent":[{"text":"Other delegate methods let you:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Inspect and repair merge data","type":"text"}]},{"type":"text","text":" before it’s committed ("},{"type":"codeVoice","code":"shouldSaveMergedChangesIn:reparationContext:"},{"type":"text","text":")"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Handle save failures","type":"text"}],"type":"strong"},{"type":"text","text":" during merging ("},{"code":"didFailToSaveMergedChangesIn:error:reparationContext:","type":"codeVoice"},{"type":"text","text":")"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"React to forced detaches","type":"text"}],"type":"strong"},{"type":"text","text":" caused by identity changes or data corruption ("},{"code":"didDetachWithError:","type":"codeVoice"},{"type":"text","text":")"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"See ","type":"text"},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/ConflictResolution","type":"reference","isActive":true},{"text":" for more on conflict handling and the reparation context.","type":"text"}],"type":"paragraph"},{"anchor":"Detach","type":"heading","level":3,"text":"Detach"},{"inlineContent":[{"type":"text","text":"To stop syncing, detach from the cloud:"}],"type":"paragraph"},{"syntax":"swift","code":["try await ensemble?.detachPersistentStore()"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This removes local sync data (event logs and metadata). The persistent store itself is not affected. You can re-attach later to resume syncing."}]},{"anchor":"Seed-Policies","type":"heading","level":3,"text":"Seed Policies"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SeedPolicy","isActive":true,"type":"reference"},{"type":"text","text":" parameter controls how existing data in the store is handled during attachment:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SeedPolicy\/mergeAllData","type":"reference","isActive":true},{"text":" (default) — Imports local data so it can be merged with data from other devices.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SeedPolicy\/excludeLocalData","isActive":true},{"text":" — Ignores local data. Use this when you want to start fresh from cloud data.","type":"text"}],"type":"paragraph"}]}]},{"anchor":"Sync-Options","type":"heading","level":3,"text":"Sync Options"},{"inlineContent":[{"type":"text","text":"For advanced control, pass "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SyncOptions"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Download only — don't integrate or upload","try await ensemble?.sync(options: .cloudFileRetrievalOnly)","","\/\/ Force a rebase to compact sync history","try await ensemble?.sync(options: .forceRebase)"],"type":"codeListing"},{"anchor":"Process-Pending-Changes","type":"heading","level":2,"text":"Process Pending Changes"},{"inlineContent":[{"text":"On iOS, the app may be suspended before Ensembles finishes recording a save. Call ","type":"text"},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/processPendingChanges()","type":"reference","isActive":true},{"text":" — for example, in a background task — to ensure all changes are fully stored:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["try await ensemble?.processPendingChanges()"],"type":"codeListing"},{"anchor":"Monitor-Activity","type":"heading","level":2,"text":"Monitor Activity"},{"inlineContent":[{"text":"Track long-running operations via ","type":"text"},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/currentActivity","type":"reference","isActive":true},{"text":" and ","type":"text"},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/activityProgress","type":"reference","isActive":true},{"text":", or observe these notifications:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"coreDataEnsembleDidBeginActivity","type":"codeVoice"},{"type":"text","text":" — An activity started"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"coreDataEnsembleDidMakeProgressWithActivity","type":"codeVoice"},{"type":"text","text":" — Progress updated (includes "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SyncingPhase","isActive":true,"type":"reference"},{"type":"text","text":" or "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/AttachingPhase","isActive":true,"type":"reference"},{"type":"text","text":")"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"coreDataEnsembleWillEndActivity","type":"codeVoice"},{"type":"text","text":" — An activity finished (may include an error)"}]}]}],"type":"unorderedList"}]}],"seeAlsoSections":[{"generated":true,"title":"Essentials","anchor":"Essentials","identifiers":["doc:\/\/Ensembles\/documentation\/Ensembles\/SwiftDataIntegration","doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleContainer","doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble","doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleDelegate"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ensembles\/gettingstarted"]}],"references":{"doc://Ensembles/documentation/Ensembles/CoreDataEnsemble":{"role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CoreDataEnsemble","kind":"identifier"}],"url":"\/documentation\/ensembles\/coredataensemble","kind":"symbol","abstract":[{"type":"text","text":"The central class of Ensembles, representing a set of synchronizing persistent stores."}],"navigatorTitle":[{"text":"CoreDataEnsemble","kind":"identifier"}],"title":"CoreDataEnsemble","type":"topic","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble"},"doc://Ensembles/documentation/Ensembles/SwiftDataIntegration":{"role":"article","title":"SwiftData Integration","type":"topic","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SwiftDataIntegration","url":"\/documentation\/ensembles\/swiftdataintegration","abstract":[{"type":"text","text":"Sync SwiftData models with Ensembles using "},{"type":"codeVoice","code":"SwiftDataEnsembleContainer"},{"type":"text","text":"."}],"kind":"article"},"doc://Ensembles/documentation/Ensembles/CoreDataEnsemble/activityProgress":{"abstract":[{"text":"The progress of the current activity, as a fraction between 0.0 and 1.0.","type":"text"}],"title":"activityProgress","kind":"symbol","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/activityProgress","url":"\/documentation\/ensembles\/coredataensemble\/activityprogress","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"activityProgress"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sf","text":"Float"}],"role":"symbol","type":"topic"},"doc://Ensembles/documentation/Ensembles/CoreDataEnsemble/processPendingChanges()":{"abstract":[{"text":"Flushes any queued operations and ensures all event data is saved to disk.","type":"text"}],"title":"processPendingChanges()","kind":"symbol","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/processPendingChanges()","url":"\/documentation\/ensembles\/coredataensemble\/processpendingchanges()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"processPendingChanges"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"}],"role":"symbol","type":"topic"},"doc://Ensembles/documentation/Ensembles/SeedPolicy/mergeAllData":{"abstract":[{"text":"Import the local store contents and merge them with cloud data at the next merge.","type":"text"}],"title":"SeedPolicy.mergeAllData","kind":"symbol","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SeedPolicy\/mergeAllData","url":"\/documentation\/ensembles\/seedpolicy\/mergealldata","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"mergeAllData"}],"role":"symbol","type":"topic"},"doc://Ensembles/documentation/Ensembles/CoreDataEnsembleContainer/sync()":{"abstract":[{"text":"Attach if needed and merge changes with peers.","type":"text"}],"title":"sync()","kind":"symbol","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleContainer\/sync()","url":"\/documentation\/ensembles\/coredataensemblecontainer\/sync()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"sync"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"role":"symbol","type":"topic"},"doc://Ensembles/documentation/Ensembles/Syncable":{"navigatorTitle":[{"text":"Syncable","kind":"identifier"}],"role":"symbol","title":"Syncable","type":"topic","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable","url":"\/documentation\/ensembles\/syncable","abstract":[{"type":"text","text":"A protocol for model types that declare how to derive a global identifier"},{"type":"text","text":" "},{"type":"text","text":"for Ensembles deduplication."}],"kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Syncable","kind":"identifier"}]},"doc://Ensembles/documentation/Ensembles":{"role":"collection","abstract":[{"type":"text","text":"Sync Core Data and SwiftData stores across devices using event sourcing."}],"url":"\/documentation\/ensembles","kind":"symbol","title":"Ensembles","type":"topic","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles"},"doc://Ensembles/documentation/Ensembles/SeedPolicy/excludeLocalData":{"abstract":[{"text":"Do not import local data. You will usually want to delete the store before attaching.","type":"text"}],"title":"SeedPolicy.excludeLocalData","kind":"symbol","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SeedPolicy\/excludeLocalData","url":"\/documentation\/ensembles\/seedpolicy\/excludelocaldata","