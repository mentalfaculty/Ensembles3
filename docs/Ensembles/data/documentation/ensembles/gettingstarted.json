{"variants":[{"paths":["\/documentation\/ensembles\/gettingstarted"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Ensembles synchronizes SQLite stores by recording local changes as events and exchanging them through a cloud backend. It works with both Core Data and SwiftData.","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Using SwiftData?","type":"text"}],"type":"strong"},{"text":" See ","type":"text"},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SwiftDataIntegration","isActive":true,"type":"reference"},{"text":" for a complete guide — you never need to touch Core Data directly.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"This guide covers Core Data setup, starting with a complete working example using ","type":"text"},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleContainer","isActive":true,"type":"reference"},{"text":".","type":"text"}]},{"type":"heading","anchor":"Develop-with-Claude-Code","level":2,"text":"Develop with Claude Code"},{"type":"paragraph","inlineContent":[{"text":"If you use ","type":"text"},{"identifier":"https:\/\/claude.com\/claude-code","isActive":true,"type":"reference"},{"text":", install the Ensembles skill first. It teaches Claude the API, the cloud backends, Ensembles 2 → 3 migration, the seed policy, and the common pitfalls, so it writes correct setup code and diagnoses sync issues without hand-holding:","type":"text"}]},{"syntax":null,"type":"codeListing","code":["\/plugin marketplace add mentalfaculty\/Ensembles3","\/plugin install ensembles@ensembles"]},{"type":"heading","anchor":"Add-Ensembles-to-Your-Project","level":2,"text":"Add Ensembles to Your Project"},{"type":"paragraph","inlineContent":[{"text":"Add the Ensembles package to your ","type":"text"},{"code":"Package.swift","type":"codeVoice"},{"text":" or via Xcode’s package dependencies:","type":"text"}]},{"syntax":null,"type":"codeListing","code":["https:\/\/github.com\/mentalfaculty\/Ensembles-3.git"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Import the core module and one cloud backend:"}]},{"type":"codeListing","code":["import Ensembles","import EnsemblesCloudKit   \/\/ or EnsemblesLocalFile, EnsemblesMemory"],"syntax":"swift"},{"type":"heading","level":2,"anchor":"Complete-Example-Core-Data-with-CloudKit","text":"Complete Example: Core Data with CloudKit"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Here’s a complete, working setup for a SwiftUI app that syncs via CloudKit. This uses "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleContainer","isActive":true},{"type":"text","text":", which creates the Core Data stack for you and syncs automatically."}]},{"type":"heading","level":3,"anchor":"1-Create-Your-Core-Data-Model","text":"1. Create Your Core Data Model"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In Xcode, add a "},{"type":"codeVoice","code":".xcdatamodeld"},{"type":"text","text":" file to your project (e.g., "},{"type":"strong","inlineContent":[{"text":"Model.xcdatamodeld","type":"text"}]},{"type":"text","text":"). Define your entities as usual. For this example, we’ll assume a "},{"type":"codeVoice","code":"Note"},{"type":"text","text":" entity with "},{"type":"codeVoice","code":"title"},{"type":"text","text":" (String) and "},{"type":"codeVoice","code":"uniqueID"},{"type":"text","text":" (String) attributes."}]},{"level":3,"anchor":"2-Define-Your-Model-with-Syncable","type":"heading","text":"2. Define Your Model with `Syncable`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For deduplication, conform your "},{"type":"codeVoice","code":"NSManagedObject"},{"type":"text","text":" subclass to the "},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable","type":"reference"},{"type":"text","text":" protocol and specify which property holds the global identifier. A UUID assigned at creation time is usually the best choice:"}]},{"syntax":"swift","code":["import CoreData","import Ensembles","","class Note: NSManagedObject, Syncable {","    static let globalIdentifierKey = \"uniqueID\"","    @NSManaged var uniqueID: String","    @NSManaged var title: String","}"],"type":"codeListing"},{"name":"Important","content":[{"inlineContent":[{"text":"A global identifier ","type":"text"},{"inlineContent":[{"type":"text","text":"must never change"}],"type":"strong"},{"text":" once it has been assigned. Changing it after sync has begun will cause duplicates or data loss.","type":"text"}],"type":"paragraph"}],"type":"aside","style":"important"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use a fixed, meaningful value instead of a UUID for singleton objects or reference data like tags, where two devices might independently create the same logical object."}]},{"level":3,"anchor":"3-Set-Up-the-Container","type":"heading","text":"3. Set Up the Container"},{"syntax":"swift","code":["import SwiftUI","import Ensembles","import EnsemblesCloudKit","","@main","struct MyApp: App {","    let syncContainer: CoreDataEnsembleContainer","","    init() {","        \/\/ The model URL points to the .momd bundle compiled from your .xcdatamodeld","        let modelURL = Bundle.main.url(forResource: \"Model\", withExtension: \"momd\")!","","        \/\/ This creates a full Core Data stack automatically:","        \/\/ - SQLite store at Application Support\/MyNotes.sqlite","        \/\/ - Main-queue viewContext for your UI","        \/\/ - Auto-sync on save, on app activation, and on a 5-minute timer","        let container = CoreDataEnsembleContainer(","            name: \"MyNotes\",","            modelURL: modelURL,","            cloudFileSystem: CloudKitFileSystem(","                privateDatabaseForUbiquityContainerIdentifier: \"iCloud.com.example.mynotes\",","                schemaVersion: .v2","            )","        )!","","        self.syncContainer = container","    }","","    var body: some Scene {","        WindowGroup {","            ContentView()","                .environment(","                    \\.managedObjectContext,","                    syncContainer.viewContext","                )","        }","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"That’s the complete setup. The container discovers "},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable","type":"reference"},{"type":"text","text":" conformances automatically, attaches to the cloud, and begins syncing. Remote changes are merged into "},{"type":"codeVoice","code":"viewContext"},{"type":"text","text":" so your UI stays up to date."}]},{"level":3,"anchor":"4-Respond-to-Events-Optional","type":"heading","text":"4. Respond to Events (Optional)"},{"syntax":"swift","code":["\/\/ Called after remote changes are merged into viewContext","container.didSaveMergeChanges = { notification in","    print(\"Merged remote changes\")","}","","\/\/ Called if a sync fails","container.didEncounterError = { error in","    print(\"Sync error: \\(error)\")","}"],"type":"codeListing"},{"level":2,"anchor":"Using-a-Custom-Store-Location","type":"heading","text":"Using a Custom Store Location"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you need control over where the SQLite file lives, pass an explicit "},{"type":"codeVoice","code":"storeURL"},{"type":"text","text":":"}]},{"syntax":"swift","code":["let appSupport = FileManager.default.urls(","    for: .applicationSupportDirectory, in: .userDomainMask",").first!","let storeURL = appSupport.appendingPathComponent(\"MyApp\/data.sqlite\")","try FileManager.default.createDirectory(","    at: storeURL.deletingLastPathComponent(),","    withIntermediateDirectories: true",")","","let container = CoreDataEnsembleContainer(","    name: \"MyNotes\",","    storeURL: storeURL,","    modelURL: Bundle.main.url(forResource: \"Model\", withExtension: \"momd\")!,","    cloudFileSystem: CloudKitFileSystem(","        privateDatabaseForUbiquityContainerIdentifier: \"iCloud.com.example.mynotes\",","        schemaVersion: .v2","    )",")!"],"type":"codeListing"},{"level":2,"anchor":"Working-with-an-Existing-Core-Data-Stack","type":"heading","text":"Working with an Existing Core Data Stack"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you already have an "},{"type":"codeVoice","code":"NSPersistentContainer"},{"type":"text","text":", pass it in directly:"}]},{"syntax":"swift","code":["let container = CoreDataEnsembleContainer(","    persistentContainer: myPersistentContainer,","    cloudFileSystem: cloudFS",")"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Or if you have an existing "},{"type":"codeVoice","code":"NSManagedObjectContext"},{"type":"text","text":":"}]},{"syntax":"swift","code":["let container = CoreDataEnsembleContainer(","    name: \"MyNotes\",","    viewContext: myContext,","    persistentStoreURL: myStoreURL,","    managedObjectModel: myContext.persistentStoreCoordinator!.managedObjectModel,","    managedObjectModels: nil,","    cloudFileSystem: cloudFS",")"],"type":"codeListing"},{"level":2,"anchor":"Auto-Sync-Configuration","type":"heading","text":"Auto-Sync Configuration"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Control when syncing occurs with "},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/AutoSyncPolicy","type":"reference"},{"type":"text","text":":"}]},{"syntax":"swift","code":["let config = EnsembleContainerConfiguration(","    autoSyncPolicy: [.onSave, .onTimer],   \/\/ Sync on save and timer, not on activation","    timerInterval: 30                       \/\/ Timer fires every 30 seconds",")","let container = CoreDataEnsembleContainer(","    name: \"MyNotes\",","    modelURL: modelURL,","    cloudFileSystem: cloudFS,","    configuration: config",")"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Set "},{"type":"codeVoice","code":"autoSyncPolicy"},{"type":"text","text":" to "},{"type":"codeVoice","code":".manual"},{"type":"text","text":" and call "},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleContainer\/sync()","type":"reference"},{"type":"text","text":" yourself for full control over timing."}]},{"level":2,"anchor":"Backward-Compatibility-with-Ensembles-2","type":"heading","text":"Backward Compatibility with Ensembles 2"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you’re transitioning from Ensembles 2 and some users may still be on E2, set the compatibility mode:"}]},{"syntax":"swift","code":["let config = EnsembleContainerConfiguration(","    compatibilityMode: .ensembles2Compatible",")"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This restricts exports to formats that Ensembles 2 peers can parse. Switch to "},{"type":"codeVoice","code":".ensembles3"},{"type":"text","text":" (the default) once all users have upgraded."}]},{"level":2,"anchor":"The-Manual-Way-CoreDataEnsemble","type":"heading","text":"The Manual Way: CoreDataEnsemble"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For more control over the sync lifecycle, use "},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble","type":"reference"},{"type":"text","text":" directly. This is useful when you need to manage attach\/detach timing, handle specific delegate methods, or integrate with a complex Core Data stack."}]},{"level":3,"anchor":"Create-and-Attach","type":"heading","text":"Create and Attach"},{"syntax":"swift","code":["import Ensembles","import EnsemblesCloudKit","","\/\/ Get the store URL from your persistent store coordinator","let store = persistentStoreCoordinator.persistentStores.first!","let storeURL = store.url!","let modelURL = Bundle.main.url(forResource: \"Model\", withExtension: \"momd\")!","","let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MyNotes\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: CloudKitFileSystem(","        privateDatabaseForUbiquityContainerIdentifier: \"iCloud.com.example.mynotes\",","        schemaVersion: .v2","    )",")","ensemble?.delegate = self","","\/\/ Attach registers this device in the cloud","try await ensemble?.attachPersistentStore()"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/ensembleIdentifier","type":"reference"},{"type":"text","text":" must be the same on all devices that should sync together. If you have multiple persistent stores, create one ensemble per store with a unique identifier."}]},{"name":"Important","content":[{"inlineContent":[{"text":"Avoid saving to the persistent store while attaching. If a save is detected, attachment will fail with an error and you will need to retry.","type":"text"}],"type":"paragraph"}],"type":"aside","style":"important"},{"level":3,"anchor":"Sync-Changes","type":"heading","text":"Sync Changes"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Call "},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/sync(options:)","type":"reference"},{"type":"text","text":" periodically — for example, when the app enters the foreground, on a timer, or in response to a push notification:"}]},{"syntax":"swift","code":["try await ensemble?.sync()"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A sync downloads remote events, replays them into the local store, and uploads new local events. Sync errors are usually transient — just retry later."}]},{"level":3,"anchor":"Handle-the-Delegate","type":"heading","text":"Handle the Delegate"},{"inlineContent":[{"type":"text","text":"Implement "},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleDelegate","type":"reference"},{"type":"text","text":" to respond to sync events. The most important method merges remote changes into your main context:"}],"type":"paragraph"},{"syntax":"swift","code":["extension AppDelegate: CoreDataEnsembleDelegate {","    func coreDataEnsemble(","        _ ensemble: CoreDataEnsemble,","        didSaveMergeChangesWith notification: Notification","    ) {","        viewContext.perform {","            self.viewContext.mergeChanges(fromContextDidSave: notification)","        }","    }","}"],"type":"codeListing"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If your "},{"type":"codeVoice","code":"NSManagedObject"},{"type":"text","text":" subclasses conform to "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable","isActive":true},{"type":"text","text":", you don’t need to implement "},{"type":"codeVoice","code":"globalIdentifiersForManagedObjects"},{"type":"text","text":" — the ensemble discovers identifier properties automatically. You only need the delegate method if you use "},{"type":"codeVoice","code":"CoreDataEnsemble"},{"type":"text","text":" directly without "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleContainer","isActive":true},{"type":"text","text":"."}]}],"name":"Tip","type":"aside","style":"tip"},{"inlineContent":[{"type":"text","text":"Other delegate methods let you:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Inspect and repair merge data"}]},{"type":"text","text":" before it’s committed ("},{"type":"codeVoice","code":"shouldSaveMergedChangesIn:reparationContext:"},{"type":"text","text":")"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Handle save failures","type":"text"}],"type":"strong"},{"type":"text","text":" during merging ("},{"code":"didFailToSaveMergedChangesIn:error:reparationContext:","type":"codeVoice"},{"text":")","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"React to forced detaches"}],"type":"strong"},{"type":"text","text":" caused by identity changes or data corruption ("},{"code":"didDetachWithError:","type":"codeVoice"},{"type":"text","text":")"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/ConflictResolution","type":"reference"},{"text":" for more on conflict handling and the reparation context.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Detach","anchor":"Detach","type":"heading"},{"inlineContent":[{"text":"To stop syncing, detach from the cloud:","type":"text"}],"type":"paragraph"},{"code":["try await ensemble?.detachPersistentStore()"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"This removes local sync data (event logs and metadata). The persistent store itself is not affected. You can re-attach later to resume syncing.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Seed Policies","anchor":"Seed-Policies","type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SeedPolicy","type":"reference","isActive":true},{"type":"text","text":" parameter controls how existing data in the store is handled during attachment:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SeedPolicy\/mergeAllData","type":"reference"},{"text":" (default) — Imports local data so it can be merged with data from other devices.","type":"text"}]}]},{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SeedPolicy\/excludeLocalData","type":"reference"},{"type":"text","text":" — Ignores local data. Use this when you want to start fresh from cloud data."}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":3,"anchor":"Sync-Options","type":"heading","text":"Sync Options"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For advanced control, pass "},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SyncOptions","type":"reference"},{"type":"text","text":":"}]},{"syntax":"swift","code":["\/\/ Download only — don't integrate or upload","try await ensemble?.sync(options: .cloudFileRetrievalOnly)","","\/\/ Force a rebase to compact sync history","try await ensemble?.sync(options: .forceRebase)"],"type":"codeListing"},{"level":2,"anchor":"Process-Pending-Changes","type":"heading","text":"Process Pending Changes"},{"type":"paragraph","inlineContent":[{"type":"text","text":"On iOS, the app may be suspended before Ensembles finishes recording a save. Call "},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/processPendingChanges()","type":"reference"},{"type":"text","text":" — for example, in a background task — to ensure all changes are fully stored:"}]},{"syntax":"swift","code":["try await ensemble?.processPendingChanges()"],"type":"codeListing"},{"level":2,"anchor":"Monitor-Activity","type":"heading","text":"Monitor Activity"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Track long-running operations via "},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/currentActivity","type":"reference"},{"type":"text","text":" and "},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/activityProgress","type":"reference"},{"type":"text","text":", or observe these notifications:"}]},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"coreDataEnsembleDidBeginActivity"},{"type":"text","text":" — An activity started"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"coreDataEnsembleDidMakeProgressWithActivity"},{"type":"text","text":" — Progress updated (includes "},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SyncingPhase","type":"reference"},{"type":"text","text":" or "},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/AttachingPhase","type":"reference"},{"type":"text","text":")"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"coreDataEnsembleWillEndActivity"},{"type":"text","text":" — An activity finished (may include an error)"}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Ensembles\/documentation\/Ensembles"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Ensembles\/documentation\/Ensembles\/GettingStarted"},"kind":"article","sections":[],"metadata":{"title":"Getting Started","roleHeading":"Article","role":"article","modules":[{"name":"Ensembles"}]},"abstract":[{"text":"Set up Ensembles to sync a Core Data or SwiftData persistent store across devices.","type":"text"}],"seeAlsoSections":[{"anchor":"Essentials","generated":true,"title":"Essentials","identifiers":["doc:\/\/Ensembles\/documentation\/Ensembles\/SwiftDataIntegration","doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleContainer","doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble","doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleDelegate"]}],"references":{"doc://Ensembles/documentation/Ensembles/Syncable":{"type":"topic","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable","url":"\/documentation\/ensembles\/syncable","title":"Syncable","abstract":[{"type":"text","text":"A protocol for model types that declare how to derive a global identifier"},{"type":"text","text":" "},{"type":"text","text":"for Ensembles deduplication."}],"role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Syncable","kind":"identifier"}],"navigatorTitle":[{"text":"Syncable","kind":"identifier"}],"kind":"symbol"},"doc://Ensembles/documentation/Ensembles/CoreDataEnsemble/currentActivity":{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/currentActivity","url":"\/documentation\/ensembles\/coredataensemble\/currentactivity","kind":"symbol","abstract":[{"type":"text","text":"The activity currently being undertaken, if any."}],"title":"currentActivity","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"currentActivity","kind":"identifier"},{"text":": ","kind":"text"},{"text":"EnsembleActivity","kind":"typeIdentifier","preciseIdentifier":"s:9Ensembles16EnsembleActivityO"}],"type":"topic"},"doc://Ensembles/documentation/Ensembles/SeedPolicy/excludeLocalData":{"abstract":[{"type":"text","text":"Do not import local data. You will usually want to delete the store before attaching."}],"type":"topic","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"excludeLocalData","kind":"identifier"}],"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SeedPolicy\/excludeLocalData","role":"symbol","title":"SeedPolicy.excludeLocalData","kind":"symbol","url":"\/documentation\/ensembles\/seedpolicy\/excludelocaldata"},"doc://Ensembles/documentation/Ensembles/CoreDataEnsemble/sync(options:)":{"url":"\/documentation\/ensembles\/coredataensemble\/sync(options:)","type":"topic","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/sync(options:)","title":"sync(options:)","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"sync"},{"kind":"text","text":"("},{"kind":"externalParam","text":"options"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:9Ensembles11SyncOptionsV","text":"SyncOptions"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"}],"abstract":[{"type":"text","text":"Syncs changes with other peers."}]},"doc://Ensembles/documentation/Ensembles/SeedPolicy/mergeAllData":{"url":"\/documentation\/ensembles\/seedpolicy\/mergealldata","type":"topic","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SeedPolicy\/mergeAllData","title":"SeedPolicy.mergeAllData","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"mergeAllData"}],"abstract":[{"text":"Import the local store contents and merge them with cloud data at the next merge.","type":"text"}]},"doc://Ensembles/documentation/Ensembles/AttachingPhase":{"type":"topic","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/AttachingPhase","url":"\/documentation\/ensembles\/attachingphase","title":"AttachingPhase","abstract":[{"type":"text","text":"The phase of an attach operation currently in progress."}],"role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"AttachingPhase"}],"navigatorTitle":[{"kind":"identifier","text":"AttachingPhase"}],"kind":"symbol"},"doc://Ensembles/documentation/Ensembles/SyncingPhase":{"type":"topic","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SyncingPhase","url":"\/documentation\/ensembles\/syncingphase","title":"SyncingPhase","abstract":[{"type":"text","text":"The phase of a sync operation currently in progress."}],"role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SyncingPhase","kind":"identifier"}],"navigatorTitle":[{"text":"SyncingPhase","kind":"identifier"}],"kind":"symbol"},"doc://Ensembles/documentation/Ensembl