Identifier":"s:SS","text":"String"}],"type":"topic"},"doc://Ensembles/documentation/Ensembles/Syncable":{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable","kind":"symbol","role":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Syncable"}],"url":"\/documentation\/ensembles\/syncable","title":"Syncable","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Syncable"}],"abstract":[{"type":"text","text":"A protocol for model types that declare how to derive a global identifier"},{"type":"text","text":" "},{"type":"text","text":"for Ensembles deduplication."}]},"doc://Ensembles/documentation/Ensembles/CoreDataEnsemble":{"url":"\/documentation\/ensembles\/coredataensemble","title":"CoreDataEnsemble","role":"symbol","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble","type":"topic","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"CoreDataEnsemble"}],"abstract":[{"type":"text","text":"The central class of Ensembles, representing a set of synchronizing persistent stores."}],"fragments":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"CoreDataEnsemble"}]},"doc://Ensembles/documentation/Ensembles/CoreDataEnsemble/activityProgress":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"activityProgress"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sf","text":"Float"}],"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/activityProgress","title":"activityProgress","type":"topic","abstract":[{"text":"The progress of the current activity, as a fraction between 0.0 and 1.0.","type":"text"}],"role":"symbol","url":"\/documentation\/ensembles\/coredataensemble\/activityprogress","kind":"symbol"},"doc://Ensembles/documentation/Ensembles/SeedPolicy/mergeAllData":{"fragments":[{"text":"case","kind":"keyword"},{"tex