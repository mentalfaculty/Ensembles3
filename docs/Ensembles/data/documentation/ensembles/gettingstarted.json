{"abstract":[{"type":"text","text":"Set up Ensembles to sync a Core Data or SwiftData persistent store across devices."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ensembles\/gettingstarted"]}],"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Ensembles synchronizes SQLite stores by recording local changes as events and exchanging them through a cloud backend. It works with both Core Data and SwiftData."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Using SwiftData?"}],"type":"strong"},{"type":"text","text":" See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SwiftDataIntegration"},{"type":"text","text":" for a complete guide — you never need to touch Core Data directly."}]},{"type":"paragraph","inlineContent":[{"text":"This guide covers Core Data setup, starting with a complete working example using ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleContainer"},{"type":"text","text":"."}]},{"text":"Develop with Claude Code","type":"heading","level":2,"anchor":"Develop-with-Claude-Code"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you use "},{"isActive":true,"type":"reference","identifier":"https:\/\/claude.com\/claude-code"},{"text":", install the Ensembles skill first. It teaches Claude the API, the cloud backends, Ensembles 2 → 3 migration, the seed policy, and the common pitfalls, so it writes correct setup code and diagnoses sync issues without hand-holding:","type":"text"}]},{"syntax":null,"type":"codeListing","code":["\/plugin marketplace add mentalfaculty\/Ensembles3","\/plugin install ensembles@ensembles"]},{"type":"heading","level":2,"anchor":"Add-Ensembles-to-Your-Project","text":"Add Ensembles to Your Project"},{"type":"paragraph","inlineContent":[{"text":"Add the Ensembles package to your ","type":"text"},{"code":"Package.swift","type":"codeVoice"},{"type":"text","text":" or via Xcode’s package dependencies:"}]},{"syntax":null,"code":["https:\/\/github.com\/mentalfaculty\/Ensembles3.git"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Import the core module and one cloud backend:"}]},{"type":"codeListing","syntax":"swift","code":["import Ensembles","import EnsemblesCloudKit   \/\/ or EnsemblesLocalFile, EnsemblesMemory"]},{"type":"heading","text":"Complete Example: Core Data with CloudKit","anchor":"Complete-Example-Core-Data-with-CloudKit","level":2},{"type":"paragraph","inlineContent":[{"text":"Here’s a complete, working setup for a SwiftUI app that syncs via CloudKit. This uses ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleContainer"},{"text":", which creates the Core Data stack for you and syncs automatically.","type":"text"}]},{"type":"heading","text":"1. Create Your Core Data Model","anchor":"1-Create-Your-Core-Data-Model","level":3},{"inlineContent":[{"type":"text","text":"In Xcode, add a "},{"type":"codeVoice","code":".xcdatamodeld"},{"type":"text","text":" file to your project (e.g., "},{"type":"strong","inlineContent":[{"type":"text","text":"Model.xcdatamodeld"}]},{"type":"text","text":"). Define your entities as usual. For this example, we’ll assume a "},{"type":"codeVoice","code":"Note"},{"text":" entity with ","type":"text"},{"type":"codeVoice","code":"title"},{"text":" (String) and ","type":"text"},{"code":"uniqueID","type":"codeVoice"},{"text":" (String) attributes.","type":"text"}],"type":"paragraph"},{"level":3,"type":"heading","text":"2. Define Your Model with `Syncable`","anchor":"2-Define-Your-Model-with-Syncable"},{"inlineContent":[{"text":"For deduplication, conform your ","type":"text"},{"type":"codeVoice","code":"NSManagedObject"},{"type":"text","text":" subclass to the "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable","isActive":true},{"type":"text","text":" protocol and specify which property holds the global identifier. A UUID assigned at creation time is usually the best choice:"}],"type":"paragraph"},{"type":"codeListing","code":["import CoreData","import Ensembles","","class Note: NSManagedObject, Syncable {","    static let globalIdentifierKey = \"uniqueID\"","    @NSManaged var uniqueID: String","    @NSManaged var title: String","}"],"syntax":"swift"},{"name":"Important","type":"aside","style":"important","content":[{"type":"paragraph","inlineContent":[{"text":"A global identifier ","type":"text"},{"type":"strong","inlineContent":[{"text":"must never change","type":"text"}]},{"type":"text","text":" once it has been assigned. Changing it after sync has begun will cause duplicates or data loss."}]}]},{"type":"paragraph","inlineContent":[{"text":"Use a fixed, meaningful value instead of a UUID for singleton objects or reference data like tags, where two devices might independently create the same logical object.","type":"text"}]},{"text":"3. Set Up the Container","anchor":"3-Set-Up-the-Container","type":"heading","level":3},{"type":"codeListing","syntax":"swift","code":["import SwiftUI","import Ensembles","import EnsemblesCloudKit","","@main","struct MyApp: App {","    let syncContainer: CoreDataEnsembleContainer","","    init() {","        \/\/ The model URL points to the .momd bundle compiled from your .xcdatamodeld","        let modelURL = Bundle.main.url(forResource: \"Model\", withExtension: \"momd\")!","","        \/\/ This creates a full Core Data stack automatically:","        \/\/ - SQLite store at Application Support\/MyNotes.sqlite","        \/\/ - Main-queue viewContext for your UI","        \/\/ - Auto-sync on save, on app activation, and on a 5-minute timer","        let container = CoreDataEnsembleContainer(","            name: \"MyNotes\",","            modelURL: modelURL,","            cloudFileSystem: CloudKitFileSystem(","                privateDatabaseForUbiquityContainerIdentifier: \"iCloud.com.example.mynotes\",","                schemaVersion: .v2","            )","        )!","","        self.syncContainer = container","    }","","    var body: some Scene {","        WindowGroup {","            ContentView()","                .environment(","                    \\.managedObjectContext,","                    syncContainer.viewContext","                )","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"That’s the complete setup. The container discovers ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable"},{"type":"text","text":" conformances automatically, attaches to the cloud, and begins syncing. Remote changes are merged into "},{"code":"viewContext","type":"codeVoice"},{"type":"text","text":" so your UI stays up to date."}]},{"text":"4. Respond to Events (Optional)","type":"heading","level":3,"anchor":"4-Respond-to-Events-Optional"},{"syntax":"swift","type":"codeListing","code":["\/\/ Called after remote changes are merged into viewContext","container.didSaveMergeChanges = { notification in","    print(\"Merged remote changes\")","}","","\/\/ Called if a sync fails","container.didEncounterError = { error in","    print(\"Sync error: \\(error)\")","}"]},{"type":"heading","anchor":"Using-a-Custom-Store-Location","level":2,"text":"Using a Custom Store Location"},{"inlineContent":[{"type":"text","text":"If you need control over where the SQLite file lives, pass an explicit "},{"type":"codeVoice","code":"storeURL"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let appSupport = FileManager.default.urls(","    for: .applicationSupportDirectory, in: .userDomainMask",").first!","let storeURL = appSupport.appendingPathComponent(\"MyApp\/data.sqlite\")","try FileManager.default.createDirectory(","    at: storeURL.deletingLastPathComponent(),","    withIntermediateDirectories: true",")","","let container = CoreDataEnsembleContainer(","    name: \"MyNotes\",","    storeURL: storeURL,","    modelURL: Bundle.main.url(forResource: \"Model\", withExtension: \"momd\")!,","    cloudFileSystem: CloudKitFileSystem(","        privateDatabaseForUbiquityContainerIdentifier: \"iCloud.com.example.mynotes\",","        schemaVersion: .v2","    )",")!"],"type":"codeListing"},{"text":"Working with an Existing Core Data Stack","anchor":"Working-with-an-Existing-Core-Data-Stack","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"If you already have an "},{"type":"codeVoice","code":"NSPersistentContainer"},{"type":"text","text":", pass it in directly:"}],"type":"paragraph"},{"syntax":"swift","code":["let container = CoreDataEnsembleContainer(","    persistentContainer: myPersistentContainer,","    cloudFileSystem: cloudFS",")"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Or if you have an existing "},{"type":"codeVoice","code":"NSManagedObjectContext"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let container = CoreDataEnsembleContainer(","    name: \"MyNotes\",","    viewContext: myContext,","    persistentStoreURL: myStoreURL,","    managedObjectModel: myContext.persistentStoreCoordinator!.managedObjectModel,","    managedObjectModels: nil,","    cloudFileSystem: cloudFS",")"]},{"anchor":"Auto-Sync-Configuration","type":"heading","level":2,"text":"Auto-Sync Configuration"},{"inlineContent":[{"type":"text","text":"Control when syncing occurs with "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/AutoSyncPolicy","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let config = EnsembleContainerConfiguration(","    autoSyncPolicy: [.onSave, .onTimer],   \/\/ Sync on save and timer, not on activation","    timerInterval: 30                       \/\/ Timer fires every 30 seconds",")","let container = CoreDataEnsembleContainer(","    name: \"MyNotes\",","    modelURL: modelURL,","    cloudFileSystem: cloudFS,","    configuration: config",")"]},{"inlineContent":[{"type":"text","text":"Set "},{"type":"codeVoice","code":"autoSyncPolicy"},{"type":"text","text":" to "},{"type":"codeVoice","code":".manual"},{"type":"text","text":" and call "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleContainer\/sync()","type":"reference","isActive":true},{"type":"text","text":" yourself for full control over timing."}],"type":"paragraph"},{"anchor":"Backward-Compatibility-with-Ensembles-2","type":"heading","level":2,"text":"Backward Compatibility with Ensembles 2"},{"inlineContent":[{"text":"If you’re transitioning from Ensembles 2 and some users may still be on E2, set the compatibility mode:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let config = EnsembleContainerConfiguration(","    compatibilityMode: .ensembles2Compatible",")"]},{"inlineContent":[{"text":"This restricts exports to formats that Ensembles 2 peers can parse. Switch to ","type":"text"},{"type":"codeVoice","code":".ensembles3"},{"text":" (the default) once all users have upgraded.","type":"text"}],"type":"paragraph"},{"anchor":"The-Manual-Way-CoreDataEnsemble","type":"heading","level":2,"text":"The Manual Way: CoreDataEnsemble"},{"inlineContent":[{"type":"text","text":"For more control over the sync lifecycle, use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble"},{"type":"text","text":" directly. This is useful when you need to manage attach\/detach timing, handle specific delegate methods, or integrate with a complex Core Data stack."}],"type":"paragraph"},{"anchor":"Create-and-Attach","type":"heading","level":3,"text":"Create and Attach"},{"syntax":"swift","type":"codeListing","code":["import Ensembles","import EnsemblesCloudKit","","\/\/ Get the store URL from your persistent store coordinator","let store = persistentStoreCoordinator.persistentStores.first!","let storeURL = store.url!","let modelURL = Bundle.main.url(forResource: \"Model\", withExtension: \"momd\")!","","let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MyNotes\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: CloudKitFileSystem(","        privateDatabaseForUbiquityContainerIdentifier: \"iCloud.com.example.mynotes\",","        schemaVersion: .v2","    )",")","ensemble?.delegate = self","","\/\/ Attach registers this device in the cloud","try await ensemble?.attachPersistentStore()"]},{"inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/ensembleIdentifier","isActive":true},{"type":"text","text":" must be the same on all devices that should sync together. If you have multiple persistent stores, create one ensemble per store with a unique identifier."}],"type":"paragraph"},{"name":"Important","type":"aside","style":"important","content":[{"type":"paragraph","inlineContent":[{"text":"Avoid saving to the persistent store while attaching. If a save is detected, attachment will fail with an error and you will need to retry.","type":"text"}]}]},{"level":3,"anchor":"Sync-Changes","type":"heading","text":"Sync Changes"},{"type":"paragraph","inlineContent":[{"text":"Call ","type":"text"},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/sync(options:)","isActive":true,"type":"reference"},{"text":" periodically — for example, when the app enters the foreground, on a timer, or in response to a push notification:","type":"text"}]},{"type":"codeListing","code":["try await ensemble?.sync()"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A sync downloads remote events, replays them into the local store, and uploads new local events. Sync errors are usually transient — just retry later."}]},{"level":3,"anchor":"Handle-the-Delegate","type":"heading","text":"Handle the Delegate"},{"type":"paragraph","inlineContent":[{"text":"Implement ","type":"text"},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleDelegate","type":"reference","isActive":true},{"text":" to respond to sync events. The most important method merges remote changes into your main context:","type":"text"}]},{"type":"codeListing","code":["extension AppDelegate: CoreDataEnsembleDelegate {","    func coreDataEnsemble(","        _ ensemble: CoreDataEnsemble,","        didSaveMergeChangesWith notification: Notification","    ) {","        viewContext.perform {","            self.viewContext.mergeChanges(fromContextDidSave: notification)","        }","    }","}"],"syntax":"swift"},{"type":"aside","style":"tip","content":[{"type":"paragraph","inlineContent":[{"text":"With ","type":"text"},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleContainer","isActive":true},{"text":", ","type":"text"},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable","isActive":true},{"text":" conformances are discovered automatically and no ","type":"text"},{"code":"globalIdentifiersForManagedObjects","type":"codeVoice"},{"text":" implementation is needed. When you use ","type":"text"},{"code":"CoreDataEnsemble","type":"codeVoice"},{"text":" directly, the delegate method is required — but if your classes conform to ","type":"text"},{"code":"Syncable","type":"codeVoice"},{"text":" it is a one-liner:","type":"text"}]},{"syntax":"swift","code":["func coreDataEnsemble(","    _ ensemble: CoreDataEnsemble,","    globalIdentifiersForManagedObjects objects: [NSManagedObject]",") -> [String] {","    ensemble.syncableGlobalIdentifiers(forManagedObjects: objects)","}"],"type":"codeListing"}],"name":"Tip"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Other delegate methods let you:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Inspect and repair merge data"}],"type":"strong"},{"type":"text","text":" before it’s committed ("},{"type":"codeVoice","code":"shouldSaveMergedChangesIn:reparationContext:"},{"text":")","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Handle save failures"}],"type":"strong"},{"text":" during merging (","type":"text"},{"type":"codeVoice","code":"didFailToSaveMergedChangesIn:error:reparationContext:"},{"text":")","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"React to forced detaches"}]},{"type":"text","text":" caused by identity changes or data corruption ("},{"type":"codeVoice","code":"didDetachWithError:"},{"text":")","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/ConflictResolution"},{"type":"text","text":" for more on conflict handling and the reparation context."}]},{"type":"heading","text":"Detach","level":3,"anchor":"Detach"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To stop syncing, detach from the cloud:"}]},{"type":"codeListing","code":["try await ensemble?.detachPersistentStore()"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"This removes local sync data (event logs and metadata). The persistent store itself is not affected. You can re-attach later to resume syncing.","type":"text"}]},{"type":"heading","text":"Seed Policies","level":3,"anchor":"Seed-Policies"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SeedPolicy","isActive":true},{"type":"text","text":" parameter controls how existing data in the store is handled during attachment:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SeedPolicy\/mergeAllData","isActive":true,"type":"reference"},{"type":"text","text":" (default) — Imports local data so it can be merged with data from other devices."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SeedPolicy\/excludeLocalData","isActive":true,"type":"reference"},{"text":" — Ignores local data. Use this when you want to start fresh from cloud data.","type":"text"}]}]}]},{"type":"heading","text":"Sync Options","level":3,"anchor":"Sync-Options"},{"inlineContent":[{"type":"text","text":"For advanced control, pass "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SyncOptions","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Download only — don't integrate or upload","try await ensemble?.sync(options: .cloudFileRetrievalOnly)","","\/\/ Force a rebase to compact sync history","try await ensemble?.sync(options: .forceRebase)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"A rebase is the most expensive part of a sync, and Ensembles decides for itself when one is due. To choose the moment yourself, sync with "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SyncOptions\/suppressRebase","type":"reference","isActive":true},{"type":"text","text":" in normal use, and when conditions suit (the device is charging, a background processing task is running) read "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/rebaseMetrics()","type":"reference","isActive":true},{"type":"text","text":" and pass "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SyncOptions\/forceRebase","type":"reference","isActive":true},{"type":"text","text":" if "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/RebaseMetrics\/isRebaseRecommended","type":"reference","isActive":true},{"type":"text","text":" is true or your own thresholds are met."}],"type":"paragraph"},{"type":"heading","text":"Process Pending Changes","level":2,"anchor":"Process-Pending-Changes"},{"inlineContent":[{"type":"text","text":"On iOS, the app may be suspended before Ensembles finishes recording a save. Call "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/processPendingChanges()","isActive":true},{"type":"text","text":" — for example, in a background task — to ensure all changes are fully stored:"}],"type":"paragraph"},{"syntax":"swift","code":["try await ensemble?.processPendingChanges()"],"type":"codeListing"},{"type":"heading","text":"Monitor Activity","level":2,"anchor":"Monitor-Activity"},{"inlineContent":[{"text":"Track long-running operations via ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/currentActivity","type":"reference"},{"text":" and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/activityProgress","type":"reference"},{"text":", or observe these notifications:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"coreDataEnsembleDidBeginActivity"},{"type":"text","text":" — An activity started"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"coreDataEnsembleDidMakeProgressWithActivity"},{"type":"text","text":" — Progress updated (includes "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SyncingPhase"},{"type":"text","text":" or "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/AttachingPhase"},{"type":"text","text":")"}]}]},{"content":[{"inlineContent":[{"code":"coreDataEnsembleWillEndActivity","type":"codeVoice"},{"type":"text","text":" — An activity finished (may include an error)"}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/Ensembles\/documentation\/Ensembles\/SwiftDataIntegration","doc:\/\/Ensembles\/documentation\/Ensembles\/SyncLifecycle","doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleContainer","doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble","doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleDelegate"],"anchor":"Essentials","title":"Essentials"}],"kind":"article","metadata":{"role":"article","title":"Getting Started","roleHeading":"Article","modules":[{"name":"Ensembles"}]},"sections":[],"identifier":{"url":"doc:\/\/Ensembles\/documentation\/Ensembles\/GettingStarted","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Ensembles\/documentation\/Ensembles"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://Ensembles/documentation/Ensembles/SeedPolicy/mergeAllData":{"title":"SeedPolicy.mergeAllData","type":"topic","url":"\/documentation\/ensembles\/seedpolicy\/mergealldata","abstract":[{"type":"text","text":"Import the local store contents and merge them with cloud data at the next merge."}],"role":"symbol","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SeedPolicy\/mergeAllData","kind":"symbol","fragments":[{"text":"case","kind":"keyword"},{"kind":"text","text":" "},{"text":"mergeAllData","kind":"identifier"}]},"doc://Ensembles/documentation/Ensembles/CoreDataEnsembleContainer/sync()":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"sync"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"role":"symbol","title":"sync()","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleContainer\/sync()","abstract":[{"type":"text","text":"Attach if needed and merge changes with peers."}],"type":"topic","url":"\/documentation\/ensembles\/coredataensemblecontainer\/sync()","kind":"symbol"},"doc://Ensembles/documentation/Ensembles/CoreDataEnsembleDelegate":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CoreDataEnsembleDelegate","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"CoreDataEnsembleDelegate","kind":"identifier"}],"title":"CoreDataEnsembleDelegate","abstract":[{"text":"Methods invoked by ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble"},{"text":" to inform of sync-related changes.","type":"text"}],"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleDelegate","url":"\/documentation\/ensembles\/coredataensembledelegate","type":"topic","kind":"symbol"},"doc://Ensembles/documentation/Ensembles/SyncingPhase":{"navigatorTitle":[{"kind":"identifier","text":"SyncingPhase"}],"type":"topic","url":"\/documentation\/ensembles\/syncingphase","role":"symbol","abstract":[{"text":"The phase of a sync operation currently in progress.","type":"text"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"SyncingPhase"}],"title":"SyncingPhase","kind":"symbol","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SyncingPhase"},"doc://Ensembles/documentation/Ensembles/SeedPolicy/excludeLocalData":{"type":"topic","url":"\/documentation\/ensembles\/seedpolicy\/excludelocaldata","role":"symbol","abstract":[{"text":"Do not import local data. You will usually want to delete the store before attaching.","type":"text"}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"excludeLocalData"}],"title":"SeedPolicy.excludeLocalData","kind":"symbol","identifier":"doc:\/\