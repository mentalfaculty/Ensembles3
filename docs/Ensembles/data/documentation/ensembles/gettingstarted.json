/documentation\/Ensembles\/SyncingPhase","title":"SyncingPhase","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"SyncingPhase"}],"abstract":[{"type":"text","text":"The phase of a sync operation currently in progress."}]},"doc://Ensembles/documentation/Ensembles/CoreDataEnsemble":{"navigatorTitle":[{"kind":"identifier","text":"CoreDataEnsemble"}],"url":"\/documentation\/ensembles\/coredataensemble","type":"topic","title":"CoreDataEnsemble","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"CoreDataEnsemble"}],"abstract":[{"text":"The central class of Ensembles, representing a set of synchronizing persistent stores.","type":"text"}],"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble","kind":"symbol"},"doc://Ensembles/documentation/Ensembles/SwiftDataIntegration":{"kind":"article","url":"\/documentation\/ensembles\/swiftdataintegration","type":"topic","role":"article","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SwiftDataIntegration","title":"SwiftData Integration","abstract":[{"type":"text","text":"Sync SwiftData models with Ensembles using "},{"type":"codeVoice","code":"SwiftDataEnsembleContainer"},{"type":"text","text":"."}]},"doc://Ensembles/documentation/Ensembles/SeedPolicy":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SeedPolicy","kind":"identifier"}],"navigatorTitle":[{"text":"SeedPolicy","kind":"identifier"}],"url":"\/documentation\/ensembles\/seedpolicy","role":"symbol","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SeedPolicy","title":"SeedPolicy","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Controls how existing data in the persistent store is treated when attaching."}]},"doc://Ensembles/documentation/Ensembles/SyncOptions":{"url":"\/documentation\/ensembles\/syncoptions","fragments":[{"kind":"keyword","text":"struct"},{"kind":"te