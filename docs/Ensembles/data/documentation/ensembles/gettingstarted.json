{"identifier":{"url":"doc:\/\/Ensembles\/documentation\/Ensembles\/GettingStarted","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ensembles\/gettingstarted"]}],"hierarchy":{"paths":[["doc:\/\/Ensembles\/documentation\/Ensembles"]]},"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Ensembles synchronizes SQLite stores by recording local changes as events and exchanging them through a cloud backend. It works with both Core Data and SwiftData.","type":"text"}]},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Using SwiftData?"}],"type":"strong"},{"text":" See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SwiftDataIntegration","type":"reference"},{"type":"text","text":" for a complete guide — you never need to touch Core Data directly."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This guide covers Core Data setup, starting with a complete working example using "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleContainer"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Develop with Claude Code","anchor":"Develop-with-Claude-Code","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"If you use "},{"type":"reference","isActive":true,"identifier":"https:\/\/claude.com\/claude-code"},{"type":"text","text":", install the Ensembles skill first. It teaches Claude the API, the cloud backends, Ensembles 2 → 3 migration, the seed policy, and the common pitfalls, so it writes correct setup code and diagnoses sync issues without hand-holding:"}],"type":"paragraph"},{"syntax":null,"code":["\/plugin marketplace add mentalfaculty\/Ensembles3","\/plugin install ensembles@ensembles"],"type":"codeListing"},{"text":"Add Ensembles to Your Project","anchor":"Add-Ensembles-to-Your-Project","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Add the Ensembles package to your "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":" or via Xcode’s package dependencies:"}],"type":"paragraph"},{"type":"codeListing","syntax":null,"code":["https:\/\/github.com\/mentalfaculty\/Ensembles3.git"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Import the core module and one cloud backend:"}]},{"code":["import Ensembles","import EnsemblesCloudKit   \/\/ or EnsemblesLocalFile, EnsemblesMemory"],"type":"codeListing","syntax":"swift"},{"type":"heading","anchor":"Complete-Example-Core-Data-with-CloudKit","level":2,"text":"Complete Example: Core Data with CloudKit"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Here’s a complete, working setup for a SwiftUI app that syncs via CloudKit. This uses "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleContainer","isActive":true},{"type":"text","text":", which creates the Core Data stack for you and syncs automatically."}]},{"type":"heading","anchor":"1-Create-Your-Core-Data-Model","level":3,"text":"1. Create Your Core Data Model"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In Xcode, add a "},{"code":".xcdatamodeld","type":"codeVoice"},{"type":"text","text":" file to your project (e.g., "},{"inlineContent":[{"type":"text","text":"Model.xcdatamodeld"}],"type":"strong"},{"type":"text","text":"). Define your entities as usual. For this example, we’ll assume a "},{"code":"Note","type":"codeVoice"},{"type":"text","text":" entity with "},{"code":"title","type":"codeVoice"},{"type":"text","text":" (String) and "},{"code":"uniqueID","type":"codeVoice"},{"type":"text","text":" (String) attributes."}]},{"type":"heading","level":3,"text":"2. Define Your Model with `Syncable`","anchor":"2-Define-Your-Model-with-Syncable"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For deduplication, conform your "},{"code":"NSManagedObject","type":"codeVoice"},{"type":"text","text":" subclass to the "},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable","type":"reference"},{"type":"text","text":" protocol and specify which property holds the global identifier. A UUID assigned at creation time is usually the best choice:"}]},{"code":["import CoreData","import Ensembles","","class Note: NSManagedObject, Syncable {","    static let globalIdentifierKey = \"uniqueID\"","    @NSManaged var uniqueID: String","    @NSManaged var title: String","}"],"type":"codeListing","syntax":"swift"},{"content":[{"inlineContent":[{"type":"text","text":"A global identifier "},{"type":"strong","inlineContent":[{"text":"must never change","type":"text"}]},{"type":"text","text":" once it has been assigned. Changing it after sync has begun will cause duplicates or data loss."}],"type":"paragraph"}],"type":"aside","style":"important","name":"Important"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use a fixed, meaningful value instead of a UUID for singleton objects or reference data like tags, where two devices might independently create the same logical object."}]},{"type":"heading","level":3,"text":"3. Set Up the Container","anchor":"3-Set-Up-the-Container"},{"code":["import SwiftUI","import Ensembles","import EnsemblesCloudKit","","@main","struct MyApp: App {","    let syncContainer: CoreDataEnsembleContainer","","    init() {","        \/\/ The model URL points to the .momd bundle compiled from your .xcdatamodeld","        let modelURL = Bundle.main.url(forResource: \"Model\", withExtension: \"momd\")!","","        \/\/ This creates a full Core Data stack automatically:","        \/\/ - SQLite store at Application Support\/MyNotes.sqlite","        \/\/ - Main-queue viewContext for your UI","        \/\/ - Auto-sync on save, on app activation, and on a 5-minute timer","        let container = CoreDataEnsembleContainer(","            name: \"MyNotes\",","            modelURL: modelURL,","            cloudFileSystem: CloudKitFileSystem(","                privateDatabaseForUbiquityContainerIdentifier: \"iCloud.com.example.mynotes\",","                schemaVersion: .v2","            )","        )!","","        self.syncContainer = container","    }","","    var body: some Scene {","        WindowGroup {","            ContentView()","                .environment(","                    \\.managedObjectContext,","                    syncContainer.viewContext","                )","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"That’s the complete setup. The container discovers "},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable","type":"reference"},{"type":"text","text":" conformances automatically, attaches to the cloud, and begins syncing. Remote changes are merged into "},{"code":"viewContext","type":"codeVoice"},{"type":"text","text":" so your UI stays up to date."}]},{"type":"heading","level":3,"text":"4. Respond to Events (Optional)","anchor":"4-Respond-to-Events-Optional"},{"code":["\/\/ Called after remote changes are merged into viewContext","container.didSaveMergeChanges = { notification in","    print(\"Merged remote changes\")","}","","\/\/ Called if a sync fails","container.didEncounterError = { error in","    print(\"Sync error: \\(error)\")","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":2,"text":"Using a Custom Store Location","anchor":"Using-a-Custom-Store-Location"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you need control over where the SQLite file lives, pass an explicit "},{"code":"storeURL","type":"codeVoice"},{"type":"text","text":":"}]},{"code":["let appSupport = FileManager.default.urls(","    for: .applicationSupportDirectory, in: .userDomainMask",").first!","let storeURL = appSupport.appendingPathComponent(\"MyApp\/data.sqlite\")","try FileManager.default.createDirectory(","    at: storeURL.deletingLastPathComponent(),","    withIntermediateDirectories: true",")","","let container = CoreDataEnsembleContainer(","    name: \"MyNotes\",","    storeURL: storeURL,","    modelURL: Bundle.main.url(forResource: \"Model\", withExtension: \"momd\")!,","    cloudFileSystem: CloudKitFileSystem(","        privateDatabaseForUbiquityContainerIdentifier: \"iCloud.com.example.mynotes\",","        schemaVersion: .v2","    )",")!"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":2,"text":"Working with an Existing Core Data Stack","anchor":"Working-with-an-Existing-Core-Data-Stack"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you already have an "},{"code":"NSPersistentContainer","type":"codeVoice"},{"type":"text","text":", pass it in directly:"}]},{"code":["let container = CoreDataEnsembleContainer(","    persistentContainer: myPersistentContainer,","    cloudFileSystem: cloudFS",")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Or if you have an existing "},{"code":"NSManagedObjectContext","type":"codeVoice"},{"type":"text","text":":"}]},{"code":["let container = CoreDataEnsembleContainer(","    name: \"MyNotes\",","    viewContext: myContext,","    persistentStoreURL: myStoreURL,","    managedObjectModel: myContext.persistentStoreCoordinator!.managedObjectModel,","    managedObjectModels: nil,","    cloudFileSystem: cloudFS",")"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":2,"text":"Auto-Sync Configuration","anchor":"Auto-Sync-Configuration"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Control when syncing occurs with "},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/AutoSyncPolicy","type":"reference"},{"type":"text","text":":"}]},{"code":["let config = EnsembleContainerConfiguration(","    autoSyncPolicy: [.onSave, .onTimer],   \/\/ Sync on save and timer, not on activation","    timerInterval: 30                       \/\/ Timer fires every 30 seconds",")","let container = CoreDataEnsembleContainer(","    name: \"MyNotes\",","    modelURL: modelURL,","    cloudFileSystem: cloudFS,","    configuration: config",")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Set "},{"code":"autoSyncPolicy","type":"codeVoice"},{"type":"text","text":" to "},{"code":".manual","type":"codeVoice"},{"type":"text","text":" and call "},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleContainer\/sync()","type":"reference"},{"text":" yourself for full control over timing.","type":"text"}]},{"type":"heading","level":2,"text":"Backward Compatibility with Ensembles 2","anchor":"Backward-Compatibility-with-Ensembles-2"},{"type":"paragraph","inlineContent":[{"text":"If you’re transitioning from Ensembles 2 and some users may still be on E2, set the compatibility mode:","type":"text"}]},{"code":["let config = EnsembleContainerConfiguration(","    compatibilityMode: .ensembles2Compatible",")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"This restricts exports to formats that Ensembles 2 peers can parse. Switch to ","type":"text"},{"code":".ensembles3","type":"codeVoice"},{"text":" (the default) once all users have upgraded.","type":"text"}]},{"text":"The Manual Way: CoreDataEnsemble","anchor":"The-Manual-Way-CoreDataEnsemble","type":"heading","level":2},{"inlineContent":[{"text":"For more control over the sync lifecycle, use ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble","type":"reference"},{"type":"text","text":" directly. This is useful when you need to manage attach\/detach timing, handle specific delegate methods, or integrate with a complex Core Data stack."}],"type":"paragraph"},{"text":"Create and Attach","anchor":"Create-and-Attach","level":3,"type":"heading"},{"syntax":"swift","code":["import Ensembles","import EnsemblesCloudKit","","\/\/ Get the store URL from your persistent store coordinator","let store = persistentStoreCoordinator.persistentStores.first!","let storeURL = store.url!","let modelURL = Bundle.main.url(forResource: \"Model\", withExtension: \"momd\")!","","let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MyNotes\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: CloudKitFileSystem(","        privateDatabaseForUbiquityContainerIdentifier: \"iCloud.com.example.mynotes\",","        schemaVersion: .v2","    )",")","ensemble?.delegate = self","","\/\/ Attach registers this device in the cloud","try await ensemble?.attachPersistentStore()"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The "},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/ensembleIdentifier","type":"reference"},{"type":"text","text":" must be the same on all devices that should sync together. If you have multiple persistent stores, create one ensemble per store with a unique identifier."}],"type":"paragraph"},{"content":[{"inlineContent":[{"type":"text","text":"Avoid saving to the persistent store while attaching. If a save is detected, attachment will fail with an error and you will need to retry."}],"type":"paragraph"}],"style":"important","name":"Important","type":"aside"},{"anchor":"Sync-Changes","type":"heading","text":"Sync Changes","level":3},{"inlineContent":[{"type":"text","text":"Call "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/sync(options:)"},{"type":"text","text":" periodically — for example, when the app enters the foreground, on a timer, or in response to a push notification:"}],"type":"paragraph"},{"syntax":"swift","code":["try await ensemble?.sync()"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"A sync downloads remote events, replays them into the local store, and uploads new local events. Sync errors are usually transient — just retry later."}],"type":"paragraph"},{"type":"heading","anchor":"Handle-the-Delegate","level":3,"text":"Handle the Delegate"},{"inlineContent":[{"type":"text","text":"Implement "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleDelegate","isActive":true},{"type":"text","text":" to respond to sync events. The most important method merges remote changes into your main context:"}],"type":"paragraph"},{"syntax":"swift","code":["extension AppDelegate: CoreDataEnsembleDelegate {","    func coreDataEnsemble(","        _ ensemble: CoreDataEnsemble,","        didSaveMergeChangesWith notification: Notification","    ) {","        viewContext.perform {","            self.viewContext.mergeChanges(fromContextDidSave: notification)","        }","    }","}"],"type":"codeListing"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If your "},{"code":"NSManagedObject","type":"codeVoice"},{"type":"text","text":" subclasses conform to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable"},{"type":"text","text":", you don’t need to implement "},{"code":"globalIdentifiersForManagedObjects","type":"codeVoice"},{"type":"text","text":" — the ensemble discovers identifier properties automatically. You only need the delegate method if you use "},{"code":"CoreDataEnsemble","type":"codeVoice"},{"type":"text","text":" directly without "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleContainer"},{"type":"text","text":"."}]}],"style":"tip","name":"Tip","type":"aside"},{"inlineContent":[{"type":"text","text":"Other delegate methods let you:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Inspect and repair merge data"}]},{"type":"text","text":" before it’s committed ("},{"code":"shouldSaveMergedChangesIn:reparationContext:","type":"codeVoice"},{"type":"text","text":")"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Handle save failures"}]},{"type":"text","text":" during merging ("},{"code":"didFailToSaveMergedChangesIn:error:reparationContext:","type":"codeVoice"},{"type":"text","text":")"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"React to forced detaches"}]},{"type":"text","text":" caused by identity changes or data corruption ("},{"code":"didDetachWithError:","type":"codeVoice"},{"type":"text","text":")"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"See "},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/ConflictResolution","type":"reference"},{"type":"text","text":" for more on conflict handling and the reparation context."}],"type":"paragraph"},{"text":"Detach","anchor":"Detach","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"To stop syncing, detach from the cloud:"}],"type":"paragraph"},{"syntax":"swift","code":["try await ensemble?.detachPersistentStore()"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"This removes local sync data (event logs and metadata). The persistent store itself is not affected. You can re-attach later to resume syncing."}],"type":"paragraph"},{"text":"Seed Policies","anchor":"Seed-Policies","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SeedPolicy","type":"reference"},{"type":"text","text":" parameter controls how existing data in the store is handled during attachment:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SeedPolicy\/mergeAllData","isActive":true},{"type":"text","text":" (default) — Imports local data so it can be merged with data from other devices."}]}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SeedPolicy\/excludeLocalData"},{"type":"text","text":" — Ignores local data. Use this when you want to start fresh from cloud data."}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Sync Options","anchor":"Sync-Options","level":3,"type":"heading"},{"inlineContent":[{"text":"For advanced control, pass ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SyncOptions","type":"reference"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Download only — don't integrate or upload","try await ensemble?.sync(options: .cloudFileRetrievalOnly)","","\/\/ Force a rebase to compact sync history","try await ensemble?.sync(options: .forceRebase)"],"type":"codeListing"},{"anchor":"Process-Pending-Changes","type":"heading","text":"Process Pending Changes","level":2},{"inlineContent":[{"text":"On iOS, the app may be suspended before Ensembles finishes recording a save. Call ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/processPendingChanges()","type":"reference"},{"text":" — for example, in a background task — to ensure all changes are fully stored:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["try await ensemble?.processPendingChanges()"],"syntax":"swift"},{"level":2,"text":"Monitor Activity","anchor":"Monitor-Activity","type":"heading"},{"inlineContent":[{"type":"text","text":"Track long-running operations via "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/currentActivity","isActive":true},{"type":"text","text":" and "},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/activityProgress","type":"reference"},{"type":"text","text":", or observe these notifications:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"coreDataEnsembleDidBeginActivity"},{"type":"text","text":" — An activity started"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"coreDataEnsembleDidMakeProgressWithActivity","type":"codeVoice"},{"type":"text","text":" — Progress updated (includes "},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SyncingPhase","type":"reference"},{"type":"text","text":" or "},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/AttachingPhase","type":"reference"},{"type":"text","text":")"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"coreDataEnsembleWillEndActivity"},{"type":"text","text":" — An activity finished (may include an error)"}]}]}],"type":"unorderedList"}],"kind":"content"}],"kind":"article","metadata":{"roleHeading":"Article","title":"Getting Started","modules":[{"name":"Ensembles"}],"role":"article"},"abstract":[{"type":"text","text":"Set up Ensembles to sync a Core Data or SwiftData persistent store across devices."}],"seeAlsoSections":[{"title":"Essentials","generated":true,"anchor":"Essentials","identifiers":["doc:\/\/Ensembles\/documentation\/Ensembles\/SwiftDataIntegration","doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleContainer","doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble","doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleDelegate"]}],"sections":[],"references":{"doc://Ensembles/documentation/Ensembles/SyncOptions":{"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SyncOptions"}],"navigatorTitle":[{"text":"SyncOptions","kind":"identifier"}],"abstract":[{"type":"text","text":"Options that control which phases of a sync are executed."}],"kind":"symbol","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SyncOptions","type":"topic","url":"\/documentation\/ensembles\/syncoptions","title":"SyncOptions"},"doc://Ensembles/documentation/Ensembles/SeedPolicy/mergeAllData":{"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"mergeAllData"}],"abstract":[{"text":"Import the local store contents and merge them with cloud data at the next merge.","type":"text"}],"url":"\/documentation\/ensembles\/seedpolicy\/mergealldata","type":"topic","kind":"symbol","title":"SeedPolicy.mergeAllData","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SeedPolicy\/mergeAllData","role":"symbol"},"doc://Ensembles/documentation/Ensembles/CoreDataEnsembleContainer":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CoreDataEnsembleContainer","kind":"identifier"}],"abstract":[{"text":"A high-level container that sets up a ","type":"text"},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble","isActive":true},{"text":" with automatic syncing,","type":"text"},{"text":" ","type":"text"},{"text":"delegate management, and optional Core Data stack creation.","type":"text"}],"navigatorTitle":[{"text":"CoreDataEnsembleContainer","kind":"identifier"}],"url":"\/documentation\/ensembles\/coredataensemblecontainer","type":"topic","kind":"symbol","title":"CoreDataEnsembleContainer","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleContainer","role":"symbol"},"doc://Ensembles/documentation/Ensembles/CoreDataEnsemble/activityProgress":{"url":"\/documentation\/ensembles\/coredataensemble\/activityprogress","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"The progress of the current activity, as a fraction between 0.0 and 1.0."}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"activityProgress","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Float","preciseIdentifier":"s:Sf","kind":"typeIdentifier"}],"type":"topic","title":"activityProgress","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/activityProgress"},"https://claude.com/claude-code":{"titleInlineContent":[{"type":"text","text":"Claude Code"}],"url":"https:\/\/claude.com\/claude-code","title":"Claude Code","identifier":"https:\/\/claude.com\/claude-code","type":"link"},"doc://Ensembles/documentation/Ensembles/SeedPolicy/excludeLocalData":{"fragments":[{"text":"case","kind":"keyword"},{"kind":"text","text":" "},{"text":"excludeLocalData","kind":"identifier"}],"abstract":[{"type":"text","text":"Do not import local data. You will usually want to delete the store before attaching."}],"url":"\/documentation\/ensembles\/seedpolicy\/excludelocaldata","type":"topic","title":"SeedPolicy.excludeLocalData","kind":"symbol","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SeedPolicy\/excludeLocalData","role":"symbol"},"doc://Ensembles/documentation/Ensembles/AttachingPhase":{"url":"\/documentation\/ensembles\/attachingphase","title":"AttachingPhase","navigatorTitle":[{"text":"AttachingPhase","kind":"identifier"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/AttachingPhase","role":"symbol","abstract":[{"type":"text","text":"The phase of an attach operation currently in progress."}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AttachingPhase","kind":"identifier"}]},"doc://Ensembles/documentation/Ensembles/ConflictResolution":{"url":"\/documentation\/ensembles\/conflictresolution","title":"Conflict Resolution","type":"topic","kind":"article","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/ConflictResolution","role":"article","abstract":[{"type":"text","text":"Understand how Ensembles resolves conflicts and how to customiz