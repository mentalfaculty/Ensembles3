":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"currentActivity"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"EnsembleActivity","preciseIdentifier":"s:9Ensembles16EnsembleActivityO"}],"abstract":[{"type":"text","text":"The activity currently being undertaken, if any."}],"kind":"symbol","type":"topic","url":"\/documentation\/ensembles\/coredataensemble\/currentactivity","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/currentActivity","role":"symbol"},"doc://Ensembles/documentation/Ensembles/SeedPolicy/excludeLocalData":{"title":"SeedPolicy.excludeLocalData","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"excludeLocalData"}],"abstract":[{"type":"text","text":"Do not import local data. You will usually want to delete the store before attaching."}],"kind":"symbol","type":"topic","url":"\/documentation\/ensembles\/seedpolicy\/excludelocaldata","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SeedPolicy\/excludeLocalData","role":"symbol"},"doc://Ensembles/documentation/Ensembles/CoreDataEnsembleContainer":{"kind":"symbol","abstract":[{"type":"text","text":"A high-level container that sets up a "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble","type":"reference","isActive":true},{"text":" with automatic syncing,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"delegate management, and optional Core Data stack creation."}],"url":"\/documentation\/ensembles\/coredataensemblecontainer","type":"topic","fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"kind":"identifier","text":"CoreDataEnsembleContainer"}],"role":"symbol","title":"CoreDataEnsembleContainer","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleContainer","navigatorTitle":[{"kind":"identifier","text":"CoreDataEnsembleContainer"}]},"doc://Ensembles/documentation/Ensembl