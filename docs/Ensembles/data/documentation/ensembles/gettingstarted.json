{"hierarchy":{"paths":[["doc:\/\/Ensembles\/documentation\/Ensembles"]]},"identifier":{"url":"doc:\/\/Ensembles\/documentation\/Ensembles\/GettingStarted","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"article","sections":[],"variants":[{"paths":["\/documentation\/ensembles\/gettingstarted"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Set up Ensembles to sync a Core Data or SwiftData persistent store across devices."}],"seeAlsoSections":[{"identifiers":["doc:\/\/Ensembles\/documentation\/Ensembles\/SwiftDataIntegration","doc:\/\/Ensembles\/documentation\/Ensembles\/SyncLifecycle","doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleContainer","doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble","doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleDelegate"],"generated":true,"title":"Essentials","anchor":"Essentials"}],"metadata":{"role":"article","roleHeading":"Article","title":"Getting Started","modules":[{"name":"Ensembles"}]},"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"inlineContent":[{"text":"Ensembles synchronizes SQLite stores by recording local changes as events and exchanging them through a cloud backend. It works with both Core Data and SwiftData.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Using SwiftData?","type":"text"}]},{"text":" See ","type":"text"},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SwiftDataIntegration","type":"reference","isActive":true},{"text":" for a complete guide — you never need to touch Core Data directly.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"This guide covers Core Data setup, starting with a complete working example using ","type":"text"},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleContainer","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"Develop-with-Claude-Code","text":"Develop with Claude Code"},{"inlineContent":[{"text":"If you use ","type":"text"},{"isActive":true,"identifier":"https:\/\/claude.com\/claude-code","type":"reference"},{"text":", install the Ensembles skill first. It teaches Claude the API, the cloud backends, Ensembles 2 → 3 migration, the seed policy, and the common pitfalls, so it writes correct setup code and diagnoses sync issues without hand-holding:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":null,"code":["\/plugin marketplace add mentalfaculty\/Ensembles3","\/plugin install ensembles@ensembles"]},{"level":2,"type":"heading","anchor":"Add-Ensembles-to-Your-Project","text":"Add Ensembles to Your Project"},{"inlineContent":[{"text":"Add the Ensembles package to your ","type":"text"},{"code":"Package.swift","type":"codeVoice"},{"text":" or via Xcode’s package dependencies:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":null,"code":["https:\/\/github.com\/mentalfaculty\/Ensembles3.git"]},{"inlineContent":[{"text":"Import the core module and one cloud backend:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import Ensembles","import EnsemblesCloudKit   \/\/ or EnsemblesLocalFile, EnsemblesMemory"]},{"level":2,"type":"heading","anchor":"Complete-Example-Core-Data-with-CloudKit","text":"Complete Example: Core Data with CloudKit"},{"inlineContent":[{"text":"Here’s a complete, working setup for a SwiftUI app that syncs via CloudKit. This uses ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleContainer","type":"reference"},{"text":", which creates the Core Data stack for you and syncs automatically.","type":"text"}],"type":"paragraph"},{"level":3,"type":"heading","anchor":"1-Create-Your-Core-Data-Model","text":"1. Create Your Core Data Model"},{"inlineContent":[{"text":"In Xcode, add a ","type":"text"},{"code":".xcdatamodeld","type":"codeVoice"},{"text":" file to your project (e.g., ","type":"text"},{"inlineContent":[{"text":"Model.xcdatamodeld","type":"text"}],"type":"strong"},{"text":"). Define your entities as usual. For this example, we’ll assume a ","type":"text"},{"code":"Note","type":"codeVoice"},{"text":" entity with ","type":"text"},{"code":"title","type":"codeVoice"},{"text":" (String) and ","type":"text"},{"code":"uniqueID","type":"codeVoice"},{"text":" (String) attributes.","type":"text"}],"type":"paragraph"},{"level":3,"type":"heading","anchor":"2-Define-Your-Model-with-Syncable","text":"2. Define Your Model with `Syncable`"},{"inlineContent":[{"text":"For deduplication, conform your ","type":"text"},{"code":"NSManagedObject","type":"codeVoice"},{"text":" subclass to the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable","type":"reference"},{"text":" protocol and specify which property holds the global identifier. A UUID assigned at creation time is usually the best choice:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import CoreData","import Ensembles","","class Note: NSManagedObject, Syncable {","    static let globalIdentifierKey = \"uniqueID\"","    @NSManaged var uniqueID: String","    @NSManaged var title: String","}"]},{"type":"aside","content":[{"inlineContent":[{"text":"A global identifier ","type":"text"},{"inlineContent":[{"type":"text","text":"must never change"}],"type":"strong"},{"type":"text","text":" once it has been assigned. Changing it after sync has begun will cause duplicates or data loss."}],"type":"paragraph"}],"style":"important","name":"Important"},{"type":"paragraph","inlineContent":[{"text":"Use a fixed, meaningful value instead of a UUID for singleton objects or reference data like tags, where two devices might independently create the same logical object.","type":"text"}]},{"level":3,"text":"3. Set Up the Container","type":"heading","anchor":"3-Set-Up-the-Container"},{"type":"codeListing","code":["import SwiftUI","import Ensembles","import EnsemblesCloudKit","","@main","struct MyApp: App {","    let syncContainer: CoreDataEnsembleContainer","","    init() {","        \/\/ The model URL points to the .momd bundle compiled from your .xcdatamodeld","        let modelURL = Bundle.main.url(forResource: \"Model\", withExtension: \"momd\")!","","        \/\/ This creates a full Core Data stack automatically:","        \/\/ - SQLite store at Application Support\/MyNotes.sqlite","        \/\/ - Main-queue viewContext for your UI","        \/\/ - Auto-sync on save, on app activation, and on a 5-minute timer","        let container = CoreDataEnsembleContainer(","            name: \"MyNotes\",","            modelURL: modelURL,","            cloudFileSystem: CloudKitFileSystem(","                privateDatabaseForUbiquityContainerIdentifier: \"iCloud.com.example.mynotes\",","                schemaVersion: .v2","            )","        )!","","        self.syncContainer = container","    }","","    var body: some Scene {","        WindowGroup {","            ContentView()","                .environment(","                    \\.managedObjectContext,","                    syncContainer.viewContext","                )","        }","    }","}"],"syntax":"swift"},{"inlineContent":[{"text":"That’s the complete setup. The container discovers ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable"},{"type":"text","text":" conformances automatically, attaches to the cloud, and begins syncing. Remote changes are merged into "},{"type":"codeVoice","code":"viewContext"},{"type":"text","text":" so your UI stays up to date."}],"type":"paragraph"},{"type":"heading","level":3,"text":"4. Respond to Events (Optional)","anchor":"4-Respond-to-Events-Optional"},{"type":"codeListing","code":["\/\/ Called after remote changes are merged into viewContext","container.didSaveMergeChanges = { notification in","    print(\"Merged remote changes\")","}","","\/\/ Called if a sync fails","container.didEncounterError = { error in","    print(\"Sync error: \\(error)\")","}"],"syntax":"swift"},{"type":"heading","level":2,"text":"Using a Custom Store Location","anchor":"Using-a-Custom-Store-Location"},{"type":"paragraph","inlineContent":[{"text":"If you need control over where the SQLite file lives, pass an explicit ","type":"text"},{"type":"codeVoice","code":"storeURL"},{"text":":","type":"text"}]},{"type":"codeListing","code":["let appSupport = FileManager.default.urls(","    for: .applicationSupportDirectory, in: .userDomainMask",").first!","let storeURL = appSupport.appendingPathComponent(\"MyApp\/data.sqlite\")","try FileManager.default.createDirectory(","    at: storeURL.deletingLastPathComponent(),","    withIntermediateDirectories: true",")","","let container = CoreDataEnsembleContainer(","    name: \"MyNotes\",","    storeURL: storeURL,","    modelURL: Bundle.main.url(forResource: \"Model\", withExtension: \"momd\")!,","    cloudFileSystem: CloudKitFileSystem(","        privateDatabaseForUbiquityContainerIdentifier: \"iCloud.com.example.mynotes\",","        schemaVersion: .v2","    )",")!"],"syntax":"swift"},{"anchor":"Working-with-an-Existing-Core-Data-Stack","text":"Working with an Existing Core Data Stack","type":"heading","level":2},{"inlineContent":[{"text":"If you already have an ","type":"text"},{"type":"codeVoice","code":"NSPersistentContainer"},{"text":", pass it in directly:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["let container = CoreDataEnsembleContainer(","    persistentContainer: myPersistentContainer,","    cloudFileSystem: cloudFS",")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Or if you have an existing ","type":"text"},{"code":"NSManagedObjectContext","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","code":["let container = CoreDataEnsembleContainer(","    name: \"MyNotes\",","    viewContext: myContext,","    persistentStoreURL: myStoreURL,","    managedObjectModel: myContext.persistentStoreCoordinator!.managedObjectModel,","    managedObjectModels: nil,","    cloudFileSystem: cloudFS",")"],"syntax":"swift"},{"type":"heading","level":2,"text":"Auto-Sync Configuration","anchor":"Auto-Sync-Configuration"},{"type":"paragraph","inlineContent":[{"text":"Control when syncing occurs with ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/AutoSyncPolicy","type":"reference"},{"text":":","type":"text"}]},{"type":"codeListing","code":["let config = EnsembleContainerConfiguration(","    autoSyncPolicy: [.onSave, .onTimer],   \/\/ Sync on save and timer, not on activation","    timerInterval: 30                       \/\/ Timer fires every 30 seconds",")","let container = CoreDataEnsembleContainer(","    name: \"MyNotes\",","    modelURL: modelURL,","    cloudFileSystem: cloudFS,","    configuration: config",")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Set ","type":"text"},{"code":"autoSyncPolicy","type":"codeVoice"},{"text":" to ","type":"text"},{"code":".manual","type":"codeVoice"},{"text":" and call ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleContainer\/sync()","type":"reference"},{"text":" yourself for full control over timing.","type":"text"}]},{"type":"heading","level":2,"text":"Backward Compatibility with Ensembles 2","anchor":"Backward-Compatibility-with-Ensembles-2"},{"type":"paragraph","inlineContent":[{"text":"If you’re transitioning from Ensembles 2 and some users may still be on E2, set the compatibility mode:","type":"text"}]},{"type":"codeListing","code":["let config = EnsembleContainerConfiguration(","    compatibilityMode: .ensembles2Compatible",")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"This restricts exports to formats that Ensembles 2 peers can parse. Switch to ","type":"text"},{"code":".ensembles3","type":"codeVoice"},{"text":" (the default) once all users have upgraded.","type":"text"}]},{"type":"heading","level":2,"text":"The Manual Way: CoreDataEnsemble","anchor":"The-Manual-Way-CoreDataEnsemble"},{"type":"paragraph","inlineContent":[{"text":"For more control over the sync lifecycle, use ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble","type":"reference"},{"text":" directly. This is useful when you need to manage attach\/detach timing, handle specific delegate methods, or integrate with a complex Core Data stack.","type":"text"}]},{"type":"heading","level":3,"text":"Create and Attach","anchor":"Create-and-Attach"},{"type":"codeListing","code":["import Ensembles","import EnsemblesCloudKit","","\/\/ Get the store URL from your persistent store coordinator","let store = persistentStoreCoordinator.persistentStores.first!","let storeURL = store.url!","let modelURL = Bundle.main.url(forResource: \"Model\", withExtension: \"momd\")!","","let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MyNotes\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: CloudKitFileSystem(","        privateDatabaseForUbiquityContainerIdentifier: \"iCloud.com.example.mynotes\",","        schemaVersion: .v2","    )",")","ensemble?.delegate = self","","\/\/ Attach registers this device in the cloud","try await ensemble?.attachPersistentStore()"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/ensembleIdentifier","type":"reference"},{"text":" must be the same on all devices that should sync together. If you have multiple persistent stores, create one ensemble per store with a unique identifier.","type":"text"}]},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":"Avoid saving to the persistent store while attaching. If a save is detected, attachment will fail with an error and you will need to retry."}],"type":"paragraph"}],"style":"important","name":"Important"},{"type":"heading","level":3,"text":"Sync Changes","anchor":"Sync-Changes"},{"type":"paragraph","inlineContent":[{"text":"Call ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/sync(options:)","type":"reference"},{"text":" periodically — for example, when the app enters the foreground, on a timer, or in response to a push notification:","type":"text"}]},{"type":"codeListing","code":["try await ensemble?.sync()"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"A sync downloads remote events, replays them into the local store, and uploads new local events. Sync errors are usually transient — just retry later.","type":"text"}]},{"type":"heading","level":3,"text":"Handle the Delegate","anchor":"Handle-the-Delegate"},{"type":"paragraph","inlineContent":[{"text":"Implement ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleDelegate","type":"reference"},{"text":" to respond to sync events. The most important method merges remote changes into your main context:","type":"text"}]},{"type":"codeListing","code":["extension AppDelegate: CoreDataEnsembleDelegate {","    func coreDataEnsemble(","        _ ensemble: CoreDataEnsemble,","        didSaveMergeChangesWith notification: Notification","    ) {","        viewContext.perform {","            self.viewContext.mergeChanges(fromContextDidSave: notification)","        }","    }","}"],"syntax":"swift"},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":"With "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleContainer","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/Syncable","type":"reference","isActive":true},{"type":"text","text":" conformances are discovered automatically and no "},{"type":"codeVoice","code":"globalIdentifiersForManagedObjects"},{"type":"text","text":" implementation is needed. When you use "},{"type":"codeVoice","code":"CoreDataEnsemble"},{"type":"text","text":" directly, the delegate method is required — but if your classes conform to "},{"type":"codeVoice","code":"Syncable"},{"type":"text","text":" it is a one-liner:"}],"type":"paragraph"},{"syntax":"swift","code":["func coreDataEnsemble(","    _ ensemble: CoreDataEnsemble,","    globalIdentifiersForManagedObjects objects: [NSManagedObject]",") -> [String] {","    ensemble.syncableGlobalIdentifiers(forManagedObjects: objects)","}"],"type":"codeListing"}],"style":"tip","name":"Tip"},{"type":"paragraph","inlineContent":[{"text":"Other delegate methods let you:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Inspect and repair merge data","type":"text"}]},{"text":" before it’s committed (","type":"text"},{"type":"codeVoice","code":"shouldSaveMergedChangesIn:reparationContext:"},{"text":")","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Handle save failures","type":"text"}]},{"text":" during merging (","type":"text"},{"type":"codeVoice","code":"didFailToSaveMergedChangesIn:error:reparationContext:"},{"text":")","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"React to forced detaches","type":"text"}]},{"text":" caused by identity changes or data corruption (","type":"text"},{"type":"codeVoice","code":"didDetachWithError:"},{"text":")","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/ConflictResolution","type":"reference"},{"text":" for more on conflict handling and the reparation context.","type":"text"}]},{"type":"heading","level":3,"text":"Detach","anchor":"Detach"},{"type":"paragraph","inlineContent":[{"text":"To stop syncing, detach from the cloud:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["try await ensemble?.detachPersistentStore()"]},{"inlineContent":[{"type":"text","text":"This removes local sync data (event logs and metadata). The persistent store itself is not affected. You can re-attach later to resume syncing."}],"type":"paragraph"},{"anchor":"Seed-Policies","text":"Seed Policies","type":"heading","level":3},{"inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SeedPolicy","type":"reference","isActive":true},{"text":" parameter controls how existing data in the store is handled during attachment:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SeedPolicy\/mergeAllData","type":"reference"},{"text":" (default) — Imports local data so it can be merged with data from other devices.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SeedPolicy\/excludeLocalData"},{"type":"text","text":" — Ignores local data. Use this when you want to start fresh from cloud data."}]}]}]},{"text":"Sync Options","type":"heading","level":3,"anchor":"Sync-Options"},{"inlineContent":[{"text":"For advanced control, pass ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SyncOptions"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ Download only — don't integrate or upload","try await ensemble?.sync(options: .cloudFileRetrievalOnly)","","\/\/ Force a rebase to compact sync history","try await ensemble?.sync(options: .forceRebase)"]},{"inlineContent":[{"type":"text","text":"A rebase is the most expensive part of a sync, and Ensembles decides for itself when one is due. To choose the moment yourself, sync with "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SyncOptions\/suppressRebase","isActive":true},{"text":" in normal use, and when conditions suit (the device is charging, a background processing task is running) read ","type":"text"},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/rebaseMetrics()","isActive":true},{"type":"text","text":" and pass "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SyncOptions\/forceRebase","isActive":true},{"type":"text","text":" if "},{"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/RebaseMetrics\/isRebaseRecommended","isActive":true},{"type":"text","text":" is true or your own thresholds are met."}],"type":"paragraph"},{"anchor":"Process-Pending-Changes","text":"Process Pending Changes","type":"heading","level":2},{"inlineContent":[{"text":"On iOS, the app may be suspended before Ensembles finishes recording a save. Call ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/processPendingChanges()"},{"text":" — for example, in a background task — to ensure all changes are fully stored:","type":"text"}],"type":"paragraph"},{"code":["try await ensemble?.processPendingChanges()"],"syntax":"swift","type":"codeListing"},{"text":"Monitor Activity","type":"heading","level":2,"anchor":"Monitor-Activity"},{"inlineContent":[{"text":"Track long-running operations via ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/currentActivity"},{"text":" and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/activityProgress"},{"text":", or observe these notifications:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"coreDataEnsembleDidBeginActivity","type":"codeVoice"},{"text":" — An activity started","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"coreDataEnsembleDidMakeProgressWithActivity","type":"codeVoice"},{"text":" — Progress updated (includes ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SyncingPhase","type":"reference"},{"text":" or ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/AttachingPhase","type":"reference"},{"text":")","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"coreDataEnsembleWillEndActivity","type":"codeVoice"},{"text":" — An activity finished (may include an error)","type":"text"}]}]}],"type":"unorderedList"}]}],"references":{"doc://Ensembles/documentation/Ensembles/SyncOptions/forceRebase":{"abstract":[{"text":"Force a rebase to compress sync data. More expensive but reduces storage.","type":"text"}],"type":"topic","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SyncOptions\/forceRebase","kind":"symbol","url":"\/documentation\/ensembles\/syncoptions\/forcerebase","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"forceRebase","kind":"identifier"},{"text":": ","kind":"text"},{"text":"SyncOptions","preciseIdentifier":"s:9Ensembles11SyncOptionsV","kind":"typeIdentifier"}],"title":"forceRebase","role":"symbol"},"doc://Ensembles/documentation/Ensembles/AttachingPhase":{"title":"AttachingPhase","navigatorTitle":[{"text":"AttachingPhase","kind":"identifier"}],"abstract":[{"text":"The phase of an attach operation currently in progress.","type":"text"}],"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/AttachingPhase","url":"\/documentation\/ensembles\/attachingphase","type":"topic","role":"symbol","kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AttachingPhase","kind":"identifier"}]},"doc://Ensembles/documentation/Ensembles/SyncingPhase":{"title":"SyncingPhase","navigatorTitle":[{"text":"SyncingPhase","kind":"identifier"}],"abstract":[{"type":"text","text":"The phase of a sync operation currently in progress."}],"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SyncingPhase","url":"\/documentation\/ensembles\/syncingphase","type":"topic","role":"symbol","kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SyncingPhase","kind":"identifier"}]},"doc://Ensembles/documentation/Ensembles/CoreDataEnsembleContainer":{"title":"CoreDataEnsembleContainer","navigatorTitle":[{"kind":"identifier","text":"CoreDataEnsembleContainer"}],"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleContainer","abstract":[{"type":"text","text":"A high-level container that sets up a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble"},{"type":"text","text":" with automatic syncing,"},{"type":"text","text":" "},{"type":"text","text":"delegate management, and optional Core Data stack creation."}],"url":"\/documentation\/ensembles\/coredataensemblecontainer","type":"topic","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"CoreDataEnsembleContainer"}]},"doc://Ensembles/documentation/Ensembles/CoreDataEnsemble/sync(options:)":{"abstract":[{"text":"Syncs changes with other peers.","type":"text"}],"type":"topic","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble\/sync(options:)","kind":"symbol","url":"\/documentation\/ensembles\/coredataensemble\/syn