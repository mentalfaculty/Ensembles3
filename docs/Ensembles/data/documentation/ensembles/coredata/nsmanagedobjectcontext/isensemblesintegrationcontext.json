{"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isEnsemblesIntegrationContext"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":" { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}]}],"kind":"declarations"},{"content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Core Data calls "},{"type":"codeVoice","code":"awakeFromInsert()"},{"type":"text","text":" (and "},{"type":"codeVoice","code":"awakeFromFetch()"},{"type":"text","text":") on objects that"},{"type":"text","text":" "},{"type":"text","text":"Ensembles creates in this context, exactly as it does for objects your own code"},{"type":"text","text":" "},{"type":"text","text":"inserts. If your "},{"type":"codeVoice","code":"awakeFromInsert()"},{"type":"text","text":" assigns default values — a fresh "},{"type":"codeVoice","code":"UUID"},{"type":"text","text":", the"},{"type":"text","text":" "},{"type":"text","text":"current location, a timestamp — those assignments will run during integration and"},{"type":"text","text":" "},{"type":"text","text":"can overwrite the synced values arriving from another device."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Guard such side effects so they only run for objects your app creates:"}],"type":"paragraph"},{"code":["override func awakeFromInsert() {","    super.awakeFromInsert()","    guard managedObjectContext?.isEnsemblesIntegrationContext != true else { return }","    if uniqueIdentifier == nil { uniqueIdentifier = UUID().uuidString }","    \/\/ ... other default-value setup ...","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Setting a stable global identifier (e.g. in "},{"type":"codeVoice","code":"awakeFromInsert"},{"type":"text","text":") is fine and recommended;"},{"type":"text","text":" "},{"type":"text","text":"it’s the assignment of "},{"type":"emphasis","inlineContent":[{"type":"text","text":"content"}]},{"type":"text","text":" attributes that this guard protects."}],"type":"paragraph"}],"kind":"content"}],"metadata":{"extendedModule":"CoreData","externalID":"s:So22NSManagedObjectContextC9EnsemblesE02isd11IntegrationC0Sbvp","title":"isEnsemblesIntegrationContext","role":"symbol","modules":[{"relatedModules":["CoreData"],"name":"Ensembles"}],"symbolKind":"property","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isEnsemblesIntegrationContext","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"roleHeading":"Instance Property"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ensembles\/coredata\/nsmanagedobjectcontext\/isensemblesintegrationcontext"]}],"hierarchy":{"paths":[["doc:\/\/Ensembles\/documentation\/Ensembles","doc:\/\/Ensembles\/documentation\/Ensembles\/CoreData","doc:\/\/Ensembles\/documentation\/Ensembles\/CoreData\/NSManagedObjectContext"]]},"kind":"symbol","identifier":{"url":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreData\/NSManagedObjectContext\/isEnsemblesIntegrationContext","interfaceLanguage":"swift"},"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"code":"true","type":"codeVoice"},{"type":"text","text":" when this context is the one Ensembles uses to insert and update objects"},{"type":"text","text":" "},{"type":"text","text":"while integrating synced changes from other devices."}],"references":{"doc://Ensembles/documentation/Ensembles/CoreData/NSManagedObjectContext/isEnsemblesIntegrationContext":{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreData\/NSManagedObjectContext\/isEnsemblesIntegrationContext","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"t