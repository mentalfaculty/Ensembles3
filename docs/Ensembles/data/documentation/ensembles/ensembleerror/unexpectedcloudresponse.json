{"abstract":[{"type":"text","text":"The cloud service answered a request with a response that does not match it — for example, no result at all for a record that was asked for. The framework cannot tell what the cloud holds and does nothing on the strength of such an answer. Transient — retry; if it recurs, the cloud service or its data may be faulty."}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"unexpectedCloudResponse","kind":"identifier"}]}]}],"sections":[],"metadata":{"symbolKind":"case","role":"symbol","modules":[{"name":"Ensembles"}],"title":"EnsembleError.unexpectedCloudResponse","externalID":"s:9Ensembles13EnsembleErrorO23unexpectedCloudResponseyA2CmF","roleHeading":"Case","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"unexpectedCloudResponse","kind":"identifier"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ensembles\/ensembleerror\/unexpectedcloudresponse"]}],"identifier":{"url":"doc:\/\/Ensembles\/documentation\/Ensembles\/EnsembleError\/unexpectedCloudResponse","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/Ensembles\/documentation\/Ensembles","doc:\/\/Ensembles\/documentation\/Ensembles\/EnsembleError"]]},"references":{"doc://Ensembles/documentation/Ensembles":{"title":"Ensembles","type":"topic","role":"collection","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles","kind":"symbol","url":"\/documentation\/ensembles","abstract":[{"type":"text","text":"Sync Core Data and SwiftData stores across devices using event sourcing."}]},"doc://Ensembles/documentation/Ensembles/EnsembleError":{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/EnsembleError","type":"topic","title":"EnsembleError","kind":"symbol","navigatorTitle":[{"text":"EnsembleError","kind":"identifier"}],"role":"symbol","abstract":[],"url":"\/documentation\/ensembles\/ensembleerror","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EnsembleError","kind":"identifier"}]},"doc://Ensembles/documentation/Ensembles/EnsembleError/unexpectedCloudResponse":{"type":"topic","title":"EnsembleError.unexpectedCloudResponse","abstract":[{"type":"text","text":"The cloud service answered a request with a response that does not match it — for example, no result at all for a record that was asked for. The framework cannot tell what the cloud holds and does nothing on the strength of such an answer. Transient — retry; if it recurs, the cloud service or its data may be faulty."}],"url":"\/documentation\/ensembles\/ensembleerror\/unexpectedcloudresponse","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/EnsembleError\/unexpectedCloudResponse","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"unexpectedCloudResponse"}]}}}