{"abstract":[{"text":"A save occurred during a merge operation. The merge is aborted (after a few in-sync retries). Transient — retry the sync. If it recurs on every sync, look for app code that saves in response to merged changes, such as a merge-notification handler rebuilding derived state.","type":"text"}],"metadata":{"roleHeading":"Case","symbolKind":"case","role":"symbol","title":"EnsembleError.saveOccurredDuringMerge","modules":[{"name":"Ensembles"}],"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"saveOccurredDuringMerge","kind":"identifier"}],"externalID":"s:9Ensembles13EnsembleErrorO23saveOccurredDuringMergeyA2CmF"},"sections":[],"hierarchy":{"paths":[["doc:\/\/Ensembles\/documentation\/Ensembles","doc:\/\/Ensembles\/documentation\/Ensembles\/EnsembleError"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"saveOccurredDuringMerge","kind":"identifier"}]}]},{"kind":"mentions","mentions":["doc:\/\/Ensembles\/documentation\/Ensembles\/SyncLifecycle"]}],"variants":[{"paths":["\/documentation\/ensembles\/ensembleerror\/saveoccurredduringmerge"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"url":"doc:\/\/Ensembles\/documentation\/Ensembles\/EnsembleError\/saveOccurredDuringMerge","interfaceLanguage":"swift"},"references":{"doc://Ensembles/documentation/Ensembles/EnsembleError":{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/EnsembleError","url":"\/documentation\/ensembles\/ensembleerror","title":"EnsembleError","abstract":[],"type":"topic","kind":"symbol","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EnsembleError","kind":"identifier"}],"navigatorTitle":[{"text":"EnsembleError","kind":"identifier"}]},"doc://Ensembles/documentation/Ensembles":{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles","url":"\/documentation\/ensembles","type":"topic","title":"Ensembles","abstract":[{"text":"Sync Core Data and SwiftData stores across devices using event sourcing.","type":"text"}],"kind":"symbol","role":"collection"},"doc://Ensembles/documentation/Ensembles/EnsembleError/saveOccurredDuringMerge":{"role":"symbol","type":"topic","url":"\/documentation\/ensembles\/ensembleerror\/saveoccurredduringmerge","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/EnsembleError\/saveOccurredDuringMerge","abstract":[{"type":"text","text":"A save occurred during a merge operation. The merge is aborted (after a few in-sync retries). Transient — retry the sync. If it recurs on every sync, look for app code that saves in response to merged changes, such as a merge-notification handler rebuilding derived state."}],"title":"EnsembleError.saveOccurredDuringMerge","kind":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"saveOccurredDuringMerge"}]},"doc://Ensembles/documentation/Ensembles/SyncLifecycle":{"url":"\/documentation\/ensembles\/synclifecycle","title":"Sync Lifecycle and Recovery","abstract":[{"text":"Know when the app may save, how to detect sync success and failure, and how to recover a device that has fallen behind.","type":"text"}],"kind":"article","role":"article","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SyncLifecycle","type":"topic"}}}