{"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Ensembles\/documentation\/Ensembles\/EnsembleError\/saveOccurredDuringMerge"},"kind":"symbol","abstract":[{"text":"A save occurred during a merge operation. The merge is aborted (after a few in-sync retries). Transient — retry the sync. If it recurs on every sync, look for app code that saves in response to merged changes, such as a merge-notification handler rebuilding derived state.","type":"text"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"saveOccurredDuringMerge","kind":"identifier"}]}],"kind":"declarations"},{"kind":"mentions","mentions":["doc:\/\/Ensembles\/documentation\/Ensembles\/SyncLifecycle"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ensembles\/ensembleerror\/saveoccurredduringmerge"]}],"hierarchy":{"paths":[["doc:\/\/Ensembles\/documentation\/Ensembles","doc:\/\/Ensembles\/documentation\/Ensembles\/EnsembleError"]]},"metadata":{"roleHeading":"Case","modules":[{"name":"Ensembles"}],"externalID":"s:9Ensembles13EnsembleErrorO23saveOccurredDuringMergeyA2CmF","title":"EnsembleError.saveOccurredDuringMerge","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"saveOccurredDuringMerge","kind":"identifier"}],"symbolKind":"case","role":"symbol"},"references":{"doc://Ensembles/documentation/Ensembles/EnsembleError":{"url":"\/documentation\/ensembles\/ensembleerror","abstract":[],"title":"EnsembleError","kind":"symbol","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"kind":"identifier","text":"EnsembleError"}],"navigatorTitle":[{"kind":"identifier","text":"EnsembleError"}],"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/EnsembleError"},"doc://Ensembles/documentation/Ensembles":{"type":"top