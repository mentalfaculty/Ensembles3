through a pluggable cloud backend, and replaying them on each peer to reach eventual consistency. It works with both ","type":"text"},{"inlineContent":[{"text":"Core Data","type":"text"}],"type":"strong"},{"text":" and ","type":"text"},{"inlineContent":[{"text":"SwiftData","type":"text"}],"type":"strong"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"An ensemble monitors a single persistent store. When the app saves, Ensembles captures the changes automatically. Calling ","type":"text"},{"type":"codeVoice","code":"sync()"},{"type":"text","text":" downloads remote events, replays them into the local store, and uploads new local events. Conflicts are resolved through causal revision tracking, with delegate hooks for custom repair logic."}],"type":"paragraph"},{"level":3,"type":"heading","text":"Quick Start — SwiftData","anchor":"Quick-Start-SwiftData"},{"inlineContent":[{"type":"text","text":"The simplest way to add sync to a SwiftData app is with "},{"type":"codeVoice","code":"SwiftDataEnsembleContainer"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["import EnsemblesSwiftData","import EnsemblesCloudKit","","let container = SwiftDataEnsembleContainer(","    name: \"MyNotes\",","    modelTypes: [Note.self],","    cloudFileSystem: CloudKitFileSystem(","        privateDatabaseForUbiquityContainerIdentifier: \"iCloud.com.example.app\",","        schemaVersion: .v2","    )",")!","\/\/ Use container.modelContainer with your SwiftUI views"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"See "},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SwiftDataIntegration","type":"reference"},{"type":"text","text":" for the full guide, including model versioning with "},{"type":"codeVoice","code":"VersionedSchema"},{"type":"text","text":"."}],"type":"paragraph"},{"level":3,"text":"Quick Start — Core Data","type":"heading","anchor":"Quick-Start-Core-Data"},{"inlineContent":[{"text":"For Core Data apps, use ","type":"text"},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleContainer","isActive":true,"type":"reference"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["import Ensembles","import EnsemblesCloudKit","","let container = CoreDataEnsembleContainer(","    name: \"MainStore\",","    modelURL: modelURL,","    cloudFileSystem: CloudKitFileSystem(","        privateDatabaseForUbiquityContainerIdentifier: \"iCloud.com.example.app\",","        schemaVersion: .v2","    )",")","\/\/ Auto-sync handles attach, sync, and ongoing saves"],"syntax":"swift"},{"inlineContent":[{"text":"For more control, use ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble"},{"text":" directly:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MainStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: cloudFS",")","ensemble?.delegate = self","","try await ensemble?.attachPersistentStore()","try await ensemble?.sync()"],"syntax":"swift"},{"text":"Cloud Backends","type":"heading","level":3,"anchor":"Cloud-Backends"},{"inlineContent":[{"text":"Ensembles ships with several cloud backends:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"CloudKitFileSystem"}]},{"type":"text","text":" — Syncs via iCloud using CloudKit."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"GoogleDriveCloudFileSystem"}]},{"type":"text","text":" — Syncs via Google Drive REST API v3."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"OneDriveCloudFileSystem"}]},{"type":"text","text":" — Syncs via Microsoft OneDrive (