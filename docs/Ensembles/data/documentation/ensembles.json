el versioning with "},{"type":"codeVoice","code":"VersionedSchema"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Quick-Start-Core-Data","type":"heading","level":3,"text":"Quick Start — Core Data"},{"inlineContent":[{"text":"For Core Data apps, use ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleContainer","type":"reference"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["import Ensembles","import EnsemblesCloudKit","","let container = CoreDataEnsembleContainer(","    name: \"MainStore\",","    modelURL: modelURL,","    cloudFileSystem: CloudKitFileSystem(","        privateDatabaseForUbiquityContainerIdentifier: \"iCloud.com.example.app\",","        schemaVersion: .v2","    )",")","\/\/ Auto-sync handles attach, sync, and ongoing saves"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"For more control, use ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble"},{"text":" directly:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MainStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: cloudFS",")","ensemble?.delegate = self","","try await ensemble?.attachPersistentStore()","try await ensemble?.sync()"]},{"type":"heading","text":"Cloud Backends","level":3,"anchor":"Cloud-Backends"},{"inlineContent":[{"type":"text","text":"Ensembles ships with several cloud backends:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"CloudKitFileSystem"}]},{"type":"text","text":" — Syncs via iCloud using CloudKit."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"GoogleDriveCloudFileSystem"}],"type":"strong"},{"text":" — Syncs