{"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"Ensembles synchronizes persistent stores by recording local saves as events, exchanging them through a pluggable cloud backend, and replaying them on each peer to reach eventual consistency. It works with both "},{"type":"strong","inlineContent":[{"text":"Core Data","type":"text"}]},{"type":"text","text":" and "},{"type":"strong","inlineContent":[{"text":"SwiftData","type":"text"}]},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"An ensemble monitors a single persistent store. When the app saves, Ensembles captures the changes automatically. Calling "},{"type":"codeVoice","code":"sync()"},{"type":"text","text":" downloads remote events, replays them into the local store, and uploads new local events. Conflicts are resolved through causal revision tracking, with delegate hooks for custom repair logic."}],"type":"paragraph"},{"text":"Quick Start — SwiftData","level":3,"type":"heading","anchor":"Quick-Start-SwiftData"},{"inlineContent":[{"type":"text","text":"The simplest way to add sync to a SwiftData app is with "},{"type":"codeVoice","code":"SwiftDataEnsembleContainer"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["import EnsemblesSwiftData","import EnsemblesCloudKit","","let container = SwiftDataEnsembleContainer(","    name: \"MyNotes\",","    modelTypes: [Note.self],","    cloudFileSystem: CloudKitFileSystem(","        privateDatabaseForUbiquityContainerIdentifier: \"iCloud.com.example.app\",","        schemaVersion: .v2","    )",")!","\/\/ Use container.modelContainer with your SwiftUI views"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"See "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/SwiftDataIntegration","type":"reference","isActive":true},{"type":"text","text":" for the full guide, including model versioning with "},{"type":"codeVoice","code":"VersionedSchema"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Quick Start — Core Data","level":3,"type":"heading","anchor":"Quick-Start-Core-Data"},{"inlineContent":[{"type":"text","text":"For Core Data apps, use "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsembleContainer","type":"reference","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"code":["import Ensembles","import EnsemblesCloudKit","","let container = CoreDataEnsembleContainer(","    name: \"MainStore\",","    modelURL: modelURL,","    cloudFileSystem: CloudKitFileSystem(","        privateDatabaseForUbiquityContainerIdentifier: \"iCloud.com.example.app\",","        schemaVersion: .v2","    )",")","\/\/ Auto-sync handles attach, sync, and ongoing saves"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"For more control, use "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CoreDataEnsemble","type":"reference","isActive":true},{"type":"text","text":" directly:"}],"type":"paragraph"},{"code":["let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MainStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: cloudFS",")","ensemble?.delegate = self","","try await ensemble?.attachPersistentStore()","try await ensemble?.sync()"],"type":"codeListing","syntax":"swift"},{"text":"Cloud Backends","level":3,"type":"heading","anchor":"Cloud-Backends"},{"inlineContent":[{"type":"text","text":"Ensembles ships with several cloud backends:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"CloudKitFileSystem","type":"text"}],"type":"strong"},{"text":" — Syncs via iCloud using CloudKit.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"GoogleDriveCloudFileSystem","type":"text"}],"type":"strong"},{"text":" — Syncs via Google Drive REST API v3.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"OneDriveCloudFileSystem","type":"text"}],"type":"strong"},{"text":" — Syncs via Microsoft OneDrive (Graph API v1.0).","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"PCloudCloudFileSystem","type":"text"}],"type":"strong"},{"text":" — Syncs via pCloud, a Swiss provider with strong privacy guarantees.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"WebDAVCloudFileSystem","type":"text"}],"type":"strong"},{"text":" — Syncs via any WebDAV server (Nextcloud, ownCloud, etc.).","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"ICloudDriveFileSystem","type":"text"}],"type":"strong"},{"text":" — Syncs via iCloud Drive (legacy — prefer CloudKit for new projects).","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"EncryptedCloudFileSystem","type":"text"}],"type":"strong"},{"text":" — Wraps any backend with AES-256-GCM encryption.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"LocalCloudFileSystem","type":"text"}],"type":"strong"},{"text":" — Uses a local directory, useful for testing or shared-folder sync.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"MemoryCloudFileSystem","type":"text"}],"type":"strong"},{"text":" — An in-memory actor-based backend for unit testing.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Any storage that can hold files at paths can serve as a backend. See "},{"identifier":"doc:\/\/Ensembles\/documentation\/Ensembles\/CustomCloudBackends","type":"reference","isActive":true},{"type":"text","text":" for a guide to implementing your own."}],"type":"paragraph"},{"text":"Backward Compatibility","level":3,"type":"headi