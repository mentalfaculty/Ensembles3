{"primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"EnsemblesWebDAV provides ","type":"text"},{"type":"reference","identifier":"doc:\/\/EnsemblesWebDAV\/documentation\/EnsemblesWebDAV\/WebDAVCloudFileSystem","isActive":true},{"type":"text","text":", an implementation of the Ensembles "},{"code":"CloudFileSystem","type":"codeVoice"},{"type":"text","text":" protocol that stores sync data on any WebDAV-compatible server. It uses standard HTTP WebDAV methods ("},{"type":"codeVoice","code":"PROPFIND"},{"type":"text","text":", "},{"code":"MKCOL","type":"codeVoice"},{"type":"text","text":", "},{"type":"codeVoice","code":"PUT"},{"type":"text","text":", "},{"code":"GET","type":"codeVoice"},{"type":"text","text":", "},{"code":"DELETE","type":"codeVoice"},{"type":"text","text":") via "},{"code":"URLSession","type":"codeVoice"},{"type":"text","text":" — no third-party dependencies required."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"WebDAV is a widely supported protocol available on Nextcloud, ownCloud, Apache, nginx, IIS, and many NAS devices. This makes it a versatile backend for self-hosted sync."}]},{"type":"heading","text":"Authentication","anchor":"Authentication","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"WebDAV supports Basic and Digest authentication. Pass credentials at initialization:"}]},{"type":"codeListing","code":["import EnsemblesWebDAV","","let cloudFS = WebDAVCloudFileSystem(","    baseURL: URL(string: \"https:\/\/cloud.example.com\/remote.php\/dav\/files\/username\/\")!,","    username: \"username\",","    password: \"app-password\"",")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Digest authentication is handled automatically by "},{"code":"URLSession","type":"codeVoice"},{"type":"text","text":"’s HTTP challenge mechanism. For servers that require client certificates or other authentication schemes, configure a custom "},{"code":"URLSession","type":"codeVoice"},{"type":"text","text":" and credential."}]},{"type":"heading","level":3,"text":"Setup Examples","anchor":"Setup-Examples"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Nextcloud \/ ownCloud:"}]}]},{"type":"codeListing","code":["\/\/ Generate an app password in Settings → Security → App passwords","let cloudFS = WebDAVCloudFileSystem(","    baseURL: URL(string: \"https:\/\/cloud.example.com\/remote.php\/dav\/files\/username\/\")!,","    username: \"username\",","    password: \"app-password\"",")","","let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MainStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: cloudFS",")","try await ensemble?.attachPersistentStore()"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Generic WebDAV server:"}]}]},{"type":"codeListing","code":["let cloudFS = WebDAVCloudFileSystem(","    baseURL: URL(string: \"https:\/\/webdav.example.com\/sync\/\")!,","    username: \"user\",","    password: \"password\"",")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"No authentication (local development):"}]}]},{"type":"codeListing","syntax":"swift","code":["let cloudFS = WebDAVCloudFileSystem(","    baseURL: URL(string: \"http:\/\/localhost:8080\/webdav\/\")!",")"]},{"type":"heading","text":"API Details","level":3,"anchor":"API-Details"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The backend uses standard WebDAV HTTP methods. The "},{"type":"codeVoice","code":"baseURL"},{"type":"text","text":" is the root directory for all sync data — Ensembles creates its directory structure beneath it."}]},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Operation"}]}],[{"inlineContent":[{