{"abstract":[{"type":"text","text":"A WebDAV cloud backend for Ensembles."}],"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","sections":[],"hierarchy":{"paths":[[]]},"identifier":{"url":"doc:\/\/EnsemblesWebDAV\/documentation\/EnsemblesWebDAV","interfaceLanguage":"swift"},"metadata":{"title":"EnsemblesWebDAV","modules":[{"name":"EnsemblesWebDAV"}],"externalID":"EnsemblesWebDAV","symbolKind":"module","roleHeading":"Framework","role":"collection"},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"EnsemblesWebDAV provides "},{"isActive":true,"type":"reference","identifier":"doc:\/\/EnsemblesWebDAV\/documentation\/EnsemblesWebDAV\/WebDAVCloudFileSystem"},{"type":"text","text":", an implementation of the Ensembles "},{"code":"CloudFileSystem","type":"codeVoice"},{"type":"text","text":" protocol that stores sync data on any WebDAV-compatible server. It uses standard HTTP WebDAV methods ("},{"code":"PROPFIND","type":"codeVoice"},{"type":"text","text":", "},{"code":"MKCOL","type":"codeVoice"},{"type":"text","text":", "},{"code":"PUT","type":"codeVoice"},{"type":"text","text":", "},{"code":"GET","type":"codeVoice"},{"type":"text","text":", "},{"code":"DELETE","type":"codeVoice"},{"type":"text","text":") via "},{"code":"URLSession","type":"codeVoice"},{"type":"text","text":" — no third-party dependencies required."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"WebDAV is a widely supported protocol available on Nextcloud, ownCloud, Apache, nginx, IIS, and many NAS devices. This makes it a versatile backend for self-hosted sync."}],"type":"paragraph"},{"text":"Authentication","anchor":"Authentication","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"WebDAV supports Basic and Digest authentication. Pass credentials at initialization:"}],"type":"paragraph"},{"code":["import EnsemblesWebDAV","","let cloudFS = WebDAVCl