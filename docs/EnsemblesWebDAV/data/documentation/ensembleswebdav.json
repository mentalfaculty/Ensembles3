eContent":[{"type":"strong","inlineContent":[{"type":"text","text":"404 Not Found"}]},{"type":"text","text":" maps to "},{"type":"codeVoice","code":"EnsembleError.fileAccessFailed"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Other HTTP errors map to "},{"type":"codeVoice","code":"EnsembleError.serverError"},{"type":"text","text":"."}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Server Compatibility Notes","anchor":"Server-Compatibility-Notes","level":3,"type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Nextcloud\/ownCloud"}]},{"type":"text","text":": Use the full WebDAV path including "},{"type":"codeVoice","code":"\/remote.php\/dav\/files\/username\/"},{"type":"text","text":". Generate an app-specific password rather than using your login password."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Apache mod_dav"}]},{"type":"text","text":": Ensure the "},{"type":"codeVoice","code":"MKCOL"},{"type":"text","text":" method is allowed and the directory is writable."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"nginx"}]},{"type":"text","text":": Requires the "},{"type":"codeVoice","code":"ngx_http_dav_module"},{"type":"text","text":" or "},{"type":"codeVoice","code":"nginx-dav-ext-module"},{"type":"text","text":" for full WebDAV support."}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Dependencies","anchor":"Dependencies","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"This module has "},{"type":"strong","inlineContent":[{"text":"no external dependencies","type":"text"}]},{"type":"text","text":" beyond Foundation and the core "},{"type":"codeVoice","code":"Ensembles"},{"type":"text","text":" framework. All network communication uses "},{"type":"codeVoice","code":"URLSession"},{"t