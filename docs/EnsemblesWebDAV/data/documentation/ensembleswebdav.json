{"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"text":"EnsemblesWebDAV provides ","type":"text"},{"type":"reference","identifier":"doc:\/\/EnsemblesWebDAV\/documentation\/EnsemblesWebDAV\/WebDAVCloudFileSystem","isActive":true},{"text":", an implementation of the Ensembles ","type":"text"},{"code":"CloudFileSystem","type":"codeVoice"},{"text":" protocol that stores sync data on any WebDAV-compatible server. It uses standard HTTP WebDAV methods (","type":"text"},{"code":"PROPFIND","type":"codeVoice"},{"text":", ","type":"text"},{"code":"MKCOL","type":"codeVoice"},{"text":", ","type":"text"},{"code":"PUT","type":"codeVoice"},{"text":", ","type":"text"},{"code":"GET","type":"codeVoice"},{"text":", ","type":"text"},{"code":"DELETE","type":"codeVoice"},{"text":") via ","type":"text"},{"code":"URLSession","type":"codeVoice"},{"text":" — no third-party dependencies required.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"WebDAV is a widely supported protocol available on Nextcloud, ownCloud, Apache, nginx, IIS, and many NAS devices. This makes it a versatile backend for self-hosted sync."}],"type":"paragraph"},{"text":"Authentication","anchor":"Authentication","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"WebDAV supports Basic and Digest authentication. Pass credentials at initialization:"}],"type":"paragraph"},{"code":["import EnsemblesWebDAV","","let cloudFS = WebDAVCloudFileSystem(","    baseURL: URL(string: \"https:\/\/cloud.example.com\/remote.php\/dav\/files\/username\/\")!,","    username: \"username\",","    password: \"app-password\"",")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Digest authentication is handled automatically by "},{"type":"codeVoice","code":"URLSession"},{"type":"text","text":"’s HTTP challenge mechanism. For servers that require client certificates or other authentication schemes, configure a custom "},{"type":"codeVoice","code":"URLSession"},{"type":"text","text":" and credential."}],"type":"paragraph"},{"text":"Setup Examples","anchor":"Setup-Examples","level":3,"type":"heading"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Nextcloud \/ ownCloud:","type":"text"}]}],"type":"paragraph"},{"code":["\/\/ Generate an app password in Settings → Security → App passwords","let cloudFS = WebDAVCloudFileSystem(","    baseURL: URL(string: \"https:\/\/cloud.example.com\/remote.php\/dav\/files\/username\/\")!,","    username: \"username\",","    password: \"app-password\"",")","","let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MainStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: cloudFS",")","try await ensemble?.attachPersistentStore()"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Generic WebDAV server:","type":"text"}]}],"type":"paragraph"},{"code":["let cloudFS = WebDAVCloudFileSystem(","    baseURL: URL(string: \"https:\/\/webdav.example.com\/sync\/\")!,","    username: \"user\",","    password: \"password\"",")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"No authentication (local development):","type":"text"}]}],"type":"paragraph"},{"code":["let cloudFS = WebDAVCloudFileSystem(","    baseURL: URL(string: \"http:\/\/localhost:8080\/webdav\/\")!",")"],"syntax":"swift","type":"codeListing"},{"text":"API Details","anchor":"API-Details","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"The backend uses standard WebDAV HTTP methods. The "},{"type":"codeVoice","code":"baseURL"},{"type":"text","text":" is the root directory for all sync data — Ensembles creates its directory structure beneath it."}],"type":"paragraph"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Operation","type":"text"}]}],[{"