{"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"EnsemblesWebDAV provides ","type":"text"},{"type":"reference","identifier":"doc:\/\/EnsemblesWebDAV\/documentation\/EnsemblesWebDAV\/WebDAVCloudFileSystem","isActive":true},{"text":", an implementation of the Ensembles ","type":"text"},{"type":"codeVoice","code":"CloudFileSystem"},{"text":" protocol that stores sync data on any WebDAV-compatible server. It uses standard HTTP WebDAV methods (","type":"text"},{"type":"codeVoice","code":"PROPFIND"},{"type":"text","text":", "},{"type":"codeVoice","code":"MKCOL"},{"type":"text","text":", "},{"code":"PUT","type":"codeVoice"},{"text":", ","type":"text"},{"type":"codeVoice","code":"GET"},{"type":"text","text":", "},{"code":"DELETE","type":"codeVoice"},{"type":"text","text":") via "},{"code":"URLSession","type":"codeVoice"},{"type":"text","text":" — no third-party dependencies required."}]},{"type":"paragraph","inlineContent":[{"text":"WebDAV is a widely supported protocol available on Nextcloud, ownCloud, Apache, nginx, IIS, and many NAS devices. This makes it a versatile backend for self-hosted sync.","type":"text"}]},{"type":"heading","text":"Authentication","level":3,"anchor":"Authentication"},{"type":"paragraph","inlineContent":[{"text":"WebDAV supports Basic and Digest authentication. Pass credentials at initialization:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import EnsemblesWebDAV","","let cloudFS = WebDAVCloudFileSystem(","    baseURL: URL(string: \"https:\/\/cloud.example.com\/remote.php\/dav\/files\/username\/\")!,","    username: \"username\",","    password: \"app-password\"",")"]},{"type":"paragraph","inlineContent":[{"text":"Digest authentication is handled automatically by ","type":"text"},{"code":"URLSession","type":"codeVoice"},{"text":"’s HTTP challenge mechanism. For servers that require client certificates or other authentication schemes, configure a custom ","type":"text"},{"code":"URLSession","type":"codeVoice"},{"text":" and credential.","type":"text"}]},{"type":"heading","text":"Setup Examples","level":3,"anchor":"Setup-Examples"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Nextcloud \/ ownCloud:"}],"type":"strong"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Generate an app password in Settings → Security → App passwords","let cloudFS = WebDAVCloudFileSystem(","    baseURL: URL(string: \"https:\/\/cloud.example.com\/remote.php\/dav\/files\/username\/\")!,","    username: \"username\",","    password: \"app-password\"",")","","let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MainStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: cloudFS",")","try await ensemble?.attachPersistentStore()"]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Generic WebDAV server:"}],"type":"strong"}]},{"type":"codeListing","syntax":"swift","code":["let cloudFS = WebDAVCloudFileSystem(","    baseURL: URL(string: \"https:\/\/webdav.example.com\/sync\/\")!,","    username: \"user\",","    password: \"password\"",")"]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"No authentication (local development):"}],"type":"strong"}]},{"type":"codeListing","syntax":"swift","code":["let cloudFS = WebDAVCloudFileSystem(","    baseURL: URL(string: \"http:\/\/localhost:8080\/webdav\/\")!",")"]},{"type":"heading","text":"API Details","level":3,"anchor":"API-Details"},{"type":"paragraph","inlineContent":[{"text":"The backend uses standard WebDAV HTTP methods. The ","type":"text"},{"code":"baseURL","type":"codeVoice"},{"text":" is the root directory for all sync data — Ensembles creates its directory structure beneath it.","type":"text"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Operation","type"