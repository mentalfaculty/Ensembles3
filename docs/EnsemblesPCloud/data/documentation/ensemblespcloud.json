{"primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"EnsemblesPCloud provides "},{"type":"reference","isActive":true,"identifier":"doc:\/\/EnsemblesPCloud\/documentation\/EnsemblesPCloud\/PCloudCloudFileSystem"},{"type":"text","text":", an implementation of the Ensembles "},{"type":"codeVoice","code":"CloudFileSystem"},{"type":"text","text":" protocol that stores sync data on "},{"type":"reference","isActive":true,"identifier":"https:\/\/www.pcloud.com"},{"type":"text","text":". It communicates directly with pCloud’s REST API using "},{"type":"codeVoice","code":"URLSession"},{"type":"text","text":" — no third-party SDK required."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"pCloud is a Swiss cloud storage provider subject to Swiss data privacy laws, making it a strong choice for privacy-conscious applications. The backend supports both US and EU API endpoints for data residency requirements."}]},{"type":"heading","level":3,"anchor":"Authentication","text":"Authentication"},{"type":"paragraph","inlineContent":[{"type":"text","text":"pCloud uses OAuth 2.0. Your app is responsible for completing the OAuth flow and obtaining an access token. Pass the token when creating the file system:"}]},{"type":"codeListing","code":["import EnsemblesPCloud","","let cloudFileSystem = PCloudCloudFileSystem(accessToken: \"your-oauth-token\")","","\/\/ For EU data residency:","let euCloudFileSystem = PCloudCloudFileSystem(","    accessToken: \"your-oauth-token\",","    apiBaseURL: URL(string: \"https:\/\/eapi.pcloud.com\")!",")"],"syntax":"swift"},{"type":"heading","level":3,"anchor":"Setup","text":"Setup"},{"type":"codeListing","code":["let ensemble = CoreDataEnsemble(","    ensembleIdentifier: \"MainStore\",","    persistentStoreURL: storeURL,","    managedObjectModelURL: modelURL,","    cloudFileSystem: PCloudCloudFileSystem(accessToken: token)",")","try 