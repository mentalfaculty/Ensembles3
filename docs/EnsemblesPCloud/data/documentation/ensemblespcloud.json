ing","text":"Error Handling"},{"type":"paragraph","inlineContent":[{"type":"text","text":"pCloud API errors are mapped to "},{"type":"codeVoice","code":"EnsembleError"},{"type":"text","text":" cases:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Result code 1000 (login required) and 2003 (access denied) map to "},{"type":"codeVoice","code":"EnsembleError\/authenticationFailure"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Result codes 2000, 2005, and 2009 (not found) map to "},{"type":"codeVoice","code":"EnsembleError\/fileAccessFailed"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"All other errors map to "},{"type":"codeVoice","code":"EnsembleError\/serverError"},{"type":"text","text":"."}],"type":"paragraph"}]}]},{"type":"heading","level":3,"anchor":"Dependencies","text":"Dependencies"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This module has "},{"type":"strong","inlineContent":[{"type":"text","text":"no external dependencies"}]},{"type":"text","text":" beyond Foundation and the core "},{"type":"codeVoice","code":"Ensembles"},{"type":"text","text":" framework. All network communication uses "},{"type":"codeVoice","code":"URLSession"},{"type":"text","text":"."}]}],"kind":"content"}],"kind":"symbol","abstract":[{"type":"text","text":"A pCloud-based cloud backend for Ensembles."}],"metadata":{"title":"EnsemblesPCloud","externalID":"EnsemblesPCloud","symbolKind":"module","modules":[{"name":"EnsemblesPCloud"}],"role":"collection","roleHeading":"Framework"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/EnsemblesPCloud\/documentation\/EnsemblesPCloud"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ensemblespcloud"]}],"hierarchy":{"paths":[[]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"topicSections":[{"anchor":"Cloud-File-System